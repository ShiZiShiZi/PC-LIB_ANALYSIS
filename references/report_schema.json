{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PC third-party library analysis report",
  "description": "Final report produced by the pc-lib-analyzer agent. The languages/code_metrics/tests blocks come verbatim from the code-metrics script (deterministic); every other block is reasoned by the model via its skill.",
  "type": "object",
  "required": ["library", "function_summary", "languages", "code_metrics",
               "tests", "license", "dependencies", "native_api", "meta"],
  "properties": {
    "library": {
      "type": "object",
      "required": ["name", "source_url"],
      "properties": {
        "name": {"type": "string"},
        "package_name": {"type": ["string", "null"],
          "description": "model: distribution/package name from the manifest (PyPI/npm/Maven artifact/crate name), may differ from the repo dir name. Used to link this library into other libraries' dependency trees. Null if none/uncertain."},
        "source_url": {"type": ["string", "null"]},
        "analyzed_at": {"type": "string", "description": "ISO-8601 UTC"},
        "commit": {"type": ["string", "null"]},
        "one_liner": {"type": "string", "description": "model: <=120 char tagline"},
        "ecosystem": {
          "type": "string",
          "enum": ["python", "java", "nodejs", "cpp", "rust", "go", "dotnet", "other"],
          "description": "库所属语言生态，由模型根据 manifest 与主语言判断。取值：python / java / nodejs / cpp / rust / go / dotnet / other"
        }
      }
    },

    "function_summary": {
      "type": "object",
      "description": "Dimension 1 — MODEL (skill: function-summary). All prose fields here (summary, category name/description, domain, target_users) and library.one_liner are written in Simplified Chinese (简体中文).",
      "required": ["summary", "categories"],
      "properties": {
        "summary": {"type": "string", "description": "2-4 sentences: what it does, for whom."},
        "categories": {
          "type": "array",
          "description": "Capability groups the library provides.",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": {"type": "string"},
              "description": {"type": "string"},
              "evidence": {"type": "array", "items": {"type": "string"},
                "description": "files/symbols/docs that support this category"}
            }
          }
        },
        "domain": {"type": "string", "description": "e.g. networking, graphics, ML, crypto"},
        "target_users": {"type": "string"}
      }
    },

    "languages": {
      "type": "object",
      "description": "Dimension 2 — SCRIPT (code-metrics).",
      "properties": {
        "primary": {"type": ["string", "null"]},
        "all": {"type": "array", "items": {"type": "string"}},
        "breakdown": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "language": {"type": "string"}, "files": {"type": "integer"},
            "code": {"type": "integer"}, "pct": {"type": "number"}}}}
      }
    },

    "code_metrics": {
      "type": "object",
      "description": "Dimension 3 — SCRIPT (code-metrics). Splits prod/test/example.",
      "properties": {
        "tool": {"type": "string", "enum": ["cloc", "tokei", "builtin"]},
        "total": {"$ref": "#/definitions/lineAgg"},
        "production": {"$ref": "#/definitions/lineAgg"},
        "test": {"$ref": "#/definitions/lineAgg"},
        "example": {"$ref": "#/definitions/lineAgg"},
        "production_by_language": {"type": "object"}
      }
    },

    "tests": {
      "type": "object",
      "description": "Dimension 4 — SCRIPT counts; model may refine framework/notes.",
      "properties": {
        "test_files": {"type": "integer"},
        "test_cases": {"type": "integer"},
        "frameworks": {"type": "array", "items": {"type": "string"}},
        "by_language": {"type": "object"},
        "notes": {"type": "string"}
      }
    },

    "license": {
      "type": "object",
      "description": "Dimension 5 — MODEL (skill: license-detect).",
      "required": ["spdx", "confidence"],
      "properties": {
        "spdx": {"type": ["string", "null"], "description": "SPDX id, 'NOASSERTION', or null"},
        "name": {"type": ["string", "null"]},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "is_dual_licensed": {"type": "boolean"},
        "license_files": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string", "description": "what the call is based on"},
        "notes": {"type": "string", "description": "caveats, copyleft, exceptions"}
      }
    },

    "dependencies": {
      "type": "object",
      "description": "Dimension 6 — MODEL (skill: dependency-analysis).",
      "properties": {
        "count": {"type": "integer"},
        "manifests": {"type": "array", "items": {"type": "string"}},
        "by_ecosystem": {"type": "object"},
        "dependencies": {"type": "array", "items": {
          "type": "object",
          "required": ["name", "ecosystem"],
          "properties": {
            "name": {"type": "string"},
            "ecosystem": {"type": "string"},
            "scope": {"type": "string", "description": "runtime/dev/test/optional/build"},
            "version": {"type": ["string", "null"]},
            "purpose": {"type": "string", "description": "model: why it's used"},
            "acquisition": {"type": "string",
              "enum": ["system", "vendored", "fetchcontent", "download_build", "submodule", "package_manager", "prebuilt_binary", "unknown"],
              "description": "how the build OBTAINS this dependency (clarifies the real dependency relationship, esp. for C/C++ libs/.so). system=find_package/expected pre-installed; vendored=source copied into the tree (External/, third_party/); fetchcontent=CMake FetchContent; download_build=ExternalProject/custom download-source-and-build (e.g. downloadAndCheckMD5); submodule=git submodule; package_manager=vcpkg/conan/pip/npm/maven; prebuilt_binary=binary .so/.dll/.a/.lib shipped in repo. Locality is derived from this: local←vendored/prebuilt_binary, remote←fetchcontent/download_build/submodule/package_manager, system←system"},
            "source": {"type": "string", "description": "model: WHERE it is obtained from — download URL / registry / 'system (find_package, must be pre-installed)' / in-tree path, 简体中文"},
            "declared_in": {"type": "array", "items": {"type": "string"},
              "description": "model: repo file(s) that declare how this dependency is integrated, e.g. the CMakeLists.txt with find_package/FetchContent_Declare/ExternalProject_Add/target_link_libraries, a .gitmodules entry, or a requirements/manifest line"}}}},
        "notes": {"type": "string"}
      }
    },

    "native_api": {
      "type": "object",
      "description": "Dimension 7 — MODEL (skill: native-api-analysis).",
      "properties": {
        "summary": {"type": "string"},
        "groups": {"type": "array", "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string",
              "description": "e.g. win32, posix, cpp_stl, ctypes_ffi, jni, node_native, opengl, directx"},
            "symbols": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "array", "items": {"type": "string"},
              "description": "files / includes / call sites"}}}},
        "dynamic_libraries": {
          "type": "array",
          "description": "Libraries loaded at RUNTIME via dynamic loading (not declared in package manifests). Model resolves the loaded library name and infers its purpose.",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "description": "loaded library name, e.g. 'libssl.so', 'kernel32.dll', 'libcudart' (keep as written; '<dynamic>' if computed at runtime)"},
              "mechanism": {"type": "string",
                "description": "how it is loaded: dlopen / LoadLibrary / ctypes.CDLL / ctypes.WinDLL / cffi.dlopen / JNI System.loadLibrary / node N-API addon"},
              "description": {"type": "string", "description": "model-inferred purpose of the loaded library, 简体中文"},
              "optional": {"type": "boolean", "description": "true if load failure is handled gracefully (feature is optional)"},
              "evidence": {"type": "array", "items": {"type": "string"},
                "description": "file + call site"}}}},
        "platform_dependence": {"type": "string",
          "enum": ["cross-platform", "windows-only", "posix-only", "mixed", "unknown"]}
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "string"},
        "analyzer": {"type": "string"},
        "counter_tool": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "confidence_overall": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    }
  },

  "definitions": {
    "lineAgg": {
      "type": "object",
      "properties": {
        "files": {"type": "integer"}, "code": {"type": "integer"},
        "comment": {"type": "integer"}, "blank": {"type": "integer"},
        "total_lines": {"type": "integer"}
      }
    }
  }
}
