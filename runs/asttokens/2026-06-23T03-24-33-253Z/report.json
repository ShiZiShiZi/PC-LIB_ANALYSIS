  "function_summary": {
    "summary": "asttokens 是一个纯 Python 工具库，用于在标准库 ast 或第三方 astroid 生成的抽象语法树（AST）节点上补充 first_token、last_token 等属性，使调用者能够根据 AST 节点精确取回生成它的源码文本。它同时提供 ASTTokens（基于 tokenize）与 ASTText（基于 AST 位置信息）两种实现，并提供 token 遍历、文本替换等辅助方法，主要服务于代码重构、静态分析、源码高亮等开发者工具。",
    "categories": [
      {
        "name": "AST 节点标注",
        "description": "遍历 AST/Astroid 树，为每个节点计算并附加 first_token 与 last_token，建立节点到源码 token 区间的映射。",
        "evidence": ["asttokens/mark_tokens.py:MarkTokens.visit_tree", "asttokens/asttokens.py:ASTTokens.mark_tokens"]
      },
      {
        "name": "源码文本提取",
        "description": "根据节点 token 区间或 AST 位置信息，返回节点对应的源码片段、字符偏移范围或行列位置。",
        "evidence": ["asttokens/asttokens.py:ASTTokens.get_text", "asttokens/asttokens.py:ASTTokens.get_text_range", "asttokens/asttokens.py:ASTText.get_text_positions"]
      },
      {
        "name": "Token 列表与导航",
        "description": "将 tokenize 输出封装为带偏移索引的 Token 列表，支持按位置/偏移查找 token，以及在 token 流中前后导航。",
        "evidence": ["asttokens/asttokens.py:ASTTokens.tokens", "asttokens/asttokens.py:ASTTokens.get_token", "asttokens/asttokens.py:ASTTokens.next_token"]
      },
      {
        "name": "astroid 兼容",
        "description": "通过 try/except 动态探测 astroid 包结构，使同一套逻辑可同时处理 ast 与 astroid 节点。",
        "evidence": ["asttokens/astroid_compat.py", "asttokens/util.py:iter_children_func"]
      },
      {
        "name": "无 token 快速定位",
        "description": "ASTText 利用 AST 自身的位置字段直接计算文本范围，避免完整 tokenize，提高性能并支持部分 f-string 内部节点。",
        "evidence": ["asttokens/asttokens.py:ASTText", "asttokens/asttokens.py:supports_tokenless"]
      }
    ],
    "domain": "developer tools / static analysis",
    "target_users": "Python 开发者工具、代码重构、静态分析与源码可视化工具的开发者"
  },
