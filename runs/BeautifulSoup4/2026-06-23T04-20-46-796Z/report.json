  "function_summary": {
    "summary": "BeautifulSoup4 是一个建立在底层 HTML/XML 解析器之上的 Python 库，提供符合 Python 习惯的 API 来将文档解析为可导航、可搜索、可修改的树形结构。它通过插件化的 TreeBuilder 机制封装 html.parser、html5lib 和 lxml 等多种解析后端，并提供 Unicode 编码探测、标签搜索、CSS 类筛选、树遍历与修改等能力，主要用于网页抓取、数据抽取和标记语言处理场景。",
    "categories": [
      {
        "name": "HTML/XML 解析",
        "description": "将字符串或文件对象形式的 HTML/XML 标记解析为 BeautifulSoup 对象树，支持自动编码探测和容错解析",
        "evidence": ["bs4/__init__.py:BeautifulSoup", "bs4/builder/_htmlparser.py:HTMLParserTreeBuilder", "bs4/dammit.py:UnicodeDammit"]
      },
      {
        "name": "树遍历与搜索",
        "description": "提供标签名、属性、CSS 类、文本内容等多维度搜索，以及父子/兄弟/前后节点遍历",
        "evidence": ["bs4/element.py:Tag.find", "bs4/element.py:Tag.find_all", "bs4/element.py:PageElement"]
      },
      {
        "name": "树结构修改",
        "description": "支持添加、删除、替换、提取节点以及修改标签名和属性",
        "evidence": ["bs4/element.py:Tag.append", "bs4/element.py:Tag.extract", "bs4/element.py:Tag.replace_with"]
      },
      {
        "name": "编码与实体处理",
        "description": "自动探测字节流编码、替换 HTML/XML 实体、处理 meta charset 声明",
        "evidence": ["bs4/dammit.py:EncodingDetector", "bs4/dammit.py:EntitySubstitution", "bs4/element.py:CharsetMetaAttributeValue"]
      },
      {
        "name": "解析后端抽象",
        "description": "通过 builder_registry 统一封装 html.parser、html5lib、lxml 三种后端，运行时按需加载",
        "evidence": ["bs4/builder/__init__.py:TreeBuilderRegistry", "bs4/builder/_lxml.py:LXMLTreeBuilder", "bs4/builder/_html5lib.py:HTML5TreeBuilder"]
      }
    ],
    "domain": "text processing / markup parsing",
    "target_users": "Python 开发者，尤其是进行网页抓取、数据清洗和 HTML/XML 处理的开发人员"
  },
