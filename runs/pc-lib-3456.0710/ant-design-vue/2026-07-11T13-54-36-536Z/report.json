  "function_summary": {
    "summary": "Ant Design Vue 是 Ant Design 设计规范的 Vue 3 完整实现，提供约 60+ 个企业级 UI 组件，覆盖通用/布局/导航/数据录入/数据展示/反馈等前端场景。组件支持 Vue 3 Composition API 和 Options API，内置国际化（数十种语言）、主题定制（CSS Variables / Less 变量）、按需加载（tree-shaking）与 SSR 兼容。底层依赖 dayjs 做日期处理、async-validator 做表单校验、dom-align 做弹层定位、@ant-design/icons-vue 做图标，无原生 C/C++ 模块，纯 JavaScript/TypeScript 库。",
    "categories": [
      {
        "name": "通用组件（General）",
        "description": "基础交互元素，包括按钮、图标、排版，是 UI 的最小构成单元",
        "components": [
          "Button",
          "Typography",
          "FloatButton"
        ]
      },
      {
        "name": "布局组件（Layout）",
        "description": "页面骨架与空间组织，包括栅格、间距、分割线",
        "components": [
          "Grid",
          "Layout",
          "Space",
          "Divider",
          "Flex"
        ]
      },
      {
        "name": "导航组件（Navigation）",
        "description": "页面跳转与内容引导，含菜单、面包屑、页头、标签页、分页、步骤条、下拉菜单、固钉",
        "components": [
          "Menu",
          "Breadcrumb",
          "PageHeader",
          "Pagination",
          "Steps",
          "Tabs",
          "Dropdown",
          "Affix",
          "Anchor"
        ]
      },
      {
        "name": "数据录入组件（Data Entry）",
        "description": "用户输入与数据提交交互，含表单/校验、选择器、日期/时间、上传、开关、滑块、评分、级联选择、穿梭框、树选择、自动完成、输入数字、单选/多选、提及、颜色选择器、搜索框",
        "components": [
          "Form",
          "Input",
          "InputNumber",
          "Select",
          "Cascader",
          "DatePicker",
          "TimePicker",
          "Upload",
          "Switch",
          "Slider",
          "Rate",
          "Radio",
          "Checkbox",
          "Transfer",
          "TreeSelect",
          "AutoComplete",
          "Mentions",
          "Segmented",
          "ColorPicker"
        ]
      },
      {
        "name": "数据展示组件（Data Display）",
        "description": "数据呈现与可视化辅助，含表格、列表、标签、卡片、头像、徽标、日历、走马灯、折叠面板、描述列表、树、空状态、图片、骨架屏、统计数值、二维码、时间线、文字提示、气泡确认框、气泡卡片、抽屉、水印",
        "components": [
          "Table",
          "List",
          "Tag",
          "Card",
          "Avatar",
          "Badge",
          "Calendar",
          "Carousel",
          "Collapse",
          "Descriptions",
          "Tree",
          "Empty",
          "Image",
          "Skeleton",
          "Statistic",
          "QRCode",
          "Timeline",
          "Tooltip",
          "Popconfirm",
          "Popover",
          "Drawer",
          "Watermark"
        ]
      },
      {
        "name": "反馈组件（Feedback）",
        "description": "用户操作后的状态反馈与信息提醒，含全局提示、模态框、通知、进度条、加载中、结果页、漫游引导",
        "components": [
          "Message",
          "Modal",
          "Notification",
          "Progress",
          "Spin",
          "Result",
          "Tour"
        ]
      },
      {
        "name": "其他（Other）",
        "description": "全局配置与国际化支持组件",
        "components": [
          "ConfigProvider",
          "LocaleProvider",
          "App",
          "Alert"
        ]
      }
    ],
    "domain": "前端开发/Web UI 框架",
    "target_users": "Vue 3 前端开发者、企业级 Web 应用开发团队"
  },
