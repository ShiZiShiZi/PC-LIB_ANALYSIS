  "function_summary": {
    "summary": "libvorbis 是 Xiph.Org Foundation 开发的 Ogg Vorbis 音频编解码器 C 参考实现库。它实现了 Vorbis I 音频压缩规范，提供可变码率（VBR）到固定码率的音频编码与解码，支持 1–255 声道、8kHz–192kHz 采样率。该库被广泛集成到多媒体框架（如 FFmpeg、GStreamer）、游戏引擎和播放器中，是 Ogg 容器格式的音频编码标准组件。项目包含三个库：libvorbis（核心编解码）、libvorbisenc（编码参数设置 API）和 libvorbisfile（基于 stdio 的高级解码/寻址便利接口）。",
    "categories": [
      {
        "name": "Vorbis 音频解码",
        "description": "将 Ogg Vorbis 位流解码为 PCM 浮点采样，支持 seek、声道数/采样率查询。核心 API 为 vorbis_synthesis_* 和 ov_read/ov_open 系列。",
        "evidence": [
          "lib/synthesis.c",
          "lib/vorbisfile.c",
          "include/vorbis/vorbisfile.h"
        ]
      },
      {
        "name": "Vorbis 音频编码",
        "description": "将 PCM 音频编码为 Vorbis 位流，支持 ABR/VBR/CBR 码率控制、声道耦合和质量因子调节。核心 API 为 vorbis_analysis_* 和 vorbis_encode_* 系列。",
        "evidence": [
          "lib/analysis.c",
          "lib/vorbisenc.c",
          "include/vorbis/vorbisenc.h"
        ]
      },
      {
        "name": "心理声学模型",
        "description": "Vorbis 内置的心理声学分析引擎，用于掩蔽计算、噪声归一化和 floor/residue 量化策略，优化编码质量与压缩比。",
        "evidence": [
          "lib/psy.c",
          "lib/psy.h",
          "lib/envelope.c",
          "lib/masking.h"
        ]
      },
      {
        "name": "MDCT 变换引擎",
        "description": "改进的离散余弦变换（MDCT）实现，是 Vorbis 时频域变换的核心，支持多种块大小。",
        "evidence": [
          "lib/mdct.c",
          "lib/mdct.h",
          "lib/block.c"
        ]
      },
      {
        "name": "码本管理与向量量化",
        "description": "内置静态码本（LSP、residue）的加载与查找，以及训练/构建工具的辅助。",
        "evidence": [
          "lib/codebook.c",
          "lib/sharedbook.c",
          "lib/books/",
          "vq/"
        ]
      }
    ],
    "domain": "音频编解码",
    "target_users": "多媒体框架开发者、播放器/编码器开发者、游戏引擎集成者"
  },
