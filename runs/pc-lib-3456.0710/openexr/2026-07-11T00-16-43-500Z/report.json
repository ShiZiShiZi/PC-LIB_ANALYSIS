  "function_summary": {
    "summary": "OpenEXR 是 Academy Software Foundation 维护的 EXR 图像文件格式的参考实现库。它提供对高动态范围（HDR）场景线性图像数据的精确读写、多种压缩/解压算法（PIZ/ZIP/RLE/PXR24/B44/DWAA/DWAB/HTJ2K）和深度图像支持，广泛用于影视渲染、合成、深度合成和中间片工作流。库核心分为纯 C 的 OpenEXRCore（底层编解码器与文件格式引擎）和 C++ 的 OpenEXR 高层 API，附带 Imath 数学库（half 浮点/向量/矩阵）和 IlmThread 线程池，可选 Python 绑定。",
    "domain": "图像与媒体",
    "target_users": "视觉特效开发人员、渲染引擎集成者、后期制作工具开发者",
    "categories": [
      {
        "name": "图像文件格式编码与解码",
        "description": "实现 EXR 文件格式的完整读写（single-part/multi-part）、多种压缩算法（PIZ/ZIP/RLE/PXR24/B44/B44A/DWAA/DWAB/HTJ2K）、多分辨率（mip/ripmap）、多视点（multi-view）和深度图像（deep image）支持",
        "evidence": [
          "src/lib/OpenEXR/ImfCompression.h:13-59",
          "src/lib/OpenEXRCore/compression.c",
          "src/lib/OpenEXRCore/encoding.c"
        ]
      },
      {
        "name": "高性能数值计算与 SIMD 加速",
        "description": "16位半浮点（half）与32位浮点间的高效转换、矩阵/向量数学运算、FPU 异常控制、x86 SSE/AVX 和 ARM NEON SIMD 指令集加速图像压缩/解压过程",
        "evidence": [
          "src/lib/OpenEXR/ImfSimd.h:46-90",
          "src/lib/OpenEXRCore/internal_dwa_simd.h",
          "src/lib/OpenEXR/ImfSystemSpecific.cpp:81-139"
        ]
      },
      {
        "name": "线程池与并行处理",
        "description": "基于 std::thread 与 POSIX/Win32 信号量的跨平台线程池，用于多核并行处理图像切片（scanline/tile）的压缩与解压任务",
        "evidence": [
          "src/lib/IlmThread/IlmThreadPool.cpp",
          "src/lib/IlmThread/IlmThreadSemaphore.cpp"
        ]
      }
    ]
  },
