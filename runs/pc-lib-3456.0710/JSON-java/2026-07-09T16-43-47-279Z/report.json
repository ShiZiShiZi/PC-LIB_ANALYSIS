  "function_summary": {
    "summary": "org.json 是一个轻量级的 Java JSON 处理库，提供 JSON 文本的解析、生成、写入等核心操作，并扩展支持 JSON 与 XML、CDL、Cookie、HTTP 头等格式的双向转换。所有类均基于 JDK 标准库，无外部依赖。",
    "categories": [
      {
        "name": "JSON 解析",
        "description": "将 JSON 文本字符串解析为结构化的 Java 对象（JSONObject/JSONArray），支持宽松语法（单引号字符串、尾随逗号、无引号键名等）和严格模式。入口类为 JSONTokener 和 JSONParserConfiguration。",
        "keywords": [
          "JSONTokener",
          "JSONObject",
          "JSONArray",
          "parse",
          "strict"
        ]
      },
      {
        "name": "JSON 生成与写入",
        "description": "将 Java 对象序列化为 JSON 文本。JSONWriter 提供流式写入，JSONStringer 封装为 String，JSONObject.toString 直接输出。JSONString 接口允许自定义类控制 JSON 序列化行为。",
        "keywords": [
          "JSONWriter",
          "JSONStringer",
          "toString",
          "serialize",
          "JSONString"
        ]
      },
      {
        "name": "JSON 与 XML 转换",
        "description": "提供 JSON 与 XML 两种格式之间的双向转换。XML.toJSONObject 将 XML 文本转为 JSONObject，JSONML 提供 JSONML 格式的 XML 表示与转换。XMLParserConfiguration 控制 XML 解析行为。",
        "keywords": [
          "XML",
          "JSONML",
          "toJSONObject",
          "XMLParserConfiguration"
        ]
      },
      {
        "name": "特殊格式转换",
        "description": "支持 JSON 与 CDL、HTTP Cookie 列表、HTTP 请求/响应头之间的转换。",
        "keywords": [
          "CDL",
          "Cookie",
          "CookieList",
          "HTTP",
          "HTTPTokener"
        ]
      },
      {
        "name": "属性访问与操作",
        "description": "JSONObject 提供 typed get/opt 方法按键取值（int、long、double、String、Boolean、BigDecimal、BigInteger 等）；JSONArray 提供类似索引访问。JSONPointer 实现 RFC 6901 JSON Pointer 标准，支持按路径定位和操作 JSON 结构中的值。",
        "keywords": [
          "get",
          "opt",
          "JSONPointer",
          "put",
          "accumulate",
          "append"
        ]
      },
      {
        "name": "Java 对象反射序列化",
        "description": "JSONObject 可通过反射将任意 Java Bean 的公开字段或 getter 方法序列化为 JSON，或从 JSON 填充到 Java 对象。支持注解（JSONPropertyName/JSONPropertyIgnore）自定义序列化行为。Property 类提供 JSON-to-Properties 转换。",
        "keywords": [
          "reflection",
          "bean",
          "JSONPropertyName",
          "JSONPropertyIgnore",
          "Property"
        ]
      }
    ],
    "domain": "数据交换与序列化",
    "target_users": "Java 后端开发者、API 开发者、需要轻量级 JSON 处理的 Java 项目"
  },
