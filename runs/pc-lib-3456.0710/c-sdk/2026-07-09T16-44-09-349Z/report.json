  "function_summary": {
    "summary": "七牛云存储 C/C++ SDK，基于七牛云官方 API，为 C89 兼容的 C/C++ 编译器提供云存储客户端能力。开发者通过此 SDK 可以方便地将数据安全地存储到七牛云存储上，实现文件上传下载、资源管理、断点续传、CDN 加速等功能。适用于服务端到终端的各种网络应用场景，包括网站程序和服务端后台。",
    "categories": [
      {
        "name": "文件上传",
        "description": "支持简单表单上传、分片上传 V2、断点续传等多种上传方式，提供进度回调与超时控制",
        "evidence": [
          "qiniu/io.h",
          "qiniu/resumable_io.h",
          "qiniu/multipart_upload.h"
        ]
      },
      {
        "name": "资源管理",
        "description": "提供文件的查询、移动、复制、删除等管理操作，支持批量处理和文件信息查看（stat、mime 变更、存储类型变更、文件生命周期管理）",
        "evidence": [
          "qiniu/rs.h",
          "qiniu/rsf.h"
        ]
      },
      {
        "name": "CDN 加速与安全",
        "description": "提供 CDN 缓存刷新、预取、流量/带宽统计查询、时间戳防盗链等功能",
        "evidence": [
          "qiniu/cdn.h"
        ]
      },
      {
        "name": "数据处理与媒体转码",
        "description": "支持持久化数据处理操作（如音视频转码、图片处理等），提供任务提交与查询接口",
        "evidence": [
          "qiniu/fop.h"
        ]
      },
      {
        "name": "认证与签名",
        "description": "提供基于 HMAC-SHA1 的七牛认证签名机制，支持上传凭证（UploadToken）和管理凭证的生成",
        "evidence": [
          "qiniu/auth_mac.c",
          "qiniu/conf.c"
        ]
      }
    ],
    "domain": "云存储",
    "target_users": "C/C++ 应用开发者、需要将文件数据存储到七牛云的后端服务开发者",
    "ecosystem": "cpp"
  },
