  "function_summary": {
    "summary": "isl 是一个线程安全的 C 库，用于操作由仿射约束限定的整数点集合与关系（Presburger 算术）。集合与关系的描述可包含参数和存在量词变量，所有计算在 GMP 或 imath 的精确整数算术上完成。主要用作多面体编译优化框架（如 GCC Graphite、LLVM Polly、CLooG、PENCIL）的底层多面体建模后端。",
    "categories": [
      {
        "name": "多面体集合操作",
        "description": "创建和操作由仿射不等式约束定义的整数点集合（basic_set、set），支持交集、并集、差集、投影、仿射包、样本点等运算。",
        "evidence": [
          "isl_map.c",
          "isl_basic_set_* API",
          "include/isl/set.h",
          "include/isl/map_type.h"
        ]
      },
      {
        "name": "多面体关系与映射",
        "description": "创建和操作整数点集合之间的二元关系（basic_map、map），支持逆、复合、差集、范围/定义域提取、字典序最优化等运算。",
        "evidence": [
          "isl_map.c",
          "include/isl/map.h",
          "isl_affine_hull.c"
        ]
      },
      {
        "name": "字典序优化",
        "description": "在整数点集合/关系上求解字典序最大/最小值，支持 PILP（参数整数线性规划），用于循环调度与依赖分析中的极值计算。",
        "evidence": [
          "isl_ilp.c",
          "isl_tab_pip.c",
          "include/isl/ilp.h",
          "isl_deprecated.c"
        ]
      },
      {
        "name": "仿射表达式与分段函数",
        "description": "构造和操作仿射表达式（aff）和分段多仿射函数（pw_multi_aff），支持加减乘除、取整、取模、复合、并集等运算。",
        "evidence": [
          "isl_aff.c",
          "include/isl/aff.h",
          "include/isl/aff_type.h"
        ]
      },
      {
        "name": "多面体扫描与调度",
        "description": "遍历多面体中的整数点（多面体扫描）和生成 AST 循环嵌套（调度），支持生成 C 代码样式的循环结构。",
        "evidence": [
          "isl_scan.c",
          "isl_ast_codegen.c",
          "isl_schedule.c",
          "schedule_tree",
          "include/isl/ast.h"
        ]
      },
      {
        "name": "依赖分析",
        "description": "基于读/写/存取关系计算数组元素之间的流依赖（RAW）、反依赖（WAR）和输出依赖（WAW），支持 must/may 两种精度。",
        "evidence": [
          "isl_flow.c",
          "flow.c",
          "include/isl/flow.h"
        ]
      }
    ],
    "domain": "编译器与程序分析（多面体编译优化、自动并行化）",
    "target_users": "编译器开发者、程序分析与优化工具开发者、自动并行化/向量化研究者",
    "ecosystem": "cpp"
  },
