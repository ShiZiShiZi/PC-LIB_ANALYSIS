  "function_summary": {
    "summary": "Sentry Native SDK 是 Sentry 官方提供的 C/C++ 原生崩溃与错误上报客户端。它支持在 Windows、Linux、macOS、Android 等平台上捕获原生崩溃（信号/异常），收集堆栈回溯、模块信息，并通过 HTTP 将事件（含附件、面包屑、上下文）上报到 Sentry 服务端。该 SDK 同时作为 sentry-java、sentry-unreal 等其他 SDK 的底层支撑库。",
    "categories": [
      {
        "name": "崩溃捕获与报告",
        "description": "在原生应用中捕获崩溃信号（SIGSEGV/SIGABRT 等）和未处理异常（Windows SEH），生成 minidump 并连同堆栈、模块信息、面包屑上报到 Sentry",
        "evidence": [
          "include/sentry.h: 定义 sentry_options_t 与崩溃处理器后端（crashpad/breakpad/inproc/native）",
          "src/backends/sentry_backend_inproc.c: 进程内崩溃处理实现（信号/UEF）",
          "src/backends/native/sentry_crash_handler.c: 原生后端崩溃处理器"
        ]
      },
      {
        "name": "事件上报与传输",
        "description": "通过 HTTP（curl/WinHTTP）将事件、附件、Session 数据等上报到 Sentry 服务端，支持 gzip 压缩",
        "evidence": [
          "src/transports/sentry_http_transport_curl.c: 基于 libcurl 的 HTTP 传输",
          "src/transports/sentry_http_transport_winhttp.c: 基于 WinHTTP 的 Windows 专有传输",
          "src/sentry_envelope.c: 信封协议封装"
        ]
      },
      {
        "name": "上下文与面包屑收集",
        "description": "支持附加自定义标签、用户信息、面包屑（tracking）、任意上下文数据，增强错误报告的可诊断性",
        "evidence": [
          "include/sentry.h: sentry_set_tag, sentry_set_context, sentry_add_breadcrumb API",
          "src/sentry_core.c: 面包屑/标签/上下文的实现"
        ]
      },
      {
        "name": "Android NDK 支持",
        "description": "提供 JNI 桥接层，使 Android 原生代码可通过 Java/Kotlin 层使用 Sentry，支持 Android API 16+",
        "evidence": [
          "ndk/lib/: JNI 封装实现目录",
          "ndk/lib/src/main/java/io/sentry/ndk/: Java/Kotlin 接口层"
        ]
      },
      {
        "name": "模块查找与符号化",
        "description": "在崩溃时识别进程加载的动态库/可执行文件、获取模块信息，支持符号化堆栈（需上传调试符号）",
        "evidence": [
          "src/modulefinder/: 各平台模块查找实现（linux/apple/windows/aix）",
          "src/symbolizer/: 符号化实现（windows/unix）"
        ]
      }
    ],
    "domain": "错误监控与崩溃报告",
    "target_users": "C/C++ 原生应用开发者，需要在其桌面应用、移动游戏或嵌入式系统中集成崩溃上报与错误监控"
  },
