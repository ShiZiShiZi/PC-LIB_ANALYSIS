  "function_summary": {
    "summary": "阿里云对象存储（OSS）的 C# SDK，为 .NET 开发者提供面向 OSS REST API 的类型安全封装。支持 Bucket 管理（创建/删除/查询/ACL/CORS/日志/生命周期/版本控制/加密/WORM）、Object 上传/下载/复制/删除/分片上传/追加上传、访问控制、签名 URL 生成等完整 OSS 功能。适用于在 .NET 应用中集成阿里云 OSS 存储服务。",
    "categories": [
      {
        "name": "Bucket 管理",
        "description": "创建、删除、列举 Bucket，设置/读取 Bucket ACL、CORS 规则、访问日志、生命周期规则、版本控制、服务器端加密、WORM 锁定、存储容量、请求者付费等配置。",
        "evidence": [
          "sdk/OssClient.cs",
          "sdk/Commands/"
        ]
      },
      {
        "name": "Object 操作",
        "description": "上传/下载/删除/复制 Object，支持普通上传、分片上传（Multipart Upload）、追加上传（Append）、断点续传（Resumable Upload/Download），以及 Object 元数据管理和 ACL 设置。",
        "evidence": [
          "sdk/OssClient.cs",
          "sdk/Commands/PutObjectCommand.cs",
          "sdk/Commands/AppendObjectCommand.cs",
          "sdk/Commands/UploadPartCommand.cs",
          "sdk/Common/ResumableUploadManager.cs",
          "sdk/Common/ResumableDownloadManager.cs"
        ]
      },
      {
        "name": "HTTP 通信与认证",
        "description": "封装 HTTP 请求/响应处理，包括 HMAC-SHA1 签名认证、连接管理、超时控制、重试策略、代理支持。",
        "evidence": [
          "sdk/Common/Authentication/",
          "sdk/Common/Communication/ServiceClient.cs",
          "sdk/Common/Communication/ServiceClientImpl.cs",
          "sdk/Common/Communication/netcore/ServiceClientNewImpl.cs"
        ]
      },
      {
        "name": "XML 序列化/反序列化",
        "description": "OSS API 的请求/响应采用 XML 格式，SDK 提供 XML 的序列化与反序列化处理。",
        "evidence": [
          "sdk/Transform/XmlStreamSerializer.cs",
          "sdk/Transform/XmlStreamDeserializer.cs",
          "sdk/Transform/SerializerFactory.cs",
          "sdk/Transform/DeserializerFactory.cs"
        ]
      },
      {
        "name": "数据完整性校验",
        "description": "支持 MD5 和 CRC64 校验，确保上传/下载数据的完整性。",
        "evidence": [
          "sdk/Util/Crc64.cs",
          "sdk/Util/Crc32.cs",
          "sdk/Common/Handlers/MD5DigestCheckHandler.cs",
          "sdk/Common/Handlers/Crc64CheckHandler.cs"
        ]
      }
    ],
    "domain": "云存储",
    "target_users": ".NET/C# 应用开发者",
    "ecosystem": "dotnet"
  },
