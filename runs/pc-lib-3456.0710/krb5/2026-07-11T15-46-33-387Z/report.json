  "function_summary": {
    "summary": "MIT Kerberos 5 (krb5) 是网络认证协议的权威开源实现，提供基于票据的单点登录（SSO）和客户端-服务端双向认证。核心功能包括密钥分发中心（KDC）、AS/TGS 协议、跨域认证与票据转发，广泛用于企业网络、Hadoop 集群、NFS 和分布式系统的身份验证基础设施。同时提供客户端命令行工具（kinit/klist/kdestroy）和管理工具（kadmin/kdb5_util）。",
    "categories": [
      {
        "name": "认证协议栈（AS/TGS）",
        "description": "实现 Kerberos 核心协议：认证服务（AS）获取 TGT、票据授权服务（TGS）获取服务票据，支持多种加密类型（AES/DES/RC4/Camellia）和预认证机制（PA-ENC-TIMESTAMP/PA-PK-INIT/SPAKE）",
        "evidence": [
          "src/lib/krb5/krb/",
          "src/lib/krb5/asn.1/",
          "src/kdc/do_as_req.c",
          "src/kdc/do_tgs_req.c"
        ]
      },
      {
        "name": "密钥分发中心（KDC）",
        "description": "KDC 服务端实现，负责票据签发与分发，包含主 KDC、增量传播（iprop）和 LDAP 后端的数据库支持",
        "evidence": [
          "src/kdc/main.c",
          "src/kdc/dispatch.c",
          "src/kdc/kdc_util.c",
          "src/plugins/kdb/",
          "src/kprop/"
        ]
      },
      {
        "name": "GSS-API 安全通信",
        "description": "基于 GSS-API 的安全上下文建立与消息保护，支持 Kerberos 5 机制（RFC 4121），被 SSH、NFS、HTTP Negotiate 等协议使用",
        "evidence": [
          "src/lib/gssapi/",
          "src/lib/gssapi/krb5/",
          "src/lib/gssapi/mechglue/",
          "src/lib/gssapi/spnego/"
        ]
      },
      {
        "name": "客户端工具与管理接口",
        "description": "提供 kinit/klist/kdestroy/kpasswd 等终端用户命令行工具，以及 kadmin（远程管理）和 kdb5_util（本地数据库管理）的 C 库与 CLI",
        "evidence": [
          "src/clients/kinit/",
          "src/clients/klist/",
          "src/clients/kdestroy/",
          "src/clients/kpasswd/",
          "src/kadmin/"
        ]
      },
      {
        "name": "凭证缓存与密钥表管理",
        "description": "支持多种凭据存储后端：文件（FILE）、内存（MEMORY）、密钥环（KEYRING）、KCM 守护进程、macOS 原生缓存、Windows MSLSA，并提供 keytab 文件的读写管理",
        "evidence": [
          "src/lib/krb5/ccache/",
          "src/lib/krb5/keytab/",
          "src/ccapi/",
          "src/lib/krb5/ccache/cc_mslsa.c",
          "src/lib/krb5/ccache/cc_keyring.c"
        ]
      },
      {
        "name": "加密框架与可插拔后端",
        "description": "内置多种加密算法实现（AES/DES3/Camellia/RC4/MD4/MD5/SHA-1/SHA-2），支持通过 OpenSSL 加速的加密后端，以及可插拔的 PBKDF2 密钥派生、预认证和 KDC 策略机制",
        "evidence": [
