  "function_summary": {
    "summary": "JUnit 是 Java 语言最广泛使用的单元测试框架，由 Erich Gamma 和 Kent Beck 创建。它提供注解驱动的测试定义（@Test、@Before、@After 等）、断言库（assertEquals、assertTrue 等）、测试运行器（Runner）和规则（@Rule）机制，支持测试组织、参数化测试、套件组合和 IDE/构建工具集成。JUnit 4 处于维护模式，但仍是大量现有 Java 项目的测试基础设施。",
    "categories": [
      {
        "name": "测试注解与生命周期",
        "description": "通过 @Test、@Before、@After、@BeforeClass、@AfterClass 等注解定义测试方法和测试前后生命周期回调，支持超时（timeout）和预期异常（expected）。",
        "evidence": [
          "src/main/java/org/junit/Test.java",
          "src/main/java/org/junit/Before.java",
          "src/main/java/org/junit/After.java"
        ]
      },
      {
        "name": "断言库",
        "description": "提供 assertEquals、assertTrue、assertThat 等静态断言方法，支持数组/浮点断言和 Hamcrest matcher 集成。",
        "evidence": [
          "src/main/java/org/junit/Assert.java",
          "src/main/java/org/junit/matchers/JUnitMatchers.java"
        ]
      },
      {
        "name": "测试运行器（Runner）框架",
        "description": "通过 @RunWith 指定测试运行策略（BlockJUnit4ClassRunner、Parameterized、Suite、Categories 等），控制测试发现和执行。",
        "evidence": [
          "src/main/java/org/junit/runner/Runner.java",
          "src/main/java/org/junit/runners/BlockJUnit4ClassRunner.java"
        ]
      },
      {
        "name": "规则（@Rule / @ClassRule）",
        "description": "通过方法级和类级规则拦截测试执行，实现临时文件夹（TemporaryFolder）、超时（Timeout）、预期异常（ExpectedException）等横切关注点。",
        "evidence": [
          "src/main/java/org/junit/Rule.java",
          "src/main/java/org/junit/ClassRule.java",
          "src/main/java/org/junit/rules/"
        ]
      },
      {
        "name": "假设与条件跳过",
        "description": "提供 Assume.assumeTrue/assumeThat 方法，在条件不满足时跳过测试，区别于断言失败。",
        "evidence": [
          "src/main/java/org/junit/Assume.java"
        ]
      },
      {
        "name": "JUnit 3 兼容层",
        "description": "兼容 JUnit 3 的 TestCase 和 TestSuite API，允许 JUnit 4 测试运行器执行旧式测试。",
        "evidence": [
          "src/main/java/junit/framework/TestCase.java",
          "src/main/java/junit/framework/TestSuite.java",
          "src/main/java/org/junit/internal/runners/JUnit38ClassRunner.java"
        ]
      }
    ],
