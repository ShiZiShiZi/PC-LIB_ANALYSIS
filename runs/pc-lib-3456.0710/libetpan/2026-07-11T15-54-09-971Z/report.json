  "function_summary": {
    "summary": "libEtPan 是一个用 C 语言编写的跨平台邮件处理框架，为应用程序开发者提供统一的 API 来访问多种邮件协议（IMAP/SMTP/POP3/NNTP）和本地邮件存储格式（mbox/MH/maildir）。它封装了底层的网络通信、SSL/TLS 加密、MIME 消息构建与解析、SASL 认证等能力，使开发者无需关心协议细节即可构建邮件客户端或邮件处理服务。",
    "categories": [
      {
        "name": "IMAP 协议支持",
        "description": "通过 IMAP4rev1 协议与邮件服务器交互，支持连接、认证、文件夹管理、邮件获取、IDLE 推送、QUOTA、CONDSTORE、QRESYNC 等扩展，以及 COMPRESS（DEFLATE）压缩和 OAuth2 认证。",
        "evidence": [
          "src/low-level/imap/mailimap.c",
          "src/low-level/imap/mailimap_ssl.c",
          "src/low-level/imap/mailimap_socket.c",
          "src/low-level/imap/mailimap_oauth2.c",
          "src/low-level/imap/mailimap_compress.c",
          "src/low-level/imap/quota.c",
          "src/low-level/imap/condstore.c",
          "src/low-level/imap/qresync.c",
          "src/low-level/imap/idle.c"
        ]
      },
      {
        "name": "SMTP 协议支持",
        "description": "通过 SMTP 协议发送邮件，支持基本的邮件投递、TLS/SSL 安全连接、SASL 认证和 OAuth2 认证。",
        "evidence": [
          "src/low-level/smtp/mailsmtp.c",
          "src/low-level/smtp/mailsmtp_ssl.c",
          "src/low-level/smtp/mailsmtp_socket.c",
          "src/low-level/smtp/mailsmtp_oauth2.c"
        ]
      },
      {
        "name": "POP3 协议支持",
        "description": "通过 POP3 协议从邮件服务器下载邮件，支持连接、认证、邮件列表获取和下载操作。",
        "evidence": [
          "src/low-level/pop3/mailpop3.c",
          "src/low-level/pop3/mailpop3_ssl.c",
          "src/low-level/pop3/mailpop3_socket.c"
        ]
      },
      {
        "name": "NNTP 协议支持",
        "description": "通过 NNTP 协议访问新闻组服务器，支持新闻组浏览、文章获取和投递。",
        "evidence": [
          "src/low-level/nntp/newsnntp.c",
          "src/low-level/nntp/newsnntp_ssl.c",
          "src/low-level/nntp/newsnntp_socket.c"
        ]
      },
      {
        "name": "MIME 消息构建与解析",
        "description": "构建和解析符合 RFC822/MIME 标准的邮件消息，包括支持 multipart 结构、附件处理、内容传输编码（base64/quoted-printable/7bit/8bit）和字符集处理。",
        "evidence": [
          "src/low-level/mime/mailmime.c",
          "src/low-level/mime/mailmime_types.c",
          "src/low-level/mime/mailmime_content.c",
          "src/low-level/mime/mailmime_disposition.c",
          "src/low-level/mime/mailmime_decode.c",
          "src/low-level/imf/mailimf.c"
        ]
      },
      {
        "name": "本地邮件存储",
        "description": "支持本地邮件存储格式的读写，包括 mbox（单文件存储）、MH（每封邮件一个文件）和 maildir（按目录存储），便于离线邮件管理和本地缓存。",
        "evidence": [
          "src/low-level/mbox/mailmbox.c",
          "src/low-level/mh/mailmh.c",
          "src/low-level/maildir/maildir.c"
        ]
      },
      {
        "name": "邮件隐私与加密（PGP/SMIME）",
        "description": "支持邮件内容的加密和签名处理，包括 PGP（GnuPG）加解密和 S/MIME 处理，通过外部 GnuPG 或 OpenSSL 完成密钥操作。",
        "evidence": [
          "src/engine/mailprivacy.c",
          "src/engine/mailprivacy_gnupg.c",
          "src/engine/mailprivacy_smime.c"
        ]
      }
    ],
    "domain": "网络通讯/邮件",
    "target_users": "需要集成多协议邮件处理能力的 C/C++ 应用程序开发者",
    "ecosystem": "cpp"
