  "function_summary": {
    "summary": "execa 是一个 Node.js 子进程执行库，以 Promise 和模板字符串语法封装了 node:child_process，提供更安全、更易用的跨平台命令行运行体验。免去手动转义、路径解析、Windows 兼容性处理等繁琐工作，支持同步/异步执行、管道编排、IPC 通信、流式 I/O 转换、超时与优雅终止等高级功能。面向 Node.js 应用开发者，目标是替代手写 child_process.spawn/exec，让进程调用像普通函数一样简单。",
    "categories": [
      {
        "name": "子进程执行",
        "description": "提供 execa()、execaSync()、$ 等入口，支持模板字符串语法、显式 file+args、Shell 执行等多种调用方式；自动处理命令查找、PATHEXT 解析、Windows shebang 支持。",
        "evidence": [
          "index.js:9-12",
          "lib/methods/main-async.js:25-46",
          "lib/methods/main-sync.js:16-29",
          "lib/arguments/command-file.js:11-21"
        ]
      },
      {
        "name": "进程管道编排",
        "description": "支持 pipe() 方法进行多进程串联/并联，可获取中间结果、多源合并、一对多/多对一管道，类似 shell 管道但提供编程式控制和结构化结果。",
        "evidence": [
          "lib/pipe/setup.js",
          "lib/pipe/streaming.js",
          "lib/pipe/sequence.js",
          "lib/pipe/pipe-arguments.js"
        ]
      },
      {
        "name": "进程间通信（IPC）",
        "description": "提供 sendMessage/getOneMessage/getEachMessage 等方法与子进程进行结构化消息交换，支持任意类型数据（不限于 JSON）；同时支持 cancelSignal 远程取消。",
        "evidence": [
          "lib/ipc/methods.js",
          "lib/ipc/send.js",
          "lib/ipc/incoming.js",
          "lib/ipc/outgoing.js",
          "lib/ipc/get-one.js",
          "lib/ipc/get-each.js"
        ]
      },
      {
        "name": "输入输出处理",
        "description": "支持多种输入（字符串、Uint8Array、文件、迭代器、Web Streams、Node.js Streams、对象模式）和多种输出（文本行分割、二进制、文件重定向、流式返回），提供 Transform 变换/过滤管线。",
        "evidence": [
          "lib/io/contents.js",
          "lib/io/output-async.js",
          "lib/io/output-sync.js",
          "lib/io/input-sync.js",
          "lib/io/iterate.js",
          "lib/io/strip-newline.js",
          "lib/io/pipeline.js"
        ]
      },
      {
        "name": "进程生命周期管理",
        "description": "支持超时自动终止（timeout）、优雅取消（gracefulCancel + cancelSignal）、强制终止（forceKillAfterDelay + SIGKILL）、信号处理、进程清理（cleanupOnExit）。",
        "evidence": [
          "lib/terminate/kill.js",
          "lib/terminate/timeout.js",
          "lib/terminate/cancel.js",
          "lib/terminate/graceful.js",
          "lib/terminate/cleanup.js",
          "lib/terminate/signal.js"
        ]
      },
      {
        "name": "Windows 兼容性",
        "description": "全面处理 Windows 下 cmd.exe 的差异：文件路径解析、PATHEXT 扩展名补全、cmd.exe 元字符转义（caret 前缀）、cmd 和 bat 文件的二次转义、shebang 脚本模拟执行、windowsHide 窗口隐藏。",
        "evidence": [
          "lib/arguments/command-file.js:29-59",
          "lib/arguments/escape.js:78-86",
          "lib/arguments/options.js:40-43"
        ]
      },
      {
        "name": "调试与错误报告",
        "description": "提供详细的 ExecaError（含命令、逃逸命令、退出码、信号、超时/取消/缓冲区溢出标识、完整 stdio 输出、持续时长）、verbose 模式（逐行子进程输出）和自定义日志回调。",
        "evidence": [
          "lib/return/final-error.js",
          "lib/return/result.js",
          "lib/return/reject.js",
          "lib/return/duration.js",
          "lib/verbose/"
        ]
      }
    ],
    "domain": "系统管理 / 进程编排",
    "target_users": "Node.js 应用开发者",
    "ecosystem": "nodejs"
  },
