  "function_summary": {
    "summary": "execa 是一个 Node.js 进程执行库，面向需要从脚本/应用中启动外部命令的开发场景。它在 Node 核心 child_process 模块之上提供了更友好的 API：模板字符串风格调用（execa`cmd`）、自动转义防注入、Promise/异步迭代支持、管道连接多个子进程、流式读写与转换、以及跨平台（Linux/macOS/Windows）适配。主要使用对象是需要可靠地在程序中执行外部命令并获取输出的 Node.js 开发者。",
    "categories": [
      {
        "name": "进程启动与参数管理",
        "description": "提供多种调用方式（execa(file, args, options)、execNode、模板字符串 $），自动处理命令行转义与选项合并，支持超时、信号、环境变量、cwd 等控制。",
        "evidence": [
          "lib/methods/create.js",
          "lib/methods/main-async.js",
          "lib/arguments/options.js"
        ]
      },
      {
        "name": "输入输出流处理",
        "description": "支持从文件、字符串、Buffer、可迭代对象、Node 流或 Web 流输入数据；输出可重定向到文件或消费为字符串、行、流或 JSON；提供 stripFinalNewline、编码转换等后处理。",
        "evidence": [
          "lib/stdio/handle-async.js",
          "lib/io/output-async.js",
          "lib/transform/generator.js"
        ]
      },
      {
        "name": "子进程管道",
        "description": "pipe() API 以类似 shell 管道的风格连接多个子进程，支持一对多、多对一的拓扑，各子进程的结果可在管道中获取。",
        "evidence": [
          "lib/pipe/setup.js",
          "lib/pipe/streaming.js"
        ]
      },
      {
        "name": "进程终止与环境适应",
        "description": "支持 gracefulCancel（优雅终止）、forceKillAfterDelay（强制终结）以及 killDescendants（杀掉整个进程树）；对 Windows 以 taskkill 兜底，对 Unix 用 process group。",
        "evidence": [
          "lib/terminate/kill.js",
          "lib/terminate/kill-descendants.js",
          "lib/terminate/graceful.js"
        ]
      },
      {
        "name": "IPC 交互",
        "description": "通过 sendMessage/getOneMessage/getEachMessage 与子进程进行双向消息传递。",
        "evidence": [
          "lib/ipc/methods.js",
          "lib/ipc/outgoing.js"
        ]
      }
    ],
    "domain": "开发工具/系统交互",
    "target_users": "Node.js 应用与脚本开发者",
    "ecosystem": "nodejs"
  },
