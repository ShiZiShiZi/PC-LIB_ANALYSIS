  "function_summary": {
    "summary": "BouncyCastle.Cryptography 是 Bouncy Castle 的 .NET 实现，为 .NET 应用开发者提供完整的密码学算法与安全协议库。涵盖对称/非对称加密、哈希与 MAC 算法、数字签名、密钥协商、TLS/DTLS 安全传输、CMS/PKCS 加解密、OpenPGP 支持、X.509 证书生成与验证、TSP 时间戳等，并包含 ML-DSA、ML-KEM、SLH-DSA 等 NIST 后量子密码（PQC）标准化候选算法的实验性实现。",
    "categories": [
      {
        "name": "对称加密与分组密码",
        "description": "提供 AES（含 AES-NI 硬件加速）、ChaCha20/Salsa20、Camellia、DES、IDEA、RC2/RC4 等对称加密引擎，支持 CBC/GCM/CCM/CTR 等工作模式与多种填充方案",
        "evidence": [
          "crypto/src/crypto/engines/",
          "crypto/src/crypto/modes/",
          "crypto/src/crypto/paddings/"
        ]
      },
      {
        "name": "非对称加密与密钥协商",
        "description": "实现 RSA、EC（椭圆曲线，含 X25519/X448、Ed25519/Ed448）、ElGamal、DSA 等非对称算法，以及 ECDH/ECDSA 密钥协商与签名",
        "evidence": [
          "crypto/src/crypto/generators/",
          "crypto/src/crypto/agreement/",
          "crypto/src/math/ec/"
        ]
      },
      {
        "name": "哈希与消息认证码",
        "description": "提供 SHA-1/SHA-2/SHA-3、BLAKE2/BLAKE3、SM3、Keccak 等哈希算法及 HMAC、CMAC、Poly1305 等消息认证码",
        "evidence": [
          "crypto/src/crypto/digests/",
          "crypto/src/crypto/macs/"
        ]
      },
      {
        "name": "后量子密码算法（PQC）",
        "description": "实验性实现 NIST PQC 候选算法：ML-DSA (CRYSTALS-Dilithium)、ML-KEM (CRYSTALS-Kyber)、SLH-DSA (SPHINCS+)、Falcon、Classic McEliece、FrodoKEM、NTRU 等",
        "evidence": [
          "crypto/src/pqc/"
        ]
      },
      {
        "name": "TLS/DTLS 安全传输协议",
        "description": "完整实现 TLS 与 DTLS 协议栈，支持多种密码套件协商、会话管理、证书验证与安全传输",
        "evidence": [
          "crypto/src/tls/"
        ]
      },
      {
        "name": "PKI 与证书管理",
        "description": "X.509 证书生成/解析/验证、PKCS#7/CMS 加密消息语法、PKCS#10 证书请求、PKCS#12 密钥库、OCSP 在线证书状态协议、CRMF 证书请求消息格式",
        "evidence": [
          "crypto/src/x509/",
          "crypto/src/pkix/",
          "crypto/src/cms/",
          "crypto/src/pkcs/",
          "crypto/src/ocsp/",
          "crypto/src/crmf/"
        ]
      },
      {
        "name": "OpenPGP 与安全工具",
        "description": "OpenPGP (RFC 4880) 消息加密/签名、ASN.1 编解码器、大整数与椭圆曲线数学运算、安全随机数生成",
        "evidence": [
          "crypto/src/openpgp/",
          "crypto/src/asn1/",
          "crypto/src/math/",
          "crypto/src/security/"
        ]
      }
    ],
    "domain": "信息安全与密码学",
    "target_users": ".NET 应用开发者与安全库集成者"
  },
