  "function_summary": {
    "summary": "CommonServiceLocator（通用服务定位器）是一个轻量级 .NET 接口库，为依赖注入（DI）容器与服务定位器模式提供统一抽象。它定义了 IServiceLocator 接口，封装 GetInstance / GetAllInstances 等服务解析方法，并提供 ServiceLocatorImplBase 基类和全局静态 ServiceLocator.Current 门面，让应用代码通过统一 API 间接调用底层 IoC 容器，无需硬绑定特定容器实现。该库是 .NET 生态中 IoC 容器互操作性的经典桥梁。",
    "categories": [
      {
        "name": "服务定位器抽象接口",
        "description": "定义 IServiceLocator 接口，提供按类型和可选名称获取服务实例的核心方法（GetInstance、GetAllInstances），规范了返回值和异常语义。",
        "evidence": [
          "src/IServiceLocator.cs"
        ]
      },
      {
        "name": "服务定位器基类实现",
        "description": "提供 ServiceLocatorImplBase 抽象基类，封装了方法重载解析、异常包装等样板逻辑。实现者仅需重写 DoGetInstance 与 DoGetAllInstances 两个抽象方法即可适配任意 DI 容器。",
        "evidence": [
          "src/ServiceLocatorImplBase.cs"
        ]
      },
      {
        "name": "全局静态门面",
        "description": "通过 ServiceLocator.Current 静态属性和 SetLocatorProvider 方法提供全局服务定位器访问点，使得不直接持有容器引用的代码也能解析服务。",
        "evidence": [
          "src/ServiceLocator.cs",
          "src/ServiceLocatorProvider.cs"
        ]
      },
      {
        "name": "统一异常模型",
        "description": "定义 ActivationException 异常类及其序列化支持，所有服务解析失败均通过该异常类型报告，统一了不同容器的错误处理约定。",
        "evidence": [
          "src/Exceptions/ActivationException.cs",
          "src/Exceptions/ActivationException.Desktop.cs"
        ]
      }
    ],
    "domain": "依赖注入与服务架构",
    "target_users": ".NET 应用与框架开发者，需要统一解耦不同 IoC 容器（如 Unity、Autofac、StructureMap）的代码库",
    "ecosystem": "dotnet"
  },
