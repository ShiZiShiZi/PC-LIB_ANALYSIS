  "function_summary": {
    "summary": "这是一个128位复数（Complex128）构造函数，属于stdlib标准库的数学模块。它提供JavaScript环境下的双精度复数类型定义，复数由实部和虚部两个双精度浮点数组成。底层通过C语言实现核心数值操作以保证性能，上层封装为JavaScript接口供Node.js和浏览器环境直接调用。面向需要高性能复数运算的数值计算、科学计算及工程应用开发者。",
    "categories": [
      {
        "name": "复数类型构造",
        "description": "创建128位复数实例，接收实部（real）和虚部（imag）两个双精度浮点数参数，返回不可变的Complex128对象。提供C绑定层以加速底层数值存储。",
        "evidence": [
          "lib/main.js:48-61（Complex128构造函数）",
          "src/main.c:33-38（stdlib_complex128 C实现）",
          "include/stdlib/complex/float64/ctor.h:39（double complex类型定义）"
        ]
      },
      {
        "name": "复数属性访问",
        "description": "提供只读属性访问复数实例的实部（re）和虚部（im），以及静态属性BYTES_PER_ELEMENT（每个分量占用字节数）和实例属性byteLength（复数总字节数）。",
        "evidence": [
          "lib/main.js:58-59（re/im属性设置）",
          "lib/main.js:76-122（name/BYTES_PER_ELEMENT/byteLength静态属性）"
        ]
      },
      {
        "name": "复数序列化与表示",
        "description": "支持将复数序列化为字符串（如'5 + 3i'、'-5 - 3i'）和JSON格式（{type:'Complex128', re:..., im:...}），便于调试和持久化存储。",
        "evidence": [
          "lib/tostring.js:27-37（toString实现）",
          "lib/tojson.js:27-34（toJSON实现）"
        ]
      },
      {
        "name": "跨类型转换（C层）",
        "description": "C实现层提供从多种数值类型（float32、float64、int8/uint8/int16/uint16/int32/uint32、complex64）到complex128的类型转换函数。",
        "evidence": [
          "src/main.c:49-54（float32→complex128）",
          "src/main.c:65-70（float64→complex128）",
          "src/main.c:84-89（complex64→complex128）",
          "src/main.c:119-204（各整数类型转换）"
        ]
      }
    ],
    "domain": "数值计算 / 数学库",
    "target_users": "JavaScript/Node.js数值计算开发者、科学计算工程师，需要在JavaScript中进行高性能复数运算的用户"
  },
