  "function_summary": {
    "summary": "Generator.Equals 是一个基于 Roslyn 的 C# 增量源代码生成器（IIncrementalGenerator），通过编译期特性注解自动生成类型的相等性比较代码。开发者在 class/struct/record 上标注 [Equatable] 特性，生成器即在编译时插入 IEquatable<T> 实现、重写的 Equals/GetHashCode 以及 ==/!= 运算符，无需手写样板代码。支持集合深度比较（有序/无序/集合相等）、字符串比较选项、浮点容差比较、自定义比较器、引用相等与忽略字段等多种属性化配置，并提供 Inequalities() 方法输出两个实例的结构化差异诊断。",
    "categories": [
      {
        "name": "相等性代码生成",
        "description": "编译期根据 [Equatable] 特性注解自动生成 IEquatable<T> 实现，包括 Equals(T)、Equals(object)、GetHashCode 与 ==/!= 运算符，支持 class/struct/record/record struct 四种类型以及继承层次中的 base.Equals 链式调用",
        "evidence": [
          "Generator.Equals/EqualsGenerator.cs",
          "Generator.Equals/EqualityGeneratorBase.cs",
          "Generator.Equals/Generators/ClassEqualityGenerator.cs",
          "Generator.Equals/Generators/StructEqualityGenerator.cs",
          "Generator.Equals/Generators/RecordEqualityGenerator.cs",
          "Generator.Equals/Generators/RecordStructEqualityGenerator.cs"
        ]
      },
      {
        "name": "集合深度比较",
        "description": "提供 [OrderedEquality]、[UnorderedEquality]、[SetEquality] 特性，支持对集合属性进行按值比较而非引用比较，覆盖数组、列表、字典、集合等 IEnumerable<T> 类型",
        "evidence": [
          "Generator.Equals.Runtime/OrderedEqualityComparer.cs",
          "Generator.Equals.Runtime/UnorderedEqualityComparer.cs",
          "Generator.Equals.Runtime/SetEqualityComparer.cs",
          "Generator.Equals.Runtime/DictionaryEqualityComparer.cs"
        ]
      },
      {
        "name": "相等性自定义配置",
        "description": "通过 [CustomEquality]、[StringEquality]、[PrecisionEquality]、[ReferenceEquality]、[IgnoreEquality]、[DefaultEquality] 等特性按属性/字段粒度为每个成员指定比较策略",
        "evidence": [
          "Generator.Equals.Runtime/Attributes.cs",
          "Generator.Equals.Runtime/DefaultEqualityComparer.cs",
          "Generator.Equals.Runtime/ReferenceEqualityComparer.cs"
        ]
      },
      {
        "name": "结构化差异诊断",
        "description": "为每个 [Equatable] 类型生成 EqualityComparer 并暴露 Inequalities() 方法，返回两个实例间所有差异字段的完整路径（含嵌套对象、集合索引、字典键），支持自动深入嵌套的 [Equatable] 类型",
        "evidence": [
          "Generator.Equals.Runtime/Inequality.cs",
          "Generator.Equals.Runtime/MemberPath.cs",
          "Generator.Equals.Runtime/MemberPathSegment.cs",
          "Generator.Equals/EqualityGeneratorBase.cs"
        ]
      },
      {
        "name": "编译期诊断分析器",
        "description": "配套 Roslyn 分析器（DiagnosticAnalyzer），在编辑器中实时提供代码修复建议，包括为类型添加 [Equatable] 特性、标记为 partial、为属性添加相等性特性等",
        "evidence": [
          "Generator.Equals/Analyzers/EquatableAnalyzer.cs",
          "Generator.Equals/Analyzers/DiagnosticDescriptors.cs",
          "Generator.Equals/Analyzers/CodeFixes/AddEquatableAttributeCodeFix.cs",
          "Generator.Equals/Analyzers/CodeFixes/MakeTypePartialCodeFix.cs"
        ]
      }
    ],
    "domain": "开发工具 — 代码生成",
    "target_users": ".NET/C# 应用与库开发者"
  },
