  "function_summary": {
    "summary": "vo-amrwbenc 是 AMR-WB（自适应多速率宽带）语音编码器的 C 语言实现库，最初源自 Android Stagefright 框架的 VisualOn 实现。该库将 16kHz 采样的单声道 PCM 线性语音输入压缩为 6.60–23.85kbps 九种比特率之一的 AMR-WB 码流输出，支持 RFC3267 和 ITU 两种帧格式。面向需要在嵌入式、移动或桌面平台上编码窄带/宽带语音的 C/C++ 应用开发者。",
    "categories": [
      {
        "name": "AMR-WB 语音编码核心",
        "description": "实现 AMR-WB 全速率编码算法：线性预测分析、自适应码本搜索、固定码本搜索、增益量化等全套 CELP 流程，支持九种比特率模式（6.60–23.85kbps）和 RFC3267/ITU 帧封装格式",
        "evidence": [
          "amrwbenc/src/voAMRWBEnc.c"
        ]
      },
      {
        "name": "C 语言编码器 API",
        "description": "提供两套调用接口：低层 VO_AUDIO_CODECAPI 结构体（通过 voGetAMRWBEncAPI 填充 Init/SetInputData/GetOutputData/SetParam/Uninit 函数指针）和高层简化封装 E_IF_init/E_IF_encode/E_IF_exit",
        "evidence": [
          "amrwbenc/src/voAMRWBEnc.c:1927",
          "wrapper.c",
          "enc_if.h"
        ]
      },
      {
        "name": "ARM 平台 SIMD 加速",
        "description": "针对 ARMv5E 和 ARMv7 NEON 提供汇编优化路径：ARMv5E 定点 DSP 级汇编加速、ARMv7 NEON SIMD 加速卷积/滤波/相关计算等热路径",
        "evidence": [
          "amrwbenc/src/asm/ARMV5E/*.s",
          "amrwbenc/src/asm/ARMV7/*.s"
        ]
      }
    ],
    "domain": "音频编解码",
    "target_users": "C/C++ 应用开发者（嵌入式、移动端、桌面端）"
  },
