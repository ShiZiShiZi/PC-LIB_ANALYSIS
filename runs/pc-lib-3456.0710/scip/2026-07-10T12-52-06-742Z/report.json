  "function_summary": {
    "summary": "SCIP 是一个高性能的开源混合整数规划（MIP）和混合整数非线性规划（MINLP）求解框架，由柏林 Zuse 研究所（ZIB）开发。除了作为求解器外，SCIP 还提供约束整数规划、分支-切割-定价（branch-cut-and-price）的灵活框架，支持通过插件系统扩展求解算法。其核心用 C/C++ 编写，通过 CMake 构建，可链接多种 LP 后端求解器（SoPlex、CPLEX、Gurobi、HiGHS 等），并支持精确有理数求解模式。附带命令行可执行文件 `scip` 用于交互式或批处理求解 MIP/MINLP 问题。",
    "categories": [
      {
        "name": "混合整数规划求解引擎",
        "description": "核心 MIP 与 MINLP 求解器，通过分支定界（branch-and-bound）、割平面（cutting plane）、分支定价（branch-and-price）等算法求解线性/非线性混合整数优化问题",
        "evidence": [
          "src/scip/solve.c",
          "src/scip/scip_solve.h",
          "src/scip/branch.c"
        ]
      },
      {
        "name": "精确有理数求解",
        "description": "可选启用精确有理数算术的求解模式，依赖 GMP 与 MPFR 库，在数值上严格验证最优性或不可行性",
        "evidence": [
          "src/lpiexact/lpiexact_spx.cpp",
          "src/scip/cons_exactsol.c",
          "src/scip/rational.cpp"
        ]
      },
      {
        "name": "可扩展插件系统",
        "description": "通过 plugins 框架支持用户自定义分支规则、启发式、割平面生成器、约束处理、节点选择等求解组件，支持运行时加载动态库",
        "evidence": [
          "src/scip/scipdefplugins.h",
          "src/scip/scipcoreplugins.h",
          "src/scip/heur_*.c"
        ]
      },
      {
        "name": "LP 后端抽象层",
        "description": "抽象 LP 求解器接口（LPI），可在编译时选择 SoPlex（推荐）/CPLEX/Gurobi/XPRESS/MOSEK/CLP/HiGHS 等作为底层线性规划后端",
        "evidence": [
          "src/lpi/lpi.h",
          "src/lpi/lpi_spx.cpp",
          "src/lpi/lpi_grb.c"
        ]
      },
      {
        "name": "命令行交互与 API",
        "description": "提供 `scip` 命令行可执行文件（支持交互式 shell 与批处理模式读取 .mps/.lp/.cip 等格式），以及 C 头文件 `scip.h` 的公共 API",
        "evidence": [
          "src/main.c",
          "src/scip/scipshell.c",
          "src/scip/scip.h"
        ]
      }
    ],
    "domain": "运筹优化",
    "target_users": "运筹学研究者、优化工程师、需要求解 MIP/MINLP 问题的工业/学术用户"
  },
