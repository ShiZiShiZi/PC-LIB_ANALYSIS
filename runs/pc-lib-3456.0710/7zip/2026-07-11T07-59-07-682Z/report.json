  "function_summary": {
    "summary": "7-Zip 是一款由 Igor Pavlov 开发的高压缩率文件归档工具，支持创建和提取 7z/XZ/BZIP2/GZIP/TAR/WIM/ZIP 等多种格式的压缩文件。它既是被终端用户直接使用的桌面应用程序（提供 GUI 文件管理器、命令行工具和 Windows Shell 右键菜单扩展），也被其他软件通过 CLI 或 DLL 接口调用。核心特色在于自研的 LZMA/LZMA2 压缩算法，在压缩率和速度上独具优势。",
    "categories": [
      {
        "name": "多格式压缩与解压",
        "description": "支持创建和提取 7z/XZ/LZMA2/ZIP/GZIP/BZIP2/TAR/WIM/CAB/ARJ/DMG/RAR 等主流格式的归档文件，并提供 AES-256 加密、分卷压缩和自解压 EXE 构建能力。",
        "evidence": [
          "CPP/7zip/Archive/",
          "CPP/7zip/Compress/",
          "CPP/7zip/Crypto/7zAes.cpp"
        ]
      },
      {
        "name": "桌面 GUI 文件管理器",
        "description": "提供 Windows 原生 GUI 文件管理界面（7zFM.exe），支持双面板浏览、拖拽操作、右键菜单集成和文件属性查看。",
        "evidence": [
          "CPP/7zip/UI/FileManager/",
          "CPP/7zip/UI/GUI/"
        ]
      },
      {
        "name": "命令行工具",
        "description": "提供 7z.exe/7za.exe/7zz.exe 命令行工具，支持脚本化批量压缩、解压、测试和基准测试，适用于 CI/CD 和自动化场景。",
        "evidence": [
          "CPP/7zip/UI/Console/Main.cpp",
          "CPP/7zip/Bundles/Alone/",
          "CPP/7zip/Bundles/Alone2/"
        ]
      },
      {
        "name": "Windows Shell 集成",
        "description": "通过 COM DLL 集成到 Windows 资源管理器右键菜单（上下文菜单扩展），提供“压缩到 7z/ZIP”和“提取到此处”等快捷操作，支持图标叠加等 Shell 扩展。",
        "evidence": [
          "CPP/7zip/UI/Explorer/ContextMenu.cpp",
          "CPP/7zip/UI/Explorer/RegistryContextMenu.cpp"
        ]
      },
      {
        "name": "高压缩比算法",
        "description": "自研 LZMA/LZMA2 压缩算法及 LZMA SDK（公有领域），提供高压缩比词典压缩、多线程压缩/解压和基准测试功能，是 7z 格式的核心竞争力。",
        "evidence": [
          "C/LzmaEnc.c",
          "C/LzmaDec.c",
          "C/LzFind.c"
        ]
      }
    ],
    "domain": "文件压缩与归档",
    "target_users": "桌面用户、系统管理员、开发者和 CI/CD 自动化脚本"
  },
