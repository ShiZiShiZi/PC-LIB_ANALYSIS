  "function_summary": {
    "summary": "Codec2 是一个低比特率语音编解码器（1.2–3.2 kbps），同时提供 FreeDV API —— 一套面向 HF/VHF 业余无线电的数字语音与数据通信协议栈。库的核心功能包括：正弦语音合成编解码（Codec2 多模式）、基于 OFDM 和 FSK 的 HF/VHF 调制解调器、前向纠错（FEC，含 LDPC、Golay 码）、以及 FreeDV API（封装编解码+调制解调）。还包含 STM32 嵌入式硬件实现（SM1000 适配器）和 LPCNet 神经网络语音合成可选集成。",
    "categories": [
      {
        "name": "语音编解码",
        "description": "基于正弦模型的低比特率语音编解码器，支持多种模式（700C/1200/1300/1400/1600/2400/3200 bps），采用 LPC 分析、基频估计、矢量和标量量化、后置滤波等技术",
        "keywords": [
          "speech codec",
          "LPC",
          "sinusoidal synthesis",
          "quantization",
          "pitch estimation"
        ]
      },
      {
        "name": "数字语音通信",
        "description": "FreeDV 数字语音协议栈，将语音编解码与调制解调器、FEC 集成，实现端到端语音 over HF/VHF 无线电传输",
        "keywords": [
          "digital voice",
          "FreeDV",
          "HF radio",
          "VHF radio",
          "FEC"
        ]
      },
      {
        "name": "调制解调器",
        "description": "OFDM（4800/2400/1200/800 Hz 带宽模式）和 FSK（2FSK/4FSK）调制解调器，用于 HF 多径信道和 VHF/UHF 视距信道的数据传输",
        "keywords": [
          "OFDM",
          "FSK",
          "modem",
          "modulation",
          "demodulation"
        ]
      },
      {
        "name": "信道编码与前向纠错",
        "description": "包含 LDPC 码（多种码率）、Golay (23,12) 码、CRC-16 校验等信道编解码，保障无线信道下的数据传输可靠性",
        "keywords": [
          "LDPC",
          "FEC",
          "Golay",
          "error correction",
          "channel coding"
        ]
      },
      {
        "name": "嵌入式实现",
        "description": "面向 STM32F4 微控制器的 FreeDV 1600/700D/700E 嵌入式固件，包含硬件驱动（ADC/DAC/I2S/USB）",
        "keywords": [
          "STM32",
          "embedded",
          "ARM Cortex-M4",
          "SM1000",
          "microcontroller"
        ]
      },
      {
        "name": "可选神经网络语音合成",
        "description": "通过可选集成 LPCNet（基于神经网络的低比特率语音合成）支持 FreeDV 2020 模式",
        "keywords": [
          "LPCNet",
          "neural vocoder",
          "speech synthesis"
        ]
      }
    ],
    "domain": "业余无线电数字语音与数据通信",
    "target_users": "业余无线电爱好者、HF/VHF 数字语音通信系统开发者、嵌入式无线电设备制造商"
  },
