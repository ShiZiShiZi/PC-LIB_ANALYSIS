  "native_api": {
    "summary": "基于 Java SE 标准库的跨平台 I/O 库；通过反射访问 sun.misc.Unsafe/sun.nio.ch.DirectBuffer 以优化直接内存清理，其他均为标准 java.io/java.nio 调用",
    "groups": [
      {
        "type": "java_standard_io",
        "category": "standard",
        "platform": "portable",
        "apis": [
          {
            "name": "java.io.InputStream/OutputStream/Reader/Writer",
            "purpose": "Java 标准 I/O 流，整个库基于这些流进行增强封装",
            "evidence": [
              "src/main/java/org/apache/commons/io/IOUtils.java",
              "src/main/java/org/apache/commons/io/input/BufferedFileChannelInputStream.java"
            ]
          },
          {
            "name": "java.nio.ByteBuffer/CharBuffer",
            "purpose": "直接缓冲区操作，避免 JVM 堆与本地内存之间的数据拷贝",
            "evidence": [
              "src/main/java/org/apache/commons/io/input/BufferedFileChannelInputStream.java:93",
              "src/main/java/org/apache/commons/io/Buffers.java:22-31"
            ]
          },
          {
            "name": "java.nio.channels.FileChannel",
            "purpose": "以 NIO channel 方式读写文件，支持 position/truncate 等随机访问操作",
            "evidence": [
              "src/main/java/org/apache/commons/io/input/BufferedFileChannelInputStream.java:21",
              "src/main/java/org/apache/commons/io/channels/FileChannels.java"
            ]
          },
          {
            "name": "java.nio.file.Files/Path",
            "purpose": "Java NIO.2 跨平台文件系统操作：walk/copy/move 等方法的基础依赖",
            "evidence": [
              "src/main/java/org/apache/commons/io/file/PathUtils.java",
              "src/main/java/org/apache/commons/io/FileUtils.java"
            ]
          },
          {
            "name": "java.net.URL/URLConnection/HttpURLConnection",
            "purpose": "通过 URL 打开远程流（IOUtils 支持直接从 URL 读取内容）",
            "evidence": [
              "src/main/java/org/apache/commons/io/IOUtils.java:39-44"
            ]
          }
        ]
      },
      {
        "type": "jdk_internal_reflect",
        "category": "platform",
        "platform": "portable",
        "apis": [
          {
            "name": "sun.misc.Unsafe.invokeCleaner",
            "purpose": "通过反射调用 Unsafe.invokeCleaner 释放 DirectByteBuffer 对应的本地内存，避免依赖 GC 延迟回收导致 OOM",
            "conditional": false,
            "evidence": [
              "src/main/java/org/apache/commons/io/input/ByteBufferCleaner.java:69-78"
            ]
          },
          {
            "name": "sun.nio.ch.DirectBuffer.cleaner",
            "purpose": "通过反射获取 DirectByteBuffer 的 Cleaner 对象（Java 8 路径），用于主动释放堆外内存",
            "conditional": true,
            "evidence": [
              "src/main/java/org/apache/commons/io/input/ByteBufferCleaner.java:50-51"
            ]
          },
          {
            "name": "sun.misc.Cleaner.clean",
            "purpose": "通过反射调用 Cleaner.clean() 方法（Java 8 路径），主动触发 DirectByteBuffer 堆外内存回收",
            "conditional": true,
            "evidence": [
              "src/main/java/org/apache/commons/io/input/ByteBufferCleaner.java:50,56-58"
            ]
          }
        ],
        "notes": "这些 sun.* 调用通过反射进行，且有降级路径：Java 8 用 sun.misc.Cleaner，Java 9+ 用 Unsafe.invokeCleaner，如果两者都不可用则抛异常。这不是 API 调用，而是运行时通过反射探测。不影响在 JDK 17（鸿蒙 PC 已移植版本）上的功能。"
      }
    ],
