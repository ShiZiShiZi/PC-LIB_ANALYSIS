  "function_summary": {
    "summary": "Apache Commons IO 是 Apache 基金会维护的 Java I/O 实用工具库，提供标准 JDK java.io/java.nio 之外的增强流实现、文件过滤器、文件比较器、字节序转换、文件监控、尾随读取和内存映射等工具类。它为 Java 开发者补充了 JDK 未内置的常见 I/O 模式，例如将整个流内容一次性读到字符串、安全的文件复制/删除、递归目录遍历等。项目要求 Java 8 以上运行环境，是 Maven Central 上使用广泛的 I/O 基础库。",
    "categories": [
      {
        "name": "增强流实现",
        "description": "提供 BufferedFileChannelInputStream（基于 NIO DirectBuffer 直达内核）、BOM 感知流、可观察/计数/节流流、关闭屏蔽流、代理流等 JDK 未内置的流实现",
        "evidence": [
          "src/main/java/org/apache/commons/io/input/BufferedFileChannelInputStream.java",
          "src/main/java/org/apache/commons/io/input/BOMInputStream.java",
          "src/main/java/org/apache/commons/io/input/ObservableInputStream.java",
          "src/main/java/org/apache/commons/io/input/CloseShieldInputStream.java"
        ]
      },
      {
        "name": "流工具类（IOUtils/IO）",
        "description": "将整个流/Reader/Writer 内容读到字符串/字节数组、流间复制、批量关闭、跳过/读取等一站式静态工具方法，覆盖了日常 I/O 编码高频模式",
        "evidence": [
          "src/main/java/org/apache/commons/io/IOUtils.java",
          "src/main/java/org/apache/commons/io/IO.java"
        ]
      },
      {
        "name": "文件操作与路径处理",
        "description": "增强文件与目录操作：递归复制/移动/删除目录、创建/清空目录、文件元数据读取、符号链接处理、文件大小单位换算（FileUtils/PathUtils）",
        "evidence": [
          "src/main/java/org/apache/commons/io/FileUtils.java",
          "src/main/java/org/apache/commons/io/file/PathUtils.java"
        ]
      },
      {
        "name": "文件过滤与比较",
        "description": "基于通配符、正则、大小、修改时间、隐藏属性等的文件/目录过滤器（FileFilter/PathFilter）；支持按名称/大小/修改时间的文件比较器，便于排序与选择",
        "evidence": [
          "src/main/java/org/apache/commons/io/filefilter/WildcardFileFilter.java",
          "src/main/java/org/apache/commons/io/filefilter/SizeFileFilter.java",
          "src/main/java/org/apache/commons/io/comparator/NameFileComparator.java",
          "src/main/java/org/apache/commons/io/comparator/SizeFileComparator.java"
        ]
      },
      {
        "name": "文件名处理",
        "description": "路径规范化、扩展名分离、文件名拼接、windows/unix 分隔符互转等文件名字符串处理（FilenameUtils）",
        "evidence": [
          "src/main/java/org/apache/commons/io/FilenameUtils.java"
        ]
      },
      {
        "name": "文件监控",
        "description": "基于轮询的文件/目录变更监控，检测文件创建、修改、删除事件并触发回调（FileAlterationMonitor）",
        "evidence": [
          "src/main/java/org/apache/commons/io/monitor/FileAlterationMonitor.java",
          "src/main/java/org/apache/commons/io/monitor/FileAlterationObserver.java"
        ]
      },
      {
        "name": "字节序与缓冲操作",
        "description": "大/小字节序转换、字节缓冲区安全读写、随机访问文件的增强封装等底层字节级操作",
        "evidence": [
          "src/main/java/org/apache/commons/io/EndianUtils.java",
          "src/main/java/org/apache/commons/io/ByteBuffers.java",
          "src/main/java/org/apache/commons/io/IORandomAccessFile.java"
        ]
      }
    ],
    "domain": "I/O 基础工具库",
    "target_users": "Java 应用程序与库开发者"
  },
