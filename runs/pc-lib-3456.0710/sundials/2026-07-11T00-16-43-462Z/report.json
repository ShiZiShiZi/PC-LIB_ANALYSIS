  "function_summary": {
    "summary": "SUNDIALS (SUite of Nonlinear and DIfferential/ALgebraic equation Solvers) 是一套由 Lawrence Livermore 国家实验室开发的高性能数值求解器库，提供刚性/非刚性常微分方程(ODE)、微分代数方程(DAE)以及非线性代数方程组的鲁棒高效求解。核心用 C 实现，提供 C++、Fortran 和 Python 接口，支持串行、多线程(OpenMP/Pthread)、分布式(MPI)和 GPU 加速(CUDA/HIP/SYCL)多种并行模式，主要面向需要将时间积分器和非线性求解器嵌入自有仿真代码的科学计算研究人员与数值计算应用开发者。",
    "categories": [
      {
        "name": "ODE 时间积分器",
        "description": "ARKODE(刚性/非刚性/多速率 ODE 单步法)、CVODE(刚性/非刚性 ODE)、CVODES(带正/伴随灵敏度分析)三套 ODE 求解器，各自支持多种线性求解器与雅可比策略",
        "evidence": [
          "include/arkode/arkode.h",
          "include/cvode/cvode.h",
          "include/cvodes/cvodes.h",
          "src/arkode/",
          "src/cvode/",
          "src/cvodes/"
        ]
      },
      {
        "name": "DAE 求解器",
        "description": "IDA 针对微分代数方程初值问题，IDAS 增加前向/伴随灵敏度分析功能",
        "evidence": [
          "include/ida/ida.h",
          "include/idas/idas.h",
          "src/ida/",
          "src/idas/"
        ]
      },
      {
        "name": "非线性代数求解器",
        "description": "KINSOL 求解非线性代数方程组 F(u)=0 或 G(u)=u，支持牛顿-克雷洛夫等迭代方法",
        "evidence": [
          "include/kinsol/kinsol.h",
          "src/kinsol/"
        ]
      },
      {
        "name": "向量与矩阵数据结构",
        "description": "NVECTOR 提供串行/OpenMP/Pthread/MPI/ParHyp/PETSc/CUDA/HIP/SYCL/RAJA/Trilinos 等多种并行的向量抽象；SUNMATRIX 提供稠密/稀疏/带/CUDA 稀疏/Ginkgo/KokkosDense/oneMKL 等矩阵实现",
        "evidence": [
          "include/nvector/",
          "include/sunmatrix/",
          "src/nvector/",
          "src/sunmatrix/"
        ]
      },
      {
        "name": "线性求解器与非线性求解器接口",
        "description": "SUNLINSOL 集成直接法(带/稠密/LAPACK 带/稠密/KLU/SuperLU_DIST/SuperLU_MT/Ginkgo/MAGMA/oneMKL)与迭代法(PG/SPGMR/SPFGMR/SPBCGS/SPTFQMR)；SUNNONLINSOL 提供牛顿/定点迭代策略",
        "evidence": [
          "include/sunlinsol/",
          "include/sunnonlinsol/",
          "src/sunlinsol/",
          "src/sunnonlinsol/"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "swig4py 生成 Python 绑定(sundials4py)、Fortran 2003 接口、C++ 面向对象封装",
        "evidence": [
          "bindings/sundials4py/",
          "swig/",
          "src/arkode/fmod_int32/",
          "src/cvode/fmod_int32/"
        ]
      }
    ],
