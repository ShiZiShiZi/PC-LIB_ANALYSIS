  "function_summary": {
    "summary": "rabbitmq-c 是一个用 C 语言编写的 AMQP 客户端库，供应用程序连接到 RabbitMQ 消息代理进行消息队列通信。它提供连接管理、通道操作、消息收发（发布/消费）、SSL/TLS 加密传输等核心 AMQP 功能。适用于需要在 C/C++ 项目中集成消息队列通信的后端开发者与系统集成场景。",
    "categories": [
      {
        "name": "AMQP 协议通信",
        "description": "实现 AMQP 0-9-1 协议帧的编解码与网络传输，支持连接建立、通道管理、心跳维持等底层协议操作。",
        "evidence": [
          "include/rabbitmq-c/amqp.h",
          "include/rabbitmq-c/framing.h",
          "librabbitmq/amqp_connection.c",
          "librabbitmq/amqp_framing.c"
        ]
      },
      {
        "name": "消息发布与消费",
        "description": "提供 basic.publish 消息发送与 basic.consume/basic.get 消息接收接口，支持 RPC 调用模式。",
        "evidence": [
          "include/rabbitmq-c/amqp.h",
          "librabbitmq/amqp_api.c",
          "librabbitmq/amqp_consumer.c",
          "examples/amqp_rpc_sendstring_client.c"
        ]
      },
      {
        "name": "连接与 Socket 传输",
        "description": "基于 TCP socket 的网络传输层，提供 amqp_socket_t 抽象接口，支持自定义 socket 实现。",
        "evidence": [
          "include/rabbitmq-c/tcp_socket.h",
          "librabbitmq/amqp_tcp_socket.c",
          "librabbitmq/amqp_socket.c",
          "librabbitmq/amqp_socket.h"
        ]
      },
      {
        "name": "SSL/TLS 安全传输",
        "description": "可选启用 OpenSSL 进行 TLS 加密通信，保护消息传输安全。",
        "evidence": [
          "include/rabbitmq-c/ssl_socket.h",
          "librabbitmq/amqp_openssl.c",
          "librabbitmq/amqp_openssl_bio.c",
          "CMakeLists.txt"
        ]
      },
      {
        "name": "AMQP URL 解析",
        "description": "解析 amqp:// 或 amqps:// 格式的连接 URL，提取主机、端口、虚拟主机、凭据等连接参数。",
        "evidence": [
          "librabbitmq/amqp_url.c",
          "include/rabbitmq-c/amqp.h (amqp_connection_info)"
        ]
      },
      {
        "name": "命令行工具",
        "description": "提供可选的命令行工具（publish/consume/declare_queue/delete_queue/get）用于交互式操作 RabbitMQ。",
        "evidence": [
          "tools/publish.c",
          "tools/consume.c",
          "tools/common.c"
        ]
      }
    ],
    "domain": "消息队列通信",
    "target_users": "C/C++ 系统与后端开发者"
  },
