  "function_summary": {
    "summary": "esm 是一个 Node.js 的 ECMAScript 模块(ESM)加载器，使 Node.js 6.x 及以上版本（CommonJS 环境）能够原生般地加载和运行 ES module 语法（import/export、import.meta、动态 import 等），无需 Babel 转译或 Webpack/Rollup 打包。它通过拦截 Node 的 require 钩子对源文件做轻量 AST 级改写，将 import/export 编译为可在 CJS 环境中执行的代码，同时保持与 CJS 模块的完全互操作性。适用于希望渐进式迁移到 ESM 的 Node.js 应用与库开发者。",
    "categories": [
      {
        "name": "ESM 语法编译与加载",
        "description": "解析和改写 ES module 语法（import、export、import.meta、动态 import），将其编译为 CommonJS 兼容的可执行代码，透明加载 .js 和 .mjs 文件",
        "evidence": [
          "src/compiler.js",
          "src/parser.js",
          "src/visitor/import-export.js",
          "src/visitor/require.js"
        ]
      },
      {
        "name": "模块缓存与生命周期钩子",
        "description": "拦截 Node 的 require 机制（Module._resolveFilename/_load/_extensions）、管理模块缓存、支持 require.cache 与 CJS/ESM 互操作",
        "evidence": [
          "src/hook/require.js",
          "src/hook/module.js",
          "src/module/static/load.js",
          "src/module/static/resolve-filename.js"
        ]
      },
      {
        "name": "入口配置与选项",
        "description": "支持多种配置方式——package.json 的 \"esm\" 字段、.esmrc.js/mjs/cjs/json 配置文件、环境变量 ESM_OPTIONS/ESM_DISABLE_CACHE——控制加载行为",
        "evidence": [
          "src/env/get-options.js",
          "src/env/get-flags.js",
          "src/package.js"
        ]
      },
      {
        "name": "运行时环境探测",
        "description": "识别当前执行环境（Node CLI/REPL/Electron/Jasmine/nyc/Yarn PnP 等），据此调整模块解析和加载行为",
        "evidence": [
          "src/env/is-electron.js",
          "src/env/is-electron-renderer.js",
          "src/env/is-cli.js",
          "src/env/is-repl.js",
          "src/env/is-yarn-pnp.js"
        ]
      }
    ],
    "domain": "JavaScript 模块系统与运行时工具",
    "target_users": "希望在 Node.js 6+ 中使用 ES module 语法的 JavaScript 应用与库开发者",
    "ecosystem": "nodejs"
  },
