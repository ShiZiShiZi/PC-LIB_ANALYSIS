  "function_summary": {
    "summary": "LwRB（Lightweight Ring Buffer Manager）是一个用 C11 编写的通用 FIFO 环形缓冲区库，专为嵌入式系统优化。它提供基于静态数组的无动态内存分配缓冲区，支持优化的内存拷贝、DMA 零拷贝存取、数据窥探与跳过、事件通知回调等功能，适用于单写单读管道模式下无需互斥锁即可实现线程安全的场景。",
    "categories": [
      {
        "name": "环形缓冲区（FIFO 队列）",
        "description": "提供基于静态数组的环形缓冲区 FIFO 读写接口，包括写入、读取、窥探、跳过读取、提前写入、覆写写入及缓冲区间数据搬移等操作，支持 DMA 零拷贝线性区域直接存取。",
        "evidence": [
          "lwrb/src/lwrb/lwrb.c:69-81 (lwrb_init)",
          "lwrb/src/lwrb/lwrb.c:157-165 (lwrb_write)",
          "lwrb/src/lwrb/lwrb.c:241-249 (lwrb_read)",
          "lwrb/src/lwrb/lwrb.c:321-359 (lwrb_peek)"
        ]
      },
      {
        "name": "事件通知机制",
        "description": "支持注册事件回调函数，在缓冲区发生读写或复位操作时通知用户，并可携带自定义用户参数。",
        "evidence": [
          "lwrb/src/lwrb/lwrb.c:111-116 (lwrb_set_evt_fn)",
          "lwrb/src/lwrb/lwrb.c:123-128 (lwrb_set_arg)",
          "lwrb/src/include/lwrb/lwrb.h:90 (lwrb_evt_fn typedef)"
        ]
      },
      {
        "name": "原子操作与并发安全",
        "description": "在支持原子操作的平台上可利用 C11 stdatomic 实现单写单读无锁并发安全，也可通过 LWRB_DISABLE_ATOMIC 宏禁用原子以适配资源受限 MCU。",
        "evidence": [
          "lwrb/src/include/lwrb/lwrb.h:51-68 (stdatomic 条件编译)",
          "lwrb/src/lwrb/lwrb.c:51-59 (LWRB_DISABLE_ATOMIC 分支)"
        ]
      }
    ],
    "domain": "嵌入式系统 / 数据结构",
    "target_users": "嵌入式固件开发者，需要高效 FIFO 缓冲区（串口收发、DMA 缓冲、数据流处理）的 MCU 程序员"
  },
