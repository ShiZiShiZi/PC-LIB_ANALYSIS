  "function_summary": {
    "summary": "Blitz++ 是一个高效的 C++ 多维数组模板库，面向科学计算与数值分析领域。它提供 Fortran-90 / NumPy 风格的多维数组抽象，并通过表达式模板（expression templates）技术在编译期消除临时对象和循环开销，产生与手写 Fortran 代码相当的运行性能。库本身仅头文件即可使用，适用于需要高性能矩阵/张量运算的数值计算项目。由于基于 C++98 标准编写、已长期无新特性开发，作者建议新项目使用 C++23 std::mdspan；该库主要为依赖它的遗留项目提供继续使用的保障。",
    "categories": [
      {
        "name": "多维数组容器",
        "description": "提供 Array<T,N> 模板，支持任意维度的多维数组存储与访问，含灵活的下标运算（Range、切片、where 表达式）、内存布局控制（行优先/列优先/任意序），以及 TinyArray/TinyVector 等固定大小的小数组优化。",
        "evidence": [
          "blitz/array.h",
          "blitz/array/array.h",
          "blitz/array-impl.h",
          "blitz/tinyvec2.h",
          "blitz/tinymat2.h"
        ]
      },
      {
        "name": "表达式模板惰性求值",
        "description": "通过对算术运算符重载返回表达式模板对象（而非立即求值的临时结果），在赋值时刻一次遍历完成所有运算，消除临时数组分配与多重循环，实测性能接近手写 Fortran。",
        "evidence": [
          "blitz/etbase.h",
          "blitz/et-forward.h",
          "blitz/ops.h",
          "blitz/indexexpr.h",
          "blitz/array/expr.h"
        ]
      },
      {
        "name": "Stencil 卷积/模板运算",
        "description": "提供 BZ_DECLARE_STENCIL 等宏定义定点模板（stencil）操作，方便在数组上施加拉普拉斯、梯度、平滑等邻域卷积，常用于 PDE 求解与流体模拟。",
        "evidence": [
          "blitz/array/stencilops.h",
          "blitz/array/stencils.h",
          "blitz/array/stencil-classes.cc",
          "examples/cfd.cpp"
        ]
      },
      {
        "name": "随机数生成",
        "description": "内置多种随机数分布（均匀、正态、指数、Gamma、Beta、χ²、F 分布等），底层使用 MT19937 Mersenne Twister 伪随机数引擎。",
        "evidence": [
          "random/mt.h",
          "random/uniform.h",
          "random/normal.h",
          "random/exponential.h",
          "random/gamma.h",
          "random/beta.h"
        ]
      },
      {
        "name": "数学函数向量化",
        "description": "对 sin/cos/exp/log/sqrt 等标准数学函数在数组上做逐元素运算的语法糖，通过表达式模板保证高效。",
        "evidence": [
          "blitz/funcs.h",
          "blitz/mathfunc.h"
        ]
      },
      {
        "name": "数组归约与统计",
        "description": "提供 sum、mean、min、max、all、any 等归约操作及自定义归约框架，可用于统计分析与数据汇总。",
        "evidence": [
          "blitz/reduce.h",
          "blitz/array/reduce.h"
        ]
      }
    ],
    "domain": "科学计算/数值分析",
    "target_users": "需要高性能多维数组运算的 C++ 科学计算开发者",
    "ecosystem": "cpp"
  },
