  "function_summary": {
    "summary": "Blitz++ 是一个 C++ 模板类库，为科学计算提供高性能多维数组容器。核心通过表达式模板（expression templates）技术在编译期消除临时对象并生成向量化友好的循环，达到接近 Fortran 的数组运算性能。面向需要数值计算效率的 C++ 应用开发者，适用于科学仿真、物理建模、数值分析等场景。",
    "categories": [
      {
        "name": "多维数组容器",
        "description": "核心 Array<T,N> 模板提供任意维度、任意数值类型的密集数组容器，支持行主序/列主序存储、切片（slice）、子数组视图、间接索引、交错（interlace）与卷积（convolve）等操作。",
        "evidence": [
          "blitz/array-impl.h (Array<T,N> 类声明)",
          "blitz/array/storage.h (存储序、对齐策略)",
          "blitz/array/slice.h",
          "blitz/array/indirect.h",
          "blitz/array/where.h"
        ]
      },
      {
        "name": "表达式模板与惰性求值",
        "description": "通过 C++ 表达式模板技术，将整条数组运算表达式（如 A+B*C）编译为单一高效循环，消除中间临时数组的分配与读写，并通过编译循环展开、缓存线对齐等优化提升向量化效率。",
        "evidence": [
          "blitz/array/expr.h (_bz_ArrayExpr 表达式树)",
          "blitz/array/ops.cc (运算符重载)",
          "blitz/etbase.h",
          "blitz/et-forward.h",
          "blitz/tuning.h (性能调优参数)"
        ]
      },
      {
        "name": "归约与统计运算",
        "description": "提供 sum、mean、min、max、minIndex、maxIndex、product、count、any、all 等沿指定轴的归约操作。",
        "evidence": [
          "blitz/reduce.h (ReduceSum/Min/Max/Product/Count 等)",
          "blitz/array/reduce.h (_bz_ArrayExprReduce)"
        ]
      },
      {
        "name": "结构化网格与模板算子",
        "description": "提供 Stencil 算子框架，支持在结构化网格上定义与应用差分模板（如拉普拉斯算子），生成高效的模板计算循环。",
        "evidence": [
          "blitz/array/stencilops.h",
          "blitz/array/stencils.h",
          "blitz/array/stencil-et.h",
          "blitz/array/stencil-et-macros.h"
        ]
      },
      {
        "name": "定长小向量与小矩阵",
        "description": "TinyVector<T,N> 与 TinyMatrix<T,R,C> 提供编译期定长的小向量/小矩阵类型，适用于三维几何计算、坐标索引等低维场景，支持表达式模板优化。",
        "evidence": [
          "blitz/tinyvec2.h (TinyVector)",
          "blitz/tinymat2.h (TinyMatrix)",
          "blitz/tvcross.h (叉积)",
          "blitz/tvecglobs.h (向量全局变量)"
        ]
      },
      {
        "name": "随机数生成",
        "description": "ranlib 子库提供多种概率分布的随机数生成器，包括均匀分布、正态分布、指数分布、Beta、Gamma、卡方、F 分布等，基于 Mersenne Twister 引擎。",
        "evidence": [
          "random/default.h",
          "random/uniform.h",
          "random/normal.h",
          "random/mt.h (Mersenne Twister)",
          "random/beta.h",
          "random/gamma.h"
        ]
      },
      {
        "name": "迭代线性方程求解",
        "description": "提供 GMRES（广义最小残差法）迭代求解器，用于大规模稀疏或带状线性系统求解。",
        "evidence": [
          "linalg/gmres.h",
          "linalg/gmres.cpp"
        ]
      },
      {
        "name": "编译检测与跨编译器适配",
        "description": "内建编译器特征检测系统（compiler/bzconfig），在 CMake 构建时自动探测各编译器（GCC/Clang/Intel/MSVC/Sun/IBM 等）的 C++ 特性支持（模板、typename、限制指针、bool 等），生成对应配置头文件，确保库在几十种编译器上正确编译。",
        "evidence": [
          "blitz/bzconfig.h (编译器选择)",
          "cmake/BlitzConfigFileName.cmake",
          "cmake/CheckCXXFeatures.cmake",
          "compiler/ (编译器特征探测程序)"
        ]
      }
    ],
    "domain": "科学计算 / 数值线性代数",
    "target_users": "C++ 数值计算与科学仿真应用开发者"
  },
