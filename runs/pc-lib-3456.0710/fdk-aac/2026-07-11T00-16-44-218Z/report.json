  "function_summary": {
    "summary": "FDK AAC 是 Fraunhofer IIS 开发的 ISO/MPEG-2/4 AAC 音频编解码库，最初为 Android 平台优化。提供高质量、低延迟的 AAC-LC、HE-AAC v1/v2、AAC-LD、AAC-ELD 编码与解码，以及 MPEG-D USAC 解码能力。面向需要紧凑高效的音频编解码的嵌入式与桌面应用开发。",
    "categories": [
      {
        "name": "AAC 音频编码",
        "description": "将 PCM 音频编码为 MPEG-2/4 AAC-LC、HE-AAC v1/v2、AAC-LD、AAC-ELD 等格式的比特流，支持多种比特率和声道配置",
        "evidence": [
          "libAACenc/include/aacenc_lib.h: aacEncOpen/aacEncEncode/aacEncClose API",
          "libAACenc/src/aacenc_lib.cpp",
          "libAACenc/src/aacenc.cpp"
        ]
      },
      {
        "name": "AAC 音频解码",
        "description": "将 MPEG-2/4 AAC、HE-AAC v1/v2、AAC-LD、AAC-ELD 及 MPEG-D USAC 比特流解码为 PCM 音频数据",
        "evidence": [
          "libAACdec/include/aacdecoder_lib.h: aacDecoder_Open/aacDecoder_DecodeFrame API",
          "libAACdec/src/aacdecoder_lib.cpp",
          "libAACdec/src/aacdecoder.cpp"
        ]
      },
      {
        "name": "SBR 频谱带复制",
        "description": "提供 HE-AAC 所需的 Spectral Band Replication（SBR）编解码，用低频重构高频提升压缩效率",
        "evidence": [
          "libSBRdec/src/sbr_dec.cpp",
          "libSBRenc/src/sbr_encoder.cpp"
        ]
      },
      {
        "name": "参量立体声",
        "description": "提供 HE-AAC v2 的 Parametric Stereo（PS）编解码，用参量描述立体声场降低比特率",
        "evidence": [
          "libSACdec/src/sac_dec.cpp",
          "libSACenc/src/sacenc_lib.cpp",
          "libSACdec/src/sac_process.cpp"
        ]
      },
      {
        "name": "动态范围控制",
        "description": "支持 MPEG-D DRC 动态范围控制解码，提供响度归一化与夜间模式等播放控制",
        "evidence": [
          "libDRCdec/src/FDK_drcDecLib.cpp",
          "libDRCdec/src/drcDec_gainDecoder.cpp",
          "libAACdec/src/aacdec_drc.cpp"
        ]
      },
      {
        "name": "传输流封装与解析",
        "description": "支持 ADTS、ADIF、LATM/LOAS 等 AAC 传输格式的封装与解析",
        "evidence": [
          "libMpegTPDec/src/tpdec_adts.cpp",
          "libMpegTPEnc/src/tpenc_adts.cpp",
          "libMpegTPDec/src/tpdec_latm.cpp"
        ]
      },
      {
        "name": "定点数学与信号处理",
        "description": "提供定点 FFT/MDCT、滤波器组、混响等信号处理基础组件，优化嵌入式平台",
        "evidence": [
          "libFDK/src/fft.cpp",
          "libFDK/src/mdct.cpp",
          "libFDK/src/fixpoint_math.cpp",
          "libFDK/src/qmf.cpp"
        ]
      }
    ],
    "domain": "音频编解码 / 数字信号处理",
    "target_users": "移动应用、嵌入式设备、流媒体服务、桌面多媒体应用的开发者"
  },
