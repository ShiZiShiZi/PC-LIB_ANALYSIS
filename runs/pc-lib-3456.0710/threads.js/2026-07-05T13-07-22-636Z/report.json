  "function_summary": {
    "summary": "threads.js 是一个面向 Node.js 和浏览器的跨平台并发库，通过统一 API 将 CPU 密集型计算任务卸载到工作线程中运行。它封装了 Node.js worker_threads、浏览器 Web Worker 以及 Electron 的工作线程，提供 spawn/expose 透明代理、线程池、Observable 流式结果等特性，使开发者能够用同一套代码在 Web 和 Node.js 环境中实现多线程并发。",
    "categories": [
      {
        "name": "工作线程抽象与透明代理",
        "description": "通过 spawn() 创建工作线程、expose() 暴露函数或模块，主线程与工作线程之间通过 postMessage 消息传递实现透明的函数调用代理，支持 async/await 和 Observable 流式返回值。",
        "evidence": [
          "src/master/spawn.ts",
          "src/worker/index.ts",
          "src/master/invocation-proxy.ts"
        ]
      },
      {
        "name": "线程池管理",
        "description": "提供 Pool 线程池构造器，支持固定大小线程池、并发度控制、任务队列与调度、任务完成/失败事件流监控等。",
        "evidence": [
          "src/master/pool.ts",
          "src/master/pool-types.ts"
        ]
      },
      {
        "name": "跨平台 Worker 实现适配",
        "description": "根据运行环境自动选择 Worker 实现：Node.js 12+ 使用 worker_threads、Node.js 8–11 使用 tiny-worker 回落、浏览器使用 Web Worker，并提供 BlobWorker 从源码字符串创建 Worker。",
        "evidence": [
          "src/master/implementation.node.ts",
          "src/master/implementation.browser.ts",
          "src/worker/implementation.worker_threads.ts",
          "src/worker/implementation.tiny-worker.ts",
          "src/worker/implementation.browser.ts"
        ]
      },
      {
        "name": "Observable 流式集成",
        "description": "基于 observable-fns 库提供 Subject 和 Observable 支持，工作线程函数可返回 Observable 以流式传输结果，线程池事件和工作线程内部事件也通过 Observable 暴露。",
        "evidence": [
          "src/observable.ts",
          "src/observable-promise.ts",
          "src/master/spawn.ts:77-106"
        ]
      },
      {
        "name": "序列化与 Transferable 支持",
        "description": "提供可扩展的 JSON 序列化器（支持 Error 对象序列化/反序列化）和 Transfer 机制，允许零拷贝传输 ArrayBuffer 等可转移对象以提升性能。",
        "evidence": [
          "src/serializers.ts",
          "src/transferable.ts",
          "src/common.ts"
        ]
      }
    ],
    "domain": "并发/并行计算",
    "target_users": "Node.js 与浏览器 JavaScript/TypeScript 应用开发者"
  },
