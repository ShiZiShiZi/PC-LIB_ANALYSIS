  "function_summary": {
    "summary": "AutoMapper 是一个 .NET 的对象-对象映射器，通过约定和配置自动生成类型之间的映射代码。它基于表达式树和运行时 IL 生成技术，将源对象属性映射到目标对象属性，免去手写枯燥的 DTO/实体转换代码。支持扁平映射、嵌套对象投影、集合映射、自定义值解析器/类型转换器、条件映射和反向映射，广泛应用于 ASP.NET Core 等 .NET 生态的数据传输层和 ORM 投影。",
    "categories": [
      {
        "name": "对象-对象映射",
        "description": "自动将源类型属性映射到目标类型属性，支持约定命名匹配、显式配置、扁平化投影、自定义成员映射和值转换器。",
        "evidence": [
          "src/AutoMapper/TypeMap.cs",
          "src/AutoMapper/Configuration/MappingExpression.cs",
          "src/AutoMapper/Configuration/Conventions.cs"
        ]
      },
      {
        "name": "表达式树编译与运行时代码生成",
        "description": "将映射配置编译为 Lambda 表达式树，通过 System.Linq.Expressions 编译成委托并缓存，避免反射开销。核心管线包括 ExpressionBuilder、TypeMapPlanBuilder 和 ProxyGenerator。",
        "evidence": [
          "src/AutoMapper/Execution/ExpressionBuilder.cs",
          "src/AutoMapper/Execution/TypeMapPlanBuilder.cs",
          "src/AutoMapper/Execution/ProxyGenerator.cs"
        ]
      },
      {
        "name": "IQueryable 投影",
        "description": "支持将映射转换为 LINQ/EF 查询投影（ProjectTo），在数据库层面完成映射，避免不必要的数据列加载。",
        "evidence": [
          "src/AutoMapper/QueryableExtensions/Extensions.cs",
          "src/AutoMapper/QueryableExtensions/ProjectionBuilder.cs"
        ]
      },
      {
        "name": "依赖注入集成",
        "description": "与 Microsoft.Extensions.DependencyInjection 集成，提供 AddAutoMapper 扩展方法自动注册 Profile、IMapper 和各类值解析器/类型转换器。",
        "evidence": [
          "src/AutoMapper/ServiceCollectionExtensions.cs"
        ]
      }
    ],
    "domain": "software-development-tools",
    "target_users": ".NET 开发者、ASP.NET Core 应用开发者，需要处理 DTO 映射和视图模型转换的场景"
  },
