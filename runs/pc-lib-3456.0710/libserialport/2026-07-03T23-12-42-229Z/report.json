      {
        "id": "ta:ohos_posix_termios",
        "capability": "OHOS NDK POSIX termios 与串口 ioctl（TIOCMGET/TIOCINQ/TIOCOUTQ/TIOCSBRK/TIOCCBRK）支持",
        "required": true,
        "target_status": "unknown",
        "impact": "Linux/macOS/FreeBSD 后端的核心打开、配置、读写、信号控制均依赖 termios 与上述 ioctl；若缺失则 POSIX 路径无法直接编译运行，需整体换用鸿蒙专有串口 API。",
        "source": "references/harmony-pc-capabilities.json#hardware_devices.usb_serial（intro：OHOS NDK musl + POSIX 子集）",
        "target_status_model": "unknown"
      },
      {
        "id": "ta:ohos_devtty",
        "capability": "OHOS PC 上存在可访问的串口设备节点（如 /dev/tty* 或鸿蒙等价路径）",
        "required": true,
        "target_status": "unknown",
        "impact": "POSIX open/read/write 依赖设备文件路径；若鸿蒙 PC 设备节点命名或权限模型不同，需调整后端路径与权限申请。",
        "source": "references/harmony-pc-capabilities.json#hardware_devices.usb_serial",
