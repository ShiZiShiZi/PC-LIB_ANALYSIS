  "function_summary": {
    "summary": "IPNetwork 是一个 .NET 网络计算库，提供 IPv4/IPv6 地址解析、子网划分、超网聚合、CIDR 计算、网络包含关系判断、重叠检测、IP 枚举等网络操作。同时附带一个 Native AOT 编译的 CLI 工具，可脱离 .NET 运行时独立执行网络计算。",
    "categories": [
      {
        "name": "IP 地址解析与格式化",
        "description": "解析 CIDR 格式（如 192.168.1.0/24）或子网掩码格式的 IP 网络，支持 IPv4 和 IPv6，并提供字符串化输出。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Parse.cs",
          "src/System.Net.IPNetwork/IPNetwork2TryParse.cs",
          "src/System.Net.IPNetwork/IPNetwork2InternalParse.cs",
          "src/System.Net.IPNetwork/IPNetwork2Print.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToCidr.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToNetmask.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToUint.cs"
        ]
      },
      {
        "name": "子网划分",
        "description": "将一个大网络按指定 CIDR 划分成多个小子网，支持 IPv4 和 IPv6。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Subnet.cs",
          "src/System.Net.IPNetwork/IPNetwork2WideSubnet.cs"
        ]
      },
      {
        "name": "超网聚合",
        "description": "将多个连续子网合并为一个更大的超网，支持数组和单个聚合两种模式。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Supernet.cs",
          "src/System.Net.IPNetwork/IPNetwork2SupernetArray.cs"
        ]
      },
      {
        "name": "网络关系判断",
        "description": "判断一个网络是否包含另一个网络或某个 IP 地址，以及两个网络是否重叠。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Contains.cs",
          "src/System.Net.IPNetwork/IPNetwork2Overlap.cs"
        ]
      },
      {
        "name": "网络减法",
        "description": "从一个网络中减去另一个网络，返回剩余的网络片段列表。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Substract.cs"
        ]
      },
      {
        "name": "IP 地址枚举与范围解析",
        "description": "遍历网络中的所有 IP 地址，以及将 IP 地址范围转换为最紧凑的 CIDR 块表示。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2ListIPAddress.cs",
          "src/System.Net.IPNetwork/IPNetwork2ParseRange.cs",
          "src/System.Net.IPNetwork/IPAddressCollection.cs"
        ]
      },
      {
        "name": "IANA 保留地址块 & ULA",
        "description": "内置 IANA 定义的 IPv4/IPv6 保留地址块常量（私有地址、回环、链路本地等），以及 RFC 4193 的 IPv6 ULA 地址生成与验证。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2IANAblock.cs",
          "src/System.Net.IPNetwork/UniqueLocalAddress.cs",
          "src/System.Net.IPNetwork/IPNetwork2UlaExtension.cs"
        ]
      },
      {
        "name": "CLI 命令行工具",
        "description": "附带独立命令行工具（Native AOT 编译），支持 JSON 输出、自定义字段打印，无需 .NET 运行时即可运行。",
        "evidence": [
          "src/ConsoleApplication/Program.cs",
          "src/ConsoleApplication/JsonFormatter.cs",
          "src/ConsoleApplication/TextFormatter.cs",
          "src/ConsoleApplication/ActionComputer.cs"
        ]
      }
    ],
    "domain": "网络工具",
    "target_users": ".NET 开发者和网络管理员",
    "ecosystem": "dotnet"
