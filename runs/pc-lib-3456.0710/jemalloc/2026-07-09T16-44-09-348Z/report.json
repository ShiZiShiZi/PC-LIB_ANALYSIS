  "native_api": {
    "summary": "jemalloc 的核心平台封装层薄而明确：在 POSIX 系统上使用 mmap/munmap/madvise 管理虚拟内存，在 Windows 上使用 VirtualAlloc/VirtualFree；通过 syscall(SYS_write/SYS_read) 避免 libc 的 write/read 与 jemalloc 自身 alloc 的实现循环。其他均为标准 C/POSIX 可移植接口。",
    "groups": [
      {
        "type": "posix_mmap",
        "category": "platform",
        "platform": "posix",
        "apis": [
          {
            "name": "mmap",
            "purpose": "POSIX 匿名内存映射，作为分配器向 OS 申请大块虚拟内存的基础",
            "count": 12,
            "evidence": [
              "src/pages.c:140-200"
            ],
            "conditional": true
          },
          {
