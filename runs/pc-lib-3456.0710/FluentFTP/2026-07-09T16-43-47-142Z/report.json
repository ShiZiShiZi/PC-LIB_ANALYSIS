  "function_summary": {
    "summary": "FluentFTP 是一个面向 .NET 的全托管 FTP/FTPS 客户端库，基于 .NET Standard 2.0/2.1 和 .NET 7–9 构建，纯 C# 实现、无外部依赖。它提供完整的 FTP 协议支持（含 FTP、FTPS、FXP 站点间传输），文件与目录的上传下载（含进度跟踪与哈希校验）、自动目录列表解析（支持 30+ 种服务器类型）、SSL/TLS 加密连接、多种代理支持（HTTP 1.1/SOCKS4/SOCKS4a/SOCKS5）、异步 async/await 操作、以及 PowerShell 命令行集成。适用于需要在 .NET 应用中集成 FTP 文件传输功能的开发者。",
    "categories": [
      {
        "name": "FTP/FTPS 协议客户端",
        "description": "完整实现 FTP（RFC 959）、FTPS（FTP over SSL/TLS）、FXP（站点间直接传输）协议，支持主动/被动模式（PORT/PASV/EPSV/EPRT），自动检测服务器类型与能力，支持自动重连与命令执行。",
        "evidence": [
          "FluentFTP/Client/BaseClient",
          "FluentFTP/Client/AsyncClient",
          "FluentFTP/Client/SyncClient"
        ]
      },
      {
        "name": "文件传输与目录管理",
        "description": "支持单文件/整个目录的上传与下载、进度跟踪、哈希校验（MD5/CRC32/SHA-1/SHA-256/SHA-512）、规则过滤、限速传输、流式读写、递归目录操作与文件权限管理（CHMOD）。",
        "evidence": [
          "FluentFTP/Client/AsyncClient",
          "FluentFTP/Rules",
          "FluentFTP/Streams"
        ]
      },
      {
        "name": "SSL/TLS 安全连接",
        "description": "基于 .NET SslStream 提供显式和隐式 SSL/TLS 连接，支持证书验证、TLS 1.3（通过 GnuTLS 集成），加密控制通道与数据通道。",
        "evidence": [
          "FluentFTP/Streams/FtpSslStream.cs",
          "FluentFTP/Streams/FtpSocketStream.cs"
        ]
      },
      {
        "name": "多服务器类型自动适配",
        "description": "自动解析 30+ 种 FTP 服务器类型（Unix、Windows/IIS、Azure、Pure-FTPd、ProFTPD、VMS、IBM z/OS 等）的目录列表格式，智能识别服务器能力。",
        "evidence": [
          "FluentFTP/Servers",
          "FluentFTP/Helpers"
        ]
      },
      {
        "name": "代理与网络支持",
        "description": "支持多种 FTP 代理（HTTP 1.1、SOCKS4、SOCKS4a、SOCKS5、User@Host、BlueCoat），可与需要中介代理的 FTP 环境对接。",
        "evidence": [
          "FluentFTP/Proxy"
        ]
      },
      {
        "name": "异步编程与 PowerShell 集成",
        "description": "全异步 async/await API（含 IAsyncEnumerable 流式枚举），同时提供同步 API；支持 CancellationToken 取消与超时；附带 PowerShell 模块脚本。",
        "evidence": [
          "FluentFTP/Client/Interfaces/IAsyncFtpClient.cs",
          "Powershell/FluentFTP.ps1"
        ]
      }
    ],
    "domain": "文件传输与网络通信",
    "target_users": ".NET 应用程序开发者，需要在应用中集成 FTP 文件上传下载功能的开发者"
  },
