  "function_summary": {
    "summary": "source-map 是 Mozilla 维护的 JavaScript 库，用于生成和消费 source map（源码映射）格式。source map 将编译、压缩、转译后的代码位置映射回原始源码位置，是 webpack、Rollup、Babel 等构建工具与浏览器 DevTools 调试栈的关键基础设施。本库提供 SourceMapGenerator（增量生成）、SourceMapConsumer（读取查询）、SourceNode（高级代码生成带映射）三个核心 API，性能关键路径通过 WebAssembly（Rust 编译的 mappings.wasm）加速映射解析。",
    "categories": [
      {
        "name": "Source Map 生成",
        "description": "以增量方式构建 source map，支持逐行添加映射、设置源码内容、合并已有 source map，最终序列化为标准 JSON 或 Base64 VLQ 编码字符串。",
        "evidence": [
          "lib/source-map-generator.js",
          "source-map.d.ts: SourceMapGenerator"
        ]
      },
      {
        "name": "Source Map 消费与位置查询",
        "description": "解析 source map JSON 或其 VLQ mappings 字符串，支持原始位置↔生成位置的双向查询、按段索引映射、模糊搜索（GREATEST_LOWER_BOUND / LEAST_UPPER_BOUND），并提供异步安全生命周期管理（with/destroy）。",
        "evidence": [
          "lib/source-map-consumer.js",
          "lib/wasm.js"
        ]
      },
      {
        "name": "高级代码生成与拼接",
        "description": "SourceNode 是对代码拼接/插值的高级抽象，使开发者在合并代码片段时自动维护行列号映射信息，支持从已有 source map 反向重建 SourceNode 树并生成带映射的代码。",
        "evidence": [
          "lib/source-node.js",
          "source-map.d.ts: SourceNode"
        ]
      },
      {
        "name": "VLQ 编解码与 Base64",
        "description": "实现 source map 规范的 Base64 VLQ 可变长度数量编解码，用于将整数数组压缩编码为 mappings 字符串；同时提供 Base64 字符集映射。",
        "evidence": [
          "lib/base64-vlq.js",
          "lib/base64.js"
        ]
      },
      {
        "name": "URL/路径处理",
        "description": "实现 source map 规范要求的 URL 相对化、规范化、拼接和源码 URL 计算（sourceRoot + sources + sourceMapURL 三段式），兼容绝对/相对/协议相对路径。",
        "evidence": [
          "lib/url.js",
          "lib/util.js"
        ]
      }
    ],
    "domain": "开发工具 / 调试基础设施",
    "target_users": "JavaScript/前端构建工具开发者、bundler 和转译器维护者、浏览器 DevTools 开发者",
    "ecosystem": "nodejs"
