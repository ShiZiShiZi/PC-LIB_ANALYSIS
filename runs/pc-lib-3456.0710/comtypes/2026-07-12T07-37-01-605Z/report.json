  "function_summary": {
    "summary": "comtypes 是一个基于 ctypes 的纯 Python COM（组件对象模型）库，运行于 Windows 平台。它允许开发者在 Python 中定义 COM 接口、调用已有 COM 组件、创建并注册 COM 服务端，以及从类型库（.tlb）自动生成 Python 包装代码。核心能力覆盖 COM 客户端（CoCreateInstance、IDispatch 动态绑定）、COM 服务端（进程内/本地服务器实现与注册）、类型库解析与代码生成，以及 COM 线程模型（STA/MTA）与 Windows 消息循环管理。",
    "categories": [
      {
        "name": "COM 客户端调用",
        "description": "通过 ctypes 加载 Windows COM DLL（ole32.dll 等），调用 CoCreateInstance/CreateObject 创建 COM 对象，支持 IUnknown/IDispatch 接口查询、属性获取与方法调用，以及 GetActiveObject 获取运行中 COM 对象。",
        "evidence": [
          "comtypes/__init__.py",
          "comtypes/client/__init__.py",
          "comtypes/client/_create.py",
          "comtypes/client/dynamic.py"
        ]
      },
      {
        "name": "COM 服务端实现与注册",
        "description": "支持在 Python 中实现 COM 类（COMObject 基类），以进程内服务器（InprocServer）或本地服务器（LocalServer）方式提供 COM 对象，并通过 Windows 注册表（winreg）注册/注销 COM 组件。",
        "evidence": [
          "comtypes/_comobject.py",
          "comtypes/server/__init__.py",
          "comtypes/server/inprocserver.py",
          "comtypes/server/localserver.py",
          "comtypes/server/register.py"
        ]
      },
      {
        "name": "COM 类型库解析与代码生成",
        "description": "解析 COM 类型库（.tlb 文件），提取接口、结构、枚举定义，并自动生成对应的 Python 模块代码（comtypes.gen 缓存目录），支持从 GUID/文件路径/注册表查找类型库。",
        "evidence": [
          "comtypes/tools/tlbparser.py",
          "comtypes/tools/codegenerator/",
          "comtypes/client/_generate.py",
          "comtypes/typeinfo.py"
        ]
      },
      {
        "name": "COM 自动化与 VARIANT 处理",
        "description": "支持 OLE Automation 类型系统：IDispatch 动态绑定、VARIANT 类型转换（含 SAFEARRAY、BSTR、VT_DATE 等）、属性存取（DISPATCH_PROPERTYGET/PUT）与方法调用（DISPATCH_METHOD）。可选集成 numpy ndarray。",
        "evidence": [
          "comtypes/automation.py",
          "comtypes/safearray.py",
          "comtypes/_npsupport.py"
        ]
      },
      {
        "name": "COM 线程模型与消息循环",
        "description": "管理 COM apartment 线程模型（STA/MTA），通过 user32.dll 提供 Windows 消息循环（GetMessage/DispatchMessage），支持 COM 接口的线程间封送（全局接口表 GIT）。",
        "evidence": [
          "comtypes/__init__.py",
          "comtypes/messageloop.py",
          "comtypes/git.py"
        ]
      }
    ],
    "domain": "Windows 桌面开发 / COM 互操作",
    "target_users": "需要在 Python 中调用或实现 Windows COM 组件的桌面应用与自动化脚本开发者"
  },
