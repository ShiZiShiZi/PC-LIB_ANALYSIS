  "function_summary": {
    "summary": "G'MIC（GREYC's Magic for Image Computing）是一个功能完备的开源数字图像处理框架，提供 C++ 核心库（libgmic）和命令行工具（gmic CLI）。它支持从 1D 标量信号到 3D+时间多光谱体数据的通用图像数据集处理，内置超过 600 种滤镜和图像处理算法，涵盖艺术效果、颜色调整、变形、修复、去噪、渲染等多种类别。面向需要图像处理能力的开发者（通过 API 嵌入）和终端用户（通过 CLI/GIMP 插件使用）。",
    "categories": [
      {
        "name": "图像处理与滤镜",
        "description": "提供超过 600 种图像处理滤镜，覆盖艺术效果、黑白转换、颜色校正、轮廓提取、变形、退化、细节增强、胶片模拟、帧效果、光影、图案、渲染、修复、序列处理等类别",
        "evidence": [
          "src/gmic_stdlib.gmic（标准滤镜库，定义所有内置命令）",
          "src/gmic.cpp（核心处理引擎）",
          "README.md（列举滤镜类别）"
        ]
      },
      {
        "name": "图像 I/O 与格式转换",
        "description": "支持常见图像格式的读取、写入与转换（PNG、JPEG、TIFF 等），通过 libpng/libjpeg/libtiff 等外部库实现",
        "evidence": [
          "CMakeLists.txt（依赖 libpng/libjpeg/libtiff）",
          "src/gmic.cpp（图像加载/保存逻辑）"
        ]
      },
      {
        "name": "C/C++ 嵌入 API",
        "description": "提供 libgmic（C++ API）和 libcgmic（C API），允许第三方应用直接调用 G'MIC 的所有图像处理功能。API 设计简洁，库支持线程安全和多线程处理",
        "evidence": [
          "src/gmic.h（公共 API 头文件）",
          "src/use_libgmic.cpp（C++ API 使用示例）",
          "src/gmic.cpp（核心库实现）"
        ]
      },
      {
        "name": "命令行图像处理工具",
        "description": "gmic CLI 允许从 shell 直接调用 G'MIC 命令进行图像批处理、转换和处理，支持管道操作和脚本化",
        "evidence": [
          "src/gmic_cli.cpp（CLI 入口实现）",
          "src/gmic_stdlib.gmic（自定义命令/滤镜定义文件）"
        ]
      },
      {
        "name": "多线程并行处理",
        "description": "支持基于 pthread（Unix）或 Win32 CreateThread 的多线程并行图像处理，利用 OpenMP 加速计算密集型操作",
        "evidence": [
          "src/gmic.cpp（gmic_parallel 线程函数 + cimg::mutex 同步）",
          "CMakeLists.txt（OpenMP 可选支持）"
        ]
      },
      {
        "name": "网络图像下载",
        "description": "通过 libcurl 支持从网络直接加载图像进行处理",
        "evidence": [
          "src/gmic.cpp（网络下载逻辑）",
          "CMakeLists.txt（可选 libcurl 依赖）"
        ]
      }
    ],
    "domain": "图像处理 / 数字图像处理",
    "target_users": "图像处理开发者（通过 API 集成）和终端用户（通过 CLI 批量处理、GIMP/Krita 等编辑器的 G'MIC-Qt 插件）"
  },
