  "function_summary": {
    "summary": "SharpCompress 是一个面向 .NET 平台的纯托管 C# 压缩解压库，无需任何原生依赖即可在 .NET Framework 4.8 及 .NET 6/8/10 等多个运行时上运行。它提供 Seekable 的 Archive API（随机访问）与 Forward-Only 的 Reader/Writer API（流式处理）两套接口，支持 RAR、7Zip、Zip、Tar、GZip、BZip2、LZip、XZ、ZStandard 等十余种主流存档与压缩格式的读写。其核心特色包括：非可寻址流（如网络下载流）的边读边解压能力、全异步 I/O 支持、以及通过 Provider 机制可插拔的压缩算法替换。适合需要在 .NET 应用中处理压缩文件或压缩流的应用开发者与库作者。",
    "categories": [
      {
        "name": "多格式存档读写（Archive API）",
        "description": "提供随机访问的归档操作——打开、枚举条目、提取、创建/修改 Zip/Tar/7Zip/Rar/GZip 等格式的存档文件，支持加密读写与 Zip64 扩展",
        "evidence": [
          "src/SharpCompress/Archives/ArchiveFactory.cs",
          "src/SharpCompress/Archives/Zip/",
          "src/SharpCompress/Archives/Tar/",
          "src/SharpCompress/Archives/SevenZip/",
          "src/SharpCompress/Archives/Rar/"
        ]
      },
      {
        "name": "流式压缩解压（Reader/Writer API）",
        "description": "Forward-Only 的只读/只写接口，适用于非可寻址流场景（如网络下载流），支持按需边读边解压大文件而无需完整加载到内存",
        "evidence": [
          "src/SharpCompress/Readers/ReaderFactory.cs",
          "src/SharpCompress/Writers/WriterFactory.cs",
          "src/SharpCompress/Readers/Rar/",
          "src/SharpCompress/Readers/Zip/"
        ]
      },
      {
        "name": "压缩算法引擎",
        "description": "独立可用的压缩/解压流实现——BZip2、DEFLATE、Deflate64、LZMA/LZMA2、PPMd、LZW、ZStandard、XZ 等算法均可直接作为 Stream 使用",
        "evidence": [
          "src/SharpCompress/Compressors/BZip2/",
          "src/SharpCompress/Compressors/Deflate/",
          "src/SharpCompress/Compressors/LZMA/",
          "src/SharpCompress/Compressors/ZStandard/",
          "src/SharpCompress/Compressors/PPMd/"
        ]
      },
      {
        "name": "格式自动检测",
        "description": "ReaderFactory 可根据流头签名自动识别存档格式并选择正确的 Reader，ArchiveFactory 同理",
        "evidence": [
          "src/SharpCompress/Factories/Factory.cs",
          "src/SharpCompress/Readers/ReaderFactory.cs",
          "src/SharpCompress/Archives/ArchiveFactory.Detection.cs"
        ]
      },
      {
        "name": "异步 I/O 与流控制",
        "description": "所有读写操作均提供 async/await 异步版本，支持 CancellationToken 取消，适配高并发与 UI 线程场景",
        "evidence": [
          "src/SharpCompress/Archives/AbstractArchive.Async.cs",
          "src/SharpCompress/Readers/AbstractReader.Async.cs",
          "src/SharpCompress/Writers/"
        ]
      },
      {
        "name": "加密与校验",
        "description": "支持 Zip PKWare 与 WinZip AES 加密、CRC32 校验、以及 Rar 的 BLAKE2sp 完整性验证",
        "evidence": [
          "src/SharpCompress/Crypto/",
          "src/SharpCompress/Compressors/Rar/RarBLAKE2spStream.cs",
          "src/SharpCompress/Common/ChecksumValidationStream.cs"
        ]
      },
      {
        "name": "可插拔压缩 Provider",
        "description": "通过 CompressionProviderRegistry 允许替换内置压缩实现，如将 System.IO.Compression 的 GZip 替换为内置的 Deflate 实现",
        "evidence": [
          "src/SharpCompress/Providers/",
          "src/SharpCompress/Common/Options/"
        ]
