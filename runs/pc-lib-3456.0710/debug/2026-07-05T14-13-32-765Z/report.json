  "function_summary": {
    "summary": "debug 是一个极简的 JavaScript 日志调试库，模拟 Node.js 核心的 debug 技术。开发者通过给模块命名空间来创建带颜色的调试输出，并通过 DEBUG 环境变量或 localStorage 动态开关不同模块的日志。支持 printf 风格格式化、时间差显示、命名空间通配符匹配等特性，兼容 Node.js 与 Web 浏览器两种运行环境。",
    "categories": [
      {
        "name": "命名空间调试输出",
        "description": "通过 createDebug(namespace) 创建带命名空间的调试函数，每个命名空间自动分配颜色，支持命名空间通配符（*）匹配和排除（-前缀），实现模块粒度的日志开关控制",
        "evidence": [
          "src/common.js:60"
        ]
      },
      {
        "name": "多环境适配",
        "description": "自动检测运行环境，Node.js 环境下使用 process.stderr + util.formatWithOptions 输出，支持 ANSI 颜色和 inspect 选项；浏览器环境下使用 console.debug，支持 CSS 颜色样式和 localStorage 持久化",
        "evidence": [
          "src/index.js:6",
          "src/node.js:5",
          "src/browser.js:120"
        ]
      },
      {
        "name": "格式化支持",
        "description": "支持 %O（多行对象）、%o（单行对象）、%s、%d、%j（JSON）等 printf 风格格式化，并可通过 formatters 扩展自定义格式器",
        "evidence": [
          "src/common.js:91",
          "src/node.js:248"
        ]
      },
      {
        "name": "时间差计算",
        "description": "自动记录每次调试调用与前一次的时间差（毫秒），帮助开发者追踪性能热点",
        "evidence": [
          "src/common.js:75"
        ]
      },
      {
        "name": "命名空间扩展（Extend）",
        "description": "支持在已有命名空间基础上通过 extend() 创建子命名空间（如 auth:sign），保持日志函数绑定",
        "evidence": [
          "src/common.js:149"
        ]
      }
    ],
    "domain": "开发者工具（日志与调试）",
    "target_users": "JavaScript/Node.js 应用开发者"
  },
