  "function_summary": {
    "summary": "@stdlib/complex-float64 是 stdlib 标准库中专门处理双精度复数（Complex128）的命名空间模块，面向需要在 JavaScript/Node.js 中执行复数运算的科学计算与数值分析开发者。它将底层复数操作（构造、实数/虚数部分提取、共轭、字符串解析、JSON 反序列化）集中组织，各个子模块可独立按需引用。",
    "categories": [
      {
        "name": "复数构造",
        "description": "创建 128 位双精度复数对象（Complex128），由实部与虚部组成。",
        "evidence": [
          "lib/index.js:64 (Complex128)",
          "test/test.js:31-34"
        ]
      },
      {
        "name": "实数与虚数部分提取",
        "description": "从复数对象中提取实部（real）、虚部（imag）或同时提取两者（reim）。",
        "evidence": [
          "lib/index.js:73-74 (real)",
          "lib/index.js:82-83 (imag)",
          "lib/index.js:100-103 (reim)"
        ]
      },
      {
        "name": "复数运算",
        "description": "复数共轭（conj）等基本运算。",
        "evidence": [
          "lib/index.js:55 (conj)"
        ]
      },
      {
        "name": "复数解析与反序列化",
        "description": "将字符串解析为 Complex128 对象（parseComplex128），或将 JSON 序列化的复数还原（reviveComplex128）。",
        "evidence": [
          "lib/index.js:93 (parseComplex128)",
          "lib/index.js:109-111 (reviveComplex128)"
        ]
      },
      {
        "name": "底层基础运算",
        "description": "通过 base 子命名空间暴露底层双精度复数运算，包括加减乘除、相等性/近似相等性判断、缩放等。",
        "evidence": [
          "lib/index.js:46 (base)"
        ]
      }
    ],
