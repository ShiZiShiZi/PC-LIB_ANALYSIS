  "function_summary": {
    "summary": "ActiveMQ-CPP 是一个 C++ 消息传递客户端库，为 Apache ActiveMQ 消息代理提供 C++ 语言绑定。它基于 Apache Portable Runtime（APR）实现跨平台网络 IO 与线程，实现了一套 JMS-like 的 CMS（C++ Messaging Service）API，支持 OpenWire（原生协议）与 STOMP 两种有线协议，使 C++ 应用程序能够与 ActiveMQ 代理进行异步、事务性和持久化的消息收发。",
    "categories": [
      {
        "name": "JMS 风格消息 API（CMS）",
        "description": "提供 Connection、Session、MessageProducer、MessageConsumer、Queue、Topic 等 C++ 接口，实现 JMS 消息模型（点对点、发布/订阅），支持同步与异步消息收发、消息选择器与持久化",
        "evidence": [
          "activemq-cpp/src/main/cms/Connection.h",
          "activemq-cpp/src/main/cms/Session.h",
          "activemq-cpp/src/main/cms/MessageConsumer.h",
          "activemq-cpp/src/main/cms/MessageProducer.h"
        ]
      },
      {
        "name": "多协议支持（OpenWire / STOMP）",
        "description": "支持 ActiveMQ 原生 OpenWire 二进制协议（高性能）和 STOMP 文本协议（跨语言通用），可配置传输 URI 切换协议与连接参数",
        "evidence": [
          "activemq-cpp/src/main/activemq/wireformat/openwire/",
          "activemq-cpp/src/main/activemq/wireformat/stomp/",
          "activemq-cpp/src/main/activemq/transport/"
        ]
      },
      {
        "name": "网络传输层（基于 APR）",
        "description": "基于 Apache Portable Runtime（APR）实现跨平台的 TCP/UDP/SSL 传输，支持连接故障转移（failover）、重连策略与心跳检测，保证高可用",
        "evidence": [
          "activemq-cpp/src/main/decaf/internal/net/tcp/TcpSocket.cpp",
          "activemq-cpp/src/main/activemq/transport/failover/",
          "activemq-cpp/src/main/decaf/internal/net/ssl/openssl/"
        ]
      },
      {
        "name": "并发与线程模型",
        "description": "基于 APR 线程池与 decaf 内部的并发工具（互斥锁、条件变量、队列等）实现多线程消息收发，支持异步回调与线程安全的消息处理",
        "evidence": [
          "activemq-cpp/src/main/decaf/util/concurrent/",
          "activemq-cpp/src/main/decaf/internal/util/concurrent/"
        ]
      },
      {
        "name": "资源管理与对象生命周期",
        "description": "实现 CMS 资源的生命周期管理（连接池、会话恢复、消息确认模式 AUTO/CLIENT/DUPS_OK/INDIVIDUAL/TRANSACTED），支持 close-to-close 语义与优雅关闭",
        "evidence": [
          "activemq-cpp/src/main/activemq/core/ActiveMQConnection.cpp",
          "activemq-cpp/src/main/activemq/core/ActiveMQSessionExecutor.cpp"
        ]
      }
    ],
    "domain": "消息中间件 / 企业集成",
    "target_users": "需要从 C++ 应用与服务中对接 Apache ActiveMQ 消息总线的后端开发者与系统集成工程师"
  },
