  "function_summary": {
    "summary": "DevIL（Developer's Image Library）是一个跨平台的开源图像库，提供简洁的 API 用于加载、保存、转换、处理、过滤和显示多种图像格式。它高度可移植，已支持 Windows、Linux、macOS 等主流平台，核心由 IL（图像 I/O）、ILU（图像处理工具）、ILUT（显示工具包）三层组成，支持约 40+ 种图像格式，适合游戏开发、图形工具和嵌入式应用。",
    "categories": [
      {
        "name": "图像加载与保存",
        "description": "支持 40+ 种图像格式的读写，包括常见的 BMP、PNG、JPEG、TGA、DDS、TIFF 等，以及游戏特定的 MDL、VTF、BLP 等格式。依赖可选的外部库（libpng/jpeg/tiff 等）以扩展支持的格式范围。",
        "evidence": [
          "src-IL/src/il_bmp.cpp",
          "src-IL/src/il_png.cpp",
          "src-IL/src/il_jpeg.cpp",
          "src-IL/src/il_tiff.cpp",
          "src-IL/src/il_dds.cpp",
          "src-IL/include/il_internal.h"
        ]
      },
      {
        "name": "图像格式转换",
        "description": "支持多种像素格式之间的转换（RGB/BGR、RGBA/BGRA、灰度、索引色等）和数据类型转换（byte/short/float/double）。提供快速转换路径（汇编优化）和通用路径。",
        "evidence": [
          "src-IL/src/il_convert.cpp",
          "src-IL/src/il_fastconv.cpp",
          "src-IL/src/il_convbuff.cpp"
        ]
      },
      {
        "name": "图像处理与过滤",
        "description": "ILU 子库提供丰富的图像处理功能：缩放、旋转（2D/3D）、裁剪、翻转/镜像、模糊（均值/高斯）、锐化、边缘检测、浮雕、噪声生成、颜色校正（伽马/对比度/饱和度）、色彩空间转换等。",
        "evidence": [
          "src-ILU/src/ilu_scale.cpp",
          "src-ILU/src/ilu_rotate.cpp",
          "src-ILU/src/ilu_filter.cpp",
          "src-ILU/src/ilu_noise.cpp",
          "src-ILU/src/ilu_manip.cpp"
        ]
      },
      {
        "name": "显示与图形 API 集成",
        "description": "ILUT 子库通过 OpenGL、DirectX（9/10）、Win32 GDI、X11、SDL、Allegro 等 API 将图像直接显示到窗口或加载为图形纹理。提供纹理创建、窗口贴图、截图等快捷功能。",
        "evidence": [
          "src-ILUT/src/ilut_opengl.cpp",
          "src-ILUT/src/ilut_win32.cpp",
          "src-ILUT/src/ilut_directx9.cpp",
          "src-ILUT/src/ilut_x11.cpp"
        ]
      },
      {
        "name": "语言绑定",
        "description": "官方提供 Python（通过 SWIG 接口文件）、C#（ILU .NET 包装）、Java、Visual Basic、PowerBasic、Delphi 和 Lua 的多语言绑定或接口，方便在多种语言中集成图像功能。",
        "evidence": [
          "include/IL/DevIL.i",
          "bindings/python/DevIL-Linux.py",
          "bindings/visual basic/il.bas",
          "cpp wrapper/il_wrap.cpp"
        ]
      }
    ],
    "domain": "graphics",
    "target_users": "游戏开发与图形应用开发者",
    "ecosystem": "cpp"
  },
