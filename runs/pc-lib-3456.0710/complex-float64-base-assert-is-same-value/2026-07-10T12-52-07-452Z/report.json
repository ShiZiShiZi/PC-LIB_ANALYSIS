  "function_summary": {
    "summary": "测试两个双精度复数浮点数是否为相同值的小型工具库。实现 ECMAScript 5 的 SameValue 算法，区分 +0/-0 并视 NaN 为相同值。供 stdlib 数学库内部组合使用，是复杂数运算基础设施的一环。",
    "categories": [
      {
        "name": "复数比较断言",
        "description": "提供双精度复数浮点数的等值断言函数，基于 ECMAScript 5 的 SameValue 算法，正确处理零符号与 NaN。",
        "evidence": [
          "lib/main.js",
          "include/stdlib/complex/float64/base/assert/is_same_value.h"
        ]
      },
      {
        "name": "C/JavaScript 双语言实现",
        "description": "同时提供 JavaScript 与 C 语言实现，通过 stdlib 的库清单机制在 Node.js 中加载 C 原生实现以获得高性能。",
        "evidence": [
          "src/main.c",
          "lib/main.js",
          "manifest.json"
        ]
      }
    ],
    "domain": "数值计算/数学库",
    "target_users": "JavaScript/Node.js 数值计算开发者，stdlib 内部模块使用者"
  },
