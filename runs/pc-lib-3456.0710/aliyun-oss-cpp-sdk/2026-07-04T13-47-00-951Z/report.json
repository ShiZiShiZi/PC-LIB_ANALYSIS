  "function_summary": {
    "summary": "aliyun-oss-cpp-sdk 是阿里云对象存储服务（OSS）的官方 C++ SDK（V1 版本）。它以现代 C++11 接口封装 OSS REST API，向 C++ 应用开发者提供桶管理、对象上传下载、分片上传、断点续传、客户端加密、请求签名、重试与限流等能力。库本身无 GUI，通过 libcurl 做 HTTP 传输、OpenSSL 做加密与签名，可直接链接到桌面/服务器后端程序。",
    "categories": [
      {
        "name": "对象存储核心 API",
        "description": "提供 Bucket、Object、MultipartUpload、LiveChannel、SelectObject 等 OSS REST API 的请求/结果模型与同步调用封装。",
        "evidence": [
          "sdk/include/alibabacloud/oss/OssClient.h",
          "sdk/src/OssClientImpl.cc",
          "sdk/src/model/CreateBucketRequest.cc",
          "sdk/src/model/PutObjectRequest.cc",
          "sdk/src/model/CompleteMultipartUploadRequest.cc"
        ]
      },
      {
        "name": "HTTP 传输与网络",
        "description": "基于 libcurl 实现 HTTP/HTTPS 连接池、请求组装、响应解析、代理、SSL 校验、网络接口绑定与速率限制。",
        "evidence": [
          "sdk/src/http/CurlHttpClient.cc",
          "sdk/src/http/CurlHttpClient.h",
          "sdk/src/http/HttpRequest.cc",
          "sdk/src/http/HttpResponse.cc",
          "sdk/include/alibabacloud/oss/client/ClientConfiguration.h"
        ]
      },
      {
        "name": "身份认证与请求签名",
        "description": "支持 AccessKey/SessionToken 凭据提供者，以及 OSS V1（HMAC-SHA1）和 V4（HMAC-SHA256）签名算法。",
        "evidence": [
          "sdk/src/auth/CredentialsProvider.cc",
          "sdk/src/auth/SimpleCredentialsProvider.cc",
          "sdk/src/signer/HmacSha1Signer.cc",
          "sdk/src/signer/SignerV4.cc",
          "sdk/src/signer/Signer.cc"
        ]
      },
      {
        "name": "客户端加密",
        "description": "在本地完成 AES/RSA 等对称与非对称加解密，使用 OpenSSL EVP/RSA 接口封装数据流与信封加密。",
        "evidence": [
          "sdk/src/encryption/CipherOpenssl.cc",
          "sdk/src/encryption/OssEncryptionClient.cc",
          "sdk/src/encryption/CryptoModule.cc",
          "sdk/include/alibabacloud/oss/encryption/OssEncryptionClient.h"
        ]
      },
      {
        "name": "断点续传与并发传输",
        "description": "实现 UploadObject/DownloadObject/CopyObject 的断点续传（checkpoint-record）机制，并通过 ThreadExecutor 并发执行分片任务。",
        "evidence": [
          "sdk/src/resumable/ResumableUploader.cc",
          "sdk/src/resumable/ResumableDownloader.cc",
          "sdk/src/resumable/ResumableBaseWorker.cc",
          "sdk/src/utils/ThreadExecutor.cc",
          "sdk/include/alibabacloud/oss/client/Executor.h"
        ]
      },
      {
        "name": "错误处理、重试与日志",
        "description": "提供 Outcome/Error 结果封装、默认指数退避重试策略、可配置日志级别与回调。",
        "evidence": [
          "sdk/src/client/ClientConfiguration.cc",
          "sdk/src/client/Client.cc",
          "sdk/src/utils/LogUtils.cc",
          "sdk/include/alibabacloud/oss/client/RetryStrategy.h"
        ]
      }
    ],
    "domain": "cloud_storage",
    "target_users": "需要在 C++ 应用中接入阿里云 OSS 的后端服务、桌面工具与嵌入式开发者"
  },
