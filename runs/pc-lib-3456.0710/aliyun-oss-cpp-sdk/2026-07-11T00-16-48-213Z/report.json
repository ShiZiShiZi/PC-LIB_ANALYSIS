  "function_summary": {
    "summary": "阿里云对象存储（OSS）C++ SDK（v1.10.1），为 C++ 开发者提供对阿里云 OSS 服务的完整客户端访问能力。封装了 RESTful API，支持 Bucket 和 Object 的 CRUD 操作、大文件分片上传与断点续传、预签名 URL 生成、客户端与服务端加密、实时音视频直播通道（Live Channel），以及异步请求、重试策略、代理等高级配置。基于现代 C++11 标准，跨平台支持 Windows/Linux/macOS/Android。",
    "categories": [
      {
        "name": "OSS Bucket 管理",
        "description": "对 OSS 存储桶（Bucket）的完整生命周期管理：创建/删除/列举 Bucket，配置 ACL 访问控制、跨域资源共享（CORS）、日志、网站托管、回源镜像、标签、生命周期规则、清单、版本控制、合规保留（WORM）、请求者付费等策略。",
        "evidence": [
          "sdk/include/alibabacloud/oss/OssClient.h:86-167",
          "sdk/src/model/*Bucket*.cc"
        ]
      },
      {
        "name": "OSS Object 操作",
        "description": "对象的 CRUD 操作（Put/Get/Delete/Copy/Append/Head）、元数据管理、标签、ACL、软链接（Symlink）创建与读取，以及 Select 结构化查询。",
        "evidence": [
          "sdk/include/alibabacloud/oss/OssClient.h:169-213",
          "sdk/src/model/*Object*.cc"
        ]
      },
      {
        "name": "分片上传与断点续传",
        "description": "大文件的分片（Multipart）上传/下载，支持初始化/上传分片/完成/中止全流程，以及基于断点记录的断点续传（Resumable）上传、下载、拷贝，可配置并发线程数、分片大小与进度回调。",
        "evidence": [
          "sdk/src/resumable/ResumableUploader.cc",
          "sdk/src/resumable/ResumableDownloader.cc",
          "sdk/src/resumable/ResumableCopier.cc"
        ]
      },
      {
        "name": "HTTP 传输与高级配置",
        "description": "基于 libcurl 的 HTTP/HTTPS 传输层，支持连接池、超时设置、代理（HTTP/SOCKS）、自定义 DNS/网络接口、速率限制、重试策略、客户端限流与取消请求。",
        "evidence": [
          "sdk/src/http/CurlHttpClient.cc",
          "sdk/include/alibabacloud/oss/client/ClientConfiguration.h"
        ]
      },
      {
        "name": "签名认证与安全",
        "description": "支持阿里云 V1（HMAC-SHA1）和 V4（HMAC-SHA256）签名算法、STS 临时凭证（AssumeRole）、服务端加密（SSE-KMS/SSE-OSS）和客户端 RSA 加密（SimpleRSAEncryptionMaterials）。",
        "evidence": [
          "sdk/src/signer/SignerV1.cc",
          "sdk/src/signer/SignerV4.cc",
          "sdk/include/alibabacloud/oss/encryption/EncryptionMaterials.h"
        ]
      },
      {
        "name": "预签名 URL 与 POST Policy",
        "description": "生成带签名的临时访问 URL（预设过期时间），支持 GET/PUT 等 HTTP 方法，便于第三方直接访问 OSS 资源。",
        "evidence": [
          "sdk/src/model/GeneratePresignedUrlRequest.cc"
        ]
      },
      {
        "name": "Live Channel 直播通道",
        "description": "OSS 实时音视频推流通道的创建、配置与管理，支持 RTMP 推流地址生成和 VOD 播放列表查询。",
        "evidence": [
          "sdk/include/alibabacloud/oss/OssClient.h:246-258",
          "sample/src/LiveChannel/LiveChannelSample.cc"
        ]
      }
    ],
    "domain": "云存储",
    "target_users": "C++ 应用开发者",
    "ecosystem": "cpp"
  },
