  "function_summary": {
    "summary": "OpenVDB 是一个面向稀疏体积数据的高效存储与操作的开源 C++ 库，核心为一种新颖的分层体素树数据结构以及配套的丰富工具集，广泛应用于电影视觉特效（如烟、火、云、水等体积效果）与动画制作管线。项目由 DreamWorks Animation 首创，现由 Academy Software Foundation 托管。",
    "domain": "计算机图形学 – 体积数据处理与特效",
    "target_users": "视觉特效艺术家、动画工程师、科学可视化研究人员、游戏开发者中的体积数据处理场景",
    "categories": [
      {
        "name": "稀疏体积树数据结构",
        "description": "核心为 B+ 树风格的层次数据结构（5-4-3 分支因子），以动态、空间高效的方式存储三维网格上的稀疏体积数据，支持随机访问、迭代与拓扑修改"
      },
      {
        "name": "体积文件 I/O",
        "description": ".vdb 文件格式的读写，支持压缩（ZIP/BLOSC）、网格元数据、延迟加载与流式序列化"
      },
      {
        "name": "体积工具与算法",
        "description": "丰富的体积操作工具集：水平集（Level Set）处理、网格转换（Volume↔Mesh↔Particles）、滤波平滑、形态学操作、CSG 布尔组合、拓扑修改、重采样与插值"
      },
      {
        "name": "粒子系统与点云",
        "description": "点属性存储（位置/颜色/法向）、点分区、粒子→体积转换、体积→粒子采样、点散射与光栅化"
      },
      {
        "name": "AX 表达式语言",
        "description": "运行时编译的嵌入式体积操作 DSL，支持 JIT 在网格上执行数学表达式，加速自定义体积处理流程"
      },
      {
        "name": "NanoVDB – GPU 加速",
        "description": "轻量级 OpenVDB 兼容数据结构，可在 GPU 上高效使用（CUDA），支持静态渲染与动态拓扑修改（如水平集追踪、网格构建）"
      },
      {
        "name": "Python 绑定",
        "description": "通过 pyopenvdb 模块提供 NumPy 兼容的 Python 接口，支持网格创建、迭代、采样与序列化"
      },
      {
        "name": "DCC 插件集成",
        "description": "提供 Houdini SOP/DOP 插件、Maya 插件和 Wolfram Mathematica 接口，将体积功能嵌入行业标准数字内容创作工具"
      }
    ]
  },
