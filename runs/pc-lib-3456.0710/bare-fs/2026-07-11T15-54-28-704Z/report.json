  "function_summary": {
    "summary": "bare-fs 是 Holepunch 为 Bare 运行时（轻量级 JavaScript 运行时）编写的原生文件系统操作库，模拟 Node.js 的 fs 模块 API。底层通过 C 原生插件调用 libuv 的异步 I/O 接口，上层 JavaScript 封装提供 Promise、回调、流（ReadStream/WriteStream）、URL 路径转换、文件监控（watch）等完整功能。面向在 Bare 上构建桌面/CLI 应用的开发者。",
    "categories": [
      {
        "name": "文件系统基本操作",
        "description": "提供文件的打开、关闭、读写、截断、复制、移动、删除等核心操作，支持 Buffer 和字符串模式。",
        "evidence": [
          "index.js:112-146 (open/close)",
          "index.js:265-298 (read)",
          "binding.c:517-559 (bare_fs_open)"
        ]
      },
      {
        "name": "文件元数据与权限",
        "description": "获取文件状态（stat/lstat/fstat），获取文件系统统计信息（statfs），修改权限（chmod/chown）和时间戳（utimes）。",
        "evidence": [
          "index.js:485-504 (stat)",
          "index.js:703-725 (chmod)",
          "index.js:781-797 (chown)"
        ]
      },
      {
        "name": "目录操作",
        "description": "创建和删除目录（mkdir/built-in递归），列出目录内容（readdir），打开目录迭代器（opendir）。",
        "evidence": [
          "index.js:1029-1088 (mkdir)",
          "index.js:1880-1918 (readdir)",
          "index.js:1823-1854 (opendir)"
        ]
      },
      {
        "name": "链接与符号链接",
        "description": "创建硬链接（link）和符号链接（symlink），支持 Windows junction 模式，以及读取链接目标（readlink）。",
        "evidence": [
          "index.js:989-1027 (link)",
          "index.js:1713-1820 (symlink)",
          "index.js:1576-1640 (readlink)"
        ]
      },
      {
        "name": "流式文件访问",
        "description": "基于 bare-stream 的 ReadStream/WriteStream，支持管道和流式大文件处理，可通过文件描述符或路径打开。",
        "evidence": [
          "index.js:2418-2565 (FileReadStream/FileWriteStream)",
          "index.js:2774-2782 (createReadStream/createWriteStream)"
        ]
      },
      {
        "name": "文件监控",
        "description": "通过 libuv 的 fs_event 接口监听文件或目录的变更事件（rename/change），返回 EventEmitter 风格 Watcher 对象。",
        "evidence": [
          "index.js:2126-2138 (watch)",
          "binding.c:2570-2697 (bare_fs_watcher_*)"
        ]
      }
    ],
    "domain": "文件系统 / 运行时基础设施",
    "target_users": "Bare 运行时上的 JavaScript/TypeScript 应用开发者，需要原生性能文件 I/O 的桌面/CLI 工具作者"
  },
