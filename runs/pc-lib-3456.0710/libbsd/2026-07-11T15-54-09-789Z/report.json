  "function_summary": {
    "summary": "libbsd 是一个 C 库，提供 BSD 操作系统（FreeBSD/OpenBSD/NetBSD）上常见的实用函数，为 Linux、Solaris、AIX 等非 BSD 平台补齐这些功能，使 BSD 风格的开源项目无需在每个项目中重复嵌入相同代码即可移植到其他平台。它封装了字符串安全操作、随机数生成、内存分配、进程管理、文件读取等底层函数，面向需要跨 Unix 平台兼容性的 C/C++ 项目开发者。",
    "categories": [
      {
        "name": "字符串安全操作",
        "description": "提供 strlcpy、strlcat、wcslcpy、wcslcat 等 BSD 风格的安全字符串复制与拼接函数，避免缓冲区溢出。",
        "evidence": [
          "src/strlcpy.c",
          "src/strlcat.c",
          "src/wcslcpy.c",
          "src/wcslcat.c",
          "include/bsd/string.h"
        ]
      },
      {
        "name": "加密安全随机数",
        "description": "提供 arc4random、arc4random_buf、arc4random_uniform 等密码学安全的随机数生成函数，及 getentropy 系统调用仿真。",
        "evidence": [
          "src/arc4random.c",
          "src/arc4random_uniform.c",
          "src/getentropy.c",
          "src/arc4random_linux.h"
        ]
      },
      {
        "name": "进程与程序信息",
        "description": "提供 setproctitle（设置进程标题）、getprogname/setprogname（获取/设置程序名）、getpeereid（获取对端 socket 用户 ID）等 BSD 风格的进程管理函数。",
        "evidence": [
          "src/setproctitle.c",
          "src/progname.c",
          "src/getpeereid.c",
          "include/bsd/unistd.h"
        ]
      },
      {
        "name": "文件与 I/O 操作",
        "description": "提供 fgetln（按行读取文件）、fgetwln（宽字符版本）、fpurge（清除流缓冲区）、funopen（自定义流打开）、closefrom（关闭指定 fd 以上所有描述符）、flopen（可靠锁定打开文件）等 BSD 扩展文件操作函数。",
        "evidence": [
          "src/fgetln.c",
          "src/fgetwln.c",
          "src/fpurge.c",
          "src/funopen.c",
          "src/closefrom.c",
          "src/flopen.c",
          "src/fparseln.c"
        ]
      },
      {
        "name": "数值解析与格式化",
        "description": "提供 strtonum（严格数字解析）、strtoi/strtou（带范围的数字转换）、expand_number/dehumanize_number（人类可读数与字节数互转）、fmtcheck（格式字符串验证）等辅助函数。",
        "evidence": [
          "src/strtonum.c",
          "src/strtoi.c",
          "src/strtou.c",
          "src/expand_number.c",
          "src/dehumanize_number.c",
          "src/humanize_number.c",
          "src/fmtcheck.c"
        ]
      },
      {
        "name": "数据结构与杂项",
        "description": "提供 BSD 风格的链表/队列宏（sys/queue.h）、树结构（sys/tree.h）、bitstring、heapsort/mergesort/radixsort 排序、getbsize（获取块大小）、MD5 摘要（委托 libmd/libc）等工具。",
        "evidence": [
          "include/bsd/sys/queue.h",
          "include/bsd/sys/tree.h",
          "src/heapsort.c",
          "src/merge.c",
          "src/radixsort.c",
          "src/md5.c",
          "src/getbsize.c"
        ]
      }
    ],
    "domain": "系统编程 / C 库",
    "target_users": "需要跨 Unix 平台可移植性的 C/C++ 项目开发者，尤其是从 BSD 移植到 Linux/其他平台的命令行工具与系统级软件"
  },
