  "function_summary": {
    "summary": "UDT（UDP-based Data Transfer）是一个基于 UDP 的高性能数据传输协议库，提供可靠的面向连接/数据报传输服务，专为高带宽延迟乘积网络（如长距离高速网络）设计。它由伊利诺伊大学开发，采用了一套自定义的拥塞控制与流量控制算法，绕过 TCP 的瓶颈，在传输大文件或批量数据时能达到接近链路带宽的利用率。",
    "categories": [
      {
        "name": "可靠 UDP 传输协议",
        "description": "在 UDP 之上实现类似 TCP 的可靠性（丢包重传、顺序交付），同时避免 TCP 协议的 AIMD 拥塞控制瓶颈。支持流模式（SOCK_STREAM）和数据报模式（SOCK_DGRAM）两种传输语义。",
        "evidence": [
          "src/core.cpp:82-2694",
          "src/channel.cpp:70-340",
          "src/packet.cpp"
        ]
      },
      {
        "name": "自定义拥塞控制",
        "description": "内置基于延迟的拥塞控制算法（UDT 默认），并支持通过 CCC（Congestion Control Class）接口扩展自定义拥塞控制算法。",
        "evidence": [
          "src/ccc.cpp",
          "src/ccc.h",
          "src/core.cpp"
        ]
      },
      {
        "name": "Socket API 兼容接口",
        "description": "提供类 BSD socket API（socket/bind/listen/accept/connect/send/recv/close），并扩展了 sendfile/recvfile 用于高效文件传输，以及 epoll 异步 I/O 多路复用接口。",
        "evidence": [
          "src/udt.h:304-359",
          "src/api.cpp:1562-2142"
        ]
      },
      {
        "name": "传输层安全（PRCv1）",
        "description": "内置基于 MD5 的简单认证/握手协议，防止未授权连接。",
        "evidence": [
          "src/md5.cpp",
          "src/md5.h"
        ]
      },
      {
        "name": "跨平台网络层",
        "description": "通过条件编译在 Windows（Winsock2）和 Linux/BSD/macOS（POSIX socket）之间提供统一的 UDP Socket 抽象。",
        "evidence": [
          "src/channel.cpp:41-67",
          "src/common.cpp:63-69",
          "src/udt.h:45-55"
        ]
      }
    ],
    "domain": "网络传输",
    "target_users": "需要高吞吐网络数据传输的应用开发者（科学数据转移、云计算数据传输、大文件分发等）",
    "ecosystem": "cpp"
  },
