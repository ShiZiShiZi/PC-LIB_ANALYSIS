  "function_summary": {
    "summary": "提供单精度（Complex64）复数浮点数的加法运算，支持对象模式和跨步数组模式。该库是 stdlib 标准数学库的一个微型模块，可用于浏览器和 Node.js 环境。",
    "categories": [
      {
        "name": "复数加法（对象模式）",
        "description": "接受两个 Complex64 对象，返回新的 Complex64 和对象。",
        "evidence": [
          "lib/main.js:46-50"
        ]
      },
      {
        "name": "复数加法（赋值模式）",
        "description": "将实部和虚部分量传入，结果写入已分配的浮点数组（支持 offset/stride）。",
        "evidence": [
          "lib/assign.js:46-50"
        ]
      },
      {
        "name": "复数加法（跨步数组模式）",
        "description": "从两个跨步存储的实值数组读取复数分量，计算结果写入提供的跨步输出数组。",
        "evidence": [
          "lib/strided.js:51-55"
        ]
      }
    ],
    "domain": "数值计算 / 数学库",
    "target_users": "JavaScript 数值计算开发者、Web 科学计算用户"
  },
