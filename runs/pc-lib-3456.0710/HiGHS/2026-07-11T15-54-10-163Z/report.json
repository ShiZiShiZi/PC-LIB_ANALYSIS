  "function_summary": {
    "summary": "HiGHS 是一个开源的线性优化求解器，用 C++ 编写，支持求解线性规划(LP)、混合整数规划(MIP)和凸二次规划(QP)问题。它提供原始/对偶修正单纯形法、内点法 LP 求解器、主动集 QP 求解器以及分支定界 MIP 求解器，并支持多线程并行 MIP 求解。HiGHS 通过 C API 暴露接口，并有 Python (highspy) 和 C# 绑定，可在 Linux、macOS 和 Windows 上运行，无需第三方依赖。",
    "categories": [
      {
        "name": "线性规划求解器 (LP Solver)",
        "description": "提供原始和对偶修正单纯形法，以及内点法求解大规模稀疏线性规划问题。",
        "evidence": [
          "highs/lp_data/Highs.cpp: 包含 passModel, readModel, solve 等核心 LP 求解接口",
          "highs/ipm/ipx/lp_solver.cc: 内点法 LP 求解实现"
        ]
      },
      {
        "name": "混合整数规划求解器 (MIP Solver)",
        "description": "基于分支定界/分支切割法求解混合整数线性规划问题，支持多线程并行搜索。",
        "evidence": [
          "highs/mip/HighsMipSolverData.cpp: MIP 分支定界核心逻辑",
          "highs/mip/HighsSearch.cpp: MIP 搜索树节点处理"
        ]
      },
      {
        "name": "二次规划求解器 (QP Solver)",
        "description": "使用主动集法求解凸二次规划问题，支持热启动。",
        "evidence": [
          "highs/qpsolver/: QP 求解器模块"
        ]
      },
      {
        "name": "预处理 (Presolve)",
        "description": "对输入模型进行行/列缩减、约束传播等预处理以减少问题规模，加速求解。",
        "evidence": [
          "highs/presolve/: 预处理模块"
        ]
      },
      {
        "name": "模型 I/O 与文件格式支持",
        "description": "支持从 .mps、.lp、.ems 等标准数学规划文件格式读取和写入模型。",
        "evidence": [
          "highs/io/: 文件 I/O 模块",
          "highs/io/filereaderlp/reader.cpp: LP 文件解析器"
        ]
      },
      {
        "name": "多语言绑定 (Language Bindings)",
        "description": "提供 C API 供外部调用，并提供 Python (highspy/pybind11) 和 C# (NuGet) 的封装绑定。",
        "evidence": [
          "highspy/highs_bindings.cpp: pybind11 Python 绑定",
          "highs/interfaces/highs_csharp_api.cs: C# 接口实现"
        ]
      }
    ],
    "domain": "数学优化 / 运筹学",
    "target_users": "运筹优化研究人员、数据科学家、工业应用开发者、需要求解大规模 LP/MIP/QP 问题的工程师",
    "ecosystem": "cpp"
  },
