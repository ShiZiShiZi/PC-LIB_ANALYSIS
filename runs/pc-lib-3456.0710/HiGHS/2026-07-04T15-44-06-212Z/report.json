  "function_summary": {
    "summary": "HiGHS 是一个高性能串行及并行大规模稀疏线性优化求解器，主要求解线性规划（LP）、凸二次规划（QP）和混合整数规划（MIP）问题。核心由 C++ 实现，提供 C、Python、C#、Fortran、Julia 等多语言接口。无需第三方依赖即可编译运行，广泛应用于运筹学、供应链优化、金融工程等领域的学者与工业用户。",
    "categories": [
      {
        "name": "线性规划求解",
        "description": "基于原始/对偶修正单纯形法的 LP 求解，支持大规模稀疏问题。",
        "evidence": [
          "highs/simplex/HEkkDual.cpp",
          "highs/simplex/HEkkPrimal.cpp",
          "highs/simplex/HEkk.h"
        ]
      },
      {
        "name": "内点法求解",
        "description": "LP 内点法求解器（IPM/IPX），含 crossover 与精化步骤，适用于大规模稠密/病态问题。",
        "evidence": [
          "highs/ipm/ipx/lp_solver.cc",
          "highs/ipm/hipo/ipm/Solver.cpp"
        ]
      },
      {
        "name": "混合整数规划求解",
        "description": "基于分支定界与割平面法的 MIP 求解，含 presolve、启发式算法、分离器等。",
        "evidence": [
          "highs/mip/HighsMipSolver.cpp",
          "highs/mip/HighsSearch.cpp",
          "highs/mip/HighsSeparator.h"
        ]
      },
      {
        "name": "二次规划求解",
        "description": "QP 主动集求解器与 PDQP 算子分裂法。",
        "evidence": [
          "highs/qpsolver/",
          "highs/pdlp/CupdlpWrapper.cpp"
        ]
      },
      {
        "name": "Presolve 预处理",
        "description": "模型化简、变量/约束消除等求解前预处理。",
        "evidence": [
          "highs/presolve/HPresolve.cpp"
        ]
      },
      {
        "name": "多语言接口",
        "description": "提供 C 原生 API、Python (highspy via pybind11)、C# (NuGet)、Fortran、Julia 等接口。",
        "evidence": [
          "highs/interfaces/highs_c_api.h",
          "highspy/highspy/",
          "highs/Highs.h"
        ]
      },
      {
        "name": "并行任务调度",
        "description": "基于任务窃取（task-stealing）的细粒度并行框架。",
        "evidence": [
          "highs/parallel/HighsTaskExecutor.cpp",
          "highs/parallel/HighsParallel.h"
        ]
      }
    ],
    "domain": "数学优化 / 运筹学",
    "target_users": "运筹学研究人员、供应链/物流/金融工程师、工业优化应用开发者"
  },
