  "function_summary": {
    "summary": "Serilog 是面向 .NET 平台的结构化诊断日志库，核心创新是采用消息模板（Message Templates）在记录时捕获具名参数值而非仅格式化文本，使日志事件天然具备可查询的结构化属性。库提供流畅的 C# 配置语法（LoggerConfiguration），支持多级日志（Verbose/Debug/Information/Warning/Error/Fatal）、丰富的上下文增强（LogContext/Enricher）、灵活的过滤与输出目标（Sink）插件体系，以及 JSON/文本等多种格式化输出。适用于从简单控制台应用到复杂分布式系统的全场景日志记录需求。",
    "categories": [
      {
        "name": "结构化日志记录",
        "description": "通过消息模板语法捕获具名参数属性，生成可查询的结构化日志事件（LogEvent），而非简单文本",
        "evidence": [
          "src/Serilog/Events/LogEvent.cs",
          "src/Serilog/Parsing/MessageTemplateParser.cs",
          "src/Serilog/Capturing/MessageTemplateProcessor.cs"
        ]
      },
      {
        "name": "日志管道配置",
        "description": "流畅 API 风格的 LoggerConfiguration 支持最小级别、输出目标（Sink）、审计、过滤、解构策略、上下文增强等全方位配置",
        "evidence": [
          "src/Serilog/LoggerConfiguration.cs",
          "src/Serilog/Configuration/LoggerSinkConfiguration.cs",
          "src/Serilog/Configuration/LoggerMinimumLevelConfiguration.cs"
        ]
      },
      {
        "name": "上下文增强与传播",
        "description": "LogContext 利用 AsyncLocal 实现跨异步调用的上下文属性传播，Enricher 机制允许动态添加属性（如线程 ID、进程信息）",
        "evidence": [
          "src/Serilog/Context/LogContext.cs",
          "src/Serilog/Core/ILogEventEnricher.cs",
          "src/Serilog/Context/LogContextEnricher.cs"
        ]
      },
      {
        "name": "Sink 插件体系",
        "description": "定义 ILogEventSink/IBatchedLogEventSink 接口，内置聚合、过滤、条件、批处理等管道 Sink，外部 Sink 包（Console/File/Elasticsearch 等）通过扩展方法接入",
        "evidence": [
          "src/Serilog/Core/ILogEventSink.cs",
          "src/Serilog/Core/IBatchedLogEventSink.cs",
          "src/Serilog/Core/Sinks/Batching/BatchingSink.cs"
        ]
      },
      {
        "name": "格式化输出",
        "description": "内置 DisplayFormat（文本）与 JSON 格式化器，JsonValueFormatter 将结构化属性递归序列化为 JSON，支持自定义 ITextFormatter",
        "evidence": [
          "src/Serilog/Formatting/Json/JsonValueFormatter.cs",
          "src/Serilog/Formatting/Display/MessageTemplateTextFormatter.cs",
          "src/Serilog/Formatting/ITextFormatter.cs"
        ]
      },
      {
        "name": "属性值解构",
        "description": "PropertyValueConverter 将 .NET 对象解构为日志属性值（ScalarValue/StructureValue/SequenceValue/DictionaryValue），支持自定义解构策略与深度/长度/集合上限控制",
        "evidence": [
          "src/Serilog/Capturing/PropertyValueConverter.cs",
          "src/Serilog/Core/IDestructuringPolicy.cs",
          "src/Serilog/Policies/"
        ]
      }
    ],
    "domain": "日志/可观测性",
    "target_users": ".NET 应用开发者，尤其是需要结构化日志、分布式追踪能力的中大型项目与微服务团队"
  },
