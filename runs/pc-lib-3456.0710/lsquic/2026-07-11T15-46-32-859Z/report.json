  "function_summary": {
    "summary": "LiteSpeed QUIC（LSQUIC）是一个用 C 语言实现的 QUIC 和 HTTP/3 协议库，面向服务器和客户端开发者。它提供了完整的 QUIC v1/v2、HTTP/3 以及旧版 Google QUIC 协议支持，包含连接管理、流控制、TLS 加密集成（基于 BoringSSL/OpenSSL）、HTTP 头部处理与 QPACK 压缩、丢包恢复与拥塞控制等核心能力。该库被 LiteSpeed Web Server、LiteSpeed ADC 和 OpenLiteSpeed 等生产环境实际使用。",
    "categories": [
      {
        "name": "QUIC 传输协议",
        "description": "完整实现 QUIC v1（RFC 9000）、v2（RFC 9369）及旧版 Google QUIC（Q043/Q046/Q050）传输协议，包括连接建立与握手、流多路复用、连接迁移、路径验证等核心传输机制。",
        "evidence": [
          "src/liblsquic/lsquic_full_conn_ietf.c",
          "include/lsquic.h"
        ]
      },
      {
        "name": "HTTP/3 支持",
        "description": "在 QUIC 之上实现 HTTP/3（RFC 9114）服务端与客户端功能，提供 HTTP 头部发送/接收接口与 QPACK（RFC 9204）头部压缩方案。",
        "evidence": [
          "src/liblsquic/lsquic_http.c",
          "src/liblsquic/lsquic_headers_stream.c",
          "bin/http_server.c",
          "bin/http_client.c"
        ]
      },
      {
        "name": "TLS 加密集成",
        "description": "通过 BoringSSL 或 OpenSSL 实现 QUIC 的 TLS 1.3 握手与传输加密，支持会话恢复与 0-RTT 数据发送。",
        "evidence": [
          "src/liblsquic/lsquic_enc_sess_ietf.c",
          "src/liblsquic/lsquic_handshake.c"
        ]
      },
      {
        "name": "拥塞控制与丢包恢复",
        "description": "内置 CUBIC、BBR v1 等多种拥塞控制算法，以及基于 RFC 9002 的丢包检测与重传恢复机制。",
        "evidence": [
          "src/liblsquic/lsquic_cubic.c",
          "src/liblsquic/lsquic_bbr.c",
          "src/liblsquic/lsquic_send_ctl.c"
        ]
      },
      {
        "name": "事件驱动的非阻塞 I/O",
        "description": "以回调驱动的事件循环模型暴露 API，不与特定事件库绑定；示例程序使用 libevent 演示集成方式。",
        "evidence": [
          "include/lsquic.h:struct lsquic_stream_if",
          "include/lsquic.h:struct lsquic_engine_api",
          "bin/prog.c"
        ]
      }
    ],
    "domain": "网络协议 / 传输层",
    "target_users": "C/C++ 服务器与客户端应用程序开发者，需集成 QUIC/HTTP3 协议栈的网络中间件和负载均衡器",
    "ecosystem": "cpp"
  },
