  "function_summary": {
    "summary": "napi_screenshot 是一个 Node.js 原生扩展模块，基于 NAPI-RS（Rust + N-API）构建。它通过 Rust FFI 调用操作系统底层图形 API（当前仅实现 Windows GDI）捕获屏幕内容，并将截图以 PNG 格式提供给 Node.js 应用。面向需要在 Node.js 端进行屏幕截图的桌面应用与自动化工具开发者。",
    "categories": [
      {
        "name": "屏幕截图",
        "description": "捕获显示器画面内容并输出为 PNG 图像数据",
        "evidence": [
          "src/core/win32.rs",
          "src/core/darwin.rs",
          "src/core/linux.rs",
          "src/napi.rs:screen_shots",
          "src/napi.rs:get_screen_shot_by_display_info"
        ]
      },
      {
        "name": "显示信息枚举",
        "description": "查询系统所有显示器的几何属性与缩放信息",
        "evidence": [
          "src/napi.rs:get_display_infos",
          "src/napi.rs:DisplayInfo"
        ]
      }
    ],
    "domain": "桌面截图",
    "target_users": "Node.js 桌面应用开发者、自动化测试/截图工具开发者"
  },
