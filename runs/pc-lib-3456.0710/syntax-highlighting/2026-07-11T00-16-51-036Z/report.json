  "function_summary": {
    "summary": "KSyntaxHighlighting 是 KDE Frameworks 6 下的独立语法高亮引擎，基于 Kate 编辑器的 XML 格式高亮定义文件，支持 300+ 种编程语言与标记语言的词法高亮。提供 C++ API（AbstractHighlighter / SyntaxHighlighter）供文本编辑器集成，以及 QML API 供 Qt Quick 应用使用；同时支持将高亮结果输出为 HTML 或 ANSI 转义码，适用于纯文本高亮渲染场景。",
    "categories": [
      {
        "name": "语法高亮引擎",
        "description": "解析 XML 格式的 Kate 语法定义文件，执行基于上下文的关键词、正则规则匹配，生成带格式的文本区间；核心类为 Definition 与 AbstractHighlighter，每一行高亮结果通过 applyFormat / applyFolding 回调输出。",
        "evidence": [
          "src/lib/definition.cpp",
          "src/lib/abstracthighlighter.cpp",
          "src/lib/state.cpp",
          "src/lib/rule.cpp",
          "src/lib/context.cpp",
          "src/lib/format.cpp"
        ]
      },
      {
        "name": "QSyntaxHighlighter 集成",
        "description": "提供 SyntaxHighlighter 类，继承 QSyntaxHighlighter 与 AbstractHighlighter，可直接用于 QTextDocument 或 QML TextEdit 的实时语法高亮，支持部分重高亮与代码折叠区域跟踪。",
        "evidence": [
          "src/lib/syntaxhighlighter.cpp",
          "src/lib/syntaxhighlighter.h"
        ]
      },
      {
        "name": "QML 绑定",
        "description": "通过 src/quick/ 下的 KQuickSyntaxHighlighter 向 QML 暴露 SyntaxHighlighter 组件，允许 QML 的 TextArea/TextEdit 直接使用与 C++ 相同的高亮引擎。",
        "evidence": [
          "src/quick/kquicksyntaxhighlighter.cpp",
          "src/quick/kquicksyntaxhighlighter.h",
          "src/quick/types.cpp"
        ]
      },
      {
        "name": "高亮输出渲染",
        "description": "支持将高亮结果输出为 HTML（HtmlHighlighter）或 ANSI 转义序列（AnsiHighlighter），适用于网页展示或终端显示；两种输出均为 AbstractHighlighter 的子类。",
        "evidence": [
          "src/lib/htmlhighlighter.cpp",
          "src/lib/htmlhighlighter.h",
          "src/lib/ansihighlighter.cpp",
          "src/lib/ansihighlighter.h"
        ]
      },
      {
        "name": "语法定义在线更新",
        "description": "DefinitionDownloader 可从 kate-editor.org 下载最新 XML 高亮定义文件并自动合并到本地仓库中。",
        "evidence": [
          "src/lib/definitiondownloader.cpp",
          "src/lib/definitiondownloader.h"
        ]
      },
      {
        "name": "主题管理",
        "description": "Theme 类管理 JSON 格式的颜色主题定义（.theme 文件），控制文本高亮的前景色、背景色、粗斜体等样式；支持从文件系统或 Qt 资源加载自定义主题。",
        "evidence": [
          "src/lib/theme.cpp",
          "src/lib/theme.h",
          "src/lib/themedata.cpp"
        ]
      }
    ],
    "domain": "文本编辑 / IDE 基础设施",
    "target_users": "文本编辑器、IDE 与代码查看器开发者",
    "ecosystem": "cpp"
  },
