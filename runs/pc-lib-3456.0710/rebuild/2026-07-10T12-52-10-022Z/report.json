  "function_summary": {
    "summary": "@electron/rebuild 是一个面向 Electron 开发者的 CLI 工具（同时提供可编程 API），用于将项目中的原生 Node.js 模块（C++ addon）针对当前安装的 Electron 版本重新编译，使原生模块能在 Electron 应用中正常加载运行。它会自动检测项目中需要重建的原生模块，下载对应 Electron 版本的 C++ 头文件，并通过 node-gyp 执行重新编译。",
    "categories": [
      {
        "name": "Electron 原生模块重建",
        "description": "检测项目中的原生 Node.js 模块（含 binding.gyp），下载对应 Electron 版本的 Node.js 头文件，通过 node-gyp 执行重建编译",
        "evidence": [
          "src/rebuild.ts",
          "src/module-rebuilder.ts",
          "src/module-walker.ts"
        ]
      },
      {
        "name": "Electron 版本自动检测",
        "description": "自动从项目的 node_modules 中定位 electron 模块并读取其版本号，无需手动指定",
        "evidence": [
          "src/electron-locator.ts",
          "src/cli.ts:158-172"
        ]
      },
      {
        "name": "Electron Clang 编译工具链",
        "description": "支持下载 Electron 官方构建使用的 clang 编译器版本，确保 ABI 兼容性",
        "evidence": [
          "src/clang-fetcher.ts",
          "src/sysroot-fetcher.ts"
        ]
      },
      {
        "name": "可编程 API",
        "description": "提供 import { rebuild } from '@electron/rebuild' 的编程接口，可集成到 Electron Forge、Electron Packager 等构建流程中",
        "evidence": [
          "src/main.ts",
          "src/rebuild.ts:350-361"
        ]
      },
      {
        "name": "CLI 命令行工具",
        "description": "提供 electron-rebuild 命令行入口，支持 --version、--arch、--module-dir 等参数，以及并行/串行编译控制",
        "evidence": [
          "src/cli.ts",
          "package.json:19-21"
        ]
      }
    ],
    "domain": "Electron 应用开发与构建工具链",
