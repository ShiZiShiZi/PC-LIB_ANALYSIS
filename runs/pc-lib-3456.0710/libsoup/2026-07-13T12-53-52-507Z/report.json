  "function_summary": {
    "summary": "libsoup 是 GNOME 桌面环境下的 HTTP 客户端/服务器库。它基于 GObject 对象系统与 glib 主循环，提供同步与异步两套 API，可自动缓存连接，支持 TLS/SSL 加密传输、HTTP 代理（含认证与 SSL 隧道）、客户端 Digest/NTLM/Basic 认证以及服务端 Digest/Basic 认证。适用于需要 HTTP 通信的 GNOME 应用及其他使用 GLib 生态的 C 程序。",
    "categories": [
      {
        "name": "HTTP 客户端",
        "description": "提供同步与异步 HTTP 客户端能力，包括请求构造、响应解析、连接复用、重定向处理、消息体流式读取等",
        "evidence": [
          "libsoup/soup-session.c",
          "libsoup/soup-session.h",
          "libsoup/soup-message.c"
        ]
      },
      {
        "name": "HTTP 服务器",
        "description": "提供异步 HTTP 服务端能力，支持路由映射、请求处理回调、静态文件服务、WebSocket 升级等",
        "evidence": [
          "libsoup/server/soup-server.c",
          "libsoup/server/soup-server.h",
          "libsoup/server/soup-server-message.c"
        ]
      },
      {
        "name": "HTTP/2 支持",
        "description": "基于 nghttp2 库实现 HTTP/2 协议支持，包括多路复用、头部压缩 (HPACK)、服务器推送等",
        "evidence": [
          "libsoup/http2/soup-client-message-io-http2.c",
          "libsoup/server/http2/soup-server-message-io-http2.c"
        ]
      },
      {
        "name": "WebSocket",
        "description": "支持客户端与服务端 WebSocket 连接，包括消息收发、扩展协商（如 permessage-deflate 压缩）",
        "evidence": [
          "libsoup/websocket/soup-websocket.c",
          "libsoup/websocket/soup-websocket-connection.c"
        ]
      },
      {
        "name": "认证",
        "description": "客户端支持 Basic、Digest、NTLM (SSO) 与 GSSAPI/Kerberos Negotiate 认证；服务端支持 Basic 与 Digest 认证域",
        "evidence": [
          "libsoup/auth/soup-auth.c",
          "libsoup/auth/soup-auth-ntlm.c",
          "libsoup/auth/soup-auth-negotiate.c",
          "libsoup/server/soup-auth-domain.c"
        ]
      },
      {
        "name": "缓存与内容处理",
        "description": "提供可插拔的 HTTP 缓存机制，支持 Brotli 与 Zstandard 响应解码，以及 MIME 内容嗅探",
        "evidence": [
          "libsoup/cache/soup-cache.c",
          "libsoup/content-decoder/soup-content-decoder.c",
          "libsoup/content-sniffer/soup-content-sniffer.c"
        ]
      },
      {
        "name": "Cookie 管理",
        "description": "支持 Cookie 解析、存储（SQLite 持久化或纯文本）与自动发送，兼容 Mozilla cookies.txt 格式",
        "evidence": [
          "libsoup/cookies/soup-cookie.c",
          "libsoup/cookies/soup-cookie-jar.c",
          "libsoup/cookies/soup-cookie-jar-db.c"
        ]
      }
    ],
    "domain": "网络通信（HTTP 协议栈）",
    "target_users": "GNOME / GLib 生态 C 应用程序开发者，需要 HTTP 通信能力的桌面应用与服务"
  },
