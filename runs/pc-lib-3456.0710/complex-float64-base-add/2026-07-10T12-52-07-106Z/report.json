  "function_summary": {
    "summary": "对两个双精度复数浮点数执行加法运算。提供纯 JavaScript 实现与基于 C 的原生 N-API 绑定两种后端，兼顾跨平台兼容性与高性能。属于 stdlib 数值科学计算标准库的底层基础模块。",
    "categories": [
      {
        "name": "复数加法运算",
        "description": "将两个双精度复数（实部+虚部）逐分量相加，返回新的复数结果",
        "evidence": [
          "lib/main.js",
          "src/main.c"
        ]
      },
      {
        "name": "数组视图接口",
        "description": "提供 assign（实数分量分别传入）与 strided（通过跨步数组视图操作）两种批量/底层调用方式",
        "evidence": [
          "lib/assign.js",
          "lib/strided.js"
        ]
      },
      {
        "name": "双后端实现",
        "description": "主入口根据环境自动选择原生 C N-API 绑定（src/addon.c）或纯 JavaScript 回退（lib/main.js），保证可移植性",
        "evidence": [
          "lib/index.js",
          "lib/native.js",
          "src/addon.c"
        ]
      }
