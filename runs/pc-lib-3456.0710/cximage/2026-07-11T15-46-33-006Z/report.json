  "function_summary": {
    "summary": "CxImage 是一个跨平台 C++ 图像处理库，提供多种图像格式的加载、转换、显示与简单编辑功能，面向需要图像编解码与基础图像处理的 C/C++ 桌面应用开发者。核心类 CxImage 通过统一 API 封装了各类第三方编解码器，支持 BMP、GIF、JPG、PNG、TIF、ICO、TGA、PCX、WBMP、WMF、JP2、JBG、MNG、RAW、PSD 等十余种格式的读写，并内置缩放、旋转、颜色调整、滤镜等图像处理操作。",
    "categories": [
      {
        "name": "多格式图像编解码",
        "description": "通过集成 zlib、libjpeg、libpng、libtiff、libmng、jasper、libpsd、jbig、dcraw 等第三方解码器，统一读写十余种图像格式，支持单帧及多帧（GIF/MNG/TIF）。",
        "evidence": [
          "CxImage/ximaenc.cpp",
          "CxImage/ximabmp.cpp",
          "CxImage/ximagif.cpp",
          "CxImage/ximajpg.cpp",
          "CxImage/ximapng.cpp",
          "CxImage/ximatif.cpp",
          "CxImage/ximaico.cpp",
          "CxImage/ximatga.cpp",
          "CxImage/ximapcx.cpp",
          "CxImage/ximawbmp.cpp",
          "CxImage/ximajbg.cpp",
          "CxImage/ximajas.cpp",
          "CxImage/ximamng.cpp",
          "CxImage/ximaraw.cpp"
        ]
      },
      {
        "name": "图像处理与变换",
        "description": "提供缩放、旋转、镜像、翻转、裁剪、降色（dither）、二值化等几何变换，以及亮度对比度、伽马校正、灰度化、直方图均衡、色彩通道分离、老照片效果等像素级操作。",
        "evidence": [
          "CxImage/ximatran.cpp",
          "CxImage/ximadsp.cpp",
          "CxImage/ximaska.cpp",
          "CxImage/ximalpha.cpp"
        ]
      },
      {
        "name": "Windows 平台集成",
        "description": "提供 GDI 互操作（HBITMAP/HICON 创建与转换）、剪贴板粘贴、ActiveX 控件封装（CxImage_ocx），以及 WMF/EMF 图元文件支持，便于在 Windows 桌面应用中直接使用。",
        "evidence": [
          "CxImage/ximawnd.cpp",
          "CxImage/ximawmf.cpp",
          "CxImage_ocx/"
        ]
      },
      {
        "name": "内存与流式文件访问",
        "description": "支持从内存缓冲区、文件、自定义 CxFile/CxMemFile 流对象加载和保存图像，提供灵活的数据源抽象。",
        "evidence": [
          "CxImage/xfile.h",
          "CxImage/xiofile.h",
          "CxImage/xmemfile.h",
          "CxImage/xmemfile.cpp",
          "CxImage/tif_xfile.cpp"
        ]
      }
    ],
    "domain": "图像编解码与处理",
    "target_users": "C/C++ 桌面应用开发者",
    "ecosystem": "cpp"
  },
