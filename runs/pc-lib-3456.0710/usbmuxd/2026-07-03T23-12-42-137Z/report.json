  "function_summary": {
    "summary": "usbmuxd 是 libimobiledevice 生态中的 USB 多路复用守护进程。它通过 libusb 与 Apple iOS 设备通信，在本地 Unix 域套接字 /var/run/usbmuxd 上暴露服务，让客户端应用能够发现已连接设备并建立到设备内部任意监听端口的 TCP 隧道。",
    "categories": [
      {
        "name": "USB 设备发现与连接管理",
        "description": "使用 libusb 枚举 Apple USB 设备，处理热插拔事件，选择正确的配置与接口，分离内核驱动并声明接口。",
        "evidence": [
          "src/usb.c:usb_init",
          "src/usb.c:usb_discover",
          "src/usb.c:usb_device_add",
          "src/usb.c:set_valid_configuration"
        ]
      },
      {
        "name": "Apple USB MUX 协议引擎",
        "description": "实现 Apple 私有 USB 多路复用协议，完成版本协商、TCP over MUX 报文封装/解封装、连接状态机，以及 Apple 特定模式查询与切换。",
        "evidence": [
          "src/device.c:send_packet",
          "src/device.c:device_tcp_input",
          "src/device.c:device_version_input",
          "src/usb.c:guess_mode",
          "src/usb.c:get_mode_cb"
        ]
      },
      {
        "name": "客户端 socket 服务",
        "description": "监听 Unix 域套接字或 TCP 端口，接受 libusbmuxd 客户端连接，处理 Listen/Connect/ListDevices/ReadPairRecord 等 plist/二进制命令。",
        "evidence": [
          "src/main.c:create_socket",
          "src/client.c:client_accept",
          "src/client.c:handle_command"
        ]
      },
      {
        "name": "配对预检工作线程",
        "description": "在设备插入后启动后台线程，通过 libimobiledevice 与 lockdownd 通信，完成配对、信任对话框和 StartSession，之后才让设备对客户端可见。",
        "evidence": [
          "src/preflight.c:preflight_worker_handle_device_add",
          "src/preflight.c:preflight_worker_device_add"
        ]
      },
      {
        "name": "配置与配对记录持久化",
        "description": "生成并保存 SystemBUID，以及按设备 UDID 存取配对记录 plist 文件，供后续会话复用。",
        "evidence": [
          "src/conf.c:config_get_system_buid",
          "src/conf.c:config_set_device_record",
          "src/conf.c:config_get_device_record"
        ]
      }
    ],
    "domain": "mobile device usb multiplexing",
    "target_users": "需要在 Linux/macOS/Windows 上与 iOS 设备通信的终端用户和开发者，通常作为 libimobiledevice 工具链的后台服务运行"
  },
