  "function_summary": {
    "summary": "py-amqp 是 AMQP 0.9.1 协议的 Python 客户端实现，源自对 amqplib 的 fork，由 Celery 项目维护。它提供底层 AMQP 连接、信道管理、消息发布与消费、认证（PLAIN/AMQPLAIN/GSSAPI/EXTERNAL）、SSL/TLS 传输、心跳保活及 RabbitMQ 扩展功能（发布确认、消费取消通知、交换器绑定等）。被 Celery 的消息中间件 Kombu 作为纯 Python 替代 librabbitmq 使用，适用于需要直接操控 AMQP 协议的后端开发者和消息系统集成场景。",
    "categories": [
      {
        "name": "AMQP 连接与信道管理",
        "description": "建立和维护与 AMQP Broker 的 TCP/SSL 连接，管理多路复用信道，支持连接恢复与错误处理",
        "evidence": [
          "amqp/connection.py",
          "amqp/channel.py",
          "amqp/transport.py"
        ]
      },
      {
        "name": "消息发布与消费",
        "description": "实现 Basic.publish、Basic.consume、Basic.get 等核心消息操作，支持确认模式（ACK/NACK）、发布确认（Publisher Confirms）和消费者取消回调",
        "evidence": [
          "amqp/channel.py",
          "amqp/basic_message.py"
        ]
      },
      {
        "name": "交换器与队列管理",
        "description": "声明、绑定、删除和卸载 AMQP 交换器与队列，支持 direct/fanout/topic 等多种交换类型及默认交换",
        "evidence": [
          "amqp/channel.py"
        ]
      },
      {
        "name": "认证与安全传输",
        "description": "提供多种 SASL 认证机制（PLAIN、AMQPLAIN、GSSAPI/Kerberos、EXTERNAL），以及基于 Python ssl 模块的可选 SSL/TLS 安全传输",
        "evidence": [
          "amqp/sasl.py",
          "amqp/transport.py"
        ]
      },
      {
        "name": "心跳保活与连接健康检测",
        "description": "实现 AMQP 心跳机制，通过 heartbeat_tick 定期发送心跳帧，检测连接丢失并自动处理重连",
        "evidence": [
          "amqp/connection.py"
        ]
      },
      {
        "name": "协议帧编解码",
        "description": "实现 AMQP 0.9.1 协议帧的序列化、反序列化、帧写入与帧处理管线",
        "evidence": [
          "amqp/serialization.py",
          "amqp/method_framing.py",
          "amqp/spec.py"
        ]
      },
      {
        "name": "可选的 Cython 加速",
        "description": "实验性支持通过 Cython 编译核心模块为原生扩展以提升性能，需设置 CELERY_ENABLE_SPEEDUPS 环境变量启用",
        "evidence": [
          "setup.py",
          "amqp/abstract_channel.pxd",
          "amqp/serialization.pxd"
        ]
      }
    ],
    "domain": "消息中间件 / 分布式通信",
    "target_users": "Python 后端开发者，特别是需要与 RabbitMQ 等 AMQP 兼容消息队列直接交互的应用开发和中间件集成者"
  },
