  "function_summary": {
    "summary": "NDesk.Options.Core 是一个纯 C# 实现的命令行选项解析库，采用回调模式，开发者通过 OptionSet 类以集合初始化器和 lambda 委托的方式定义选项名称、是否支持值参数以及匹配后的回调行为。支持短选项（-v）、长选项（--verbose）和 Windows 风格选项（/v）、选项捆绑（-abc）、选项值提取（= 必选值 / : 可选值）、System.ComponentModel.TypeConverter 类型转换以及选项终止符 --，功能对标 Perl 的 Getopt::Long。适用于需要命令行参数解析的 .NET 控制台应用和工具。",
    "categories": [
      {
        "name": "选项定义与解析",
        "description": "通过 OptionSet 类以简洁的委托/集合初始化器语法定义选项别名、值类型和回调，解析命令行参数数组",
        "evidence": [
          "src/OptionSet.cs",
          "src/Options.cs"
        ]
      },
      {
        "name": "类型转换",
        "description": "支持通过 System.ComponentModel.TypeConverter 将字符串选项值转换为任意自定义数据类型",
        "evidence": [
          "src/Option.cs:62-77",
          "src/Converter/FooConverter.cs"
        ]
      },
      {
        "name": "选项值处理",
        "description": "支持必选值（=）、可选值（:）、无值选项以及键值对分隔符自定义",
        "evidence": [
          "src/Option.cs:79-108",
          "src/OptionValueType.cs"
        ]
      },
      {
        "name": "帮助文本输出",
        "description": "自动生成格式化的选项描述文本，方便向用户展示命令行用法",
        "evidence": [
          "src/OptionSet.cs:297-324"
        ]
      }
    ],
    "domain": "命令行工具 / 控制台应用",
    "target_users": ".NET 命令行应用开发者",
    "ecosystem": "dotnet"
