  "function_summary": {
    "summary": "C++ REST SDK（又名 Casablanca）是微软推出的跨平台 C++ 库，面向需要从 C++ 原生代码发起 HTTP 请求、构建 REST 服务、处理 JSON 数据的开发者。它基于 C++11 异步编程模型（PPL 任务），在 Windows、Linux、macOS、iOS、Android 等平台上提供统一的 HTTP 客户端/服务端、WebSocket 客户端、URI 解析与构建、JSON 序列化/反序列化以及 OAuth 1.0/2.0 认证支持。",
    "categories": [
      {
        "name": "HTTP 客户端",
        "description": "异步 HTTP/HTTPS 客户端，支持 GET/POST/PUT/DELETE 等方法、自定义请求头、超时、代理与流式响应读取；后端在 Windows 上使用 WinHTTP，在其他平台使用 Boost.ASIO。",
        "evidence": [
          "Release/include/cpprest/http_client.h",
          "Release/src/http/client/http_client.cpp",
          "Release/src/http/client/http_client_winhttp.cpp",
          "Release/src/http/client/http_client_asio.cpp"
        ]
      },
      {
        "name": "HTTP 服务端",
        "description": "基于事件驱动的 HTTP 服务端（listener），支持路由到处理函数、并发请求处理；Windows 上使用 HTTP Server API (http.sys)，其他平台使用 Boost.ASIO。",
        "evidence": [
          "Release/include/cpprest/http_listener.h",
          "Release/src/http/listener/http_listener.cpp",
          "Release/src/http/listener/http_server_httpsys.cpp",
          "Release/src/http/listener/http_server_asio.cpp"
        ]
      },
      {
        "name": "JSON 解析与构建",
        "description": "流式 JSON 解析与序列化/反序列化，支持从 C++ 对象到 JSON 的双向映射，提供 JSON 值对象的树形操作。",
        "evidence": [
          "Release/include/cpprest/json.h",
          "Release/src/json/json.cpp",
          "Release/src/json/json_parsing.cpp",
          "Release/src/json/json_serialization.cpp"
        ]
      },
      {
        "name": "WebSocket 客户端",
        "description": "支持 RFC 6455 的 WebSocket 客户端，可收发文本与二进制消息；后端基于 websocketpp 或 WinRT（UWP）。",
        "evidence": [
          "Release/include/cpprest/ws_client.h",
          "Release/src/websockets/client/ws_client.cpp",
          "Release/src/websockets/client/ws_client_wspp.cpp"
        ]
      },
      {
        "name": "URI 解析与构建",
        "description": "符合 RFC 3986 的 URI 解析、规范化与构建工具，支持查询参数操作与编码解码。",
        "evidence": [
          "Release/include/cpprest/uri.h",
          "Release/include/cpprest/uri_builder.h",
          "Release/src/uri/uri.cpp",
          "Release/src/uri/uri_builder.cpp"
        ]
      },
      {
        "name": "异步流与并发",
        "description": "C++11 PPL 任务模型，支持链式异步操作组合（task<T>.then()）、异步 I/O 流（producer/consumer stream）与文件流，提供跨平台并发编程原语。",
        "evidence": [
          "Release/include/pplx/pplx.h",
          "Release/include/pplx/pplxtasks.h",
          "Release/include/cpprest/streams.h",
          "Release/src/pplx/pplx.cpp"
        ]
      },
      {
        "name": "OAuth 认证",
        "description": "OAuth 1.0 和 OAuth 2.0 客户端认证流程的便捷封装，支持令牌获取与自动刷新。",
        "evidence": [
          "Release/include/cpprest/oauth1.h",
          "Release/include/cpprest/oauth2.h",
          "Release/src/http/oauth/oauth1.cpp",
          "Release/src/http/oauth/oauth2.cpp"
        ]
      }
    ],
    "domain": "网络与 Web 服务",
    "target_users": "C++ 应用程序开发者，需要从 C++ 原生代码连接 RESTful 服务、构建 HTTP 服务端或处理 JSON 数据的项目"
  },
