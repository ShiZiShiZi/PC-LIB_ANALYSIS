  "function_summary": {
    "summary": "C++ REST SDK（代号 Casablanca）是微软开源的跨平台 C++11 库，为原生 C++ 应用程序提供基于异步任务模型的云客户端-服务器通信能力。核心提供 HTTP 客户端（支持 HTTPS/TLS 及代理）、HTTP 监听器（服务器端）、WebSocket 客户端、JSON 解析/序列化、URI 构建与解析、OAuth 认证、异步流与文件 I/O 等功能。内部通过 PPLX 任务系统实现跨平台异步调度，在 Windows/Linux/macOS/iOS/Android 上均有对应的平台后端实现。",
    "categories": [
      {
        "name": "HTTP 客户端",
        "description": "基于 Boost.ASIO（Linux/macOS）或 WinHTTP（Windows）的异步 HTTP/HTTPS 客户端，支持代理连接、TLS 证书验证、HTTP 重定向、压缩（gzip/deflate/Brotli）、分块传输、基本认证与 OAuth。",
        "evidence": [
          "Release/include/cpprest/http_client.h",
          "Release/src/http/client/http_client_asio.cpp",
          "Release/src/http/client/http_client_winhttp.cpp"
        ]
      },
      {
        "name": "HTTP 服务器/监听器",
        "description": "提供异步 HTTP 服务器端 API，基于 Boost.ASIO（Linux/macOS）或 Windows HTTP Server API（httpsys），支持 URI 路由、多主机绑定、SSL/TLS。",
        "evidence": [
          "Release/include/cpprest/http_listener.h",
          "Release/src/http/listener/http_server_asio.cpp",
          "Release/src/http/listener/http_server_httpsys.cpp"
        ]
      },
      {
        "name": "WebSocket 客户端",
        "description": "基于 WebSocket++（wspp）或 WinRT 的 WebSocket 客户端实现，支持 wss:// 加密连接与多种子协议。",
        "evidence": [
          "Release/include/cpprest/ws_client.h",
          "Release/src/websockets/client/ws_client_wspp.cpp"
        ]
      },
      {
        "name": "JSON 处理",
        "description": "提供 JSON 值的解析（从字符串/流）、序列化与操作，支持对象、数组、数字、字符串、布尔、空值等类型及遍历。",
        "evidence": [
          "Release/include/cpprest/json.h",
          "Release/src/json/json_parsing.cpp",
          "Release/src/json/json_serialization.cpp"
        ]
      },
      {
        "name": "URI 构建与解析",
        "description": "提供 URI 的解析、构建、编码/解码、路径规范化等操作，支持分割各组成部分（scheme、host、port、path、query、fragment）。",
        "evidence": [
          "Release/include/cpprest/uri.h",
          "Release/include/cpprest/uri_builder.h",
          "Release/src/uri/uri.cpp"
        ]
      },
      {
        "name": "异步流与文件 I/O",
        "description": "提供跨平台的异步流抽象（istream/ostream/streambuf），支持内存流、文件流、生产者-消费者流等，底层依赖平台文件 API（Windows 或 POSIX）。",
        "evidence": [
          "Release/include/cpprest/streams.h",
          "Release/include/cpprest/filestream.h",
          "Release/src/streams/fileio_win32.cpp",
          "Release/src/streams/fileio_posix.cpp"
        ]
      },
      {
        "name": "认证（OAuth 1.0/2.0）",
        "description": "提供 OAuth 1.0 与 OAuth 2.0 认证协议的辅助工具，支持多种授权类型（authorization_code、client_credentials 等）。",
        "evidence": [
          "Release/include/cpprest/oauth1.h",
          "Release/include/cpprest/oauth2.h",
          "Release/src/http/oauth/oauth1.cpp",
          "Release/src/http/oauth/oauth2.cpp"
        ]
      },
      {
        "name": "PPLX 异步任务系统",
        "description": "内部跨平台任务并行库，提供 task、cancellation_token 等异步原语，在 Windows 上基于 Win32 线程池、Linux 上用 pthread、macOS 上用 GCD dispatch 实现。",
        "evidence": [
          "Release/include/pplx/pplxtasks.h",
          "Release/src/pplx/pplxwin.cpp",
          "Release/src/pplx/pplxlinux.cpp",
          "Release/src/pplx/pplxapple.cpp"
        ]
      }
    ],
    "domain": "网络通信",
    "target_users": "需要 HTTP/WebSocket 客户端或服务器功能的 C++ 应用开发者、跨平台原生应用开发团队",
    "ecosystem": "cpp"
