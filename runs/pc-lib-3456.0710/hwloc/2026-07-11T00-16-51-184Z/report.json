  "function_summary": {
    "summary": "hwloc（Portable Hardware Locality）是一个 C 语言库，用于发现和抽象现代计算平台的硬件拓扑结构——包括 CPU 核心/线程、多级缓存、NUMA 内存节点、PCI 总线与 I/O 设备。它提供跨平台（Linux/Windows/macOS/FreeBSD/Solaris/AIX 等）的 API，让高性能计算、并行运行时和系统管理工具能查询硬件布局、设置 CPU 与内存亲和性，从而优化任务调度和内存分配。",
    "categories": [
      {
        "name": "硬件拓扑发现与查询",
        "description": "自动发现 CPU 包（Package）、核心（Core）、硬件线程（PU）、各级缓存（L1/L2/L3/L4/L5）、NUMA 节点以及 PCI 设备、网络接口、GPU 等 I/O 设备的层级关系与属性。",
        "evidence": [
          "hwloc/topology.c",
          "hwloc/topology-linux.c",
          "hwloc/topology-windows.c",
          "hwloc/topology-darwin.c",
          "hwloc/topology-x86.c",
          "hwloc/topology-pci.c"
        ]
      },
      {
        "name": "CPU/内存亲和性（Binding）",
        "description": "提供可移植 API 将进程/线程绑定到指定 CPU 集合或 NUMA 内存节点，支持 STRICT/NONSTRICT 策略，跨 Linux sched_setaffinity、Windows SetProcessAffinityMask 等平台机制。",
        "evidence": [
          "hwloc/bind.c",
          "hwloc/memattrs.c",
          "include/hwloc/memattrs.h"
        ]
      },
      {
        "name": "CPU 位图（Bitmap）操作",
        "description": "高效的大范围 CPU/节点集合（cpuset/nodeset）位图操作，支持与/或/非/遍历等，最大可表示 16K+ 逻辑 CPU。",
        "evidence": [
          "hwloc/bitmap.c",
          "include/hwloc/bitmap.h"
        ]
      },
      {
        "name": "拓扑导入导出（XML/合成）",
        "description": "支持将发现的拓扑导出为 XML 供离线分析，也支持从 XML 或合成描述重新构建拓扑（无需实际硬件），便于测试和跨节点使用。",
        "evidence": [
          "hwloc/topology-xml.c",
          "hwloc/topology-xml-libxml.c",
          "hwloc/topology-xml-nolibxml.c",
          "hwloc/topology-synthetic.c"
        ]
      },
      {
        "name": "GPU/I/O 设备发现",
        "description": "通过 PCI 总线扫描发现 NVIDIA GPU（NVML）、AMD GPU（RSMI/ROCm）、Intel GPU（LevelZero）以及 OpenCL 设备，并提供与 CPU 拓扑的关联信息。",
        "evidence": [
          "hwloc/topology-cuda.c",
          "hwloc/topology-nvml.c",
          "hwloc/topology-opencl.c",
          "hwloc/topology-levelzero.c",
          "hwloc/topology-rsmi.c",
          "hwloc/topology-gl.c"
        ]
      },
      {
        "name": "命令行工具 lstopo",
        "description": "随库提供的图形化/文本拓扑查看工具，支持 ASCII/图形/PDF/SVG/XML 多种输出格式，直观展示系统硬件拓扑。",
        "evidence": [
          "utils/lstopo/lstopo.c",
          "utils/lstopo/lstopo-draw.c",
          "utils/lstopo/lstopo-cairo.c"
        ]
      }
    ],
    "domain": "系统软件 / HPC 运行时",
    "target_users": "HPC 开发者、并行运行时框架开发者和系统管理工具开发者",
    "ecosystem": "cpp"
  },
