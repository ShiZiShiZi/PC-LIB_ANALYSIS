  "function_summary": {
    "summary": "libdwarf 是一个 C 语言编写的跨平台库，用于从 ELF（Linux/BSD）、Mach-O（macOS）和 PE（Windows）目标文件中读取和解析 DWARF2 至 DWARF5 格式的调试信息。它提供 ABI 无关的访问接口，能检测并报告损坏的 DWARF 数据，避免运行时崩溃和内存泄漏。附带 dwarfdump 工具可用于打印和验证 DWARF 内容。",
    "categories": [
      {
        "name": "DWARF 调试信息读取",
        "description": "提供完整的 DWARF2/3/4/5 解析能力，包括编译单元（CU）遍历、调试信息条目（DIE）树遍历、属性读取、行号表、调用帧信息（CFI）、位置列表、宏信息、地址范围等全部核心 DWARF 数据结构的访问 API",
        "evidence": [
          "src/lib/libdwarf/libdwarf.h:1619",
          "src/lib/libdwarf/dwarf_die_deliv.c",
          "src/lib/libdwarf/dwarf_line.c",
          "src/lib/libdwarf/dwarf_frame.c",
          "src/lib/libdwarf/dwarf_macro5.c",
          "src/lib/libdwarf/dwarf_rnglists.c",
          "src/lib/libdwarf/dwarf_loclists.c"
        ]
      },
      {
        "name": "目标文件格式解析",
        "description": "内置 ELF、Mach-O、PE 三种主流目标文件格式的读取器，从文件中提取 .debug_* 节区，支持压缩节区（zlib/zstd）的透明解压",
        "evidence": [
          "src/lib/libdwarf/dwarf_elfread.c",
          "src/lib/libdwarf/dwarf_elf_load_headers.c",
          "src/lib/libdwarf/dwarf_machoread.c",
          "src/lib/libdwarf/dwarf_peread.c",
          "src/lib/libdwarf/dwarf_object_detector.c"
        ]
      },
      {
        "name": "DWARF 数据验证与错误恢复",
        "description": "内置强健的 DWARF 数据验证机制，检测并报告格式错误，防止损坏的 DWARF 导致库本身崩溃或内存泄漏",
        "evidence": [
          "src/lib/libdwarf/dwarf_error.c",
          "src/lib/libdwarf/dwarf_harmless.c",
          "src/lib/libdwarf/dwarf_secname_ck.c"
        ]
      },
      {
        "name": "DWARF 调试信息生成（libdwarfp）",
        "description": "提供生产者 API（libdwarfp），允许程序构造并写入符合 DWARF 标准的调试信息",
        "evidence": [
          "src/lib/libdwarfp/libdwarfp.h",
          "src/lib/libdwarfp/dwarf_pro_die.c",
          "src/lib/libdwarfp/dwarf_pro_finish.c"
        ]
      }
    ],
    "domain": "调试/开发工具",
    "target_users": "调试器开发者、编译器开发者、性能分析工具开发者、二进制分析工具开发者"
  },
