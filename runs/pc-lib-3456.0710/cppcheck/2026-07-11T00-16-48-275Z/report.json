  "function_summary": {
    "summary": "Cppcheck 是一款面向 C/C++ 代码的静态分析工具，可检测内存泄漏、空指针解引用、缓冲区溢出、未初始化变量等常见缺陷。它提供命令行界面（CLI）和可选的 Qt 图形界面（GUI），支持自定义规则（基于 PCRE 正则表达式）和 MISRA C 等编码规范检查，并可通过 addon 扩展机制（Python/JS）集成外部分析逻辑。",
    "categories": [
      {
        "name": "静态缺陷检测",
        "description": "检测 C/C++ 代码中的内存泄漏、空指针、缓冲区溢出、数组越界、未初始化变量、资源泄漏、整数溢出等常见缺陷。",
        "evidence": [
          "lib/checkbufferoverrun.cpp",
          "lib/checkmemoryleak.cpp",
          "lib/checknullpointer.cpp",
          "lib/checkleakautovar.cpp",
          "lib/checkuninitvar.cpp",
          "lib/checkio.cpp"
        ]
      },
      {
        "name": "数据流与值追踪分析",
        "description": "通过值流分析（value flow）追踪变量值在程序中的传播路径，支持更精确的缺陷检测和条件判断。",
        "evidence": [
          "lib/valueflow.cpp",
          "lib/vf_common.cpp",
          "lib/vf_analyzers.cpp",
          "lib/forwardanalyzer.cpp",
          "lib/reverseanalyzer.cpp"
        ]
      },
      {
        "name": "符号数据库与 AST 分析",
        "description": "构建完整的符号表和抽象语法树，支持类型检查、作用域分析、函数调用图等高级分析。",
        "evidence": [
          "lib/symboldatabase.cpp",
          "lib/tokenize.cpp",
          "lib/token.cpp",
          "lib/tokenlist.cpp",
          "lib/templatesimplifier.cpp"
        ]
      },
      {
        "name": "自定义规则与规范检查",
        "description": "支持通过 PCRE 正则表达式定义自定义检查规则，可检测代码风格、命名约定和模式匹配问题。",
        "evidence": [
          "lib/checkclass.cpp",
          "lib/checkfunctions.cpp",
          "lib/checkstl.cpp",
          "lib/checkstring.cpp"
        ]
      },
      {
        "name": "扩展与插件机制",
        "description": "支持通过 Python addon 脚本和插件扩展检查能力，可编写自定义分析逻辑和报告生成器。",
        "evidence": [
          "addons/*.py",
          "addons/README.md"
        ]
      },
      {
        "name": "报告生成与多格式输出",
        "description": "支持多种输出格式，包括 XML、SARIF、HTML 报告和命令行友好格式，便于集成到 CI/CD 流水线。",
        "evidence": [
          "cli/cppcheckexecutor.cpp",
          "lib/errorlogger.cpp",
          "lib/sarifreport.cpp",
          "htmlreport/"
        ]
      }
    ],
    "domain": "静态代码分析",
    "target_users": "C/C++ 软件开发者和 DevOps 工程师，用于代码质量保证和 CI/CD 集成",
    "ecosystem": "cpp"
  },
