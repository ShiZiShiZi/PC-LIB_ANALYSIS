  "function_summary": {
    "summary": "PropertyChanged.Fody 是一个 Fody 编织器（Weaver）插件，在 MSBuild 编译期间对 IL 代码进行注入——自动在所有实现了 INotifyPropertyChanged 接口的类的属性 setter 中生成 PropertyChanged 事件触发代码。开发者只需在属性上使用自动属性语法，编译后即自动获得完整的属性变更通知逻辑，无需手写每个属性的 setter。插件还支持通过 [AlsoNotifyFor]/[DependsOn] 属性声明属性间依赖关系、通过 [DoNotNotify]/[DoNotSetChanged] 等属性细粒度控制注入行为，并内置代码生成器（Source Generator）进一步简化 INotifyPropertyChanged 样板代码。",
    "categories": [
      {
        "name": "属性变更通知注入",
        "description": "编译期通过 IL 编织自动在属性 setter 中注入 INotifyPropertyChanged.PropertyChanged 事件触发代码，替代手写 OnPropertyChanged 调用",
        "evidence": [
          "PropertyChanged.Fody/ModuleWeaver.cs:5",
          "PropertyChanged.Fody/PropertyWeaver.cs:17"
        ]
      },
      {
        "name": "属性依赖关系声明",
        "description": "通过 [AlsoNotifyFor]（从源属性声明被通知属性）和 [DependsOn]（从目标属性声明依赖项）两个注解自动推导并生成级联通知代码",
        "evidence": [
          "PropertyChanged/AlsoNotifyForAttribute.cs",
          "PropertyChanged/DependsOnAttribute.cs",
          "PropertyChanged.Fody/MappingFinder.cs"
        ]
      },
      {
        "name": "细粒度注入控制",
        "description": "提供 [DoNotNotify]、[DoNotSetChanged]、[DoNotCheckEquality]、[FilterType] 等注解，允许排除特定类/属性、禁用 IsChanged 属性生成、按类型筛选编织范围（从全程序集 opt-out 切换为 opt-in）",
        "evidence": [
          "PropertyChanged/DoNotNotifyAttribute.cs",
          "PropertyChanged/DoNotSetChangedAttribute.cs",
          "PropertyChanged/DoNotCheckEqualityAttribute.cs",
          "PropertyChanged/FilterTypeAttribute.cs"
        ]
      },
      {
        "name": "代码生成器（Source Generator）",
        "description": "内置 C# Source Generator，为标记为 partial 的实现 INotifyPropertyChanged 的类自动生成 PropertyChanged 事件声明和事件触发方法等样板代码",
        "evidence": [
          "PropertyChanged.Fody.Analyzer/SourceGenerator.cs"
        ]
      },
      {
        "name": "变更回调方法注入",
        "description": "通过 [OnChangedMethod] 注解指定属性变更时调用的方法；支持 before/after 值传递的回调签名",
        "evidence": [
          "PropertyChanged/OnChangedMethodAttribute.cs",
          "PropertyChanged.Fody/OnChangedMethod.cs"
        ]
      }
    ],
    "domain": "开发工具 / 编译期代码生成",
    "target_users": "WPF / MAUI / Avalonia / Xamarin 等 .NET MVVM 应用开发者"
  },
