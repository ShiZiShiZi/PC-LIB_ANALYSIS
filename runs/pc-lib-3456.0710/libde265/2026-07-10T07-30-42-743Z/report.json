  "function_summary": {
    "summary": "libde265 是一个开源的 H.265/HEVC 视频解码器库，使用纯 C++ 实现并提供纯 C API 以便集成到其他软件中。支持 Main Profile 的所有特性，具备 WPP（波前并行处理）和瓦片级多线程解码能力，并包含 x86 SSE/AVX/AVX-512 与 ARM NEON SIMD 加速优化。附带两个示例程序（命令行播放器 dec265 和 Qt 图形化播放器 sherlock265）用于演示库的用法。",
    "categories": [
      {
        "name": "H.265/HEVC 视频解码核心",
        "description": "实现 H.265/HEVC 标准的完整解码流程，包括 NAL 单元解析、熵解码（CABAC）、帧内/帧间预测、反量化/反变换、去块滤波、SAO 滤波等所有 Main Profile 特性。",
        "evidence": [
          "libde265/decctx.cc",
          "libde265/cabac.cc",
          "libde265/nal-parser.cc",
          "libde265/vps.h",
          "libde265/sps.h",
          "libde265/pps.h",
          "libde265/slice.h",
          "libde265/deblock.cc",
          "libde265/sao.cc",
          "libde265/transform.cc",
          "libde265/intrapred.cc",
          "libde265/motion.cc"
        ]
      },
      {
        "name": "纯 C 公有 API",
        "description": "提供稳定的纯 C 外部接口（de265_new_decoder / de265_push_data / de265_decode / de265_get_next_picture 等），方便其他语言和框架绑定调用。",
        "evidence": [
          "libde265/de265.h",
          "libde265/de265.cc"
        ]
      },
      {
        "name": "多线程并行解码",
        "description": "支持 WPP（波前并行处理）和瓦片级多线程解码，可通过 de265_start_worker_threads 配置线程池大小，显著提升多核 CPU 解码性能。",
        "evidence": [
          "libde265/threads.cc",
          "libde265/threads.h",
          "libde265/decctx.cc"
        ]
      },
      {
        "name": "SIMD 加速优化",
        "description": "针对 x86 平台提供 SSE4.1/AVX2/AVX-512 加速（变换、去块滤波、帧内预测、运动补偿等），针对 ARM 平台提供 NEON 汇编加速（Qpel 运动补偿等），提升解码性能。",
        "evidence": [
          "libde265/x86/sse.cc",
          "libde265/x86/sse-dct.cc",
          "libde265/x86/sse-motion.cc",
          "libde265/x86/sse-intrapred.cc",
          "libde265/x86/sse-deblk.cc",
          "libde265/x86/transform-avx2.cc",
          "libde265/x86/transform-avx512.cc",
          "libde265/arm32/arm.cc",
          "libde265/arm32/hevcdsp_qpel_neon.S"
        ]
      }
    ],
    "domain": "视频编解码",
    "target_users": "需要解码 H.265/HEVC 视频的应用程序开发者与多媒体框架开发者"
  },
