  "native_api": {
    "summary": "SDL_mixer不直接调用任何OS原生API（Win32/POSIX/syscall），所有平台交互通过SDL3抽象层完成。内部使用标准C库函数进行内存操作，使用SSE/NEON SIMD intrinsics加速VBAP空间化音频运算（有纯C fallback）。动态链接方案通过SDL_LoadObject/SDL_LoadFunction在运行期加载编解码共享库，支持插件化后端切换。",
    "groups": [
      {
        "type": "sdl_runtime_api",
        "category": "standard",
        "platform": "portable",
        "apis": [
          {
            "name": "SDL_LoadObject/SDL_UnloadObject/SDL_LoadFunction",
            "purpose": "动态共享库加载与符号查找——按需加载libFLAC/libmpg123/libvorbis/libxmp/libfluidsynth等编解码后端",
            "count": 3
          },
          {
            "name": "SDL_CreateMutex/SDL_LockMutex/SDL_UnlockMutex/SDL_DestroyMutex",
            "purpose": "线程互斥锁——保护混音器全局状态，避免SDL音频回调线程与用户线程竞争",
            "count": 4
          },
          {
            "name": "SDL_RWLock",
            "purpose": "读写锁——Tag列表的并发访问保护",
            "count": 3
          },
          {
            "name": "SDL_IOStream系列（SDL_OpenIO/SDL_ReadIO/SDL_SeekIO/SDL_CloseIO）",
            "purpose": "IO流抽象——统一封装文件IO与内存IO，供解码器读取音频数据",
            "count": 5
          },
          {
            "name": "SDL_AudioStream系列（SDL_CreateAudioStream/SDL_PutAudioStreamData）",
            "purpose": "音频流管道——解码后PCM经音频流送入SDL音频设备播放",
            "count": 3
