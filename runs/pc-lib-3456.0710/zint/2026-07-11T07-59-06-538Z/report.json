  "function_summary": {
    "summary": "Zint 是一个开源的条码编码库与工具套件，核心为 C 语言编写的 libzint 库，支持对 90 多种条码标准进行数据编码并输出为多种图像格式。除库外还提供命令行工具 zint 和基于 Qt 的图形界面 Zint Barcode Studio。主要面向需要在自己的应用或工具中生成条码图像的开发者，也直接被终端用户作为命令行或桌面条码生成器使用。",
    "categories": [
      {
        "name": "条码编码引擎",
        "description": "核心的条码数据编码能力，支持一维条码（Code 128/Code 39/EAN/UPC/ITF-14 等）、二维条码（QR Code/Data Matrix/Aztec Code/PDF417/Micro QR/rMQR 等）、邮政码、GS1 复合码等 90 余种条码标准，内置 Reed-Solomon 纠错编码。",
        "evidence": [
          "backend/library.c:ZBarcode_Encode()",
          "backend/zint.h:154-260 (BARCODE_XXX 定义)",
          "backend/reedsol.c"
        ]
      },
      {
        "name": "多格式图像输出",
        "description": "将编码后的条码渲染为 BMP、GIF、PCX、PNG、SVG、EMF、EPS、TIF 等位图或矢量格式，支持颜色、边框、Human Readable Text 等输出选项。",
        "evidence": [
          "backend/output.c",
          "backend/bmp.c",
          "backend/svg.c",
          "backend/png.c",
          "backend/emf.c",
          "backend/gif.c",
          "backend/pcx.c",
          "backend/ps.c",
          "backend/tif.c"
        ]
      },
      {
        "name": "命令行工具",
        "description": "提供命令行条码生成器 zint，支持通过选项指定条码类型、输入数据、输出格式与文件等参数，适用于批处理与脚本集成。",
        "evidence": [
          "frontend/main.c",
          "frontend/CMakeLists.txt"
        ]
      },
      {
        "name": "Qt 图形界面与绑定",
        "description": "提供基于 Qt5/Qt6 的桌面 GUI（Zint Barcode Studio）可视化创建条码，以及 QZint 库（Qt/C++ 封装），方便 Qt 应用集成条码生成。还提供 Tcl 绑定。",
        "evidence": [
          "frontend_qt/mainwindow.cpp",
          "frontend_qt/CMakeLists.txt",
          "backend_qt/CMakeLists.txt",
          "backend_tcl/zint.c"
        ]
      }
    ],
    "domain": "条码编码与生成",
    "target_users": "需要在应用中生成条码的 C/C++/Qt 开发者，以及需要通过命令行或桌面 GUI 生成条码的终端用户"
  },
