  "function_summary": {
    "summary": "OpenOCD（Open On-Chip Debugger）是一个开源的嵌入式片上调试与编程工具，面向嵌入式开发者和硬件工程师。它通过 USB/JTAG/SWD 硬件适配器连接 ARM、RISC-V、MIPS、Xtensa 等架构的 MCU/SoC，提供 GDB 远程调试、Flash 烧写、边界扫描（(X)SVF）以及交互式 Tcl 脚本控制台。内置 telnet/GDB/Tcl 网络服务，可集成到 IDE 和自动化脚本中，用于固件开发、芯片 bring-up 和生产烧录。",
    "categories": [
      {
        "name": "JTAG/SWD 接口与适配器驱动",
        "description": "支持数十种 USB/JTAG/SWD 硬件适配器的底层协议驱动，包括 FTDI、ST-LINK、J-Link、CMSIS-DAP、OpenJTAG、USB-Blaster 等，通过 bitbang 或 MPSSE 引擎实现 GPIO 位级操控与协议栈",
        "evidence": [
          "src/jtag/drivers/（70+ 驱动文件）",
          "src/jtag/adapter.c",
          "src/jtag/core.c"
        ]
      },
      {
        "name": "目标处理器调试支持",
        "description": "支持 ARM（Cortex-A/R/M、ARM7/9/11）、RISC-V、MIPS、Xtensa、ARC、ESP32/ESP32-S2/ESP32-S3、DSP563xx、STM8 等架构的断点/观察点/单步/寄存器访问，通过 DAP/ADIv5 等调试访问端口协议",
        "evidence": [
          "src/target/arm_adi_v5.c",
          "src/target/cortex_m.c",
          "src/target/riscv/"
        ]
      },
      {
        "name": "Flash 存储器编程",
        "description": "内置 100+ 种 Flash 芯片的烧写算法，覆盖 NOR/NAND/SPI/QSPI Flash，支持 AT91SAM、STM32、Kinetis、nRF、PSoC、RP2040 等主流 MCU 的片上 Flash 编程",
        "evidence": [
          "src/flash/nor/drivers/（大量驱动）",
          "src/flash/nand/"
        ]
      },
      {
        "name": "GDB 远程调试服务",
        "description": "内置 GDB RSP 服务器（TCP 端口），使 GDB/IDA Pro 等客户端能以远程目标方式调试嵌入式系统，支持断点/内存/寄存器操作与 Thread Info",
        "evidence": [
          "src/server/gdb_server.c"
        ]
      },
      {
        "name": "交互式 Tcl 控制台与脚本",
        "description": "内嵌 Jim Tcl 解释器，提供 telnet（端口 4444）和 Tcl 命令端口，支持交互式调试命令、自动化脚本与自定义命令扩展",
        "evidence": [
          "src/server/telnet_server.c",
          "src/server/tcl_server.c",
          "jimtcl/"
        ]
      },
      {
        "name": "边界扫描与 SVF/XSVF 播放",
        "description": "支持 IEEE 1149.1 边界扫描测试，可播放 SVF/XSVF 文件实现 FPGA/CPLD 自动编程与板级测试",
        "evidence": [
          "src/svf/",
          "src/xsvf/"
        ]
      }
    ],
    "domain": "嵌入式开发调试工具",
    "target_users": "嵌入式固件开发者、硬件工程师、芯片 bring-up 工程师、生产测试工程师",
    "ecosystem": "cpp"
  },
