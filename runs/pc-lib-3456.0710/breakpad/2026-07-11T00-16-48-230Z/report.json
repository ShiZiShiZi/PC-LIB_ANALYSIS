  "function_summary": {
    "summary": "Google Breakpad 是一套跨平台的崩溃报告（crash-reporting）库与工具集。客户端（client）集成到应用程序中，在进程崩溃时生成 minidump 文件（紧凑的崩溃快照）；服务端工具（processor）离线解析 minidump 并输出可读的调用栈。面向 C/C++ 应用的开发者，用于生产环境崩溃监控与事后调试。",
    "categories": [
      {
        "name": "崩溃捕获与 minidump 生成",
        "description": "在进程崩溃时（SIGSEGV/SIGABRT 等）捕获信号，通过 ptrace（Linux）/ Mach API（macOS）/ SEH（Windows）读取崩溃线程的寄存器、内存映射与栈，生成紧凑的 minidump 快照文件。",
        "evidence": [
          "src/client/linux/handler/exception_handler.cc",
          "src/client/mac/handler/exception_handler.cc",
          "src/client/windows/handler/exception_handler.cc",
          "src/client/linux/minidump_writer/minidump_writer.cc"
        ]
      },
      {
        "name": "minidump 解析与调用栈还原",
        "description": "服务端工具（processor）解析 minidump 文件，结合符号文件还原函数调用栈。包含 minidump 流读取、CPU 上下文解释、CFI（Call Frame Information）栈帧展开等。",
        "evidence": [
          "src/processor/minidump.cc",
          "src/processor/stackwalk_common.cc",
          "src/processor/minidump_stackwalk.cc",
          "src/processor/cfi_frame_info.cc",
          "src/google_breakpad/processor/minidump.h"
        ]
      },
      {
        "name": "符号文件生成与管理",
        "description": "从 ELF/Mach-O/PE 二进制提取调试符号，生成 Breakpad 自有格式的 .sym 符号文件，供 processor 调用栈还原使用。",
        "evidence": [
          "src/common/dwarf/dwarf2reader.cc",
          "src/common/linux/dump_symbols.cc",
          "src/common/mac/dump_syms.mm",
          "src/tools/linux/dump_syms/",
          "src/tools/windows/converter/"
        ]
      },
      {
        "name": "崩溃报告上传",
        "description": "将生成的 minidump 文件通过 HTTP 上传到崩溃收集服务器（如 Socorro），支持多平台（libcurl/Linux、WinHTTP/Windows、NSURLConnection/macOS）。",
        "evidence": [
          "src/common/linux/http_upload.cc",
          "src/common/linux/libcurl_wrapper.cc",
          "src/common/windows/http_upload.cc",
          "src/tools/windows/symupload/symupload.cc"
        ]
      },
      {
        "name": "microdump 格式支持",
        "description": "除 minidump 外还支持更轻量的 microdump 格式——以文本形式记录崩溃线程栈和寄存器，适合 Android 等存储受限环境。",
        "evidence": [
          "src/client/linux/microdump_writer/microdump_writer.cc",
          "src/processor/microdump.cc",
          "src/processor/microdump_processor.cc"
        ]
      },
      {
        "name": "多平台适配",
        "description": "同一套崩溃捕获 API 在 Linux/Android/macOS/Windows/Solaris 上均有实现，底层分别适配不同操作系统的进程/线程/异常机制。",
        "evidence": [
          "src/client/linux/minidump_writer/linux_ptrace_dumper.cc",
          "src/client/mac/handler/minidump_generator.cc",
          "src/client/windows/crash_generation/minidump_generator.cc"
        ]
      }
    ],
    "domain": "崩溃报告与事后调试",
    "target_users": "C/C++ 应用开发者与运维人员",
    "ecosystem": "cpp"
  },
