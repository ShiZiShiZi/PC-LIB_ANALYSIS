  "function_summary": {
    "summary": "LZMA SDK 是一套压缩/解压缩软件开发工具包，提供 7z、LZMA、LZMA2、XZ 四种格式的压缩与解压缩实现（C/C++ 核心，另附 C# 与 Java 绑定）。面向需要在自己的应用中集成数据压缩功能的开发者，可用于文件归档、软件安装包、固件压缩等场景。",
    "categories": [
      {
        "name": "LZMA 压缩/解压缩",
        "description": "提供 LZMA 算法的编码与解码，支持可变字典大小（最高 1 GB），具有高压缩比和快速解压缩的特点。",
        "evidence": [
          "C/LzmaDec.c",
          "C/LzmaEnc.c",
          "C/Lzma86Enc.c",
          "C/Lzma86Dec.c"
        ]
      },
      {
        "name": "LZMA2 压缩/解压缩",
        "description": "基于 LZMA 改进的 LZMA2 算法，支持更好的多线程压缩和多块流式处理。",
        "evidence": [
          "C/Lzma2Dec.c",
          "C/Lzma2Enc.c",
          "C/Lzma2DecMt.c"
        ]
      },
      {
        "name": "7z 格式支持",
        "description": "实现 .7z 文件格式的解码，支持 LZMA/LZMA2/PPMd 算法及 AES-256 加密，可以解析 7z 归档中的文件元数据。",
        "evidence": [
          "C/7zDec.c",
          "C/7zArcIn.c",
          "C/7zCrc.c",
          "CPP/7zip/Archive/7z/"
        ]
      },
      {
        "name": "XZ 格式支持",
        "description": "实现 XZ 格式（基于 LZMA2）的压缩与解压缩，支持 SHA/CRC 校验、过滤器链和流分割。",
        "evidence": [
          "C/Xz.c",
          "C/XzDec.c",
          "C/XzEnc.c",
          "C/XzCrc64.c"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "C/C++ 核心之外提供了 C# 和 Java 的封装层，支持在 .NET 和 JVM 平台上使用 LZMA 压缩功能。",
        "evidence": [
          "CS/7zip/Compress/LZMA/",
          "Java/SevenZip/Compression/LZMA/"
        ]
      },
      {
        "name": "CPU 优化（SIMD / 汇编）",
        "description": "针对 x86（SSE/AES-NI）和 ARM 平台提供汇编级优化的 CRC 校验和 AES 加密加速实现。",
        "evidence": [
          "Asm/x86/",
          "Asm/arm/",
          "C/AesOpt.c",
          "C/CpuArch.c"
        ]
      }
    ],
    "domain": "数据压缩",
    "target_users": "需要在自己的应用中集成压缩/解压缩功能的 C/C++/C#/Java 开发者",
    "ecosystem": "cpp"
  },
