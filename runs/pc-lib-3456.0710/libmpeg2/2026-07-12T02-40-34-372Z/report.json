  "function_summary": {
    "summary": "libmpeg2 是一个免费的 C 语言 MPEG-1 和 MPEG-2 视频解码库，以 GPL 协议发布。它追求高解码速度（在典型 DVD 码流上可达 110+ fps）与 MPEG 标准一致性，是众多视频播放器（如 xine、MPlayer、VideoLAN）和 GStreamer 插件等下游项目的核心解码组件。",
    "categories": [
      {
        "name": "MPEG-1/2 视频解码核心",
        "description": "解析并解码符合 MPEG-1 和 MPEG-2 标准的视频流（含 IDCT 反变换、运动补偿、VLD 解码），支持 constrained parameters 与 main profile 标准。",
        "evidence": [
          "libmpeg2/decode.c",
          "libmpeg2/header.c",
          "libmpeg2/slice.c",
          "libmpeg2/idct.c",
          "libmpeg2/motion_comp.c",
          "libmpeg2/vlc.h"
        ]
      },
      {
        "name": "多平台 SIMD 加速",
        "description": "为 x86（MMX/3DNow/MMXEXT/SSE2/SSE3）、PowerPC（Altivec）、SPARC（VIS/VIS2）和 ARM 等架构提供手写汇编或 intrinsics 优化加速以提升解码吞吐量。",
        "evidence": [
          "libmpeg2/idct_mmx.c",
          "libmpeg2/motion_comp_mmx.c",
          "libmpeg2/idct_altivec.c",
          "libmpeg2/motion_comp_altivec.c",
          "libmpeg2/motion_comp_vis.c",
          "libmpeg2/motion_comp_arm.c",
          "include/mmx.h",
          "include/alpha_asm.h"
        ]
      },
      {
        "name": "视频输出示例（libvo）",
        "description": "mpeg2dec 示例程序内置的简单视频输出后端，支持 X11（XShm/Xv）、DirectX、SDL 等输出方式，供测试和演示参考。",
        "evidence": [
          "libvo/video_out.c",
          "libvo/video_out_x11.c",
          "libvo/video_out_dx.c",
          "libvo/video_out_sdl.c",
          "libvo/video_out_null.c"
        ]
      },
      {
        "name": "色彩空间转换",
        "description": "提供 YUV→RGB 等多种色彩空间转换例程，方便后端渲染管线对接。",
        "evidence": [
          "libmpeg2/convert/",
          "include/mpeg2convert.h"
        ]
      }
    ],
