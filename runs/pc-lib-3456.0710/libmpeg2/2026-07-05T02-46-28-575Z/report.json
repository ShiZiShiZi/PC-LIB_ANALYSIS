  "function_summary": {
    "summary": "libmpeg2 是一个用 C 语言编写的开源 MPEG-2 与 MPEG-1 视频流解码库，以 GPL-2.0 协议发布。核心面向视频播放器（xine、MPlayer、VLC）、流媒体框架（GStreamer）与转码工具等上层应用，提供轻量高效的解码能力。该库在 x86（MMX/MMXEXT/3DNow!/SSE2/SSE3）、PowerPC（AltiVec）、SPARC（VIS/VIS2）、Alpha（MVI）和 ARM 架构上均有汇编/SIMD 优化路径，运行时自动检测 CPU 能力选择最优实现，同时保留纯 C 回退以保证可移植性。",
    "categories": [
      {
        "name": "MPEG 视频解码",
        "description": "实现对 MPEG-1 与 MPEG-2 视频流的完整解析与解码，覆盖 MPEG-1 受限参数（constrained parameters）与 MPEG-2 主配置（main profile），支持 I/P/B/D 帧、程序流/传输流/PVA 流解复用，典型 DVD 视频流在 PIII/666 上可超 100fps。",
        "evidence": [
          "include/mpeg2.h",
          "libmpeg2/decode.c",
          "libmpeg2/header.c",
          "libmpeg2/slice.c",
          "libmpeg2/vlc.h"
        ]
      },
      {
        "name": "色彩空间转换",
        "description": "提供 YUV 到 RGB 的色彩空间转换，支持 RGB32/24/16/15/8 及对应 BGR 位深变体，以及 UYVY 格式转换，适配不同显示后端需求。",
        "evidence": [
          "include/mpeg2convert.h",
          "libmpeg2/convert/"
        ]
      },
      {
        "name": "多架构 SIMD 加速",
        "description": "运动补偿（motion compensation）和逆离散余弦变换（IDCT）在 x86（MMX/MMXEXT/3DNow!/SSE2/SSE3）、PowerPC（AltiVec）、SPARC（VIS/VIS2）、Alpha（MVI）、ARM 上均有汇编/SIMD 优化实现，运行时通过 CPUID 或信号探测自动检测并选择最佳路径；纯 C 回退保证可移植性。",
        "evidence": [
          "libmpeg2/cpu_accel.c",
          "libmpeg2/motion_comp_mmx.c",
          "libmpeg2/motion_comp_altivec.c",
          "libmpeg2/motion_comp_vis.c",
          "libmpeg2/motion_comp_alpha.c",
          "libmpeg2/motion_comp_arm.c",
          "libmpeg2/motion_comp_arm_s.S",
          "libmpeg2/idct_mmx.c",
          "libmpeg2/idct_altivec.c",
          "libmpeg2/idct_alpha.c",
          "libmpeg2/motion_comp.c"
        ]
      },
      {
        "name": "可插拔视频输出",
        "description": "通过 vo_driver 抽象机制支持多种视频显示后端：X11（含 XShm 共享内存扩展与 Xv 视频加速）、DirectX/DirectDraw（含 Overlay）、SDL、PGM 文件输出，以及 null/md5 等测试与性能验证后端。各后端编译期可选，运行时由用户命令行选择。",
        "evidence": [
          "include/video_out.h",
          "libvo/video_out.c",
          "libvo/video_out_x11.c",
          "libvo/video_out_dx.c",
          "libvo/video_out_sdl.c",
          "libvo/video_out_pgm.c",
          "libvo/video_out_null.c"
        ]
      }
    ],
    "domain": "视频编解码",
    "target_users": "视频播放器、流媒体框架与转码工具开发者"
  },
