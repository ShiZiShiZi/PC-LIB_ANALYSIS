  "function_summary": {
    "summary": "@stdlib/complex-float32 是 stdlib 标准库中单精度复数功能的总入口命名空间。它将复数构造器（Complex64）、实部/虚部访问器（real/imag/reim）、共轭运算（conj）、字符串解析（parseComplex64）与 JSON 反序列化（reviveComplex64）共 7 个子包聚合为一个统一的导入点，方便数值计算项目使用。该库纯 JavaScript/TypeScript 实现，无原生依赖，面向需要在 Node.js 或浏览器中进行复数运算的 JavaScript 开发者。",
    "categories": [
      {
        "name": "复数构造与表示",
        "description": "提供单精度复数类型的构造函数 Complex64，用两个 32 位浮点数分别表示实部和虚部。",
        "evidence": [
          "lib/index.js:64"
        ]
      },
      {
        "name": "实部与虚部访问",
        "description": "提供 real、imag 函数提取复数的实部和虚部，reim 函数同时返回两者。",
        "evidence": [
          "lib/index.js:73",
          "lib/index.js:91",
          "lib/index.js:100"
        ]
      },
      {
        "name": "复数运算",
        "description": "提供 conj 函数计算复数的共轭，以及底层 base 子命名空间提供加减乘除等算术运算。",
        "evidence": [
          "lib/index.js:46",
          "lib/index.js:55"
        ]
      },
      {
        "name": "序列化与反序列化",
        "description": "提供 parseComplex64 从字符串解析复数，reviveComplex64 从 JSON 恢复 Complex64 实例。",
        "evidence": [
          "lib/index.js:82",
          "lib/index.js:109"
        ]
      }
    ],
    "domain": "数值计算 / 复数数学",
    "target_users": "JavaScript/TypeScript 数值计算开发者"
  },
