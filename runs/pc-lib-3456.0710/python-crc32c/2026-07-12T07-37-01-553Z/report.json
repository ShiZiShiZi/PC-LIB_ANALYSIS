  "function_summary": {
    "summary": "google-crc32c 是一个 Python 包，封装了 Google 的 crc32c 硬件加速 CRC32C 校验和算法。它提供 C 扩展实现（调用 Intel SSE4.2 CRC32 指令或其他硬件加速）和纯 Python 回退实现，通过 hashlib 风格 API（Checksum 类、extend/value 函数）对外提供 CRC32C 计算能力。主要面向需要高性能 CRC32C 校验的 Python 应用开发者，典型场景包括 Google Cloud Storage 对象完整性校验。项目已归档，代码已合并至 google-cloud-python 仓库。",
    "categories": [
      {
        "name": "CRC32C 哈希计算",
        "description": "提供 CRC32C 校验和的核心计算功能，支持单次计算（value）和增量更新（extend），遵循 RFC 3720 / RFC 4960 标准",
        "evidence": [
          "src/google_crc32c/__init__.py",
          "src/google_crc32c/_crc32c.c"
        ]
      },
      {
        "name": "hashlib 风格接口",
        "description": "提供 Checksum 类，兼容 Python hashlib 风格的 update/digest/hexdigest/copy 方法，以及流式 consume 能力",
        "evidence": [
          "src/google_crc32c/_checksum.py",
          "src/google_crc32c/cext.py",
          "src/google_crc32c/python.py"
        ]
      },
      {
        "name": "双模实现（C 扩展 + 纯 Python 回退）",
        "description": "优先加载 C 扩展以获得硬件加速性能；在 C 扩展不可用时自动回退到纯 Python 查表实现，确保跨平台可用性",
        "evidence": [
          "src/google_crc32c/__init__.py:24-30",
          "src/google_crc32c/python.py"
        ]
      }
    ],
    "domain": "数据完整性/校验",
    "target_users": "需要高性能 CRC32C 校验的 Python 应用开发者（尤其是 Google Cloud Storage 用户）",
    "ecosystem": "python"
  },
