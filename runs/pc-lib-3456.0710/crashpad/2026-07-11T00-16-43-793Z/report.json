  "function_summary": {
    "summary": "Crashpad 是一个进程崩溃信息捕获、存储与上报系统，由 Google 开发并用于 Chromium 等产品。它在目标进程崩溃时通过独立进程（handler）采集该进程的 CPU 状态、内存快照、操作系统信息等，生成 Minidump 格式文件并上传至后端收集服务器，为开发者提供高质量的事后诊断数据。同时支持用户主动触发 dump（非崩溃场景）和基于注解（annotation）的自定义元数据附加。",
    "categories": [
      {
        "name": "崩溃捕获与进程快照",
        "description": "在崩溃发生时暂停目标进程，收集 CPU 寄存器、线程栈、已加载模块列表和关键内存区域，构造一份完整的进程态快照。",
        "evidence": [
          "snapshot/snapshot.h",
          "snapshot/cpu_context.h",
          "snapshot/exception_snapshot.h",
          "snapshot/memory_snapshot.h",
          "snapshot/process_snapshot.h"
        ]
      },
      {
        "name": "Minidump 文件生成",
        "description": "将进程快照序列化为 Windows Minidump 格式（含 Crashpad 扩展），写入磁盘文件。",
        "evidence": [
          "minidump/minidump_file_writer.cc",
          "minidump/minidump_context_writer.cc",
          "minidump/minidump_exception_writer.cc",
          "minidump/minidump_memory_writer.cc"
        ]
      },
      {
        "name": "崩溃报告上传",
        "description": "通过 HTTP(S) 将 Minidump 文件和注解元数据以 Breakpad 兼容的 MIME multipart 格式上传到收集服务器，支持 gzip 压缩与重试节流。",
        "evidence": [
          "handler/crash_report_upload_thread.cc",
          "util/net/http_transport.cc",
          "util/net/http_multipart_builder.cc"
        ]
      },
      {
        "name": "客户端注册与 IPC",
        "description": "客户端进程通过平台特定的 IPC 机制（macOS Mach port、Windows Named Pipe、Linux Unix socket）向 handler 注册，在崩溃时由 handler 接管快照。",
        "evidence": [
          "client/crashpad_client.h",
          "client/crashpad_client_mac.cc",
          "client/crashpad_client_win.cc",
          "client/crashpad_client_linux.cc"
        ]
      },
      {
        "name": "注解与元数据系统",
        "description": "允许应用在可执行模块中嵌入 CrashpadInfo 结构，携带键值对注解、用户自定义 Minidump 流等元数据，在崩溃时被自动采集。",
        "evidence": [
          "client/crashpad_info.h",
          "client/annotation.h",
          "client/annotation_list.h",
          "client/simple_string_dictionary.h"
        ]
      },
      {
        "name": "跨平台适配层",
        "description": "封装 Windows (Win32)、macOS (Mach/Cocoa)、Linux/Android (POSIX)、Fuchsia 等操作系统的进程控制、文件、网络、线程等底层差异，提供统一的上层接口。",
        "evidence": [
          "util/misc/capture_context.h",
          "util/file/",
          "snapshot/mac/",
          "snapshot/win/",
          "snapshot/linux/",
          "snapshot/fuchsia/"
        ]
      }
    ],
    "domain": "崩溃诊断与遥测（crash telemetry / crash reporting）",
    "target_users": "桌面和移动 C++/原生应用开发者与分发者，尤其是浏览器、大型客户端应用开发团队",
    "ecosystem": "cpp"
  },
