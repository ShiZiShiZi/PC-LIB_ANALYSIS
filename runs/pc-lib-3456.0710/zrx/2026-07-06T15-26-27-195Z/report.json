  "function_summary": {
    "summary": "ZRX（Zen Reactive Extensions）是一个用 Rust 编写的响应式扩展库，为 Zensical 静态站点生成器提供核心基础设施。它以有向无环图（DAG）驱动的调度器为核心，支持流式数据变换（Stream）、模块化插件系统（Module）、工作窃取/共享并行执行器（Executor），以及类型安全的键值存储抽象（Store/Storage）。用户通过组合 Stream 算子（join/map/barrier 等）构建工作流，由调度器自动编排执行；模块可在运行时动态挂载/卸载，并通过类型化订阅实现跨模块协作。",
    "categories": [
      {
        "name": "响应式流处理",
        "description": "提供 Stream 抽象与丰富的算子（join、map、barrier 等），支持基于 DAG 的数据流图构建与变换，类似 Rx 系列的响应式编程模型",
        "evidence": [
          "crates/zrx-stream/src/stream/mod.rs",
          "crates/zrx-stream/src/stream/workflow.rs",
          "crates/zrx-stream/src/stream/barrier.rs"
        ]
      },
      {
        "name": "任务调度与编排",
        "description": "Scheduler 以 DAG 拓扑驱动的 tick 模型编排工作流节点，管理路由、定时器、任务队列与前沿传播，支持 attach/detach 动态调度",
        "evidence": [
          "crates/zrx-scheduler/src/scheduler.rs",
          "crates/zrx-scheduler/src/scheduler/schedule.rs"
        ]
      },
      {
        "name": "并行执行引擎",
        "description": "Executor 提供 WorkSharing（工作共享）与 WorkStealing（工作窃取）两种并行策略，基于 crossbeam 通道与线程池实现任务分发与调度",
        "evidence": [
          "crates/zrx-executor/src/executor.rs",
          "crates/zrx-executor/src/executor/strategy/worker/sharing.rs",
          "crates/zrx-executor/src/executor/strategy/worker/stealing.rs"
        ]
      },
      {
        "name": "模块化插件系统",
        "description": "Module trait 定义统一的 setup 入口，模块通过 Context 与系统交互，支持类型化订阅实现跨模块通信，可在运行时动态添加和移除",
        "evidence": [
          "crates/zrx-module/src/module.rs",
          "crates/zrx-module/src/module/context.rs"
        ]
      },
      {
        "name": "键值存储抽象",
        "description": "提供 Store/StoreMut/StoreIterable 等特质抽象，以及 Storage 的类型擦除容器和 Storages 集合，支持可插拔的底层集合实现",
        "evidence": [
          "crates/zrx-store/src/store.rs",
          "crates/zrx-storage/src/storage.rs",
          "crates/zrx-storage/src/storage/set.rs"
        ]
      },
      {
        "name": "图数据结构",
        "description": "Graph 提供带权有向图的构建（Builder 模式）与遍历（BFS/拓扑/路径枚举），支持 Direct 与 Transitive 两种拓扑视图，供调度器构建执行计划",
        "evidence": [
          "crates/zrx-graph/src/graph.rs",
          "crates/zrx-graph/src/graph/iter/paths.rs"
        ]
      },
      {
        "name": "标识符与选择器体系",
        "description": "Id/Selector/Key 构成层级化的资源标识体系（zri:/zrs: 前缀），支持 glob 模式匹配、特异性排序与跨模块路由",
        "evidence": [
          "crates/zrx-id/src/id/selector.rs",
          "crates/zrx-id/src/id/selector/convert.rs"
        ]
      },
      {
        "name": "诊断与日志",
        "description": "Diagnostic 提供结构化的错误/警告/信息消息，支持位置、代码、标签等元数据，并提供 error!/warning! 等便捷宏",
        "evidence": [
          "crates/zrx-diagnostic/src/diagnostic.rs"
        ]
      },
      {
        "name": "路径工具",
        "description": "路径解析与转换工具，为标识符体系与文件系统操作提供基础",
        "evidence": [
          "crates/zrx-path/src/lib.rs"
        ]
      }
    ],
    "domain": "reactive_programming",
    "target_users": "Rust 开发者，特别是需要构建数据流驱动、模块化可扩展应用（如静态站点生成器、数据处理管线、实时事件系统）的开发者"
  },
