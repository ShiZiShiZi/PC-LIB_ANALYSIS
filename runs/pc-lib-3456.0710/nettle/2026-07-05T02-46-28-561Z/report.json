  "function_summary": {
    "summary": "Nettle 是一个底层密码学库，专注于提供密码学原语的简洁通用接口，不负责算法选择、内存分配和 I/O。它被设计为可在多种场景下使用——从面向对象语言的密码学工具包（C++、Python 等），到 LSH、GnuPG 等应用，甚至可嵌入内核空间。Nettle 的低层设计理念是「只做一件事并做好」，上层应用可按需在其上构建面向特定场景的接口。",
    "categories": [
      {
        "name": "对称加密（块密码与流密码）",
        "description": "提供 AES（128/192/256）、Camellia、Serpent、Twofish、Blowfish（含 bcrypt 密码哈希）、ARCTWO、DES/3DES、CAST128、SM4（国密）、ChaCha、Salsa20 等块密码与流密码算法，支持 ECB/CBC/CTR/CFB/XTS/OCB/SIV 等工作模式。",
        "evidence": [
          "aes.h",
          "camellia.h",
          "serpent.h",
          "twofish.h",
          "blowfish.h",
          "des.h",
          "chacha.h",
          "salsa20.h",
          "cbc.h",
          "ctr.h",
          "cfb.h",
          "xts.h",
          "ocb.h",
          "sm4.h",
          "cast128.h",
          "arctwo.h"
        ]
      },
      {
        "name": "哈希摘要",
        "description": "实现 SHA-1、SHA-2（224/256/384/512/512-224/512-256）、SHA-3（224/256/384/512、SHAKE128/256）、MD2/4/5、RIPEMD160、GOSTHASH94、Streebog（256/512）、SM3（国密）等多种哈希算法。",
        "evidence": [
          "sha1.h",
          "sha2.h",
          "sha3.h",
          "md2.h",
          "md4.h",
          "md5.h",
          "ripemd160.h",
          "gosthash94.h",
          "streebog.h",
          "sm3.h",
          "nettle-meta-hashes.c"
        ]
      },
      {
        "name": "消息认证码（MAC）",
        "description": "提供 HMAC（基于 MD5/SHA-1/SHA-2/SM3/Streebog/GOSTHASH94/RIPEMD160）、CMAC（基于 AES128/256、DES3）、UMAC（32/64/96/128 位）、Poly1305-AES 等消息认证码。",
        "evidence": [
          "hmac.h",
          "cmac.h",
          "umac.h",
          "poly1305.h",
          "nettle-meta-macs.c",
          "hmac-internal.c"
        ]
      },
      {
        "name": "认证加密（AEAD）",
        "description": "实现 GCM（AES/Camellia/SM4）、CCM（AES）、EAX（AES）、ChaCha-Poly1305、SIV-CMAC（AES）、SIV-GCM（AES）等认证加密模式，提供消息保密性与完整性的一体化保障。",
        "evidence": [
          "gcm.h",
          "ccm.h",
          "eax.h",
          "chacha-poly1305.h",
          "siv-cmac.h",
          "siv-gcm.h",
          "nettle-meta-aeads.c"
        ]
      },
      {
        "name": "公钥密码",
        "description": "提供 RSA（含 OAEP/PSS/PKCS1 填充、签名/验证/加解密）、DSA、ECDSA（secp192r1/224r1/256r1/384r1/521r1 等 NIST 曲线）、EdDSA（Ed25519、Ed448）、Curve25519/448 密钥协商、GOST DSA 签名等公钥密码算法，依赖 GMP 大数库。",
        "evidence": [
          "rsa.h",
          "dsa.h",
          "ecdsa.h",
          "eddsa.h",
          "ecc.h",
          "curve25519.h",
          "curve448.h",
          "ecc-curve.h",
          "gostdsa.h",
          "hogweed-internal.h"
        ]
      },
      {
        "name": "后量子密码",
        "description": "提供 ML-KEM（FIPS 203 密钥封装、768/1024 安全级别）、SLH-DSA（FIPS 205 无状态哈希签名、128f/128s 安全级别）、sntrup761（NTRU Prime 密钥封装）等抗量子攻击密码算法。",
        "evidence": [
          "ml-kem.h",
          "slh-dsa.h",
          "sntrup.h"
        ]
      },
      {
        "name": "密钥派生与随机数生成",
        "description": "提供 PBKDF2（基于 HMAC-SHA1/256/384/512、HMAC-GOSTHASH94）、HKDF 密钥派生，以及 Yarrow-256 熵累积、Knuth LFIB 伪随机数生成、Balloon 内存困难哈希等。",
        "evidence": [
          "pbkdf2.h",
          "hkdf.h",
          "yarrow.h",
          "knuth-lfib.h",
          "balloon.h"
        ]
      },
      {
        "name": "数据编码与序列化",
        "description": "提供 Base16（十六进制）、Base64、Base64URL 编解码，以及 S-expression（Lisp 风格）的格式化与解析，用于密钥和签名的结构化序列化。",
        "evidence": [
          "base16.h",
          "base64.h",
          "sexp.h",
          "buffer.h"
        ]
      }
    ],
    "domain": "密码学",
    "target_users": "安全应用开发者、协议实现者、其他密码学库的底层基础（如 GnuPG、LSH、Pike 等）"
  },
