  "function_summary": {
    "summary": "@napi-rs/canvas 是面向 Node.js 的高性能 Canvas 2D 实现，底层采用 Google Skia 图形引擎（通过 skia-c 的 C 绑定与 Rust/napi-rs 封装）。它提供与浏览器 Canvas API 一致的 2D 绘图接口，支持路径绘制、文本渲染、图像编解码（JPEG/PNG/WebP/AVIF/GIF）、SVG/PDF 输出、渐变与图案填充、Lottie 动画播放，以及色彩空间管理（sRGB / Display P3）。所有能力均以原生插件形式集成，零系统依赖（Skia 静态链接），适用于需要服务端高性能图形合成、图像处理或 PDF/SVG 生成的 Node.js 应用。",
    "categories": [
      {
        "name": "Canvas 2D 绘图",
        "description": "实现 W3C Canvas 2D API，含路径绘制、描边与填充样式、复合操作（globalCompositeOperation）、阴影、变换矩阵、裁剪区域、文本渲染（font/lineWidth/textAlign 等），以及 deferred rendering（按需合成页面后统一绘制到位图）。",
        "evidence": [
          "src/ctx.rs",
          "src/path.rs",
          "src/state.rs",
          "src/pattern.rs",
          "src/gradient.rs",
          "src/filter.rs"
        ]
      },
      {
        "name": "图像编解码",
        "description": "支持 JPEG/PNG/WebP/AVIF/GIF 多格式的图像加载与导出，含像素级 ImageData 操作，以及从文件路径或 URL 远程加载图像。",
        "evidence": [
          "src/image.rs",
          "src/avif.rs",
          "src/gif.rs",
          "load-image.js"
        ]
      },
      {
        "name": "矢量输出：SVG / PDF",
        "description": "支持将 Canvas 绘图输出为 SVG 矢量图形（含 SVG 文本转路径功能），以及通过 PDFCanvas 渲染并导出 PDF 文档。",
        "evidence": [
          "src/svg.rs",
          "src/lib.rs:713-867",
          "npm/pdf.js"
        ]
      },
      {
        "name": "Lottie 动画播放",
        "description": "集成 Skia 的 Skottie 模块，支持加载和渲染 Lottie JSON 动画文件，并以帧序列导出为图像。",
        "evidence": [
          "src/lottie.rs"
        ]
      },
      {
        "name": "字体与排版",
        "description": "支持系统字体加载、按路径注册自定义字体、CSS font 属性解析，以及可变字体（variable font）的轴参数控制。",
        "evidence": [
          "src/font.rs",
          "src/global_fonts.rs"
        ]
      },
      {
        "name": "GIF 动画编解码",
        "description": "支持 GIF 动画的帧级编码与解码，可创建多帧 GIF 输出。",
        "evidence": [
          "src/gif.rs"
        ]
      }
    ],
    "domain": "图形与图像处理",
    "target_users": "Node.js 后端开发者（服务端图像合成、图表生成、PDF/SVG 导出、动画渲染场景）",
