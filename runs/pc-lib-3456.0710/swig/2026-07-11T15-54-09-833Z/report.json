  "function_summary": {
    "summary": "SWIG (Simplified Wrapper and Interface Generator) 是一个编译工具，读取带有注解的 C/C++ 头文件和接口文件(.i)，自动生成将 C/C++ 库暴露给多种高级语言的粘合包装代码。支持的目标语言包括 Python、Java、C#、Go、Ruby、Perl、PHP、JavaScript、Lua、Tcl、R、Guile、D、Octave、Scilab、OCaml 等 20 多种语言，还可将解析树导出为 XML。开发者只需写一次接口文件(.i)，即可自动生成多语言绑定，大幅降低跨语言绑定的维护成本。",
    "categories": [
      {
        "name": "C/C++ 解析与类型系统",
        "description": "完整的 C/C++ 预处理器、词法分析器和 Bison 语法解析器，支持 C99/C11/C++98 到 C++20 标准，含完整类型系统和模板展开引擎",
        "evidence": [
          "Source/CParse/parser.y",
          "Source/Preprocessor/",
          "Source/Swig/typesys.c",
          "Source/CParse/templ.c"
        ]
      },
      {
        "name": "多语言代码生成后端",
        "description": "为 Python、Java、C#、Go、Ruby、Perl、PHP、JavaScript、Lua、R、D、Guile、Octave、Scilab、Tcl、OCaml、XML 等语言生成包装胶水代码；支持 typemap 系统精细控制转换",
        "evidence": [
          "Source/Modules/python.cxx",
          "Source/Modules/java.cxx",
          "Source/Modules/csharp.cxx",
          "Source/Modules/go.cxx",
          "Source/Modules/ruby.cxx",
          "Source/Modules/javascript.cxx"
        ]
      },
      {
        "name": "Typemap 与转换系统",
        "description": "灵活的 typemap 机制，支持按类型/函数级别的自定义 C↔目标语言转换规则，内建标准库 typemap 和用户自定义扩展，支持 director 跨语言多态与跨语言异常传递",
        "evidence": [
          "Lib/*.i",
          "Lib/*.swg",
          "Source/Swig/typemap.c",
          "Source/Swig/wrapfunc.c"
        ]
      },
      {
        "name": "多平台构建集成",
        "description": "支持 GNU Autotools 和 CMake 构建系统，生成 .c/.cxx 包装文件后可集成到各类构建体系，提供 ccache-swig 编译缓存变体加速重复生成",
        "evidence": [
          "CMakeLists.txt",
          "configure.ac",
          "CCache/"
        ]
      },
      {
        "name": "运行时支持库",
        "description": "为各目标语言提供运行时支持库（Lib 目录下的 .i/.swg 文件），在生成的包装代码中引用，处理内存管理、类型转换、异常转译等运行时功能",
        "evidence": [
          "Lib/python/",
          "Lib/java/",
          "Lib/ruby/",
          "Lib/perl5/"
        ]
      }
    ],
    "domain": "跨语言绑定/FFI 编译工具",
    "target_users": "需要将 C/C++ 库暴露给 Python/Java/C#/Go/JS 等高级语言的库开发者和系统集成者",
    "ecosystem": "cpp"
  },
