  "function_summary": {
    "summary": "dav1d 是一个由 VideoLAN 开发的开源、跨平台 AV1 视频解码器库，完全由 C 语言编写并结合多重架构汇编优化（x86 SSE/SSSE3/AVX2/AVX-512、ARM NEON/SVE/SVE2、POWER、RISC-V、LoongArch），以在无硬件解码器的环境中提供最高解码速度为首要目标。支持 AV1 的所有子采样和位深度特性，API 简洁，可供其他程序嵌入调用，也可编译出命令行工具 dav1d 作为独立解码播放器使用。目标受众为多媒体应用开发者、视频播放器项目和需要 AV1 软件解码的任何系统集成。",
    "categories": [
      {
        "name": "AV1 比特流解析与解码",
        "description": "完整实现 AV1 编码格式的熵解码、帧内/帧间预测、变换与量化、环内滤波（去块/CDEF/恢复）等核心解码流程",
        "evidence": [
          "src/decode.c",
          "src/obu.c",
          "src/itx_tmpl.c",
          "src/loopfilter_tmpl.c",
          "src/recon_tmpl.c"
        ]
      },
      {
        "name": "多架构 SIMD 加速",
        "description": "针对 x86(SSE/SSSE3/AVX2/AVX-512)、ARM(AArch64/NEON/SVE/SVE2)、POWER、RISC-V、LoongArch 等架构，提供汇编或 intrinsic 级别的手工优化解码路径，含 MSAC 熵解码、逆变换、预测、环内滤波等关键热路径",
        "evidence": [
          "src/x86/cdef_avx2.asm",
          "src/x86/ipred_avx512.asm",
          "src/arm/64/mc.S",
          "src/arm/64/ipred.S",
          "src/ppc/cdef_tmpl.c",
          "src/riscv/64/mc.S",
          "src/loongarch/mc.S"
        ]
      },
      {
        "name": "多线程并行解码",
        "description": "支持帧级和 tile 级并行解码，使用 pthread/Win32 线程原语，充分利用多核 CPU 提升解码吞吐量",
        "evidence": [
          "src/thread_task.c",
          "src/win32/thread.c"
        ]
      },
      {
        "name": "公共 C API 与命令行工具",
        "description": "提供清晰的公共 C 头文件 API（dav1d_open/dav1d_send_data/dav1d_get_picture 等），附带 dav1d CLI 工具支持从文件/管道输入解码到 Y4M/YUV/MD5 等输出",
        "evidence": [
          "include/dav1d/dav1d.h",
          "include/dav1d/data.h",
          "include/dav1d/picture.h",
          "tools/dav1d.c",
          "tools/output/y4m2.c",
          "tools/input/ivf.c"
        ]
      }
    ],
    "domain": "多媒体/视频编解码",
    "target_users": "多媒体应用开发者、视频播放器项目、浏览器引擎、转码工具、嵌入式系统",
    "ecosystem": "cpp"
  },
