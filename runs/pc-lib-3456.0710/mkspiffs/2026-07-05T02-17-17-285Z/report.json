        "evidence": [
          "main.cpp:512-555 (actionUnpack)",
          "main.cpp:349-374 (unpackFile)",
          "main.cpp:385-457 (unpackFiles)"
        ]
      },
      {
        "name": "SPIFFS 镜像列表",
