  "function_summary": {
    "summary": "net-mdns（NuGet 包名 Makaretu.Dns.Multicast）是一个 .NET 多播 DNS（mDNS）库，完整实现 RFC 6762（多播 DNS）与 RFC 6763（DNS 服务发现）。它同时支持客户端（发送查询）和服务端（响应查询）两种角色，可在局域网内自动通告和发现服务。该库支持 IPv4 和 IPv6 双栈、多网卡并发多播、网络接口热插拔检测，以及反向地址映射和传统单播查询兼容，适用于需要通过 .NET 构建 Zeroconf/Bonjour 风格零配置网络的场景。",
    "categories": [
      {
        "name": "多播 DNS 协议栈",
        "description": "完整实现 RFC 6762 多播 DNS 协议，包括查询发送、应答生成、消息序列化/反序列化、TTL 管理等核心机制。",
        "evidence": [
          "src/MulticastService.cs",
          "src/MulticastClient.cs",
          "src/MessageEventArgs.cs"
        ]
      },
      {
        "name": "DNS 服务发现（DNS-SD）",
        "description": "基于 RFC 6763 实现高层 DNS 服务发现，支持自动响应服务查询、服务实例查询、服务子类型和动态通告/取消通告。",
        "evidence": [
          "src/ServiceDiscovery.cs",
          "src/ServiceProfile.cs"
        ]
      },
      {
        "name": "网络接口管理",
        "description": "检测新出现或移除的网络接口，支持在多个网卡上同时进行多播，兼容 IPv4 和 IPv6 环境。",
        "evidence": [
          "src/MulticastService.cs:198",
          "src/MulticastService.cs:222",
          "src/NetworkInterfaceEventArgs.cs"
        ]
      },
      {
        "name": "反向地址映射",
        "description": "支持通过 IP 地址查询对应主机名，将地址记录自动映射为 PTR 记录用于 DNS 反向查询。",
        "evidence": [
          "src/ServiceDiscovery.cs:257"
        ]
      }
    ],
    "domain": "networking",
    "target_users": ".NET 开发者，需要在 C# 应用中实现局域网服务自动发现与零配置网络的场景"
  },
