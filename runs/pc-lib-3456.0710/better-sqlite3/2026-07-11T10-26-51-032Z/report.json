  "function_summary": {
    "summary": "better-sqlite3 是为 Node.js 提供的 SQLite3 数据库同步绑定库，以 C++ 原生扩展（Node-API）形式封装 SQLite C 库，对外暴露同步 API。它强调高性能、安全性和简洁性：完全支持事务、用户自定义函数/聚合/虚拟表/窗口函数、64 位整数，并内置 Worker 线程支持用于处理大型查询。由于 SQLite 本身是串行化数据库，同步 API 避免了异步 API 常见的互斥锁争用和资源浪费，实际并发性能优于异步方案。",
    "categories": [
      {
        "name": "数据库访问（SQL）",
        "description": "提供对 SQLite3 数据库的完整 CRUD 操作——建表、查询（get/all/iterate）、插入/更新（run）、事务（transaction）、序列化/反序列化数据库等，所有操作均为同步调用。",
        "evidence": [
          "src/better_sqlite3.cpp",
          "lib/database.js",
          "src/objects/database.cpp",
          "src/objects/statement.cpp",
          "lib/methods/backup.js",
          "lib/methods/serialize.js",
          "lib/methods/pragma.js",
          "lib/methods/transaction.js"
        ]
      },
      {
        "name": "用户自定义函数与聚合",
        "description": "支持以 JavaScript 函数注册为 SQLite 的自定义标量函数（Scalar UDF）、聚合函数（Aggregate UDF，含 step/inverse/final）和窗口函数（Window Function）。",
        "evidence": [
          "src/util/custom-function.cpp",
          "src/util/custom-aggregate.cpp",
          "lib/methods/function.js",
          "lib/methods/aggregate.js"
        ]
      },
      {
        "name": "虚拟表",
        "description": "支持将 JavaScript 生成器（Generator）注册为 SQLite 虚拟表（Virtual Table），包括纯同名表（eponymous-only）和完整可建表模块。",
        "evidence": [
          "src/util/custom-table.cpp",
          "lib/methods/table.js"
        ]
      },
      {
        "name": "扩展加载",
        "description": "支持运行时加载 SQLite C 扩展库（.dll/.so/.dylib），通过 sqlite3_load_extension 接口完成。",
        "evidence": [
          "src/objects/database.cpp:loadExtension"
        ]
      },
      {
        "name": "性能与安全增强",
        "description": "内置 WAL 模式支持、防御模式（defensive mode，防止 SQL 注入修改数据库 schema）、64 位整数自动处理（BigInt）、预编译语句复用、批量插入的事务优化。",
        "evidence": [
          "src/objects/database.cpp",
          "lib/database.js",
          "src/util/data.cpp",
          "docs/performance.md",
          "docs/integer.md",
          "docs/unsafe.md"
        ]
      }
    ],
    "domain": "数据库",
    "target_users": "Node.js 后端开发者、Electron 桌面应用开发者、需要在 JavaScript 中高效访问本地 SQLite 数据库的各类应用场景"
  },
