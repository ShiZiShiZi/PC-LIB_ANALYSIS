  "function_summary": {
    "summary": "better-sqlite3 是一个面向 Node.js 的 SQLite 数据库驱动，以 C++ N-API 原生插件为核心，封装同步 JavaScript API。它是目前 Node.js 生态中性能最快、API 设计最简洁的 SQLite 驱动——提供数据库打开/关闭、SQL 预处理与执行（prepare/run/get/all/iterate）、完整事务支持、用户自定义函数/聚合/虚拟表、备份与序列化、扩展加载等功能，并支持 Worker 线程与 64 位整数。适合需要嵌入式本地数据库的 Node.js 应用开发者，尤其是高并发只读或本地桌面/CLI 工具场景。",
    "categories": [
      {
        "name": "SQL 数据库引擎",
        "description": "封装 SQLite C API，提供 SQL 解析、编译、执行与结果返回的完整流程，支持预编译语句（prepared statement）重用以提升性能",
        "evidence": [
          "src/objects/database.cpp",
          "src/objects/statement.cpp",
          "lib/database.js"
        ]
      },
      {
        "name": "事务控制",
        "description": "支持 BEGIN/COMMIT/ROLLBACK 以及嵌套事务（savepoint），提供 deferred/immediate/exclusive 四种事务模式",
        "evidence": [
          "lib/methods/transaction.js:52-78"
        ]
      },
      {
        "name": "用户自定义函数与聚合",
        "description": "允许在 JavaScript 中定义 SQL 标量函数、窗口函数与自定义聚合（含 step/inverse/value），注入 SQLite 运行时执行",
        "evidence": [
          "src/util/custom-function.cpp",
          "src/util/custom-aggregate.cpp"
        ]
      },
      {
        "name": "虚拟表",
        "description": "支持以 JavaScript 工厂函数创建 eponymous 虚拟表，可在 SQL 查询中动态生成数据",
        "evidence": [
          "src/util/custom-table.cpp",
          "lib/methods/table.js"
        ]
      },
      {
        "name": "数据库备份与序列化",
        "description": "利用 SQLite 在线备份 API 实现热备，支持将数据库序列化为 Buffer 或从 Buffer 反序列化恢复",
        "evidence": [
          "src/objects/backup.cpp",
          "lib/methods/backup.js",
          "lib/methods/serialize.js"
        ]
      },
      {
        "name": "扩展加载",
        "description": "支持动态加载 SQLite 扩展（.dll/.so），为数据库注入额外功能",
        "evidence": [
          "src/objects/database.cpp:365-385",
          "lib/methods/wrappers.js:18-21"
        ]
      },
      {
        "name": "Worker 线程安全",
        "description": "支持在 Node.js Worker 线程中使用，通过同步 API 规避异步驱动的互斥锁争用",
        "evidence": [
          "lib/database.js",
          "test/44.worker-threads.js"
        ]
      }
    ],
    "domain": "数据库",
    "target_users": "Node.js 应用开发者、桌面应用与 CLI 工具开发者"
  },
