  "function_summary": {
    "summary": "RTTR（Run Time Type Reflection）是一个纯 C++11 头文件/库结合的运行时反射库，允许开发者在不依赖编译器 RTTI 的情况下，将 C++ 类、构造器、方法、属性与枚举注册到统一的类型系统，并通过字符串名动态创建对象、调用方法或读写属性。它面向需要元数据、序列化、脚本绑定或插件化的 C++ 应用程序与引擎开发者。",
    "categories": [
      {
        "name": "运行时类型注册",
        "description": "通过 RTTR_REGISTRATION 块或 RTTR_ENABLE 宏将类、构造器、方法、属性、枚举注册到全局类型表，形成可在运行时查询的元数据。",
        "evidence": [
          "src/rttr/registration.h:1",
          "src/rttr/detail/registration/registration_impl.h:1"
        ]
      },
      {
        "name": "动态构造与类型查询",
        "description": "以字符串或模板方式获取 type 对象，按名称创建实例，查询继承关系与成员列表。",
        "evidence": [
          "src/rttr/type.h:1",
          "src/rttr/type.cpp:67"
        ]
      },
      {
        "name": "属性与方法反射",
        "description": "在运行时通过 property/method 对象读取/写入数据成员、调用成员函数或静态函数，并支持默认参数与策略。",
        "evidence": [
          "src/rttr/property.h:46",
          "src/rttr/method.h:1"
        ]
      },
      {
        "name": "variant 与视图",
        "description": "提供类型擦除容器 variant，以及对顺序容器、关联容器、数组的反射视图，用于统一访问不同数据结构。",
        "evidence": [
          "src/rttr/variant.h:1",
          "src/rttr/variant_sequential_view.h:1",
          "src/rttr/variant_associative_view.h:1"
        ]
      },
      {
        "name": "动态库加载",
        "description": "library 类封装跨平台的共享库加载（Windows LoadLibraryW / POSIX dlopen），支持插件式反射注册。",
        "evidence": [
          "src/rttr/library.h:1",
          "src/rttr/detail/library/library_unix.cpp:106",
          "src/rttr/detail/library/library_win.cpp:200"
        ]
      }
    ],
    "domain": "reflection / metadata",
    "target_users": "C++ 应用与引擎开发者，尤其需要序列化、脚本化、编辑器属性面板或插件系统的项目。"
  },
