  "function_summary": {
    "summary": "quickjs-emscripten 是将 QuickJS（一个轻量级现代 JavaScript 解释器）编译为 WebAssembly 并提供 TypeScript 绑定的开源库。它允许开发者在浏览器、Node.js、Deno、Bun、Cloudflare Workers 等 JavaScript/WebAssembly 运行时环境中安全地执行不受信任的 JavaScript 代码，并支持在宿主与 QuickJS 虚拟机之间双向传递和操作 JavaScript 值。核心编译产物为一个或多个 WASM 变体（同步/异步 asyncify 两模式），通过 Emscripten 编译 C 源码并生成 JS 胶水层。",
    "categories": [
      {
        "name": "JavaScript 虚拟机与代码执行",
        "description": "在 WASM 沙箱内创建 QuickJS 运行时和上下文，安全地执行 JavaScript 代码字符串，支持 ES2023 大部分特性",
        "evidence": [
          "packages/quickjs-emscripten-core/src/context.ts",
          "packages/quickjs-emscripten-core/src/runtime.ts",
          "c/interface.c"
        ]
      },
      {
        "name": "JS 值与宿主双向互通",
        "description": "在宿主 TypeScript/JavaScript 与 QuickJS WASM 虚拟机之间创建、读取、修改和传递 JavaScript 值（字符串、数字、对象、函数、Promise 等）",
        "evidence": [
          "packages/quickjs-emscripten-core/src/context.ts",
          "packages/quickjs-emscripten-core/src/types.ts",
          "packages/quickjs-ffi-types/src/index.ts"
        ]
      },
      {
        "name": "宿主函数暴露到虚拟机",
        "description": "将 TypeScript/JavaScript 宿主函数注册到 QuickJS 虚拟机中，使被执行的脚本能调用宿主能力",
        "evidence": [
          "packages/quickjs-emscripten-core/src/context.ts",
          "packages/quickjs-emscripten-core/src/vm-interface.ts"
        ]
      },
      {
        "name": "异步支持 (Asyncify)",
        "description": "通过 Emscripten Asyncify 机制，允许在 WASM 同步执行流程中调用宿主异步函数并挂起/恢复执行",
        "evidence": [
          "packages/quickjs-emscripten-core/src/context-asyncify.ts",
          "packages/quickjs-emscripten-core/src/module-asyncify.ts",
          "packages/quickjs-emscripten-core/src/asyncify-helpers.ts"
        ]
      },
      {
        "name": "多运行时/多变体打包",
        "description": "提供多种构建变体（WASM 分离文件/单文件嵌入、同步/异步）以适配不同运行时环境（浏览器/Node/Deno/Cloudflare Workers）",
        "evidence": [
          "scripts/prepareVariants.ts",
          "packages/variant-*/src/index.ts"
        ]
      },
      {
        "name": "ES 模块加载器",
        "description": "支持在 QuickJS 虚拟机内运行 ES 模块（import/export），由宿主侧提供模块加载和路径解析",
        "evidence": [
          "packages/quickjs-emscripten-core/src/module.ts",
          "packages/quickjs-emscripten-core/src/module-asyncify.ts"
        ]
      }
    ],
    "domain": "运行时/解释器",
    "target_users": "需要在 Web、Node.js 或其他 WASM 环境中安全执行沙箱化 JavaScript 的前端/全栈开发者",
