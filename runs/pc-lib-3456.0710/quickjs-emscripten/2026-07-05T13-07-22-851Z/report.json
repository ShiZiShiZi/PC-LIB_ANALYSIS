  "function_summary": {
    "summary": "quickjs-emscripten 是将 Fabrice Bellard 编写的 QuickJS JavaScript 引擎通过 Emscripten 编译为 WebAssembly (WASM) 的 TypeScript 绑定库。它提供完整的 JS 运行时环境：可在浏览器、Node.js、Deno、Bun 及 Cloudflare Workers 中安全地执行不受信任的 JavaScript 代码，支持 ES2023 语法。核心功能包括创建隔离的 JS 虚拟机（运行时与上下文管理）、宿主与 QuickJS 之间的双向类型安全互操作（暴露宿主函数、传递值）、利用 Emscripten Asyncify 实现同步代码调用异步宿主函数、ES 模块加载器扩展、内存限制与执行中断等安全控制、以及多种预编译构建变体（调试/发布、同步/异步、单文件嵌入/外部 WASM 文件、CJS/ESM/MJS/浏览器 IIFE 等输出格式）。适合需要安全沙箱化脚本执行的场景（如插件系统、用户脚本、低代码平台配置引擎）。",
    "categories": [
      {
        "name": "沙箱化 JavaScript 执行引擎",
        "description": "提供基于 WebAssembly 的隔离 JavaScript 运行时，安全评估不受信任的代码，支持 ES2023 语法（含 Proxy、BigInt、Promise、模块等）",
        "evidence": [
          "packages/quickjs-emscripten-core/src/module.ts:326 (QuickJSWASMModule.evalCode)",
          "packages/quickjs-emscripten-core/src/context.ts:177 (QuickJSContext 类与 evalCode)",
          "packages/quickjs-emscripten-core/src/runtime.ts:46 (QuickJSRuntime)",
          "c/interface.c (C 层 QuickJS API 封装)"
        ]
      },
      {
        "name": "宿主函数互操作",
        "description": "将 TypeScript/JavaScript 宿主函数暴露给 QuickJS VM，通过 HostRef/回调机制实现双向类型安全调用，支持同步与异步（Asyncify）两种模式",
        "evidence": [
          "packages/quickjs-emscripten-core/src/module.ts:100 (QuickJSModuleCallbacks)",
          "packages/quickjs-emscripten-core/src/context.ts:668 (newFunction)",
          "packages/quickjs-emscripten-core/src/module.ts:51 (QuickJSEmscriptenModuleCallbacks)",
          "c/interface.c:497-539 (HostRef 管理)"
        ]
      },
      {
        "name": "Asyncify 异步桥接",
        "description": "通过 Emscripten Asyncify 编译选项，使 QuickJS VM 内部的同步 JS 代码可以调用宿主环境的异步操作（如 fetch、文件读取），执行过程可挂起/恢复",
        "evidence": [
          "packages/quickjs-emscripten-core/src/module.ts:126-182 (handleAsyncify)",
          "packages/quickjs-emscripten-core/src/context-asyncify.ts (QuickJSAsyncContext)",
          "packages/quickjs-emscripten-core/src/runtime-asyncify.ts (QuickJSAsyncRuntime)",
          "c/interface.c:444-458 (set_asyncify_stack_size)"
        ]
      },
      {
        "name": "内存与安全控制",
        "description": "提供 WebAssembly 堆内存限制、栈大小限制、执行超时中断（shouldInterruptAfterDeadline）等安全机制，防止不受信任代码耗尽资源",
        "evidence": [
          "packages/quickjs-emscripten-core/src/runtime.ts:121 (setMemoryLimit, setMaxStackSize)",
          "packages/quickjs-emscripten-core/src/interrupt-helpers.ts (shouldInterruptAfterDeadline)",
          "packages/quickjs-emscripten-core/src/memory.ts (ModuleMemory)"
        ]
      },
      {
        "name": "多构建变体与多环境部署",
        "description": "预生成多种 WebAssembly 构建变体（同步/异步、调试/发布、单文件嵌入/外部文件），覆盖 debug-asyncify、release-sync 等组合，适配 CJS/ESM/MJS/Browser 等不同模块系统",
        "evidence": [
          "packages/quickjs-emscripten/src/variants.ts",
          "packages/quickjs-emscripten/src/mod.ts",
          "scripts/prepareVariants.ts",
          "variants.json"
        ]
      },
      {
        "name": "ES 模块加载",
        "description": "支持自定义模块加载器与模块路径标准化器，在 QuickJS VM 内实现 import/export 语句",
        "evidence": [
          "packages/quickjs-emscripten-core/src/types.ts:55-101 (JSModuleLoader/JSModuleNormalizer)",
          "packages/quickjs-emscripten-core/src/module.ts:223-259 (loadModuleSource/normalizeModule)",
          "c/interface.c:1470-1488 (qts_host_load_module_source/normalize_module)"
        ]
      }
    ],
    "domain": "JavaScript 运行时/脚本引擎",
    "target_users": "需要在应用中嵌入安全 JS 沙箱的 TypeScript/JavaScript 开发者（如低代码平台、插件系统、用户脚本安全执行环境）"
  },
