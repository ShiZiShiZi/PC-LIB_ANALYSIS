  "function_summary": {
    "summary": "liba52 是一个用 C 语言编写的 ATSC A/52（AC-3 / 杜比数字）音频流解码库。它读取符合 A/52 标准的压缩音频码流（如 DVD 音轨或数字电视音频），完成比特流解析、指数/尾数解码、IMDCT 变换、声道下混等处理，输出 PCM 音频样本。附带命令行工具 a52dec（解码器 + MPEG-1/2 节目流解复用器）和 extract_a52（A/52 码流抽取工具）。",
    "domain": "多媒体/音频编解码",
    "target_users": "多媒体播放器开发者、音视频框架集成者、嵌入式音频系统开发者",
    "categories": [
      {
        "name": "音频解码",
        "description": "核心功能：解码 ATSC A/52 标准（AC-3 / 杜比数字）的压缩音频码流为 PCM 样本。"
      },
      {
        "name": "码流解复用",
        "description": "附带工具支持 MPEG-1 和 MPEG-2 节目流（program stream）和传输流（transport stream）中抽取 A/52 音频轨道。"
      },
      {
        "name": "音频输出抽象",
        "description": "提供OSS、Solaris、AL、Win32 waveOut 等多种音频输出后端的抽象层，也支持 WAV/AIFF 文件输出。"
      }
    ]
  },
