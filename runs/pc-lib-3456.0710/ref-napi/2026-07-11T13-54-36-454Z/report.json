  "function_summary": {
    "summary": "ref-napi 是一个 Node.js 原生插件（N-API），将 Node.js 的 Buffer 实例赋予类 C 指针的语义——提供获取 Buffer 内存地址、读写指向 JavaScript 对象的引用、读写 64 位整数（int64/uint64）以及一套可扩展的\"类型\"（type）体系，使 Buffer 可以按指定 C 类型进行解引用与赋值。灵感来自旧版 node-ffi 的 Pointer 类，但完全基于 Node 原生 Buffer，性能更高且避免了独立的 C++ Pointer 类开销。主要供 node-ffi-napi 等 FFI 场景使用。",
    "categories": [
      {
        "name": "Buffer 指针地址读取",
        "description": "获取任意 Buffer 实例的内存地址（十六进制或数值），以及判断是否为 NULL 指针。",
        "evidence": [
          "lib/ref.js:8-10",
          "src/binding.cc:222-227 (Address)",
          "src/binding.cc:238-251 (HexAddress)",
          "src/binding.cc:260-263 (IsNull)"
        ]
      },
      {
        "name": "指针引用与解引用 (ref/deref)",
        "description": "在 Buffer 中读写指向 JavaScript Object 的持久引用，以及创建/解引用多级指针（如 int **），实现类似 C 语言指针语义的操作。",
        "evidence": [
          "lib/ref.js:635-638 (ref)",
          "lib/ref.js:663-666 (deref)",
          "lib/ref.js:309-322 (refType)",
          "lib/ref.js:332-344 (derefType)",
          "src/binding.cc:273-282 (ReadObject)",
          "src/binding.cc:294-311 (WriteObject)",
          "lib/ref.js:679-684 (_attach)"
        ]
      },
      {
        "name": "64 位整数读写",
        "description": "支持 int64_t 和 uint64_t 的读写，当数值超出 JavaScript Number 安全范围时自动以 String 形式返回，避免精度丢失。",
        "evidence": [
          "src/binding.cc:382-399 (ReadInt64)",
          "src/binding.cc:410-442 (WriteInt64)",
          "src/binding.cc:451-468 (ReadUInt64)",
          "src/binding.cc:479-511 (WriteUInt64)",
          "lib/ref.js:586-618 (endian 别名)"
        ]
      },
      {
        "name": "可扩展类型体系",
        "description": "一套\"类型\"约定——支持 int/uint/long/float/double/void/CString/Object 等内置类型，也允许用户自定义类型对象（含 size/indirection/get/set），使 Buffer 可按指定 C 类型解引用。",
        "evidence": [
          "lib/ref.js:834-979 (内置 types 定义)",
          "lib/ref.js:1156-1171 (typedef for variable-sized types)",
          "lib/ref.js:370-405 (coerceType)",
          "lib/ref.js:444-465 (get 泛型解引用)",
          "lib/ref.js:480-496 (set 泛型赋值)"
        ]
      },
      {
        "name": "内存重解释 (reinterpret)",
        "description": "基于同一块内存创建指定长度或到 NULL 终止符的新 Buffer 视图，支持 C 风格的 reinterpret_cast 操作。",
        "evidence": [
          "lib/ref.js:783-788 (reinterpret)",
          "lib/ref.js:826-831 (reinterpretUntilZeros)",
          "src/binding.cc:542-553 (ReinterpretBuffer)",
          "src/binding.cc:565-592 (ReinterpretBufferUntilZeros)"
        ]
      }
    ],
    "domain": "系统编程 / FFI 桥接",
    "target_users": "Node.js 系统编程开发者、FFI/原生库调用场景的使用者"
  },
