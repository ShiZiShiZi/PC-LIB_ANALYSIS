  "function_summary": {
    "summary": "SimpleBase 是一个纯 C# 编写的多进制编解码库，提供 Base16、Base32、Base36、Base45、Base58、Base62、Base85 及 Base256Emoji（🚀）等基编码方案的编解码功能。支持 Multibase 标准、多种业界变体（RFC 4648、BECH32、Crockford、z-base-32、Bitcoin、Ripple、Monero 等）以及自定义字母表。零外部依赖，线程安全，支持 big-endian CPU，提供基于 Memory Buffer 的一次性 API 与异步流式 API。发布于 NuGet（Package: SimpleBase）。",
    "categories": [
      {
        "name": "Base32 编解码",
        "description": "支持 RFC 4648、BECH32、Crockford（含字符替换）、z-base-32、Geohash、FileCoin 和 Extended Hex 等变体编码与解码",
        "evidence": [
          "src/Base32.cs",
          "src/Base32Alphabet.cs"
        ]
      },
      {
        "name": "Base58 编解码",
        "description": "支持 Bitcoin（BTC）、Ripple（XRP）、Monero（XMR）等标准变体，以及 Base58Check、Avalanche CB58 编解码",
        "evidence": [
          "src/Base58.cs",
          "src/MoneroBase58.cs",
          "src/Base58Alphabet.cs"
        ]
      },
      {
        "name": "Base85 编解码",
        "description": "支持 Ascii85、Z85 及自定义字母表变体，以及 IPv6（RFC 1924）编解码",
        "evidence": [
          "src/Base85.cs",
          "src/Base85Ipv6.cs",
          "src/Base85Alphabet.cs"
        ]
      },
      {
        "name": "其他基编码",
        "description": "支持 Base16（含 ModHex）、Base36、Base45（RFC 9285）、Base62、Base2/Base8/Base10 以及 Base256Emoji 编解码",
        "evidence": [
          "src/Base16.cs",
          "src/Base36.cs",
          "src/Base45.cs",
          "src/Base62.cs",
          "src/Base2.cs",
          "src/Base8.cs",
          "src/Base10.cs",
          "src/Base256Emoji.cs"
        ]
      },
      {
        "name": "Multibase 支持",
        "description": "支持 Multibase 多格式前缀自动识别与编解码，涵盖多种 Base16/32/58/64 变体",
        "evidence": [
          "src/Multibase.cs",
          "src/MultibaseEncoding.cs"
        ]
      },
      {
        "name": "流式异步编解码",
        "description": "提供基于 Stream 和 TextWriter/TextReader 的异步流式编解码 API",
        "evidence": [
          "src/IBaseStreamCoder.cs",
          "src/StreamHelper.cs"
        ]
      }
    ],
