  "function_summary": {
    "summary": "MPIR 是一个高性能任意精度算术库，是 GMP（GNU Multiple Precision Arithmetic Library）的分支。支持有符号大整数（mpz）、有理数（mpq）、浮点数（mpf）以及底层 mpn 运算。面向需要高精度数值计算的 C/C++ 开发者，同时提供 .NET 绑定。广泛用于密码学、数论研究、科学计算等领域。",
    "categories": [
      {
        "name": "有符号大整数运算（mpz）",
        "description": "提供加减乘除、取模、幂运算、GCD/LCM、素性检测等大整数算术功能。",
        "evidence": [
          "mpz/add.c",
          "mpz/mul.c",
          "mpz/powm.c",
          "mpz/pprime_p.c",
          "gmp-h.in mpz_* 函数声明"
        ]
      },
      {
        "name": "有理数运算（mpq）",
        "description": "支持有理数的四则运算、规范化、比较与 I/O。",
        "evidence": [
          "mpq/add.c",
          "mpq/mul.c",
          "mpq/div.c",
          "gmp-h.in mpq_* 函数声明"
        ]
      },
      {
        "name": "浮点数运算（mpf）",
        "description": "支持用户指定精度的任意精度浮点数算术运算。",
        "evidence": [
          "mpf/add.c",
          "mpf/mul.c",
          "gmp-h.in mpf_* 函数声明"
        ]
      },
      {
        "name": "底层 mpn 运算",
        "description": "提供不托管内存的底层正整数运算原语，所有高层运算均构建于此之上；包含多平台手工汇编优化（x86/x86_64/ARM）。",
        "evidence": [
          "mpn/generic/add.c",
          "mpn/x86_64/core2/aors_n.asm",
          "mpn/arm/add_n.asm",
          "mpn/alpha/",
          "mpn/powerpc64/"
        ]
      },
      {
        "name": ".NET 绑定",
        "description": "通过 C++/CLI 提供 .NET（C#/VB.NET 等）对 MPIR 库的访问，封装 HugeInt/HugeFloat/HugeRational 类型与随机数生成器。",
        "evidence": [
          "mpir.net/mpir.net/HugeInt.cpp",
          "mpir.net/mpir.net/HugeFloat.cpp",
          "mpir.net/mpir.net/HugeRational.cpp",
          "mpir.net/mpir.net/Random.cpp"
        ]
      },
      {
        "name": "格式化 I/O 与打印",
        "description": "支持 gmp_printf/gmp_scanf 风格的自定义格式输出与输入。",
        "evidence": [
          "printf/",
          "scanf/",
          "gmp-h.in gmp_printf/gmp_scanf 声明"
        ]
      }
    ],
    "domain": "数值计算、密码学、数论",
    "target_users": "C/C++ 开发者、密码学研究人员、需要高精度算术的 .NET 应用开发者"
  },
