  "function_summary": {
    "summary": "mpg123 是一个高性能、可移植的 MPEG 音频解码库，支持 MPEG 1.0/2.0/2.5 Layer I/II/III（即 MP3）格式解码。项目由三部分构成：libmpg123（核心解码引擎，含 SSE/AVX/NEON/AltiVec 等 CPU 优化）、libout123（跨平台音频输出抽象层，支持 ALSA/PulseAudio/JACK/CoreAudio/WASAPI/OSS/SDL/PortAudio 等二十余种后端）、libsyn123（测试信号生成与音频格式转换/重采样）。附带 mpg123 命令行播放器和 out123 命令行播放测试工具。广泛用于各类媒体播放器与音频处理管线。",
    "categories": [
      {
        "name": "MPEG 音频解码",
        "description": "MPEG 1.0/2.0/2.5 Layer I/II/III（MP3）完整解码，含 ID3v2 标签解析、无缝播放、均衡器支持",
        "evidence": [
          "src/libmpg123/layer1.c",
          "src/libmpg123/layer2.c",
          "src/libmpg123/layer3.c",
          "src/libmpg123/libmpg123.c",
          "src/include/mpg123.h"
        ]
      },
      {
        "name": "CPU 优化解码后端",
        "description": "针对 x86 SSE/AVX、ARM NEON/NEON64、PowerPC AltiVec 的汇编/SIMD 优化解码路径，含 DCT36/DCT64 变换加速",
        "evidence": [
          "src/libmpg123/dct36_sse.S",
          "src/libmpg123/dct36_avx.S",
          "src/libmpg123/dct36_neon.S",
          "src/libmpg123/dct36_neon64.S",
          "src/libmpg123/dct64_avx.S",
          "src/libmpg123/dct64_neon.S"
        ]
      },
      {
        "name": "跨平台音频输出",
        "description": "libout123 提供的音频输出抽象层，运行时动态加载平台音频后端——Linux（ALSA/PulseAudio/JACK/OSS），macOS（CoreAudio），Windows（Win32/WASAPI），及其他（SDL/PortAudio/sndio/OpenAL）",
        "evidence": [
          "src/libout123/modules/alsa.c",
          "src/libout123/modules/pulse.c",
          "src/libout123/modules/jack.c",
          "src/libout123/modules/coreaudio.c",
          "src/libout123/modules/win32.c",
          "src/libout123/modules/win32_wasapi.c",
          "src/libout123/modules/sdl.c",
          "src/libout123/modules/portaudio.c"
        ]
      },
      {
        "name": "音频信号合成与转换",
        "description": "生成测试信号（正弦波/白噪声/粉红噪声）、采样率重采样、格式转换（S16/S32/F32/ALAW/ULAW/iG.711/μG.711）",
        "evidence": [
          "src/libsyn123/libsyn123.c",
          "src/libsyn123/resample.c",
          "src/libsyn123/sampleconv.c",
          "src/libsyn123/pinknoise.c",
          "src/include/syn123.h"
        ]
      },
      {
        "name": "命令行 MPEG 播放器",
        "description": "基于 libmpg123 与 libout123 的完整命令行 MPEG 音频播放器，支持 HTTP/FTP 流媒体、终端控制界面",
        "evidence": [
          "src/mpg123.c",
          "src/control_generic.c",
          "src/httpget.c"
        ]
      }
    ],
    "domain": "多媒体 / 音频编解码",
    "target_users": "媒体播放器开发者、嵌入式音频系统集成者、需要高性能 MP3 解码的 C/C++ 应用程序"
  },
