  "function_summary": {
    "summary": "Newtonsoft.Json（Json.NET）是 .NET 生态最流行的 JSON 处理框架，提供高性能的对象与 JSON 之间的序列化/反序列化、内存中 JSON 文档操作（LINQ to JSON）、JSON Schema 验证以及 BSON 格式支持。它通过 NuGet 包分发，被几乎所有 .NET 项目广泛依赖。",
    "categories": [
      {
        "name": "JSON 序列化与反序列化",
        "description": "在 .NET 对象（POCO）与 JSON 文本双向转换的核心能力，支持高度可配置的序列化行为（日期格式、命名策略、空值处理、循环引用、类型名称保留等）。",
        "evidence": [
          "Src/Newtonsoft.Json/JsonConvert.cs",
          "Src/Newtonsoft.Json/JsonSerializer.cs",
          "Src/Newtonsoft.Json/Serialization/"
        ]
      },
      {
        "name": "LINQ to JSON",
        "description": "提供内存中 JSON 文档对象模型（JObject、JArray、JToken），支持类 LINQ 的方式动态读取、查询、修改、创建 JSON 数据，无需预定义 .NET 类型。",
        "evidence": [
          "Src/Newtonsoft.Json/Linq/JObject.cs",
          "Src/Newtonsoft.Json/Linq/JArray.cs",
          "Src/Newtonsoft.Json/Linq/JToken.cs"
        ]
      },
      {
        "name": "JSON Path 查询",
        "description": "提供类似 XPath 的 JSON 路径表达式支持，可对 JSON 文档进行条件查询与过滤操作。",
        "evidence": [
          "Src/Newtonsoft.Json/Linq/JsonPath/JPath.cs"
        ]
      },
      {
        "name": "JSON Schema 验证",
        "description": "支持 JSON Schema 标准，可定义并校验 JSON 数据结构的完整性，生成 Schema、验证数据。",
        "evidence": [
          "Src/Newtonsoft.Json/Schema/JsonSchema.cs",
          "Src/Newtonsoft.Json/Schema/JsonSchemaGenerator.cs"
        ]
      },
      {
        "name": "BSON 支持",
        "description": "支持二进制 JSON（BSON）格式的读写，用于 MongoDB 等 NoSQL 数据库的高效数据交换。",
        "evidence": [
          "Src/Newtonsoft.Json/Bson/BsonReader.cs",
          "Src/Newtonsoft.Json/Bson/BsonWriter.cs"
        ]
      }
    ],
