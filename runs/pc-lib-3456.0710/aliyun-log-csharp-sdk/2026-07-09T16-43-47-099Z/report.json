  "function_summary": {
    "summary": "阿里云日志服务（SLS）官方 .NET SDK，封装了 SLS 的 REST API，支持将日志数据写入到阿里云日志服务、从日志库查询和分析日志、管理 Logstore 和 Shard 等资源，并提供 LZ4 压缩和 Protocol Buffers 序列化以优化传输效率。面向需要在 .NET 应用中集成阿里云日志收集和分析能力的开发者。",
    "categories": [
      {
        "name": "日志写入",
        "description": "将结构化日志数据批量上传到指定的 SLS Logstore，支持 Protobuf 序列化和 LZ4 压缩以优化网络传输",
        "evidence": [
          "SLSSDK/Client.cs:PutLogs",
          "SLSSDK/Request/PutLogsRequest.cs"
        ]
      },
      {
        "name": "日志查询与分析",
        "description": "按时间范围和查询条件检索日志，支持全文搜索和统计分析",
        "evidence": [
          "SLSSDK/Client.cs:GetLogs",
          "SLSSDK/Request/GetLogsRequest.cs",
          "SLSSDK/Response/GetLogsResponse.cs"
        ]
      },
      {
        "name": "日志消费",
        "description": "通过 Shard 游标机制顺序消费日志数据，支持批量拉取",
        "evidence": [
          "SLSSDK/Client.cs:GetCursor",
          "SLSSDK/Client.cs:BatchGetLogs",
          "SLSSDK/Request/BatchGetLogsRequest.cs"
        ]
      },
      {
        "name": "资源管理",
        "description": "列出项目下的 Logstore、Topic 和 Shard 列表，查询直方图统计",
        "evidence": [
          "SLSSDK/Client.cs:ListLogstores",
          "SLSSDK/Client.cs:ListShards",
          "SLSSDK/Client.cs:GetHistograms"
        ]
      },
      {
        "name": "请求签名与认证",
        "description": "对 API 请求进行 HMAC-SHA1 签名，以阿里云 AccessKey 鉴权",
        "evidence": [
          "SLSSDK/Common/Authentication/HmacSHA1Signature.cs",
          "SLSSDK/Utilities/RequestSigner.cs"
        ]
      }
    ],
    "domain": "云计算/日志服务",
    "target_users": ".NET 应用开发者、运维工程师"
  },
