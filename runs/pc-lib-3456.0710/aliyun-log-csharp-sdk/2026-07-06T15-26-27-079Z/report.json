  "function_summary": {
    "summary": "阿里云日志服务（Simple Log Service，SLS）的 .NET/C# SDK，封装了与 SLS 服务端通信的 HTTP API。核心类 LogClient 提供日志写入（PutLogs）、日志查询（GetLogs/BatchGetLogs）、直方图统计（GetHistograms）、Logstore 列举（ListLogstores）、Topic 管理（ListTopics）、Shard 游标与列表（GetCursor/ListShards）等操作。使用 Protobuf 序列化日志数据，LZ4/zlib 压缩传输，HMAC-SHA1 签名鉴权。面向在 .NET Framework 3.5/4.0 环境下对接阿里云日志服务的开发者。",
    "categories": [
      {
        "name": "日志写入",
        "description": "通过 Protobuf 序列化与 LZ4 压缩，将结构化日志数据批量写入指定 Logstore",
        "evidence": [
          "SLSSDK/Client.cs:275",
          "SLSSDK/Utilities/ClientTools.cs:53"
        ]
      },
      {
        "name": "日志查询与检索",
        "description": "按时间范围、Topic、查询语句检索日志，支持分页与批量拉取",
        "evidence": [
          "SLSSDK/Client.cs:395",
          "SLSSDK/Client.cs:206"
        ]
      },
      {
        "name": "直方图统计",
        "description": "查询指定时间范围内日志的分布直方图，用于日志量趋势分析",
        "evidence": [
          "SLSSDK/Client.cs:454"
        ]
      },
      {
        "name": "Logstore 与 Shard 管理",
        "description": "列举项目下的 Logstore、查询 Shard 列表与游标位置",
        "evidence": [
          "SLSSDK/Client.cs:244",
          "SLSSDK/Client.cs:175",
          "SLSSDK/Client.cs:142"
        ]
      },
      {
        "name": "请求签名与鉴权",
        "description": "基于 AccessKey 的 HMAC-SHA1 签名机制，支持安全令牌（SecurityToken）临时授权",
        "evidence": [
          "SLSSDK/Utilities/ClientTools.cs:178",
          "SLSSDK/Common/Authentication/HmacSHA1Signature.cs:33"
        ]
      },
      {
        "name": "HTTP 通信与压缩",
        "description": "封装 HttpWebRequest 通信层，支持代理、超时配置，以及 LZ4 和 zlib 数据压缩",
        "evidence": [
          "SLSSDK/Common/Communication/ServiceClientImpl.cs:235",
          "SLSSDK/Utilities/ClientTools.cs:27"
        ]
      }
    ],
    "domain": "云服务日志/观测",
    "target_users": "在 .NET 环境下需要对接阿里云日志服务（SLS）的应用开发者"
  },
