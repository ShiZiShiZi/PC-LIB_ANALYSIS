  "function_summary": {
    "summary": "Imath 是一个基础、轻量且高效的 C++ 数学库，面向计算机图形应用。它提供 2D/3D 向量、矩阵、四元数、欧拉角等常用数学对象与运算，以及 IEEE 754-2008 binary16 兼容的 16 位半精度浮点类型 half。同时提供可选的 Python 绑定，支持向量和矩阵数组的优化实现。",
    "categories": [
      {
        "name": "2D/3D 向量与运算",
        "description": "提供 Vec2、Vec3、Vec4 等模板化向量类型，支持加、减、点积、叉积、归一化、线性插值等常见向量运算。",
        "evidence": [
          "src/Imath/ImathVec.h",
          "src/Imath/ImathVecAlgo.h"
        ]
      },
      {
        "name": "矩阵与线性变换",
        "description": "提供 Matrix22、Matrix33、Matrix44 等方阵类型，支持矩阵乘法、转置、求逆、行列式计算、从旋转/缩放/平移构造等操作。",
        "evidence": [
          "src/Imath/ImathMatrix.h",
          "src/Imath/ImathMatrixAlgo.h"
        ]
      },
      {
        "name": "四元数、欧拉角与旋转",
        "description": "提供 Quat（四元数）和 Euler（欧拉角）类型，支持球面线性插值（slerp）、四元数乘法、轴角构造、以及欧拉角的各种顺序表示。",
        "evidence": [
          "src/Imath/ImathQuat.h",
          "src/Imath/ImathEuler.h"
        ]
      },
      {
        "name": "半精度浮点类型 (half)",
        "description": "实现 16 位半精度浮点类型 half，兼容 IEEE 754-2008 binary16 格式；支持查找表、F16C SSE 硬件指令和纯位运算三种转换路径。",
        "evidence": [
          "src/Imath/half.h",
          "src/Imath/half.cpp",
          "src/Imath/toFloat.h"
        ]
      },
      {
        "name": "几何基础类型",
        "description": "提供 Box（轴对齐包围盒）、Line（直线/线段）、Plane（平面）、Sphere（球体）、Frustum（视锥体）等几何基础类型，支持相交测试和边界计算。",
        "evidence": [
          "src/Imath/ImathBox.h",
          "src/Imath/ImathBoxAlgo.h",
          "src/Imath/ImathLine.h",
          "src/Imath/ImathPlane.h",
          "src/Imath/ImathSphere.h",
          "src/Imath/ImathFrustum.h"
        ]
      },
      {
        "name": "颜色处理",
        "description": "提供 Color3、Color4 颜色类型，以及 HSV/HSL 与 RGB 之间的颜色空间转换算法。",
        "evidence": [
          "src/Imath/ImathColor.h",
          "src/Imath/ImathColorAlgo.h"
        ]
      },
      {
        "name": "OpenGL 辅助接口",
        "description": "提供对 OpenGL 和 GLU 的便捷封装，包括将 Imath 类型转换为 glVertex/glMultMatrix/gluLookAt 等 GL 调用的工具函数。",
        "evidence": [
          "src/Imath/ImathGL.h",
          "src/Imath/ImathGLU.h"
        ]
      },
      {
        "name": "Python 绑定",
        "description": "通过 PyBind11 提供类型和函数的 Python 绑定，支持向量与矩阵数组的优化实现。",
        "evidence": [
          "src/pybind11/PyBindImath/",
          "src/python/PyImath/"
        ]
      }
    ],
    "domain": "计算机图形学数学",
    "target_users": "计算机图形应用开发者、游戏引擎开发者、视觉特效（VFX）软件开发者",
    "ecosystem": "cpp"
