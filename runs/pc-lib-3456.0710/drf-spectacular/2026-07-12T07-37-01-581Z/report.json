  "function_summary": {
    "summary": "drf-spectacular 是一个 Django REST Framework (DRF) 的第三方插件库，自动从 DRF 的视图类、序列化器、认证类等组件中提取信息，生成符合 OpenAPI 3.0/3.1/3.2 规范的 API 模式（schema）。它源自 DRF 内置 OpenAPI 生成器的重度改造，增加了丰富的自定义装饰器、多态响应建模、可选依赖集成、schema 校验与预/后处理钩子等生产级特性。",
    "categories": [
      {
        "name": "OpenAPI 模式生成",
        "description": "从 DRF 的 ViewSet、APIView、序列化器和路由自动推导生成完整的 OpenAPI 3 模式文档，支持 YAML/JSON 输出",
        "evidence": [
          "drf_spectacular/generators.py: SchemaGenerator",
          "drf_spectacular/openapi.py: AutoSchema",
          "drf_spectacular/plumbing.py: build_root_object"
        ]
      },
      {
        "name": "模式自定义与扩展",
        "description": "提供 @extend_schema 装饰器用于细粒度定制请求/响应体、参数、示例、操作 ID、标签等；支持 OpenApiAuthenticationExtension/OpenApiSerializerExtension 等扩展点注册机制",
        "evidence": [
          "drf_spectacular/utils.py: extend_schema, OpenApiParameter, OpenApiExample",
          "drf_spectacular/extensions.py: OpenApiAuthenticationExtension, OpenApiSerializerExtension"
        ]
      },
      {
        "name": "模式校验",
        "description": "内置基于 jsonschema 的 OpenAPI 模式合规校验，支持 OpenAPI 3.0/3.1/3.2 各版本 JSON Schema 对照验证",
        "evidence": [
          "drf_spectacular/validation/__init__.py: validate_schema",
          "drf_spectacular/validation/openapi_3_0_schema.json",
          "drf_spectacular/validation/openapi_3_1_schema.json"
        ]
      },
      {
        "name": "Schema 可视化与分发",
        "description": "提供 SpectacularAPIView 用于实时提供 API 的模式端点（content negotiation 选择 YAML/JSON），以及 SpectacularSwaggerView / SpectacularRedocView 渲染 Swagger UI 和 Redoc 交互式文档",
        "evidence": [
          "drf_spectacular/views.py: SpectacularAPIView, SpectacularSwaggerView, SpectacularRedocView",
          "drf_spectacular/renderers.py: OpenApiYamlRenderer, OpenApiJsonRenderer"
        ]
      },
      {
        "name": "多库集成支持",
        "description": "内置对 django-filter、SimpleJWT、OAuth Toolkit、django-polymorphic、Pydantic、drf-nested-routers、django-rest-framework-gis 等多个常连库的 schema 适配（通过 contrib 模块按需加载）",
        "evidence": [
          "drf_spectacular/contrib/__init__.py",
          "drf_spectacular/contrib/django_filters.py",
          "drf_spectacular/contrib/rest_framework_simplejwt.py",
          "drf_spectacular/contrib/pydantic.py"
        ]
      },
      {
        "name": "命令行与部署检查",
        "description": "提供 Django 管理命令 ./manage.py spectacular 用于 CI/CD 中离线生成模式文件；集成 Django check 框架在 deploy 时自动校验模式可生成性",
        "evidence": [
          "drf_spectacular/management/commands/spectacular.py: Command",
          "drf_spectacular/checks.py: schema_check"
        ]
      }
    ],
    "domain": "Web API 文档工具",
    "target_users": "Django REST Framework 开发者"
  },
