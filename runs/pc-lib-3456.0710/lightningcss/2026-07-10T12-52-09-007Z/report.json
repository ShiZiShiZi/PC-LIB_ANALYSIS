  "function_summary": {
    "summary": "Lightning CSS 是一个用 Rust 编写的极速 CSS 处理工具，提供 CSS 解析、属性值类型化、浏览器靶向的 CSS 转换（前缀添加/移除与语法降级）、高效压缩（合并简写、规则合并、calc 简化等）以及 CSS Bundle 依赖打包能力。它可被用作 CLI 命令行工具、Node.js (N-API) 库、或 Parcel 打包器的内置 CSS 管线，也可作为 Rust crate 嵌入到任意 Rust 项目中。",
    "domain": "web-前端构建工具",
    "target_users": "前端开发者、构建工具链开发者、Node.js/JavaScript 打包器（如 Parcel）的维护者",
    "categories": [
      {
        "name": "CSS 解析与序列化",
        "description": "提供完整的 CSS 规则、属性与值的解析与序列化，基于 Mozilla Servo 的 cssparser 与 selectors crate，实现浏览器级别（Firefox/Servo）的 CSS 语法支持。所有 CSS 属性值均按 CSS 规范类型化（非字符串 token 列表），输出标准化。",
        "evidence": [
          "Cargo.toml 依赖 cssparser、parcel_selectors",
          "src/stylesheet.rs 提供 StyleSheet 的完整 parse/minify/to_css 流程",
          "src/properties/ 下 29 个文件覆盖各 CSS 属性",
          "src/rules/ 下 24 个文件覆盖各 CSS 规则类型"
        ]
      },
      {
        "name": "CSS 压缩与优化",
        "description": "对 CSS 进行语义安全的压缩与优化，包括简写与长写双向转换、相邻规则合并、calc() 表达式化简、颜色值缩简、渐变压缩、网格模板压缩、默认子值剔除等多项微优化。",
        "evidence": [
          "src/printer.rs 实现输出序列化与压缩控制",
          "src/declaration.rs 中 DeclarationHandler 处理声明合并逻辑",
          "README.md 列出 10+ 类压缩优化项目"
        ]
      },
      {
        "name": "浏览器靶向前缀与语法降级",
        "description": "根据指定的浏览器目标列表（Browserslist 或手动列表），自动添加或移除 CSS 厂商前缀，并将较新的 CSS 语法（嵌套、逻辑属性、颜色 Level 4/5、选择器、媒体查询范围语法等）降级为兼容版本。",
        "evidence": [
          "src/vendor_prefix.rs 处理厂商前缀逻辑",
          "src/targets.rs 定义浏览器目标结构",
          "src/compat.rs (5954 行) 自动生成的前缀/兼容数据表",
          "README 明确列出 CSS Nesting、逻辑属性、Color Level 4/5、:is/:not/:dir 等降级支持"
        ]
      },
      {
        "name": "CSS Modules 支持",
        "description": "支持 CSS Modules 规范的子集，包括局部作用域的类/ID 选择器、自定义标识符、:local()/:global() 伪类以及 composes 组合属性。",
        "evidence": [
          "src/css_modules.rs 实现 CSS Modules 功能",
          "README 明确列出 CSS Modules 支持"
        ]
      },
      {
        "name": "CSS 打包",
        "description": "通过 Bundler 实现 CSS 文件的递归打包，根据 @import 依赖关系合并所有 CSS 资源到单一样式表，自动处理 @media/@supports/@layer 等条件规则的嵌套。",
        "evidence": [
          "src/bundler.rs (2244 行) 实现 Bundler 逻辑",
          "src/dependencies.rs 实现 @import 与 url() 依赖分析",
          "示例代码展示 Bundler + FileProvider 用法"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "提供 Node.js N-API 绑定作为 npm 包 lightningcss，同时保留原生 Rust crate 接口。支持 CLI 命令行工具 standalone 使用。",
        "evidence": [
          "node/ 目录含 N-API (node/napi/) 绑定实现",
          "package.json 入口点指向 node/index.js",
          "src/main.rs 提供 CLI 入口",
          "c/Cargo.toml 提供 C 绑定 (lightningcss_c_bindings)"
        ]
      },
      {
        "name": "自定义转换插件",
        "description": "通过 Visitor API 提供可扩展的自定义 CSS 变换插件机制，允许用户编写自定义规则处理器。",
        "evidence": [
          "src/visitor.rs 提供 Visitor trait",
          "derive/src/visit.rs 提供 #[derive(Visit)] 宏",
          "examples/custom_at_rule.rs 展示自定义 at-rule 处理"
        ]
      }
    ]
  },
