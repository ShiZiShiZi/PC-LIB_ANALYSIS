  "function_summary": {
    "summary": "iniparser 是一个极简的 C 语言 INI 配置文件解析库，约 1500 行代码，零外部依赖，-pedantic 标准 C 编写。提供 section/key/value 三级的字典结构解析，支持字符串、整数、浮点数、布尔类型读取，以及内存字典向 INI 文件的回写。适合嵌入式、跨平台应用或任何需要轻量配置管理的 C 项目。",
    "categories": [
      {
        "name": "INI 文件解析",
        "description": "将 INI 格式文本文件解析为内存字典结构（dictionary），支持 [Section] 分组和 key=value 键值对，自动处理注释行（# 和 ;）与空白行。",
        "evidence": [
          "src/iniparser.c:iniparser_load",
          "src/iniparser.c:iniparser_load_file",
          "src/iniparser.c:iniparser_line"
        ]
      },
      {
        "name": "配置值读取（带类型转换）",
        "description": "从解析后的字典中按 section:key 形式读取字符串、整数（十进制/八进制/十六进制）、长整数、int64、uint64、双精度浮点数和布尔值（y/n/t/f/1/0），支持引用字符串与逸出字符。",
        "evidence": [
          "src/iniparser.c:iniparser_getstring",
          "src/iniparser.c:iniparser_getint",
          "src/iniparser.c:iniparser_getboolean",
          "src/iniparser.c:iniparser_getdouble"
        ]
      },
      {
        "name": "字典操作",
        "description": "核心哈希字典（dictionary）的创建、键值查找、设置、删除、遍历和销毁，使用字符串键进行哈希查找。",
        "evidence": [
          "src/dictionary.c:dictionary_new",
          "src/dictionary.c:dictionary_get",
          "src/dictionary.c:dictionary_set",
          "src/dictionary.c:dictionary_unset",
          "src/dictionary.c:dictionary_del"
        ]
      },
      {
        "name": "INI 文件回写",
        "description": "将内存字典数据序列化回 INI 格式，支持整体回写和按节分别回写到文件指针（stdout/stderr/文件均可）。",
        "evidence": [
          "src/iniparser.c:iniparser_dump_ini",
          "src/iniparser.c:iniparser_dumpsection_ini",
          "src/iniparser.c:iniparser_dump"
        ]
      },
      {
        "name": "Section 遍历",
        "description": "获取字典中 section 数量、按索引取出 section 名称、以及获取某 section 下所有 key 的列表。",
        "evidence": [
          "src/iniparser.c:iniparser_getnsec",
          "src/iniparser.c:iniparser_getsecname",
          "src/iniparser.c:iniparser_getsecnkeys",
          "src/iniparser.c:iniparser_getseckeys"
        ]
      },
      {
        "name": "键值管理",
        "description": "运行时向字典中新增、修改、删除键值对，以及检测某键（含 section 标记）是否存在。",
        "evidence": [
          "src/iniparser.c:iniparser_set",
