  "function_summary": {
    "summary": "Html Agility Pack (HAP) 是一个 .NET 生态的 HTML 解析库，能对真实世界中残破的 HTML 文档构建可读写的 DOM 对象模型，并提供 XPath 和 XSLT 两种查询与变换接口。目标用户是需要从网页中提取结构化数据的 .NET 开发者，常用于网页抓取、内容抽取、HTML 编辑等场景。",
    "categories": [
      {
        "name": "HTML 解析与 DOM 构建",
        "description": "将 HTML 字符串、流或文件解析成以 HtmlDocument 为根的 DOM 树，对格式残缺的 HTML 容错性强。",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlDocument.cs",
          "src/HtmlAgilityPack.Shared/HtmlNode.cs"
        ]
      },
      {
        "name": "XPath 查询",
        "description": "对解析后的 DOM 树执行 XPath 表达式查询，返回匹配节点集合（HtmlNodeCollection），支持标准 XPath 语法。",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlNode.Xpath.cs",
          "src/HtmlAgilityPack.Shared/HtmlDocument.Xpath.cs"
        ]
      },
      {
        "name": "XSLT 变换",
        "description": "支持将 HTML 文档经过 XSLT 样式表变换生成新的结构或 XML/HTML 输出。",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlWeb.Xpath.cs"
        ]
      },
      {
        "name": "HTTP 网页加载",
        "description": "通过 HtmlWeb 类从 URL 直接加载网页，支持 GET/POST 方法、代理、凭据、超时和缓存控制。",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlWeb.cs"
        ]
      },
      {
        "name": "HTML 编辑与输出",
        "description": "支持对 DOM 树进行节点增删改、属性读写，并能将修改后的 DOM 序列化回 HTML 字符串。",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlDocument.cs",
          "src/HtmlAgilityPack.Shared/HtmlAttributeCollection.cs"
        ]
      },
      {
        "name": "混合文档解析",
        "description": "可解析内含 C# 代码片段的混合文档（类似 ASPX），将代码片段和 HTML 标记分离为不同节点。",
        "evidence": [
          "src/HtmlAgilityPack.Shared/MixedCodeDocument.cs"
        ]
      }
    ],
    "domain": "HTML 解析与网页抓取",
    "target_users": ".NET 开发者，尤其是网页抓取、内容抽取和 HTML 处理场景",
    "ecosystem": "dotnet"
  },
