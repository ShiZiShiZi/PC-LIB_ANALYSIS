  "function_summary": {
    "summary": "SDL_ttf 是 SDL3 生态的字体渲染库，封装 FreeType 和 HarfBuzz，将 TrueType/OpenType 字体渲染为 SDL 的各种输出目标（Surface、Renderer 纹理、GPU 纹理）。支持多字体后备链、SDF 渲染、文本排版引擎，适用于游戏 UI、字幕渲染、图形应用等需要高质量文字显示的 SDL 应用场景。",
    "categories": [
      {
        "name": "字体加载与管理",
        "description": "从文件或 SDL_IOStream 加载 TrueType/OpenType 字体，支持字体复制、后备字体链、字体样式（粗体/斜体/下划线/删除线）、字号动态调整、字距调整和 DPI 设置。",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_OpenFont, TTF_OpenFontIO, TTF_OpenFontWithProperties, TTF_CopyFont, TTF_AddFallbackFont, TTF_SetFontStyle, TTF_SetFontSize, TTF_SetFontSizeDPI, TTF_SetFontKerning, TTF_SetFontCharSpacing)",
          "src/SDL_ttf.c"
        ]
      },
      {
        "name": "字形查询与度量",
        "description": "查询字体是否包含指定 Unicode 码点的字形、获取字形度量（宽高、偏移、间距）、字形图像（SDL_Surface 格式），支持 SDF（有符号距离场）渲染。",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_FontHasGlyph, TTF_GetGlyphMetrics, TTF_GetGlyphImage, TTF_GetGlyphImageForIndex)",
          "src/SDL_ttf.c"
        ]
      },
      {
        "name": "文本渲染到 Surface",
        "description": "将 UTF-8 文本渲染到 SDL_Surface，支持 Solid（8 位快速）、Shaded（带背景）、Blended（高质量抗锯齿）、LCD（子像素渲染）四种模式，支持自动换行。",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_RenderText_Solid, TTF_RenderText_Shaded, TTF_RenderText_Blended, TTF_RenderText_LCD, TTF_RenderText_Solid_Wrapped 等)",
          "src/SDL_ttf.c"
        ]
      },
      {
        "name": "文本引擎架构",
        "description": "提供可扩展的文本排版引擎（TTF_TextEngine），内置 Surface、Renderer、GPU 三种引擎实现，支持文本对象生命周期管理、排版更新、绘制到对应输出目标。第三方可实现自定义引擎。",
        "evidence": [
          "include/SDL3_ttf/SDL_textengine.h",
          "src/SDL_surface_textengine.c",
          "src/SDL_renderer_textengine.c",
          "src/SDL_gpu_textengine.c",
          "src/SDL_gl_textengine.c"
        ]
      },
      {
        "name": "文本排版与方向",
        "description": "支持文本方向设置（LTR/RTL/TTB/BTT，需 HarfBuzz）、脚本选择、BCP47 语言标签控制，用于复杂文本 shaping。",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_SetFontDirection, TTF_SetFontScript, TTF_SetFontLanguage)",
          "src/SDL_ttf.c"
        ]
      }
    ],
    "domain": "图形渲染/字体渲染",
    "target_users": "SDL3 应用与游戏开发者，尤其是需要在 SDL 程序中渲染高质量文本的 C/C++ 开发者",
    "ecosystem": "cpp"
  },
