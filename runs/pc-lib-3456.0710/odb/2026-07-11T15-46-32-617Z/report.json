  "function_summary": {
    "summary": "ODB 是一个跨平台、跨数据库的 C++ 对象关系映射（ORM）系统。它能让开发者将 C++ 类持久化到关系型数据库中，无需手动编写 SQL 语句或映射代码。ODB 支持 MySQL、SQLite、PostgreSQL、Oracle 和 Microsoft SQL Server 五种数据库，并提供可选的 Boost 和 Qt 框架集成配置（profile），允许无缝使用这些框架中的值类型、容器和智能指针。ODB 的核心是一个基于 GCC 插件的编译器，在编译期解析 C++ 头文件并自动生成数据库持久化代码。",
    "categories": [
      {
        "name": "ORM 核心引擎",
        "description": "提供 C++ 对象到关系数据库的自动映射，包括对象持久化、查询、更新、删除，支持继承、复合值类型、对象关系（双向/惰性加载）、数据库模式演进与迁移。",
        "evidence": [
          "libodb/odb/database.hxx",
          "libodb/odb/traits.hxx",
          "libodb/odb/query.hxx",
          "libodb/odb/schema-catalog.hxx"
        ]
      },
      {
        "name": "ODB 编译器（代码生成）",
        "description": "基于 GCC 插件的编译期工具，解析 C++ 头文件中的 #pragma db 标注，自动生成数据库持久化代码（-odb.hxx/-odb.cxx），支持 ODB 特有的查询语言和模式生成。",
        "evidence": [
          "odb/odb/plugin.cxx",
          "odb/odb/generator.cxx",
          "odb/odb/pragma.hxx",
          "odb/odb/processor.cxx"
        ]
      },
      {
        "name": "SQLite 数据库后端",
        "description": "为 SQLite 提供运行时支持，包括连接管理、语句执行、模式生成，支持共享缓存和增量 BLOB/TEXT I/O。",
        "evidence": [
          "libodb-sqlite/odb/sqlite/database.hxx",
          "libodb-sqlite/odb/sqlite/connection.hxx",
          "libodb-sqlite/odb/sqlite/statement.hxx"
        ]
      },
      {
        "name": "PostgreSQL 数据库后端",
        "description": "为 PostgreSQL 提供运行时支持，包括连接池、批量操作（pipeline 模式）、存储过程和函数调用。",
        "evidence": [
          "libodb-pgsql/odb/pgsql/database.hxx",
          "libodb-pgsql/odb/pgsql/connection.hxx"
        ]
      },
      {
        "name": "MySQL 数据库后端",
        "description": "为 MySQL 和 MariaDB 提供运行时支持，包括连接池与存储过程调用。",
        "evidence": [
          "libodb-mysql/odb/mysql/database.hxx",
          "libodb-mysql/odb/mysql/connection.hxx"
        ]
      },
      {
        "name": "Oracle / SQL Server 数据库后端",
        "description": "为 Oracle 和 Microsoft SQL Server 提供运行时支持（使用专有客户端库，非开源许可）。",
        "evidence": [
          "libodb-oracle/odb/oracle/database.hxx",
          "libodb-mssql/odb/mssql/database.hxx"
        ]
      },
      {
        "name": "Boost / Qt 框架集成",
        "description": "可选的 Boost 和 Qt profile，使 ODB 支持 Boost 和 Qt 库中的常用类型、容器和智能指针（如 shared_ptr、QString、QList 等）。",
        "evidence": [
          "libodb-boost/odb/boost/",
          "libodb-qt/odb/qt/"
        ]
      }
    ],
    "domain": "数据库/ORM",
    "target_users": "C++ 应用开发者，需要将 C++ 对象模型持久化到关系数据库的中大型项目",
    "ecosystem": "cpp"
  },
