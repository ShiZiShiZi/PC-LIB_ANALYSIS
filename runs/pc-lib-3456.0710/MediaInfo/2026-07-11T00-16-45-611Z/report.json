  "function_summary": {
    "summary": "MediaInfo 是一个跨平台的音视频文件技术元数据读取工具，支持解析媒体文件的格式、编码参数、时长、比特率、流信息等详细技术数据。项目包含 CLI 命令行工具以及基于 VCL、Qt、wxWidgets、Cocoa 等多个 GUI 框架的桌面客户端（覆盖 Windows/Linux/macOS/Android/iOS/Universal Windows）。核心解析能力由独立的 MediaInfoLib 库提供，本仓库则为该库构建面向最终用户的命令行与图形界面入口。",
    "categories": [
      {
        "name": "媒体元数据解析",
        "description": "读取音频、视频、容器文件的格式、编码、码率、分辨率、流信息等详细技术参数，支持数百种格式。",
        "evidence": [
          "Source/CLI/CLI_Main.cpp",
          "Source/Common/Core.cpp:46",
          "README.md:3"
        ]
      },
      {
        "name": "多平台 GUI 桌面应用",
        "description": "提供基于 VCL（仅 Windows）、Qt 5/6、wxWidgets、Cocoa（macOS）的图形化桌面界面，允许用户交互式浏览媒体文件元数据。",
        "evidence": [
          "Source/GUI/Qt/mainwindow.cpp",
          "Source/GUI/VCL/GUI_Main.cpp",
          "Source/GUI/WxWidgets/GUI_Main.cpp",
          "Source/GUI/Cocoa/main.m"
        ]
      },
      {
        "name": "命令行接口",
        "description": "提供 CLI 工具用于脚本化或批量分析媒体文件，输出文本、XML、JSON、CSV 等多种格式。",
        "evidence": [
          "Source/CLI/CLI_Main.cpp:100",
          "Source/CLI/CommandLine_Parser.cpp:52"
        ]
      },
      {
        "name": "多格式输出",
        "description": "支持文本、HTML、XML、JSON、CSV、MPEG-7、PBCore、EBUCore、FIMS、NISO 等多种元数据输出格式，适用于不同行业标准。",
        "evidence": [
          "Source/Common/Core.h:88",
          "Source/CLI/CommandLine_Parser.cpp"
        ]
      }
    ],
    "domain": "多媒体元数据读取",
    "target_users": "终端用户（通过桌面 GUI 浏览媒体文件信息）、系统管理员（通过 CLI 脚本化批量分析）、媒体行业从业者（通过标准化元数据输出接口）"
  },
