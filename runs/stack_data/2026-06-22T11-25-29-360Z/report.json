  "function_summary": {
    "summary": "stack_data 是一个 Python 调试工具库，用于从堆栈帧（stack frame）和回溯（traceback）中提取结构化数据，生成比默认 traceback 更丰富的错误信息展示。它通过 AST 分析将源码切分为语义片段（piece），安全地求值帧中的变量表达式，并支持文本、HTML、JSON 等多种输出格式，是 IPython 与 futurecoder 等项目的 traceback 展示底层依赖。",
    "categories": [
      {
        "name": "帧与回溯解析",
        "description": "封装 FrameInfo、Source 等类型，从 frame 或 traceback 对象中提取代码对象、行号、文件名、执行节点等元数据，并遍历完整调用栈。",
        "evidence": [
          "stack_data/core.py:511 FrameInfo",
          "stack_data/core.py:82 Source",
          "stack_data/utils.py:94 iter_stack",
          "stack_data/utils.py:104 frame_and_lineno"
        ]
      },
      {
        "name": "源代码片段与上下文",
        "description": "将源码按 AST 语义切分为 piece，结合 Options 配置生成包含当前行、上下文、函数签名、行间隔（LINE_GAP）和空行处理的 Line 列表。",
        "evidence": [
          "stack_data/core.py:95 Source.pieces",
          "stack_data/core.py:719 FrameInfo.lines",
          "stack_data/core.py:181 Options",
          "stack_data/core.py:230 LINE_GAP"
        ]
      },
      {
        "name": "变量安全求值",
        "description": "借助 pure_eval 在无副作用前提下，对当前作用域中的变量和表达式进行安全求值，生成 Variable 对象及其源码范围。",
        "evidence": [
          "stack_data/core.py:830 FrameInfo.variables",
          "stack_data/core.py:65 Variable",
          "stack_data/core.py:18 from pure_eval import Evaluator, is_expression_interesting"
        ]
      },
      {
        "name": "格式化输出",
        "description": "提供 Formatter 类将堆栈信息格式化为类 Python 默认 traceback 的文本输出，支持行号、当前行标记、执行节点下划线、变量列表与 HTML 转义。",
        "evidence": [
          "stack_data/formatting.py:12 Formatter",
          "stack_data/formatting.py:98 format_exception",
          "stack_data/formatting.py:115 format_stack",
          "stack_data/formatting.py:220 format_variables"
        ]
      },
      {
        "name": "序列化输出",
        "description": "提供 Serializer 类将堆栈与异常信息输出为 JSON 可序列化的 dict 结构，便于 Web 前端或日志系统消费。",
        "evidence": [
          "stack_data/serializing.py:23 Serializer",
          "stack_data/serializing.py:74 format_exception",
          "stack_data/serializing.py:101 format_stack"
        ]
      },
      {
        "name": "语法高亮集成",
