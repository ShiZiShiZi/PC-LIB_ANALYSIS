          "src/graphui/classes/com/jogamp/graph/ui/Scene.java",
          "src/graphui/classes/com/jogamp/graph/ui/widgets/MediaPlayer.java"
        ]
      },
      {
        "name": "NativeWindow 抽象层",
        "description": "平台无关的原生窗口抽象接口，封装 AWT、SWT、NEWT 等不同窗口工具包，提供统一的 NativeSurface/ScalableSurface 接口与 DPI 感知。",
        "evidence": [
          "src/nativewindow/classes/com/jogamp/nativewindow/NativeWindow.java",
