  "function_summary": {
    "summary": "distfit 是一个用于随机变量概率密度拟合的 Python 库：给定经验数据 X，它能在 90+ 种理论分布中找出最佳拟合并返回 loc/scale/arg 参数。支持参数化、非参数化（分位数/百分位）、离散（二项）与基于 copula 的多变量分布拟合，并提供概率预测、显著性检验、异常值检测、合成数据生成和 PDF/CDF/QQ 图等可视化。面向数据科学与统计研究场景，作为被 import 调用的库使用。",
    "categories": [
      {
        "name": "参数化分布拟合",
        "description": "在 89~90+ 种理论分布上对经验数据拟合，用 RSS/SSE、Wasserstein、Kolmogorov-Smirnov、Energy 等拟合优度统计量评分选出最佳分布并返回参数。",
        "evidence": [
          "distfit/distfit.py:386 (fit_transform)",
          "distfit/distfit.py:273 (fit)",
          "distfit/distfit.py:299 (transform)",
          "README.md:51"
        ]
      },
      {
        "name": "非参数化拟合",
        "description": "提供分位数(quantile)与百分位(percentile)两种非参数方法，不假设数据服从特定分布，直接对数据的分位数/百分位建模。",
        "evidence": [
          "distfit/distfit.py (method='quantile'/'percentile')",
          "distfit/__init__.py:37",
          "README.md:56"
        ]
      },
      {
        "name": "离散分布拟合",
        "description": "对取离散值的数据用二项分布拟合（BinomPMF + curve_fit 估计 n、p），输出 SSE 与卡方统计量。",
        "evidence": [
          "distfit/distfit.py:2874 (class BinomPMF)",
          "distfit/distfit.py:2957 (curve_fit)",
          "distfit/distfit.py:2978",
          "README.md:224"
        ]
      },
      {
        "name": "多变量分布拟合",
        "description": "Multidistfit 基于 copula（Gaussian/t copula）对多列数据建模变量间依赖，输出相关矩阵与联合密度。",
        "evidence": [
          "distfit/multidistfit.py:14 (class Multidistfit)",
          "distfit/multidistfit.py:31 (fit_transform)",
          "distfit/multidistfit.py:44 (fit_marginals)",
          "README.md:124"
        ]
      },
      {
        "name": "概率预测与显著性检验",
        "description": "对已拟合分布计算响应变量 y 的概率/显著性，含多重检验校正（如 fdr_bh），用于假设检验与推断。",
        "evidence": [
          "distfit/distfit.py:512 (predict)",
          "distfit/distfit.py:2807 (multitest.multipletests)",
          "README.md:33"
        ]
      },
      {
        "name": "异常值检测",
        "description": "基于拟合分布/联合密度对样本打异常分，predict_outliers 标记落在低概率区域的离群点。",
        "evidence": [
          "distfit/distfit.py:755 (predict_outliers)",
          "distfit/multidistfit.py:119 (predict_outliers)",
          "README.md:34"
        ]
      },
      {
        "name": "合成数据生成",
        "description": "按已拟合的（单/多变量）分布随机采样，生成指定数量的合成样本。",
        "evidence": [
          "distfit/distfit.py:610 (generate)",
          "distfit/multidistfit.py:74 (generate)",
          "README.md:35"
        ]
      },
      {
        "name": "分布可视化",
        "description": "提供 PDF/CDF 曲线、QQ 图、拟合汇总图等基于 matplotlib 的绘图，并可将模型保存/加载（pypickle）。",
        "evidence": [
          "distfit/distfit.py:775 (plot)",
          "distfit/distfit.py:994 (qqplot)",
          "distfit/distfit.py:1495 (plot_summary)",
          "distfit/distfit.py:1707 (save)"
        ]
      }
    ],
    "domain": "数据科学 / 概率统计 / 机器学习（分布拟合与密度估计）",
    "target_users": "Python 数据科学家、统计/机器学习研究者与工程师（以库形式被 import 调用）"
  },
