  "function_summary": {
    "summary": "distfit 是一个用于概率密度拟合的 Python 库，面向数据科学家和统计分析师。它对输入的单变量随机样本进行拟合，从 89 种以上理论分布（连续/离散）中自动确定最佳匹配分布，支持参数化拟合、非参数化分位数/百分位数拟合和离散二项拟合四种模式，并返回最佳分布的参数（loc/scale/arg）与置信区间。同时提供预测概率、异常值检测、合成数据生成和可视化绘图功能。",
    "categories": [
      {
        "name": "概率分布拟合",
        "description": "对单变量经验数据 X 自动拟合最佳理论分布（含 89+ 分布），支持 RSS/SSE、Wasserstein、KS、Energy 等评分统计量，返回最佳分布参数（loc/scale/arg）。",
        "evidence": [
          "distfit/distfit.py:286-296",
          "distfit/distfit.py:299-383"
        ]
      },
      {
        "name": "非参数化拟合",
        "description": "提供基于分位数和百分位数的非参数化分布拟合模式，不假设数据服从特定概率分布，直接对数据的经验分位数/百分位数建模。",
        "evidence": [
          "distfit/distfit.py:373-381"
        ]
      },
      {
        "name": "离散型分布拟合",
        "description": "针对离散值数据集，使用二项分布进行离散拟合，并支持加权选项控制拟合质量。",
        "evidence": [
          "distfit/distfit.py:365-372",
          "distfit/distfit.py:3004-3021"
        ]
      },
      {
        "name": "预测与异常值检测",
        "description": "基于拟合分布对新样本 y 进行概率预测，计算 P 值；支持基于拟合分布的异常值检测，标记偏离理论分布的异常点。",
        "evidence": [
          "distfit/distfit.py:512-608",
          "distfit/distfit.py:755-773"
        ]
      },
      {
        "name": "合成数据生成",
        "description": "从拟合的理论分布中生成合成随机样本，用于模拟和蒙特卡洛分析。",
        "evidence": [
          "distfit/distfit.py:610-753"
        ]
      },
      {
        "name": "可视化",
        "description": "提供丰富的绘图功能：PDF/CDF 曲线叠加、QQ 图、协变量联合密度图(Copula)、联合分布密度图等，帮助直观评估拟合效果。",
        "evidence": [
          "distfit/distfit.py:775-891",
          "distfit/distfit.py:951-1335",
          "distfit/distfit.py:1629-1705"
        ]
      },
      {
        "name": "模型持久化",
        "description": "支持将拟合模型保存到文件并从文件加载，便于模型复用和部署。",
        "evidence": [
          "distfit/distfit.py:1707-1804"
        ]
      }
    ],
    "domain": "统计分析/概率拟合",
    "target_users": "数据科学家、统计分析师、机器学习工程师",
    "ecosystem": "python"
  },
