    "one_liner": "用于单变量/多变量概率密度拟合、预测、异常检测与可视化的 Python 库",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "distfit 是一个面向单变量与多变量数据的概率密度拟合 Python 库。它支持参数化方法（对多达 89 种理论分布进行拟合并用 RSS/SSE、Wasserstein、Kolmogorov-Smirnov、Energy 等统计量评分）、非参数化方法（分位数/百分位）、离散分布（二项分布）拟合，以及基于 copula 的多变量联合分布建模。库还提供概率预测、置信区间计算、异常检测、合成数据生成和丰富的可视化（PDF/CDF/QQ 图、汇总图、联合密度图）。",
    "categories": [
      {
        "name": "参数化分布拟合",
        "description": "对经验数据自动或指定地拟合大量理论分布，返回最优分布名称、评分、loc/scale/args 参数",
        "evidence": [
          "distfit/distfit.py:286-287",
          "distfit/distfit.py:35-38"
        ]
      },
      {
        "name": "非参数化分布拟合",
        "description": "使用分位数或百分位方法对不假设特定分布形态的数据进行建模",
        "evidence": [
          "distfit/distfit.py:291-294",
          "distfit/distfit.py:40-42"
        ]
      },
      {
        "name": "离散分布拟合",
        "description": "针对离散值数据使用二项分布进行参数估计与拟合",
        "evidence": [
          "distfit/distfit.py:288-289",
          "distfit/distfit.py:44-45"
        ]
      },
      {
        "name": "多变量分布拟合",
        "description": "基于高斯 copula 对每个特征拟合边缘分布，估计相关性矩阵并计算联合密度",
        "evidence": [
          "distfit/multidistfit.py:31-42",
          "distfit/distfit.py:459"
        ]
      },
      {
        "name": "预测与推断",
        "description": "基于拟合模型计算响应变量的概率、P 值、置信区间与显著性",
        "evidence": [
          "distfit/distfit.py:65",
          "distfit/distfit.py:586"
        ]
      },
      {
        "name": "异常检测与合成数据",
        "description": "利用拟合分布的上/下界检测异常值，并按最优分布生成合成样本",
        "evidence": [
          "distfit/distfit.py:34",
          "distfit/distfit.py:1203"
        ]
      },
      {
        "name": "数据可视化",
        "description": "绘制 PDF/CDF/QQ 图、拟合分布汇总图以及多变量联合密度 pairplot",
        "evidence": [
