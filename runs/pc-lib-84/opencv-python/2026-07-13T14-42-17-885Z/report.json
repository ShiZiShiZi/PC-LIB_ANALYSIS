  "function_summary": {
    "summary": "opencv-python 是 OpenCV 计算机视觉库的 Python 包装包，提供通过 pip 安装的预编译 wheel（CPU-only）。包内含静态编译的 OpenCV C++ 二进制文件与 Python 绑定（cv2 模块），用户 `pip install opencv-python` 后即可 `import cv2` 使用完整的 OpenCV Python API。发行版还包括 Haar 级联分类器数据文件。可选变体有：含 contrib 额外模块的 opencv-contrib-python，以及去 GUI 依赖的 headless 版本（适合服务器/容器环境）。",
    "categories": [
      {
        "name": "OpenCV Python 绑定分发",
        "description": "将上游 OpenCV C++ 库编译为静态库，通过 scikit-build + CMake 构建出 Python wheel，封装为 cv2 模块供 Python 调用",
        "evidence": [
          "setup.py:10-13",
          "pyproject.toml:1-15"
        ]
      },
      {
        "name": "多平台预编译 Wheel",
        "description": "为 Windows、macOS、Linux 三平台提供预编译二进制 wheel（manylinux2014 / musllinux），无需本地编译 OpenCV 即可通过 pip 安装",
        "evidence": [
          "setup.py:157-201",
          "docker/manylinux2014/Dockerfile_x86_64:1-164"
        ]
      },
      {
        "name": "变体构建支持",
        "description": "提供四个包变体的构建：标准版、contrib 版（含额外模块）、headless 版（无 GUI 依赖）、以及组合变体，通过环境变量 ENABLE_CONTRIB/ENABLE_HEADLESS 控制",
        "evidence": [
          "setup.py:20-23",
          "setup.py:76-88",
          "setup.py:210-222"
        ]
      },
      {
        "name": "Haar 级联数据分发",
        "description": "将 OpenCV 的 Haar 级联分类器 XML 文件打包进 wheel，可通过 cv2.data.haarcascades 访问",
        "evidence": [
          "setup.py:100",
          "setup.py:133-135"
        ]
      }
    ],
    "domain": "计算机视觉",
    "target_users": "Python 开发者和数据科学家，需要计算机视觉能力但不愿从源码编译 OpenCV",
    "ecosystem": "python"
  },
