    "commit": "50a75711f0b8aa9431ef64a91a9d71fd8a5ddf1c",
    "one_liner": "GPU 加速视频/图像渲染库，提供 HDR 色调映射、色彩管理、缩放与后处理着色器，支持 Vulkan/OpenGL/D3D11 后端",
    "ecosystem": "cpp",
    "bindings": []
  },
  "function_summary": {
    "summary": "libplacebo 是从 mpv 播放器核心渲染算法提取而成的独立 GPU 加速视频/图像处理库。它提供高质量的缩放（含极性滤波器）、动态 HDR 色调映射、Dolby Vision 支持、色彩管理（含 ICC 配置文件和 3DLUT）、胶片颗粒合成、去色带、去隔行、抖动等完整渲染管线，并通过统一的 GPU 抽象层封装了 Vulkan、OpenGL 和 Direct3D 11 三个图形后端，使上层应用可无视后端差异调用 pl_render_image 等高级 API 完成全流程渲染。",
    "categories": [
      {
        "name": "GPU 渲染管线",
        "description": "高层渲染器（pl_renderer）将源帧完整处理到目标帧，涵盖缩放、色调映射、色彩空间转换、去色带、去隔行、胶片颗粒、叠加层等全流程",
        "evidence": [
          "src/renderer.c",
          "src/include/libplacebo/renderer.h"
        ]
      },
      {
        "name": "GPU 抽象层",
        "description": "跨后端统一 GPU API：纹理/缓冲区管理、着色器编译与分发、描述符集、管线缓存、同步原语；分别由 Vulkan/OpenGL/D3D11 后端实现",
        "evidence": [
          "src/gpu.c",
          "src/include/libplacebo/gpu.h",
          "src/vulkan/gpu.c",
          "src/opengl/gpu.c",
          "src/d3d11/gpu.c"
        ]
      },
      {
        "name": "着色器库",
        "description": "GLSL 着色器集合：采样/缩放、色彩空间转换、色调映射、色域映射、ICC 配置文件处理、3DLUT、胶片颗粒、去色带、去隔行、抖动、误差扩散",
        "evidence": [
          "src/shaders/sampling.c",
          "src/shaders/colorspace.c",
          "src/shaders/tone_mapping.c",
          "src/shaders/dithering.c",
          "src/shaders/icc.c",
          "src/shaders/film_grain.c",
          "src/shaders/deinterlacing.c"
        ]
      },
      {
        "name": "色彩科学与色调映射",
        "description": "完整的色彩管理引擎：色彩原色/传输特性/矩阵转换、HDR 色调映射（含场景直方图检测与动态曝光控制）、Dolby Vision RPU 解析与重塑、色域映射（含感知映射与软裁剪）、黑点自适应",
        "evidence": [
          "src/colorspace.c",
          "src/tone_mapping.c",
          "src/gamut_mapping.c",
          "src/utils/dolbyvision.c",
          "src/shaders/icc.c"
        ]
      },
      {
        "name": "图形后端实现",
        "description": "Vulkan（主要后端，含内存分配器、命令池、swapchain）、OpenGL（含 GL/EGL loader 生成）、Direct3D 11（含 SPIRV-Cross HLSL 转换、DXGI swapchain）",
        "evidence": [
          "src/vulkan/context.c",
          "src/opengl/context.c",
          "src/d3d11/context.c"
        ]
      },
      {
        "name": "帧队列与工具",
        "description": "异步帧队列（pl_queue）用于解码器与渲染器解耦，支持插值与漂移补偿；AVFrame/Dav1dPicture 互操作辅助",
        "evidence": [
          "src/utils/frame_queue.c",
          "src/include/libplacebo/utils/frame_queue.h",
          "src/include/libplacebo/utils/libav.h",
          "src/utils/upload.c"
        ]
      }
    ],
    "domain": "图形渲染/视频处理",
    "target_users": "媒体播放器开发者（mpv/VLC）、视频处理框架（FFmpeg 滤镜）、GPU 渲染引擎集成者"
