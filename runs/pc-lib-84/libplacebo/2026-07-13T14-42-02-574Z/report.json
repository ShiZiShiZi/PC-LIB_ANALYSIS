  "function_summary": {
    "summary": "libplacebo 是 mpv 播放器核心渲染算法的独立库化产物，提供一套高质量、高性能的 GPU 加速视频/图像后处理管线。它通过统一的抽象层（pl_gpu）封装 Vulkan、OpenGL、Direct3D 11 三种图形 API，向上暴露三个层次的接口：低层 GPU 抽象（pl_gpu）、着色器生成层（pl_shader/pl_dispatch）、高层渲染器（pl_renderer），使调用方可以按需使用完整管线或仅取用部分着色器模块。功能涵盖高品质缩放（Jinc/polar 等）、HDR 色调映射（含实时场景分析）、色彩管理（ICC/LUT/ITU-R BT.1886）、Dolby Vision（Profile 5 等）、AV1/H.274 胶片颗粒合成、去色带、去交错、误差扩散抖色等。核心实现为 C，构建系统为 Meson。已被 VLC、FFmpeg 集成。",
    "categories": [
      {
        "name": "GPU 渲染抽象",
        "description": "提供统一的 GPU 对象与状态抽象（pl_gpu），同时封装 Vulkan、OpenGL、Direct3D 11 三种后端，对外隐藏同步、资源绑定等细节",
        "keywords": [
          "gpu",
          "vulkan",
          "opengl",
          "direct3d",
          "rendering",
          "abstraction"
        ]
      },
      {
        "name": "着色器管线生成",
        "description": "支持动态生成 GLSL 着色器并通过 pl_shader/pl_dispatch 编译执行，包含完整的着色器缓存（基于 Bloatster）与资源池化",
        "keywords": [
          "shader",
          "glsl",
          "spirv",
          "shaderc",
          "glslang"
        ]
      },
      {
        "name": "图像缩放与插值",
        "description": "内置多种高质量重建滤波核（Jinc、Lanczos、Mitchell 等），支持 gamma 校正缩放、抗锯齿、抗振铃",
        "keywords": [
          "scaling",
          "upscaling",
          "downscaling",
          "jinc",
          "lanczos",
          "filter"
        ]
      },
      {
        "name": "HDR 色调映射",
        "description": "动态 HDR→SDR 或 HDR→HDR 色调映射，支持实时直方图分析、场景切换检测、曝光控制、感知色域拉伸、对比度恢复",
        "keywords": [
          "hdr",
          "tone-mapping",
          "histogram",
          "bt.2390"
        ]
      },
      {
        "name": "色彩管理",
        "description": "色度学精确的色彩管线，支持 ICC 配置文件、3DLUT (cube)、ITU-R BT.1886 gamma、黑点补偿、软色域映射",
        "keywords": [
          "color-management",
          "icc",
          "3dlut",
          "color-space",
          "gamut"
        ]
      },
      {
        "name": "Dolby Vision 处理",
        "description": "原生支持 Dolby Vision 元数据解析与着色映射（Profile 5→HDR/PQ/SDR），含 DV side data 读取与重塑",
        "keywords": [
          "dolby-vision",
          "dovi",
          "profile-5",
          "reshaping"
        ]
      },
      {
        "name": "胶片颗粒合成",
        "description": "高性能 AV1（H.274）胶片颗粒 GPU 合成，使播放器可将此环节从 CPU 卸载到 GPU",
        "keywords": [
          "film-grain",
          "av1",
          "h.274"
        ]
      },
      {
        "name": "后处理算法",
        "description": "可调的去色带（debanding）、去交错（deinterlacing/yadif）、gamma 校正误差扩散抖色（dithering）",
        "keywords": [
          "debanding",
          "deinterlacing",
          "dithering",
          "yadif"
        ]
      },
      {
        "name": "自定义着色器系统",
        "description": "可插拔扩展着色器框架，支持用户注入自定义 GLSL 片段或 mpv .hook 格式的着色器（如 RAVU、FSRCNNX、Anime4K）",
        "keywords": [
          "custom-shader",
          "hook",
          "mpv"
        ]
      },
      {
        "name": "帧队列与上传",
        "description": "高层帧队列（pl_queue）处理时间戳帧插值，辅助工具完成通用图像上传（pl_upload）与 dav1d/FFmpeg 互操作",
        "keywords": [
          "frame-queue",
          "upload",
          "dav1d",
          "ffmpeg",
          "interop"
        ]
      }
    ],
