  "function_summary": {
    "summary": "GoAccess 是一个开源的实时 Web 日志分析器和交互式查看器，在终端或浏览器中运行。它能够实时解析 Apache/Nginx/CloudFront 等多种 Web 服务器日志格式，以 ncurses 终端界面或 HTML 仪表盘呈现访客统计、带宽、响应时间、状态码等关键指标。核心特性包括增量日志处理与磁盘持久化、内置 WebSocket 服务器实现浏览器实时推送、多线程并行解析、GeoIP 地理位置查询、DNS 反向解析、CSV/JSON 输出等。",
    "categories": [
      {
        "name": "日志解析与格式识别",
        "description": "支持 Apache、Nginx、Amazon S3/CloudFront、Caddy、IIS W3C、Squid 等几乎所有主流 Web 日志格式，并提供自定义格式字符串能力",
        "evidence": [
          "src/parser.c",
          "src/settings.c:verify_formats"
        ]
      },
      {
        "name": "终端 TUI 仪表盘",
        "description": "基于 ncurses 的全屏终端界面，支持多面板（访客/请求/状态码/带宽/OS/浏览器等）、键盘导航、实时滚动与搜索",
        "evidence": [
          "src/ui.c",
          "src/goaccess.c:get_keys",
          "src/gdashboard.c",
          "src/dialogs.c"
        ]
      },
      {
        "name": "HTML 实时仪表盘",
        "description": "生成含 D3.js 图表的 HTML 报告，通过内置 WebSocket 服务器实现浏览器端实时数据推送，支持 JWT 认证",
        "evidence": [
          "src/output.c:output_html",
          "src/websocket.c",
          "src/gwsocket.c",
          "src/gchart.c",
          "resources/js/charts.js"
        ]
      },
      {
        "name": "数据持久化与增量处理",
        "description": "将解析数据序列化到磁盘（基于 tpl 二进制格式），支持增量加载历史数据继续处理，适用于大日志或长期监控场景",
        "evidence": [
          "src/persistence.c",
          "src/tpl.c"
        ]
      },
      {
        "name": "网络与 WebSocket 服务器",
        "description": "内置 RFC 6455 合规的 WebSocket 服务器，支持 TCP/Unix 域套接字、TLS (OpenSSL)、管道通信、自管 trick 实现信号安全",
        "evidence": [
          "src/websocket.c",
          "src/gwsocket.c"
        ]
      },
      {
        "name": "地理定位与 ASN 查询",
        "description": "可选集成 GeoIP Legacy 或 MaxMindDB (GeoIP2)，提供 IP 到国家/城市/ASN 的映射",
        "evidence": [
          "src/geoip1.c",
          "src/geoip2.c",
          "src/geoip1.h"
        ]
      },
      {
        "name": "DNS 反向解析",
        "description": "后台线程池异步执行 IP 反向 DNS 查询，结果缓存到哈希表",
        "evidence": [
          "src/gdns.c"
        ]
      }
    ],
    "domain": "日志分析 / 网络监控",
    "target_users": "系统管理员、DevOps 工程师、安全分析师"
  },
