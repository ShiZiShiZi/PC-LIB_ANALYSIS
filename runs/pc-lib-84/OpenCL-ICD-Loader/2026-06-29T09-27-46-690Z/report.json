  "function_summary": {
    "summary": "OpenCL ICD Loader 是 Khronos Group 官方维护的 OpenCL 安装式客户端驱动（ICD）加载器库。它导出 OpenCL API 入口点，在运行时枚举系统中已安装的各厂商 OpenCL 驱动（ICD），并将应用程序的 OpenCL API 调用转发到正确的驱动实现。该库本身不包含任何 OpenCL 实现，仅作为应用程序与多个厂商驱动之间的调度层。同时支持实验性的 OpenCL 层（Layer）机制，允许在应用和驱动之间插入调试/追踪层。",
    "categories": [
      {
        "name": "ICD 枚举与加载",
        "description": "在运行时发现并加载系统中已安装的 OpenCL 厂商驱动（ICD），Linux 通过扫描 /etc/OpenCL/vendors/*.icd 文件，Windows 通过注册表、DXGK、HKR 和 AppPackage 枚举",
        "evidence": [
          "loader/icd.c:70-331",
          "loader/linux/icd_linux.c:218-231",
          "loader/windows/icd_windows.c:186-406"
        ]
      },
      {
        "name": "API 调度与转发",
        "description": "导出全部 OpenCL API 入口点，将调用分派到正确的厂商驱动实现；支持 cl_khr_icd2 加载器管理调度和扩展函数地址查询",
        "evidence": [
          "loader/icd_dispatch.c:151-227",
          "loader/icd_dispatch_generated.c",
          "loader/icd_dispatch.h"
        ]
      },
      {
        "name": "层（Layer）支持",
        "description": "实验性功能：支持在应用和驱动之间插入层，用于调试、追踪和性能分析；通过 OPENCL_LAYERS 环境变量或注册表配置",
        "evidence": [
          "loader/icd.c:334-497",
          "loader/icd.c:541-560",
          "loader/cllayerinfo.c"
        ]
      },
      {
        "name": "平台适配",
        "description": "针对不同操作系统提供不同的 ICD 发现机制：Linux 使用文件系统扫描 + dlopen，Windows 使用注册表 + LoadLibraryEx + DXGK/DXGI 枚举",
        "evidence": [
          "loader/linux/icd_linux.c",
          "loader/windows/icd_windows.c",
          "loader/icd_platform.h"
        ]
      },
      {
        "name": "OpenGL/D3D 互操作支持",
        "description": "支持 OpenCL 与 OpenGL、Direct3D 的缓冲区/纹理共享扩展（cl_khr_gl_sharing、cl_khr_d3d10_sharing、cl_khr_d3d11_sharing 等）",
        "evidence": [
          "loader/icd_dispatch.c:85-121",
          "loader/icd_dispatch.c:129-134"
        ]
      }
    ],
    "domain": "GPU 并行计算 / 图形驱动中间件",
    "target_users": "需要使用 OpenCL 进行 GPU 通用计算的应用开发者，以及 OpenCL 驱动厂商（需配合此加载器注册其 ICD）"
  },
