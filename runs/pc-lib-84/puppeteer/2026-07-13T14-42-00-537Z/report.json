  "function_summary": {
    "summary": "Puppeteer 是一个 Node.js 浏览器自动化库，提供高级 API 通过 Chrome DevTools Protocol（CDP）或 WebDriver BiDi 协议远程控制浏览器。核心功能包括：页面导航与交互、元素定位与操作、DOM 查询、网络拦截与模拟、JavaScript 执行、截图与 PDF 生成、浏览器 Cookie 与会话管理、性能追踪与分析、设备模拟、蓝牙设备模拟等。适用于自动化测试、网页抓取、性能监控、自动表单填写、PDF 生成等场景。",
    "categories": [
      {
        "name": "浏览器自动化",
        "description": "远程启动、连接和控制 Chrome/Chromium/Firefox 浏览器实例，支持无头和有头模式，管理浏览器生命周期（启动、关闭、连接现有实例）"
      },
      {
        "name": "页面操作与交互",
        "description": "页面导航（打开 URL、前进/后退、刷新）、元素定位与交互（点击、输入、选择）、键盘与鼠标事件模拟、页面等待与超时控制"
      },
      {
        "name": "网络拦截与模拟",
        "description": "HTTP 请求/响应拦截与修改、网络条件模拟（延迟、带宽）、请求阻塞与允许列表、请求模式匹配"
      },
      {
        "name": "截图与 PDF 生成",
        "description": "页面截图（全页、区域、元素级）、PDF 生成、支持自定义尺寸、格式与裁剪"
      },
      {
        "name": "JavaScript 执行与注入",
        "description": "在页面上下文中执行 JavaScript 表达式和函数、注入脚本、在浏览器和 Node.js 之间传输对象"
      },
      {
        "name": "设备与视口模拟",
        "description": "模拟移动设备（User-Agent、视口尺寸、像素比）、触摸事件、地理位置、时区、权限、蓝牙设备"
      },
      {
        "name": "Cookie 与会话管理",
        "description": "设置、获取、删除 Cookie、管理浏览器会话和存储状态、隐身模式支持"
      },
      {
        "name": "浏览器下载与管理",
        "description": "自动检测平台、下载和安装 Chrome for Testing / Firefox 浏览器二进制文件、管理浏览器版本和缓存、解析可执行文件路径"
      }
    ],
    "domain": "developer_tools",
    "target_users": "Web 开发者、QA 测试工程师、DevOps 工程师、爬虫开发者、Web 安全研究者"
  },
