  "function_summary": {
    "summary": "node-screenshots 是一个零依赖的原生 Node.js 截图库，基于 Rust xcap 库通过 N-API (napi-rs) 绑定封装而成。提供跨平台（Windows/macOS/Linux）的显示器截图、指定窗口截图功能，支持同步与异步两种调用模式，输出格式包括 PNG、JPEG、BMP 及原生 RGBA 像素数据。",
    "categories": [
      {
        "name": "显示器截图",
        "description": "枚举所有显示器或按坐标定位特定显示器，获取其屏幕截图（全屏），支持同步 captureImageSync 和异步 captureImage 两种模式。",
        "evidence": [
          "src/monitor.rs",
          "index.d.ts Monitor class"
        ]
      },
      {
        "name": "窗口截图",
        "description": "枚举系统所有窗口(按 z 序排列)，获取指定窗口的截图，可获取窗口属性（ID/PID/标题/app 名/位置/大小/最小化/最大化/焦点状态），同步与异步截图两种模式。",
        "evidence": [
          "src/window.rs",
          "index.d.ts Window class"
        ]
      },
      {
        "name": "图像格式转换",
        "description": "将截取的 RGBA 像素数据转换为 PNG、JPEG、BMP 等常见图像格式，或直接导出原始 RGBA 数据，每个格式均支持同步与异步模式。",
        "evidence": [
          "src/image.rs",
          "index.d.ts Image class"
        ]
      },
      {
        "name": "异步任务支持",
        "description": "通过 N-API AsyncTask 机制将截图与格式转换操作暴露为 Node.js 异步 Promise 接口，避免阻塞事件循环。",
        "evidence": [
          "src/async_capture.rs"
        ]
      }
    ],
    "domain": "屏幕截图/桌面捕获",
    "target_users": "需要程序化截图功能的 Node.js / Electron 应用开发者",
    "ecosystem": "nodejs"
  },
