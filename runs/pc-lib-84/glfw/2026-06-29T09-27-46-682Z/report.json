  "runtime_surface": {
    "summary": "GLFW 运行时需要访问窗口系统服务（X11/Wayland/Win32/Cocoa）和显示器/输入设备。Linux 上直接打开 /dev/input/event* 设备读取游戏手柄输入、使用 shm_open/mmap 构造 Wayland 共享内存缓冲区、通过 pipe 实现事件唤醒。无网络通信、无外部进程调用、无配置文件读取。",
    "network": [],
    "filesystem": [
      {
        "detail": "/dev/input/event*",
        "purpose": "Linux 上读取 evdev 游戏手柄输入事件",
        "evidence": [
