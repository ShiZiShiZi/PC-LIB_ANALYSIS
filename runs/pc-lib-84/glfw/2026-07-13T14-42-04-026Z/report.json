  "runtime_surface": {
    "summary": "GLFW 运行时不访问本地文件系统（无配置文件读写），不启动子进程，不依赖环境变量，仅需系统提供头文件中的窗口/图形库。网络访问最低限度（仅 Wayland 后端 UNIX 域套接字 loopback，无 TCP/HTTP 出站）。需要 GPU 渲染设备与显示器。",
    "network": [
      false
    ],
    "filesystem": [
      false
    ],
    "subprocess": [
      false
    ],
    "env_vars": [],
    "devices": [
      "OpenGL/Vulkan-capable GPU（GPU 渲染）",
      "显示器/桌面窗口管理器（窗口创建与管理）",
      "键盘/鼠标/手柄输入设备"
    ],
    "services": []
  },
