  "function_summary": {
    "summary": "GLFW 是一个用 C99 编写的开源跨平台桌面窗口库，为 OpenGL、OpenGL ES 和 Vulkan 应用开发提供简洁的平台无关 API——创建窗口与绘图表面、读取键盘/鼠标/手柄输入、处理窗口事件，以及管理 OpenGL/EGL/Vulkan 上下文。macOS 部分辅助代码使用 Objective-C 编写。支持 Windows 7+、macOS 10.11+、Linux（含 X11 与 Wayland 双后端）等多种桌面平台，是图形应用/游戏引擎/可视化工具的基础设施层。",
    "categories": [
      {
        "name": "窗口与表面管理",
        "description": "创建可跨平台的桌面窗口，设置尺寸/位置/标题/图标/全屏/无边框等属性，并生成 OpenGL/Vulkan 绘图表面",
        "evidence": [
          "src/window.c",
          "src/monitor.c",
          "include/GLFW/glfw3.h:GLFWwindow API 区段"
        ]
      },
      {
        "name": "图形 API 上下文管理",
        "description": "创建并管理 OpenGL/OpenGL ES/EGL/Vulkan 上下文，处理扩展加载与上下文切换",
        "evidence": [
          "src/context.c",
          "src/egl_context.c",
          "src/glx_context.c",
          "src/wgl_context.c",
          "src/nsgl_context.m",
          "src/osmesa_context.c",
          "src/vulkan.c"
        ]
      },
      {
        "name": "输入处理",
        "description": "键盘/鼠标/手柄事件的轮询与回调分发，支持按键状态、光标模式（普通/隐藏/锁定）、滚轮、游戏手柄映射",
        "evidence": [
          "src/input.c",
          "src/xkb_unicode.c",
          "src/mappings.h.in",
          "src/linux_joystick.c",
          "src/win32_joystick.c",
          "src/cocoa_joystick.m"
        ]
      },
      {
        "name": "多平台抽象层",
        "description": "统一的平台抽象后端——Win32、Cocoa(macOS)、X11、Wayland、以及空后端——供内部编译切换",
        "evidence": [
          "src/platform.h",
          "src/platform.c",
          "src/null_platform.h",
          "src/null_init.c",
          "src/null_window.c",
          "src/null_monitor.c",
          "src/null_joystick.c"
        ]
      },
      {
        "name": "多显示器与 HiDPI",
        "description": "多显示器枚举、分辨率/刷新率模式切换、Gamma 调整、内容缩放感知",
        "evidence": [
          "src/monitor.c",
          "src/win32_monitor.c",
          "src/x11_monitor.c",
          "src/wl_monitor.c",
          "src/cocoa_monitor.m"
        ]
      }
    ],
    "domain": "桌面图形应用基础设施 / 跨平台窗口层",
    "target_users": "C/C++ 图形应用开发者、游戏引擎开发者、可视化工具开发者、需要跨平台桌面窗口与 OpenGL/Vulkan 上下文管理的项目",
    "ecosystem": "cpp"
  },
