  "function_summary": {
    "summary": "quiche 是 Cloudflare 开发的开源 QUIC 传输协议与 HTTP/3 实现，基于 Rust 编写。它提供一个底层的协议库，由应用程序负责 I/O（如 UDP socket 管理）和定时器驱动的事件循环。库核心是 quiche crate，包含 Connection 状态机、QUIC 帧编解码、TLS 集成（通过 BoringSSL C FFI）、HTTP/3 协议层（包括 QPACK 头压缩）、多路径支持、拥塞控制（Cubic 和 BBR2）等。此外还包括 tokio-quiche（异步 Tokio 封装，提供 ApplicationOverQuic 可扩展 trait 和 H3Driver）、C FFI 头文件和静态库、qlog 日志追踪、以及客户端/服务器 CLI 工具。主要被网络基础设施供应商和代理使用，如 Cloudflare 边缘网络、Android DNS Resolver、curl 等。",
    "categories": [
      {
        "name": "QUIC 传输协议实现",
        "description": "完整实现 RFC 9000 QUIC 传输协议：连接建立/终止、流复用、丢包检测与恢复、拥塞控制（Cubic/BBR2）、多路径、路径 MTU 发现、连接迁移、地址验证等。应用程序只需提供 UDP socket I/O 和定时器。",
        "evidence": [
          "quiche/src/lib.rs:Connection struct",
          "quiche/src/packet.rs",
          "quiche/src/frame.rs",
          "quiche/src/recovery/mod.rs",
          "quiche/src/path.rs",
          "quiche/src/cid.rs"
        ]
      },
      {
        "name": "HTTP/3 协议支持",
        "description": "在 QUIC 之上实现 HTTP/3：流类型管理、HEADERS/DATA 帧、SETTINGS 帧、QPACK 头压缩（静态/动态表）、服务器推送、双向流与单向流映射。",
        "evidence": [
          "quiche/src/h3/mod.rs",
          "quiche/src/h3/qpack/",
          "quiche/src/stream/"
        ]
      },
      {
        "name": "TLS 1.3 加密集成",
        "description": "通过 BoringSSL（boringssl-boring-crate）集成 TLS 1.3，完成 QUIC 的密钥派生、数据包保护、握手状态管理。FFI 桥接 BoringSSL C 库。",
        "evidence": [
          "quiche/src/tls/mod.rs",
          "quiche/src/tls/boringssl.rs",
          "quiche/src/crypto/mod.rs",
          "quiche/src/crypto/boringssl.rs"
        ]
      },
      {
        "name": "异步 I/O 集成（tokio-quiche）",
        "description": "基于 Tokio 的异步 QUIC 封装，提供 ApplicationOverQuic trait 作为扩展点、IoWorker 每连接 I/O 状态机、InboundPacketRouter 按 DCID 多路分发、Ready-made H3Driver 等。",
        "evidence": [
          "tokio-quiche/src/lib.rs",
          "tokio-quiche/src/quic/mod.rs",
          "tokio-quiche/src/quic/io/worker.rs",
          "tokio-quiche/src/quic/router/mod.rs",
          "tokio-quiche/src/http3/driver/mod.rs"
        ]
      },
      {
        "name": "C FFI 绑定",
        "description": "提供 C 语言头文件（quiche.h）和静态/动态库（staticlib/cdylib），可将 quiche 集成到 C/C++ 项目。暴露 config、connect、accept、recv、send、http3 等 API。",
        "evidence": [
          "quiche/include/quiche.h",
          "quiche/src/ffi.rs",
          "quiche/Cargo.toml:lib crate-type"
        ]
      },
      {
        "name": "qlog 日志与工具",
        "description": "支持 qlog（QUIC 日志标准格式），含 qlog 事件 schema、Chrome netlog 解析器、可视化工具（qlog-dancer）。",
        "evidence": [
          "qlog/",
          "qlog-dancer/",
          "netlog/",
          "quiche/Cargo.toml:features/qlog"
        ]
      },
      {
        "name": "调试与测试工具",
        "description": "提供 CLI 客户端/服务器（quiche-client/quiche-server）、h3i HTTP/3 交互式测试工具、fuzz 测试目标。",
        "evidence": [
          "apps/",
          "h3i/",
          "fuzz/"
        ]
      }
    ],
