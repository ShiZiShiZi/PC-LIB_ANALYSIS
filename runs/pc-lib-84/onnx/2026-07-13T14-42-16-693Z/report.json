  "function_summary": {
    "summary": "ONNX（Open Neural Network Exchange）是一个开放的 AI 模型交换格式标准，定义了可扩展的计算图模型、内置算子和标准数据类型。它以 protobuf 序列化为基础，提供模型加载/保存、合法性校验、形状推断、算子版本转换等工具链，同时包含一个基于 numpy 的参考执行器用于结果验证。目标用户为 ML 框架开发者、模型部署工程师和需要跨框架模型互操作的 AI 研究人员。",
    "categories": [
      {
        "name": "模型序列化与反序列化",
        "description": "支持从文件或字节流加载/保存 ONNX 模型（protobuf、textproto、onnxtxt、json 格式），包括外部数据（大张量）的独立存储与合并。",
        "evidence": [
          "onnx/__init__.py:load_model/save_model",
          "onnx/serialization.py",
          "onnx/external_data_helper.py"
        ]
      },
      {
        "name": "模型合法性校验",
        "description": "对 ONNX 模型进行结构与语义校验，包括图结构、节点输入输出、类型一致性、算子版本兼容性等检查，C++ 实现（nanobind 暴露给 Python）。",
        "evidence": [
          "onnx/checker.cc",
          "onnx/checker.py"
        ]
      },
      {
        "name": "形状与类型推断",
        "description": "基于算子注册的形状推断函数，对计算图进行前向类型和形状传播推断，支持数据传播和严格模式，C++ 实现（nanobind 暴露给 Python）。",
        "evidence": [
          "onnx/shape_inference.py",
          "onnx/shape_inference/implementation.cc",
          "onnx/defs/shape_inference.cc"
        ]
      },
      {
        "name": "算子版本转换",
        "description": "在不同 opset 版本之间转换模型中的算子，通过 adapter 模式实现版本间的图变换（如 BatchNorm、Reshape、Slice 等算子的自动适配）。",
        "evidence": [
          "onnx/version_converter.py",
          "onnx/version_converter/convert.cc",
          "onnx/version_converter/adapters/"
        ]
      },
      {
        "name": "参考执行器",
        "description": "基于 numpy 的 ONNX 模型纯 Python 参考实现，可逐算子执行计算图以验证模型输出，供调试和跨框架结果对账使用。",
        "evidence": [
          "onnx/reference/reference_evaluator.py",
          "onnx/reference/ops/",
          "onnx/reference/op_run.py"
        ]
      },
      {
        "name": "图构建与操作",
        "description": "提供 ONNX 计算图、节点、张量的编程构建 API（make_* 系列函数）、图组合/合并、以及 numpy 数组与 ONNX TensorProto 的互转工具。",
        "evidence": [
          "onnx/helper.py",
          "onnx/compose.py",
          "onnx/numpy_helper.py",
          "onnx/_mapping.py"
        ]
      },
      {
        "name": "算子模式定义",
        "description": "以 C++ 代码注册 ONNX 内置算子的 schema（输入输出类型、属性、版本），覆盖数学、神经网络、张量操作、序列、目标检测等多领域算子。",
        "evidence": [
          "onnx/defs/schema.h",
          "onnx/defs/nn/defs.cc",
          "onnx/defs/math/defs.cc",
          "onnx/defs/tensor/defs.cc"
        ]
      }
    ],
    "domain": "AI/ML 模型交换与工具链",
    "target_users": "ML 框架开发者、模型部署工程师、AI 研究人员",
    "ecosystem": "python"
