    ]
  },
  "function_summary": {
    "summary": "Brotli 是一种通用无损压缩算法，结合了 LZ77 变体、霍夫曼编码与二阶上下文建模，压缩比接近当前最优通用压缩方法。本项目以 C/C++ 实现核心编码/解码库，并围绕核心提供 Python、Java、JavaScript/Node.js、Go、C# 等多语言绑定，同时附带一个命令行压缩/解压工具（brotli CLI）以及字典生成、差异分析等研究工具。",
    "categories": [
      {
        "name": "核心编解码库",
        "description": "提供 Brotli 编码器、解码器与共享字典的 C/C++ 实现，是项目最主要的能力。",
        "evidence": [
          "c/include/brotli/encode.h",
          "c/include/brotli/decode.h",
          "c/include/brotli/shared_dictionary.h",
          "c/enc/encode.c",
          "c/dec/decode.c"
        ]
      },
      {
        "name": "共享字典",
        "description": "支持自定义/预训练 LZ77 字典，提升特定数据（如字体 WOFF2）的压缩率。",
        "evidence": [
          "c/common/shared_dictionary.c",
          "c/include/brotli/shared_dictionary.h"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "在核心 C 库之上提供 Python C 扩展、纯 Java/Java JNI、纯 JavaScript/TypeScript、Go（含 cgo 绑定）与 C# 绑定，使各类语言生态都能调用 Brotli。",
        "evidence": [
          "python/_brotli.c",
          "python/brotli.py",
          "java/org/brotli/dec/BrotliInputStream.java",
          "java/org/brotli/wrapper/dec/decoder_jni.cc",
          "js/decode.js",
          "go/cbrotli/cgo.go",
          "csharp/org/brotli/dec/Decoder.cs"
        ]
      },
      {
        "name": "命令行工具",
        "description": "提供 brotli 可执行程序，支持文件/标准流的压缩、解压、完整性检测与字典使用。",
        "evidence": [
          "c/tools/brotli.c"
        ]
      },
      {
        "name": "研究/实验工具",
        "description": "位于 research/ 目录的字典生成、差异可视化、直方图、实验性解码器等辅助研究程序，属于实验性质，不是发布库的核心部分。",
        "evidence": [
          "research/dictionary_generator.cc",
          "research/brotli_decoder.c",
          "research/draw_diff.cc"
        ]
      }
    ],
    "domain": "数据压缩与归档",
    "target_users": "需要高性能无损压缩的应用开发者、Web/网络传输/字体处理库开发者、系统打包与压缩工具维护者。"
