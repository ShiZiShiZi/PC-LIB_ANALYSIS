  "function_summary": {
    "summary": "C++ REST SDK（原名 Casablanca）是微软开发的跨平台 C++ 库，用于云客户端-服务端通信。它提供基于现代异步 C++ API 设计的 HTTP 客户端与服务端、JSON 解析/序列化、URI 处理、异步流、WebSocket 客户端以及 OAuth 1.0/2.0 认证功能。底层在 Windows 上使用 WinHTTP/HTTP.sys，在 Linux/macOS 上使用 Boost.Asio + OpenSSL 实现网络通信。该项目已归档停止维护。",
    "categories": [
      {
        "name": "HTTP 客户端",
        "description": "异步 HTTP 客户端，支持 GET/POST/PUT/DELETE 等方法、TLS/SSL、代理、压缩、重定向和请求/响应流处理",
        "evidence": ["Release/include/cpprest/http_client.h", "Release/src/http/client/http_client_asio.cpp", "Release/src/http/client/http_client_winhttp.cpp"]
      },
      {
        "name": "HTTP 服务端",
        "description": "异步 HTTP 监听器（服务端），支持路由、TLS/SSL 和请求处理",
        "evidence": ["Release/include/cpprest/http_listener.h", "Release/src/http/listener/http_server_asio.cpp", "Release/src/http/listener/http_server_httpsys.cpp"]
      },
      {
        "name": "JSON 处理",
        "description": "JSON 值的解析、构造、序列化与反序列化，支持数字、字符串、布尔、数组、对象和 null 类型",
        "evidence": ["Release/include/cpprest/json.h", "Release/src/json/json.cpp", "Release/src/json/json_parsing.cpp"]
      },
      {
        "name": "WebSocket 客户端",
        "description": "异步 WebSocket 客户端，基于 websocketpp（非 Windows）或 WinRT WebSocket 实现",
        "evidence": ["Release/include/cpprest/ws_client.h", "Release/src/websockets/client/ws_client_wspp.cpp"]
      },
      {
        "name": "异步流与文件 I/O",
        "description": "基于流缓冲区的异步 I/O 框架，支持文件、容器、原始指针和互操作流",
        "evidence": ["Release/include/cpprest/streams.h", "Release/include/cpprest/astreambuf.h", "Release/src/streams/fileio_posix.cpp"]
      },
      {
        "name": "URI 处理",
        "description": "URI 解析、构建与编码/解码工具",
        "evidence": ["Release/include/cpprest/uri.h", "Release/include/cpprest/uri_builder.h", "Release/src/uri/uri.cpp"]
      },
      {
        "name": "OAuth 认证",
        "description": "OAuth 1.0 和 OAuth 2.0 认证流程支持，自动为 HTTP 请求附加认证头",
        "evidence": ["Release/include/cpprest/oauth1.h", "Release/include/cpprest/oauth2.h", "Release/src/http/oauth/oauth1.cpp", "Release/src/http/oauth/oauth2.cpp"]
      },
      {
        "name": "PPL 异步任务",
        "description": "跨平台异步任务组合框架（PPLX），基于 C++11 特性实现，Windows 上可回退至 PPL",
        "evidence": ["Release/include/pplx/pplxtasks.h", "Release/src/pplx/pplxlinux.cpp", "Release/src/pplx/pplxwin.cpp"]
      }
    ],
    "domain": "网络通信 / REST API",
    "target_users": "需要从 C++ 原生代码进行云服务通信和 REST API 调用的开发者"
  },

