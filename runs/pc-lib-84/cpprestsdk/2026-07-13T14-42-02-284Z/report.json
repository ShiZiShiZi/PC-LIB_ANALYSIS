          "Release/include/cpprest/oauth1.h",
          "Release/include/cpprest/oauth2.h"
        ]
      },
      {
        "name": "异步流与实用工具",
        "description": "异步文件 I/O（posix/win32 后端）、内存流、生产者-消费者流、Base64 编解码、日期时间工具",
