  "function_summary": {
    "summary": "C++ REST SDK（cpprestsdk）是微软开发的跨平台 C++ HTTP 客户端/服务器库，提供基于 PPL（Parallel Patterns Library）的现代异步 C++ API，用于构建云客户端-服务器通信应用。支持 HTTP/HTTPS 客户端与服务器、WebSocket 客户端、JSON 解析与序列化、URI 构建、异步流、OAuth 1.0/2.0 认证等，覆盖 Windows/Linux/macOS/iOS/Android 多平台。",
    "categories": [
      {
        "name": "HTTP 客户端",
        "description": "基于 Boost.Asio（跨平台）或 WinHTTP（Windows）实现异步 HTTP/HTTPS 客户端，支持 GET/POST/PUT/DELETE、请求/响应头、代理、重定向、TLS/SSL、HTTP 压缩（gzip/deflate/brotli）",
        "evidence": [
          "Release/src/http/client/http_client.cpp",
          "Release/src/http/client/http_client_asio.cpp",
          "Release/src/http/client/http_client_winhttp.cpp",
          "Release/include/cpprest/http_client.h"
        ]
      },
      {
        "name": "HTTP 服务器",
        "description": "基于 Boost.Asio 或 Windows HTTP Server API（http.sys）实现的异步 HTTP 服务器，支持路由匹配、请求过滤管线、多监听端口",
        "evidence": [
          "Release/src/http/listener/http_listener.cpp",
          "Release/src/http/listener/http_server_asio.cpp",
          "Release/src/http/listener/http_server_httpsys.cpp",
          "Release/include/cpprest/http_listener.h"
        ]
      },
      {
        "name": "WebSocket 客户端",
        "description": "基于 websocketpp（跨平台）或 WinRT（UWP）的 WebSocket 客户端，支持文本/二进制帧收发、自动 ping/pong、连接/关闭回调",
        "evidence": [
          "Release/src/websockets/client/ws_client.cpp",
          "Release/src/websockets/client/ws_client_wspp.cpp",
          "Release/src/websockets/client/ws_client_winrt.cpp",
          "Release/include/cpprest/ws_client.h"
        ]
      },
      {
        "name": "JSON 处理",
        "description": "完整的 JSON 解析（SAX 风格）与序列化/反序列化，支持 JSON 值树操作、类型转换、迭代器遍历、窄/宽字符编码自动转换",
        "evidence": [
          "Release/src/json/json.cpp",
          "Release/src/json/json_parsing.cpp",
          "Release/src/json/json_serialization.cpp",
          "Release/include/cpprest/json.h"
        ]
      },
      {
        "name": "URI 处理",
        "description": "URI 解析（scheme/user-info/host/port/path/query/fragment）与构造器（builder 模式），支持 URL 编码/解码",
        "evidence": [
