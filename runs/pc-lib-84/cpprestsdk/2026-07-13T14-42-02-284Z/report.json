          "Release/src/uri/uri_builder.cpp",
          "Release/include/cpprest/uri.h",
          "Release/include/cpprest/uri_builder.h"
        ]
      },
      {
        "name": "OAuth 认证",
        "description": "OAuth 1.0 和 2.0 客户端认证流程实现，支持 authorization_code、client_credentials 等授权模式",
        "evidence": [
          "Release/src/http/oauth/oauth1.cpp",
