  "function_summary": {
    "summary": "HIDAPI 是一个轻量级跨平台 C 库，为应用程序提供统一的 API 与 USB/蓝牙等 HID（人机接口设备）进行通信。它封装了 Windows（hid.dll）、macOS（IOKit HID Manager）、Linux（hidraw/udev 或 libusb）等操作系统的原生 HID 接口，屏蔽了平台差异，让开发者只需一套 API 即可读写 HID 设备的输入/输出/特性报告。典型用户是需要与游戏手柄、条码扫描器、USB HID 自定义设备等交互的桌面或嵌入式应用开发者。",
    "categories": [
      {
        "name": "HID 设备枚举与发现",
        "description": "列出系统中所有连接的 HID 设备，可按 VID/PID 过滤；返回设备路径、厂商/产品字符串、序列号等属性。",
        "evidence": [
          "hidapi/hidapi.h:hid_enumerate()",
          "hidapi/hidapi.h:hid_free_enumeration()",
          "hidapi/hidapi.h:struct hid_device_info"
        ]
      },
      {
        "name": "设备读写操作",
        "description": "打开设备后，通过 hid_read/hid_write 收发输入/输出报告（基于中断传输端点），支持非阻塞读写模式。",
        "evidence": [
          "hidapi/hidapi.h:hid_open()",
          "hidapi/hidapi.h:hid_read() / hid_write()",
          "hidapi/hidapi.h:hid_set_nonblocking()"
        ]
      },
      {
        "name": "特性报告控制传输",
        "description": "通过控制端点收发 HID 特性报告（Set_Report/Get_Report），用于设备配置与状态查询。",
        "evidence": [
          "hidapi/hidapi.h:hid_get_feature_report()",
          "hidapi/hidapi.h:hid_send_feature_report()"
        ]
      },
      {
        "name": "设备字符串与元数据获取",
        "description": "读取 HID 设备的厂商名称、产品名、序列号等字符串描述符，以及 HID Report Descriptor。",
        "evidence": [
          "hidapi/hidapi.h:hid_get_manufacturer_string()",
          "hidapi/hidapi.h:hid_get_product_string()",
          "hidapi/hidapi.h:hid_get_indexed_string()",
          "hidapi/hidapi.h:hid_get_report_descriptor()"
        ]
      },
      {
        "name": "多平台后端抽象",
        "description": "内置 Windows（hid.dll + SetupDi）、macOS（IOKit IOHIDManager）、Linux hidraw（udev）+ libusb 四个后端，编译时选择。",
        "evidence": [
          "windows/hid.c",
          "mac/hid.c",
          "linux/hid.c",
          "libusb/hid.c",
          "CMakeLists.txt 中各后端选项"
        ]
      }
    ],
    "domain": "硬件接口/设备通信",
    "target_users": "桌面及嵌入式 C/C++ 应用开发者，需要跨平台访问 HID 类 USB/蓝牙设备",
    "ecosystem": "cpp"
  },
