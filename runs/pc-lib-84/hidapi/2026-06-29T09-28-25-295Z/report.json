  "function_summary": {
    "summary": "hidapi 是一个跨平台的 C 语言库，用于与 USB 和蓝牙 HID（人机接口设备）类设备通信。它为开发者提供了统一的 API 来枚举、打开、读写 HID 设备，屏蔽了不同操作系统底层 HID 驱动的差异。该库支持 Windows（hid.dll）、Linux（hidraw/libusb）、macOS（IOHidManager）、FreeBSD 和 NetBSD 四种后端实现，可编译为共享库或直接嵌入目标应用。",
    "categories": [
      {
        "name": "HID 设备枚举与发现",
        "description": "扫描系统中所有 HID 设备，按厂商 ID/产品 ID 过滤，返回设备路径、序列号、厂商/产品字符串等信息的链表",
        "evidence": ["hidapi/hidapi.h:hid_enumerate", "hidapi/hidapi.h:hid_free_enumeration"]
      },
      {
        "name": "HID 设备通信",
        "description": "打开指定 HID 设备，发送/接收输入输出报告和特征报告，支持阻塞与非阻塞读写模式及超时控制",
        "evidence": ["hidapi/hidapi.h:hid_open", "hidapi/hidapi.h:hid_open_path", "hidapi/hidapi.h:hid_write", "hidapi/hidapi.h:hid_read", "hidapi/hidapi.h:hid_send_feature_report", "hidapi/hidapi.h:hid_get_feature_report"]
      },
      {
        "name": "设备信息查询",
        "description": "获取已打开设备的厂商字符串、产品字符串、序列号、报告描述符等元信息",
        "evidence": ["hidapi/hidapi.h:hid_get_manufacturer_string", "hidapi/hidapi.h:hid_get_product_string", "hidapi/hidapi.h:hid_get_device_info", "hidapi/hidapi.h:hid_get_report_descriptor"]
      },
      {
        "name": "平台后端抽象",
        "description": "为每个支持的平台提供独立的 hid.c 实现（Windows/hidraw/libusb/mac/NetBSD），通过统一头文件 hidapi.h 暴露相同的 API，链接时选择对应后端",
        "evidence": ["windows/hid.c", "linux/hid.c", "libusb/hid.c", "mac/hid.c", "netbsd/hid.c"]
      }
    ],
    "domain": "硬件设备访问 / USB HID 通信",
