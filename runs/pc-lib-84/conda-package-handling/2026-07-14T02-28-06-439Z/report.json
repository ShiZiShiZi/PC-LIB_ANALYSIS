  "function_summary": {
    "summary": "conda-package-handling 是一个用于创建、提取与转换多种格式 conda 软件包的纯 Python 库。它同时支持新式 .conda（zstd 压缩的 zip 容器）与传统 .tar.bz2 两种包格式，被 conda 与 conda-build 作为 API（conda_package_handling.api）调用，并附带 cph 命令行工具（extract / create / transmute / list 子命令）。核心的流式打包/解包与压缩逻辑委托给姊妹库 conda-package-streaming 与 C 扩展 zstandard 完成，本库主要提供格式抽象、异常兼容层、批量转换校验与 CLI。",
    "categories": [
      {
        "name": "conda 包创建",
        "description": "把前缀目录中的文件打包成 .conda 或 .tar.bz2；.conda 走 zstd 压缩的双组件（pkg/info）zip 容器，.tar.bz2 走 bzip2 tar。",
        "evidence": [
          "src/conda_package_handling/api.py:85",
          "src/conda_package_handling/conda_fmt.py:58",
          "src/conda_package_handling/tarball.py:73"
        ]
      },
      {
        "name": "conda 包提取",
        "description": "解包 .conda / .tar.bz2 到目标目录，支持按 CEP 35 分离 info 与 pkg 组件；底层委托给 conda-package-streaming。",
        "evidence": [
          "src/conda_package_handling/api.py:55",
          "src/conda_package_handling/streaming.py:58"
        ]
      },
      {
        "name": "包格式转换 (transmute)",
        "description": "在 .tar.bz2 与 .conda 之间批量转换，可用多进程并行并对转换结果做一致性校验。",
        "evidence": [
          "src/conda_package_handling/api.py:196",
          "src/conda_package_handling/api.py:125",
          "src/conda_package_handling/validate.py:58"
        ]
      },
      {
        "name": "包内容列举",
        "description": "列出本地或远程 .conda / .tar.bz2 的内容清单（类似 tar --list），远程 .conda 通过 URL 仅取 info 组件推断。",
        "evidence": [
          "src/conda_package_handling/api.py:228",
          "src/conda_package_handling/conda_fmt.py:168",
          "src/conda_package_handling/tarball.py:96"
        ]
      },
      {
        "name": "cph 命令行工具",
        "description": "argparse 实现的 CLI，提供 extract/create/transmute/list 子命令，作为 console_script 入口 cph 安装。",
        "evidence": [
          "src/conda_package_handling/cli.py:130",
          "pyproject.toml:24"
        ]
      },
      {
        "name": "格式抽象与异常兼容层",
        "description": "AbstractBaseFormat 抽象基类统一各包格式接口，并把 conda-package-streaming 的异常翻译为本库公开的 InvalidArchiveError/ConversionError 等。",
        "evidence": [
          "src/conda_package_handling/interface.py:6",
          "src/conda_package_handling/streaming.py:52",
          "src/conda_package_handling/exceptions.py:4"
        ]
      }
    ],
    "domain": "软件包管理 / 归档与压缩（conda 生态）",
    "target_users": "conda 生态的工具开发者（conda、conda-build 等以 API 方式集成）以及需要处理 conda 包的命令行用户",
    "ecosystem": "python"
  },
