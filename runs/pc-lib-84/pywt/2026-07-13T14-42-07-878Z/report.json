  "function_summary": {
    "summary": "PyWavelets（pywt）是一个 Python 开源小波变换库，为科学计算与信号处理提供 1D/2D/nD 离散小波变换（DWT）、平稳小波变换（SWT）、连续小波变换（CWT）及小波包分解功能。内置 100+ 小波滤波器，同时支持单/双精度实数和复数运算，结果与 MATLAB Wavelet Toolbox 兼容。面向信号处理、图像分析、数据压缩等领域的 Python 研究人员与工程师。",
    "categories": [
      {
        "name": "离散小波变换（DWT）",
        "description": "提供 1D、2D 及 nD 正向与逆向离散小波变换，支持多级分解与重构（wavedec/waverec、wavedecn/waverecn），信号扩展模式包括零填充、对称、周期等",
        "evidence": [
          "pywt/_dwt.py",
          "pywt/_multidim.py",
          "pywt/_multilevel.py",
          "pywt/_extensions/_dwt.pyx",
          "pywt/_extensions/c/dwt.c"
        ]
      },
      {
        "name": "连续小波变换（CWT）",
        "description": "支持 1D 连续小波变换（cwt），可使用卷积或 FFT 方法计算，提供尺度与频率互转工具（scale2frequency/frequency2scale）",
        "evidence": [
          "pywt/_cwt.py",
          "pywt/_extensions/_cwt.pyx"
        ]
      },
      {
        "name": "平稳小波变换（SWT）",
        "description": "提供 1D、2D 及 nD 的平稳（非抽取）小波变换（swt/iswt、swtn/iswtn），具有平移不变性，遵循 à-trous 算法",
        "evidence": [
          "pywt/_swt.py",
          "pywt/_extensions/_swt.pyx"
        ]
      },
      {
        "name": "小波包分解",
        "description": "提供 1D、2D 及 nD 小波包分解与重构（WaveletPacket/WaveletPacketND），支持节点选择、系数提取与自定义路径遍历",
        "evidence": [
          "pywt/_wavelet_packets.py"
        ]
      },
      {
        "name": "多分辨率分析（MRA）",
        "description": "将信号投影到小波子空间，提供正向与逆向 1D/2D/nD 多分辨率分析（mra/imra），可选基于 SWT 或 DWT",
        "evidence": [
          "pywt/_mra.py"
        ]
      },
      {
        "name": "信号阈值处理",
        "description": "提供软阈值、硬阈值、Garrote 阈值、大于/小于阈值等多种信号去噪阈值方法，支持复数",
        "evidence": [
          "pywt/_thresholding.py"
        ]
      },
      {
        "name": "小波滤波器与工具函数",
        "description": "内置 100+ 小波滤波器族（Haar/Daubechies/Symlet/Coiflet/Biorthogonal/Morlet/Mexican Hat 等），支持自定义小波；提供小波函数逼近（wavefun）、中心频率计算、正交滤波器组等工具",
        "evidence": [
          "pywt/_functions.py",
          "pywt/_extensions/_pywt.pyx",
          "pywt/_extensions/wavelets_list.pxi",
          "pywt/_extensions/c/wavelets.h"
        ]
      }
    ],
    "domain": "科学计算 / 信号处理",
    "target_users": "科学研究人员、信号处理工程师、数据科学家",
    "ecosystem": "python"
  },
