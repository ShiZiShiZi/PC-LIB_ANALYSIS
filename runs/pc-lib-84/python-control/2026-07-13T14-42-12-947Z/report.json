  "function_summary": {
    "summary": "Python Control Systems Library (python-control) 是一个面向控制工程与科研的 Python 开源库，提供反馈控制系统的建模、分析与设计功能。支持线性时不变系统（状态空间与传递函数）、非线性系统（优化控制、描述函数、微分平坦）以及离散时间系统；内置 Bode/Nyquist/Nichols 频域分析、根轨迹、极点配置、LQR/LQG/H∞ 最优控制等经典与现代控制方法；并提供兼容 MATLAB Control Systems Toolbox 的接口模块。主要面向控制理论研究者、控制工程师与自动化专业的教学用户。",
    "categories": [
      {
        "name": "线性系统建模与互连",
        "description": "以状态空间（StateSpace）和传递函数（TransferFunction）两种核心表示建模线性时不变系统，支持串联、并联、反馈等代数互连以及参数摄动模型族（InputOutputModelList）。",
        "evidence": [
          "control/statesp.py:60 (StateSpace)",
          "control/xferfcn.py (TransferFunction)",
          "control/bdalg.py (series/parallel/feedback/append)",
          "control/iosys.py:140 (InputOutputSystem)",
          "control/lti.py (LTI 基类)"
        ]
      },
      {
        "name": "时域仿真与响应分析",
        "description": "对线性和非线性系统进行初始响应、阶跃响应、脉冲响应等时域仿真，支持连续/离散时间，可返回信号带标签的时间序列数据。",
        "evidence": [
          "control/timeresp.py (step_response/impulse_response/initial_response/forced_response)",
          "control/timeplot.py (时域绘图)"
        ]
      },
      {
        "name": "频域分析与频响",
        "description": "计算并绘制 Bode 图、Nyquist 图、Nichols 图、增益/相位裕度，支持 SISO 和 MIMO 系统的频率响应分析。",
        "evidence": [
          "control/freqplot.py (bode_plot/nyquist_plot/gangof4)",
          "control/nichols.py (nichols_plot)",
          "control/margins.py (margin/stability_margins/disk_margins)",
          "control/frdata.py (FrequencyResponseData)"
        ]
      },
      {
        "name": "控制系统设计",
        "description": "提供极点配置、线性二次型调节器（LQR）、线性二次型估计器（Kalman 滤波器/LQE）、H∞/H2 鲁棒控制等经典与现代设计方法。",
        "evidence": [
          "control/statefbk.py (place/acker/lqr/lqe)",
          "control/robust.py (hinfsyn/h2syn/robust_stability)",
          "control/mateqn.py (Riccati 方程求解)"
        ]
      },
      {
        "name": "非线性系统",
        "description": "支持非线性系统的建模（NonlinearIOSystem）、基于优化的轨迹生成与控制（flatness-based B-spline）、描述函数法分析、微分平坦系统与 2D 相平面图。",
        "evidence": [
          "control/nlsys.py (NonlinearIOSystem/InterconnectedSystem)",
          "control/flatsys/ (平坦系统/轨迹生成)",
          "control/descfcn.py (描述函数)",
          "control/phaseplot.py (相平面图)"
        ]
      },
      {
        "name": "模型降阶与分析",
        "description": "基于自洽性、可观性、可达性分析系统性质，提供模型降阶（平衡截断）、模态分解和系统范数计算。",
        "evidence": [
          "control/canonical.py (可观/可达性判定)",
          "control/modelsimp.py (balred/hsvd/modred)",
          "control/statesp.py:792 (slycot_laub/linfnorm)",
          "control/passivity.py (无源性分析)"
        ]
      },
      {
        "name": "MATLAB 兼容接口与 SISO 辅助",
        "description": "提供与 MATLAB Control Systems Toolbox 兼容的命名接口（`control.matlab`），以及 SISOTool、根轨迹绘制、零极点图、PID 整定等辅助工具。",
        "evidence": [
          "control/matlab/__init__.py (MATLAB 兼容层)",
          "control/sisotool.py (SISOTool)",
          "control/rlocus.py (根轨迹)",
          "control/pzmap.py (零极点图)",
          "control/sysnorm.py (系统范数)"
        ]
      }
    ],
    "domain": "控制工程与自动化",
    "target_users": "控制理论研究者和工程师、自动化专业师生、机器人/航空航天领域的控制算法开发者",
    "ecosystem": "python"
