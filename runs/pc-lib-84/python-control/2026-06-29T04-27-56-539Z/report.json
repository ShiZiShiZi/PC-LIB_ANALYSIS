    "one_liner": "Python 控制系统的分析与设计库，提供传递函数/状态空间建模、时频域分析、控制器设计及 MATLAB 兼容接口。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "python-control（Python Control Systems Library）是一个用于反馈控制系统分析与设计的 Python 库。它以传递函数、状态空间和频响数据等对象为核心，提供线性/非线性系统建模、时频域响应、稳定性分析、控制器综合以及 MATLAB 风格兼容命令，服务于控制工程师、科研人员和学生。",
    "categories": [
      {
        "name": "线性输入/输出系统建模",
        "description": "支持状态空间（StateSpace）、传递函数（TransferFunction）和频响数据（FrequencyResponseData）等对象，以及连续/离散时间系统的表示与转换。",
        "evidence": [
          "control/statesp.py",
          "control/xferfcn.py",
          "control/frdata.py",
          "README.rst:40-41"
        ]
      },
      {
        "name": "方框图代数与系统互联",
        "description": "实现串联、并联、反馈、求和等块图运算，支持任意 MIMO 系统的互连与化简。",
        "evidence": [
          "control/bdalg.py",
          "control/iosys.py",
          "README.rst:41"
        ]
      },
      {
        "name": "时域与频域分析",
        "description": "提供阶跃、脉冲、初始响应等时域仿真，以及 Bode、Nyquist、Nichols、根轨迹、稳定裕度、能控能观性等频域与稳定性分析工具。",
        "evidence": [
          "control/timeresp.py",
          "control/freqplot.py",
          "control/nichols.py",
          "control/rlocus.py",
          "control/margins.py",
          "README.rst:42-44"
        ]
      },
      {
        "name": "控制器与估计器设计",
        "description": "支持极点配置、线性二次调节器（LQR）、线性二次估计器（Kalman 滤波）、H2/H∞ 综合、sisotool 等设计方法。",
        "evidence": [
          "control/statefbk.py",
          "control/robust.py",
          "control/sisotool.py",
          "README.rst:45-46"
        ]
      },
      {
        "name": "非线性系统分析与优化控制",
        "description": "提供相平面图、描述函数、微分平坦（flatsys）轨迹生成以及基于优化的控制（optimal）功能。",
        "evidence": [
          "control/phaseplot.py",
          "control/descfcn.py",
          "control/flatsys/",
          "control/optimal.py",
          "README.rst:47"
        ]
      },
      {
        "name": "MATLAB 兼容接口",
        "description": "通过 control.matlab 子模块提供与 MATLAB Control Systems Toolbox 相近的函数命名与调用风格。",
        "evidence": [
          "control/matlab/__init__.py",
          "control/matlab/wrappers.py",
          "README.rst:16-18"
        ]
      },
      {
        "name": "可视化与绘图",
        "description": "基于 matplotlib 生成控制专用的 Bode、Nyquist、Nichols、根轨迹、时域响应等二维图表。",
        "evidence": [
          "control/ctrlplot.py",
          "control/timeplot.py",
          "control/freqplot.py",
          "README.rst:43"
        ]
      }
    ],
    "domain": "control systems / scientific computing",
    "target_users": "控制工程师、科研人员、学生以及使用 Python 进行控制系统分析的开发者"
  },
