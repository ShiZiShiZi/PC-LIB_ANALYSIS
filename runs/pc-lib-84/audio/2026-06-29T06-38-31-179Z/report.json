  "function_summary": {
    "summary": "TorchAudio 是 PyTorch 生态的音频处理库，专注为机器学习工作流提供音频数据加载、特征提取、语音模型与数据集工具。自 2.9 起进入维护阶段并精简功能，核心能力包括通过 TorchCodec 的音频读写、频谱/Mel/MFCC 等变换、语音识别/合成/分离预训练模型与常见数据集加载器。",
    "categories": [
      {
        "name": "音频 I/O",
        "description": "通过 TorchCodec 解码/编码音频文件，提供 torchaudio.load / save 与底层 AudioDecoder/AudioEncoder 封装。",
        "evidence": [
          "src/torchaudio/__init__.py:load/save",
          "src/torchaudio/_torchcodec.py"
        ]
      },
      {
        "name": "音频与语音特征变换",
        "description": "提供 Spectrogram、MelSpectrogram、MFCC、MuLaw、Resample、GriffinLim 等基于 PyTorch 张量的可微分音频变换。",
        "evidence": [
          "src/torchaudio/transforms/_transforms.py",
          "src/torchaudio/functional/functional.py"
        ]
      },
      {
        "name": "预训练语音与音频模型",
        "description": "包含 Wav2Vec2/HuBERT/WavLM、RNNT、Tacotron2/WaveRNN、ConvTasNet/HDemucs、SQUIM 等语音/音频模型与预训练权重。",
        "evidence": [
          "src/torchaudio/models/__init__.py",
          "src/torchaudio/pipelines/__init__.py"
        ]
      },
      {
        "name": "数据集加载器",
        "description": "为 LibriSpeech、CommonVoice、VoxCeleb、MUSDB-HQ 等常见音频数据集提供 PyTorch Dataset 封装。",
        "evidence": [
          "src/torchaudio/datasets/__init__.py"
        ]
      },
      {
        "name": "原生加速算子",
        "description": "通过 C++/CUDA 扩展实现 lfilter、overdrive、RNNT loss、forced alignment、CTC prefix decoder 等计算密集型算子，并注册为 PyTorch 自定义算子。",
        "evidence": [
          "src/libtorchaudio/lfilter.cpp",
          "src/libtorchaudio/overdrive.cpp",
          "src/libtorchaudio/rnnt",
          "src/libtorchaudio/forced_align",
          "src/libtorchaudio/cuctc"
        ]
      },
      {
        "name": "Kaldi 兼容接口",
        "description": "提供与 Kaldi 语音工具包数值兼容的 fbank、mfcc、spectrogram 计算。",
        "evidence": [
          "src/torchaudio/compliance/kaldi.py"
        ]
      }
    ],
