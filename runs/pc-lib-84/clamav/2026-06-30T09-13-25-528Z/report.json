  "function_summary": {
    "summary": "ClamAV 是 Cisco Talos 维护的开源反病毒引擎，主要用于检测木马、病毒、恶意软件等安全威胁。核心库 libclamav 提供文件扫描引擎（支持 PE/ELF/Mach-O/PDF/Office 文档等数十种格式解析与特征匹配），配套守护进程 clamd（多线程扫描服务）、命令行扫描器 clamscan、实时文件监控 clamonacc（Linux fanotify/inotify）以及特征库更新工具 freshclam。Rust 组件（libclamav_rust）提供新版解析器与模糊哈希等新功能。",
    "categories": [
      {
        "name": "恶意软件扫描引擎",
        "description": "核心扫描库 libclamav，支持 PE/ELF/Mach-O/OLE2/PDF/HTML/邮件/压缩包等数十种文件格式的解析、特征匹配（AC 自动机/BM/PCRE/YARA 字节码）与启发式检测",
        "evidence": [
          "libclamav/clamav.h",
          "libclamav/scan_layer.c",
          "libclamav/matcher-ac.c",
          "libclamav/matcher-bm.c",
          "libclamav/scanners.c"
        ]
      },
      {
        "name": "文件格式解析",
        "description": "对 PE/ELF/Mach-O/OLE2/PDF/HTML/邮件/压缩包/DMG/ISO 等格式进行解析，识别可疑内容与提取嵌入文件",
        "evidence": [
          "libclamav/pe.c",
          "libclamav/elf.c",
          "libclamav/macho.c",
          "libclamav/pdf.c",
          "libclamav/ole2_extract.c",
          "libclamav/htmlnorm.c",
          "libclamav/mbox.c"
        ]
      },
      {
        "name": "特征匹配与签名系统",
        "description": "AC 自动机、BM 模式匹配、PCRE 正则、YARA 规则引擎和字节码虚拟机（可选 LLVM JIT）构成多层签名检测体系",
        "evidence": [
          "libclamav/matcher-ac.c",
          "libclamav/matcher-bm.c",
          "libclamav/matcher-pcre.c",
          "libclamav/yara_compiler.c",
          "libclamav/bytecode.c",
          "libclamav/bytecode_vm.c"
        ]
      },
      {
        "name": "数据库更新服务",
        "description": "freshclam 通过 HTTP/HTTPS 从 ClamAV 官方镜像下载并验证病毒特征库（CVD/CLD 格式），支持 DNS 查询与数字签名验证",
        "evidence": [
          "libfreshclam/libfreshclam.h",
          "libfreshclam/libfreshclam_internal.c",
          "freshclam/freshclam.c"
        ]
      },
      {
        "name": "守护进程与网络扫描服务",
        "description": "clamd 提供多线程 TCP/Unix socket 扫描服务，支持会话协议与并发扫描管理；clamdscan 为其命令行客户端",
        "evidence": [
          "clamd/clamd.c",
          "clamd/server-th.c",
          "clamd/thrmgr.c",
          "clamdscan/clamdscan.c"
        ]
      },
      {
        "name": "实时文件监控",
        "description": "clamonacc 利用 Linux fanotify/inotify 机制实现实时文件访问监控与自动扫描，需 root 权限",
        "evidence": [
          "clamonacc/clamonacc.c",
