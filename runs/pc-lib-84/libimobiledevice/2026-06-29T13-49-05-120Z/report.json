  "function_summary": {
    "summary": "libimobiledevice 是一个跨平台 C 库，实现了 Apple iOS 设备原生服务协议（lockdown、AFC、backup、sync、diagnostics、screenshot、syslog 等），供应用与 iOS 设备建立连接、交换 plist 消息、启用 SSL 加密并操作各类设备服务。库本身附带命令行工具作为使用示例，核心定位是被其他程序以 API 方式调用。",
    "categories": [
      {
        "name": "设备连接与发现",
        "description": "通过 usbmuxd（USB）或 TCP（WiFi sync）发现、连接 iOS 设备，并订阅设备增删事件。",
        "evidence": [
          "src/idevice.c:idevice_connect",
          "src/idevice.c:idevice_get_device_list",
          "src/idevice.c:usbmuxd_events_subscribe"
        ]
      },
      {
        "name": "安全通信与 SSL/TLS",
        "description": "读取主机与设备的配对记录，与设备建立 TLS 1.0+ 加密连接；支持 OpenSSL、GnuTLS、MbedTLS 三种后端。",
        "evidence": [
          "src/idevice.c:idevice_connection_enable_ssl",
          "common/userpref.c"
        ]
      },
      {
        "name": "Lockdown 服务",
        "description": "与 lockdownd 握手、查询设备信息、启动后续各项服务。",
        "evidence": [
          "src/lockdown.c",
          "src/lockdown-cu.c"
        ]
      },
      {
        "name": "文件与存储服务",
        "description": "通过 AFC/House Arrest 访问设备文件系统及应用共享文档。",
        "evidence": [
          "src/afc.c",
          "src/house_arrest.c"
        ]
      },
      {
        "name": "备份与同步",
        "description": "提供与 iTunes 兼容的原生备份/恢复（mobilebackup/mobilebackup2）及数据同步（mobilesync）能力。",
        "evidence": [
          "src/mobilebackup.c",
          "src/mobilebackup2.c",
          "src/mobilesync.c"
        ]
      },
      {
        "name": "设备管理",
        "description": "安装/卸载应用、管理描述文件、挂载镜像、激活、诊断、截图、系统日志、通知代理等。",
        "evidence": [
          "src/installation_proxy.c",
          "src/mobile_image_mounter.c",
          "src/diagnostics_relay.c",
          "src/screenshotr.c",
          "src/syslog_relay.c",
          "src/notification_proxy.c"
        ]
      },
      {
        "name": "无线配对与证书",
        "description": "在启用 wireless-pairing 时使用仓库内嵌的 ed25519 与 SRP6a-SHA512 实现完成配对与密钥交换。",
        "evidence": [
          "src/lockdown-cu.c",
          "3rd_party/ed25519",
          "3rd_party/libsrp6a-sha512"
        ]
      },
      {
        "name": "Python 绑定",
        "description": "通过 Cython 将核心 C API 暴露给 Python，实现 Python 应用调用。",
        "evidence": [
          "cython/imobiledevice.pyx",
          "cython/Makefile.am"
        ]
      }
    ],
    "domain": "移动设备管理 / iOS 配套工具库",
    "target_users": "需要与 iOS 设备交互的应用开发者，如设备管理、备份、调试、自动化测试工具开发者"
  },
