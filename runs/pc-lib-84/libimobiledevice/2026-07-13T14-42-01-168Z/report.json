  "function_summary": {
    "summary": "libimobiledevice 是一个跨平台 C 库，实现了与 iOS 设备通信的原生协议栈。它不依赖任何 Apple 专有库，无需越狱即可通过 USB 或 WiFi 连接到 iPhone/iPad 等设备，提供文件系统访问、备份恢复、应用安装管理、崩溃日志获取、设备信息查询、屏幕截图、调试代理等丰富的设备管理功能。附带一组命令行工具（idevice_id、idevicebackup2 等）和 Cython Python 绑定。",
    "categories": [
      {
        "name": "设备连接与配对",
        "description": "通过 USB (usbmuxd) 或 WiFi 发现并连接 iOS 设备，管理设备配对关系（Lockdown 协议），支持 TLS/SSL 加密通信（可选 OpenSSL/GnuTLS/MbedTLS）。",
        "evidence": [
          "src/idevice.c",
          "src/lockdown.c",
          "src/lockdown-cu.c",
          "src/service.c"
        ]
      },
      {
        "name": "文件系统访问",
        "description": "通过 AFC (Apple File Conduit) 和 House Arrest 协议访问设备文件系统，支持文件浏览、读写、目录操作。",
        "evidence": [
          "src/afc.c",
          "src/house_arrest.c",
          "src/file_relay.c"
        ]
      },
      {
        "name": "备份与恢复",
        "description": "实现 iTunes 兼容的本地备份和恢复协议（MobileBackup/MobileBackup2），支持完整备份及增量恢复。",
        "evidence": [
          "src/mobilebackup.c",
          "src/mobilebackup2.c"
        ]
      },
      {
        "name": "应用管理",
        "description": "通过 installation_proxy 和 misagent 协议安装、卸载、列出、管理设备上的应用，管理配置文件。",
        "evidence": [
          "src/installation_proxy.c",
          "src/misagent.c"
        ]
      },
      {
        "name": "设备信息与诊断",
        "description": "获取设备基本信息（型号、iOS 版本等）、崩溃日志、诊断数据、系统日志转发。支持激活设备、进入恢复模式。",
        "evidence": [
          "src/diagnostics_relay.c",
          "src/syslog_relay.c",
          "src/mobileactivation.c",
          "src/ostrace.c"
        ]
      },
      {
        "name": "开发者工具支持",
        "description": "提供调试服务代理（debugserver）、WebKit 远程调试连接（webinspector）、开发者磁盘镜像挂载（mobile_image_mounter）、位置模拟等服务，支持 iOS 开发调试场景。",
        "evidence": [
          "src/debugserver.c",
          "src/webinspector.c",
          "src/mobile_image_mounter.c",
          "src/companion_proxy.c"
        ]
      },
      {
        "name": "Python 绑定",
        "description": "通过 Cython 提供 Python 接口，可被 Python 应用调用以管理 iOS 设备。",
        "evidence": [
          "cython/imobiledevice.pyx",
          "cython/imobiledevice.pxd"
        ]
      }
    ],
    "domain": "移动设备管理",
    "target_users": "桌面应用开发者、自动化测试工程师、设备管理工具开发者",
    "ecosystem": "cpp"
  },
