  "function_summary": {
    "summary": "JOCL（Java OpenCL Binding）是 JogAmp 社区开发的 Java 到 OpenCL（开放计算语言）的绑定库，让 Java 程序可以直接访问 GPU、CPU 等异构计算设备进行并行计算。它封装了 OpenCL 1.1/1.2/2.0 的全部核心 API，并通过 NIO Direct Buffer 实现 Java 与原生 OpenCL 运行时的高效数据传输。项目还提供 JOGL 互操作层，使 OpenCL 计算与 OpenGL 图形渲染可共享 GPU 资源。",
    "categories": [
      {
        "name": "OpenCL 平台与设备管理",
        "description": "列举可用 OpenCL 平台（厂商实现）与计算设备（GPU/CPU/加速器），查询设备属性（CL_DEVICE_TYPE、CL_DEVICE_MAX_COMPUTE_UNITS 等）",
        "evidence": [
          "src/com/jogamp/opencl/CLPlatform.java",
          "src/com/jogamp/opencl/CLDevice.java"
        ]
      },
      {
        "name": "内存对象管理",
        "description": "创建 Buffer、Image2d/3d 等 OpenCL 内存对象，支持从 Java NIO Direct/Indirect Buffer 映射数据到设备内存，含读写传输",
        "evidence": [
          "src/com/jogamp/opencl/CLBuffer.java",
          "src/com/jogamp/opencl/CLMemory.java",
          "src/com/jogamp/opencl/CLImage2d.java",
          "src/com/jogamp/opencl/CLImage3d.java"
        ]
      },
      {
        "name": "内核执行与命令队列",
        "description": "创建 CommandQueue 提交内核执行任务，管理 Program 编译/链接，设置 Kernel 参数并启动并行计算，支持事件同步与性能分析",
        "evidence": [
          "src/com/jogamp/opencl/CLCommandQueue.java",
          "src/com/jogamp/opencl/CLProgram.java",
          "src/com/jogamp/opencl/CLKernel.java",
          "src/com/jogamp/opencl/CLEvent.java"
        ]
      },
      {
        "name": "JOGL 互操作（OpenCL-GL 共享）",
        "description": "允许 OpenCL 计算与 OpenGL 渲染共享 GPU 缓冲区/纹理等对象，通过 cl_khr_gl_sharing 扩展实现零拷贝数据交换",
        "evidence": [
          "src/com/jogamp/opencl/gl/CLGLContext.java",
          "src/com/jogamp/opencl/gl/CLGLBuffer.java",
          "src/com/jogamp/opencl/gl/CLGLTexture2d.java"
        ]
      },
      {
        "name": "高级并发工具",
        "description": "提供 CLCommandQueuePool 多队列池、CLMultiContext 多设备上下文、自定义工作拆分策略等高级工具，简化多 GPU/多设备并行编程",
        "evidence": [
          "src/com/jogamp/opencl/util/concurrent/CLCommandQueuePool.java",
          "src/com/jogamp/opencl/util/CLMultiContext.java"
        ]
      }
    ],
    "domain": "GPU 并行计算 / 异构计算",
    "target_users": "需要从 Java 进行 GPU/并行计算的科研人员、工程师和 Java 应用开发者",
    "ecosystem": "java"
  },
