  "function_summary": {
    "summary": "Branca 是一个从 folium 项目中分离出来的 Python 库，用于程序化生成 HTML+JavaScript 页面。它基于 Jinja2 模板引擎，提供了一套可组合的 Element 控件体系——每个 Element 可嵌套子元素、递归渲染为 HTML——以及配套的色阶工具（线性、阶梯、内置调色板方案）。主要面向需要用 Python 生成可视化网页的开发者，尤其是地图/数据可视化场景。",
    "categories": [
      {
        "name": "可组合 HTML Element 体系",
        "description": "提供 Element/Figure/Html/Div/IFrame/MacroElement 等类，支持层级嵌套、递归渲染为 HTML 字符串，并可通过 Jinja2 自定义模板。每个元素可指定模板、添加子元素、控制尺寸与定位。",
        "evidence": [
          "branca/element.py:27 Element class",
          "branca/element.py:238 Link",
          "branca/element.py:266 JavascriptLink",
          "branca/element.py:291 CssLink",
          "branca/element.py:316 Figure",
          "branca/element.py:476 Html",
          "branca/element.py:516 Div",
          "branca/element.py:622 IFrame",
          "branca/element.py:692 MacroElement"
        ]
      },
      {
        "name": "色阶工具 (Colormap)",
        "description": "提供 ColorMap 基类及 LinearColormap、StepColormap 子类，支持从定义的颜色点线性或阶梯插值生成色阶。内置 100+ 套 ColorBrewer 调色方案（通过 _schemes.json 引用），可在 Figure 中渲染为 D3.js 色带。",
        "evidence": [
          "branca/colormap.py:80 ColorMap class",
          "branca/colormap.py:246 LinearColormap",
          "branca/colormap.py:492 StepColormap",
          "branca/colormap.py:631 _LinearColormaps (内置方案)",
          "branca/colormap.py:654 _StepColormaps",
          "branca/colormap.py:97 _template = ENV.get_template(\"color_scale.js\")"
        ]
      },
      {
        "name": "Jinja2 模板渲染引擎",
        "description": "利用 Jinja2 的 Environment/PackageLoader 加载 branca/templates/ 下的 JS/HTML 模板，在 Element.render() 时将元素数据注入模板生成最终输出。",
        "evidence": [
          "branca/element.py:24 ENV = Environment(loader=PackageLoader(\"branca\", \"templates\"))",
          "branca/element.py:97 _template: Template = ENV.get_template(\"color_scale.js\")",
          "branca/templates/color_scale.js"
        ]
      },
      {
        "name": "辅助工具",
        "description": "提供 legend_scaler（图例标签去重）、linear_gradient（颜色线性插值）、color_brewer（ColorBrewer 方案查询）、write_png（数组转 PNG 字节流，依赖 NumPy）、image_to_url（图片转 base64 data URI）等工具函数。",
        "evidence": [
          "branca/utilities.py:41 legend_scaler",
          "branca/utilities.py:63 linear_gradient",
          "branca/utilities.py:106 color_brewer",
          "branca/utilities.py:252 write_png",
          "branca/utilities.py:203 image_to_url"
        ]
      }
    ],
