  "function_summary": {
    "summary": "Branca 是从 folium 项目拆分出来的 Python 库，专注于通过 Jinja2 模板生成复杂的 HTML + JavaScript 页面。它提供线性/分段颜色映射、内置 ColorBrewer 配色方案，以及 Figure、Div、IFrame、Html 等可组合元素，帮助数据可视化与 Web 地图类库构建可嵌入网页的交互式组件。",
    "categories": [
      {
        "name": "HTML/JS 页面生成",
        "description": "基于 Jinja2 模板渲染可嵌套的 HTML 元素树，支持将子元素按 header、html、script 三段注入最终页面。",
        "evidence": [
          "branca/element.py:24 ENV = Environment(loader=PackageLoader(\"branca\", \"templates\"))",
          "branca/element.py:692 MacroElement.render 注入 header/html/script 三段",
          "branca/templates/color_scale.js Jinja2 宏模板"
        ]
      },
      {
        "name": "颜色映射",
        "description": "提供线性（LinearColormap）与分段（StepColormap）颜色映射，支持颜色插值、缩放、转换及内置 ColorBrewer 配色方案。",
        "evidence": [
          "branca/colormap.py:80 ColorMap 基类",
          "branca/colormap.py:246 LinearColormap",
          "branca/colormap.py:492 StepColormap",
          "branca/utilities.py:106 color_brewer"
        ]
      },
      {
        "name": "可视化组件",
        "description": "提供 Figure、Div、IFrame、Html、JavascriptLink、CssLink 等组件，用于在 Jupyter Notebook 或独立网页中组装可视化布局。",
        "evidence": [
          "branca/element.py:316 Figure",
          "branca/element.py:516 Div",
          "branca/element.py:622 IFrame",
          "branca/element.py:476 Html"
        ]
      },
      {
        "name": "图像内联工具",
        "description": "将文件、数组或颜色映射后的单通道数据转换为 data URI 形式的内联 PNG，便于在生成的 HTML 中直接嵌入图片。",
        "evidence": [
          "branca/utilities.py:203 image_to_url",
          "branca/utilities.py:252 write_png"
        ]
      }
    ],
    "domain": "数据可视化 / Web 页面生成",
    "target_users": "数据可视化库开发者、Web 地图应用开发者、Jupyter Notebook 用户"
  },
