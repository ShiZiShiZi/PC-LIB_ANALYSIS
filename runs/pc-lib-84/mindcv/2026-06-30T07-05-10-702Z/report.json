  "function_summary": {
    "summary": "MindCV 是基于 MindSpore 深度学习框架的计算机视觉工具箱，集成了 50 余种经典与前沿视觉模型（涵盖 ResNet、SwinTransformer、EfficientNet、ConvNeXt 等主流架构），并提供预训练权重、数据增强策略（AutoAugment/RandAugment/MixUp/CutMix）、学习率调度、优化器及完整的训练/验证/推理流水线。采用解耦模块化设计，用户可通过工厂函数（create_model、create_dataset、create_loader 等）快速组合数据、模型与训练策略，也可通过命令行一键完成迁移学习或模型训练。",
    "categories": [
      {
        "name": "视觉模型库",
        "description": "提供 50+ 种 CNN 与 Transformer 架构的视觉模型实现，包括 ResNet/VGG/MobileNet/EfficientNet/ConvNeXt/SwinTransformer/ViT 等，每个模型附带预训练权重和 ImageNet 基准结果",
        "evidence": [
          "mindcv/models/__init__.py",
          "mindcv/models/model_factory.py",
          "mindcv/models/registry.py"
        ]
      },
      {
        "name": "数据处理与增强",
        "description": "提供标准数据集的创建接口（ImageNet/CIFAR/MNIST），以及多种图像增强策略，包括 AutoAugment、RandAugment、AugMix、TrivialAugmentWide、MixUp、CutMix 等前沿方法",
        "evidence": [
          "mindcv/data/__init__.py",
          "mindcv/data/dataset_factory.py",
          "mindcv/data/transforms_factory.py",
          "mindcv/data/auto_augment.py",
          "mindcv/data/mixup.py",
          "mindcv/data/loader.py"
        ]
      },
      {
        "name": "损失函数",
        "description": "提供交叉熵平滑损失、二元交叉熵平滑损失、非对称损失（Asymmetric Loss）、JSD 交叉熵等多种损失函数实现",
        "evidence": [
          "mindcv/loss/__init__.py",
          "mindcv/loss/loss_factory.py",
          "mindcv/loss/asymmetric.py",
          "mindcv/loss/cross_entropy_smooth.py"
        ]
      },
      {
        "name": "优化器与学习率调度",
        "description": "实现 AdamW、Lion、Adan、NAdam 等优化器，以及余弦退火/阶梯/指数/多项式/循环等学习率调度策略，支持逐层学习率衰减与预热",
        "evidence": [
          "mindcv/optim/optim_factory.py",
          "mindcv/optim/adamw.py",
          "mindcv/optim/lion.py",
          "mindcv/scheduler/scheduler_factory.py"
        ]
      },
      {
        "name": "训练与推理流水线",
        "description": "提供完整的训练、验证与推理脚本，支持分布式训练、自动混合精度、EMA、梯度累积、梯度裁剪等训练技巧，以及模型检查点管理和训练状态监控",
        "evidence": [
          "train.py",
          "validate.py",
          "infer.py",
          "mindcv/utils/trainer_factory.py",
          "mindcv/utils/callbacks.py",
          "mindcv/utils/train_step.py"
        ]
      }
    ],
    "domain": "计算机视觉 / 深度学习",
