  "function_summary": {
    "summary": "pyreadline3 是面向 Windows 的 GNU readline 功能纯 Python 实现，通过 ctypes 直接调用 Win32 Console API 与 Win32 Clipboard API，为 CPython 解释器补齐命令行编辑、键位绑定、历史记录、复制粘贴等交互能力。它作为 drop-in 的 readline 替代品被其它 Python 程序（如 cmd、pdb、IPython）导入使用，不支持 Windows 以外的平台。",
    "categories": [
      {
        "name": "Windows 控制台驱动",
        "description": "通过 ctypes 调用 kernel32/user32 等 Win32 Console API，实现控制台句柄获取、输入事件读取、光标控制、屏幕缓冲、颜色属性与标题管理。",
        "evidence": [
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/console/console.py:201",
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/console/console.py:159-185"
        ]
      },
      {
        "name": "readline 状态与回调绑定",
        "description": "维护 readline 全局状态，暴露 parse_and_bind、set_completer、add_history 等标准接口，并通过 CPython C-API 的 PyOS_ReadlineFunctionPointer 将 Python 实现的回调注册到解释器。",
        "evidence": [
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/rlmain.py:60-90",
          "repos/pc-lib-84/pyreadline3/src/readline.py:12-38",
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/console/console.py:868-885"
        ]
      },
      {
        "name": "行编辑与编辑模式",
        "description": "提供 Emacs、Vi 与 NotEmacs 三种编辑模式，处理字符/单词移动、选择、删除、撤销、历史搜索等行内编辑操作。",
        "evidence": [
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/modes/emacs.py",
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/modes/vi.py",
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/modes/notemacs.py"
        ]
      },
      {
        "name": "历史记录管理",
        "description": "维护命令历史缓冲，支持从 ~/.history 文件读写持久化历史，并提供前向/反向搜索。",
        "evidence": [
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/lineeditor/history.py:22-97",
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/rlmain.py:141-150"
        ]
      },
      {
        "name": "剪贴板交互",
        "description": "通过 Win32 Clipboard API 实现系统剪贴板的读取与写入，支持复制、粘贴与 ipython_paste 等高级粘贴行为。",
        "evidence": [
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/clipboard/win32_clipboard.py",
          "repos/pc-lib-84/pyreadline3/src/pyreadline3/clipboard/api.py"
        ]
      },
      {
        "name": "按键符号映射",
        "description": "将 Windows 虚拟键码与输入记录转换为 readline 可识别的 KeyPress 对象，并提供字符到虚拟键码的转换。",
