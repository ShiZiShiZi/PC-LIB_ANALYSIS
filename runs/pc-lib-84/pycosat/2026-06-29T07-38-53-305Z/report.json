  "function_summary": {
    "summary": "pycosat 是 PicoSAT（由 Armin Biere 编写的纯 C SAT 求解器）的 Python 绑定库。它将 PicoSAT 以 C 扩展模块形式集成到 Python 进程中，提供 solve 和 itersolve 两个核心函数，用于求解布尔可满足性问题（SAT）并枚举所有解。主要面向需要在 Python 中调用高效 SAT 求解器的开发者和其他库。",
    "categories": [
      {
        "name": "SAT 求解",
        "description": "调用 PicoSAT 求解给定子句集合，返回一个满足赋值、字符串 'UNSAT'（不可满足）或 'UNKNOWN'（达到传播限制未决）。",
        "evidence": [
          "pycosat.c:solve",
          "picosat.h:picosat_sat",
          "README.rst:17"
        ]
      },
      {
        "name": "多解枚举",
        "description": "itersolve 将 SAT 求解结果封装为 Python 迭代器，通过不断添加阻塞子句来逐个返回所有满足赋值；C 层实现避免反复转换子句列表。",
        "evidence": [
          "pycosat.c:itersolve",
          "pycosat.c:soliter_next",
          "pycosat.c:blocksol",
          "README.rst:27"
        ]
      },
      {
        "name": "Python C 扩展绑定",
        "description": "使用 Python C-API 将 PicoSAT C 接口包装为 Python 模块，处理参数解析、子句/文字的 Python 对象迭代、GIL 释放与迭代器协议。",
        "evidence": [
          "pycosat.c:setup_picosat",
          "pycosat.c:add_clause",
          "pycosat.c:module_functions",
          "setup.py"
        ]
      },
      {
        "name": "求解器配置",
        "description": "支持 prop_limit（传播限制）、vars（变量数）、verbose（详细级别）等参数，并可输出求解统计信息。",
        "evidence": [
          "pycosat.c:setup_picosat",
          "pycosat.c:solve",
          "README.rst:31"
        ]
      }
    ],
