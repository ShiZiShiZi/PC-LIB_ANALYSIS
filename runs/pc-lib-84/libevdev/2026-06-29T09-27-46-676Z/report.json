  "function_summary": {
    "summary": "libevdev 是 Linux evdev 输入设备的封装库，将对 /dev/input/eventX 设备的 ioctl 操作抽象为类型安全的 C API。它处理事件读取、SYN_DROPPED 同步、多触点（MT）槽位状态管理、设备能力查询，以及通过 /dev/uinput 创建虚拟输入设备。该库是 Linux 输入栈中的基础组件，位于内核 evdev 驱动与上层输入处理程序（如 libinput）之间。",
    "categories": [
      {
        "name": "evdev 设备初始化与文件描述符管理",
        "description": "创建 libevdev 上下文、关联/切换文件描述符、设备抓取（EVIOCGRAB）与释放",
        "evidence": [
          "libevdev/libevdev.h:libevdev_new",
          "libevdev/libevdev.h:libevdev_set_fd",
          "libevdev/libevdev.h:libevdev_grab"
        ]
      },
      {
        "name": "设备能力与状态查询",
        "description": "查询设备支持的事件类型/代码、输入属性、轴范围、按键/LED/开关当前状态、多触点槽位信息",
        "evidence": [
          "libevdev/libevdev.h:libevdev_has_event_type",
          "libevdev/libevdev.h:libevdev_has_event_code",
          "libevdev/libevdev.c:517:EVIOCGABS"
        ]
      },
      {
        "name": "事件读取与 SYN_DROPPED 同步",
        "description": "从设备读取事件、处理内核 SYN_DROPPED 通知、重新同步设备状态（包括 MT 槽位与触摸点追踪 ID）",
        "evidence": [
          "libevdev/libevdev.h:libevdev_next_event",
          "libevdev/libevdev.c:924:sync_state",
          "libevdev/libevdev.c:935:drain_events"
        ]
      },
      {
        "name": "uinput 虚拟设备创建与事件注入",
        "description": "基于已有 libevdev 设备或从零构建 uinput 虚拟输入设备，向虚拟设备写入事件",
        "evidence": [
          "libevdev/libevdev-uinput.h:libevdev_uinput_create_from_device",
          "libevdev/libevdev-uinput.h:libevdev_uinput_write_event",
          "libevdev/libevdev-uinput.c:411:UI_DEV_CREATE"
        ]
      },
      {
        "name": "事件名称映射与辅助工具",
        "description": "事件类型/代码与字符串名称的互查、事件范围查询、修改设备外观参数",
