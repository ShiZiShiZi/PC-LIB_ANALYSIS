  "function_summary": {
    "summary": "esptool 是 Espressif（乐鑫）官方维护的跨平台命令行工具集，用于通过串口（UART/USB）与 ESP32 系列 SoC 进行交互。核心功能包括：将固件/程序烧录到 SPI Flash、读取 Flash 内容、擦除 Flash、获取芯片信息（型号/特性/MAC 地址/Flash 大小）、操作 eFuse（一次性可编程存储器）以及管理安全启动与 Flash 加密的签名密钥。工具集支持 ESP32/ESP32-S2/ESP32-S3/ESP32-C2/ESP32-C3/ESP32-C5/ESP32-C6/ESP32-C61/ESP32-H2 等全系列芯片，提供自动芯片检测和波特率自适应。附带一个 RFC 2217 串口转 TCP 重定向服务器，方便远程调试。",
    "categories": [
      {
        "name": "固件烧录与 Flash 管理",
        "description": "通过串口将固件镜像烧录到 ESP32 的 SPI Flash 中，支持多种镜像格式（bin/hex/UF2/ELF）、分区表烧录、Flash 读取/擦除/校验，以及基于 stub 的高效烧录协议。"
      },
      {
        "name": "芯片信息查询与诊断",
        "description": "读取芯片型号、特性、MAC 地址、Flash 芯片 ID、安全状态等信息，帮助开发者识别和诊断硬件。"
      },
      {
        "name": "安全密钥管理",
        "description": "管理 ESP32 安全启动（Secure Boot V1/V2）和 Flash 加密的签名密钥——生成 RSA/ECDSA 密钥对、对固件镜像摘要签名、摘要验证，以及管理硬件安全模块（HSM）辅助签名。"
      },
      {
        "name": "eFuse 配置",
        "description": "读取、写入和配置 ESP32 芯片的一次性可编程 eFuse 存储器，包括安全启动、Flash 加密、电压配置、JTAG 禁用、MAC 地址定制等烧录后不可逆的芯片级配置。"
      },
      {
        "name": "串口通信基础设施",
        "description": "提供串口参数配置（波特率/流控）、芯片自动检测、复位策略管理（DTR/RTS/EN 引脚的经典复位/USB-JTAG-Serial 复位/自定义复位序列），以及 RFC 2217 串口转 TCP 重定向服务。"
      }
    ],
    "domain": "嵌入式开发 / IoT",
    "target_users": "嵌入式固件开发者、物联网产品工程师、生产烧录产线操作员",
    "meta": {}
  },
