  "function_summary": {
    "summary": "esptool 是一套基于 Python 的命令行工具集，用于通过串口与 Espressif 系列 SoC（如 ESP32、ESP8266 等）进行通信，完成固件烧录、Flash 读写与擦除、eFuse 配置、安全启动/加密签名以及芯片检测等任务。 additionally 提供 esp_rfc2217_server 将本地串口透传为 RFC2217 TCP 服务，面向嵌入式开发者与硬件工程师。",
    "categories": [
      {
        "name": "固件烧录与 Flash 操作",
        "description": "通过串口将固件写入 ESP 片外 Flash，并支持读取、擦除、校验与参数配置",
        "evidence": ["esptool/cmds.py:write_flash", "esptool/cmds.py:read_flash", "esptool/cmds.py:erase_flash", "esptool/cmds.py:verify_flash", "esptool/loader.py:ESPLoader.command"]
      },
      {
        "name": "芯片检测与连接",
        "description": "自动识别芯片型号、建立 ROM bootloader 同步连接、选择 reset 策略并协商波特率",
        "evidence": ["esptool/cmds.py:detect_chip", "esptool/loader.py:ESPLoader.connect", "esptool/loader.py:ESPLoader._construct_reset_strategy_sequence", "esptool/reset.py:ResetStrategy"]
      },
      {
        "name": "固件镜像转换",
        "description": "将 ELF 转换为可烧录镜像、合并多个二进制文件、输出 Intel Hex / UF2 格式并解析镜像信息",
        "evidence": ["esptool/cmds.py:elf2image", "esptool/cmds.py:merge_bin", "esptool/cmds.py:image_info", "esptool/bin_image.py"]
      },
      {
        "name": "eFuse 配置",
        "description": "通过 espefuse 子工具读写 ESP eFuse，支持多芯片的熔丝字段定义与烧写确认",
        "evidence": ["espefuse/__init__.py:cli", "espefuse/efuse/base_operations.py", "espefuse/efuse/fields.py"]
      },
      {
        "name": "安全启动与加密",
        "description": "通过 espsecure 子工具生成密钥、签名/验证 bootloader 与应用程序、处理安全启动 V2 与 Flash 加密",
        "evidence": ["espsecure/__init__.py:digest_secure_bootloader", "espsecure/__init__.py:sign_secure_boot", "espsecure/__init__.py:encrypt_flash_data"]
      },
      {
        "name": "RFC2217 串口网络转发",
        "description": "将本地串口数据通过 RFC2217 协议转发到 TCP 网络，支持远程串口访问",
        "evidence": ["esp_rfc2217_server/__init__.py:main", "esp_rfc2217_server/redirector.py", "esp_rfc2217_server/esp_port_manager.py"]
      }
    ],
    "domain": "embedded systems",
    "target_users": "嵌入式开发者、硬件工程师及 ESP 生态用户"
  },
