  "function_summary": {
    "summary": "systeminformation 是一个面向 Node.js 后端的系统信息采集库，通过执行平台原生命令（PowerShell/WMI、Linux shell、macOS system_profiler/sysctl 等）和读取 /proc、/sys、注册表等系统文件，为上层应用提供统一的 JavaScript API 来获取 CPU、内存、网络、磁盘、电池、蓝牙、USB、Docker、进程、图形、音频等全方位硬件与操作系统信息。该库无第三方依赖，纯 JavaScript 实现，支持 Windows、Linux、macOS、FreeBSD、OpenBSD、NetBSD 等多平台。",
    "categories": [
      {
        "name": "CPU 信息与负载监控",
        "description": "获取 CPU 型号、频率、核心数、缓存、温度、标志位、当前负载与速度等",
        "evidence": [
          "lib/cpu.js"
        ]
      },
      {
        "name": "内存信息",
        "description": "获取物理内存与交换空间总量、使用率、内存布局（DIMM 详情）等",
        "evidence": [
          "lib/memory.js"
        ]
      },
      {
        "name": "网络接口与连接",
        "description": "获取网络接口详情、IP 地址、网络统计、网络连接列表、默认网关等",
        "evidence": [
          "lib/network.js"
        ]
      },
      {
        "name": "文件系统与磁盘",
        "description": "获取磁盘分区、文件系统大小、磁盘 IO 统计、块设备、磁盘布局等",
        "evidence": [
          "lib/filesystem.js"
        ]
      },
      {
        "name": "操作系统信息",
        "description": "获取 OS 版本、发行版、内核、主机名、UUID、已安装软件版本等",
        "evidence": [
          "lib/osinfo.js"
        ]
      },
      {
        "name": "系统硬件信息",
