          "src/core/chromepalette.cpp"
        ]
      },
      {
        "name": "标准标题栏与系统按钮",
        "description": "提供预构建的标准标题栏控件（含最小化/最大化/关闭按钮），支持 Qt Widgets 和 Qt Quick",
