  "function_summary": {
    "summary": "RobotJS 是一个 Node.js 桌面自动化库，底层用 C/C++ 实现并通过 N-API 暴露给 JavaScript。它提供鼠标移动/点击/拖拽/滚动、键盘按键/输入字符串/Unicode 输入、屏幕截图/像素颜色读取、剪贴板操作以及弹窗提示等功能。该库通过条件编译在 macOS（CoreGraphics/Carbon/IOKit）、Windows（SendInput/GDI）和 Linux/X11（XTest/Xlib）三个平台上实现了统一的跨平台 API。",
    "categories": [
      {
        "name": "鼠标控制",
        "description": "移动鼠标、点击（左/右/中键）、拖拽、滚动、获取鼠标位置，支持平滑移动动画",
        "evidence": [
          "src/mouse.c",
          "src/robotjs.cc:101-302"
        ]
      },
      {
        "name": "键盘控制",
        "description": "模拟按键敲击、按住/释放、Unicode 字符输入、字符串输入（含速率控制），支持修饰键组合",
        "evidence": [
          "src/keypress.c",
          "src/robotjs.cc:505-700"
        ]
      },
      {
        "name": "屏幕捕获与像素操作",
        "description": "截取屏幕指定区域为位图、获取单个像素颜色、获取屏幕尺寸，支持位图颜色查询",
        "evidence": [
          "src/screengrab.c",
          "src/screen.c",
          "src/robotjs.cc:738-867"
        ]
      },
      {
        "name": "剪贴板操作",
        "description": "将位图数据复制到系统剪贴板（macOS 使用 Pasteboard API，Windows 使用 Win32 Clipboard API，Linux 暂不支持）",
        "evidence": [
          "src/pasteboard.c"
        ]
      },
      {
        "name": "弹窗提示",
        "description": "显示系统弹窗/对话框（macOS 使用 CFUserNotification，Linux 使用 xmessage，Windows 使用 MessageBox）",
        "evidence": [
          "src/alert.c"
        ]
      },
      {
        "name": "图像编解码",
        "description": "PNG 读写（基于 libpng）和 BMP 读写，用于屏幕截图的保存与加载",
        "evidence": [
          "src/png_io.c",
          "src/bmp_io.c",
          "src/io.c"
        ]
      }
    ],
