  "function_summary": {
    "summary": "RobotJS 是一个 Node.js 桌面自动化库，提供跨平台（Windows/macOS/Linux）的鼠标操作、键盘输入与屏幕读取能力。通过 N-API 原生 C/C++ 扩展将各平台底层 API（Win32、X11、macOS CoreGraphics）封装为统一的 JavaScript 接口，适合 GUI 自动化测试、桌面脚本与辅助工具开发。",
    "categories": [
      {
        "name": "鼠标控制",
        "description": "获取/设置鼠标位置、移动（即时/平滑）、左/右/中键点击与拖拽",
        "evidence": [
          "src/mouse.c",
          "src/robotjs.cc:52-303"
        ]
      },
      {
        "name": "键盘输入",
        "description": "按键按下/释放/连击、字符串输入与字母延迟输入，支持修饰键组合",
        "evidence": [
          "src/keypress.c",
          "src/keycode.c",
          "src/robotjs.cc:311-715"
        ]
      },
      {
        "name": "屏幕读取",
        "description": "获取指定像素颜色值（hex）、截取指定区域屏幕并编码为 PNG/BMP 位图",
        "evidence": [
          "src/screen.c",
          "src/screengrab.c",
          "src/robotjs.cc:731-867"
        ]
      },
      {
        "name": "图像处理",
        "description": "位图创建/销毁、像素访问、颜色查找与模板匹配",
        "evidence": [
          "src/MMBitmap.c",
          "src/color_find.c",
          "src/bitmap_find.c",
          "src/bmp_io.c",
          "src/png_io.c"
        ]
      }
    ],
    "domain": "桌面自动化",
    "target_users": "Node.js 自动化脚本开发者与 GUI 测试工程师",
    "ecosystem": "nodejs"
  },
