  "function_summary": {
    "summary": "debugpy 是微软开源的 Python 调试器，完整实现了 Debug Adapter Protocol (DAP)，为 VS Code、PyCharm 等 IDE/编辑器提供 Python 代码的调试能力。它由一个运行在调试目标进程内的调试服务器、一个与 IDE 通信的协议适配器、以及一个进程启动/注入器组成——三者通过 socket 通信，支持本地和远程调试。核心引擎基于内嵌的 PyDev.Debugger (pydevd)，这是一个久经考验的 Python 调试后端，提供断点、单步执行、变量检查、表达式求值、调用栈查看等完整的调试功能。debugpy 可被 IDE 作为库集成，也可通过命令行直接启动调试会话。",
    "categories": [
      {
        "name": "调试协议适配",
        "description": "完整实现 Debug Adapter Protocol (DAP)，将 IDE 的标准调试请求（设置断点、单步执行、变量查看等）翻译为 pydevd 调试引擎的操作，并将调试事件（命中断点、异常等）转发回 IDE。",
        "evidence": [
          "src/debugpy/adapter/sessions.py",
          "src/debugpy/adapter/servers.py",
          "src/debugpy/adapter/clients.py"
        ]
      },
      {
        "name": "调试服务器",
        "description": "嵌入在被调试进程内的调试服务器，通过 socket 与适配器通信，控制代码执行流（暂停/继续/单步）、管理断点和异常处理、收集调用栈和变量信息。",
        "evidence": [
          "src/debugpy/server/api.py",
          "src/debugpy/server/attach_pid_injected.py",
          "src/debugpy/server/cli.py"
        ]
      },
      {
        "name": "进程启动与注入",
        "description": "支持多种调试启动方式——直接启动 Python 脚本/模块、attach 到运行中的进程（通过 sys.remote_exec 或 pydevd attach）、以及管理子进程调试（自动注入到被调试进程 fork 出的子进程）。",
        "evidence": [
          "src/debugpy/launcher/debuggee.py",
          "src/debugpy/launcher/winapi.py",
          "src/debugpy/server/cli.py:attch_to_pid"
        ]
      },
      {
        "name": "断点与代码执行控制",
        "description": "支持行断点、条件断点、日志点（logpoint）、异常断点，以及多种单步模式（逐行/逐语句/跳出）。依托 pydevd 引擎提供异常过滤和捕获配置。",
        "evidence": [
          "src/debugpy/_vendored/pydevd/_pydevd_bundle/pydevd_process_net_command_json.py",
          "src/debugpy/adapter/breakpoints.py"
        ]
      },
      {
        "name": "变量查看与表达式求值",
        "description": "支持在调试暂停时查看局部/全局变量、对象属性、集合元素等，并支持在调试上下文中执行任意 Python 表达式求值。提供变量格式化、截断大对象等功能。",
        "evidence": [
          "src/debugpy/adapter/variables.py",
          "src/debugpy/adapter/evaluate.py"
        ]
      },
      {
        "name": "远程调试",
        "description": "通过 TCP socket 通信，支持将调试服务器与适配器/IDE 分离部署，实现跨机器远程调试。支持指定监听地址和端口，可配置访问令牌进行认证。",
        "evidence": [
          "src/debugpy/common/sockets.py",
          "src/debugpy/adapter/servers.py:listen"
        ]
      }
    ],
