  "function_summary": {
    "summary": "leveldown 是 LevelDB 嵌入式键值数据库的 Node.js 原生 C++ 绑定（已被 classic-level 取代）。作为底层桥接层，它将 LevelDB 的 C++ API（包括键值 CRUD、批量写入、迭代器、范围查询、压缩与修复等）通过 N-API 暴露给 Node.js，使用 node-gyp-build 跨平台分发预编译二进制。依赖 Google Snappy 压缩库和抽象接口 abstract-leveldown，面向需要高性能嵌入式本地持久化存储的 Node.js 应用开发者。",
    "categories": [
      {
        "name": "键值存储核心操作",
        "description": "提供 LevelDB 数据库的打开/关闭、键值对的插入（put）、查询（get）、批量查询（getMany）和删除（del）操作，支持同步和异步两种模式",
        "evidence": [
          "binding.cc:932-1004 (OpenWorker)",
          "binding.cc:1059-1101 (PutWorker)",
          "binding.cc:1144-1159 (db_get)",
          "binding.cc:1235-1249 (db_get_many)"
        ]
      },
      {
        "name": "批量写入与链式操作",
        "description": "支持 LevelDB 原子批量写入（WriteBatch），提供链式 API 用于构建批量操作序列，确保一组写操作原子执行",
        "evidence": [
          "binding.cc:1690-1740 (batch_write)",
          "binding.cc:1605-1640 (batch_put/del/clear)",
          "chained-batch.js"
        ]
      },
      {
        "name": "迭代器与范围遍历",
        "description": "提供 LevelDB 双向迭代器接口，支持按键范围遍历、随机定位（seek）和方向控制，可选择性返回键、值或两者",
        "evidence": [
          "binding.cc:590-771 (BaseIterator)",
          "binding.cc:776-867 (Iterator)",
          "iterator.js"
        ]
      },
      {
        "name": "数据库管理工具",
        "description": "提供数据库销毁（destroy）、修复（repair）、空间估算（approximateSize）、键范围压缩（compactRange）和内部属性查询（getProperty）等管理功能",
        "evidence": [
          "binding.cc:1741-1804 (db_approximate_size)",
          "binding.cc:1805-1873 (db_compact_range)",
          "binding.cc:1875-1931 (db_get_property)",
          "binding.cc:1933-1982 (destroy_db)",
          "binding.cc:1984-2026 (repair_db)"
        ]
      },
      {
        "name": "预编译跨平台分发",
        "description": "通过 node-gyp-build 分发预编译二进制，支持 Linux/x64/ARM、macOS/x64/ARM64、Windows/x64、Android/ARM 等多平台，无需本地编译即可安装",
        "evidence": [
          "binding.js",
          "package.json:scripts.prebuild",
          "binding.gyp"
        ]
      }
    ],
    "domain": "数据库存储引擎",
    "target_users": "需要嵌入式本地键值存储的 Node.js 应用开发者",
    "ecosystem": "nodejs"
