  "function_summary": {
    "summary": "OpenCL-SDK 是 Khronos Group 发布的 OpenCL 官方软件开发工具包，将 OpenCL 头文件、C++ 绑定、ICD 加载器以及一组实用工具库打包为统一的 CMake 构建项目。开发者通过本 SDK 即可获得编写、编译、链接和运行 OpenCL 程序的全部基础组件，无需单独配置各依赖项。",
    "categories": [
      {
        "name": "OpenCL API 头文件",
        "description": "提供 OpenCL C 语言 API 的全部类型定义、常量与函数声明，是编译任何 OpenCL 程序的必备头文件集合",
        "evidence": [
          "external/OpenCL-Headers/",
          "lib/include/CL/cl.h"
        ]
      },
      {
        "name": "OpenCL C++ 绑定",
        "description": "在 C API 之上提供类型安全、RAII 式的 C++ 封装，简化资源生命周期管理与错误处理",
        "evidence": [
          "external/OpenCL-CLHPP/include/"
        ]
      },
      {
        "name": "OpenCL ICD 加载器",
        "description": "实现 OpenCL 可安装客户端驱动（ICD）机制，在运行时动态发现并加载平台上已安装的各厂商 OpenCL 实现",
        "evidence": [
          "external/OpenCL-ICD-Loader/"
        ]
      },
      {
        "name": "实用工具库",
        "description": "提供 OpenCL 常见任务的便捷封装：设备/平台枚举与查询、上下文创建、事件耗时测量、错误日志、文件读取等",
        "evidence": [
          "lib/include/CL/Utils/",
          "lib/src/Utils/"
        ]
      },
      {
        "name": "SDK 工具库",
        "description": "面向 SDK 示例代码的通用工具：命令行解析、伪随机数生成（PCG）、BMP/PNG/JPEG 图像读写、OpenCL-OpenGL 互操作辅助",
        "evidence": [
          "lib/include/CL/SDK/",
          "lib/src/SDK/"
        ]
      },
      {
        "name": "代码示例与文档",
        "description": "提供涵盖 OpenCL 核心 API（设备查询、SAXPY、归约、图像处理、多设备、外部内存）的可编译示例程序及说明文档",
        "evidence": [
          "samples/",
          "docs/"
        ]
      }
    ],
    "domain": "异构并行计算 / GPGPU",
    "target_users": "使用 OpenCL 进行 GPU/异构并行编程的 C/C++ 应用程序开发者"
  },
