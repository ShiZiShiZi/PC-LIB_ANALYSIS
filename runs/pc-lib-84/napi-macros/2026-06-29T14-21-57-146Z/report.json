  "function_summary": {
    "summary": "napi-macros 是一组 C 预处理器宏，用于简化 Node.js N-API 原生插件的开发。它将 N-API 的样板代码（模块初始化、参数解析、值返回、函数导出等）封装为简洁的宏调用，使开发者可以用最少的 C 代码编写 Node.js 原生扩展。目标用户是编写 Node.js N-API 原生插件的 C/C++ 开发者。",
    "categories": [
      {
        "name": "模块初始化与函数导出",
        "description": "提供 NAPI_INIT()、NAPI_EXPORT_FUNCTION()、NAPI_EXPORT_UINT32() 等宏，封装 N-API 模块注册和导出样板代码，包括 NAPI_MODULE 声明和 napi_set_named_property 调用。",
        "evidence": [
          "napi-macros.h:4-11",
          "napi-macros.h:139-158"
        ]
      },
      {
        "name": "参数解析",
        "description": "提供 NAPI_ARGV()、NAPI_ARGV_INT32()、NAPI_ARGV_UINT32()、NAPI_ARGV_UTF8()、NAPI_ARGV_BUFFER() 等宏，从 JavaScript 调用参数中提取 C 类型值，含类型检查与自动抛错。",
        "evidence": [
          "napi-macros.h:204-253"
        ]
      },
      {
        "name": "值返回",
        "description": "提供 NAPI_RETURN_INT32()、NAPI_RETURN_UINT32()、NAPI_RETURN_UTF8()、NAPI_RETURN_STRING() 等宏，将 C 值转换为 napi_value 并返回给 JavaScript。",
        "evidence": [
          "napi-macros.h:170-186"
        ]
      },
      {
        "name": "类型导出工具",
        "description": "提供 NAPI_EXPORT_SIZEOF()、NAPI_EXPORT_ALIGNMENTOF()、NAPI_EXPORT_OFFSETOF() 等宏，将 C 类型的内存布局信息（大小、对齐、偏移）导出为 JavaScript 常量。",
        "evidence": [
          "napi-macros.h:68-137"
        ]
      },
      {
        "name": "错误处理与辅助工具",
        "description": "提供 NAPI_STATUS_THROWS()、NAPI_UV_THROWS()、NAPI_MAKE_CALLBACK()、NAPI_TEST_GC() 等宏，封装 N-API 状态检查、libuv 错误抛出、回调安全调用和 GC 触发等辅助功能。",
        "evidence": [
          "napi-macros.h:13-22",
          "napi-macros.h:39-66"
        ]
      }
    ],
    "domain": "native_bindings",
    "target_users": "编写 Node.js N-API 原生插件的 C/C++ 开发者"
