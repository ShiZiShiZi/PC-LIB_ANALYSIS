  "function_summary": {
    "summary": "TensorFlow 是由 Google Brain 团队开发的端到端开源机器学习平台，以 C++ 为核心实现计算图运行时与算子库，通过 Python 作为主要用户接口对外提供高层 API（Keras、tf.data、tf.train 等）。它支持 CPU、GPU（CUDA/ROCm）、TPU 等多种硬件后端，提供从模型定义、训练、评估到部署的完整工作流。TensorFlow Lite 为移动/嵌入式端提供轻量推理引擎，TensorFlow.js 支持浏览器与 Node.js 推理。项目体量巨大（生产代码约 238 万行），涵盖图构建、算子实现、分布式运行、XLA 编译优化、性能分析器等核心子系统。",
    "categories": [
      {
        "name": "张量计算与算子库",
        "description": "提供数千种数学/逻辑/神经网络算子（卷积、矩阵乘、归约、激活函数等），在 CPU/GPU/TPU 上执行，涵盖 tensorflow/core/kernels 与 tensorflow/core/ops",
        "evidence": [
          "tensorflow/core/kernels/",
          "tensorflow/core/ops/"
        ]
      },
      {
        "name": "计算图与运行时",
        "description": "基于数据流图（Graph）的执行引擎，支持即时执行（eager）与图模式，含会话管理、图优化（Grappler）、函数追踪等",
        "evidence": [
          "tensorflow/core/graph/graph.h",
          "tensorflow/core/common_runtime/"
        ]
      },
      {
        "name": "GPU 加速与 CUDA/ROCm 后端",
        "description": "通过 Stream Executor 与 CUDA Driver/Runtime API 实现 GPU 加速计算，支持 cuBLAS/cuDNN/cuFFT/NCCL 等 NVIDIA 库，同时提供 AMD ROCm (HIP) 后端",
        "evidence": [
          "tensorflow/core/kernels/*_gpu.cu.cc",
          "third_party/xla/xla/stream_executor/cuda/",
          "third_party/xla/xla/stream_executor/rocm/"
        ]
      },
      {
        "name": "分布式训练与通信",
        "description": "支持多机多卡分布式训练，含 gRPC 通信层、NCCL 集合通信、Parameter Server 与 CollectiveOps 策略",
        "evidence": [
          "tensorflow/core/distributed_runtime/",
          "tensorflow/core/nccl/"
        ]
      },
      {
        "name": "Python 高层 API",
        "description": "tf.keras（模型构建与训练）、tf.data（数据管道）、tf.train（检查点与恢复）、tf.saved_model（模型导出）、tf.function（AutoGraph）等用户接口",
        "evidence": [
          "tensorflow/python/keras/",
          "tensorflow/python/data/",
          "tensorflow/python/training/"
        ]
      },
      {
        "name": "XLA 编译优化",
        "description": "Ahead-of-Time 与 Just-in-Time 编译器，对计算图进行融合、内存布局优化等，通过 third_party/xla 内嵌提供",
        "evidence": [
          "third_party/xla/"
        ]
      },
      {
        "name": "轻量推理（TensorFlow Lite）",
        "description": "面向移动和嵌入式设备的推理引擎，支持量化、GPU delegate（OpenGL/Vulkan）、NNAPI delegate 等",
        "evidence": [
          "tensorflow/lite/"
        ]
      },
      {
        "name": "多语言绑定与 C API",
        "description": "提供稳定的 C API（tensorflow/c/c_api.h）、C++ API、Java API、Go API，以及 Swift 绑定，使非 Python 生态可调用 TensorFlow",
        "evidence": [
          "tensorflow/c/c_api.h",
          "tensorflow/cc/",
          "tensorflow/java/",
          "tensorflow/go/"
        ]
      },
      {
        "name": "性能分析与调试",
        "description": "内置 Profiler（CUPTI 集成、TensorBoard）、调试器（tfdbg）、跟踪工具等",
        "evidence": [
          "tensorflow/core/profiler/",
          "tensorflow/python/debug/"
        ]
      }
    ],
