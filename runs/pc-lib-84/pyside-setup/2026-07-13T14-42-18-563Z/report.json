  "function_summary": {
    "summary": "PySide6 是 Qt 框架的官方 Python 绑定，提供对 Qt 6 C++ 框架的完整 Python 访问，使 Python 开发者能利用 Qt 构建跨平台桌面 GUI 应用；同时包含 shiboken6 绑定生成器工具链，可将任意 C++ 库自动生成 Python 绑定。",
    "categories": [
      {
        "name": "Qt 6 Python 绑定运行时",
        "description": "完整的 Qt 6 框架 Python 封装，覆盖 QtCore、QtGui、QtWidgets、QtQuick/QML、QtNetwork、QtSql、QtMultimedia 等数十个模块，通过预生成绑定与惰性加载机制将 C++ 类/方法/信号槽映射为 Pythonic API",
        "evidence": [
          "sources/pyside6/PySide6/",
          "sources/pyside6/libpyside/",
          "sources/pyside6/CMakeLists.txt"
        ]
      },
      {
        "name": "C++ → Python 绑定生成器 (shiboken6)",
        "description": "基于 libclang (Clang C Interface) 解析 C++ 头文件的自动化绑定生成框架，生成 CPython C-API 调用代码以高效暴露 C++ 类型系统、重载、继承、信号槽等特性到 Python",
        "evidence": [
          "sources/shiboken6_generator/ApiExtractor/",
          "sources/shiboken6_generator/generator/",
          "sources/shiboken6/libshiboken/"
        ]
      },
      {
        "name": "QML/Quick 集成",
        "description": "通过 libpysideqml 提供 Python ↔ QML 互操作，支持从 Python 加载 .qml UI 文件、在 Python 中定义 QML 类型、以及 QML 与 Python 对象间的属性/方法/信号双向绑定",
        "evidence": [
          "sources/pyside6/libpysideqml/"
        ]
      }
    ],
    "domain": "跨平台桌面 GUI 开发 / 绑定生成工具链",
    "target_users": "Python 桌面应用开发者、需要将现有 C++ 库暴露为 Python API 的绑定开发团队"
  },
