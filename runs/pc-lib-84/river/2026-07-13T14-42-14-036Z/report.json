  "function_summary": {
    "summary": "River 是一个 Python 在线机器学习库，由 creme 和 scikit-multiflow 合并而来。它面向流式数据场景，所有模型采用增量式接口（learn_one/predict_one），支持逐样本或小批量训练与预测。适用于数据量过大无法一次载入内存、或数据持续实时产生的场景，如实时推荐、异常检测、概念漂移监控等。",
    "categories": [
      {
        "name": "线性模型与优化器",
        "description": "支持多种在线线性模型（逻辑回归、线性回归、感知器等）及配套优化器（SGD、AdaGrad、Adam 等），所有参数可增量更新。",
        "evidence": [
          "river/linear_model/",
          "river/optim/"
        ]
      },
      {
        "name": "决策树与集成学习",
        "description": "提供 Hoeffding 树等增量决策树，以及 Bagging、Boosting、Stacking 等在线集成方法，支持流式特征选择与分裂。",
        "evidence": [
          "river/tree/",
          "river/ensemble/",
          "river/forest/"
        ]
      },
      {
        "name": "异常检测与概念漂移",
        "description": "含多种在线异常检测算法（Half-Space Trees、One-Class SVM 等）和概念漂移检测器（ADWIN、DDM、EDDM、Page-Hinkley 等），可监控数据分布变化。",
        "evidence": [
          "river/anomaly/",
          "river/drift/"
        ]
      },
      {
        "name": "推荐系统与矩阵分解",
        "description": "支持增量式推荐算法（FM、FFM、BiasedMF 等），可在线更新用户/物品隐向量，适合实时推荐场景。",
        "evidence": [
          "river/reco/",
          "river/facto/"
        ]
      },
      {
        "name": "时间序列预测与聚类",
        "description": "提供在线时间序列预测模型（Holt-Winters、SNARIMAX 等）和流式聚类算法（StreamKMeans、DenStream、CluStream 等）。",
        "evidence": [
          "river/time_series/",
          "river/cluster/"
        ]
      },
      {
        "name": "特征工程与预处理",
        "description": "涵盖特征提取（TF-IDF、聚合统计）、特征选择、标准化/归一化等流式预处理，以及 Pipeline 管道式组合（使用 | 运算符）。",
        "evidence": [
          "river/preprocessing/",
          "river/feature_extraction/",
          "river/feature_selection/",
          "river/compose/"
        ]
      },
      {
        "name": "在线统计与模型评估",
        "description": "内置多种在线统计量（均值、方差、分位数、峰度、偏度等）和流式评估指标（准确率、AUC、F1 等），支持渐进式验证（progressive validation）。",
        "evidence": [
          "river/metrics/",
          "river/stats/",
          "river/evaluate/"
        ]
      }
    ],
    "domain": "机器学习 / 数据科学 / 流式计算",
    "target_users": "需要处理流式数据或大规模数据的数据科学家和机器学习工程师",
    "ecosystem": "python"
  },
