  "function_summary": {
    "summary": "Formulaic 是一个高性能的 Python Wilkinson 公式实现库，用于将数据框转换为统计模型矩阵（model matrix）。它提供可扩展的公式解析、数据物化器（pandas/narwhals/pyarrow/polars）、对比编码与状态化变换，并支持符号微分，主要服务于统计建模与机器学习生态。",
    "categories": [
      {
        "name": "公式解析与结构化",
        "description": "解析 R 风格的 Wilkinson 公式字符串（如 y ~ x + z），支持简单公式、结构化公式与嵌套结构。",
        "evidence": ["formulaic/formula.py:Formula", "formulaic/parser/parser.py:DefaultFormulaParser"]
      },
      {
        "name": "模型矩阵物化",
        "description": "将数据转换为 numpy 数组、pandas DataFrame 或 scipy.sparse 稀疏矩阵，支持缺失值处理与输出格式选择。",
        "evidence": ["formulaic/model_matrix.py:ModelMatrix", "formulaic/materializers/pandas.py:PandasMaterializer", "formulaic/materializers/narwhals.py:NarwhalsMaterializer"]
      },
      {
        "name": "数据框适配",
        "description": "通过 pandas 与 narwhals 适配层支持多种数据框后端输入输出，包括 pyarrow.Table 与 polars.DataFrame。",
        "evidence": ["formulaic/materializers/base.py:FormulaMaterializer", "README.md:20-34"]
      },
      {
        "name": "统计变换",
        "description": "提供 C（对比编码）、poly（多项式）、scale/center、spline、lag、hashed 等常见统计变换函数。",
        "evidence": ["formulaic/transforms/__init__.py:TRANSFORMS", "formulaic/transforms/contrasts.py", "formulaic/transforms/poly.py"]
      },
      {
        "name": "符号微分",
        "description": "支持对公式进行符号微分（可选 sympy），用于估计模型梯度。",
        "evidence": ["formulaic/utils/calculus.py:differentiate_term", "formulaic/formula.py:Formula.differentiate"]
      }
    ],
    "domain": "data / statistics",
    "target_users": "Python 数据科学、统计建模与机器学习开发者"
  },
