  "function_summary": {
    "summary": "formulaic 是 Wilkinson 公式（R 风格统计建模公式语法，如 `y ~ x + z`）的高性能 Python 实现，把 pandas、narwhals（含 pyarrow/polars）等多种 DataFrame 转换为统计建模所需的模型矩阵（design matrix）。它提供可扩展的公式解析、可复用的编码状态（在训练集与预测集间保持一致的编码），以及 pandas/numpy/scipy.sparse 等多种稠密与稀疏输出后端，常作为 patsy 的高性能替代品被 statsmodels 生态的下游库（如 glum、lifelines、linearmodels、pyfixest）调用。",
    "categories": [
      {
        "name": "公式解析",
        "description": "将 `y ~ x + z` 这类 Wilkinson 公式字符串分词、构建 AST 并求值为结构化的 Term/Factor 集合；支持自定义解析器与操作符解析器，处理截距、交互项、嵌套结构等。",
        "evidence": [
          "formulaic/parser/",
          "formulaic/formula.py",
          "formulaic/parser/types/formula_parser.py:25"
        ]
      },
      {
        "name": "模型矩阵物化",
        "description": "把解析后的公式在给定数据上求值并编码成模型矩阵；通过可注册的 materializer 后端支持 pandas/narwhals 输入与 pandas/numpy/scipy.sparse(CSC) 输出，并保证结构满秩。",
        "evidence": [
          "formulaic/materializers/base.py",
          "formulaic/materializers/pandas.py",
          "formulaic/materializers/narwhals.py"
        ]
      },
      {
        "name": "因子变换与对比编码",
        "description": "内置丰富变换（B/三次样条、正交多项式 poly、中心化/缩放、滞后 lag、哈希、分类对比编码 C/contr 等），并提供 stateful_transform 机制以在训练/预测间复用编码状态。",
        "evidence": [
          "formulaic/transforms/__init__.py",
          "formulaic/transforms/contrasts.py",
          "formulaic/utils/stateful_transforms.py"
        ]
      },
      {
        "name": "结构化公式与模型规格",
        "description": "支持多 LHS/RHS 的结构化公式（StructuredFormula）与编码状态的结构化保存/复用（ModelSpec/ModelSpecs），使同一编码可跨数据集一致地应用于新数据。",
        "evidence": [
          "formulaic/formula.py",
          "formulaic/model_spec.py",
          "formulaic/utils/structured.py"
        ]
      },
      {
        "name": "符号微分",
        "description": "对公式（及由此生成的模型矩阵）按变量求梯度，可选借助 sympy 做符号微分（如 `log(x)` → `1/x`），用于估计拟合模型对变量的梯度。",
        "evidence": [
          "formulaic/utils/calculus.py",
          "formulaic/formula.py:310"
        ]
      }
    ],
    "domain": "科学计算 / 统计建模（数据）",
    "target_users": "构建统计与机器学习模型的 Python 开发者，以及 statsmodels 生态的下游统计库"
  },
