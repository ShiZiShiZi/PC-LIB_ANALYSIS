    "one_liner": "点云数据处理的跨平台 C++ 库与命令行工具，类似 GDAL 之于栅格/矢量",
    "ecosystem": "cpp",
    "bindings": [
      "python"
    ]
  },
  "function_summary": {
    "summary": "PDAL（Point Data Abstraction Library）是面向点云数据的开源 C++ 库，提供点云数据的读取、转换、滤波与写出功能，类似于 GDAL 在栅格/矢量数据领域的角色。它支持 LAS/LAZ、COPC、EPT、PLY、PCD、GeoTIFF 等 20+ 种点云格式的读写，内置 50+ 种滤波算法（去噪、分类、地表提取、重投影等），并以管道（Pipeline）方式组合处理步骤，供 GIS/遥感/测绘开发者集成使用。",
    "categories": [
      {
        "name": "点云 I/O 格式驱动",
        "description": "支持 LAS/LAZ、COPC、EPT、3D Tiles (I3S/SLPK)、PLY、PCD、OBJ、BPF、SBET、QFIT、Text、GDAL 栅格、OGR 矢量等 20+ 种格式的读写驱动",
        "evidence": [
          "io/LasReader.cpp",
          "io/CopcReader.cpp",
          "io/EptReader.cpp",
          "io/GDALReader.cpp",
          "io/OGRWriter.cpp",
          "io/PlyReader.cpp"
        ]
      },
      {
        "name": "点云滤波与处理算法",
        "description": "内置 50+ 种滤波器：去噪（CSFilter、LOFFilter）、分类（ClusterFilter、SMRFilter）、地表提取（PMFFilter、GroundKernel）、重投影（ReprojectionFilter）、统计（StatsFilter）、采样/抽稀、法线计算、Delaunay 三角化、体素化等",
        "evidence": [
          "filters/CSFilter.cpp",
          "filters/PMFFilter.cpp",
          "filters/ReprojectionFilter.cpp",
          "filters/NormalFilter.cpp",
          "filters/VoxelDownsizeFilter.cpp"
        ]
      },
      {
        "name": "管道引擎与命令行工具",
        "description": "通过 JSON 管道描述文件组合 Reader-Filter-Writer 处理链；提供 pdal CLI 及子命令（info、pipeline、translate、tile、tindex 等）供批处理使用",
        "evidence": [
          "pdal/PipelineManager.cpp",
          "kernels/PipelineKernel.cpp",
          "kernels/TranslateKernel.cpp",
          "apps/pdal.cpp"
        ]
      },
      {
        "name": "插件与动态加载框架",
        "description": "基于 PluginManager + DynamicLibrary 的插件系统，运行时按需加载 I/O 驱动与处理内核；可选插件涵盖 Arrow/Parquet、HDF5、TileDB、Draco、PostgreSQL、IceBridge 等",
        "evidence": [
          "pdal/PluginManager.cpp",
          "pdal/DynamicLibrary.cpp",
          "plugins/"
        ]
      },
      {
        "name": "空间参考与坐标变换",
        "description": "集成 PROJ 库进行坐标参考系定义与投影变换，支持 GeoTIFF 键与 WKT 格式；GDAL/OGR 提供额外矢量与栅格互操作能力",
        "evidence": [
          "filters/ReprojectionFilter.cpp",
          "pdal/SpatialReference.cpp",
          "pdal/Geometry.cpp"
        ]
      }
    ],
    "domain": "GIS/点云数据处理",
    "target_users": "GIS 与遥感应用开发者、测绘与地理信息工程师"
  },
