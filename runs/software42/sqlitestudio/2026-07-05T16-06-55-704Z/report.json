  "function_summary": {
    "summary": "Letos（前称 SQLiteStudio）是一个跨平台桌面 GUI 应用，用于创建、浏览、编辑和管理 SQLite 数据库。提供 SQL 编辑器（语法高亮、自动补全）、数据网格视图、数据库对象浏览（表、索引、视图、触发器）、导入/导出（CSV/JSON/XML/SQL/HTML/PDF）、数据库加密支持（SQLite Multiple Ciphers）、脚本扩展（Python/Tcl）等功能，面向数据库开发者、DBA 及需要本地 SQLite 管理的用户。",
    "categories": [
      {
        "name": "数据库管理",
        "description": "提供 SQLite 数据库的图形化创建、浏览、表结构编辑、索引/触发器/视图管理、数据库加密（通过 SQLite Multiple Ciphers 插件）及 Android SQLite 远程管理（通过 ADB）",
        "evidence": [
          "Letos/core/services/dbmanager.cpp",
          "Plugins/DbAndroid/",
          "Plugins/DbSQLite3MC/"
        ]
      },
      {
        "name": "SQL 编辑与执行",
        "description": "提供带语法高亮、自动补全、多语句执行的 SQL 编辑器，支持 SQL 格式化（简易与高级），含 SQL 查询执行器与结果网格展示",
        "evidence": [
          "Letos/gui/sqleditor.cpp",
          "Letos/gui/sqlitesyntaxhighlighter.h",
          "Plugins/SqlFormatterSimple/",
          "Plugins/SqlEnterpriseFormatter/"
        ]
      },
      {
        "name": "数据导入/导出",
        "description": "支持从 CSV/正则表达式/Tcl 脚本导入数据，导出为 CSV/TSV/SQL/JSON/XML/HTML/PDF 格式",
        "evidence": [
          "Plugins/CsvImport/",
          "Plugins/CsvExport/",
          "Plugins/JsonExport/",
          "Plugins/XmlExport/",
          "Plugins/HtmlExport/",
          "Plugins/SqlExport/",
          "Plugins/PdfExport/",
          "Plugins/RegExpImport/"
        ]
      },
      {
        "name": "脚本扩展",
        "description": "支持以 Python 和 Tcl 脚本扩展功能，提供脚本化数据库访问与自定义弹出工具",
        "evidence": [
          "Plugins/ScriptingPython/",
          "Plugins/ScriptingTcl/"
        ]
      },
      {
        "name": "跨平台桌面 GUI",
        "description": "基于 Qt6 Widgets 的 MDI（多文档界面）桌面应用，支持 Windows（含 InnoSetup 安装包）、macOS（.app Bundle）与 Linux（desktop 入口），提供暗色主题、多语言翻译、HiDPI 缩放和打印支持",
        "evidence": [
          "Letos/gui/mainwindow.cpp",
          "Letos/letos/main.cpp",
          "InnoSetupScript.iss",
          "Letos/letos/Info.plist.in",
          "Plugins/FusionDarkStyle/",
          "Plugins/Printing/"
        ]
      },
      {
        "name": "自动更新与崩溃报告",
        "description": "包含自动更新检查（访问 letos.org REST API）与跨平台崩溃处理器（Windows SEH + dbghelp / POSIX signal + backtrace），集成于 chillout 模块",
        "evidence": [
          "Letos/core/services/updatemanager.cpp",
          "Letos/core/chillout/"
        ]
      }
    ],
    "domain": "数据库工具",
    "target_users": "数据库开发者、数据库管理员、数据分析师、需要在桌面环境管理 SQLite 数据库的终端用户"
  },
