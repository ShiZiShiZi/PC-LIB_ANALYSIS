  "function_summary": {
    "summary": "Klavaro 是一款面向终端用户的盲打（触觉打字）训练应用程序。它通过 GTK+3 图形界面提供四个递进式训练模块——基础课程（逐键学习）、适应性练习（针对弱键与错误模式）、速度训练（词汇/段落输入）以及流畅度训练（完整文本录入，含纠错机制）——并配有虚拟键盘指法提示、进度图表、在线排行榜和深色模式等辅助功能，支持 40 多种语言翻译及数十种国际键盘布局（含 Dvorak、BÉPO、Neo2 等）。",
    "categories": [
      {
        "name": "盲打训练引擎",
        "description": "核心训练逻辑：基础课程按字母分组逐步教学（共 43+ 课）、适应性练习根据用户错误与触键时间生成针对性训练、速度训练使用词汇/段落测量 WPM、流畅度训练要求完整输入文本并支持退格与纠错，所有模块均记录准确率与速度统计数据。",
        "evidence": [
          "src/tutor.c",
          "src/basic.c",
          "src/adaptability.c",
          "src/velocity.c",
          "src/fluidness.c"
        ]
      },
      {
        "name": "多语言与键盘布局支持",
        "description": "支持 40+ 种语言翻译（通过 GNU gettext PO 文件）与数十种键盘布局（QWERTY、AZERTY、Dvorak、BÉPO、Neo2、Jhelum 等各国变体），用户可自定义键盘布局并编辑。",
        "evidence": [
          "src/translation.c",
          "src/keyboard.c",
          "po/"
        ]
      },
      {
        "name": "图形用户界面",
        "description": "基于 GTK+3 的桌面 GUI：主窗口提供模块导航、语言/键盘选择；训练窗口含彩色文本标注（正确/错误/重触/光标）、虚拟键盘、指法提示、进度图表（GtkDatabox）；支持字体选择、深色模式切换、窗口位置记忆。",
        "evidence": [
          "src/main.c",
          "src/callbacks.c",
          "src/plot.c",
          "src/cursor.c",
          "data/klavaro.glade"
        ]
      },
      {
        "name": "在线排行榜",
        "description": "通过 libcurl 以 HTTPS 连接 klavaro.sourceforge.io 发布/获取用户的流畅度成绩（Top 10），支持本地与全球排名对比。",
        "evidence": [
          "src/top10.c",
          "src/top10.h"
        ]
      },
      {
        "name": "语音提示",
        "description": "可选依赖 Espeak 语音合成器，在基础/适应性/速度模块中提供手指提示与练习词语朗读（speech synthesis），帮助视觉障碍用户或辅助教学。",
        "evidence": [
          "src/tutor.c",
          "src/tutor.h"
        ]
      }
    ],
    "domain": "教育 / 打字训练",
    "target_users": "希望提升键盘盲打速度与准确率的各类终端用户（从初学者到进阶者，支持多语言）"
  },
