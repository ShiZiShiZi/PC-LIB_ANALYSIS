  "function_summary": {
    "summary": "PulseView 是 sigrok 信号分析软件套件的 Qt 图形前端应用，用于连接、配置和可视化逻辑分析仪、示波器、万用表等 USB/网络测量硬件设备。支持实时信号采集与波形绘制、协议解码（I2C/SPI/UART 等）、数据导入导出（VCD/CSV/SRF 等格式）以及会话保存恢复。适用于电子工程师、嵌入式开发者和硬件调试人员。",
    "categories": [
      {
        "name": "硬件设备发现与连接",
        "description": "通过 libsigrok 驱动框架自动扫描和连接 USB/串口/网络连接的各种 sigrok 兼容测量设备，支持手动指定驱动和禁止自动扫描。",
        "evidence": [
          "pv/devicemanager.cpp",
          "pv/devices/hardwaredevice.cpp",
          "pv/devices/device.cpp",
          "main.cpp:333"
        ]
      },
      {
        "name": "实时信号采集与存储",
        "description": "从硬件设备采集模拟/逻辑信号流，支持采样率控制、触发条件配置和捕获数据的内存管理。支持将采集数据保存为 sigrok session (.sr) 文件。",
        "evidence": [
          "pv/session.cpp",
          "pv/storesession.cpp",
          "pv/devices/inputfile.cpp",
          "pv/data/analogsegment.cpp",
          "pv/data/logicsegment.cpp"
        ]
      },
      {
        "name": "波形可视化与交互",
        "description": "多通道信号波形在可缩放/平移的时间轴视图中以颜色区分绘制，支持模拟波形、逻辑波形、数学计算波形、光标测量和时间标记。基于 Qt QAbstractScrollArea 实现高性能渲染。",
        "evidence": [
          "pv/views/trace/view.hpp:30",
          "pv/views/trace/view.cpp",
          "pv/views/trace/analogsignal.cpp",
          "pv/views/trace/logicsignal.cpp",
          "pv/views/trace/cursorpair.cpp"
        ]
      },
      {
        "name": "协议解码与分析",
        "description": "通过 libsigrokdecode 框架加载协议解码器（PD），对采集的逻辑信号进行 I2C/SPI/UART/CAN/JTAG 等数十种协议的自动解码，并以标注行、二进制视图、表格等形式展示解码结果。",
        "evidence": [
          "pv/data/decodesignal.cpp",
          "pv/data/decode/decoder.cpp",
          "pv/subwindows/decoder_selector/subwindow.cpp",
          "pv/views/trace/decodetrace.cpp",
          "pv/views/tabular_decoder/view.cpp"
        ]
      },
      {
        "name": "数据导入与导出",
        "description": "支持从 VCD/CSV/WAV 等文件格式导入信号数据，以及将采集数据或解码结果导出为 CSV/文本/图像等格式。",
        "evidence": [
          "pv/devices/inputfile.cpp",
          "pv/widgets/exportmenu.cpp",
          "pv/widgets/importmenu.cpp",
          "pv/views/trace/decodetrace.cpp:1191"
        ]
      },
      {
        "name": "会话与设置管理",
        "description": "支持多会话标签页管理，会话的完整设置（设备配置、通道映射、窗口布局）可保存为 .ini 文件并在下次启动时恢复。全局设置通过 QSettings 持久化。",
        "evidence": [
          "pv/session.cpp:221",
          "pv/session.cpp:469",
          "pv/mainwindow.cpp:452",
          "pv/globalsettings.cpp",
          "pv/storesession.cpp"
        ]
      },
      {
        "name": "多语言界面与主题",
        "description": "支持 Qt 翻译机制的多语言界面，内置英文等多语言翻译（.ts/.qm）。支持暗色主题（QDarkStyleSheet）切换。",
        "evidence": [
          "pv/application.cpp:72",
          "pv/globalsettings.cpp:215",
          "l10n/"
        ]
      }
    ],
    "domain": "电子测量/信号分析",
    "target_users": "电子工程师、嵌入式开发者、硬件调试人员、开源硬件爱好者"
  },
