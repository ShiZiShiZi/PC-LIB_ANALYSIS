  "function_summary": {
    "summary": "libsigrok 是一款便携、跨平台的 C 语言共享库，为 sigrok 信号分析软件套件提供核心 API，用于与逻辑分析仪、示波器、万用表、LCR 表、可编程电源等约 90 余种硬件设备通信并读写采集数据。它通过统一的抽象层封装 USB、串口、HID、蓝牙、GPIB、TCP SCPI 等多种物理接口，将不同厂商设备的协议差异对调用者透明化，同时提供数据输入/输出格式转换（支持二十余种文件格式）和信号变换处理能力。",
    "categories": [
      {
        "name": "设备驱动与硬件抽象",
        "description": "提供统一的设备驱动框架，支持逻辑分析仪、示波器、万用表、LCR 表、电源、信号发生器、热电偶等约 90 种设备的自动探测、打开、配置与数据采集；通过 USB（libusb）、串口（libserialport）、HID（hidapi）、蓝牙（bluez）、GPIB、TCP/VXI SCPI 等多种接口与设备通信",
        "evidence": [
          "src/hwdriver.c",
          "src/drivers.c",
          "src/device.c",
          "src/usb.c",
          "src/serial.c",
          "src/serial_libsp.c",
          "src/serial_hid.c",
          "src/bt/bt_bluez.c",
          "src/scpi/scpi_tcp.c",
          "src/scpi/scpi_libgpib.c",
          "include/libsigrok/libsigrok.h (struct sr_dev_driver, enum sr_configkey)"
        ]
      },
      {
        "name": "会话管理与数据流",
        "description": "管理数据采集会话的生命周期，包含 session 创建/销毁、设备添加/移除、触发条件设置、数据流回传（通过回调机制）以及停止回调通知",
        "evidence": [
          "src/session.c",
          "src/session_driver.c",
          "src/session_file.c",
          "src/trigger.c",
          "include/libsigrok/libsigrok.h (struct sr_datafeed_packet, struct sr_trigger)"
        ]
      },
      {
        "name": "数据格式输入/输出",
        "description": "支持二十余种文件格式的读写，包括 sigrok 自有格式（srzip）、VCD、WAV、CSV、二进制、SIGROK 会话文件等；输出模块可将采集数据导出为各类格式或图表",
        "evidence": [
          "src/input/",
          "src/output/",
          "include/libsigrok/proto.h (sr_input_list, sr_output_list)"
        ]
      },
      {
        "name": "信号变换与处理",
        "description": "内建信号变换模块，如模拟信号到逻辑信号的阈值转换、施密特触发器去抖、软件限幅等；可在数据流中链式插入变换单元",
        "evidence": [
          "src/transform/",
          "src/conversion.c",
          "src/soft-trigger.c",
          "src/sw_limits.c"
        ]
      },
      {
        "name": "模拟与数字测量量模型",
        "description": "定义完善的物理量模型（电压、电流、电阻、电容、温度、频率、功率等 30 余种测量量及其单位），以及标志位（AC/DC、RMS、自换档等），在数据包中携带精确的编码和语义信息",
        "evidence": [
          "src/analog.c",
          "include/libsigrok/libsigrok.h (enum sr_mq, enum sr_unit, enum sr_mqflag, struct sr_analog_encoding)"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "通过 SWIG 生成 C++、Python、Ruby、Java 四套语言绑定，使以上所有功能均可从对应语言调用；C++ 绑定还额外提供 glibmm 封装层",
        "evidence": [
          "bindings/swig/",
          "bindings/cxx/",
          "bindings/python/",
          "bindings/ruby/",
          "bindings/java/",
          "configure.ac (lines 400-661)"
        ]
      }
    ],
    "domain": "电子测量仪器控制与信号分析",
    "target_users": "电子工程与嵌入式开发者、测试测量工具前端/桌面应用开发者"
  },
