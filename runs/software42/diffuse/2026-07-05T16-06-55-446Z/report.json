  "function_summary": {
    "summary": "Diffuse 是一款基于 GTK3 的 Python 图形化桌面应用，用于文本文件的对比与合并。它能将任意数量的文件并排显示（n-way merge），支持手动调整行匹配和直接编辑文件内容，并通过调用 Git、SVN、Mercurial、Bazaar、CVS 等版本控制系统命令行工具来获取历史版本进行对比。主要面向需要代码审查、冲突解决和文件比对的终端用户与开发者。",
    "categories": [
      {
        "name": "多文件并排对比",
        "description": "支持将任意数量（n-way）的文件并排显示对比差异，提供统一的滚动同步和差异导航",
        "evidence": [
          "src/diffuse/window.py",
          "src/diffuse/widgets.py"
        ]
      },
      {
        "name": "文件合并与编辑",
        "description": "允许用户在对比窗口中直接编辑文件内容，支持无限撤销/重做，可手动调整行匹配并对齐差异块",
        "evidence": [
          "src/diffuse/window.py",
          "src/diffuse/dialogs.py"
        ]
      },
      {
        "name": "版本控制系统集成",
        "description": "通过调用 Bazaar、CVS、Darcs、Git、Mercurial、Monotone、RCS、Subversion 的命令行工具获取文件历史版本进行对比与合并",
        "evidence": [
          "src/diffuse/vcs/git.py",
          "src/diffuse/vcs/svn.py",
          "src/diffuse/vcs/hg.py",
          "src/diffuse/vcs/vcs_interface.py"
        ]
      },
      {
        "name": "语法高亮",
        "description": "支持可自定义的语法高亮，通过资源文件配置颜色、字体和关键词规则",
        "evidence": [
          "src/diffuse/resources.py"
        ]
      },
      {
        "name": "国际化支持",
        "description": "支持多语言界面（i18n），提供 PO 文件翻译，并通过 GTK 的 Pango 渲染 Unicode 文本",
        "evidence": [
          "po/",
          "src/diffuse/diffuse.in"
        ]
      }
    ],
    "domain": "开发工具 / 文本对比",
    "target_users": "需要进行代码审查、文件差异查看和合并冲突解决的开发者与终端用户"
  },
