  "function_summary": {
    "summary": "pip 是 Python 官方推荐的包安装器（CLI 应用），用户通过命令行从 PyPI 及其他包索引下载、安装、升级、卸载 Python 包。支持依赖解析、wheel 构建、虚拟环境管理、VCS 直接安装、需求文件批量安装、配置管理等完整包生命周期操作。面向 Python 开发者与运维人员。",
    "categories": [
      {
        "name": "包安装与卸载",
        "description": "从 PyPI、自定义索引或本地路径安装/卸载 Python 包，支持 wheel 和 sdist 格式，提供 install/uninstall 命令。",
        "evidence": [
          "src/pip/_internal/commands/install.py",
          "src/pip/_internal/operations/install/wheel.py"
        ]
      },
      {
        "name": "依赖解析",
        "description": "基于 resolvelib 的依赖解析器，自动求解包之间的版本约束并生成安装计划。",
        "evidence": [
          "src/pip/_internal/resolution/resolvelib/"
        ]
      },
      {
        "name": "包搜索与索引",
        "description": "查询 PyPI 及自定义索引获取包信息与可用版本列表，支持多种索引源。",
        "evidence": [
          "src/pip/_internal/index/package_finder.py",
          "src/pip/_internal/index/collector.py"
        ]
      },
      {
        "name": "虚拟环境",
        "description": "检测虚拟环境并支持在其内安装包，也可创建隔离构建环境。",
        "evidence": [
          "src/pip/_internal/utils/virtualenv.py",
          "src/pip/_internal/build_env/virtual.py"
        ]
      },
      {
        "name": "VCS 集成",
        "description": "支持从 Git、Mercurial、Subversion、Bazaar 等版本控制系统直接安装包。",
        "evidence": [
          "src/pip/_internal/vcs/git.py",
          "src/pip/_internal/vcs/versioncontrol.py"
        ]
      },
      {
        "name": "需求文件",
        "description": "解析 requirements.txt 格式的需求文件，支持批量安装与依赖约束。",
        "evidence": [
          "src/pip/_internal/req/req_file.py"
        ]
      },
      {
        "name": "配置管理",
        "description": "多层配置文件系统（全局/用户/站点/venv），支持 pip.conf、环境变量覆盖。",
        "evidence": [
          "src/pip/_internal/configuration.py"
        ]
      },
      {
        "name": "网络与认证",
        "description": "HTTP/HTTPS 下载、代理支持、多域名 HTTP 基本认证、TLS/SSL 配置。",
        "evidence": [
          "src/pip/_internal/network/session.py",
          "src/pip/_internal/network/auth.py"
        ]
      }
    ],
