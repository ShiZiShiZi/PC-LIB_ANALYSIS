    "commit": "b5b2aa5ff41b17b63b04dfe6a803dbebe820c8ad",
    "one_liner": "通用字符编码检测器，纯 Python 实现、零运行时依赖，可流式检测并返回编码、置信度、语言与 MIME 类型。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "chardet 是一个通用字符编码检测库，通过 13 阶段流水线（BOM、UTF-16/32 模式、转义序列、魔数、二进制判定、标记字符集、ASCII/UTF-8 预检、字节有效性过滤、CJK 结构门控、结构探测、统计 bigram 评分、后处理与语言填充）识别字节流编码。它提供 detect、detect_all、UniversalDetector 流式接口以及 chardetect 命令行工具，适用于需要自动识别文本编码的 Python 应用、CLI 用户及下游库。",
    "categories": [
      {
        "name": "编码检测核心 API",
        "description": "对外提供一次性检测与全候选排序接口，包括 detect、detect_all 与结果类型 DetectionResult/DetectionDict。",
        "evidence": ["src/chardet/__init__.py:detect", "src/chardet/__init__.py:detect_all", "src/chardet/pipeline/__init__.py:DetectionResult"]
      },
      {
        "name": "流式检测",
        "description": "UniversalDetector 以 feed/close/reset 模式支持大文件或网络流的增量编码检测。",
        "evidence": ["src/chardet/detector.py:UniversalDetector"]
      },
      {
        "name": "多阶段检测流水线",
        "description": "按优先级执行 BOM、UTF-16/32、转义序列、魔数、二进制、标记字符集、ASCII、UTF-8、字节有效性、结构探测、统计评分、后处理等阶段。",
        "evidence": ["src/chardet/pipeline/orchestrator.py:run_pipeline", "src/chardet/pipeline/orchestrator.py:_run_pipeline_core"]
      },
      {
        "name": "二进制与 MIME 类型识别",
        "description": "通过文件魔数识别 40 余种二进制格式，并返回对应 MIME 类型；无法识别时返回 application/octet-stream。",
        "evidence": ["src/chardet/pipeline/magic.py:detect_magic", "src/chardet/pipeline/binary.py:is_binary"]
      },
      {
        "name": "语言检测",
        "description": "基于单语言编码映射、多语言 bigram 模型与 UTF-8 回退三层策略，为检测结果填充 ISO 639-1 语言代码。",
        "evidence": ["src/chardet/pipeline/language.py:fill_languages", "src/chardet/models/__init__.py:score_best_language"]
      },
      {
        "name": "编码过滤与兼容输出",
        "description": "支持按编码年代、包含/排除列表过滤候选集，并提供 prefer_superset 与 compat_names 选项保持与 chardet 5.x/6.x 的兼容。",
        "evidence": ["src/chardet/__init__.py:detect", "src/chardet/output_names.py:apply_compat_names", "src/chardet/output_names.py:apply_preferred_superset"]
      },
      {
        "name": "命令行工具",
        "description": "chardetect CLI 从文件或标准输入读取字节，输出检测到的编码与置信度。",
        "evidence": ["src/chardet/cli.py:main", "pyproject.toml:project.scripts"]
      }
    ],
    "domain": "text processing",
    "target_users": "Python 应用开发者、数据工程师、CLI 用户以及需要自动识别文本编码的下游库"
  },
