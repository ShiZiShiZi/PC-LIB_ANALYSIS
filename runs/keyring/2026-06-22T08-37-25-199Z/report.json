  },
  "function_summary": {
    "summary": "keyring 是一个 Python 库，为应用提供统一、安全的密码/凭据存储与读取接口。它通过插件化后端自动适配 macOS Keychain、Windows Credential Locker、Linux Freedesktop Secret Service 及 KDE KWallet 等系统密钥环服务，并附带命令行工具与第三方后端扩展入口。主要面向需要在桌面平台安全存取密码的 Python 应用开发者和 CLI 工具作者。",
    "categories": [
      {
        "name": "核心密码操作 API",
        "description": "提供 set_password、get_password、delete_password、get_credential 等统一入口，封装后端差异。",
        "evidence": ["keyring/__init__.py", "keyring/core.py:63-82"]
      },
      {
        "name": "后端发现与优先级调度",
        "description": "基于 KeyringBackend 抽象基类、元类注册与 priority/viable 机制，自动发现并选择当前环境可用的密钥环后端。",
        "evidence": ["keyring/backend.py:65-107", "keyring/backends/chainer.py:11-45"]
      },
      {
        "name": "macOS Keychain 后端",
        "description": "通过 ctypes 调用 Security / CoreServices / Foundation 框架，实现 macOS 系统钥匙串的密码读写。",
        "evidence": ["keyring/backends/macOS/__init__.py", "keyring/backends/macOS/api.py:25-184"]
      },
      {
        "name": "Windows Credential Locker 后端",
        "description": "借助 pywin32-ctypes / pywin32 封装 win32cred，读写 Windows 凭据管理器。",
        "evidence": ["keyring/backends/Windows.py:14-168"]
      },
      {
        "name": "Linux Secret Service 后端",
        "description": "通过 secretstorage 库访问 Freedesktop Secret Service（GNOME Keyring 等），并支持 libsecret 备选路径。",
        "evidence": ["keyring/backends/SecretService.py", "keyring/backends/libsecret.py"]
      },
      {
        "name": "KDE KWallet 后端",
        "description": "通过 dbus 与 KDE KWallet 服务交互，支持 KWallet 4/5。",
        "evidence": ["keyring/backends/kwallet.py:29-161"]
      },
      {
        "name": "命令行工具与 shell 补全",
        "description": "提供 keyring CLI（get/set/del/diagnose/list-backends）及可选的 bash/zsh 补全脚本。",
        "evidence": ["keyring/cli.py", "keyring/completion.py"]
      }
    ],
