  "function_summary": {
    "summary": "executing 是一个轻量级 Python 工具库，用于在运行时获取某个帧（frame）当前正在执行的 AST 节点。它通过比对字节码指令与抽象语法树，识别 Call、Attribute、Subscript、BinOp、UnaryOp、Compare 等常见表达式节点，常被 traceback 美化、调试器和源码分析工具用作底层依赖。",
    "categories": [
      {
        "name": "AST 节点定位",
        "description": "根据 frame.f_lasti 与字节码指令，结合 AST 匹配算法，定位当前正在执行的具体 AST 节点；支持普通 Python 代码与 IPython/Jupyter cell。",
        "evidence": [
          "executing/executing.py:Source.executing",
          "executing/_position_node_finder.py:PositionNodeFinder.find_node"
        ]
      },
      {
        "name": "字节码分析与验证",
        "description": "使用 dis 模块解析字节码，并在修改 AST 后重新编译，通过比较指令序列验证节点映射的正确性；包含针对各 Python 版本的字节码差异处理。",
        "evidence": [
          "executing/executing.py:SentinelNodeFinder.matching_nodes",
          "executing/_utils.py:get_instructions"
        ]
      },
      {
        "name": "源码文本提取",
        "description": "在可选安装 asttokens 后，可获取 AST 节点对应的源代码文本片段（text/text_range），或返回 ASTTokens/ASTText 对象供下游使用。",
        "evidence": [
          "executing/executing.py:Source.asttokens",
          "executing/executing.py:Executing.text"
        ]
      },
      {
        "name": "限定名推断",
        "description": "遍历 AST 并维护类/函数嵌套栈，为 code object 模拟生成 __qualname__，便于在 traceback 中显示完整路径。",
        "evidence": [
          "executing/executing.py:QualnameVisitor",
          "executing/executing.py:Source.code_qualname"
        ]
      },
      {
        "name": "IPython 与 pytest 兼容",
        "description": "识别 IPython cell 文件名与代码对象名，处理 pytest assert 重写后的字节码，保证在交互式环境与测试框架下的可用性。",
        "evidence": [
          "executing/executing.py:is_ipython_cell_code",
          "executing/executing.py:is_rewritten_by_pytest",
          "executing/_pytest_utils.py:is_pytest_compatible"
        ]
      }
    ],
    "domain": "开发工具 / 调试 / 源码分析",
    "target_users": "Python 开发者、调试与 traceback 增强库作者、Jupyter/IPython 生态工具开发者"
