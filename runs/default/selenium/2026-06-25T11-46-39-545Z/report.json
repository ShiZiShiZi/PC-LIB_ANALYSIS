  "function_summary": {
    "summary": "Selenium 是一个浏览器自动化库，实现 W3C WebDriver 规范，提供跨平台、多语言的 API 来控制和自动化 Web 浏览器。它支持主流浏览器（Chrome、Firefox、Edge、Safari），用于 Web 应用测试、任务自动化和爬虫开发。项目包含五个主要语言绑定（Java、Python、JavaScript、Ruby、.NET/C#）、一个用 Rust 编写的 Selenium Manager 工具（自动管理浏览器驱动），以及 Selenium Grid 分布式测试服务器。核心功能包括：页面导航、元素定位与操作、表单填写、窗口管理、Cookie 处理、截图、DevTools/CDP 协议集成（网络拦截、性能监控）、BiDi（双向 WebDriver）协议支持。所有语言绑定共享同一协议层，通过 HTTP/WebSocket 与浏览器驱动通信。",
    "categories": [
      {
        "name": "浏览器控制与导航",
        "description": "提供 WebDriver API 控制浏览器打开页面、导航前进后退刷新、管理窗口和标签页、处理弹窗和对话框",
        "evidence": ["java/src/org/openqa/selenium/WebDriver.java: WebDriver.get(), Navigation.to/back/forward/refresh()", "py/selenium/webdriver/remote/webdriver.py: driver.get(), driver.back(), driver.forward()"]
      },
      {
        "name": "元素定位与交互",
        "description": "通过 CSS 选择器、XPath、ID、类名等方式定位 DOM 元素，执行点击、输入文本、清除、提交表单、拖拽等操作",
        "evidence": ["java/src/org/openqa/selenium/By.java: By.id/cssSelector/xpath/linkText", "java/src/org/openqa/selenium/WebElement.java: click(), sendKeys(), clear(), submit()"]
      },
      {
        "name": "DevTools/CDP 协议集成",
        "description": "集成 Chrome DevTools Protocol，支持网络请求拦截、性能监控、日志捕获、JavaScript 执行上下文控制、页面性能分析",
        "evidence": ["java/src/org/openqa/selenium/devtools/DevTools.java", "java/src/org/openqa/selenium/devtools/idealized/Network.java: NetworkInterceptor", "common/devtools/*.json CDP 协议定义"]
      },
      {
        "name": "分布式测试（Selenium Grid）",
        "description": "提供 Grid 服务器实现分布式浏览器测试，支持节点注册、会话分发、队列管理、WebSocket 代理，可在多台机器并行运行测试",
        "evidence": ["java/src/org/openqa/selenium/grid/", "java/src/org/openqa/selenium/grid/distributor/local/LocalNodeRegistry.java", "java/src/org/openqa/selenium/grid/router/"]
      },
      {
        "name": "驱动管理（Selenium Manager）",
        "description": "用 Rust 编写的 CLI 工具，自动下载和管理浏览器驱动（chromedriver、geckodriver、IEDriver 等），解析驱动版本匹配浏览器版本",
        "evidence": ["rust/src/main.rs: Selenium Manager CLI", "rust/src/lib.rs: driver resolution logic", "Cargo.toml: selenium-manager"]
      }
    ],
    "domain": "Web 自动化测试 / 浏览器控制 / Web 应用自动化",
    "target_users": "自动化测试工程师、Web 应用开发者、QA 团队、爬虫开发者"
  },
