  "function_summary": {
    "summary": "packaging 是 PyPA 维护的 Python 打包基础设施库，为 PEP 440、PEP 508、PEP 425、PEP 345/566/639 等 Python 打包互操作性规范提供单一、可复用的参考实现。它向上层工具（pip、poetry、setuptools、warehouse 等）提供版本解析、依赖说明符、环境标记、平台标签、核心元数据、wheel/sdist 文件名解析、许可证表达式规范化以及 pylock 锁文件等能力。",
    "categories": [
      {
        "name": "版本与说明符处理",
        "description": "解析并比较 PEP 440 版本字符串，评估 PEP 508 版本说明符（Specifier / SpecifierSet），构造 Requirement 对象。",
        "evidence": ["src/packaging/version.py", "src/packaging/specifiers.py", "src/packaging/requirements.py"]
      },
      {
        "name": "依赖标记求值",
        "description": "解析环境标记（Marker）表达式，并基于当前 Python 进程的平台信息（os_name、platform_system、python_version 等）求值。",
        "evidence": ["src/packaging/markers.py", "src/packaging/markers.py:default_environment"]
      },
      {
        "name": "Wheel 标签与平台兼容性",
        "description": "生成并匹配 PEP 425 标签三元组（interpreter-abi-platform），支持 CPython、PyPy、manylinux、musllinux、macOS、iOS、Android、Emscripten 等平台标签。",
        "evidence": ["src/packaging/tags.py", "src/packaging/_manylinux.py", "src/packaging/_musllinux.py", "src/packaging/_elffile.py"]
      },
      {
        "name": "核心元数据解析",
        "description": "将 RFC 822 风格的 METADATA 邮件解析为结构化的 RawMetadata / Metadata 对象，覆盖 Metadata 1.0 至 2.6 的字段。",
        "evidence": ["src/packaging/metadata.py"]
      },
      {
        "name": "通用解析与规范化工具",
        "description": "提供包名规范化、wheel/sdist 文件名解析、SPDX 许可证表达式规范化等辅助函数。",
        "evidence": ["src/packaging/utils.py", "src/packaging/licenses/__init__.py"]
      },
      {
        "name": "锁文件与依赖组",
        "description": "实现 pylock.toml 锁文件的数据模型与验证（Package、Pylock），以及 PEP 735 dependency-groups 的解析与包含展开。",
        "evidence": ["src/packaging/pylock.py", "src/packaging/dependency_groups.py"]
      }
    ],
    "domain": "developer tools / packaging",
    "target_users": "Python 打包工具、包索引、构建后端及依赖解析器的开发者"
