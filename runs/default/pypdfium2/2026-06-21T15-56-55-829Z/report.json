    "bindings": []
  },
  "function_summary": {
    "summary": "pypdfium2 是 PDFium 的 Python ABI 绑定库，提供 PDF 文档加载、页面渲染、文本/图片/附件提取、书签目录读取、表单处理、文档合并/拆分与保存等能力。它通过 ctypesgen 自动生成 ctypes 接口，同时提供面向对象的高层 helpers 与命令行工具。适合需要在 Python 中处理 PDF 的开发者、数据抽取工作流以及构建下游 PDF 工具。",
    "categories": [
      {
        "name": "PDF 文档加载与元数据读取",
        "description": "通过 PdfDocument 打开文件路径、字节流或原始句柄，读取页数、版本、权限、目录、附件等文档级信息。",
        "evidence": ["src/pypdfium2/_helpers/document.py:PdfDocument", "src/pypdfium2/_helpers/document.py:len/pdf.get_version"]
      },
      {
        "name": "页面渲染与位图转换",
        "description": "将 PDF 页面栅格化为位图，支持缩放、旋转、透明通道与多种像素格式，并提供与 PIL/numpy/OpenCV 的懒加载适配器。",
        "evidence": ["src/pypdfium2/_helpers/page.py:PdfPage.render", "src/pypdfium2/_helpers/bitmap.py:PdfBitmap", "src/pypdfium2/_lazy.py"]
      },
      {
        "name": "文本提取与搜索",
        "description": "基于 PdfTextPage 提取页面或区域文本，支持字符范围与文本搜索。",
        "evidence": ["src/pypdfium2/_helpers/textpage.py:PdfTextPage", "src/pypdfium2/_helpers/textpage.py:search"]
      },
      {
        "name": "页面对象与附件操作",
        "description": "遍历页面中的文本/路径/图片/表单等对象，并支持嵌入文件的列出、提取与修改。",
        "evidence": ["src/pypdfium2/_helpers/pageobjects.py", "src/pypdfium2/_helpers/attachment.py"]
      },
      {
        "name": "文档结构导航",
        "description": "读取书签、目录（TOC）、目标（destination）与页面模式，支持层级遍历。",
        "evidence": ["src/pypdfium2/_helpers/document.py:PdfBookmark/PdfDest", "src/pypdfium2_cli/toc.py"]
      },
      {
        "name": "表单与系统字体信息",
        "description": "初始化表单环境（FPDF_FORMFILLINFO），并封装 FPDF_SYSFONTINFO 回调以拦截系统字体查询。",
        "evidence": ["src/pypdfium2/_helpers/sysfontinfo.py", "src/pypdfium2/_helpers/document.py:PdfFormEnv"]
      },
      {
        "name": "命令行工具",
        "description": "提供 pypdfium2 CLI，支持 render、extract-text、extract-images、arrange、toc 等子命令，用于测试与快速处理。",
        "evidence": ["src/pypdfium2_cli/__main__.py:SubCommands", "src/pypdfium2_cli/_setup.py:setup_logging"]
      },
      {
        "name": "ctypes 底层 API 绑定",
        "description": "通过 ctypesgen 生成的 pypdfium2.raw 模块暴露原始 PDFium C API，供高级用户直接调用或与 helpers 混用。",
        "evidence": ["src/pypdfium2/raw.py", "autorelease/bindings.py"]
      }
    ],
