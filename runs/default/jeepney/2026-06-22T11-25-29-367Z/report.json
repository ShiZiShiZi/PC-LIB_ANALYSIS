  "function_summary": {
    "summary": "jeepney 是一个纯 Python 的 D-Bus 消息协议实现，用于在 Linux/Unix 桌面环境中与 D-Bus 服务进行进程间通信。它包含一个与 I/O 无关的核心（负责消息编解码、签名解析、构造方法调用/返回/错误/信号），以及分别适配阻塞、asyncio、trio 和线程模型的 I/O 集成层。开发者可直接构造消息，也可通过 bindgen 从 D-Bus 内省 XML 自动生成类型安全的接口包装类。",
    "categories": [
      {
        "name": "D-Bus 消息编解码与签名解析",
        "description": "实现 D-Bus 二进制协议的解析与序列化，包括字节序、消息头、类型签名（struct、array、variant、object path 等）以及文件描述符索引映射",
        "evidence": [
          "jeepney/low_level.py:Message",
          "jeepney/low_level.py:Parser",
          "jeepney/low_level.py:simple_types"
        ]
      },
      {
        "name": "D-Bus 消息构造与接口包装",
        "description": "提供方法调用、方法返回、错误、信号四类消息的高阶构造函数，以及 MessageGenerator 基类、属性访问器和内省包装",
        "evidence": [
          "jeepney/wrappers.py:new_method_call",
          "jeepney/wrappers.py:MessageGenerator",
          "jeepney/wrappers.py:Properties",
          "jeepney/wrappers.py:Introspectable"
        ]
      },
      {
        "name": "SASL 认证与会话协商",
        "description": "处理 D-Bus 连接前的 EXTERNAL 认证握手，并可选协商 Unix 文件描述符传递能力",
        "evidence": [
          "jeepney/auth.py:Authenticator",
          "jeepney/auth.py:make_auth_external"
        ]
      },
      {
        "name": "文件描述符传递",
        "description": "通过 Unix domain socket 的 SCM_RIGHTS 辅助数据发送/接收文件描述符，并提供 FileDescriptor 包装类管理生命周期",
        "evidence": [
          "jeepney/fds.py:FileDescriptor",
          "jeepney/fds.py:from_ancdata",
          "jeepney/fds.py:fds_buf_size"
        ]
      },
      {
        "name": "总线地址发现",
        "description": "从 DBUS_SESSION_BUS_ADDRESS/DBUS_SYSTEM_BUS_ADDRESS 环境变量解析 Unix domain socket 地址（含 abstract 命名空间），并支持显式地址",
        "evidence": [
          "jeepney/bus.py:find_session_bus",
          "jeepney/bus.py:find_system_bus",
          "jeepney/bus.py:get_connectable_addresses"
        ]
      },
      {
        "name": "接口绑定生成",
        "description": "从 D-Bus 内省 XML 或实时 introspect 生成 Python 接口包装模块代码",
        "evidence": [
          "jeepney/bindgen.py:generate_from_introspection",
          "jeepney/bindgen.py:code_from_xml"
        ]
      },
      {
        "name": "多事件循环 I/O 集成",
        "description": "提供阻塞、asyncio、trio、线程四种 I/O 集成，包含连接、路由、Proxy、消息过滤与回复匹配",
