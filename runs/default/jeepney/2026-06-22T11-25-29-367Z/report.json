  "harmony_adaptation": {
    "target": "HarmonyOS PC（跑在已移植的 Python 3.12 运行时上；原生扩展经 OHOS NDK/musl 重编；arm64/x86_64；自研内核，无 Linux ABI）",
    "feasibility": "hard",
    "overall_difficulty": "very_high",
    "effort_estimate": "XL",
    "porting_class": "needs_adaptation",
    "recommended_path": "find_alternative",
    "summary": "jeepney 本身是纯 Python 库，可在鸿蒙 PC 已移植的 Python 上直接导入运行；但其全部价值建立在 Linux/Unix D-Bus IPC 基础设施之上，而 HarmonyOS PC 不使用 D-Bus。除非同时把 D-Bus 守护进程及其依赖的 Unix socket 凭证机制移植到鸿蒙，否则该库在鸿蒙上没有可工作的目标总线。建议不要在鸿蒙上移植 jeepney，而是使用鸿蒙自身的分布式软总线或其他 IPC 方案重写应用层交互。",
    "blockers": [
      {
        "issue": "HarmonyOS PC 没有 D-Bus 守护进程，库的核心目标平台服务缺失",
        "severity": "blocker",
        "category": "platform_service_unavailable",
        "source_dimension": "library",
        "harmony_status": "unavailable",
