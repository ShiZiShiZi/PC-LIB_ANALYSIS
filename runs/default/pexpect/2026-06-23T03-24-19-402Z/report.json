  "function_summary": {
    "summary": "Pexpect 是一个纯 Python 的 Expect-like 库，用于生成子进程、控制交互式应用（如 ssh、ftp、passwd、telnet 等）并根据输出模式自动响应。它提供 spawn 类与 run 函数两种主要接口，支持正则/字符串模式匹配、发送输入、TTY/PTY 控制，以及基于 subprocess.Popen 和 socket 的备用 spawn 后端。",
    "categories": [
      {
        "name": "子进程生成与控制",
        "description": "通过伪终端或管道生成子进程，提供 spawn、PopenSpawn、SocketSpawn、fdspawn 等多种后端，支持关闭、终止、等待、信号发送等生命周期管理。",
        "evidence": [
          "pexpect/pty_spawn.py:spawn",
          "pexpect/popen_spawn.py:PopenSpawn",
          "pexpect/socket_pexpect.py:SocketSpawn",
          "pexpect/fdpexpect.py:fdspawn"
        ]
      },
      {
        "name": "期望模式匹配",
        "description": "在子进程输出流中搜索字符串或正则模式，支持 expect、expect_exact、expect_list 与 EOF/TIMEOUT 特殊模式，实现自动化交互逻辑。",
        "evidence": [
          "pexpect/spawnbase.py:expect",
          "pexpect/spawnbase.py:expect_list",
          "pexpect/spawnbase.py:expect_exact",
          "pexpect/expect.py:Expecter"
        ]
      },
      {
        "name": "SSH 会话封装",
        "description": "pxssh 继承 spawn，专门处理 SSH 登录、主机密钥接受、密码/密钥认证、提示符同步与远程命令执行。",
        "evidence": [
          "pexpect/pxssh.py:pxssh",
          "pexpect/pxssh.py:login",
          "pexpect/pxssh.py:prompt"
        ]
      },
      {
        "name": "REPL 交互封装",
        "description": "REPLWrapper 为 Python、bash、zsh 等交互式解释器提供统一封装，自动设置唯一提示符并执行命令。",
        "evidence": [
          "pexpect/replwrap.py:REPLWrapper",
          "pexpect/replwrap.py:python",
          "pexpect/replwrap.py:bash",
          "pexpect/replwrap.py:zsh"
        ]
      },
      {
        "name": "ANSI/终端模拟",
        "description": "提供 ANSI VT100 终端模拟器（ANSI.py）与虚拟屏幕（screen.py）以及有限状态机（FSM.py），用于解析终端转义序列。",
        "evidence": [
          "pexpect/ANSI.py",
          "pexpect/screen.py",
          "pexpect/FSM.py"
        ]
      },
      {
        "name": "实用工具",
        "description": "提供命令行拆分、PATH 查找、select/poll 中断忽略包装等辅助函数。",
