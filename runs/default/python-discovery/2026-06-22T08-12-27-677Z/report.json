  "function_summary": {
    "summary": "python-discovery 是一个纯 Python 的解释器发现库，面向需要在构建、测试或自动化流程中定位特定 Python 版本的开发者与工具。它接受诸如 3.12、cpython3.12、>=3.11,<3.13 或绝对路径等规格说明，依次扫描 try_first_with 路径、当前解释器、PATH、pyenv/mise/asdf 版本管理器 shim 以及 uv 管理的安装目录，最终返回候选解释器的详细元数据；Windows 平台还会读取 PEP 514 注册表项。查询结果默认写入磁盘缓存，避免重复通过子进程探测解释器。",
    "categories": [
      {
        "name": "解释器规格解析",
        "description": "把字符串规格（版本、实现前缀、版本范围、绝对路径）解析为结构化的 PythonSpec 对象",
        "evidence": [
          "src/python_discovery/_py_spec.py:PythonSpec.from_string_spec",
          "src/python_discovery/_specifier.py:SimpleSpecifierSet"
        ]
      },
      {
        "name": "候选解释器枚举",
        "description": "按优先级枚举可能的解释器来源，包括显式路径、当前解释器、PATH、pyenv/mise/asdf shim 解析、uv 安装目录以及 Windows PEP 514 注册表",
        "evidence": [
          "src/python_discovery/_discovery.py:propose_interpreters",
          "src/python_discovery/_discovery.py:_propose_from_path",
          "src/python_discovery/_discovery.py:_propose_from_uv",
          "src/python_discovery/_windows/_pep514.py:discover_pythons"
        ]
      },
      {
        "name": "解释器元数据探测",
        "description": "通过子进程启动目标解释器运行 _py_info.py 脚本，采集平台、实现、版本、架构、sysconfig、虚拟环境层级等信息",
        "evidence": [
          "src/python_discovery/_cached_py_info.py:_run_subprocess",
          "src/python_discovery/_py_info.py:PythonInfo"
        ]
      },
      {
        "name": "匹配与过滤",
        "description": "根据规格与可选谓词筛选候选解释器，并去重同一系统解释器的符号链接/虚拟环境别名",
        "evidence": [
          "src/python_discovery/_discovery.py:_iter_for_spec",
          "src/python_discovery/_py_info.py:PythonInfo.satisfies"
        ]
      },
      {
        "name": "磁盘缓存",
        "description": "使用 JSON 文件缓存解释器元数据，并通过 filelock 保证并发安全，支持 DiskCache 与 NoOpCache",
        "evidence": [
          "src/python_discovery/_cache.py:DiskCache",
          "src/python_discovery/_cache.py:DiskContentStore"
        ]
      }
    ],
