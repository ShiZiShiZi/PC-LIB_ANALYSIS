  "function_summary": {
    "summary": "VLC 是一个跨平台开源媒体播放器与多媒体引擎，支持几乎所有音视频格式、光盘、流媒体、设备的播放、转换、编码与流式传输。其核心引擎 libVLC 可嵌入第三方应用，提供播放、流媒体与转换能力，并有 Python/C#/Java 等语言绑定。",
    "categories": [
      {
        "name": "多媒体播放",
        "description": "支持几乎所有音视频格式、光盘(VCD/DVD/蓝光)、流媒体(HTTP/RTSP/SMB)、网络协议的解码与播放",
        "evidence": ["modules/codec/", "modules/demux/", "modules/access/"]
      },
      {
        "name": "编解码器支持",
        "description": "通过 FFmpeg/libavcodec 提供广泛的视频与音频编解码支持，含硬件加速(VAAPI/VDPAU/DXVA2/VideoToolbox)",
        "evidence": ["modules/codec/avcodec/", "modules/hw/"]
      },
      {
        "name": "图形界面",
        "description": "提供 Qt6 桌面界面、ncurses CLI 界面、原生 macOS/Windows 界面、skins2 可换肤界面",
        "evidence": ["modules/gui/qt/", "modules/gui/ncurses.c", "modules/gui/skins2/"]
      },
      {
        "name": "音频输出",
        "description": "支持 PulseAudio、ALSA、JACK、PipeWire、CoreAudio、WASAPI、DirectSound 等音频后端",
        "evidence": ["modules/audio_output/"]
      },
      {
        "name": "视频渲染",
        "description": "支持 OpenGL、Vulkan、Direct3D(9/11)、Wayland、X11/XCB、DRM/KMS 等视频输出后端",
        "evidence": ["modules/video_output/opengl/", "modules/video_output/vulkan/", "modules/video_output/win32/"]
      },
      {
        "name": "嵌入式引擎 libVLC",
        "description": "提供可嵌入第三方应用的播放引擎，含播放控制、媒体列表管理、事件回调等 API",
        "evidence": ["lib/libvlc.c", "lib/media_player.c", "include/vlc/libvlc.h"]
      },
      {
        "name": "流媒体输出",
        "description": "支持将媒体转码并流式输出(HTTP/RTSP/UDP)、录制、视频滤镜与音视频特效",
        "evidence": ["src/stream_output/", "modules/stream_out/"]
      }
    ],
    "domain": "multimedia",
    "target_users": "终端用户（播放器应用）与开发者（libVLC 嵌入式引擎使用者）"
  },
