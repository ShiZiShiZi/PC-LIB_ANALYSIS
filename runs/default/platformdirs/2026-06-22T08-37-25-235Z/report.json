  "function_summary": {
    "summary": "platformdirs 是一个用于确定各操作系统标准应用目录路径的小型 Python 工具库。它为 macOS、Windows、Linux/Unix 与 Android 提供统一接口，返回用户数据、配置、缓存、状态、日志、运行时以及文档/下载/图片等用户媒体目录，使开发者无需关注各平台路径约定差异。核心通过 PlatformDirsABC 抽象基类与平台专属子类实现，并暴露大量便捷函数与 pathlib.Path 变体。",
    "categories": [
      {
        "name": "应用目录解析",
        "description": "按应用名与版本返回数据、配置、缓存、状态、日志、运行时等目录，同时支持 user（单用户可写）与 site（系统只读）两种作用域。",
        "evidence": [
          "src/platformdirs/api.py:PlatformDirsABC",
          "src/platformdirs/__init__.py:user_data_dir / site_data_dir / user_config_dir / site_config_dir"
        ]
      },
      {
        "name": "用户媒体目录解析",
        "description": "返回与用户相关的标准媒体目录，包括 Documents、Downloads、Pictures、Videos、Music、Desktop、Projects、Public share、Templates、Fonts 等。",
        "evidence": [
          "src/platformdirs/api.py:user_documents_dir / user_downloads_dir / user_pictures_dir",
          "src/platformdirs/unix.py:_get_user_dirs_folder"
        ]
      },
      {
        "name": "跨平台后端抽象",
        "description": "依据 sys.platform 与 Android 环境检测，自动选择 Windows、macOS、Unix/Linux 或 Android 后端，各自实现平台原生的路径规则。",
        "evidence": [
          "src/platformdirs/__init__.py:_set_platform_dir_class",
          "src/platformdirs/windows.py:Windows",
          "src/platformdirs/macos.py:MacOS",
          "src/platformdirs/unix.py:Unix",
          "src/platformdirs/android.py:Android"
        ]
      },
      {
        "name": "路径对象与迭代器",
        "description": "除返回字符串的目录函数外，还提供返回 pathlib.Path 的 *_path 属性，以及 iter_*_dirs / iter_*_paths 迭代器，方便批量遍历配置或数据目录。",
        "evidence": [
          "src/platformdirs/api.py:user_data_path / iter_data_dirs / iter_data_paths",
          "src/platformdirs/__init__.py:user_data_path / user_config_path"
        ]
      },
      {
        "name": "XDG 环境变量支持",
        "description": "在 Unix 与 macOS 上遵循 XDG Base Directory Specification，允许通过 XDG_DATA_HOME、XDG_CONFIG_HOME 等环境变量覆盖默认路径。",
        "evidence": [
