    "bindings": []
  },
  "function_summary": {
    "summary": "auditwheel 是 PyPA 维护的命令行工具，用于审计和修复包含原生二进制扩展的 Linux/Android Python wheel。它解析 wheel 中的 ELF 文件及其 DT_NEEDED 依赖树，对照 PEP 600/513/571/599/738 定义的 manylinux/musllinux/android 策略（白名单、符号版本、黑名单、ISA 扩展）检查兼容性，并通过 repair 子命令将外部共享库打包进 wheel、重写 SONAME/RPATH，从而生成兼容性更好的平台 wheel。主要面向 Python 包发布者和 CI/CD 维护人员。",
    "categories": [
      {
        "name": "Wheel 文件解析与平台标签识别",
        "description": "解析 wheel 文件名、dist-info、WHEEL 文件，识别平台标签、架构与 libc 类型（glibc/musl/android）",
        "evidence": [
          "src/auditwheel/wheeltools.py:36-348",
          "src/auditwheel/architecture.py:10-75",
          "src/auditwheel/libc.py:22-57"
        ]
      },
      {
        "name": "ELF 依赖树解析",
        "description": "不执行 ELF 而直接读取其段与动态表，递归解析 DT_NEEDED、RPATH/RUNPATH、解释器及符号版本，构建类似 ldd 的依赖树",
        "evidence": [
          "src/auditwheel/lddtree.py:101-639",
          "src/auditwheel/elfutils.py:18-134"
        ]
      },
      {
        "name": "多平台策略管理与兼容性判定",
        "description": "加载 manylinux/musllinux/android 策略 JSON，基于白名单、符号版本、黑名单与 ISA 扩展判定 wheel 可声明的平台标签",
        "evidence": [
          "src/auditwheel/policy/__init__.py:58-295",
          "src/auditwheel/wheel_abi.py:436-552"
        ]
      },
      {
        "name": "Wheel 修复与依赖打包",
        "description": "将外部共享库复制到 wheel 内，调用 patchelf 重写 SONAME、RPATH 与 DT_NEEDED，并更新 wheel 文件名与 WHEEL 标签",
        "evidence": [
          "src/auditwheel/repair.py:31-149",
          "src/auditwheel/patcher.py:44-107"
        ]
      },
      {
        "name": "SBOM 生成",
        "description": "在修复时为打包进 wheel 的系统库生成 CycloneDX 格式 SBOM，通过系统包管理器（apk/rpm/dpkg/apt）反查库所属软件包",
        "evidence": [
          "src/auditwheel/sboms.py:16-86",
          "src/auditwheel/_vendor/whichprovides/__init__.py:58-334"
        ]
      },
      {
        "name": "命令行接口",
        "description": "提供 show、repair、lddtree 三个子命令，支持平台选择、压缩级别、排除 SONAME、RPATH 搜索路径等选项",
        "evidence": [
          "src/auditwheel/main.py:14-51",
          "src/auditwheel/main_show.py:32-154",
          "src/auditwheel/main_repair.py:129-284",
          "src/auditwheel/main_lddtree.py:23-28"
        ]
      }
    ],
    "domain": "打包与构建工具",
    "target_users": "Python 包发布者、CI/CD 维护人员、Python 打包生态贡献者"
