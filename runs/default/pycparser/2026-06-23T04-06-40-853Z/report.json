  "function_summary": {
    "summary": "pycparser 是一个用纯 Python 编写的 C 语言解析器，主要遵循 C99 标准（部分支持 C11），将 C 源代码转换为抽象语法树（AST）。它既可作为独立库嵌入到静态检查器、代码混淆器、专用编译器前端等工具中，也被 cffi 等 FFI 生成工具用来解析 C 声明以自动生成绑定。",
    "categories": [
      {
        "name": "C 词法分析",
        "description": "CLexer 将 C 源码切分为 Token 流，支持标识符、常量、运算符、预处理指令等 C 词法元素",
        "evidence": ["pycparser/c_lexer.py:CLexer"]
      },
      {
        "name": "C 语法解析",
        "description": "CParser 使用递归下降算法解析 C 翻译单元，输出以 FileAST 为根的 AST",
        "evidence": ["pycparser/c_parser.py:CParser.parse", "pycparser/c_parser.py:_parse_translation_unit_or_empty"]
      },
      {
        "name": "AST 节点模型",
        "description": "c_ast 模块提供 Decl、FuncDecl、Compound、BinaryOp 等 AST 节点类，由 _c_ast.cfg 自动生成",
        "evidence": ["pycparser/c_ast.py:Node", "pycparser/_c_ast.cfg"]
      },
      {
        "name": "AST 遍历与 C 代码生成",
        "description": "NodeVisitor 提供访问者模式遍历 AST，CGenerator 可将 AST 还原为 C 源码字符串",
        "evidence": ["pycparser/c_generator.py:CGenerator", "pycparser/c_ast.py:NodeVisitor"]
      },
      {
        "name": "源码预处理封装",
        "description": "parse_file 与 preprocess_file 提供便捷接口，可调用系统 cpp/gcc/clang -E 对 C 源码做预处理后再解析",
        "evidence": ["pycparser/__init__.py:parse_file", "pycparser/__init__.py:preprocess_file"]
      },
      {
        "name": "AST 规范化转换",
        "description": "fix_switch_cases 与 fix_atomic_specifiers 修正 switch  case 嵌套结构及 _Atomic 限定符的 AST 表示",
        "evidence": ["pycparser/ast_transforms.py:fix_switch_cases", "pycparser/ast_transforms.py:fix_atomic_specifiers"]
      }
    ],
    "domain": "programming-tools",
    "target_users": "Python 开发者、静态分析工具作者、编译器前端与 FFI 自动生成工具开发者"
  },
