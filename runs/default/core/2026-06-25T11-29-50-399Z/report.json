  "function_summary": {
    "summary": "LibreOffice 是一个功能完整的开源办公套件，提供文字处理(Writer)、电子表格(Calc)、演示文稿(Draw/Impress)、数据库管理(Base)、公式编辑(Math)等核心模块。它支持多种文档格式(ODF、OOXML、PDF等)，具备宏脚本支持(StarBasic/Python/JavaScript)，并通过UNO组件架构实现跨平台扩展能力。该项目由The Document Foundation维护，面向个人与企业用户提供桌面办公生产力解决方案。",
    "categories": [
      {
        "name": "文字处理",
        "description": "Writer模块提供完整的文档编辑功能，包括富文本排版、样式管理、表格、图表、邮件合并等",
        "evidence": ["sw/", "sw/source/core/doc/", "sw/inc/swmodule.hxx"]
      },
      {
        "name": "电子表格",
        "description": "Calc模块提供数据分析、公式计算、图表绘制、数据透视表等功能",
        "evidence": ["sc/", "sc/source/core/data/", "sc/inc/scmod.hxx"]
      },
      {
        "name": "演示文稿",
        "description": "Draw/Impress模块提供矢量图形绘制、演示文稿制作、动画效果等功能",
        "evidence": ["sd/", "sd/source/core/", "svx/"]
      },
      {
        "name": "图形渲染引擎",
        "description": "VCL视觉组件库与drawinglayer提供跨平台GUI抽象、窗口管理、2D/3D渲染能力",
        "evidence": ["vcl/", "drawinglayer/", "basegfx/", "canvas/"]
      },
      {
        "name": "文档格式转换",
        "description": "支持ODF、OOXML、PDF、HTML等多种格式的导入导出",
        "evidence": ["filter/", "oox/", "xmloff/", "xmlsecurity/"]
