  "function_summary": {
    "summary": "sphinx-autobuild 是一款面向 Sphinx 文档开发者的实时预览工具。它监听文档源目录的改动，触发 sphinx-build 重新构建 HTML，并通过内置 HTTP/WebSocket 服务器为生成的静态文件提供服务；当构建完成后，向浏览器注入的 JavaScript 会收到刷新指令，实现页面自动热重载。该工具主要供编写、维护或设计 Sphinx 文档与主题的 Python 开发者使用。",
    "categories": [
      {
        "name": "命令行接口",
        "description": "提供与 sphinx-build 兼容的 CLI，支持端口、主机、忽略模式、预/后置命令等自研选项，并复用 Sphinx 的参数解析器。",
        "evidence": [
          "sphinx_autobuild/__main__.py:28-97",
          "sphinx_autobuild/__main__.py:180-248"
        ]
      },
      {
        "name": "文件变更监听",
        "description": "基于 watchfiles 异步监控源目录与额外指定目录的文件变化，并通过 glob 与正则忽略规则过滤噪声路径。",
        "evidence": [
          "sphinx_autobuild/server.py:51-60",
          "sphinx_autobuild/filter.py:11-44"
        ]
      },
      {
        "name": "文档自动重建",
        "description": "检测到变化后，通过 subprocess 调用 python -m sphinx build 重新构建文档，并支持用户自定义的前后置命令。",
        "evidence": [
          "sphinx_autobuild/build.py:26-64"
        ]
      },
      {
        "name": "静态文件服务",
        "description": "使用 Starlette + uvicorn 提供生成目录的 HTTP 静态文件服务，并在 HTML 响应中注入 WebSocket 重载脚本。",
        "evidence": [
          "sphinx_autobuild/__main__.py:99-109",
          "sphinx_autobuild/middleware.py:21-48"
        ]
      },
      {
        "name": "浏览器热重载",
        "description": "通过 WebSocket 在构建完成后向浏览器发送刷新消息，实现无手动刷新的实时预览。",
        "evidence": [
          "sphinx_autobuild/server.py:75-79",
          "sphinx_autobuild/middleware.py:11-18"
        ]
      }
    ],
