  "function_summary": {
    "summary": "pyparsing 是一个纯 Python 编写的解析器组合子库，开发者无需学习 lex/yacc 或编写正则表达式，就能用 Python 对象和运算符直接构造、执行文本解析语法。它提供丰富的语法基元、组合子、预置表达式、Unicode 字符集、测试辅助和可选的铁路图可视化能力，适用于配置文件、查询语言、数据格式、DSL 等各类文本解析场景。",
    "categories": [
      {
        "name": "语法基元",
        "description": "构成解析器的基本匹配单元，包括字面量、字符词、关键字、正则、引号字符串、字符排除等。",
        "evidence": [
          "pyparsing/__init__.py:246-300",
          "pyparsing/core.py:Literal",
          "pyparsing/core.py:Word",
          "pyparsing/core.py:Regex",
          "pyparsing/core.py:QuotedString"
        ]
      },
      {
        "name": "表达式组合与重复",
        "description": "把基本元素组合成复杂语法的组合子，支持顺序、选择、可选、零次或多次、一次或多次、前向引用等结构。",
        "evidence": [
          "pyparsing/__init__.py:240-413",
          "pyparsing/core.py:And",
          "pyparsing/core.py:Or",
          "pyparsing/core.py:MatchFirst",
          "pyparsing/core.py:OneOrMore",
          "pyparsing/core.py:Forward"
        ]
      },
      {
        "name": "解析结果与诊断",
        "description": "提供解析结果对象 ParseResults、异常体系（ParseException 等）、诊断/兼容开关 __diag__/__compat__ 与弃用警告机制。",
        "evidence": [
          "pyparsing/results.py",
