  "function_summary": {
    "summary": "RustDesk 是一款开源的远程桌面软件，使用 Rust 和 Flutter 开发，支持 Windows、Linux 和 macOS 三大桌面平台。它提供远程桌面控制、文件传输、TCP 隧道等功能，采用自研的 rendezvous/relay 协议实现 NAT 穿透和中继连接，用户可使用官方服务器或自建服务器。应用包含服务端（被控端屏幕捕获/音视频编码/输入注入）和客户端（远程连接/音视频解码/输入发送）两部分。",
    "categories": [
      {
        "name": "远程桌面控制",
        "description": "核心功能：屏幕实时捕获与传输、远程键盘鼠标输入注入、多显示器支持、分辨率调整",
        "evidence": ["src/server/video_service.rs", "src/server/input_service.rs", "libs/scrap/"]
      },
      {
        "name": "音视频编解码",
        "description": "视频编码（VP8/VP9/AOM/硬件编码）、音频采集与播放、实时流传输与 QoS 控制",
        "evidence": ["libs/scrap/src/common/codec.rs", "src/client.rs:8 (cpal)", "src/server/video_qos.rs"]
      },
      {
        "name": "网络连接管理",
        "description": "TCP/UDP 连接、NAT 穿透（直接连接与中继）、STUN 客户端、与 rustdesk-server 通信",
        "evidence": ["src/rendezvous_mediator.rs", "src/client.rs", "libs/hbb_common/"]
      },
      {
        "name": "文件传输",
        "description": "远程文件浏览、上传下载、拖拽传输、目录操作",
        "evidence": ["src/server/file_transfer.rs", "src/ipc/fs.rs"]
      },
      {
        "name": "剪贴板同步",
        "description": "跨平台剪贴板内容同步、文件复制粘贴",
        "evidence": ["libs/clipboard/", "src/clipboard.rs"]
      },
      {
        "name": "用户界面",
        "description": "Flutter 桌面 UI（连接管理、地址簿、设置）、系统托盘、多窗口支持",
        "evidence": ["flutter/lib/", "src/tray.rs", "src/ui/"]
      },
      {
        "name": "平台适配层",
        "description": "Windows/Linux/macOS 平台特定的屏幕捕获、输入注入、权限管理、服务安装",
        "evidence": ["src/platform/", "libs/enigo/", "libs/scrap/src/dxgi/", "libs/scrap/src/quartz/"]
      }
    ],
    "domain": "远程桌面/远程控制",
    "target_users": "需要远程访问和控制其他计算机的终端用户"
  },
