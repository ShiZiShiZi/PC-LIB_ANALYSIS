  "function_summary": {
    "summary": "html5lib 是一个纯 Python 编写的 HTML 解析库，严格遵循 WHATWG HTML 规范，能够像主流浏览器一样处理真实世界中可能损坏的 HTML 并执行规范化的错误恢复。它提供文档与片段解析、多后端树构建（etree、DOM、lxml）、树遍历与序列化，以及一个已弃用的 HTML 消毒过滤器。目标用户是需要稳健 HTML 处理的 Python 应用开发者、Web 爬虫、测试工具和其他库。",
    "categories": [
      {
        "name": "HTML 文档与片段解析",
        "description": "将字符串或文件对象解析为完整的 HTML 文档或片段，支持 namespace 元素开关与严格错误模式。",
        "evidence": ["html5lib/__init__.py:25", "html5lib/html5parser.py:24", "html5lib/html5parser.py:72"]
      },
      {
        "name": "树构建器（TreeBuilder）",
        "description": "提供多种树后端实现，包括标准库 xml.etree.ElementTree、xml.dom.minidom 以及可选的 lxml。",
        "evidence": ["html5lib/treebuilders/__init__.py:39", "html5lib/treebuilders/etree.py", "html5lib/treebuilders/dom.py", "html5lib/treebuilders/etree_lxml.py"]
      },
      {
        "name": "树遍历器（TreeWalker）",
        "description": "将已解析的树转换为统一的 token 流，供序列器消费，支持 etree、DOM、lxml 与可选的 Genshi。",
        "evidence": ["html5lib/treewalkers/__init__.py:21", "html5lib/treewalkers/base.py:20", "html5lib/treewalkers/etree.py", "html5lib/treewalkers/genshi.py"]
      },
      {
        "name": "HTML 序列化",
        "description": "将 token 流或树结构序列化为 HTML 字符串，支持可选标签省略、属性引号风格、RCDATA 转义等选项。",
        "evidence": ["html5lib/serializer.py:75", "html5lib/serializer.py:104"]
      },
      {
        "name": "输入流与编码检测",
        "description": "处理字节/Unicode 输入、BOM、传输编码、meta 标签声明编码，以及可选的 chardet 回退检测。",
        "evidence": ["html5lib/_inputstream.py:125", "html5lib/_inputstream.py:451", "html5lib/_inputstream.py:529"]
      },
      {
        "name": "HTML 消毒过滤器（已弃用）",
        "description": "基于允许列表过滤危险标签与属性的过滤器，自 1.1 起已弃用，推荐使用 Bleach。",
        "evidence": ["html5lib/filters/sanitizer.py:1", "html5lib/filters/sanitizer.py:29"]
      }
    ],
