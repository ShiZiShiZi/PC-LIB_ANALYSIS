  "function_summary": {
    "summary": "Nmap（Network Mapper）是一款开源的网络探测与安全审计命令行工具，用于发现网络上的主机、扫描端口、探测服务版本、识别操作系统、执行漏洞检测等。它支持多种扫描技术（TCP/UDP/ICMP/SCTP）、灵活的目标指定、NSE脚本扩展引擎，并提供可选的 Zenmap 图形界面。主要用户为网络安全专业人员、系统管理员和渗透测试人员。",
    "categories": [
      {
        "name": "端口扫描",
        "description": "支持 TCP Connect、TCP SYN、TCP FIN、TCP ACK、UDP、SCTP、IP Protocol 等多种扫描方式",
        "evidence": ["scan_engine.cc", "scan_engine_connect.cc", "scan_engine_raw.cc", "scan_lists.h"]
      },
      {
        "name": "主机发现",
        "description": "通过 ICMP ping、ARP ping、TCP ping 等方式发现网络中的存活主机",
        "evidence": ["targets.cc", "Target.cc", "TargetGroup.cc"]
      },
      {
        "name": "服务与版本探测",
        "description": "识别开放端口上运行的服务及其版本信息",
        "evidence": ["service_scan.cc", "services.cc", "nmap-service-probes"]
      },
      {
        "name": "操作系统识别",
        "description": "通过 TCP/IP 协议栈特征指纹识别目标主机的操作系统",
        "evidence": ["osscan.cc", "osscan2.cc", "FPEngine.cc", "FPModel.cc", "nmap-os-db"]
      },
      {
        "name": "NSE脚本引擎",
        "description": "Lua脚本扩展引擎，支持自定义漏洞检测、暴力破解、后门检测等扩展功能",
        "evidence": ["nse_main.cc", "nse_utility.cc", "nselib/", "liblua/"]
      },
      {
        "name": "网络工具集",
        "description": "包含 Ncat（Netcat替代品）、Nping（packet generator）、Ndiff（扫描结果对比）等辅助工具",
        "evidence": ["ncat/", "nping/", "ndiff/"]
      }
    ],
    "domain": "networking",
    "target_users": "网络安全专业人员、系统管理员、渗透测试工程师"
  },

