    "one_liner": "使用 ctypes/cffi 纯 Python 重新实现 pywin32 子集，用于在 Windows 上调用 Win32 API、资源与凭据接口。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "pywin32-ctypes 是 pywin32 的纯 Python 重新实现，优先通过 cffi、回退到 ctypes 调用 Windows 系统 DLL，安装和运行均无需编译器。它向上提供与 pywin32 兼容的 win32api、win32cred 和 pywintypes 接口，向下封装对 kernel32/advapi32 的调用，适用于希望避免原生 C 扩展依赖、又需要 Windows API 的 Python 项目。",
    "categories": [
      {
        "name": "Win32 API 兼容层",
        "description": "提供与 pywin32.win32api 兼容的常用 Win32 函数封装，包括 DLL 加载卸载、系统启动毫秒数、Windows 目录与 System 目录查询。",
        "evidence": [
          "win32ctypes/pywin32/win32api.py",
          "win32ctypes/core/ctypes/_dll.py",
          "win32ctypes/core/ctypes/_time.py",
          "win32ctypes/core/ctypes/_system_information.py"
        ]
      },
      {
        "name": "Windows 资源管理",
        "description": "枚举、查找、加载和更新 PE 模块中的资源（如图标、字符串表、版本信息等），覆盖 Begin/End/UpdateResource、EnumResource*、FindResourceEx、LoadResource 等 API。",
        "evidence": [
          "win32ctypes/pywin32/win32api.py:130-267",
          "win32ctypes/core/ctypes/_resource.py",
          "win32ctypes/core/cffi/_resource.py"
        ]
      },
      {
        "name": "Windows 凭据管理",
        "description": "封装 Windows Credential Manager 的 CredRead、CredWrite、CredDelete、CredEnumerate 操作，提供与 pywin32.win32cred 类似的字典式凭据读写接口。",
        "evidence": [
          "win32ctypes/pywin32/win32cred.py",
          "win32ctypes/core/ctypes/_authentication.py",
          "win32ctypes/core/cffi/_authentication.py"
        ]
      },
      {
        "name": "ctypes/cffi 后端抽象",
        "description": "运行时自动检测 cffi 是否可用，并通过 import hook 将 win32ctypes.core.* 动态重定向到 ctypes 或 cffi 后端实现，实现同一上层 API 两套底层 FFI 调用。",
        "evidence": [
          "win32ctypes/core/__init__.py",
          "win32ctypes/core/ctypes/_util.py",
          "win32ctypes/core/cffi/_util.py"
        ]
      },
      {
        "name": "通用类型与错误处理",
        "description": "提供 pywintypes.error 异常、datetime 子类与 Time 转换工具，并统一将 ctypes/cffi 抛出的 WindowsError 转换为 pywin32 风格的 error。",
        "evidence": [
          "win32ctypes/pywin32/pywintypes.py",
          "win32ctypes/core/_winerrors.py"
        ]
      }
    ],
