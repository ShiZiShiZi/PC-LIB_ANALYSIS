  "function_summary": {
    "summary": "prompt_toolkit 是一个纯 Python 的交互式命令行 UI 库，面向需要复杂终端交互的 Python 应用。它提供可替换 GNU readline 的输入框架、实时语法高亮、多行编辑、Emacs/Vi 键绑定、自动补全、对话框、进度条以及跨平台（POSIX/Windows）终端抽象，使开发者能够构建 ptpython、IPython、Typer 等工具的 TUI 体验。",
    "categories": [
      {
        "name": "交互式命令行输入",
        "description": "提供 prompt() 便捷函数与 PromptSession 会话对象，支持密码输入、历史、验证、多行编辑与默认键绑定。",
        "evidence": [
          "src/prompt_toolkit/shortcuts/prompt.py:prompt",
          "src/prompt_toolkit/shortcuts/prompt.py:PromptSession",
          "src/prompt_toolkit/__init__.py:23"
        ]
      },
      {
        "name": "语法高亮与样式",
        "description": "通过可选 Pygments 集成实现输入实时语法高亮，并内置默认 UI 样式与 ANSI/HTML 格式化文本。",
        "evidence": [
          "src/prompt_toolkit/lexers/pygments.py:PygmentsLexer",
          "src/prompt_toolkit/styles/defaults.py",
          "src/prompt_toolkit/formatted_text/pygments.py"
        ]
      },
      {
        "name": "键绑定与编辑模式",
        "description": "支持 Emacs 与 Vi 两种编辑模式，提供可扩展的 KeyBindings 系统以及鼠标、搜索、分页等默认绑定。",
        "evidence": [
          "src/prompt_toolkit/key_binding/",
          "src/prompt_toolkit/key_binding/bindings/vi.py",
          "src/prompt_toolkit/key_binding/bindings/named_commands.py"
        ]
      },
      {
        "name": "自动补全与建议",
        "description": "提供 Completer 接口、Completion 状态管理、异步补全以及基于历史的 fish 风格自动建议。",
        "evidence": [
          "src/prompt_toolkit/completion/",
          "src/prompt_toolkit/auto_suggest.py",
          "src/prompt_toolkit/buffer.py:start_completion"
        ]
      },
      {
        "name": "布局与渲染",
        "description": "基于容器/控件/窗口的声明式布局系统，配合 Renderer 将 UI 渲染为 VT100 转义序列或 Windows 控制台 API 调用。",
        "evidence": [
          "src/prompt_toolkit/layout/",
          "src/prompt_toolkit/renderer.py",
