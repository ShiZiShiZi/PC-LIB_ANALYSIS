  "function_summary": {
    "summary": "typeshed 是 Python 生态的核心类型存根仓库，为 Python 标准库、内建对象以及大量第三方 PyPI 包提供 .pyi 静态类型签名。这些存根本身不执行，而是作为类型检查器（mypy、pyright、PyCharm 等）的输入，用于静态分析、类型推断和自动补全。仓库同时包含完整的测试与维护基础设施，用于验证存根质量、自动生成新包存根，以及向 PyPI 发布 types-* 存根包。",
    "categories": [
      {
        "name": "标准库类型存根",
        "description": "为 Python 标准库与内建模块提供类型签名，覆盖 os、sys、socket、ctypes 等模块。",
        "evidence": [
          "stdlib/VERSIONS",
          "stdlib/@tests/test_cases",
          "stdlib/ctypes.pyi",
          "stdlib/os/__init__.pyi"
        ]
      },
      {
        "name": "第三方包类型存根",
        "description": "为 PyPI 上无内建类型注解的第三方包提供 types-* 存根包，按包分目录管理，并声明版本与依赖。",
        "evidence": [
          "stubs/requests/METADATA.toml",
          "stubs/numpy/METADATA.toml",
          "stubs/paramiko/METADATA.toml"
        ]
      },
      {
        "name": "存根质量测试基础设施",
        "description": "使用 mypy、pyright 与 stubtest 对存根进行回归测试、结构检查与运行时一致性校验。",
        "evidence": [
          "tests/mypy_test.py",
          "tests/pyright_test.py",
          "tests/stubtest_stdlib.py",
          "tests/regr_test.py"
        ]
      },
      {
        "name": "存根生成与维护脚本",
        "description": "自动生成新包基线存根、同步上游 protobuf 定义、以及自动检测并更新过期存根版本。",
        "evidence": [
          "scripts/create_baseline_stubs.py",
