  "function_summary": {
    "summary": "Sphinx 是 Python 生态下的文档生成器，以 reStructuredText 为核心标记语言（亦可通过扩展支持 Markdown），将源文档解析并输出为 HTML、LaTeX/PDF、EPUB、man 页、Texinfo、纯文本等多种格式。它面向需要为软件项目构建结构化、可交叉引用、可国际化文档的开发者、技术写作者与开源维护团队。",
    "categories": [
      {
        "name": "多格式文档构建",
        "description": "支持 HTML、LaTeX/PDF、EPUB、man、Texinfo、JSON、XML、gettext 等多种 builder，将源文档渲染为对应输出格式",
        "evidence": ["sphinx/builders/", "sphinx/application.py:builtin_extensions", "pyproject.toml:[project.scripts]"]
      },
      {
        "name": "标记解析与文档转换",
        "description": "基于 docutils 解析 reStructuredText，并通过 Sphinx 自定义的 directives、roles、transforms 实现语义化标记与文档树转换",
        "evidence": ["sphinx/parsers.py", "sphinx/directives/", "sphinx/transforms/", "sphinx/roles.py"]
      },
      {
        "name": "自动交叉引用与索引",
        "description": "通过 Domain 机制为 Python、C、C++、JavaScript 等语言对象建立语义索引，自动生成模块索引、普通索引与链接",
        "evidence": ["sphinx/domains/", "sphinx/roles.py", "sphinx/builders/__init__.py"]
      },
      {
        "name": "代码高亮与模板渲染",
        "description": "使用 Pygments 进行语法高亮，使用 Jinja2 渲染 HTML/LaTeX 主题与页面模板",
        "evidence": ["sphinx/highlighting.py", "sphinx/jinja2glue.py", "sphinx/themes/"]
