    "one_liner": "实现 Python 软件包分发底层工具的低依赖库，被 pip 等工具用作打包基础设施。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "distlib 是 PyPA 维护的 Python 打包基础设施库，提供分发元数据解析、已安装分发数据库、依赖图、版本规范、Wheel 构建与安装、脚本生成、包索引交互（PyPI 上传/下载/签名）以及资源定位等低层能力。它被设计为 pip、caniusepython3 等更高级工具的底层依赖，本身不声明任何运行时第三方依赖。",
    "categories": [
      {
        "name": "分发元数据与版本管理",
        "description": "解析并生成 PEP 241/314/345/566/643 定义的 PKG-INFO/METADATA，实现 PEP 440 版本规范与 PEP 508 环境标记。",
        "evidence": ["distlib/metadata.py:605", "distlib/version.py:17", "distlib/markers.py:24"]
      },
      {
        "name": "已安装分发与依赖图",
        "description": "按 PEP 376 读取 site-packages 中的已安装分发信息，构建分发之间的依赖图并生成 DOT 输出。",
        "evidence": ["distlib/database.py:27", "distlib/database.py:1071"]
      },
      {
        "name": "Wheel 构建与安装",
        "description": "支持 PEP 427 Wheel 格式的构建、安装、兼容标签计算以及签名/验签流程。",
        "evidence": ["distlib/wheel.py:180", "distlib/wheel.py:252"]
      },
      {
        "name": "脚本生成与启动器",
        "description": "生成入口脚本并调整 shebang；在 Windows 上可嵌入预构建的 .exe 启动器（PC/launcher.c），提供原生可执行包装。",
        "evidence": ["distlib/scripts.py:93", "distlib/scripts.py:149", "PC/launcher.c:1042"]
      },
      {
        "name": "包索引交互",
        "description": "通过 HTTP/HTTPS 与 PyPI 等兼容索引通信，支持注册、上传、文档上传以及 GnuPG 签名/验签。",
        "evidence": ["distlib/index.py:29", "distlib/index.py:108", "distlib/index.py:232"]
      },
      {
        "name": "分发定位与下载",
        "description": "在 PyPI、本地目录或其他索引源中查找并下载分发包，支持 XML-RPC 与 simple API。",
        "evidence": ["distlib/locators.py:86", "distlib/locators.py:188"]
      },
      {
        "name": "资源与清单工具",
        "description": "访问包内数据文件（含 zip 内资源）并生成 MANIFEST 文件列表，提供增强 glob 等辅助工具。",
        "evidence": ["distlib/resources.py:12", "distlib/manifest.py:21", "distlib/util.py:1444"]
      }
    ],
