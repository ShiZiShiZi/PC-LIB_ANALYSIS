  "function_summary": {
    "summary": "cssselect 是一个轻量级的 Python 库，核心任务是把 CSS3 选择器字符串解析成可被 XPath 引擎执行的中缀表达式树，再进一步翻译为 XPath 1.0 表达式。它本身不直接操作 DOM，而是作为 lxml、html5lib 等 XML/HTML 解析器的前置选择器层，帮助开发者用熟悉的 CSS 语法在文档树中定位节点。",
    "categories": [
      {
        "name": "CSS 选择器解析",
        "description": "将 CSS3 选择器字符串分词、语法分析并构建为 Selector/Element/Class/Hash/Attrib/CombinedSelector 等对象树，支持 :not()、:is()、:where()、:has() 等现代伪类及伪元素。",
        "evidence": [
          "cssselect/parser.py:499 parse()",
          "cssselect/parser.py:552 parse_selector()",
          "cssselect/parser.py:932 tokenize()"
        ]
      },
      {
        "name": "XPath 1.0 转换",
        "description": "把解析后的选择器对象递归翻译为 XPath 1.0 表达式，覆盖组合器、属性匹配、结构伪类（:nth-child 等）和 :contains()、:lang() 等功能伪类。",
        "evidence": [
          "cssselect/xpath.py:203 GenericTranslator.css_to_xpath()",
          "cssselect/xpath.py:227 GenericTranslator.selector_to_xpath()",
          "cssselect/xpath.py:289 GenericTranslator.xpath()"
        ]
      },
      {
        "name": "HTML 适配翻译",
        "description": "通过 HTMLTranslator 提供 HTML5 语义化的伪类实现，如 :checked、:disabled、:enabled、:link 等，并对元素名和属性名做大小写不敏感处理。",
        "evidence": [
          "cssselect/xpath.py:802 HTMLTranslator",
          "cssselect/xpath.py:828 xpath_checked_pseudo()",
          "cssselect/xpath.py:861 xpath_disabled_pseudo()"
        ]
      },
      {
        "name": "结构化选择器扩展",
        "description": "支持相对选择器 :has()、选择器列表 :is()/matches() 以及零特化选择器 :where()，满足复杂文档查询场景。",
        "evidence": [
          "cssselect/parser.py:265 Relation",
          "cssselect/parser.py:296 Matching",
          "cssselect/parser.py:321 SpecificityAdjustment"
        ]
      },
      {
        "name": "开发者工具与错误处理",
        "description": "提供 SelectorSyntaxError、ExpressionError 等异常类型，以及选择器规范化输出、特异性计算等辅助能力，便于上层框架集成与调试。",
        "evidence": [
          "cssselect/parser.py:33 SelectorError",
          "cssselect/parser.py:113 Selector.canonical()",
          "cssselect/parser.py:126 Selector.specificity()"
        ]
      }
    ],
