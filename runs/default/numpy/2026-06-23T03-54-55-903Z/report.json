  "function_summary": {
    "summary": "NumPy 是 Python 科学计算生态的基石库，核心提供高性能的 N 维数组对象 ndarray、基于广播机制的通用函数（ufunc）、丰富的数组创建/变形/索引操作，以及线性代数、快速傅里叶变换、随机数生成等计算模块。它还通过 f2py 提供 Fortran/C/C++ 代码与 Python 的绑定能力，并对外暴露 C-API 供第三方扩展使用。主要面向数据科学、机器学习、数值模拟等领域的 Python 开发者。",
    "categories": [
      {
        "name": "多维数组对象与基础数组操作",
        "description": "提供 ndarray 对象及数组创建、索引、切片、变形、拼接、广播、拷贝等核心操作，是 NumPy 所有上层功能的数据基础。",
        "evidence": [
          "numpy/__init__.py:119-200",
          "numpy/_core/__init__.py",
          "numpy/_core/src/multiarray/arrayobject.c",
          "numpy/_core/src/multiarray/ctors.c"
        ]
      },
      {
        "name": "通用函数与逐元素运算",
        "description": "通过 ufunc 机制对数组执行向量化数学、逻辑、位运算；在 C 层实现循环分发与 SIMD 加速，支持自定义 ufunc 与类型提升。",
        "evidence": [
          "numpy/_core/src/umath/ufunc_object.c",
          "numpy/_core/src/umath/dispatching.cpp",
          "numpy/_core/src/common/simd"
        ]
      },
      {
        "name": "线性代数",
        "description": "封装 BLAS/LAPACK 提供矩阵乘法、特征分解、SVD、求解线性方程组、最小二乘等线性代数运算，无外部 BLAS 时回退到 lapack_lite。",
        "evidence": [
          "numpy/linalg/meson.build",
          "numpy/linalg/lapack_lite",
          "numpy/_core/src/common/cblasfuncs.c"
        ]
      },
      {
        "name": "快速傅里叶变换",
        "description": "基于 pocketfft 提供一维及多维复数/实数 FFT、逆变换与实数频谱函数。",
        "evidence": [
          "numpy/fft/_pocketfft.py",
          "numpy/fft/pocketfft"
        ]
      },
      {
        "name": "随机数生成",
        "description": "提供现代伪随机数生成器（PCG64、Philox、SFC64、MT19937 等）及多种分布采样，并以 C 扩展实现高性能。",
        "evidence": [
          "numpy/random/_generator.pyx",
          "numpy/random/src/distributions",
          "numpy/random/src/pcg64"
        ]
      },
      {
        "name": "Fortran/C/C++ 集成工具",
        "description": "f2py 解析 Fortran 签名/源码并生成 Python 扩展模块的 C 包装代码，运行时通过 meson 调用 Fortran/C 编译器完成构建。",
        "evidence": [
          "numpy/f2py/f2py2e.py",
          "numpy/f2py/_backends/_meson.py",
          "numpy/f2py/rules.py"
        ]
      },
      {
        "name": "数据类型与类型标注",
        "description": "支持丰富的标量类型、结构化 dtype、数组 API 标准兼容能力，以及类型存根（.pyi）和数组命名空间信息。",
