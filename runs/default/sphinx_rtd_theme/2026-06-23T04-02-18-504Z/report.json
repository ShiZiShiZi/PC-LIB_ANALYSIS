  "function_summary": {
    "summary": "sphinx_rtd_theme 是 Sphinx 文档生成器的 HTML 主题包，提供 Read the Docs 风格的响应式文档界面。它通过 Sphinx 扩展机制注册主题，并附带侧边栏导航、面包屑、搜索框、版本选择器等 Jinja2 模板，以及由 Sass/JavaScript 编写的前端样式与交互逻辑。目标用户是使用 Sphinx 构建文档的 Python 开发者与文档维护者。",
    "categories": [
      {
        "name": "HTML 主题模板",
        "description": "提供 layout.html、footer.html、breadcrumbs.html、searchbox.html 等 Jinja2 模板，定义文档页面的整体结构与页面片段。",
        "evidence": [
          "sphinx_rtd_theme/layout.html",
          "sphinx_rtd_theme/footer.html",
          "sphinx_rtd_theme/breadcrumbs.html",
          "sphinx_rtd_theme/searchbox.html"
        ]
      },
      {
        "name": "主题注册与配置",
        "description": "通过 Sphinx 扩展入口 setup() 注册 html_theme、加载消息目录、校验主题选项，并向模板上下文注入 Sphinx 版本与 Read the Docs 环境变量。",
        "evidence": [
          "sphinx_rtd_theme/__init__.py:setup",
          "sphinx_rtd_theme/__init__.py:config_initiated",
          "sphinx_rtd_theme/__init__.py:extend_html_context",
          "sphinx_rtd_theme/theme.conf"
        ]
      },
      {
        "name": "前端样式",
        "description": "使用 Sass 编写主题样式，依赖 bourbon、bourbon-neat、font-awesome、wyrm 等框架，经 webpack 编译为静态 CSS。",
        "evidence": [
          "src/sass/theme.sass",
          "src/sass/_theme_layout.sass",
          "src/sass/_theme_variables.sass",
          "webpack.common.js"
        ]
      },
      {
        "name": "前端交互",
        "description": "基于 jQuery 实现浏览器端侧边栏导航、目录展开/收起、锚点定位、窗口滚动与尺寸自适应等交互。",
        "evidence": [
          "src/theme.js:ThemeNav",
          "sphinx_rtd_theme/static/js/theme.js"
        ]
      },
      {
        "name": "国际化与本地化",
        "description": "通过 Babel 从 Jinja2 模板提取可翻译字符串，维护多语言 .po/.pot/.mo 文件，支持 Sphinx 消息目录。",
        "evidence": [
          "babel.cfg",
          "sphinx_rtd_theme/locale/",
          "setup.cfg:[extract_messages]"
        ]
      }
    ],
    "domain": "documentation",
    "target_users": "使用 Sphinx 构建文档的 Python 开发者与文档维护者"
