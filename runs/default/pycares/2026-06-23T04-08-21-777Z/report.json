  "function_summary": {
    "summary": "pycares 是 c-ares C 库的 Python 封装，通过 cffi 暴露异步 DNS 查询、地址解析与 DNS 记录解析能力。它面向需要在 Python 中执行高性能异步域名解析的开发者，提供类似 Python socket 的回调式 API，并附带一个简易命令行 dig 工具。",
    "categories": [
      {
        "name": "异步 DNS 查询",
        "description": "发起 A/AAAA/MX/NS/SOA/SRV/TXT/CNAME/CAA/TLSA/HTTPS/URI/ANY 等 DNS 查询，支持 search 路径与自定义服务器、选项。",
        "evidence": ["src/pycares/__init__.py:763 Channel.query", "src/pycares/__init__.py:804 Channel.search", "src/_cffi_src/build_cares.py:591 ares_query_dnsrec"]
      },
      {
        "name": "地址解析",
        "description": "提供 getaddrinfo（主机名到地址）、gethostbyaddr（反向解析）和 getnameinfo（地址到名称服务）的异步封装。",
        "evidence": ["src/pycares/__init__.py:729 Channel.getaddrinfo", "src/pycares/__init__.py:706 Channel.gethostbyaddr", "src/pycares/__init__.py:893 Channel.getnameinfo"]
      },
      {
        "name": "DNS 记录解析",
        "description": "将 c-ares 返回的原始 DNS 记录解析为类型化的 Python dataclass，包括 answer/authority/additional 三个区段。",
        "evidence": ["src/pycares/__init__.py:346 parse_dnsrec", "src/pycares/__init__.py:215 extract_record_data", "src/pycares/__init__.py:974 DNSResult dataclass"]
      },
      {
        "name": "通道生命周期管理",
        "description": "创建、配置、关闭 c-ares channel，支持超时、重试、服务器、本地 IP/网卡、resolv.conf 等选项，以及后台安全销毁线程。",
        "evidence": ["src/pycares/__init__.py:487 Channel.__init__", "src/pycares/__init__.py:433 _ChannelShutdownManager", "src/pycares/__init__.py:930 Channel.close"]
      },
      {
        "name": "错误处理与常量",
        "description": "暴露 c-ares 错误码、查询类型/类常量、channel 标志位，并提供 strerror 中文友好错误描述。",
        "evidence": ["src/pycares/errno.py", "src/pycares/__init__.py:27 ARES_FLAG_* constants", "src/pycares/__init__.py:59 QUERY_TYPE_* constants"]
      },
      {
        "name": "国际化域名编码",
        "description": "支持 ASCII 与 IDN 2003/2008 域名编码；可选依赖 idna 提供 IDNA 2008 支持。",
        "evidence": ["src/pycares/utils.py:44 parse_name", "src/pycares/utils.py:29 parse_name_idna2008", "pyproject.toml:42 idna optional"]
      },
      {
        "name": "命令行 dig 工具",
        "description": "提供 python -m pycares [query_type] hostname 命令行接口，按 dig 风格输出 DNS 结果。",
        "evidence": ["src/pycares/__main__.py", "README.rst:92"]
      }
