  "function_summary": {
    "summary": "xrdp 是一个开源的 RDP（远程桌面协议）服务器，运行于 GNU/Linux 系统，监听 TCP 3389 端口，为客户端提供远程图形桌面访问。它实现了完整的 RDP 协议栈，支持 TLS 加密传输、会话重连、剪贴板双向传输、音频重定向、驱动重定向等功能。核心架构包含主守护进程（xrdp）、会话管理器（sesman）及多个协议模块（libxrdp、xup、vnc、neutrinordp），与 xorgxrdp Xorg 模块配合实现 Linux 桌面的远程呈现。",
    "categories": [
      {"name": "RDP 协议实现", "description": "实现 Microsoft Remote Desktop Protocol 协议栈，包括连接建立、能力协商、输入/输出虚拟通道、图形编码等", "evidence": ["libxrdp/", "xrdp/xrdp_rdp.c", "common/ms-rdpbcgr.h"]},
      {"name": "会话管理", "description": "管理用户登录会话，包括 PAM 认证、会话创建/销毁、X server 启动、进程监控", "evidence": ["sesman/sesman.c", "sesman/session_list.c", "sesman/libsesman/verify_user_pam.c"]},
      {"name": "图形编码与加速", "description": "支持 RemoteFX、NSCodec、JPEG/H.264 编码；可选 NVENC GPU 加速、OpenGL/EGL 渲染辅助", "evidence": ["librfxcodec/", "xrdp_accel_assist/xrdp_accel_assist_nvenc.c", "xrdp_accel_assist/xrdp_accel_assist_glx.c"]},
      {"name": "虚拟通道服务", "description": "提供剪贴板、音频、驱动重定向等虚拟通道服务（chansrv）", "evidence": ["sesman/chansrv/", "sesman/chansrv/chansrv.c"]},
      {"name": "协议桥接模块", "description": "支持 VNC 代理、RDP 代理（neutrinordp）、xorgxrdp 客户端模块", "evidence": ["vnc/vnc.c", "neutrinordp/", "xup/xup.c"]}
    ],
    "domain": "远程桌面/网络服务",
    "target_users": "Linux 系统管理员、需要远程桌面访问的企业/个人用户"
  },
