          "pyproject.toml project.scripts"
        ]
      },
      {
        "name": "平台集成与可选扩展",
        "description": "针对Windows提供ActiveX/COM容器、Adobe PDF控件封装；针对GTK提供Cairo/Pango桥接；支持WebView、OpenGL等可选平台特性。",
        "evidence": [
