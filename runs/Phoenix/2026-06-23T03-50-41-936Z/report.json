        ]
      },
      {
        "name": "高级控件与布局库",
        "description": "在wx.lib与wx.lib.agw中提供大量纯Python实现的高级控件，如AUI停靠窗格、FlatMenu、Ribbon、UltimateListCtrl、FloatCanvas等，补充核心控件能力。",
        "evidence": [
          "wx/lib/agw/aui/framemanager.py",
          "wx/lib/agw/flatmenu.py",
          "wx/lib/agw/ribbon/bar.py",
          "wx/lib/agw/ultimatelistctrl.py",
          "wx/lib/floatcanvas/FloatCanvas.py"
        ]
      },
      {
        "name": "交互式Python Shell与开发工具",
        "description": "提供PyCrust、PyShell、PySlices等内嵌式交互解释器，以及img2py、img2png、helpviewer、wxget等配套工具脚本。",
        "evidence": [
          "wx/py/PyCrust.py",
          "wx/py/PyShell.py",
          "wx/tools/img2py.py",
          "wx/tools/helpviewer.py",
