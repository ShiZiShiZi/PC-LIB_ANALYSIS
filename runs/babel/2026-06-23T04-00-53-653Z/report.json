    "one_liner": "Python 国际化与本地化工具库，提供 CLDR 数据访问、gettext 消息目录管理及数字/日期/时区格式化能力。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "Babel 是 Python 生态中主流的国际化（i18n）与本地化（l10n）工具库。它将 Unicode CLDR（通用区域数据仓库）打包为 Python 可访问的 locale 数据，向应用开发者提供 locale 解析、数字/货币/日期/列表/单位格式化、gettext 消息目录（PO/MO）读写与合并、消息提取以及 pybabel 命令行工具等能力。",
    "categories": [
      {
        "name": "Locale 数据与解析",
        "description": "封装 CLDR 全球 locale 数据，提供 Locale 对象、locale 标识符解析、locale 协商与回退、区域元数据查询等核心能力。",
        "evidence": [
          "babel/core.py:Locale",
          "babel/core.py:parse_locale",
          "babel/core.py:negotiate_locale",
          "babel/localedata.py"
        ]
      },
      {
        "name": "数字与货币格式化",
        "description": "按 locale 习惯格式化十进制数、货币、百分比、科学计数、紧凑数字，并支持复数规则与自定义数字系统。",
        "evidence": [
          "babel/numbers.py:format_decimal",
          "babel/numbers.py:format_currency",
          "babel/numbers.py:format_percent"
        ]
      },
      {
        "name": "日期与时间格式化",
        "description": "按 locale 与 timezone 格式化日期、时间、日期时间、相对时长及间隔，并支持时区名称本地化。",
        "evidence": [
          "babel/dates.py:format_date",
          "babel/dates.py:format_datetime",
          "babel/dates.py:format_time",
          "babel/dates.py:format_timedelta"
        ]
      },
      {
        "name": "列表与单位格式化",
        "description": "依据 CLDR 列表模式连接多个项目，并格式化度量单位与复合单位（如千米/小时）。",
        "evidence": [
          "babel/lists.py:format_list",
          "babel/units.py:format_unit",
          "babel/units.py:format_compound_unit"
        ]
      },
      {
        "name": "gettext 消息目录管理",
        "description": "创建、更新、合并 gettext 消息目录，读写 PO/MO 文件，支持复数形式、上下文（msgctxt）与标志管理。",
        "evidence": [
          "babel/messages/catalog.py:Catalog",
          "babel/messages/pofile.py",
          "babel/messages/mofile.py"
        ]
      },
      {
        "name": "消息提取与前端集成",
        "description": "从 Python、JavaScript 等源码中提取可翻译字符串，提供 pybabel 命令行接口与 setuptools/distutils 集成命令。",
        "evidence": [
          "babel/messages/extract.py",
          "babel/messages/frontend.py:main",
          "babel/messages/setuptools_frontend.py"
        ]
      },
      {
        "name": "本地时区检测",
        "description": "在 Windows 通过注册表、在 Unix/Linux/macOS 通过 /etc/localtime 等系统文件检测本地时区，并回退到手动偏移时区。",
        "evidence": [
          "babel/localtime/__init__.py",
          "babel/localtime/_win32.py",
          "babel/localtime/_unix.py",
          "babel/localtime/_fallback.py"
        ]
      }
    ],
    "domain": "internationalization and localization",
    "target_users": "Python 应用与 Web 应用开发者、需要多语言支持的库作者"
  },
