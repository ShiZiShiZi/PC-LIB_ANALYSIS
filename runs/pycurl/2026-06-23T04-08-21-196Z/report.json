  "function_summary": {
    "summary": "PycURL 是 libcurl 的 Python 绑定库，将 libcurl 的多协议文件传输能力暴露给 Python 程序。它提供同步/异步 HTTP/FTP 请求、WebSocket、MIME 表单、连接共享、SSL/TLS 选项等底层网络控制，适合需要比 requests 更高性能或更细粒度 libcurl 控制的应用开发者。",
    "categories": [
      {
        "name": "HTTP/HTTPS 客户端请求",
        "description": "通过 Curl 对象执行同步 HTTP/HTTPS 请求，支持 setopt、perform、getinfo 等 libcurl 核心 API。",
        "evidence": ["src/easy.c:do_curl_new", "src/easy.c:curlobject_methods", "src/easyperform.c:do_curl_perform"]
      },
      {
        "name": "多协议文件传输",
        "description": "依托 libcurl 支持 FTP、SFTP、WebSocket、FILE 等多种协议的数据传输。",
        "evidence": ["src/pycurl.h", "README.rst:28-48", "src/easyws.c"]
      },
      {
        "name": "异步/多路复用",
        "description": "提供 CurlMulti 与 AsyncCurlMulti，基于 libcurl multi-socket API 实现非阻塞并发传输。",
        "evidence": ["src/multi.c:curlmultiobject_methods", "src/pycurl/async_multi.py:AsyncCurlMulti"]
      },
      {
        "name": "MIME/多部分表单",
        "description": "通过 CurlMime 与 CurlMimePart 封装 libcurl MIME API，构造文件上传与表单请求。",
        "evidence": ["src/mime.c:curlmimeobject_methods", "src/mime.c:CurlMime_Type"]
      },
      {
        "name": "连接共享与会话状态",
        "description": "通过 CurlShare 共享 DNS、Cookie、SSL 会话等状态，减少连接开销。",
        "evidence": ["src/share.c:curlshareobject_methods", "src/share.c:CurlShare_Type"]
      },
      {
        "name": "SSL/TLS 与代理配置",
        "description": "暴露 libcurl 的 SSL 后端选项、CA 证书、代理、认证等高级网络配置常量与方法。",
        "evidence": ["src/module.c:COMPILE_SSL_LIB", "src/easyopt.c:do_curl_setopt", "src/threadsupport.c"]
      }
    ],
    "domain": "networking",
    "target_users": "Python 应用开发者，特别是需要高性能网络传输或直接使用 libcurl 能力的场景"
  },
