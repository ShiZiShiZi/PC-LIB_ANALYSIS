  "function_summary": {
    "summary": "parso 是一个纯 Python 实现的 Python 语法解析器，为 IDE、静态分析工具和其他 Python 语言服务提供带错误恢复的解析能力。它支持按指定 Python 版本解析源码、通过 DiffParser 对代码变更进行增量解析、保留原始代码格式的往返解析，并能够一次性报告多个语法与缩进错误。",
    "categories": [
      {
        "name": "Python 语法解析",
        "description": "将 Python 源码转换为具体语法树（CST），支持按指定 Python 版本选择对应文法进行解析",
        "evidence": ["parso/__init__.py:49-58", "parso/grammar.py:49-163", "parso/python/parser.py:11-79"]
      },
      {
        "name": "错误恢复与诊断",
        "description": "在代码不完整或存在语法错误时生成错误节点，避免解析中断，并迭代输出多个语法/缩进错误",
        "evidence": ["parso/python/parser.py:111-180", "parso/python/errors.py", "parso/parser.py:146-152"]
      },
      {
        "name": "增量解析",
        "description": "通过 DiffParser 对比新旧代码行差异，仅重新解析变更部分以提升重复解析性能",
        "evidence": ["parso/python/diff.py", "parso/grammar.py:122-147"]
      },
      {
        "name": "语法树操作",
        "description": "提供 PythonNode、Leaf 等节点类型，支持 get_code() 往返输出、get_root_node() 获取根节点、位置查询与父节点遍历",
        "evidence": ["parso/python/tree.py", "parso/tree.py"]
      },
      {
        "name": "分词器",
        "description": "内置 Python 分词器，支持 f-string、INDENT/DEDENT、编码声明、BOM 处理等 Python 词法特性",
        "evidence": ["parso/python/tokenize.py", "parso/python/token.py"]
      },
      {
        "name": "文法加载与管理",
        "description": "根据 Python 版本加载内置 BNF 文法文件（grammar*.txt）并缓存 Grammar 实例",
        "evidence": ["parso/grammar.py:234-271", "parso/pgen2/generator.py"]
      },
      {
        "name": "文件与缓存 I/O",
        "description": "通过 FileIO 读取源文件，支持内存缓存与可选的磁盘 pickle 缓存，并提供缓存清理能力",
        "evidence": ["parso/file_io.py", "parso/cache.py"]
      }
    ],
