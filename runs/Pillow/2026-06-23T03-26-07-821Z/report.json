    "bindings": []
  },
  "function_summary": {
    "summary": "Pillow 是 Python Imaging Library（PIL）的友好分支，为 Python 提供高效的图像处理能力。它支持超过 40 种图像格式的打开与保存、像素级操作、几何变换、滤镜、绘图、文字渲染、ICC 色彩管理以及屏幕截图/显示等辅助功能。核心由 C 扩展实现以兼顾性能，上层为 Python  API，广泛用于 Web 后端、数据科学、机器学习预处理、桌面应用与自动化脚本。",
    "categories": [
      {
        "name": "图像文件格式读写",
        "description": "支持 BMP、JPEG、PNG、GIF、TIFF、WebP、AVIF、ICO、PDF 等大量格式的解码与编码，每种格式以独立插件实现。",
        "evidence": [
          "src/PIL/__init__.py:27-75 (_plugins 列表)",
          "src/PIL/ImageFile.py",
          "src/PIL/JpegImagePlugin.py",
          "src/PIL/PngImagePlugin.py"
        ]
      },
      {
        "name": "图像变换与处理",
        "description": "提供缩放、裁剪、旋转、模式转换、滤镜、直方图、颜色增强、alpha 合成等通用图像处理操作。",
        "evidence": [
          "src/PIL/Image.py",
          "src/PIL/ImageFilter.py",
          "src/PIL/ImageOps.py",
          "src/PIL/ImageEnhance.py",
          "src/PIL/ImageTransform.py",
          "src/libImaging/Resample.c",
          "src/libImaging/Filter.c"
        ]
      },
      {
        "name": "图像绘制与文字",
        "description": "在图像上绘制几何图形、文字与路径，并通过 FreeType/Raqm 渲染 TrueType/OpenType 字体与复杂文本布局。",
        "evidence": [
          "src/PIL/ImageDraw.py",
          "src/PIL/ImageFont.py",
          "src/PIL/ImageDraw2.py",
          "src/_imagingft.c",
          "src/libImaging/Draw.c"
        ]
      },
      {
        "name": "色彩管理",
        "description": "基于 Little CMS 2 实现 ICC 色彩空间转换、配置文件读写与打样（proofing）功能。",
        "evidence": [
          "src/PIL/ImageCms.py",
          "src/_imagingcms.c"
        ]
      },
      {
        "name": "屏幕捕获与显示",
        "description": "提供跨平台的图像显示（ImageShow）、屏幕/剪贴板截图（ImageGrab）以及 Windows 原生窗口/X11 显示支持。",
        "evidence": [
          "src/PIL/ImageShow.py",
          "src/PIL/ImageGrab.py",
          "src/PIL/ImageWin.py",
          "src/display.c"
        ]
      },
      {
        "name": "底层 C 性能扩展",
        "description": "核心像素操作、编解码器与内存管理通过 pybind11/setuptools 构建的 C 扩展实现，以保证处理速度。",
        "evidence": [
          "src/_imaging.c",
          "src/libImaging/*.c",
          "pyproject.toml:2-6 (build-system)",
          "setup.py:20-23"
        ]
      }
    ],
