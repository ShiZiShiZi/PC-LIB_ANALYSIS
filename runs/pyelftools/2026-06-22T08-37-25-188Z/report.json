  "function_summary": {
    "summary": "pyelftools 是一个纯 Python 库，用于解析和分析 ELF（Executable and Linkable Format）可执行文件及其 DWARF 调试信息。它面向逆向工程师、编译器/调试器开发者以及需要在 Python 中读取二进制文件结构的应用开发者，提供从文件头、节区、段、符号表、重定位、动态链接信息到 DWARF 编译单元、DIE、行号表等全方位解析能力。",
    "categories": [
      {
        "name": "ELF 文件解析",
        "description": "解析 ELF 文件头、节区表、程序头段、符号表、字符串表等核心结构",
        "evidence": [
          "elftools/elf/elffile.py:ELFFile",
          "elftools/elf/sections.py:Section",
          "elftools/elf/segments.py:Segment"
        ]
      },
      {
        "name": "DWARF 调试信息解析",
        "description": "解析 DWARF 编译单元、调试信息项(DIE)、行号程序、位置列表、范围列表、调用帧等调试结构",
        "evidence": [
          "elftools/dwarf/dwarfinfo.py:DWARFInfo",
          "elftools/dwarf/die.py:DIE",
          "elftools/dwarf/lineprogram.py:LineProgram"
        ]
      },
      {
        "name": "重定位处理",
        "description": "读取和解释 REL/RELA/RELR 重定位表项",
        "evidence": [
          "elftools/elf/relocation.py:Relocation",
          "elftools/elf/relocation.py:RelocationSection"
        ]
      },
      {
        "name": "动态链接信息",
        "description": "解析动态段/节区、动态标签、依赖库名、运行路径等",
        "evidence": [
          "elftools/elf/dynamic.py:Dynamic",
          "elftools/elf/dynamic.py:DynamicTag"
        ]
      },
      {
        "name": "ARM EHABI 展开信息",
        "description": "解析 ARM 异常处理 ABI 的索引表与字节码",
        "evidence": [
          "elftools/ehabi/ehabiinfo.py:EHABIInfo",
          "elftools/ehabi/decoder.py:EHABIBytecodeDecoder"
        ]
      },
      {
        "name": "CLI 工具",
        "description": "提供类 readelf/dwarfdump 的命令行脚本，用于快速查看 ELF/DWARF 内容",
        "evidence": [
          "scripts/readelf.py:ReadElf",
          "scripts/dwarfdump.py"
        ]
      },
      {
        "name": "结构化二进制解析",
        "description": "基于内嵌 construct 风格的声明式语法，定义和解析 ELF/DWARF 二进制结构",
        "evidence": [
          "elftools/construct/core.py",
          "elftools/construct/adapters.py"
        ]
      }
    ],
