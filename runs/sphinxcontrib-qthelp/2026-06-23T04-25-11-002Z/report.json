  "function_summary": {
    "summary": "sphinxcontrib-qthelp 是一个 Sphinx 构建器扩展，继承自 StandaloneHTMLBuilder，在生成普通 HTML 文档的同时，额外输出 Qt 帮助系统所需的 .qhp（Qt Help Project）与 .qhcp（Qt Help Collection Project）文件。它解析 Sphinx 文档树目录、索引和关键词，生成可被 Qt Assistant / qcollectiongenerator 消费的 XML 项目文件，常用于把 Sphinx 文档打包成离线帮助。",
    "categories": [
      {
        "name": "Qt 帮助项目生成",
        "description": "基于 Sphinx 构建结果生成 .qhp 项目文件，包含命名空间、自定义过滤器、目录、关键词和文件清单。",
        "evidence": ["sphinxcontrib/qthelp/__init__.py:build_qhp:93-150", "sphinxcontrib/qthelp/templates/project.qhp"]
      },
      {
        "name": "集合项目生成",
        "description": "生成 .qhcp 集合项目文件，定义帮助集合的标题、主页、起始页以及 .qch 编译与注册配置。",
        "evidence": ["sphinxcontrib/qthelp/__init__.py:build_qhp:145-150", "sphinxcontrib/qthelp/templates/project.qhcp"]
      },
      {
        "name": "目录结构转换",
        "description": "将 Sphinx doctree 中的 toctree 节点递归转换为 Qt Help 的 <section> 层级 XML。",
        "evidence": ["sphinxcontrib/qthelp/__init__.py:write_toc:163-191"]
      },
      {
        "name": "索引关键词构建",
        "description": "从 Sphinx 索引适配器提取索引项，生成 <keyword> 元素，并针对类/方法名构造规范化 id。",
        "evidence": ["sphinxcontrib/qthelp/__init__.py:build_keywords:215-234", "sphinxcontrib/qthelp/__init__.py:keyword_item:193-213"]
      },
      {
        "name": "Sphinx 扩展接入",
        "description": "通过 setup() 注册 QtHelpBuilder 构建器、配置项（命名空间、主题等）和翻译目录。",
        "evidence": ["sphinxcontrib/qthelp/__init__.py:setup:251-266"]
      }
