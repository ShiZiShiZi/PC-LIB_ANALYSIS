  "function_summary": {
    "summary": "sphinxcontrib-applehelp 是一个 Sphinx 构建器扩展，它将 Sphinx 生成的 HTML 文档打包成 macOS Help Viewer 可识别的 Apple Help Book（.help  bundles）。扩展负责创建 Contents/Resources/<locale>.lproj 目录结构、生成 Info.plist、复制本地化资源、调用 hiutil 建立搜索索引，并可选择调用 codesign 对帮助包签名。它面向使用 Sphinx 编写文档并需要发布 macOS 原生帮助内容的开发者与文档工程师。",
    "categories": [
      {
        "name": "Apple Help Book 构建",
        "description": "继承 StandaloneHTMLBuilder 实现 applehelp 构建器，输出 .help 目录结构并注册到 Sphinx。",
        "evidence": [
          "sphinxcontrib/applehelp/__init__.py:53 AppleHelpBuilder",
          "sphinxcontrib/applehelp/__init__.py:239 setup"
        ]
      },
      {
        "name": "Info.plist 生成",
        "description": "使用 plistlib 生成 Apple Help Book 的 Info.plist，写入 bundle 标识、版本、标题、访问页与索引路径等元数据。",
        "evidence": [
          "sphinxcontrib/applehelp/__init__.py:129 build_info_plist",
          "sphinxcontrib/applehelp/__init__.py:156 plistlib.dump"
        ]
      },
      {
        "name": "本地化资源处理",
        "description": "复制源目录中 <locale>.lproj 下的本地化文件到帮助包对应位置，并支持通过模板生成访问页 _access.html。",
        "evidence": [
          "sphinxcontrib/applehelp/__init__.py:103 copy_localized_files",
          "sphinxcontrib/applehelp/__init__.py:171 build_access_page"
        ]
      },
      {
        "name": "帮助搜索索引生成",
        "description": "调用 macOS 的 hiutil 工具为帮助内容生成 search.helpindex 搜索索引。",
        "evidence": [
          "sphinxcontrib/applehelp/__init__.py:179 build_helpindex",
          "sphinxcontrib/applehelp/__init__.py:206 subprocess.run"
        ]
      },
      {
        "name": "可选代码签名",
        "description": "当配置 applehelp_codesign_identity 时，调用 macOS 的 codesign 工具对 .help 包进行签名。",
        "evidence": [
          "sphinxcontrib/applehelp/__init__.py:213 do_codesign",
          "sphinxcontrib/applehelp/__init__.py:231 subprocess.run"
        ]
      }
    ],
