  "function_summary": {
    "summary": "virtualenv 是一款 Python 虚拟环境创建工具，支持通过命令行或编程 API 为 CPython、PyPy、GraalPy、RustPython 等多种 Python 实现生成隔离的运行环境。它能够发现本机 Python 解释器、通过复制或符号链接构建环境目录、生成多种 shell 的激活脚本，并可选择在环境中预装 pip、setuptools 等种子包。",
    "categories": [
      {
        "name": "Python 解释器发现",
        "description": "根据用户指定的版本、路径或标识符，在本机文件系统中发现并匹配可用的 Python 解释器，缓存解释器元数据以加速后续调用。",
        "evidence": ["src/virtualenv/discovery/builtin.py:68", "src/virtualenv/discovery/discover.py:29"]
      },
      {
        "name": "虚拟环境创建",
        "description": "基于选定的解释器创建隔离环境，支持 venv 内联创建、调用宿主 Python 的 venv 子进程，以及基于全局引用文件的复制/符号链接策略。",
        "evidence": ["src/virtualenv/create/creator.py:198", "src/virtualenv/create/via_global_ref/venv.py:50", "src/virtualenv/create/via_global_ref/api.py:110"]
      },
      {
        "name": "种子包安装",
        "description": "在创建环境后，通过内嵌 wheel、本地搜索目录或 PyPI 下载方式安装 pip、setuptools 等种子包，并支持周期性更新已下载的 wheel。",
        "evidence": ["src/virtualenv/seed/embed/pip_invoke.py:26", "src/virtualenv/seed/wheels/acquire.py:51", "src/virtualenv/seed/embed/base_embed.py:55"]
      },
      {
        "name": "激活脚本生成",
        "description": "为新环境生成 bash、zsh、fish、PowerShell、cmd、cshell、nushell、xonsh 以及 Python 内联形式的激活/反激活脚本。",
        "evidence": ["src/virtualenv/activation/via_template.py:43", "src/virtualenv/activation/activator.py:17", "pyproject.toml:59"]
      },
      {
        "name": "应用数据与缓存管理",
        "description": "管理解释器信息缓存、wheel 仓库和更新日志的持久化存储，使用文件锁保证多进程安全，并支持只读/临时回退模式。",
        "evidence": ["src/virtualenv/app_data/via_disk_folder.py:50", "src/virtualenv/app_data/__init__.py:25", "src/virtualenv/util/lock.py:94"]
      },
      {
        "name": "命令行与配置",
        "description": "提供基于 argparse 的 CLI 入口，支持 INI 配置文件、环境变量覆盖以及详细的日志与调试信息输出。",
        "evidence": ["src/virtualenv/run/__init__.py:26", "src/virtualenv/config/ini.py:22", "src/virtualenv/config/env_var.py:15"]
      }
    ],
