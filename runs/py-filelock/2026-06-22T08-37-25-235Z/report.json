  "function_summary": {
    "summary": "filelock 是一个跨平台的 Python 文件锁库，为开发者提供基于操作系统原语的独占文件锁（Unix/Linux/macOS 使用 fcntl.flock，Windows 使用 msvcrt.locking，无原生锁时回退到软锁），以及基于 SQLite 的读写锁和基于文件标记的软读写锁；同时提供同步与 asyncio 异步 API，用于多进程/多线程间的资源协调、缓存、日志等场景。",
    "categories": [
      {
        "name": "平台独占文件锁",
        "description": "在 Unix 类系统通过 fcntl.flock 对锁文件加锁，在 Windows 通过 msvcrt.locking 加锁，实现跨进程互斥；运行时根据 sys.platform 自动选择后端。",
        "evidence": ["src/filelock/_unix.py", "src/filelock/_windows.py", "src/filelock/__init__.py"]
      },
      {
        "name": "软文件锁",
        "description": "不依赖 OS 级锁原语，通过 os.open(O_CREAT | O_EXCL) 创建锁文件实现可移植互斥，并自动检测并清理僵死锁。",
        "evidence": ["src/filelock/_soft.py"]
      },
      {
        "name": "读写锁",
        "description": "基于 SQLite 事务实现跨进程共享读锁与独占写锁，支持同模式可重入、禁止读写到写读升级/降级。",
        "evidence": ["src/filelock/_read_write.py"]
      },
      {
        "name": "软读写锁",
        "description": "基于 SoftFileLock 文件标记与心跳线程，实现适用于 NFS 等共享存储的跨主机读写锁，并处理 fork 后的状态失效。",
        "evidence": ["src/filelock/_soft_rw/_sync.py"]
      },
      {
        "name": "异步锁支持",
        "description": "提供 AsyncFileLock 与 AsyncReadWriteLock，通过 asyncio 线程池或 executor 包装同步加锁逻辑，支持 async with。",
        "evidence": ["src/filelock/asyncio.py", "src/filelock/_async_read_write.py"]
      },
      {
        "name": "锁生命周期与超时管理",
        "description": "支持阻塞/非阻塞获取、超时、轮询间隔、锁有效期、僵死锁自动清理、单例缓存及线程本地上下文。",
        "evidence": ["src/filelock/_api.py"]
      }
    ],
    "domain": "系统并发与文件锁",
    "target_users": "Python 应用开发者、库作者及需要跨进程资源协调的工具开发者"
  },
