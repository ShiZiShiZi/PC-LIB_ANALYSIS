  "function_summary": {
    "summary": "go-github 是 Google 官方维护的 Go 语言客户端库，用于访问 GitHub REST API v3。它将 GitHub API 的各个功能域（仓库、组织、用户、Issue、Pull Request、Actions、安全等 40+ 服务）封装为类型安全的 Go 方法调用，支持 OAuth Token 认证、GitHub App 认证、分页、速率限制检测与条件请求，是 Go 生态中访问 GitHub API 的最主流方式。",
    "categories": [
      {
        "name": "HTTP API 客户端框架",
        "description": "提供统一的 HTTP 客户端架构，支持自定义 Transport、超时、代理、User-Agent、多 API 版本协商等底层配置，所有 API 调用统一经过中心化的请求构造与响应解析流程",
        "evidence": [
          "github/github.go:167 Client struct",
          "github/github.go:351 clientOptions struct",
          "github/github.go:789 NewClient"
        ]
      },
      {
        "name": "认证与授权管理",
        "description": "支持 OAuth Token、HTTP Basic Auth、GitHub App（Installation Token / JWT）多种认证方式，并提供 WithAuthToken、BasicAuthTransport 等辅助方法",
        "evidence": [
          "github/github.go:436 WithAuthToken",
          "github/github.go:944 BasicAuthTransport"
        ]
      },
      {
        "name": "仓库管理",
        "description": "覆盖仓库的 CRUD、分支保护、协作者管理、部署、环境、Webhook、Release、Pages、LFS、属性、规则等完整的仓库生命周期 API",
        "evidence": [
          "github/repos.go",
          "github/repos_deployments.go",
          "github/repos_releases.go",
          "github/repos_hooks.go"
        ]
      },
      {
        "name": "Git 数据与引用",
        "description": "底层 Git 对象操作——blob、commit、ref、tag、tree 的创建与查询，支持 GitHub 的 Git Data API",
        "evidence": [
          "github/git_blobs.go",
          "github/git_commits.go",
          "github/git_refs.go",
          "github/git_trees.go"
        ]
      },
      {
        "name": "Issue、Pull Request 与项目管理",
        "description": "Issue 的创建/查询/评论/标签/里程碑/时间线、Pull Request 的创建/审查/合并/评论、Projects（看板）、SubIssue 等协作流程的完整封装",
        "evidence": [
          "github/issues.go",
          "github/pulls.go",
          "github/projects.go",
          "github/sub_issue.go"
        ]
      },
      {
        "name": "GitHub Actions 与 CI/CD",
        "description": "Actions 工作流、作业、运行记录、Runner/Runner Group、Secrets、Variables、OIDC、Artifacts、Cache、Hosted Runner、Permissions 等持续集成功能的 API 封装",
        "evidence": [
          "github/actions_workflows.go",
          "github/actions_workflow_runs.go",
          "github/actions_runner_groups.go",
          "github/actions_secrets.go"
        ]
      },
      {
        "name": "安全与合规",
        "description": "代码扫描 (Code Scanning)、密钥扫描 (Secret Scanning)、安全公告 (Security Advisories)、SCIM、审计日志 (Audit Log)、依赖快照、Dependabot 等安全相关 API",
        "evidence": [
          "github/code_scanning.go",
          "github/secret_scanning.go",
          "github/security_advisories.go",
          "github/dependabot.go"
        ]
      },
      {
        "name": "组织与企业管理",
        "description": "组织成员/权限/角色、团队、审计、计费、许可证、GitHub Enterprise 特有能力（网络配置、代码安全配置、托管 GHES、SCIM 等）的 API 封装",
        "evidence": [
          "github/orgs.go",
          "github/enterprise.go",
          "github/teams.go",
          "github/admin.go"
        ]
      }
    ],
    "domain": "developer-tools",
    "target_users": "需要以编程方式访问 GitHub API 的 Go 开发者与 DevOps 工具链"
