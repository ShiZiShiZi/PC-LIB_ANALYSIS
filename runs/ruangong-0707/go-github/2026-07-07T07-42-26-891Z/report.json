  "function_summary": {
    "summary": "go-github 是 Google 官方维护的 Go 语言 GitHub REST API v3 客户端库，提供对 GitHub API 几乎全部功能的类型安全封装。通过 Client 结构体上的 40+ 服务字段（Actions、Issues、Repositories、PullRequests、Organizations、Enterprise 等），开发者可在 Go 程序中以惯用方式操作 GitHub 资源——包括仓库管理、Issue/PR CRUD、CI/CD Actions、代码扫描、企业审计、Copilot 管理等。库内置分页迭代、速率限制追踪与重试、OAuth/App 认证传输层、请求/响应类型安全结构体与 JSON 序列化等能力，是 Go 生态中访问 GitHub API 的事实标准库。",
    "categories": [
      {
        "name": "GitHub 资源 CRUD 服务",
        "description": "对仓库、Issue、Pull Request、Release、Gist、项目等 GitHub 核心资源的完整增删改查操作，含分页、过滤与批量接口",
        "evidence": [
          "github/github.go:207-251",
          "github/repos_*.go",
          "github/issues.go",
          "github/pulls.go",
          "github/gists.go"
        ]
      },
      {
        "name": "CI/CD 与自动化（Actions/Checks）",
        "description": "管理 GitHub Actions 工作流运行、Job、Artifact、Cache、Runner、Secret、OIDC 及 Check Run/Check Suite 的全生命周期",
        "evidence": [
          "github/actions_*.go",
          "github/checks.go",
          "github/actions_workflows.go",
          "github/actions_workflow_runs.go"
        ]
      },
      {
        "name": "企业级管理（Enterprise/Org/Admin）",
        "description": "GitHub Enterprise Server 管理、组织管理、团队管理、SCIM 用户同步、企业审计日志流、计费与许可证等企业级功能",
        "evidence": [
          "github/enterprise_*.go",
          "github/orgs_*.go",
          "github/admin_*.go",
          "github/enterprise_scim.go"
        ]
      },
      {
        "name": "安全与合规",
        "description": "代码扫描、密钥扫描、依赖图、Dependabot 告警与密钥、安全公告、交互限制、分支保护规则等安全与合规功能",
        "evidence": [
          "github/code_scanning.go",
          "github/secret_scanning.go",
          "github/dependabot_*.go",
          "github/dependency_graph.go"
        ]
      },
      {
        "name": "认证与速率限制",
        "description": "OAuth Token、Basic Auth、GitHub App 安装认证传输层，以及速率限制追踪、二级限制重试、条件请求支持",
        "evidence": [
          "github/github.go:436-447",
          "github/github.go:511-539",
          "github/rate_limit.go",
          "github/authorizations.go"
        ]
      },
      {
        "name": "Copilot 与开发者工具",
        "description": "GitHub Copilot 云代理、座位管理、扩展管理，以及 Codespaces、Classroom 等开发者工具的 API 封装",
        "evidence": [
          "github/copilot.go",
          "github/copilot_cloud_agent.go",
          "github/codespaces.go",
          "github/classroom.go"
        ]
      }
    ],
    "domain": "开发者工具 / API 客户端",
    "target_users": "需要在 Go 程序中与 GitHub API 交互的开发者——包括 CI/CD 工具作者、DevOps 工程师、GitHub App 开发者、以及企业级 GitHub 管理自动化团队"
  },
