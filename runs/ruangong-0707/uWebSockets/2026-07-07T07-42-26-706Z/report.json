  "function_summary": {
    "summary": "µWebSockets 是一个用 C/C++ 编写的高性能 WebSocket 和 HTTP 服务器库，面向需要极致吞吐量和低延迟的实时 Web 应用场景。它提供 Express.js 风格的 URL 路由器、内置 Pub/Sub 主题树、permessage-deflate 压缩、TLS 1.3/SNI 支持，以及实验性 HTTP/3(QUIC) 能力。底层依赖 µSockets 事件循环抽象层，可选用 epoll/kqueue/libuv/ASIO 等多种事件后端。",
    "categories": [
      {
        "name": "WebSocket 服务器",
        "description": "完整实现 RFC 6455 WebSocket 协议（服务端），支持 permessage-deflate 压缩、ping/pong 心跳、背压管理、升级握手和自动超时断开",
        "evidence": [
          "src/WebSocket.h",
          "src/WebSocketProtocol.h",
          "src/WebSocketHandshake.h",
          "src/WebSocketContext.h"
        ]
      },
      {
        "name": "HTTP 服务器",
        "description": "提供 HTTP/1.1 请求解析与响应构建，支持 GET/POST/PUT/DELETE 等 URL 路由、分块传输编码、流式大文件响应、Corking 优化和 Slow Loris 防护",
        "evidence": [
          "src/HttpParser.h",
          "src/HttpResponse.h",
          "src/HttpContext.h",
          "src/HttpRouter.h",
          "src/ChunkedEncoding.h"
        ]
      },
      {
        "name": "发布订阅（Pub/Sub）",
        "description": "内置 TopicTree 主题树实现高效的消息发布/订阅，支持按主题订阅/退订、消息批量投递和背压感知的 drain 机制",
        "evidence": [
          "src/TopicTree.h",
          "src/App.h:166-178"
        ]
      },
      {
        "name": "TLS/SSL 加密",
        "description": "通过 µSockets 支持 OpenSSL、BoringSSL 或 WolfSSL 后端，提供 TLS 1.3、SNI 多域名和证书热加载",
        "evidence": [
          "src/App.h:62-78",
          "build.c:48-62"
        ]
      },
      {
        "name": "HTTP/3（QUIC）实验性支持",
        "description": "通过 lsquic 集成提供实验性 HTTP/3 服务，包括 QUIC 上下文、请求/响应对象",
        "evidence": [
          "src/Http3App.h",
          "src/Http3Context.h",
          "src/Http3Request.h",
          "src/Http3Response.h"
        ]
      },
      {
        "name": "事件循环抽象",
        "description": "通过 µSockets 抽象层提供线程局部事件循环，支持 epoll(Linux)/kqueue(macOS)/libuv/ASIO/GCD 多种后端，含定时器、defer 队列和跨线程唤醒",
        "evidence": [
          "src/Loop.h",
          "src/LoopData.h",
          "src/AsyncSocket.h"
        ]
      }
    ],
    "domain": "networking",
    "target_users": "需要构建高性能实时 WebSocket/HTTP 服务的 C++ 后端开发者，以及通过 Node.js 绑定（uWebSockets.js）使用的 JavaScript 开发者"
  },
