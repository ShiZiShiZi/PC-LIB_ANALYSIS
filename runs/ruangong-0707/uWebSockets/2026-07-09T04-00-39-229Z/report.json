  "function_summary": {
    "summary": "uWebSockets 是一个面向高并发场景的 C++ 高性能 Web 服务器库，以 header-only 方式分发。它构建于 uSockets 之上，提供 HTTP(S) 路由、WebSocket 实时通信、HTTP3/QUIC（实验性）、发布/订阅消息广播、Zlib 压缩扩展等功能，支持 OpenSSL / BoringSSL / WolfSSL 三种 TLS 后端。适用于加密货币交易所等对延迟和吞吐有极致要求的实时 Web 应用。",
    "categories": [
      {
        "name": "HTTP(S) 服务器与 URL 路由",
        "description": "提供完整的 HTTP 请求解析、响应构建、分块传输编码、多部分表单解析、URL 参数/通配符路由匹配、服务器名虚拟主机等能力，支持 Builder 模式链式定义路由。",
        "evidence": [
          "src/App.h:83",
          "src/HttpContext.h",
          "src/HttpResponse.h",
          "src/HttpRouter.h",
          "src/HttpParser.h",
          "src/ChunkedEncoding.h",
          "src/Multipart.h",
          "src/QueryParser.h"
        ]
      },
      {
        "name": "WebSocket 实时通信",
        "description": "支持 RFC 6455 WebSocket 协议的完整服务端实现，包含 WebSocket 升级握手、分片发送、compression permessage-deflate 压缩、心跳超时管理，通过 Autobahn 测试套件满分验证。",
        "evidence": [
          "src/WebSocket.h",
          "src/WebSocketProtocol.h",
          "src/WebSocketHandshake.h",
          "src/WebSocketExtensions.h",
          "src/PerMessageDeflate.h"
        ]
      },
      {
        "name": "发布/订阅消息广播",
        "description": "内置基于 TopicTree 的发布/订阅系统，支持通配符主题订阅（如 'sports/*'）与高效消息广播分发。",
        "evidence": [
          "src/TopicTree.h",
          "src/BloomFilter.h"
        ]
      },
      {
        "name": "TLS/SSL 加密传输",
        "description": "通过 uSockets 层集成 OpenSSL、BoringSSL 或 WolfSSL，提供 TLS 1.3 加密的 HTTPS/WSS 支持，支持证书文件、CA 文件、DH 参数等 SSL 上下文配置。",
        "evidence": [
          "src/App.h:62-78",
          "build.c:48-62"
        ]
      },
      {
        "name": "HTTP3/QUIC 实验性支持",
        "description": "通过 lsquic 后端提供 HTTP3/QUIC（RFC 9114）服务端支持，属于实验性功能，需 `WITH_QUIC=1` 构建开关启用。",
        "evidence": [
          "src/Http3App.h",
          "src/Http3Context.h",
          "src/Http3Response.h",
          "src/Http3Request.h",
          "build.c:42-45"
        ]
      },
      {
        "name": "多线程与多事件循环支持",
        "description": "支持每线程一个应用实例的多核扩展模型（每个 CPU 核创建独立线程和事件循环），通过 SO_REUSEPORT 共享监听端口；支持 defer 延迟执行、pre/post 事件循环钩子。",
        "evidence": [
          "src/Loop.h",
          "src/LoopData.h",
          "src/LocalCluster.h",
          "src/AsyncSocket.h"
        ]
      },
      {
        "name": "HTTP 缓存与压缩",
        "description": "内建 HTTP 响应缓存层（CachingApp），支持基于 URL 的缓存自动生成与失效；支持 zlib（及可选的 libdeflate 快速路径）内容压缩。",
        "evidence": [
          "src/CachingApp.h",
          "src/PerMessageDeflate.h",
          "build.c:18-34"
        ]
      }
    ],
    "domain": "网络服务 / 实时通信",
    "target_users": "需要高并发、低延迟 HTTP/WebSocket 服务端应用的 C++ 后端开发者",
    "ecosystem": "cpp"
  },
