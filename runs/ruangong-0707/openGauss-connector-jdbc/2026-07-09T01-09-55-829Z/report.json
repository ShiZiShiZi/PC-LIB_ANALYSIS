  "function_summary": {
    "summary": "openGauss-connector-jdbc 是 openGauss 数据库的 Java JDBC 驱动，基于 PostgreSQL JDBC 驱动演进而来，向 Java 应用提供符合 JDBC 4.2 标准的数据库访问接口。它覆盖连接管理、SQL 执行、连接池、分布式事务、逻辑复制、读写分离、集群健康探测、SSL/TLS 与国密 TLCP 安全传输、以及客户端逻辑（客户端加密）等能力，主要面向使用 openGauss 的后端 Java 业务系统。",
    "categories": [
      {
        "name": "JDBC 驱动与连接管理",
        "description": "实现 java.sql.Driver 并向 DriverManager 注册，解析 JDBC URL，建立 TCP 连接，管理连接属性与会话状态。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/Driver.java:86",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgConnection.java",
          "pgjdbc/src/main/java/org/postgresql/core/v3/ConnectionFactoryImpl.java"
        ]
      },
      {
        "name": "SQL 执行与结果集",
        "description": "提供 Statement、PreparedStatement、CallableStatement 及结果集、元数据实现，支持参数绑定、批处理与返回生成键。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgStatement.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgPreparedStatement.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgResultSet.java",
          "pgjdbc/src/main/java/org/postgresql/PGResultSetMetaData.java"
        ]
      },
      {
        "name": "连接池与数据源",
        "description": "提供 PGSimpleDataSource、PGConnectionPoolDataSource、PGPoolingDataSource 等标准数据源，便于应用服务器与连接池框架集成。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/ds/common/BaseDataSource.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc2/optional/SimpleDataSource.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc2/optional/ConnectionPool.java"
        ]
      },
      {
        "name": "XA 分布式事务",
        "description": "实现 XADataSource、XAConnection 与 XAResource，支持 JTA 事务管理器集成。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/xa/PGXADataSource.java",
          "pgjdbc/src/main/java/org/postgresql/xa/PGXAConnection.java"
        ]
      },
      {
        "name": "复制与流复制",
        "description": "支持逻辑复制槽、流复制连接与复制流 API，用于 CDC 等场景。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/replication/PGReplicationConnection.java",
          "pgjdbc/src/main/java/org/postgresql/replication/PGReplicationConnectionImpl.java",
          "pgjdbc/src/main/java/org/postgresql/core/v3/replication/V3PGReplicationStream.java"
        ]
      },
      {
        "name": "读写分离",
        "description": "在 autoCommit 下依据 SQL 类型（SELECT 还是写操作）通过 ShardingSphere SQL 解析器将请求路由到主节点或只读从节点。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/readwritesplitting/ReadWriteSplittingPgConnection.java",
          "pgjdbc/src/main/java/org/postgresql/readwritesplitting/SqlRouteEngine.java:30"
        ]
      },
      {
        "name": "集群健康探测",
        "description": "通过心跳与缓存机制跟踪主从节点状态，为读写分离和故障切换提供集群拓扑信息。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/clusterhealthy/ClusterHeartBeat.java",
          "pgjdbc/src/main/java/org/postgresql/clusterhealthy/ClusterNodeCache.java",
          "pgjdbc/src/main/java/org/postgresql/quickautobalance/Cluster.java"
        ]
      },
      {
        "name": "SSL/TLS 与国密 TLCP",
        "description": "支持标准 TLSv1.2/1.3 连接，以及基于 BGMProvider 的国密 TLCP（GMTLS/ECDHE_SM4_SM3 等）安全传输。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/ssl/MakeSSL.java",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQFactory.java",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQTlcpFactory.java:71"
        ]
      },
      {
        "name": "客户端逻辑（客户端加密）",
        "description": "通过 JNI 调用 gauss_cl_jni 原生库，对含客户端逻辑字段的 SQL 进行预处理与后处理，实现客户端侧加密/解密。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogic.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogicImpl.java:12"
        ]
      },
      {
        "name": "数据类型与工具",
        "description": "提供 PostgreSQL/openGauss 特有类型（几何类型、大对象、数组等）、MD5/SM3 摘要、时间戳转换、URL 编解码等工具类。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/geometric/PGline.java",
          "pgjdbc/src/main/java/org/postgresql/util/MD5Digest.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/TimestampUtils.java"
        ]
      }
    ],
    "domain": "database / data access",
    "target_users": "使用 openGauss 数据库的 Java 后端应用开发者与数据库中间件开发者"
  },
