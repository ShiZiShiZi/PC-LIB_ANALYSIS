  "function_summary": {
    "summary": "openGauss-connector-jdbc 是 openGauss 关系型数据库的官方 Java JDBC 驱动库。它在 PostgreSQL JDBC 驱动（pgjdbc）基础上演进，向上提供标准 java.sql 接口与 openGauss 扩展接口（PGConnection），向下通过 TCP/SSL 与 openGauss 后端通信，支持连接管理、认证、SQL 执行、数据类型映射、批量 COPY、大对象、流复制、负载均衡、读写分离等能力。目标用户为使用 Java 访问 openGauss 数据库的开发者与应用程序。",
    "categories": [
      {
        "name": "JDBC 驱动核心与连接建立",
        "description": "实现 java.sql.Driver 与服务发现机制，解析 jdbc:opengauss:// URL，建立 TCP/SSL 连接，维护连接属性与驱动信息。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/Driver.java:86",
          "pgjdbc/src/main/java/org/postgresql/PGConnection.java:24",
          "pgjdbc/src/main/java/org/postgresql/core/ConnectionFactory.java:28"
        ]
      },
      {
        "name": "连接管理与高可用",
        "description": "支持多主机、故障转移、负载均衡、读写分离、连接池数据源、XA 事务与全局连接跟踪，提升集群场景下的可用性。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/hostchooser/MultiHostChooser.java",
          "pgjdbc/src/main/java/org/postgresql/quickautobalance/ConnectionManager.java:42",
          "pgjdbc/src/main/java/org/postgresql/readwritesplitting/ReadWriteSplittingPgConnection.java:46",
          "pgjdbc/src/main/java/org/postgresql/ds/PGConnectionPoolDataSource.java:39"
        ]
      },
      {
        "name": "认证与安全",
        "description": "支持密码、Kerberos/GSSAPI、SSPI（构建时可选排除）等认证方式，提供 SSL/TLS 连接、证书校验与 TLS 国密（TLCP）能力。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/gss/GssAction.java:28",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQFactory.java:43",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQTlcpFactory.java",
          "pgjdbc/src/main/java/org/postgresql/PGProperty.java:396"
        ]
      },
      {
        "name": "SQL 执行与数据类型",
        "description": "实现 Statement/PreparedStatement/CallableStatement、结果集元数据、数据库元数据，映射 PostgreSQL/openGauss 特有数据类型（几何、数组、大对象、XML 等）。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgStatement.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgResultSet.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgDatabaseMetaData.java",
          "pgjdbc/src/main/java/org/postgresql/geometric/",
          "pgjdbc/src/main/java/org/postgresql/util/PGobject.java"
        ]
      },
      {
        "name": "批量导入与高级协议特性",
        "description": "提供 COPY 批量导入导出、大对象（LargeObject）、异步通知（LISTEN/NOTIFY）、流复制连接、Fastpath 等 PostgreSQL/openGauss 扩展协议能力。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/copy/CopyManager.java",
          "pgjdbc/src/main/java/org/postgresql/largeobject/LargeObjectManager.java",
          "pgjdbc/src/main/java/org/postgresql/replication/PGReplicationConnection.java",
          "pgjdbc/src/main/java/org/postgresql/PGNotification.java"
        ]
      },
      {
        "name": "客户端逻辑（Client Logic）",
        "description": "通过 JNI 调用 gauss_cl_jni 原生库，实现客户端加密/透明数据加密等 openGauss 客户端逻辑特性。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogic.java:20",
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogicImpl.java:10"
        ]
      }
    ],
    "domain": "database connectivity",
    "target_users": "使用 Java 访问 openGauss 数据库的开发者与后端应用程序"
  },
