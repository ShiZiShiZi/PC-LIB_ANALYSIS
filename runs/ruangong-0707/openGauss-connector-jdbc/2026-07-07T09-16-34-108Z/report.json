  "function_summary": {
    "summary": "openGauss-connector-jdbc 是 openGauss 数据库的官方 Java JDBC 驱动库，基于 PostgreSQL JDBC Driver（pgjdbc）演进而来。它实现了 java.sql.Driver 接口，为 Java 应用提供通过标准 JDBC 4.2 API 访问 openGauss 关系型数据库的能力，覆盖连接建立、SQL 执行、预编译语句、事务、分布式 XA、连接池/数据源、SSL/TLS 与国密 TLCP 安全传输、客户端加密（Client Logic）、读写分离与高可用路由等能力，主要面向 Java 应用开发者和数据库中间件。",
    "categories": [
      {
        "name": "JDBC 驱动注册与连接管理",
        "description": "实现 java.sql.Driver，向 DriverManager 注册；解析 jdbc:postgresql:/jdbc:oGRAC: 等 URL，建立 PgConnection 物理连接。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/Driver.java:86",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgConnection.java:446"
        ]
      },
      {
        "name": "SQL 执行与预编译语句",
        "description": "封装 Statement、PreparedStatement、CallableStatement，支持服务器端预编译缓存、二进制传输、批处理与结果集元数据。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgStatement.java:158",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgPreparedStatement.java",
          "pgjdbc/src/main/java/org/postgresql/core/Query.java"
        ]
      },
      {
        "name": "事务与分布式 XA",
        "description": "提供标准 JDBC 事务控制，并通过 PGXAConnection/PGXADataSource 实现 javax.sql.XAConnection/XADataSource，支持两阶段提交。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/xa/PGXAConnection.java:43",
          "pgjdbc/src/main/java/org/postgresql/xa/PGXADataSource.java:23"
        ]
      },
      {
        "name": "数据源与连接池适配",
        "description": "提供 PGSimpleDataSource、PGConnectionPoolDataSource 及公共基类 BaseDataSource，供应用服务器连接池集成。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/ds/PGSimpleDataSource.java:25",
          "pgjdbc/src/main/java/org/postgresql/ds/PGConnectionPoolDataSource.java:39",
          "pgjdbc/src/main/java/org/postgresql/ds/common/BaseDataSource.java"
        ]
      },
      {
        "name": "SSL/TLS 与国密安全传输",
        "description": "支持基于 JSSE 的 SSL/TLS 连接（LibPQFactory），并支持国密 TLCP/GM 算法（LibPQTlcpFactory、BGMProvider）。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQFactory.java:43",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQTlcpFactory.java",
          "pgjdbc/src/main/java/org/postgresql/ssl/MakeSSL.java:38"
        ]
      },
      {
        "name": "客户端加密 Client Logic",
        "description": "可选的客户端加密功能，通过 JNI 调用外部原生库 gauss_cl_jni，对启用 enable_ce=1 的连接的查询与字段加解密。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogic.java:20",
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogicImpl.java:10",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgConnection.java:719"
        ]
      },
      {
        "name": "高可用与读写分离",
        "description": "支持集群状态选择、健康检查、快速自动负载均衡以及基于 ShardingSphere SQL 解析的读写分离路由。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/clusterchooser",
          "pgjdbc/src/main/java/org/postgresql/clusterhealthy",
          "pgjdbc/src/main/java/org/postgresql/readwritesplitting/ReadWriteSplittingPgConnection.java",
          "pgjdbc/src/main/java/org/postgresql/quickautobalance"
        ]
      },
      {
        "name": "大对象、Copy 与数据类型",
        "description": "提供 LargeObject、CopyManager、几何类型、数组、XML、JSON 等 openGauss/PostgreSQL 特有数据类型的映射。",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/largeobject",
          "pgjdbc/src/main/java/org/postgresql/copy",
          "pgjdbc/src/main/java/org/postgresql/geometric",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgArray.java"
        ]
      }
    ],
    "domain": "database connectivity / data access",
    "target_users": "Java 应用开发者、企业级数据库中间件、需要连接 openGauss 的后端服务"
  },
