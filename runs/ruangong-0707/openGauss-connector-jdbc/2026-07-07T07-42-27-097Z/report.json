  "function_summary": {
    "summary": "openGauss-connector-jdbc 是 openGauss 数据库的官方 JDBC 驱动，基于 PostgreSQL JDBC 驱动（pgjdbc）二次开发，实现了完整的 JDBC 4.2 规范。它为 Java 应用提供连接 openGauss 和 PostgreSQL 数据库的标准接口，支持 SQL 查询与更新、事务管理、连接池、SSL/TLS 加密连接、GSS/Kerberos 认证、读写分离、集群心跳检测、数据复制流、大对象操作、客户端数据加密（Client Logic）等企业级特性。驱动还支持国密 TLCP 协议和 BouncyCastle 加密库集成。",
    "categories": [
      {
        "name": "JDBC 核心驱动",
        "description": "实现 java.sql.Driver 接口与 JDBC 4.2 规范，提供数据库连接建立、SQL 语句执行、结果集处理、事务控制等核心功能",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/Driver.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgConnection.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgStatement.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/PgResultSet.java"
        ]
      },
      {
        "name": "连接池与数据源",
        "description": "提供 JDBC 数据源与连接池实现（PGSimpleDataSource、PGPoolingDataSource、PGPooledConnection），支持 JNDI 注册与 OSGi 部署",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/ds/PGSimpleDataSource.java",
          "pgjdbc/src/main/java/org/postgresql/ds/PGPoolingDataSource.java",
          "pgjdbc/src/main/java/org/postgresql/ds/common/BaseDataSource.java"
        ]
      },
      {
        "name": "SSL/TLS 与国密 TLCP 安全连接",
        "description": "支持 SSL/TLS 加密连接（多种模式：disable/require/verify-ca/verify-full）、国密 TLCP 协议、证书验证、主机名校验",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/ssl/MakeSSL.java",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQFactory.java",
          "pgjdbc/src/main/java/org/postgresql/ssl/LibPQTlcpFactory.java",
          "pgjdbc/src/main/java/org/postgresql/ssl/PGjdbcHostnameVerifier.java"
        ]
      },
      {
        "name": "GSS/Kerberos 与 SSPI 认证",
        "description": "支持 GSS-API/Kerberos 认证和 Windows SSPI 单点登录，通过 org.ietf.jgss 标准接口实现",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/gss/GssAction.java",
          "pgjdbc/src/main/java/org/postgresql/gss/MakeGSS.java",
          "pgjdbc/src/main/java/org/postgresql/gss/GSSCallbackHandler.java"
        ]
      },
      {
        "name": "读写分离与集群管理",
        "description": "支持主备读写分离（基于 ShardingSphere SQL 解析器）、集群心跳检测、快速自动负载均衡、多主机选择策略",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/readwritesplitting/ReadWriteSplittingPgConnection.java",
          "pgjdbc/src/main/java/org/postgresql/clusterhealthy/ClusterHeartBeat.java",
          "pgjdbc/src/main/java/org/postgresql/quickautobalance/Cluster.java"
        ]
      },
      {
        "name": "数据复制流",
        "description": "支持逻辑复制与物理复制流协议，用于数据库变更数据捕获（CDC）场景",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/core/v3/replication/V3PGReplicationStream.java",
          "pgjdbc/src/main/java/org/postgresql/core/v3/replication/V3ReplicationProtocol.java"
        ]
      },
      {
        "name": "客户端数据加密（Client Logic）",
        "description": "通过 JNI 调用原生库 gauss_cl_jni，实现客户端数据加密/解密预处理，保护敏感字段",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogicImpl.java",
          "pgjdbc/src/main/java/org/postgresql/jdbc/ClientLogic.java"
        ]
      },
      {
        "name": "大对象与 COPY 协议",
        "description": "支持 PostgreSQL 大对象操作（LargeObject API）和 COPY 批量数据导入导出协议",
        "evidence": [
          "pgjdbc/src/main/java/org/postgresql/largeobject/LargeObjectManager.java",
          "pgjdbc/src/main/java/org/postgresql/copy/CopyManager.java"
        ]
      }
    ],
    "domain": "数据库连接/数据访问",
    "target_users": "使用 Java 语言开发、需要连接 openGauss 或 PostgreSQL 数据库的应用开发者与中间件开发者"
  },
