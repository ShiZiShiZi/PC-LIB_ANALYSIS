  "function_summary": {
    "summary": "Fx 是 Uber 开源的 Go 语言依赖注入框架，用于构建模块化、可组合的 Go 应用程序。它通过反射自动解析构造函数的参数依赖，自动装配依赖图，消除全局变量和手动接线代码。支持构造函数注册（Provide）、启动/停止生命周期钩子（Lifecycle Hook）、模块分组（Module）、装饰器替换（Decorate/Replace）、命名实例与值组等高级 DI 特性，是 Uber 内部几乎所有 Go 服务的基石。",
    "categories": [
      {
        "name": "依赖注入容器",
        "description": "基于反射自动解析构造函数参数类型、自动装配依赖图，支持 Provide 注册构造函数、Invoke 注入调用、Supply 直接注入值、Populate 填充结构体。底层委托 go.uber.org/dig 实现反射容器。",
        "evidence": [
          "app.go:422 New()",
          "provide.go:64 Provide()",
          "module.go:173 provideAll()",
          "inout.go:33 dig.In"
        ]
      },
      {
        "name": "生命周期管理",
        "description": "提供 OnStart/OnStop 生命周期钩子，支持启动/停止超时控制、优雅关闭。应用通过 Run() 阻塞等待 OS 信号后自动停止，或通过 Shutdowner 手动触发关闭。",
        "evidence": [
          "app.go:596 Run()",
          "app.go:660 Start()",
          "app.go:716 Stop()",
          "lifecycle.go:45 Hook"
        ]
      },
      {
        "name": "模块化组织",
        "description": "支持 Module 将多个 Option 组合为命名模块，作用域隔离 Private 构造函数的可见性，便于构建可复用的功能包。",
        "evidence": [
          "module.go:78 Module()",
          "module.go:120 module"
        ]
      },
      {
        "name": "装饰器与替换",
        "description": "支持 Decorate 修改已注册类型、Replace 完全替换现有类型，用于中间件模式或测试时 mock 依赖。",
        "evidence": [
          "decorate.go:64 Decorate()",
          "replace.go:64 Replace()"
        ]
      },
      {
        "name": "值组与注解",
        "description": "支持 group 标签将同类型多值注入到 slice，支持 name 标签区分同类型不同命名的实例，支持 fx.In/fx.Out 参数/结果结构体、Optional 可选依赖等高级 DI 模式。",
        "evidence": [
          "annotated.go",
          "inout.go",
          "doc.go:198 值组"
        ]
      },
      {
        "name": "应用日志事件系统",
        "description": "Fx 内部事件（构造函数执行、生命周期事件等）通过 fxevent.Logger 接口发出，支持自定义日志后端（如 zap），默认输出到 stderr。",
        "evidence": [
          "app.go:204 WithLogger()",
          "fxevent/",
          "log.go"
        ]
      }
    ],
    "domain": "依赖注入 / 应用框架",
    "target_users": "Go 应用开发者、微服务架构师",
    "ecosystem": "go"
  },
