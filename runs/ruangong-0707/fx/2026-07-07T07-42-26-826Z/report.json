  "function_summary": {
    "summary": "Fx 是 Uber 开源的 Go 语言依赖注入（DI）框架，用于构建基于可组合模块的应用程序。它通过自动解析构造函数依赖关系消除全局状态，支持参数/结果结构体、命名值、值组、可选依赖、装饰器和生命周期钩子等高级功能，是 Uber 几乎所有 Go 服务的骨干框架。",
    "categories": [
      {
        "name": "依赖注入容器",
        "description": "基于 go.uber.org/dig 实现的运行时依赖注入，自动解析构造函数参数类型图，管理单例生命周期，支持 Provide/Invoke/Decorate 等核心操作",
        "evidence": [
          "app.go",
          "provide.go",
          "invoke.go",
          "decorate.go"
        ]
      },
      {
        "name": "应用生命周期管理",
        "description": "提供 OnStart/OnStop 钩子机制，有序启动和优雅关闭应用组件，支持超时控制和信号监听（SIGINT/SIGTERM）",
        "evidence": [
          "lifecycle.go",
          "signal.go",
          "shutdown.go",
          "internal/lifecycle/lifecycle.go"
        ]
      },
      {
        "name": "模块化组合",
        "description": "通过 fx.Module 将功能打包为可复用、可作用域化的逻辑单元，支持 Private 可见性控制和模块级 Decorate/Replace",
        "evidence": [
          "module.go",
          "provide.go:99-112"
        ]
      },
      {
        "name": "注解与元数据",
        "description": "fx.Annotate 提供对构造函数的标签注解（命名/分组/可选），fx.Annotated 为简化版；支持结果组扁平化和软值组",
        "evidence": [
          "annotated.go"
        ]
      },
      {
        "name": "事件与日志",
        "description": "通过 fxevent 包定义结构化事件（OnStartExecuted/Provided/Invoked 等），支持 Console/Zap/Slog 多种日志后端",
        "evidence": [
          "fxevent/event.go",
          "fxevent/console.go",
          "fxevent/zap.go",
          "fxevent/slog.go"
        ]
      },
      {
        "name": "测试辅助",
        "description": "fxtest 包提供测试用 App 封装和 Lifecycle 模拟，帮助编写 Fx 应用的端到端测试",
        "evidence": [
          "fxtest/app.go",
          "fxtest/lifecycle.go"
        ]
      }
    ],
    "domain": "应用框架 / 依赖注入",
    "target_users": "Go 后端开发者，特别是构建微服务和模块化应用的团队"
  },
