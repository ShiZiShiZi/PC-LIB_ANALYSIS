  "function_summary": {
    "summary": "MySQL Connector/J 是 MySQL 官方的 JDBC Type 4 驱动，纯 Java 实现 MySQL 客户端/服务端协议，不依赖 MySQL C 客户端库。它同时实现了 JDBC 4.2 规范和 MySQL X DevAPI，前者为传统 SQL 关系型访问提供标准 java.sql.Connection/Statement/ResultSet 接口，后者通过 Protobuf 编码的 X Protocol 支持以 NoSQL 文档存储方式操作 MySQL（CRUD、Collection、Schema 管理）。主要功能包括：TCP/IP 与命名管道连接管理、SSL/TLS 加密通信、多种认证插件、连接池与负载均衡、语句拦截器与查询重写、OpenTelemetry 遥测集成、DNS SRV 服务发现等。",
    "categories": [
      {
        "name": "JDBC 驱动核心",
        "description": "实现 java.sql.Driver 接口，提供标准 JDBC Connection、Statement、ResultSet，支持 JDBC 4.2 规范",
        "evidence": [
          "src/main/user-impl/java/com/mysql/cj/jdbc/Driver.java:40 implements java.sql.Driver",
          "src/main/user-impl/java/com/mysql/cj/jdbc/ConnectionImpl.java"
        ]
      },
      {
        "name": "X DevAPI 文档存储",
        "description": "实现 MySQL X DevAPI，通过 X Protocol（Protobuf 编码）与 MySQL X Plugin 通信，支持 Schema/Collection/Table 的 CRUD NoSQL 操作",
        "evidence": [
          "src/main/user-api/java/com/mysql/cj/xdevapi/Session.java",
          "src/main/user-impl/java/com/mysql/cj/xdevapi/SessionImpl.java"
        ]
      },
      {
        "name": "网络通信与协议",
        "description": "实现 MySQL 原生协议和 X Protocol 的编解码，TCP/IP Socket 连接、SSL/TLS 握手、命名管道、SOCKS 代理、DNS SRV",
        "evidence": [
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/NativeProtocol.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/x/XProtocol.java"
        ]
      },
      {
        "name": "认证与安全",
        "description": "支持多种 MySQL 认证插件：原生密码、SHA-256、Kerberos、LDAP SASL、OCI IAM、OpenID Connect、WebAuthn；SSL/TLS 配置",
        "evidence": [
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/authentication/AuthenticationKerberosClient.java",
          "src/main/core-impl/java/com/mysql/cj/protocol/ExportControlled.java"
        ]
      },
      {
        "name": "高可用与负载均衡",
        "description": "提供 Failover、Replication、LoadBalanced 三种多主机连接策略，支持可插拔负载均衡算法",
        "evidence": [
          "src/main/user-impl/java/com/mysql/cj/jdbc/ha/FailoverConnectionProxy.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/ha/LoadBalancedConnectionProxy.java"
        ]
      },
      {
        "name": "遥测与监控",
        "description": "集成 OpenTelemetry 原生插桩用于分布式追踪；JMX 管理 Bean 支持；多日志框架",
        "evidence": [
          "src/main/core-impl/java/com/mysql/cj/otel/OpenTelemetryHandler.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/jmx/"
        ]
      }
    ],
    "domain": "数据库连接驱动",
    "target_users": "使用 Java 应用访问 MySQL 数据库的开发者"
  },
