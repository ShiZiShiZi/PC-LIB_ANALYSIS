  "function_summary": {
    "summary": "MySQL Connector/J 是 MySQL 官方提供的 Java 数据库连接驱动（JDBC Type 4 驱动），纯 Java 实现 MySQL 客户端/服务器通信协议，不依赖任何本地库。同时实现 JDBC 4.2 规范与 MySQL X DevAPI，支持对 MySQL 数据库的传统 SQL 操作与 NoSQL 文档存储（Document Store）CRUD 操作。主要面向 Java 应用开发者，通过 Maven Central 分发。",
    "categories": [
      {
        "name": "JDBC 驱动核心",
        "description": "完整实现 JDBC 4.2 规范：Driver、Connection、Statement、PreparedStatement、ResultSet 等接口；提供连接管理、连接池集成（c3p0）、高可用（负载均衡/主从复制）、SSL/TLS 加密通信。",
        "evidence": [
          "src/main/user-api/java/com/mysql/cj/jdbc/JdbcConnection.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/ConnectionImpl.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/ha/"
        ]
      },
      {
        "name": "MySQL 协议实现",
        "description": "纯 Java 实现 MySQL 原生客户端/服务器有线协议，包括握手认证、SQL 文本协议与预处理语句二进制协议。支持多种认证插件：mysql_native_password、caching_sha2_password、SHA-256、Kerberos、LDAP SASL、OpenID Connect、OCI IAM、WebAuthn/FIDO。",
        "evidence": [
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/NativeProtocol.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/authentication/"
        ]
      },
      {
        "name": "X DevAPI / X Protocol",
        "description": "实现 MySQL X DevAPI，支持将 MySQL 作为文档存储（Document Store）进行 CRUD 操作。通过 X Protocol 通信（基于 Google Protocol Buffers 序列化），提供 Collection、Schema、CRUD 语句等 NoSQL 风格编程接口。",
        "evidence": [
          "src/main/user-api/java/com/mysql/cj/xdevapi/",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/x/"
        ]
      },
      {
        "name": "安全与加密",
        "description": "支持 TLS/SSL 加密通信（基于 javax.net.ssl）；SCRAM-SHA 认证；密码哈希（SHA-1、SHA-256、SHA-512）；KeyStore 管理与 X.509 证书验证。",
        "evidence": [
          "src/main/core-impl/java/com/mysql/cj/protocol/ExportControlled.java",
          "src/main/core-impl/java/com/mysql/cj/sasl/"
        ]
      },
      {
        "name": "可观测性与诊断",
        "description": "支持 OpenTelemetry 分布式追踪集成；通过 SLF4J 标准日志接口输出运行日志；JMX 管理 Bean 暴露线程与连接统计信息。",
        "evidence": [
          "src/main/core-impl/java/com/mysql/cj/otel/",
          "src/main/core-impl/java/com/mysql/cj/log/",
          "src/main/user-impl/java/com/mysql/cj/jdbc/jmx/"
        ]
      }
    ],
    "domain": "数据库驱动",
    "target_users": "Java 应用开发者",
    "ecosystem": "java"
  },
