  "function_summary": {
    "summary": "MySQL Connector/J 是 Oracle 官方提供的 MySQL 数据库 Java 连接驱动。它是一个纯 Java 实现的 JDBC Type 4 驱动，符合 JDBC 4.2 规范，无需 MySQL 客户端库即可通过 TCP/IP 直连 MySQL 服务器。此外还实现了 MySQL X DevAPI，支持将 MySQL 作为文档存储进行 CRUD 风格的无 SQL 操作。面向 Java 应用开发者，提供连接管理、SQL 执行、预编译语句、存储过程调用、SSL/TLS 加密连接、多主机故障转移、连接池集成等企业级数据库连接功能。",
    "categories": [
      {
        "name": "JDBC 数据库连接与 SQL 执行",
        "description": "实现 JDBC 4.2 规范的全部接口，包括 Driver、Connection、Statement、PreparedStatement、CallableStatement、ResultSet 等，支持通过标准 JDBC URL 连接 MySQL 服务器并执行 SQL 查询/更新、事务管理、批处理、存储过程调用等完整数据库操作。",
        "evidence": [
          "src/main/user-impl/java/com/mysql/cj/jdbc/Driver.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/ConnectionImpl.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/StatementImpl.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/PreparedStatement.java",
          "src/main/user-impl/java/com/mysql/cj/jdbc/CallableStatement.java"
        ]
      },
      {
        "name": "MySQL 原生协议实现",
        "description": "实现 MySQL 客户端-服务器原生通信协议（Native Protocol），包括握手认证、数据包编码/解码、压缩传输、二进制结果集解析、服务器端预处理语句等底层协议细节。",
        "evidence": [
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/NativeProtocol.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/NativeSocketConnection.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/NativeMessageBuilder.java"
        ]
      },
      {
        "name": "多种认证机制支持",
        "description": "支持多种 MySQL 认证插件：mysql_native_password、caching_sha2_password、sha256_password、mysql_clear_password、LDAP SASL、Kerberos/GSSAPI、OCI AIM、OpenID Connect、WebAuthn (FIDO2) 等。",
        "evidence": [
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/authentication/MysqlNativePasswordPlugin.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/authentication/CachingSha2PasswordPlugin.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/authentication/AuthenticationKerberosClient.java",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/a/authentication/AuthenticationOciClient.java"
        ]
      },
      {
        "name": "SSL/TLS 加密传输",
        "description": "支持通过 javax.net.ssl 建立 TLS 加密连接，可配置 SSL 模式（DISABLED/PREFERRED/REQUIRED/VERIFY_CA/VERIFY_IDENTITY）、客户端/服务器证书验证、密钥库与信任库管理等。",
        "evidence": [
          "src/main/core-impl/java/com/mysql/cj/protocol/ExportControlled.java",
          "src/main/core-impl/java/com/mysql/cj/protocol/StandardSocketFactory.java"
        ]
      },
      {
        "name": "X DevAPI 文档存储与 CRUD 操作",
        "description": "实现 MySQL X DevAPI，通过 X Protocol（基于 protobuf 编码）支持对 MySQL 文档存储（Document Store）的 CRUD 操作、集合管理、表达式查询等 NoSQL 风格数据库操作。",
        "evidence": [
          "src/main/user-impl/java/com/mysql/cj/xdevapi/",
          "src/main/protocol-impl/java/com/mysql/cj/protocol/x/",
          "src/generated/java/com/mysql/cj/x/protobuf/"
        ]
      },
      {
        "name": "连接池与高可用",
        "description": "支持连接属性配置、多主机故障转移（Multi-Host）、负载均衡、复制感知路由等高级连接管理功能；可与 c3p0、HikariCP 等第三方连接池集成。",
        "evidence": [
          "src/main/user-impl/java/com/mysql/cj/jdbc/ha/",
          "src/main/core-impl/java/com/mysql/cj/conf/"
        ]
      }
    ],
    "domain": "数据库",
    "target_users": "Java 应用开发者",
    "ecosystem": "java"
  },
