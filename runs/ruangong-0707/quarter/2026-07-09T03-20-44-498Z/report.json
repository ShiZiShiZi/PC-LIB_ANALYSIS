  "function_summary": {
    "summary": "Quarter 是 Coin3D 项目下的轻量级 C++ 胶水库，将 Coin 高层 3D 可视化库与 Qt GUI 框架无缝集成。核心组件 QuarterWidget 继承 QGLWidget/QOpenGLWidget，在其内部渲染 Coin 场景图（Open Inventor 格式），并将 Qt 事件（鼠标、键盘、滚轮、拖放）翻译为 Coin 的 SoEvent 体系。库还提供 3Dconnexion SpaceNavigator 输入设备支持（通过 X11/spnav）、场景导航状态机（SCXML）、透明度/立体/渲染模式控制、右键上下文菜单以及 Qt Designer 插件。",
    "categories": [
      {
        "name": "3D 场景图渲染集成",
        "description": "通过 QuarterWidget 将 Coin 场景图渲染嵌入 Qt 窗口体系，管理 OpenGL 上下文、渲染管理器与事件管理器的生命周期",
        "evidence": [
          "include/Quarter/QuarterWidget.h",
          "src/Quarter/QuarterWidget.cpp"
        ]
      },
      {
        "name": "事件桥接与输入设备",
        "description": "将 Qt 鼠标/键盘/滚轮事件翻译为 Coin SoEvent，并支持 3Dconnexion SpaceNavigator 六自由度输入设备",
        "evidence": [
          "src/Quarter/EventFilter.cpp",
          "src/Quarter/Mouse.cpp",
          "src/Quarter/Keyboard.cpp",
          "src/Quarter/SpaceNavigatorDevice.cpp"
        ]
      },
      {
        "name": "场景导航与交互",
        "description": "基于 SCXML 状态机的场景导航（旋转/平移/缩放/寻点/交互模式切换），支持自定义导航文件与光标映射",
        "evidence": [
          "src/Quarter/InteractionMode.cpp",
          "src/Quarter/QuarterWidget.cpp:1023-1107"
        ]
      },
      {
        "name": "拖放文件加载",
        "description": "支持将 Inventor (.iv) 和 VRML (.wrl) 文件拖放到 QuarterWidget 中自动加载场景图",
        "evidence": [
          "src/Quarter/DragDropHandler.cpp"
        ]
      },
      {
        "name": "图像读取桥接",
        "description": "通过 QImage 将 Qt 的图像加载能力桥接到 Coin 的 SbImage 纹理系统",
        "evidence": [
          "src/Quarter/ImageReader.cpp"
        ]
      },
      {
        "name": "Qt Designer 插件",
        "description": "提供 Qt Designer 自定义控件插件，允许在 Qt Designer 中直接使用 QuarterWidget",
        "evidence": [
          "src/plugins/QuarterWidgetPlugin.cpp"
        ]
      }
    ],
    "domain": "3D 图形 / GUI 集成",
    "target_users": "需要在 Qt 应用程序中嵌入 Coin3D/Open Inventor 3D 场景图渲染的开发者"
  },
