  "function_summary": {
    "summary": "Quarter 是一个 C++ 胶水库，将 Coin3D 高级 3D 可视化库与 Qt GUI 框架无缝集成。其核心组件 QuarterWidget 继承自 QGLWidget/QOpenGLWidget，提供 Coin 场景图的 OpenGL 渲染能力，并将 Qt 事件（鼠标、键盘、拖放、3DConnexion SpaceNavigator）翻译为 Coin 的 SoEvent 体系。该库面向需要在 Qt 应用中嵌入 3D 场景图渲染的开发者，特别适用于 CAD/工程可视化领域。",
    "categories": [
      {
        "name": "3D 场景图渲染组件",
        "description": "QuarterWidget 将 Coin3D 场景图渲染嵌入 Qt 窗口系统，管理 OpenGL 上下文初始化、场景图设置、相机/灯光控制、透明度/渲染/立体模式，以及 Coin 的 SoRenderManager/SoEventManager 生命周期",
        "evidence": [
          "include/Quarter/QuarterWidget.h",
          "src/Quarter/QuarterWidget.cpp",
          "src/Quarter/QuarterWidgetP.cpp"
        ]
      },
      {
        "name": "Qt-Coin 事件桥接",
        "description": "将 Qt 的 QEvent（鼠标、键盘、滚轮、拖放）翻译为 Coin3D 的 SoEvent（SoMouseButtonEvent、SoLocation2Event、SoKeyboardEvent 等），支持 SCXML 导航状态机驱动的交互模式",
        "evidence": [
          "src/Quarter/EventFilter.cpp",
          "src/Quarter/Mouse.cpp",
          "src/Quarter/Keyboard.cpp",
          "src/Quarter/DragDropHandler.cpp",
          "src/Quarter/FocusHandler.cpp"
        ]
      },
      {
        "name": "3DConnexion SpaceNavigator 设备支持",
        "description": "通过 spacenav 开源库在 X11 平台上接收 3DConnexion SpaceNavigator 六自由度输入设备的事件，翻译为 SoMotion3Event 和 SoSpaceballButtonEvent",
        "evidence": [
          "src/Quarter/SpaceNavigatorDevice.cpp",
          "src/Quarter/NativeEvent.cpp"
        ]
      },
      {
        "name": "Qt Designer 插件",
        "description": "提供 Qt Designer 可视化设计器插件，允许在 Qt Designer 中直接拖放使用 QuarterWidget",
        "evidence": [
          "src/plugins/QuarterWidgetPlugin.cpp",
          "src/plugins/QuarterWidgetPlugin.h"
        ]
      },
      {
        "name": "Coin 传感器定时器桥接",
        "description": "SensorManager 将 Coin3D 的传感器队列（定时器/延迟传感器）与 Qt 事件循环集成，使用 QTimer 和跨线程信号机制确保线程安全",
        "evidence": [
          "src/Quarter/SensorManager.cpp",
          "src/Quarter/SignalThread.cpp"
        ]
      },
      {
        "name": "图像读取桥接",
        "description": "ImageReader 利用 Qt 的 QImage 加载图像文件，转换为 Coin3D 的 SbImage 格式，扩展 Coin 的图像输入通道",
        "evidence": [
          "src/Quarter/ImageReader.cpp",
          "src/Quarter/QtCoinCompatibility.cpp"
        ]
      }
    ],
    "domain": "3D 图形可视化",
    "target_users": "需要在 Qt 应用中嵌入 Coin3D/Open Inventor 3D 场景图渲染的 CAD/工程可视化开发者"
  },
