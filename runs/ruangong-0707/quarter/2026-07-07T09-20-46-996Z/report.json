  "function_summary": {
    "summary": "Quarter 是 Systems in Motion Coin 3D 可视化库与 Qt GUI 框架之间的轻量胶水库。它通过 QuarterWidget（继承自 QGLWidget/QOpenGLWidget）把 Coin 的场景图渲染能力嵌入到 Qt 应用中，同时完成 Qt 事件（QEvent）到 Coin 事件（SoEvent）的转换，目标用户主要是开发桌面 3D 可视化应用的 C++ 开发者。",
    "categories": [
      {
        "name": "Qt 3D 渲染集成",
        "description": "提供 QuarterWidget 作为 Qt 与 OpenGL 的桥梁，在 Qt 窗口中渲染 Coin 场景图",
        "evidence": [
          "include/Quarter/QuarterWidget.h:71",
          "src/Quarter/QuarterWidget.cpp:127",
          "src/Quarter/QuarterWidget.cpp:683"
        ]
      },
      {
        "name": "场景图管理",
        "description": "设置/获取 Coin 场景图（SoNode）、相机（SoCamera）及渲染管理器（SoRenderManager）",
        "evidence": [
          "src/Quarter/QuarterWidget.cpp:492",
          "src/Quarter/QuarterWidget.cpp:545",
          "src/Quarter/QuarterWidget.cpp:590"
        ]
      },
      {
        "name": "事件转换与分发",
        "description": "将 Qt 鼠标、键盘等事件翻译为 Coin 事件并分发给 SoEventManager 处理",
        "evidence": [
          "include/Quarter/devices/Mouse.h",
          "include/Quarter/devices/Keyboard.h",
          "src/Quarter/EventFilter.cpp"
        ]
      },
      {
        "name": "交互导航",
        "description": "支持 SCXML 状态机驱动的查看器导航（examiner、seek、viewAll 等）",
        "evidence": [
          "src/Quarter/QuarterWidget.cpp:645",
          "src/Quarter/QuarterWidget.cpp:663",
          "include/Quarter/eventhandlers/EventFilter.h"
        ]
      },
      {
        "name": "渲染控制",
        "description": "控制背景色、透明度类型、渲染模式、立体模式、自动重绘与设备像素比",
        "evidence": [
          "src/Quarter/QuarterWidget.cpp:399",
          "src/Quarter/QuarterWidget.cpp:427",
          "src/Quarter/QuarterWidget.cpp:483"
        ]
      },
      {
        "name": "输入设备支持",
        "description": "封装鼠标、键盘及 SpaceNavigator 3D 输入设备，将硬件输入映射到 Coin 事件",
        "evidence": [
          "include/Quarter/devices/SpaceNavigatorDevice.h",
          "src/Quarter/SpaceNavigatorDevice.cpp:90",
          "src/Quarter/Mouse.cpp"
        ]
      },
      {
        "name": "Qt Designer 插件",
        "description": "提供 Qt Designer 自定义插件，可在表单设计器中放置 QuarterWidget",
        "evidence": [
          "src/plugins/QuarterWidgetPlugin.cpp",
          "CMakeLists.txt:68"
        ]
      }
    ],
