  "function_summary": {
    "summary": "Coin3D Quarter 是一个轻量级 C++ 粘合库，用于将 Systems in Motion 的 Coin 3D 场景图可视化库与 Qt 2D/3D GUI 框架无缝集成。核心类 QuarterWidget 继承自 QGLWidget/QOpenGLWidget，可在 Qt 应用中直接嵌入一个 3D 渲染窗口，负责 Coin 场景图的渲染、相机管理、事件转换（QEvent → SoEvent）以及导航状态机。库还附带 Qt Designer 插件，允许在 GUI 设计器中拖放 QuarterWidget。",
    "categories": [
      {
        "name": "Qt 3D 可视化控件",
        "description": "提供 QuarterWidget 作为 Qt 可嵌入 3D 渲染控件，基于 QGLWidget/QOpenGLWidget，管理 OpenGL 上下文、视图区、高 DPI 适配与自动重绘。",
        "evidence": [
          "include/Quarter/QuarterWidget.h:71",
          "src/Quarter/QuarterWidget.cpp:684-779"
        ]
      },
      {
        "name": "场景图管理",
        "description": "设置与维护 Coin 场景图（SoNode/SoSeparator），管理 SoRenderManager 与 SoEventManager，实现相机、灯光、渲染模式与透明度的调度。",
        "evidence": [
          "src/Quarter/QuarterWidget.cpp:492-531",
          "src/Quarter/QuarterWidget.cpp:546-630"
        ]
      },
      {
        "name": "事件转换与交互处理",
        "description": "将 Qt 输入事件（鼠标、键盘、拖拽等）转换为 Coin 的 SoEvent，并通过 EventFilter、DragDropHandler、FocusHandler、InteractionMode 实现交互语义。",
        "evidence": [
          "src/Quarter/EventFilter.cpp",
          "src/Quarter/DragDropHandler.cpp",
          "include/Quarter/devices/Mouse.h",
          "include/Quarter/devices/Keyboard.h"
        ]
      },
      {
        "name": "Qt Designer 插件",
        "description": "提供 QuarterWidgetPlugin，使 QuarterWidget 可在 Qt Designer 中可视化使用，并支持动态加载包含 QuarterWidget 的 UI 文件。",
        "evidence": [
          "src/plugins/QuarterWidgetPlugin.cpp",
          "src/plugins/QuarterWidgetPlugin.h"
        ]
      },
      {
        "name": "导航状态机",
        "description": "通过 Coin ScXML 状态机加载导航模式文件（如 examiner.xml），支持 ViewAll、Seek 等导航事件以及默认光标映射。",
        "evidence": [
          "src/Quarter/QuarterWidget.cpp:644-674",
          "src/Quarter/QuarterWidget.cpp:1022-1107"
        ]
      },
      {
        "name": "3Dconnexion SpaceNavigator 输入",
        "description": "可选集成 libspnav，通过 X11 窗口系统接收 3Dconnexion SpaceNavigator 的六自由度运动与按键事件。",
        "evidence": [
          "src/Quarter/SpaceNavigatorDevice.cpp:45-181",
          "CMakeLists.txt:100"
        ]
      }
    ],
    "domain": "3D 图形可视化与 GUI 集成",
    "target_users": "需要在 Qt 桌面应用中嵌入 Coin 3D 场景图渲染能力的 C++ 开发者",
    "ecosystem": "cpp"
  },
