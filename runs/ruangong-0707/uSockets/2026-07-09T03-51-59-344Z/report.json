  "function_summary": {
    "summary": "uSockets 是 C 语言编写的非阻塞网络传输基础库，采用线程-每核（thread-per-CPU）架构，为上层 uWebSockets 提供统一 API 的底层网络抽象。支持 TCP、TLS（OpenSSL/BoringSSL/WolfSSL）、QUIC/HTTP3（lsquic）多种传输协议，可选用 epoll、kqueue、libuv、io_uring、GCD（libdispatch）、Boost.ASIO 等多种事件循环后端，无需修改上层代码即可跨平台运行。",
    "categories": [
      {
        "name": "事件驱动网络 I/O",
        "description": "提供非阻塞的 TCP 服务端/客户端、Unix domain socket、UDP socket 创建与管理，基于 BSD socket API 封装 connect/listen/accept/send/recv 操作，支持 TCP_NODELAY、SO_REUSEPORT 等 socket 选项",
        "evidence": [
          "src/socket.c",
          "src/bsd.c:468-540",
          "src/loop.c:225-395",
          "src/context.c"
        ]
      },
      {
        "name": "可插拔事件循环",
        "description": "支持多种底层事件循环后端：Linux epoll/timerfd/eventfd、macOS/FreeBSD kqueue、Windows libuv、Linux io_uring、macOS GCD（libdispatch）、Boost.ASIO，编译时按平台与配置自动选择，运行时通过 poll 抽象统一接口",
        "evidence": [
          "src/eventing/epoll_kqueue.c",
          "src/eventing/libuv.c",
          "src/eventing/gcd.c",
          "src/eventing/asio.cpp",
          "src/io_uring/",
          "src/libusockets.h:343-351"
        ]
      },
      {
        "name": "TLS/SSL 加密传输",
        "description": "可选集成 OpenSSL、BoringSSL 或 WolfSSL 提供 TLS 加密的 socket 传输，支持 SNI（Server Name Indication）多证书路由、证书/密码/CA 配置，兼容 OpenSSL BIO 与 SSL_CTX 接口",
        "evidence": [
          "src/crypto/openssl.c",
          "src/crypto/sni_tree.cpp",
          "src/libusockets.h:130-138"
        ]
      },
      {
        "name": "QUIC/HTTP3 传输（实验性）",
        "description": "通过集成 lsquic 库提供 QUIC 协议支持，可用于 HTTP3 通信；基于 UDP socket 封装，提供与 TCP 一致的流式 API（stream open/data/close/writable 回调）",
        "evidence": [
          "src/quic.h",
          "src/quic.c",
          "src/udp.c"
        ]
      },
      {
        "name": "定时器与超时管理",
        "description": "提供低精度高性能的 socket 超时（秒级）与长超时（分钟级）机制，基于 sweep 算法（O(1) 分摊遍历），支持独立定时器（epoll timerfd / kqueue EVFILT_TIMER）",
        "evidence": [
          "src/libusockets.h:112-127",
          "src/loop.c:84-138",
          "src/eventing/epoll_kqueue.c:289-370"
        ]
      },
      {
        "name": "UDP 多包收发",
        "description": "提供高效的 UDP socket 封装，内部使用 Linux sendmmsg/recvmmsg 批量收发（macOS/Windows 降级为 sendto/recvfrom 循环），支持 ECN 标记、本地 IP 获取（IP_PKTINFO/IPV6_PKTINFO）",
        "evidence": [
          "src/udp.c",
          "src/bsd.c:56-135",
          "src/bsd.c:141-174"
        ]
      }
    ],
    "domain": "网络传输／事件驱动 I/O",
    "target_users": "需要高性能非阻塞网络传输的 C/C++ 应用与库开发者（如 uWebSockets 等上层协议库）"
  },
