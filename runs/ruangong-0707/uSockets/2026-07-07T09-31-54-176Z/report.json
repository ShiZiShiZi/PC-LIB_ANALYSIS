  "function_summary": {
    "summary": "uSockets 是 uWebSockets 项目使用的基础网络库，提供跨平台、非阻塞、线程 per CPU 的 TCP、TLS、QUIC 与 HTTP/3 传输能力。它以统一的事件回调 API 屏蔽底层差异，支持 epoll、kqueue、libuv、asio、GCD 与 io_uring 等多种事件后端，目标用户是构建高性能 Web/WebSocket 服务器或网络中间件的 C/C++ 开发者。",
    "categories": [
      {
        "name": "TCP Socket 服务",
        "description": "提供非阻塞 TCP 监听、连接、收发、关闭与地址解析的统一 API，封装在 BSD socket 抽象层之上",
        "evidence": [
          "src/libusockets.h:189-207",
          "src/bsd.c:468-520",
          "src/context.c:1-200"
        ]
      },
      {
        "name": "TLS/SSL 加密传输",
        "description": "通过 OpenSSL、BoringSSL 或 WolfSSL 提供 SSL/TLS 握手、SNI、证书加载与加密读写",
        "evidence": [
          "src/crypto/openssl.c:1-50",
          "src/crypto/sni_tree.cpp:1-30",
          "Makefile:8-28"
        ]
      },
      {
        "name": "QUIC/HTTP3 传输",
        "description": "实验性 QUIC 与 HTTP/3 支持，基于 lsquic 引擎与 UDP socket 实现流式传输",
        "evidence": [
          "src/quic.h:1-67",
          "src/quic.c:1-100",
          "Makefile:61-67"
        ]
      },
      {
        "name": "多事件循环后端",
        "description": "支持 epoll/kqueue、libuv、Boost.Asio、Grand Central Dispatch 与 io_uring 作为事件驱动后端",
        "evidence": [
          "src/eventing/epoll_kqueue.c:1-50",
