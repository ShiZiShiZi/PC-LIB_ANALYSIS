          "src/io_uring/io_loop.c:1-30"
        ]
      },
      {
        "name": "UDP 与定时器",
        "description": "提供 UDP socket 批量收发（sendmmsg/recvmmsg）及高精度/低精度定时器，用于超时控制与心跳",
        "evidence": [
          "src/udp.c:1-100",
          "src/bsd.c:55-136",
          "src/loop.c:85-138"
        ]
      }
    ],
