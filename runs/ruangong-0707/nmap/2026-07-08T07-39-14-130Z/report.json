  "function_summary": {
    "summary": "nmap 是一个 Go 语言库，为 nmap 网络扫描器提供类型安全的、符合 Go 习惯的 API 封装。它通过 os/exec 启动系统上的 nmap 二进制文件，将用户传入的扫描选项转换为命令行参数，并解析 nmap 输出的 XML 结果，返回结构化的主机、端口、服务、操作系统等信息。主要面向编写安全审计、渗透测试和网络扫描工具的 Go 开发者。",
    "categories": [
      {
        "name": "扫描器构建与执行",
        "description": "创建 Scanner、配置扫描选项、通过子进程运行 nmap 并等待完成。",
        "evidence": [
          "nmap.go",
          "helpers.go:29-38",
          "scan_sync.go",
          "scan_async.go"
        ]
      },
      {
        "name": "XML 输出解析",
        "description": "使用 encoding/xml 解析 nmap -oX 输出的 XML，映射到 Run、Host、Port、Service 等结构体。",
        "evidence": [
          "xml.go",
          "helpers.go:98-151",
          "scan_progress.go:streamTaskProgress"
        ]
      },
      {
        "name": "扫描选项参数化",
        "description": "通过 Option 函数为 nmap 提供类型化的参数设置，如目标、端口、扫描类型、防火墙绕过、输出等。",
        "evidence": [
          "opt_target.go",
          "opt_ports.go",
          "opt_scan.go",
          "opt_firewall.go",
          "opt_output.go",
          "opt_misc.go"
        ]
      },
      {
        "name": "网络接口与路由信息",
        "description": "调用 nmap --iflist 获取本地接口、IP、MAC、路由表等网络配置。",
        "evidence": [
          "iflist.go"
        ]
      },
      {
        "name": "进度与错误处理",
        "description": "支持流式读取 stdout 并按 <taskprogress> 元素回调进度；将 nmap 退出码和 stderr 映射为库错误。",
        "evidence": [
          "scan_progress.go",
          "errors.go",
          "helpers.go:154-207"
        ]
      }
    ],
    "domain": "网络安全 / 网络扫描",
    "target_users": "使用 Go 编写安全审计、渗透测试和网络扫描工具的开发人员"
  },
