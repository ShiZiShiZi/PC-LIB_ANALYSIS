  "function_summary": {
    "summary": "本库是 nmap 的 Go 语言封装层，面向安全审计与网络扫描类工具的开发人员。它不提供原始包收发能力，而是将 nmap 命令行参数转化为类型安全的 Option 函数，启动外部 nmap 进程后解析其 XML 输出，返回结构化的主机、端口、服务、操作系统等信息。",
    "categories": [
      {
        "name": "命令行参数构造",
        "description": "提供大量 Option 函数（WithTargets、WithPorts、WithSYNScan 等），把 nmap 的命令行参数映射为类型安全的 Go API，避免用户直接拼接字符串。",
        "evidence": [
          "opt_scan.go:WithSYNScan",
          "opt_host.go:WithPingScan",
          "opt_misc.go:WithIPv6Scanning"
        ]
      },
      {
        "name": "外部进程调用与结果解析",
        "description": "通过 os/exec 启动 nmap 二进制，支持同步执行、异步流式执行以及带进度回调的执行模式；解析 nmap 返回的 XML 为结构化的 Run/Host/Port/Service/OS 等数据类型。",
        "evidence": [
          "nmap.go:NewScanner",
          "helpers.go:newCmd",
          "scan_sync.go:runAndParse",
          "scan_async.go:runAsync",
          "xml.go:parse"
        ]
      },
      {
        "name": "扫描结果数据模型",
        "description": "定义了 nmap XML 输出对应的 Go 结构体，包括主机状态、端口状态、服务指纹、操作系统指纹、 traceroute、任务进度等，并提供 OSFamily 枚举用于操作系统归类。",
        "evidence": [
          "xml.go:Run",
          "xml.go:Host",
          "xml.go:Port",
          "xml.go:OS",
          "pkg/osfamilies/os_families.go"
        ]
      },
      {
        "name": "交互式终端检测",
        "description": "使用 go-isatty 检测标准输入是否为 TTY，以决定是否启用交互式行为；进度回调功能依赖终端转义序列。",
        "evidence": [
          "nmap.go:54",
          "scan_progress.go:runAndParseWithProgress"
        ]
      },
      {
        "name": "网络接口列表解析",
        "description": "封装 nmap --iflist 选项，执行 nmap 后解析其文本输出，得到本地网络接口与路由信息。",
        "evidence": [
          "iflist.go:InterfaceList",
          "iflist.go:parseInterfaces"
        ]
      }
    ],
    "domain": "networking",
    "target_users": "使用 Go 编写网络安全扫描、资产发现、渗透测试工具的开发者"
  },
