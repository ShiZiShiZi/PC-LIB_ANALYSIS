  "function_summary": {
    "summary": "本库为 Go 语言网络扫描库，提供对 nmap 命令行工具的编程式封装。通过 Go 的 exec 包调用系统安装的 nmap 二进制，将 nmap 的 XML 输出解析为结构化的 Go 类型，支持同步/异步扫描、进度回调、结果过滤等功能。适用于 Go 开发者编写渗透测试工具、安全审计工具或自动化网络资产探测。",
    "categories": [
      {
        "name": "nmap 扫描封装",
        "description": "将 nmap 命令行参数映射为类型安全的 Go Option 函数，支持 TCP SYN/Connect/ACK/Window 等扫描技术、主机发现、端口范围、操作系统检测、服务探测、脚本引擎、性能模板等完整 nmap 参数集",
        "evidence": [
          "nmap.go:52-73",
          "opt_scan.go:11-50",
          "opt_timing.go:29-34",
          "opt_ports.go",
          "opt_host.go",
          "opt_os.go",
          "opt_script.go"
        ]
      },
      {
        "name": "XML 结果解析",
        "description": "将 nmap XML 输出反序列化为强类型的 Go 结构体，涵盖主机状态、端口、服务指纹、操作系统匹配、距离/路由追踪、脚本输出、时间统计等完整扫描信息",
        "evidence": [
          "xml.go:14-40",
          "xml.go:100-121",
          "xml.go:174-182",
          "xml.go:272-296",
          "xml.go:434-445"
        ]
      },
      {
        "name": "同步/异步执行",
        "description": "支持同步阻塞扫描和异步扫描（Go channel 流式输出 stdout/stderr/结果），并支持 TTY 环境下的进度回调（实时百分比与剩余时间）",
        "evidence": [
          "scan_sync.go:9-17",
          "scan_async.go:11-82",
          "scan_progress.go:12-41",
          "nmap.go:88-103"
        ]
      },
      {
        "name": "结果过滤与实用功能",
        "description": "提供端口/主机过滤器、网络接口列表解析（--iflist 输出格式化）、自定义二进制路径、XML 文件读写、JSON 序列化等辅助功能",
        "evidence": [
          "nmap.go:121-145",
          "nmap.go:174-189",
          "iflist.go:42-62",
          "xml.go:42-49",
          "xml.go:409-431"
        ]
      }
    ],
    "domain": "网络安全/网络探测",
    "target_users": "Go 语言安全工具开发者"
