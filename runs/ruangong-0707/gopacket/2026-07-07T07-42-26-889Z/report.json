  "function_summary": {
    "summary": "gopacket 是一个 Go 语言网络数据包解码库，提供对网络协议栈各层（以太网/IP/TCP/UDP/DNS 等 100+ 种协议）的分层解码与序列化能力。它同时封装了多种底层抓包后端（libpcap、Linux AF_PACKET、PF_RING、BSD BPF）以及纯 Go 实现的 pcap/pcapng 文件读写，并附带 TCP 流重组与 IP 分片重组功能。目标用户为网络安全工具、流量监控、协议分析器等开发者。",
    "categories": [
      {
        "name": "协议解码",
        "description": "对 100+ 种网络协议进行分层解码，涵盖 L2-L7 全协议栈（Ethernet/IP/TCP/UDP/DNS/DHCP/TLS/LLDP/ARP 等），支持懒解码与零拷贝优化",
        "evidence": [
          "layers/",
          "decode.go",
          "packet.go:NewPacket"
        ]
      },
      {
        "name": "抓包后端绑定",
        "description": "封装多种底层抓包接口：libpcap C 绑定（pcap 子包，Unix+Windows）、Linux AF_PACKET 原始套接字（afpacket 子包）、PF_RING（pfring 子包）、BSD BPF（bsdbpf 子包）",
        "evidence": [
          "pcap/pcap.go",
          "afpacket/afpacket.go",
          "pfring/pfring.go",
          "bsdbpf/bsd_bpf_sniffer.go"
        ]
      },
      {
        "name": "文件读写",
        "description": "纯 Go 实现的 pcap/pcapng/snoop 格式文件读写（pcapgo 子包），无需 libpcap 即可离线处理抓包文件",
        "evidence": [
          "pcapgo/read.go",
          "pcapgo/write.go",
          "pcapgo/ngread.go",
          "pcapgo/ngwrite.go"
        ]
      },
      {
        "name": "流重组与分片重组",
        "description": "TCP 流重组（tcpassembly/reassembly）与 IPv4 分片重组（ip4defrag），支持双向流拼接与乱序处理",
        "evidence": [
          "tcpassembly/assembly.go",
          "reassembly/tcpassembly.go",
          "ip4defrag/defrag.go"
        ]
      },
      {
        "name": "路由表查询",
        "description": "通过 Linux netlink 获取内核路由表，实现 IPv4/IPv6 路由查询（routing 子包，仅 Linux）",
        "evidence": [
          "routing/routing.go",
          "routing/common.go"
        ]
      },
      {
        "name": "数据包构造与序列化",
        "description": "支持从零构造数据包并序列化为字节流（SerializeLayers/SerializeBuffer），可用于发包工具",
        "evidence": [
          "packet.go",
          "writer.go"
        ]
      }
    ],
    "domain": "网络/协议分析",
    "target_users": "网络安全工具开发者、流量监控系统开发者、协议分析器开发者"
  },
