  "function_summary": {
    "summary": "Rod 是一个基于 Chrome DevTools Protocol（CDP）的高阶 Go 浏览器自动化库，主要面向网页自动化、端到端测试和网页抓取。它既提供高阶链式 API（Browser/Page/Element），也保留低阶 cdp/proto 包供开发者定制。库核心通过 WebSocket 与浏览器通信，封装了页面、元素、输入、网络劫持、请求等待、下载等能力，并可自动发现或下载 Chromium/Chrome 二进制。",
    "categories": [
      {
        "name": "浏览器生命周期管理",
        "description": "启动、连接、关闭浏览器实例；自动发现本地 Chrome、按平台下载 Chromium 压缩包，并管理浏览器进程与 user-data 目录。",
        "evidence": [
          "lib/launcher/launcher.go",
          "lib/launcher/browser.go",
          "browser.go"
        ]
      },
      {
        "name": "CDP 通信与协议封装",
        "description": "通过自研 WebSocket 客户端与浏览器建立 DevTools Protocol 连接，实现请求/响应/事件的双向通信，并生成所有 CDP 域的 Go 结构体。",
        "evidence": [
          "lib/cdp/websocket.go",
          "lib/cdp/client.go",
          "lib/proto"
        ]
      },
      {
        "name": "页面与元素操作",
        "description": "提供 Page、Element、Query 等高阶 API，支持导航、截图、点击、输入、等待、表单填充、iframe/shadow DOM 穿透等常见自动化操作。",
        "evidence": [
          "page.go",
          "element.go",
          "query.go",
          "input.go"
        ]
      },
      {
        "name": "网络劫持与请求处理",
        "description": "拦截、修改、路由或 mock 浏览器发出的 HTTP 请求，支持 WaitRequestIdle、HijackRequests 等高级等待机制。",
        "evidence": [
          "hijack.go",
          "page.go"
        ]
      },
      {
        "name": "设备模拟与输入事件",
        "description": "内置常见设备列表与视口/UA 模拟；模拟键盘、鼠标输入并处理 macOS/Windows 编辑命令差异。",
        "evidence": [
          "lib/devices",
          "lib/input",
          "input.go"
        ]
      }
    ],
    "domain": "browser automation / web scraping",
    "target_users": "Go 语言开发者、QA 测试工程师、爬虫与自动化脚本作者，以及需要可编程控制浏览器场景的其他库"
  },
