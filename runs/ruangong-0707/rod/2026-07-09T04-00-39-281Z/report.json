  "function_summary": {
    "summary": "Rod 是一个基于 Chrome DevTools Protocol 的 Go 语言浏览器自动化驱动库。它可直接操控 Chromium/Chrome 浏览器，实现页面导航、元素定位与交互、JavaScript 执行、截图与 PDF 生成、网络请求拦截等高级自动化能力。面向需要 Web 自动化测试、网页抓取、端到端测试的 Go 开发者，提供链式 API 与自动等待机制，兼顾高层便捷与底层可控。",
    "categories": [
      {
        "name": "浏览器生命周期管理",
        "description": "启动/连接 Chromium 浏览器（支持本地自动下载、远程连接、容器内启动），管理浏览器实例、隐身模式、页面标签页的创建与销毁。",
        "evidence": [
          "browser.go:Browser.Connect/Close/Page",
          "lib/launcher/launcher.go:Launch",
          "lib/launcher/browser.go:Browser.Get"
        ]
      },
      {
        "name": "页面导航与控制",
        "description": "页面 URL 导航、前进/后退、刷新、激活、窗口大小定位设置、页面生命周期事件等待（load/network idle/DOM stable）。",
        "evidence": [
          "page.go:Page.Navigate/NavigateBack/Reload/WaitLoad/WaitStable",
          "page.go:Page.SetWindow/SetViewport"
        ]
      },
      {
        "name": "DOM 元素选择与交互",
        "description": "通过 CSS 选择器/XPath/文本查找页面元素，支持点击、输入、悬停、选择、文件上传、滚动、触摸等交互操作，自动等待元素可见可交互。",
        "evidence": [
          "element.go:Element.Click/Input/Select/Hover/Tap",
          "query.go:Page.Element/Elements/Search",
          "input.go:Page.InsertText/KeyActions"
        ]
      },
      {
        "name": "JavaScript 执行与页面注入",
        "description": "在页面上下文中执行任意 JavaScript 代码，注入脚本/样式标签，在新文档加载前注入脚本，支持 Promise 等待与超时控制。",
        "evidence": [
          "page_eval.go:Page.Evaluate/Eval",
          "page.go:Page.AddScriptTag/AddStyleTag/EvalOnNewDocument"
        ]
      },
      {
        "name": "网络拦截与请求操控",
        "description": "拦截/修改/伪造 HTTP 请求与响应，设置请求头、Cookies、用户代理、代理服务器，阻止 URL 模式，处理文件下载与认证对话框。",
        "evidence": [
          "hijack.go:HijackRouter",
          "browser.go:Browser.SetCookies/GetCookies/IgnoreCertErrors",
          "page.go:Page.SetExtraHeaders/HandleDialog"
        ]
      },
      {
        "name": "截图与 PDF 输出",
        "description": "页面/元素/滚动区域截图（支持 JPEG/PNG），打印为 PDF，Canvas 导出为图片，支持全页面滚动拼接截图。",
        "evidence": [
          "page.go:Page.Screenshot/ScrollScreenshot/PDF",
          "element.go:Element.Screenshot/CanvasToImage"
        ]
      },
      {
        "name": "事件监听与自动化辅助",
        "description": "基于 observable 模式的事件系统，支持等待浏览器/页面/网络/DOM 事件；自动追踪输入操作（Trace 模式），慢动作调试，远程监控面板。",
        "evidence": [
          "browser.go:Browser.EachEvent/WaitEvent",
          "page.go:Page.WaitRequestIdle/WaitDOMStable",
          "dev_helpers.go:ExposeHelpers"
        ]
      }
    ],
    "domain": "web 自动化/web 抓取",
    "target_users": "需要自动化控制浏览器进行 Web 测试、数据抓取、端到端验证的 Go 后端/全栈开发者",
    "ecosystem": "go"
  },
