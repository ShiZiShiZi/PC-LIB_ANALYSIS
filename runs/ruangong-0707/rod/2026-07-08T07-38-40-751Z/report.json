  "function_summary": {
    "summary": "Rod 是一个基于 Chrome DevTools Protocol 的高层 Go 语言浏览器自动化库，用于网页自动化、爬虫、UI 测试与端到端测试。它为开发者提供链式 API 来启动/连接浏览器、操控页面与元素、模拟输入、拦截网络请求、执行 JavaScript 以及下载管理；高级用户可以深入低层包自定义行为。",
    "categories": [
      {
        "name": "浏览器生命周期管理",
        "description": "创建浏览器控制器、连接本地或远程 Chromium、启动/关闭浏览器、管理 incognito 上下文与页面池。",
        "evidence": [
          "browser.go:New",
          "browser.go:Connect",
          "browser.go:Incognito",
          "utils.go:NewBrowserPool"
        ]
      },
      {
        "name": "页面导航与状态",
        "description": "打开页面、跳转 URL、管理 Cookie/Header/UserAgent、窗口状态、截图、PDF、弹窗与下载等页面级操作。",
        "evidence": [
          "page.go:Page",
          "page.go:Cookies",
          "page.go:SetUserAgent",
          "page.go:PDF"
        ]
      },
      {
        "name": "DOM 元素交互",
        "description": "定位元素、点击、输入、悬停、滚动、等待可见/可交互、处理 iframe/shadow DOM。",
        "evidence": [
          "element.go:Click",
          "element.go:Type",
          "element.go:WaitInteractable",
          "query.go:Element"
        ]
      },
      {
        "name": "网络请求拦截与修改",
        "description": "通过 CDP Fetch 域拦截、修改或 mock 页面发起的 HTTP 请求与响应。",
        "evidence": [
          "hijack.go:HijackRequests",
          "hijack.go:LoadResponse",
          "hijack.go:ContinueRequest"
        ]
      },
      {
        "name": "JavaScript 执行与页面内辅助",
        "description": "在页面上下文中执行 JS、传递参数、绑定回调、注入 helper。",
        "evidence": [
          "page_eval.go:Eval",
          "page_eval.go:Evaluate",
          "page_eval.go:Expose"
        ]
      },
      {
        "name": "输入模拟",
        "description": "模拟键盘按键、鼠标点击/移动、触摸手势等人机交互事件。",
        "evidence": [
          "input.go:Mouse.Click",
          "input.go:Keyboard.Press",
          "input.go:Touch.Tap"
        ]
      }
    ],
    "domain": "web automation / browser control",
    "target_users": "Go 开发者、爬虫工程师、QA 与端到端测试人员"
  },
