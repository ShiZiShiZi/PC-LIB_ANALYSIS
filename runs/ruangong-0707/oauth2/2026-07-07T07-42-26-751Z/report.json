  "function_summary": {
    "summary": "golang.org/x/oauth2 是 Go 官方扩展库，实现了 OAuth 2.0 规范（RFC 6749）的客户端功能，包括授权码流程、客户端凭证流程、设备授权流程（RFC 8628）、PKCE（RFC 7636）以及 JWT Bearer 授权。同时提供 Google Cloud 专属的 Application Default Credentials（ADC）机制、外部账户/工作负载身份联合认证、JWT 签名（JWS）编解码，以及 30+ 主流 OAuth 服务商的预配置端点常量。目标用户为需要接入 OAuth 2.0 认证的 Go 后端服务与 CLI 工具开发者。",
    "categories": [
      {
        "name": "OAuth 2.0 核心协议实现",
        "description": "实现 OAuth 2.0 三-legged 授权码流程、密码凭证流程、令牌刷新与自动续期、设备授权流程（RFC 8628）、PKCE（RFC 7636），以及可插拔的 TokenSource 接口",
        "evidence": [
          "oauth2.go",
          "token.go",
          "transport.go",
          "deviceauth.go",
          "pkce.go"
        ]
      },
      {
        "name": "客户端凭证流程",
        "description": "实现 OAuth 2.0 两-legged 客户端凭证授权（RFC 6749 §4.4），用于服务间调用场景",
        "evidence": [
          "clientcredentials/clientcredentials.go"
        ]
      },
      {
        "name": "JWT 与 JWS 签名",
        "description": "提供 JWT Bearer 授权流程（两-legged OAuth 2.0）及 JWS 编解码/签名/验证能力",
        "evidence": [
          "jwt/jwt.go",
          "jws/jws.go"
        ]
      },
      {
        "name": "Google Cloud 认证集成",
        "description": "实现 Google Application Default Credentials（ADC）自动发现、GCE 元数据服务令牌获取、服务账户/用户凭证/外部账户/工作负载身份联合/模拟服务账户等多种凭证类型的解析与令牌获取，以及 Google Cloud SDK 凭证读取",
        "evidence": [
          "google/google.go",
          "google/default.go",
          "google/sdk.go",
          "google/appengine.go",
          "google/externalaccount/basecredentials.go"
        ]
      },
      {
        "name": "多服务商端点配置",
        "description": "预定义 30+ 主流 OAuth 服务商（Google、GitHub、GitLab、Microsoft、Facebook、Amazon、LinkedIn、Slack、Spotify 等）的授权与令牌端点常量，以及 Azure AD、AWS Cognito 等参数化端点生成函数",
        "evidence": [
          "endpoints/endpoints.go",
          "github/github.go",
          "gitlab/gitlab.go",
          "microsoft/microsoft.go",
          "facebook/facebook.go"
        ]
      },
      {
        "name": "三方 OAuth 辅助流程",
        "description": "提供 JIRA/Confluence JWT 授权、HipChat 服务端端点、Google 令牌降级（downscoping）及外部账户可执行凭证源等特定场景支持",
        "evidence": [
          "jira/jira.go",
          "hipchat/hipchat.go",
          "google/downscope/downscoping.go",
          "google/externalaccount/executablecredsource.go"
        ]
      }
    ],
    "domain": "认证与授权",
    "target_users": "Go 后端服务与 CLI 工具开发者，尤其是需要接入 OAuth 2.0 认证或 Google Cloud API 的开发者"
  },
