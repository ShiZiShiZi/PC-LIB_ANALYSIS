  "native_api": {
    "summary": "纯 Go 标准库 API，跨平台零原生调用。主要使用 Go 标准库的 net/http（HTTP 客户端/服务端）、net/url（URL 编码）、crypto/*（RSA/SHA256/rand 用于 JWT 签名与 PKCE）、encoding/*（JSON/Base64/PEM 编解码）。无 Win32、POSIX 特定调用；无 syscall、ioctl、/proc、/sys 访问；无 cgo 或动态库加载。仅两个 runtime.GOOS 平台分支存在于 google/ 子包（Windows vs Unix 路径拼接）。",
    "groups": [
      {
        "type": "go_stdlib_net",
        "category": "standard",
        "platform": "portable",
        "apis": [
          {
            "name": "net/http.Client.Do",
            "purpose": "发送 OAuth2 令牌请求和受保护资源请求",
