  "function_summary": {
    "summary": "golang.org/x/oauth2 是 Go 语言官方的 OAuth 2.0 客户端库，由 Go 团队维护。实现 RFC 6749 定义的授权码（Authorization Code）、客户端凭据（Client Credentials）、资源所有者密码（Resource Owner Password）、设备授权（Device Authorization，RFC 8628）等完整 OAuth2 流程，支持 PKCE（RFC 7636）、JWT Bearer 断言、令牌自动刷新与 HTTP Transport 注入。内置 30+ 第三方服务（Google、GitHub、Facebook、Amazon 等）的 OAuth2 端点常量，其中 Google 子包额外提供服务账号 JWT 认证、GCE 元数据默认凭据、外部账户/工作负载身份联合、ADC（Application Default Credentials）等 Google Cloud 平台认证能力。",
    "categories": [
      {
        "name": "OAuth2 授权流程",
        "description": "实现 OAuth 2.0 RFC 6749 标准客户端：授权码流程（AuthCodeURL + Exchange）、客户端凭据流程（clientcredentials 子包）、密码凭据流程（PasswordCredentialsToken）、令牌刷新（TokenSource 自动续期）、HTTP Transport 注入（自动添加 Authorization 头）",
        "evidence": [
          "oauth2.go:37-260 (Config/TokenSource/Exchange/AuthCodeURL)",
          "clientcredentials/clientcredentials.go:29-80",
          "transport.go:14-75",
          "token.go:31-67 (Token 结构与解析)"
        ]
      },
      {
        "name": "设备授权流程",
        "description": "实现 RFC 8628 设备授权流程（Device Authorization Grant），用于无浏览器/输入受限设备通过另一设备完成授权：DeviceAuth 发起请求、DeviceAccessToken 轮询令牌获取",
        "evidence": [
          "deviceauth.go:26-227"
        ]
      },
      {
        "name": "PKCE 安全扩展",
        "description": "实现 RFC 7636 PKCE（Proof Key for Code Exchange），S256 挑战方式，生成随机 Verifier 并派生 Challenge，防止授权码拦截攻击",
        "evidence": [
          "pkce.go:20-69"
        ]
      },
      {
        "name": "JWT 令牌认证",
        "description": "JWT Bearer 断言流程（RFC 7523），使用 RSA 私钥签名 JWT 从授权服务器换取访问令牌，用于服务账号等服务端场景",
        "evidence": [
          "jwt/jwt.go:31-180",
          "jws/jws.go"
        ]
      },
      {
        "name": "多提供商端点",
        "description": "内置 30+ 常见 OAuth2 提供商的授权与令牌端点常量（Amazon、Apple、Facebook、GitHub、GitLab、Google、Microsoft、Slack、Spotify、Yandex 等），开箱即用",
        "evidence": [
          "endpoints/endpoints.go (465 行，含 60+ 端点)",
          "google/google.go:25-33",
          "github/github.go",
          "facebook/facebook.go",
          "microsoft/microsoft.go"
        ]
      },
      {
        "name": "Google Cloud 平台认证",
        "description": "Google 子包提供 Google 平台专用认证：服务账号 JWT 凭据加载、GCE 元数据服务器凭据、Application Default Credentials (ADC) 自动发现、外部账户工作负载身份联合（AWS/Azure/OIDC）、模拟服务账号、GDCH 服务账号、App Engine 环境支持",
        "evidence": [
          "google/google.go:44-309",
          "google/default.go:193-284",
          "google/externalaccount/*.go (外部账户联合)",
          "google/appengine.go",
          "google/jwt.go",
          "google/sdk.go"
        ]
      }
    ],
    "domain": "认证与授权 / 网络安全协议",
    "target_users": "Go 语言后端与 CLI 工具开发者，需要集成 OAuth2 第三方登录或访问 Google Cloud/其他 OAuth2 保护资源的应用"
  },
