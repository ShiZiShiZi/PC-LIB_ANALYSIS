  "function_summary": {
    "summary": "golang.org/x/oauth2 是 Go 语言官方维护的 OAuth 2.0 客户端库，实现 RFC 6749 的授权码流、客户端凭证流、密码凭证流、令牌刷新，以及 RFC 8628 设备授权流和 RFC 7636 PKCE 安全扩展。同时提供 JWT (JSON Web Token) 和 JWS (JSON Web Signature) 支持用于服务账户认证，并内置 Google Cloud Platform、GitHub、GitLab、Facebook、Microsoft、Slack 等数十个 OAuth 服务商的端点常量。",
    "categories": [
      {
        "name": "OAuth 2.0 核心授权流程",
        "description": "实现 RFC 6749 标准的三步授权码流（AuthCodeURL → Exchange → Client）、两步客户端凭证流、密码凭证流、令牌刷新等完整流程，并提供可扩展的 TokenSource 接口与自动刷新 HTTP Transport",
        "evidence": [
          "oauth2.go (Config.AuthCodeURL, Config.Exchange, Config.PasswordCredentialsToken, NewClient)",
          "token.go (Token, retrieveToken, reuseTokenSource)",
          "transport.go (Transport.RoundTrip)"
        ]
      },
      {
        "name": "OAuth 设备授权流",
        "description": "实现 RFC 8628 Device Authorization Grant，支持无浏览器/IoT 设备场景的授权流程——用户在本设备获取验证码后在另一设备上完成授权",
        "evidence": [
          "deviceauth.go (Config.DeviceAuth, Config.DeviceAccessToken)"
        ]
      },
      {
        "name": "PKCE 安全扩展",
        "description": "实现 RFC 7636 Proof Key for Code Exchange，提供 S256 方式的 code_challenge/verifier 生成与校验，防止授权码拦截攻击",
        "evidence": [
          "pkce.go (GenerateVerifier, S256ChallengeOption, VerifierOption)"
        ]
      },
      {
        "name": "JWT / JWS 服务账户认证",
        "description": "实现 OAuth 2.0 JWT Bearer Token 流程——使用 RSA 私钥签名 JWT 断言换取 access token，常用于 Google Cloud 等平台的服务账户认证",
        "evidence": [
          "jwt/jwt.go (Config, JWTConfigFromJSON)",
          "jws/jws.go (ClaimSet, Header, Encode)",
          "internal/oauth2.go (ParseKey)"
        ]
      },
      {
        "name": "OAuth 服务商端点常量",
        "description": "内置 50+ 个 OAuth 服务商的授权/令牌端点常量，涵盖 Google、GitHub、GitLab、Facebook、Microsoft、Slack、Spotify、Amazon、LinkedIn 等主流平台",
        "evidence": [
          "endpoints/endpoints.go (Amazon, Apple, Bitbucket, Facebook, GitHub, GitLab, Google, LinkedIn, Microsoft, Slack, Spotify 等 50+ Endpoint 变量)"
        ]
      },
      {
        "name": "Google Cloud 平台集成",
        "description": "针对 Google Cloud 的深度集成——支持从客户端密钥 JSON 文件/ADC 凭据创建 OAuth2 Config、JWT Config，以及 Workload Identity Federation / External Account / Impersonation 等企业级凭据源",
        "evidence": [
          "google/google.go (ConfigFromJSON, FindDefaultCredentials)",
          "google/appengine.go",
          "google/idtoken.go",
          "google/externalaccount/",
          "google/internal/"
        ]
      }
    ],
    "domain": "身份认证与授权",
    "target_users": "需要集成 OAuth 2.0 第三方登录或调用 OAuth 保护 API 的 Go 应用开发者"
  },
