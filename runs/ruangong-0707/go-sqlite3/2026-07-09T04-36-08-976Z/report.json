  "function_summary": {
    "summary": "go-sqlite3 是 Go 语言中广泛使用的 SQLite3 数据库驱动，通过 CGO 内嵌 SQLite3 C 语言合并版(amalgamation)实现零外部依赖的完整 SQLite3 支持，符合 Go 标准库 database/sql 接口规范。支持多平台编译（Windows/Linux/macOS/OpenBSD/Solaris），可通过 Go build tags 按需启用 FTS5/ICU/JSON/数学函数/用户认证等数十种 SQLite 扩展特性，也支持链接系统已安装的 libsqlite3 库。",
    "categories": [
      {
        "name": "数据库连接与会话管理",
        "description": "实现 database/sql 驱动接口，支持连接池、DSN 连接字符串配置（缓存模式、WAL 模式、外键、超时等 20+ 选项）、多连接并发读写控制",
        "evidence": [
          "sqlite3.go (SQLiteDriver.Open)",
          "sqlite3_opt_foreign_keys.go",
          "sqlite3_opt_secure_delete.go"
        ]
      },
      {
        "name": "SQL 执行与类型转换",
        "description": "提供 SQL 查询/执行、预编译语句、参数绑定、结果集扫描与 Go 原生类型互转（int/float/string/[]byte/time.Time/bool），支持 column type introspection",
        "evidence": [
          "sqlite3.go (_sqlite3_exec, _sqlite3_bind_*)",
          "convert.go (convertAssign)",
          "sqlite3_type.go (ColumnTypeDatabaseTypeName)"
        ]
      },
      {
        "name": "SQLite 扩展特性",
        "description": "通过 build tags 按需启用 20+ SQLite 编译选项：全文搜索 (FTS3/FTS5)、JSON 函数、数学函数、ICU 国际化、统计分析 (STAT4)、用户认证、虚拟表 (VTABLE)、DBSTAT 虚拟表、预更新钩子、序列化/反序列化、安全删除等",
        "evidence": [
          "sqlite3_opt_fts5.go",
          "sqlite3_opt_icu.go",
          "sqlite3_opt_json.go",
          "sqlite3_opt_math_functions.go",
          "sqlite3_opt_stat4.go",
          "sqlite3_opt_vtable.go",
          "sqlite3_opt_userauth.go",
          "sqlite3_opt_serialize.go"
        ]
      },
      {
        "name": "Go 侧扩展注册",
        "description": "支持将 Go 函数注册为 SQLite 自定义 SQL 函数或聚合函数（标量/聚合），以及注册自定义排序比较函数，需通过 build tag 保护编译",
        "evidence": [
          "callback.go (callbackTrampoline, stepTrampoline, doneTrampoline)",
          "sqlite3_context.go (SQLiteContext.Result*)"
        ]
      },
      {
        "name": "数据库备份与恢复",
        "description": "封装 SQLite3 Online Backup API，支持在线热备份/恢复数据库",
        "evidence": [
          "backup.go (SQLiteBackup, Backup)"
        ],
        "conditions": []
      },
      {
        "name": "扩展加载与外部 libsqlite3 链接",
        "description": "支持运行时加载 SQLite C 扩展 (.so/.dll)，也可通过 libsqlite3 build tag 链接系统预装的 libsqlite3 动态库",
        "evidence": [
          "sqlite3_load_extension.go",
          "sqlite3_libsqlite3.go"
        ]
      },
      {
        "name": "调试与跟踪",
        "description": "提供 SQL 语句跟踪/性能分析回调 (sqlite3_trace_v2)、语句缓存与 OS trace 调试日志",
        "evidence": [
          "sqlite3_trace.go",
          "sqlite3_opt_os_trace.go"
        ]
      }
