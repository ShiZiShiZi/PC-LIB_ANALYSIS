  "function_summary": {
    "summary": "sqlite-jdbc 是一个 Java 语言的 SQLite 嵌入式数据库 JDBC 驱动程序，使用 JNI 封装 SQLite C 库。它将各主流操作系统（Windows、macOS、Linux、FreeBSD、Android 等）的预编译原生库打包进单个 JAR 文件中，开发者无需手动配置原生库路径或安装 SQLite，即可通过标准 JDBC API 读写本地 SQLite 数据库文件。支持 SQLite 丰富特性如用户自定义函数、聚合、排序规则、备份、加载扩展模块等。",
    "categories": [
      {
        "name": "JDBC 数据库驱动",
        "description": "实现 JDBC Driver/Connection/Statement/PreparedStatement/ResultSet 等完整接口，提供标准 SQL 查询、更新、事务、批量操作能力。",
        "evidence": [
          "src/main/java/org/sqlite/jdbc3/JDBC3Connection.java",
          "src/main/java/org/sqlite/core/CoreStatement.java",
          "src/main/java/org/sqlite/core/CoreResultSet.java"
        ]
      },
      {
        "name": "JNI 原生桥接",
        "description": "通过 JNI 直接调用 SQLite C API，提供 thin JNI layer，Java 侧通过 native 方法映射到 sqlite3_open/_close/_exec/_prepare 等底层 C 函数。",
        "evidence": [
          "src/main/java/org/sqlite/core/NativeDB.java",
          "src/main/java/org/sqlite/core/NativeDB.c"
        ]
      },
      {
        "name": "原生库自动加载与多平台适配",
        "description": "自动检测当前 OS 和 CPU 架构，从 JAR 内提取对应预编译原生库（.dll/.dylib/.so）到临时目录并加载，支持 x86/arm/ppc/riscv 等众多架构。",
        "evidence": [
          "src/main/java/org/sqlite/SQLiteJDBCLoader.java",
          "src/main/java/org/sqlite/util/OSInfo.java",
          "src/main/java/org/sqlite/util/LibraryLoaderUtil.java"
        ]
      },
      {
        "name": "SQLite 扩展功能支持",
        "description": "支持 SQLite 高级特性：用户自定义函数（Scalar/Aggregate/Window）、自定义排序规则、加密备份、进度回调、忙回调、提交/更新监听等。",
        "evidence": [
          "src/main/java/org/sqlite/Function.java",
          "src/main/java/org/sqlite/Collation.java",
          "src/main/java/org/sqlite/core/NativeDB.java"
        ]
      },
      {
        "name": "GraalVM Native Image 集成",
        "description": "提供 GraalVM native-image 构建配置，支持将 sqlite-jdbc 编译为 Native Image 原生可执行文件，包含 JNI 反射注册和资源配置。",
        "evidence": [
          "src/main/resources/META-INF/native-image/",
          "pom.xml (native profile)"
        ]
      }
    ],
    "domain": "数据库",
    "target_users": "Java 应用程序开发者、需要嵌入式 SQLite 数据库的场景（桌面应用、移动端、服务端数据缓存）"
  },
