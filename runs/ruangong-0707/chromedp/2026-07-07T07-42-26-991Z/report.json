  "function_summary": {
    "summary": "chromedp 是一个用 Go 语言编写的 Chrome DevTools Protocol (CDP) 高级客户端库，无需任何第三方依赖即可在 Go 中完整实现 CDP 的异步通信。它通过 WebSocket 连接控制 Chrome/Chromium 浏览器，提供网页导航、DOM 查询与操作、JavaScript 执行、鼠标键盘模拟、截图、设备模拟、PDF 生成等高层 API，主要用于 Web 自动化测试、网页抓取、无头浏览器操作和性能分析等场景。该库支持本地启动浏览器进程（ExecAllocator）和远程连接已运行的浏览器（RemoteAllocator）两种模式。",
    "categories": [
      {
        "name": "浏览器进程管理",
        "description": "启动、连接和管理 Chrome 浏览器进程，包括本地进程启动（ExecAllocator）和远程 WebSocket 连接（RemoteAllocator），以及浏览器生命周期管理",
        "evidence": [
          "allocate.go",
          "browser.go",
          "chromedp.go:NewContext",
          "chromedp.go:NewExecAllocator",
          "chromedp.go:NewRemoteAllocator"
        ]
      },
      {
        "name": "DOM 查询与操作",
        "description": "通过 CSS 选择器、XPath、JS Path 等方式查询和操作浏览器 DOM 节点，包括元素等待、属性读写、文本获取、表单操作、滚动等",
        "evidence": [
          "query.go",
          "target.go:domEvent",
          "util.go:walk"
        ]
      },
      {
        "name": "JavaScript 执行",
        "description": "在浏览器上下文中执行 JavaScript 表达式和函数调用，支持值回传、DevTools 上下文执行和 Promise 等待",
        "evidence": [
          "eval.go",
          "call.go",
          "poll.go"
        ]
      },
      {
        "name": "用户输入模拟",
        "description": "模拟鼠标点击、移动、滚轮和键盘输入事件，用于自动化交互场景",
        "evidence": [
          "input.go",
          "kb/kb.go"
        ]
      },
      {
        "name": "页面导航与截图",
        "description": "页面导航、历史记录操作、视口截图和全页面截图功能，支持 PNG 和 JPEG 格式输出",
        "evidence": [
          "nav.go",
          "screenshot.go"
        ]
      },
      {
        "name": "设备模拟",
        "description": "模拟移动设备的视口、用户代理、触摸模式和屏幕方向，内置多种设备配置",
        "evidence": [
          "emulate.go",
          "device/device.go"
        ]
      },
      {
        "name": "PDF 生成",
        "description": "将网页内容导出为 PDF 文档",
        "evidence": [
          "query.go:PrintToPDF"
        ]
      }
    ],
    "domain": "浏览器自动化 / Web 测试",
    "target_users": "Go 开发者，需要做 Web 自动化测试、网页抓取、无头浏览器操作或 CI 中浏览器集成的工程师"
  },
