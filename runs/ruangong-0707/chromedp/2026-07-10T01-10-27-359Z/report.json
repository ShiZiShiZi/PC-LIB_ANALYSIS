  "function_summary": {
    "summary": "chromedp 是一个 Go 语言库，提供对 Chrome DevTools Protocol（CDP）的高层封装，无需第三方依赖即可驱动 Chrome/Chromium 浏览器。它支持启动/管理浏览器进程、建立 WebSocket 连接并通过 CDP 发送命令，实现网页抓取、自动化测试、性能分析和页面截图等常见浏览器自动化任务。面向 Go 开发者，适用于需要在无头/有头浏览器中执行网页操作的场景。",
    "categories": [
      {
        "name": "浏览器生命周期管理",
        "description": "启动、分配和管理 Chrome/Chromium 浏览器进程（ExecAllocator），或连接到远程已运行的浏览器实例（RemoteAllocator），支持用户数据目录、命令行参数和超时配置",
        "evidence": [
          "allocate.go",
          "allocate_linux.go",
          "allocate_other.go",
          "browser.go"
        ]
      },
      {
        "name": "页面与目标管理",
        "description": "管理浏览器 Tab/目标（target），包括创建/附加/关闭标签页、管理浏览器上下文（BrowserContext）和 iframe/框架树，支持 Worker 目标",
        "evidence": [
          "chromedp.go:122-221",
          "target.go",
          "browser.go:152-180"
        ]
      },
      {
        "name": "DOM 操作与元素交互",
        "description": "通过 CDP 的 DOM/Runtime 域进行节点查询、属性读取、点击、输入、表单提交等页面交互，支持 WaitVisible/WaitReady 等等待谓词",
        "evidence": [
          "query.go",
          "input.go",
          "nav.go",
          "eval.go",
          "chromedp.go:310-336"
        ]
      },
      {
        "name": "JavaScript 执行",
        "description": "在页面上下文中执行 JavaScript 代码并获取返回值，支持同步/异步求值、轮询等待和对象序列化",
        "evidence": [
          "eval.go",
          "poll.go",
          "js/"
        ]
      },
      {
        "name": "键盘与设备模拟",
        "description": "提供完整的 DOM 键码映射（Keyboard Layout）和设备模拟（Device Emulation），支持移动设备 User-Agent、视口大小和触摸事件的模拟",
        "evidence": [
          "kb/",
          "device/",
          "emulate.go"
        ]
      },
      {
        "name": "截图与页面捕获",
        "description": "支持全页或视口截图、元素截图，可指定图片格式和质量，以及像素级截图比较",
        "evidence": [
          "screenshot.go"
        ]
      },
      {
        "name": "网络响应监控",
        "description": "提供 RunResponse 方法，在执行页面导航操作时捕获 HTTP 响应信息（状态码、响应头），便于验证页面加载结果",
        "evidence": [
          "chromedp.go:558-564",
          "chromedp.go:566-702"
        ]
      }
    ],
    "domain": "浏览器自动化与网页测试",
    "target_users": "Go 语言开发者，需要进行网页抓取、端到端 Web 测试、浏览器性能分析和自动化操作的工程师"
  },
