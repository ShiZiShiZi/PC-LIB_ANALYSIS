  "function_summary": {
    "summary": "termbox-go 是一个用 Go 语言编写的跨平台终端文本界面库，提供最小化的 API 供程序员在文本终端上构建用户界面。在 *nix 系统上使用终端转义序列和 terminfo 实现，在 Windows 上使用 Win32 Console API 实现。库的核心抽象是终端屏幕的二维单元格数组，支持设置字符、前景/背景属性（含 256 色和 RGB 模式），以及处理键盘和鼠标事件。该项目已不太活跃维护，但仍被众多终端应用（编辑器、游戏、监控工具等）广泛使用。",
    "categories": [
      {
        "name": "终端屏幕渲染",
        "description": "提供二维单元格缓冲区模型，支持在终端屏幕上设置字符、前景色和背景色，包括标准 8 色、256 色、216 色和 RGB 输出模式",
        "evidence": [
          "api_common.go:Cell",
          "api_common.go:OutputMode",
          "api.go:SetCell",
          "api.go:Flush",
          "termbox.go:send_attr"
        ]
      },
      {
        "name": "终端输入事件处理",
        "description": "轮询终端的键盘和鼠标输入事件，支持 Esc/Alt 输入模式切换，处理终端转义序列解析和鼠标事件（X10/SGR/xterm 扩展模式）",
        "evidence": [
          "api.go:PollEvent",
          "api.go:SetInputMode",
          "termbox.go:extract_event",
          "termbox.go:parse_mouse_event"
        ]
      },
      {
        "name": "跨平台终端抽象",
        "description": "在 *nix 上通过 terminfo 数据库和 POSIX termios 控制终端，在 Windows 上通过 Win32 Console API 控制控制台，为上层提供统一的 Init/Close/Flush/Size 等接口",
        "evidence": [
          "api.go:Init(!windows)",
          "api_windows.go:Init(windows)",
          "termbox.go:tcgetattr/tcsetattr",
          "termbox_windows.go:kernel32"
        ]
      },
      {
        "name": "终端信息数据库",
        "description": "内置多款终端的 terminfo 数据（xterm/screen/rxvt/linux/Eterm），并支持从系统 terminfo 数据库加载；还包含一个 Python 辅助脚本用于收集 terminfo",
        "evidence": [
          "terminfo_builtin.go",
          "terminfo.go:load_terminfo",
          "collect_terminfo.py"
        ]
      }
    ],
    "domain": "终端用户界面 / TUI",
    "target_users": "需要在终端环境下构建文本界面的 Go 开发者，如终端编辑器、系统监控工具、终端游戏等应用的开发者"
  },
