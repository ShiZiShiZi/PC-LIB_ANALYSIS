  "function_summary": {
    "summary": "hnswlib 是一个 C++ 头文件库，实现了基于分层可导航小世界（Hierarchical Navigable Small World, HNSW）图的高性能近似最近邻搜索算法。支持 L2 平方距离、内积和余弦距离三种度量，具备多线程并行插入与搜索、增量索引构建、元素更新与删除等能力。通过 pybind11 提供 Python 绑定，可经 pip 安装。适用于推荐系统、向量检索、语义搜索等需要在大规模向量空间中快速查找近似最近邻的场景。",
    "categories": [
      {
        "name": "近似最近邻搜索",
        "description": "基于 HNSW 图的多层贪婪搜索算法，在亚线性时间复杂度内返回近似最近邻。支持 L2 平方距离、内积和余弦距离三种度量空间。",
        "evidence": [
          "hnswlib/hnswalg.h (HierarchicalNSW::searchKnn)",
          "hnswlib/space_l2.h",
          "hnswlib/space_ip.h"
        ]
      },
      {
        "name": "索引管理与持久化",
        "description": "支持增量构建索引、标记/取消标记删除元素、替换已删除元素以及调整索引容量。可通过二进制流将索引保存到文件并从文件加载恢复。",
        "evidence": [
          "hnswlib/hnswalg.h (addPoint/saveIndex/loadIndex/markDeletedDelete)",
          "hnswlib/bruteforce.h"
        ]
      },
      {
        "name": "多线程并行",
        "description": "支持多线程并行插入元素与并行批量查询，通过 std::thread 与互斥锁实现细粒度并发控制。Python 绑定中提供线程安全的 ParallelFor 并行调度。",
        "evidence": [
          "hnswlib/hnswalg.h (std::mutex/link_list_locks_)",
          "python_bindings/bindings.cpp (ParallelFor)"
        ]
      },
      {
        "name": "Python 绑定",
        "description": "通过 pybind11 将 C++ HNSW 索引封装为 Python 类，提供与 NumPy 数组集成的 ADD/查询/加载/保存接口，支持索引序列化（pickle）。",
        "evidence": [
          "python_bindings/bindings.cpp",
          "setup.py"
        ]
      }
    ],
    "domain": "向量检索与近似近邻搜索",
    "target_users": "推荐系统、信息检索、数据挖掘等领域的 C++ 与 Python 开发者和研究人员",
    "ecosystem": "cpp"
  },
