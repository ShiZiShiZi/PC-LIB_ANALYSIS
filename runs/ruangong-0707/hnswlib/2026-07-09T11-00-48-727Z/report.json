  "function_summary": {
    "summary": "hnswlib 是一个基于 HNSW（Hierarchical Navigable Small World）图算法的高效近似最近邻搜索（ANN）C++ 头文件库，同时提供 Python 绑定。它仅依赖 C++11 标准库，无需任何外部运行时依赖，支持余弦、L2 和内积三种距离度量，并支持增量索引构建、元素删除与替换、多线程插入/搜索、过滤搜索和多向量文档搜索等高级功能。适用于机器学习、推荐系统、向量检索等需要高性能向量相似度搜索的场景。",
    "categories": [
      {
        "name": "近似最近邻搜索（ANN）",
        "description": "基于 HNSW 多层图结构的快速近似最近邻搜索，支持构建、查询、序列化/反序列化索引。",
        "evidence": [
          "hnswlib/hnswalg.h:18 class HierarchicalNSW",
          "hnswlib/hnswalg.h:1269 searchKnn"
        ]
      },
      {
        "name": "距离度量",
        "description": "支持 L2 平方距离、内积距离和余弦距离三种度量，支持自定义距离函数（C++）。",
        "evidence": [
          "hnswlib/space_l2.h:7 L2Sqr",
          "hnswlib/space_ip.h:6 InnerProduct",
          "hnswlib/space_ip.h:17 InnerProductDistance"
        ]
      },
      {
        "name": "SIMD 加速",
        "description": "利用 x86 SSE/AVX/AVX-512 指令集对距离计算与预取进行向量化加速，同时保留标量回退路径以兼容无 SIMD 的架构。",
        "evidence": [
          "hnswlib/hnswlib.h:13 USE_SSE",
          "hnswlib/hnswlib.h:14 USE_AVX",
          "hnswlib/hnswlib.h:17 USE_AVX512",
          "hnswlib/space_l2.h:22-56 AVX512 实现"
        ]
      },
      {
        "name": "多线程支持",
        "description": "支持多线程并发插入和搜索，使用 std::mutex 和 std::atomic 实现线程安全。",
        "evidence": [
          "hnswlib/hnswalg.h:40 label_op_locks_",
          "hnswlib/hnswalg.h:42 global",
          "hnswlib/hnswalg.h:65 metric_distance_computations"
        ]
      },
      {
        "name": "Python 绑定",
        "description": "通过 pybind11 提供 Python 接口，支持 numpy 数组输入，索引可 pickle 序列化。",
        "evidence": [
          "python_bindings/bindings.cpp",
          "python_bindings/LazyIndex.py"
        ]
      },
      {
        "name": "索引持久化",
        "description": "索引可保存到磁盘并从磁盘加载，支持索引容量动态调整。",
        "evidence": [
          "hnswlib/hnswalg.h saveIndex",
          "hnswlib/hnswalg.h loadIndex"
        ]
      }
    ],
    "domain": "向量检索 / 机器学习",
    "target_users": "机器学习工程师、推荐系统开发者、向量数据库实现者",
