  "function_summary": {
    "summary": "IXWebSocket 是一个轻量级的 C++ 网络库，提供 WebSocket 客户端与服务端的完整实现（符合 RFC 6455，通过 Autobahn 合规测试），同时包含 HTTP 客户端与服务端功能。该库无 Boost 依赖，支持多种 TLS 后端（OpenSSL、MbedTLS、Apple SecureTransport、LibreSSL），内建 per-message deflate 压缩、自动重连、DNS 异步解析、gzip 编解码、UDP 套接字等能力，可运行于 macOS、iOS、Linux、Android、Windows 和 FreeBSD。",
    "categories": [
      {
        "name": "WebSocket 通信",
        "description": "符合 RFC 6455 的 WebSocket 客户端与服务端实现，支持文本/二进制消息收发、ping/pong 心跳、per-message deflate 压缩、子协议协商、自动重连与代理",
        "evidence": [
          "ixwebsocket/IXWebSocket.h",
          "ixwebsocket/IXWebSocketServer.h",
          "ixwebsocket/IXWebSocketTransport.h",
          "ixwebsocket/IXWebSocketPerMessageDeflate.h"
        ]
      },
      {
        "name": "HTTP 客户端与服务端",
        "description": "提供 HTTP 客户端（GET/POST/PUT/PATCH/DELETE，支持 multipart form-data 与重定向）及 HTTP 服务端，可独立于 WebSocket 使用",
        "evidence": [
          "ixwebsocket/IXHttpClient.h",
          "ixwebsocket/IXHttpServer.h",
          "ixwebsocket/IXHttp.h"
        ]
      },
      {
        "name": "TLS/SSL 安全传输",
        "description": "支持多种 TLS 后端：OpenSSL、MbedTLS、Apple SecureTransport、LibreSSL，可通过编译选项切换；支持证书验证、系统 CA 信任、内存 CA 加载",
        "evidence": [
          "ixwebsocket/IXSocketOpenSSL.h",
          "ixwebsocket/IXSocketMbedTLS.h",
          "ixwebsocket/IXSocketAppleSSL.h",
          "ixwebsocket/IXSocketTLSOptions.h"
        ]
      },
      {
        "name": "网络基础设施",
        "description": "封装跨平台网络系统初始化（Winsock/POSIX）、DNS 异步解析、TCP/UDP 套接字连接管理、select/poll 事件循环中断机制、线程命名",
        "evidence": [
          "ixwebsocket/IXNetSystem.h",
          "ixwebsocket/IXDNSLookup.h",
          "ixwebsocket/IXSocket.h",
          "ixwebsocket/IXUdpSocket.h",
          "ixwebsocket/IXSelectInterrupt.h"
        ]
      },
      {
        "name": "数据编解码工具",
        "description": "提供 Base64 编解码、gzip 压缩/解压（基于 zlib）、URL 解析、UTF-8 校验、UUID 生成等辅助功能",
        "evidence": [
          "ixwebsocket/IXBase64.h",
          "ixwebsocket/IXGzipCodec.h",
          "ixwebsocket/IXUrlParser.h",
          "ixwebsocket/IXUtf8Validator.h",
          "ixwebsocket/IXUuid.h"
        ]
      }
    ],
    "domain": "网络通信",
    "target_users": "需要在 C++ 应用中集成 WebSocket 或 HTTP 通信能力的开发者，尤其适合游戏、实时消息、IoT 等对轻量级依赖有需求的场景"
  },
