  "function_summary": {
    "summary": "FingerprintJS 是一个开源的客户端浏览器指纹识别库，运行在浏览器中，通过查询数十种浏览器属性（Canvas 渲染、WebGL 参数、音频信号处理、字体列表、屏幕参数、navigator 属性等）生成稳定的哈希化访客标识。该标识跨隐身模式/数据清除保持不变，可用于欺诈检测与用户去重。不依赖任何服务端，完全在浏览器端完成指纹计算。",
    "categories": [
      {
        "name": "浏览器指纹采集",
        "description": "通过 40+ 个熵源（Canvas 渲染差异、WebGL 参数/扩展、AudioContext 信号、字体枚举、屏幕帧测量、CSS 特征检测、navigator 属性、存储 API 探测、浏览器引擎识别等）并行采集浏览器/设备特征，对各浏览器都有精心适配的降级与反指纹容错逻辑",
        "evidence": [
          "src/sources/index.ts",
          "src/sources/canvas.ts",
          "src/sources/webgl.ts",
          "src/sources/audio.ts",
          "src/sources/fonts.ts",
          "src/sources/screen_frame.ts"
        ]
      },
      {
        "name": "访客标识哈希",
        "description": "将采集到的熵组件规整化后通过 MurmurHash3 x64 128 位哈希生成稳定的 visitorId，带惰性求值优化",
        "evidence": [
          "src/utils/hashing.ts",
          "src/agent.ts:104-106"
        ]
      },
      {
        "name": "浏览器引擎无 UA 检测",
        "description": "不使用 User-Agent 字符串，通过检测各引擎（Chromium/Gecko/WebKit/Trident/EdgeHTML）的专有属性、API 特性存在性组合来识别浏览器引擎与版本区间，支持 iPad 与 Android 设备判定",
        "evidence": [
          "src/utils/browser.ts"
        ]
      },
      {
        "name": "置信度评分",
        "description": "基于各熵源的稳定性与信息量对最终 fingerprint 提供 confidence 评分",
        "evidence": [
          "src/confidence.ts"
        ]
      }
    ],
    "domain": "web安全与反欺诈",
    "target_users": "Web 前端开发者",
    "ecosystem": "nodejs"
  },
