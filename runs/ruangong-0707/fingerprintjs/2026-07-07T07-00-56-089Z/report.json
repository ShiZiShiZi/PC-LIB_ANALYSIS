  "function_summary": {
    "summary": "FingerprintJS 是一个开源的客户端浏览器指纹库，用于在 Web 浏览器环境中采集 Canvas、WebGL、Web Audio、字体、插件、屏幕分辨率、时区等多种浏览器属性，并将这些属性哈希为一个稳定的访客标识（visitor ID）。它无服务器端处理，不依赖 Cookie/LocalStorage，主要用于 Web 应用开发者的设备识别、反欺诈、访客去重等场景。",
    "categories": [
      {
        "name": "浏览器指纹采集与 visitor ID 生成",
        "description": "提供 `load()` 工厂函数创建 Agent，并通过 `get()` 异步收集浏览器熵源，最终使用 x64 MurmurHash 生成 128 位 visitor ID。",
        "evidence": [
          "src/agent.ts:load:203",
          "src/agent.ts:hashComponents:104",
          "src/index.ts:export load:9"
        ]
      },
      {
        "name": "多源浏览器熵采集",
        "description": "内置约 30 个熵源，包括 Canvas 2D 渲染、WebGL 参数、OfflineAudioContext 音频、已安装字体、浏览器插件、DOM 内容拦截器、屏幕分辨率/帧、User-Agent Client Hints、时区、存储可用性等。",
        "evidence": [
          "src/sources/index.ts:53",
          "src/sources/canvas.ts:35",
          "src/sources/webgl.ts:76",
          "src/sources/audio.ts:41",
          "src/sources/fonts.ts:71"
        ]
      },
      {
        "name": "浏览器引擎与平台识别",
        "description": "通过检测全局对象与 API 存在性判断 Trident、EdgeHTML、Chromium、WebKit、Gecko、Android、iPad 等浏览器引擎和平台，用于对指纹结果做稳定性校正。",
        "evidence": [
          "src/utils/browser.ts:14",
          "src/utils/browser.ts:53",
          "src/utils/browser.ts:78",
          "src/utils/browser.ts:148"
        ]
      },
      {
        "name": "指纹置信度评估",
        "description": "根据浏览器平台、熵源稳定性等因素给出指纹可信度评分，帮助调用方判断当前 visitor ID 是否可靠。",
        "evidence": [
          "src/confidence.ts:20",
          "src/agent.ts:makeLazyGetResult:112"
        ]
      },
      {
        "name": "构建与分发",
        "description": "使用 Rollup 构建浏览器适用的 IIFE/UMD/CJS/ESM 产物，并通过 npm 与 CDN（jsDelivr / openfpcdn）分发。",
        "evidence": [
          "rollup.config.ts:40",
          "package.json:main:27",
          "package.json:files:31"
        ]
      }
    ],
    "domain": "browser fingerprinting / fraud detection",
    "target_users": "Web 应用开发者、反欺诈与设备识别系统"
  },
