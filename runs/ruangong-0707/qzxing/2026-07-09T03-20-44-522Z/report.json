  "function_summary": {
    "summary": "QZXing 是一个基于 Qt 框架的 ZXing 条码图像处理库的 C++/QML 封装，支持多种一维码（UPC-A/E、EAN-8/13、Code 39/93/128、ITF、Codabar）和二维码（QR Code、Data Matrix、Aztec、PDF 417）的解码，以及 QR Code 的编码。它提供 C++ API 和 QML 组件两种使用方式，可选集成 Qt Multimedia 实现实时摄像头扫码。核心功能为纯算法处理，通过 QImage 与图像数据交互。",
    "categories": [
      {
        "name": "条码/二维码解码",
        "description": "对静态图像或实时视频帧中的多种条码格式进行识别和解码，支持 1D（UPC-A/E、EAN-8/13、Code 39/93/128、ITF、Codabar、RSS）和 2D（QR Code、Data Matrix、Aztec、PDF 417）格式",
        "evidence": [
          "src/QZXing.cpp:415 (decodeImage)",
          "src/QZXing.h:74-94 (DecoderFormat enum)",
          "src/zxing/zxing/MultiFormatReader.cpp"
        ]
      },
      {
        "name": "QR Code 编码",
        "description": "将文本数据编码为 QR Code 图像，支持自定义尺寸、纠错等级（L/M/Q/H）和边框/透明度设置",
        "evidence": [
          "src/QZXing.cpp:651 (encodeData)",
          "src/QZXing.h:207-218 (encodeData declarations)",
          "src/zxing/zxing/qrcode/encoder/QREncoder.cpp"
        ]
      },
      {
        "name": "图像适配层",
        "description": "将 QImage 转换为 ZXing 内部的灰度亮度源（LuminanceSource），支持缩放、裁剪、旋转和反转等图像预处理",
        "evidence": [
          "src/CameraImageWrapper.cpp",
          "src/CameraImageWrapper.h",
          "src/ImageHandler.cpp"
        ]
      },
      {
        "name": "QML 集成与实时视频解码",
        "description": "提供 QML 类型注册和 Image Provider，以及基于 QAbstractVideoFilter/QVideoSink 的实时摄像头视频帧解码滤镜",
        "evidence": [
          "src/QZXingFilter.h",
          "src/QZXingFilterVideoSink.h",
          "src/QZXingImageProvider.cpp",
          "src/QZXing.cpp:100-119 (registerQMLTypes/registerQMLImageProvider)"
        ]
      }
    ],
    "domain": "图像处理/条码识别",
    "target_users": "需要在 Qt/QML 应用中集成条码扫描或 QR Code 生成功能的 C++ 开发者"
  },
