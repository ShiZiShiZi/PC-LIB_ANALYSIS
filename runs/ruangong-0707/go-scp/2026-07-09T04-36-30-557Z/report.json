  "function_summary": {
    "summary": "go-scp 是一个 Go 语言实现的 SCP（Secure Copy Protocol）客户端库。它基于 golang.org/x/crypto/ssh 建立安全 SSH 连接，通过 SCP 协议实现本地文件上传到远程服务器，以及从远程服务器下载文件到本地。支持密码、密钥、SSH Agent 等多种认证方式，并可通过现有 SSH 连接复用已有会话。适用于需要在 Go 应用中集成远程文件传输功能的开发者。",
    "categories": [
      {
        "name": "SCP 文件上传",
        "description": "通过 SCP 协议将本地文件或 io.Reader 内容上传到远程服务器，支持指定远程路径和文件权限，并提供 PassThru 回调以跟踪传输进度",
        "evidence": [
          "client.go:89-112 CopFromFile/CopyFromFilePassThru",
          "client.go:116-149 CopyFile/CopyFilePassThru",
          "client.go:182-302 Copy/CopyPassThru"
        ]
      },
      {
        "name": "SCP 文件下载",
        "description": "从远程服务器下载文件到本地 io.Writer，支持获取文件的权限、大小、修改时间等元信息",
        "evidence": [
          "client.go:307-334 CopFromRemote/CopyFromRemotePassThru/CopyFromRemoteFileInfos",
          "client.go:336-444 copyFromRemote"
        ]
      },
      {
        "name": "SSH 认证集成",
        "description": "提供多种 SSH 认证辅助工具：从本地文件加载私钥（含密码保护密钥）、连接 SSH Agent、使用用户名密码认证",
        "evidence": [
          "auth/key.go:18-38 PrivateKey",
          "auth/key.go:41-60 PrivateKeyWithPassphrase",
          "auth/key.go:63-78 SshAgent",
          "auth/key.go:81-89 PasswordKey"
        ]
      },
      {
        "name": "SCP 协议栈",
        "description": "实现 SCP 协议的消息解析与确认机制，支持 C（创建/权限/大小）、T（时间戳）等协议消息类型的解析与确认应答",
        "evidence": [
          "protocol.go:29-99 ParseResponse",
          "protocol.go:135-159 ParseFileInfos",
          "protocol.go:161-192 ParseFileTime",
          "protocol.go:196-206 Ack"
        ]
      }
    ],
    "domain": "网络通信 / 文件传输",
    "target_users": "Go 应用程序开发者，需要在应用中集成 SSH 远程文件传输功能"
  },
