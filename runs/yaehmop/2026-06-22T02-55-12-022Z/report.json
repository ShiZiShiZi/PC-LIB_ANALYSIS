  "function_summary": {
    "summary": "YAeHMOP 是一个基于扩展休克尔理论（EHT）的紧束缚计算程序包，由 Greg Landrum 在 Cornell 大学 Hoffmann 组期间开发。它包含 tightbind 命令行计算引擎与 viewkel 可视化工具，可处理分子、一维/二维/三维周期性体系，构建 Hamiltonian 与重叠矩阵、求解能带结构、生成态密度（DOS）与晶体轨道重叠布居（COOP/COHP），并提供 X11/Mac/TEK 多端可视化。",
    "categories": [
      {
        "name": "扩展休克尔紧束缚计算",
        "description": "读取原子坐标与参数，为分子和周期性体系构建扩展休克尔 Hamiltonian 与重叠矩阵。",
        "evidence": [
          "tightbind/R_hamil.c",
          "tightbind/R_overlap_mat.c",
          "tightbind/K_hamil.c",
          "tightbind/K_overlap_mat.c",
          "tightbind/mov.c"
        ]
      },
      {
        "name": "能带结构与 k 点采样",
        "description": "在倒空间生成 k 点网格或高对称路径，计算周期性体系的能带与布里渊区采样。",
        "evidence": [
          "tightbind/kpoints.c",
          "tightbind/bands.c",
          "tightbind/recip_space.c",
          "tightbind/driver.c:loop_over_k_points"
        ]
      },
      {
        "name": "态密度与晶体轨道重叠布居",
        "description": "计算总态密度、投影态密度（PDOS）以及 COOP/COHP，用于分析成键与反键特征。",
        "evidence": [
          "tightbind/DOS_stuff.c",
          "tightbind/COOP_stuff.c",
          "tightbind/postprocess.c"
        ]
      },
      {
        "name": "片段分子轨道分析",
        "description": "将体系拆分为片段，构建片段分子轨道（FMO）基下的 Hamiltonian、重叠矩阵与电荷矩阵。",
        "evidence": [
          "tightbind/FMO_stuff.c",
          "tightbind/prototypes.h:FMO_frag_type"
        ]
      },
      {
        "name": "对称性与 Walsh 图",
        "description": "检测点群/空间群对称操作，跟踪轨道对称性，并沿几何参数扫描生成 Walsh 图。",
        "evidence": [
          "tightbind/symmetry.c",
          "tightbind/solid_symmetry.c",
          "tightbind/walsh.c"
        ]
      },
      {
        "name": "电荷迭代与自洽参数优化",
        "description": "支持电荷迭代和 Muller 迭代方案，自洽调整 Slater 轨道指数与 Coulomb 积分。",
        "evidence": [
          "tightbind/chg_it.c",
          "tightbind/muller.c",
          "tightbind/zetas.c"
        ]
      },
      {
        "name": "结果可视化",
        "description": "viewkel 提供分子、能带、态密度、Walsh 图等交互式可视化，支持 X11、Mac 与 Tektronix 后端。",
        "evidence": [
          "viewkel/main.c",
          "viewkel/xstuff.c",
          "viewkel/graphics.c",
          "viewkel/interface.c"
        ]
      }
    ],
    "domain": "computational_chemistry",
    "target_users": "计算化学、材料科学与量子化学领域的研究人员及软件开发者"
  },
