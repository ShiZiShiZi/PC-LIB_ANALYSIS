    "one_liner": "测量 Unicode 字符串在终端中的显示宽度，支持控制序列、Emoji 和 Grapheme 聚类。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "wcwidth 是一个纯 Python 的终端文本宽度测量库，为 CLI/TUI 程序提供比 Python 内置字符串函数更准确的显示宽度计算。它实现了 POSIX wcwidth(3)/wcswidth(3) 的语义，并扩展支持 Unicode Grapheme 聚类、终端转义序列（SGR、光标移动、OSC 66 文本尺寸等）、Hyperlink 以及 Kitty 等终端的宽度修正表。",
    "categories": [
      {
        "name": "单字符与字符串宽度测量",
        "description": "提供 wcwidth()、wcswidth()、wcstwidth() 等核心函数，按 Unicode  East Asian Width 规则计算单个码点或字符串在终端占据的列数。",
        "evidence": [
          "wcwidth/_wcwidth.py:115",
          "wcwidth/_wcswidth.py:60",
          "wcwidth/_wcswidth.py:199"
        ]
      },
      {
        "name": "Grapheme 聚类分割",
        "description": "遵循 Unicode Standard Annex #29 实现 grapheme cluster 迭代器，用于正确处理组合字符、Emoji 序列、国旗和肤色修饰符。",
        "evidence": [
          "wcwidth/grapheme.py:79",
          "wcwidth/grapheme.py:306",
          "wcwidth/__init__.py:36"
        ]
      },
      {
        "name": "终端控制序列解析",
        "description": "解析 SGR、CSI、OSC、Hyperlink、光标移动等 ANSI/终端转义序列，使 width() 在含颜色、样式、光标控制字符的文本上仍能返回正确的显示宽度。",
        "evidence": [
          "wcwidth/escape_sequences.py:70",
          "wcwidth/sgr_state.py:292",
          "wcwidth/_width.py:73"
        ]
      },
      {
        "name": "文本裁剪与排版",
        "description": "提供 clip()、wrap()、ljust()/rjust()/center() 等工具，作为 Python 标准 textwrap 和 str 对齐函数的替代品，按显示宽度而非码点数量操作。",
        "evidence": [
          "wcwidth/_clip.py",
          "wcwidth/textwrap.py",
          "wcwidth/align.py"
        ]
      },
      {
        "name": "终端宽度修正表",
        "description": "内置大量终端程序（VTE、kitty、WezTerm、Windows Terminal 等）的宽度覆盖表，用于补偿不同终端对 Emoji、VS15/VS16、宽字符的差异化渲染。",
        "evidence": [
          "wcwidth/_constants.py:140",
          "wcwidth/table_overrides.py",
          "wcwidth/table_term_programs.py"
        ]
      }
    ],
