  "function_summary": {
    "summary": "sphinxcontrib-jsmath 是 Sphinx 文档构建工具的一款官方扩展，负责把 reStructuredText 中的行内数学（math）与独立显示数学（math_block）节点转换成 HTML 标记，并通过 JavaScript 库（如 jsMath）在浏览器端渲染公式。它自身只包含一个 HTML 数学渲染器，安装到 Sphinx 应用后，由 Sphinx 在构建 HTML 时调用。",
    "categories": [
      {
        "name": "HTML 数学渲染器注册",
        "description": "通过 Sphinx 扩展入口 setup() 将 jsmath 渲染器注册到 HTML 构建器，并声明配置项 jsmath_path 与本地化消息目录。",
        "evidence": ["sphinxcontrib/jsmath/__init__.py:75-88"]
      },
      {
        "name": "行内数学公式 HTML 生成",
        "description": "处理 docutils.nodes.math 节点，输出带 math 样式的 <span> 标签，并跳过默认节点渲染。",
        "evidence": ["sphinxcontrib/jsmath/__init__.py:28-31"]
      },
      {
        "name": "独立显示数学公式 HTML 生成",
        "description": "处理 docutils.nodes.math_block 节点，支持编号、换行对齐与permalink，生成对应的 <div> 与 <span class=\"eqno\"> 标记。",
        "evidence": ["sphinxcontrib/jsmath/__init__.py:34-58"]
      },
      {
        "name": "条件注入 jsmath.js",
        "description": "在文档包含数学公式且构建器为 HTML 时，向页面添加用户配置的 jsmath.js 脚本路径；否则不加载。",
        "evidence": ["sphinxcontrib/jsmath/__init__.py:61-72"]
      },
      {
        "name": "本地化支持",
        "description": "使用 Sphinx 的 get_translation 与 add_message_catalog，为渲染提示文本（如 \"Permalink to this equation\"）提供多语言支持。",
        "evidence": ["sphinxcontrib/jsmath/__init__.py:25", "sphinxcontrib/jsmath/__init__.py:77"]
      }
    ],
    "domain": "documentation",
    "target_users": "使用 Sphinx 编写技术文档并需要在 HTML 输出中展示数学公式的开发者与作者"
  },
