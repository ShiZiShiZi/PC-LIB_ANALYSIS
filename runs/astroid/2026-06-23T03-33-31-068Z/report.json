    "one_liner": "为 pylint 等工具提供 Python 源代码的抽象语法树表示与静态推断能力",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "astroid 是一个 Python 抽象语法树（AST）库，它在 Python 内置 _ast 的基础上构建一套扩展节点树，并支持静态推断、作用域解析与模块加载。该库最初为 pylint 开发，现也被 pyreverse 等代码质量工具用作底层 AST 与类型推断引擎。",
    "categories": [
      {
        "name": "AST 构建与重建",
        "description": "从 Python 源码字符串、源文件或运行时模块对象构建 astroid 扩展 AST，内置 TreeRebuilder 将 _ast 节点转换为 astroid 节点",
        "evidence": [
          "astroid/builder.py:AstroidBuilder",
          "astroid/rebuilder.py:TreeRebuilder",
          "astroid/__init__.py:parse"
        ]
      },
      {
        "name": "节点模型",
        "description": "提供与 Python _ast 对应的节点类（如 Module、FunctionDef、ClassDef、Call 等），在 astroid.nodes 下维护扩展属性、源码位置与父子关系",
        "evidence": [
          "astroid/nodes/node_classes.py",
          "astroid/nodes/scoped_nodes/scoped_nodes.py:Module",
          "astroid/nodes/_base_nodes.py:NodeNG"
        ]
      },
      {
        "name": "静态推断",
        "description": "在 AST 节点上实现推断协议，尝试在静态分析阶段解析名称、调用返回值、属性访问与异常类型等",
        "evidence": [
          "astroid/nodes/node_classes.py:Call._infer",
          "astroid/bases.py:Instance",
          "astroid/protocols.py"
        ]
      },
      {
        "name": "模块发现与加载",
        "description": "封装 importlib、sysconfig、zipimport 等机制，定位标准库、第三方包与命名空间包，并为 C 扩展/内置模块生成部分 AST",
        "evidence": [
          "astroid/interpreter/_import/spec.py:find_spec",
          "astroid/modutils.py:file_info_from_modpath",
          "astroid/manager.py:AstroidManager"
        ]
      },
      {
        "name": "Transform 与 Brain 插件",
        "description": "通过 TransformVisitor 与大量 brain 模块为常见标准库和第三方库（如 numpy、pytest、subprocess、signal 等）提供推断增强或补全",
        "evidence": [
          "astroid/transforms.py:TransformVisitor",
          "astroid/brain/helpers.py:register_all_brains",
          "astroid/brain/brain_builtin_inference.py"
        ]
      },
      {
        "name": "命令行接口",
        "description": "提供 astroid ast 子命令，用于在终端打印指定 Python 文件的 astroid AST",
        "evidence": [
          "astroid/__main__.py:main",
          "astroid/__main__.py:parse_ast"
        ]
      }
    ],
