{
  "library": {
    "name": "pyee",
    "package_name": "pyee",
    "source_url": "https://github.com/jfhbrook/pyee",
    "analyzed_at": "2026-06-22T08:37:25.196Z",
    "commit": "661fe6a4e144a0ce205d1e900836157208b79122",
    "one_liner": "一个近似 Node.js EventEmitter 的 Python 事件发射器库，支持同步、asyncio、Trio、Twisted 及线程执行器等多种执行模型。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "pyee 为 Python 提供了一套受 Node.js EventEmitter 启发的事件发布/订阅机制。它以一个同步的 EventEmitter 为核心，并派生出支持 asyncio、Trio、Twisted 和 concurrent.futures 执行器的异步/并发后端，方便开发者在不同异步框架中统一使用事件驱动模式。",
    "categories": [
      {
        "name": "同步事件发射器",
        "description": "提供 EventEmitter 基类，支持 on/once/emit/remove_listener 等监听器注册、触发与移除操作。",
        "evidence": ["pyee/base.py:EventEmitter"]
      },
      {
        "name": "asyncio 异步事件发射器",
        "description": "AsyncIOEventEmitter 自动识别协程处理器并通过 asyncio.ensure_future 将其调度到事件循环，支持等待完成与取消。",
        "evidence": ["pyee/asyncio.py:AsyncIOEventEmitter"]
      },
      {
        "name": "Trio 异步事件发射器",
        "description": "TrioEventEmitter 在 Trio nursery 中以 start_soon 方式运行协程处理器，并提供异步上下文管理器生命周期。",
        "evidence": ["pyee/trio.py:TrioEventEmitter"]
      },
      {
        "name": "Twisted 异步事件发射器",
        "description": "TwistedEventEmitter 支持 Twisted Deferred、inlineCallbacks 以及原生协程，统一通过 failure/error 事件处理异常。",
        "evidence": ["pyee/twisted.py:TwistedEventEmitter"]
      },
      {
        "name": "线程/执行器事件发射器",
        "description": "ExecutorEventEmitter 将同步回调提交到 concurrent.futures Executor（默认 ThreadPoolExecutor），实现非阻塞的事件处理。",
        "evidence": ["pyee/executor.py:ExecutorEventEmitter"]
      },
      {
        "name": "类装饰器与事件封装",
        "description": "提供 evented/on 装饰器为类方法自动绑定事件发射器，以及 uplift 工具将底层事件发射器能力提升到新的 emitter 类型。",
        "evidence": ["pyee/cls.py:evented,on", "pyee/uplift.py:uplift"]
      },
      {
        "name": "监听器生命周期管理",
        "description": "支持事件名查询、监听器列表、一次性监听器、批量移除，以及 new_listener/error 等特殊事件。",
        "evidence": ["pyee/base.py:event_names,listeners,once,remove_all_listeners"]
      }
    ],
    "domain": "事件驱动编程 / 异步编程工具库",
    "target_users": "Python 应用开发者及使用 asyncio、Trio、Twisted 等异步框架的开发者"
  },
