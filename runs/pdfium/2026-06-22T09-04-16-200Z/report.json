    "one_liner": "Google 开源的 C++ PDF 解析、渲染与表单处理引擎，提供稳定的 C API 供嵌入式应用使用。",
    "ecosystem": "cpp",
    "bindings": []
  },
  "function_summary": {
    "summary": "PDFium 是 Google 维护的开源 PDF 引擎，核心用 C++20 编写，提供 C 语言公共 API。它负责解析 PDF 文档结构、逐页光栅化为位图、提取文本与元数据、填充交互式表单，并可选地通过 V8 执行 PDF JavaScript 与 XFA 表单逻辑。目标用户主要是浏览器、办公软件、阅读器以及需要在桌面或移动平台嵌入 PDF 能力的 C/C++ 项目开发者。",
    "categories": [
      {
        "name": "PDF 解析与文档访问",
        "description": "解析 PDF 文件结构（对象、交叉引用、流、目录），提供文档加载、页面遍历、附件、签名等基础访问能力。",
        "evidence": ["public/fpdfview.h", "core/fpdfapi/parser/cpdf_parser.cpp", "core/fpdfdoc/"]
      },
      {
        "name": "页面渲染与光栅化",
        "description": "将 PDF 页面渲染为位图，支持路径、图像、文本、透明、颜色管理；默认使用 AGG，实验性支持 Skia。",
        "evidence": ["core/fxge/agg/cfx_agg_devicedriver.cpp", "core/fxge/cfx_renderdevice.cpp", "public/fpdfview.h"]
      },
      {
        "name": "文本提取与搜索",
        "description": "从页面生成文本布局，支持按字符/单词提取、搜索高亮、访问结构化文本树。",
        "evidence": ["core/fpdftext/", "public/fpdf_text.h", "public/fpdf_searchex.h"]
      },
      {
        "name": "表单填充与交互",
        "description": "支持 AcroForm 交互式表单的创建、填写、压平，以及表单事件回调。",
        "evidence": ["fpdfsdk/formfiller/", "public/fpdf_formfill.h", "public/fpdf_flatten.h"]
      },
      {
        "name": "JavaScript 与 XFA 支持",
        "description": "通过 V8 引擎执行 PDF JavaScript；可选支持 XFA 表单与条码生成。",
        "evidence": ["fxjs/cfxjs_engine.cpp", "fxbarcode/", "public/fpdf_javascript.h", "xfa/"]
      },
      {
        "name": "注释与文档编辑",
        "description": "创建、读取、修改 PDF 注释，以及页面对象、路径、文本的编辑接口。",
        "evidence": ["public/fpdf_annot.h", "public/fpdf_edit.h", "fpdfsdk/fpdf_annot.cpp"]
      },
      {
        "name": "字体管理与系统字体回退",
        "description": "解析内嵌字体，扫描系统字体目录进行字体替换与回退，跨平台使用 FreeType/HarfBuzz/平台字体接口。",
        "evidence": ["core/fxge/cfx_font.cpp", "core/fxge/cfx_folderfontinfo.cpp", "core/fxge/freetype/fx_freetype.cpp"]
      }
    ],
    "domain": "文档处理 / 图形渲染",
    "target_users": "需要嵌入 PDF 查看、渲染或处理能力的桌面/移动应用开发者、浏览器厂商及其他 C/C++ 项目"
  },
