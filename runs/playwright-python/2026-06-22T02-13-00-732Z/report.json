  "function_summary": {
    "summary": "playwright 是 Microsoft 官方维护的 Python 浏览器自动化库，为 Chromium、Firefox、WebKit 提供统一 API。Python 客户端通过 stdin/stdout 长度前缀 JSON 管道与 bundled 的 Node 驱动通信，由 Node 驱动负责真正的浏览器启停、页面控制与网络拦截。库同时提供 async/await 与同步阻塞两种 API 风格，并内置 expect 断言，主要面向 Web 端到端测试与 RPA 场景。",
    "categories": [
      {
        "name": "浏览器自动化控制",
        "description": "启动/关闭浏览器、管理 BrowserContext、Page 生命周期，以及 CDP 会话等底层能力封装",
        "evidence": ["playwright/_impl/_browser_type.py", "playwright/_impl/_browser.py", "playwright/_impl/_browser_context.py"]
      },
      {
        "name": "页面与元素交互",
        "description": "页面导航、截图、PDF、元素定位与操作、输入、对话框处理、WebSocket、Worker 等高级页面 API",
        "evidence": ["playwright/_impl/_page.py", "playwright/_impl/_locator.py", "playwright/_impl/_element_handle.py", "playwright/_impl/_dialog.py"]
      },
      {
        "name": "网络拦截与请求",
        "description": "请求/响应路由、HAR 回放、Cookie、缓存、代理、客户端证书以及 API 请求上下文",
        "evidence": ["playwright/_impl/_network.py", "playwright/_impl/_fetch.py", "playwright/_impl/_har_router.py"]
      },
      {
        "name": "同步/异步双 API",
        "description": "由同一套 _impl 实现生成 async_api 与 sync_api，sync API 借助 greenlet 在事件循环上模拟阻塞调用",
        "evidence": ["playwright/async_api/_generated.py", "playwright/sync_api/_generated.py", "playwright/_impl/_sync_base.py", "playwright/_impl/_async_base.py", "playwright/_impl/_greenlets.py"]
      },
      {
        "name": "测试断言",
        "description": "提供 Page/Locator/APIResponse 的 expect 断言实现，支持软断言与自动重试",
        "evidence": ["playwright/_impl/_assertions.py", "playwright/async_api/__init__.py:expect"]
      },
      {
        "name": "浏览器驱动集成",
        "description": "定位 bundled 的 Node 驱动可执行文件、设置 PW_* 环境变量、启动子进程并通过 PipeTransport 通信",
        "evidence": ["playwright/_impl/_driver.py", "playwright/_impl/_transport.py", "playwright/__main__.py"]
      }
    ],
