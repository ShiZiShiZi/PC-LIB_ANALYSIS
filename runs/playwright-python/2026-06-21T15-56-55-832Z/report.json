          "playwright/_impl/_transport.py",
          "setup.py"
        ]
      },
      {
        "name": "追踪、录制与上下文隔离",
        "description": "支持 HAR 录制、视频录制、追踪文件、存储状态与客户端证书等上下文级配置。",
