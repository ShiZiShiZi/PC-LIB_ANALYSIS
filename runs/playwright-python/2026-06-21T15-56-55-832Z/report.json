  "function_summary": {
    "summary": "playwright 是跨浏览器 Web 自动化库。本仓库为其 Python 语言绑定：客户端通过 JSON 协议 pipe 与内置的 Node.js 驱动通信，向上暴露异步与同步两套 API，覆盖浏览器启动、页面操作、元素定位、网络拦截、API 请求、追踪录制等能力，主要服务于 Web 测试与自动化脚本开发者。",
    "categories": [
      {
        "name": "浏览器生命周期管理",
        "description": "启动、连接、关闭浏览器实例，管理 BrowserContext 与页面的创建与销毁。",
        "evidence": [
          "playwright/_impl/_browser_type.py",
          "playwright/_impl/_browser.py",
          "playwright/_impl/_browser_context.py"
        ]
      },
      {
        "name": "页面与元素交互",
        "description": "对 Page、Frame 执行导航、点击、填充、截图等操作，并通过 Locator 进行链式元素定位。",
        "evidence": [
          "playwright/_impl/_page.py",
          "playwright/_impl/_frame.py",
          "playwright/_impl/_locator.py"
        ]
      },
      {
        "name": "网络与请求拦截",
        "description": "监听请求/响应事件、拦截并修改网络路由、处理 WebSocket，以及发起独立 API 请求。",
        "evidence": [
          "playwright/_impl/_network.py",
          "playwright/_impl/_fetch.py"
        ]
      },
      {
        "name": "元素定位与选择器",
        "description": "提供 role/text/test-id/label 等高级选择器语法，以及自定义选择器引擎注册。",
        "evidence": [
          "playwright/_impl/_locator.py",
          "playwright/_impl/_selectors.py"
        ]
      },
      {
        "name": "异步/同步 API 包装",
        "description": "基于 greenlet 在单线程内将异步实现桥接为同步 API，同时保留原生 async/await API。",
        "evidence": [
          "playwright/async_api/_generated.py",
          "playwright/sync_api/_generated.py",
