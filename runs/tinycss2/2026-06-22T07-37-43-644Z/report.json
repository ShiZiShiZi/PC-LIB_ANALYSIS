  "function_summary": {
    "summary": "tinycss2 是一个低级 CSS 解析库，能够将 CSS 字符串切分为 token、解析成抽象语法树节点，并重新序列化为 CSS 文本。它实现了 CSS Syntax Level 3 的核心语法，但不包含具体 CSS 模块的属性语义。适用于需要自定义处理 CSS 的 Web 框架、样式工具、PDF/渲染库以及其他 Python 开发者。",
    "categories": [
      {
        "name": "CSS 分词",
        "description": "将 CSS 字符流拆分为标准 token（标识符、数字、维度、字符串、URL、注释等），并记录行列位置。",
        "evidence": ["tinycss2/tokenizer.py:parse_component_value_list", "tinycss2/__init__.py:17"]
      },
      {
        "name": "CSS 解析",
        "description": "在分词基础上解析样式表、规则列表、声明块、单个规则/声明/分量值，生成 QualifiedRule/AtRule/Declaration 等 AST 节点。",
        "evidence": ["tinycss2/parser.py:parse_stylesheet", "tinycss2/parser.py:parse_blocks_contents"]
      },
      {
        "name": "CSS 序列化",
        "description": "将 AST 节点重新输出为符合 CSS 规范的字符串，处理相邻 token 歧义、字符串/URL/标识符转义等边界情况。",
        "evidence": ["tinycss2/serializer.py:serialize", "tinycss2/serializer.py:_serialize_to"]
      },
      {
        "name": "AST 节点表示",
        "description": "提供 token 与规则的 Python 对象模型（Node 基类及各类子类），支持序列化与类型判断。",
        "evidence": ["tinycss2/ast.py:Node", "tinycss2/ast.py:Declaration", "tinycss2/ast.py:QualifiedRule"]
      },
      {
        "name": "字节流与编码处理",
        "description": "按浏览器方式检测 CSS 字节流的字符编码（BOM、@charset、协议编码、环境编码），并解析为样式表。",
        "evidence": ["tinycss2/bytes.py:decode_stylesheet_bytes", "tinycss2/bytes.py:parse_stylesheet_bytes"]
      },
      {
        "name": "CSS 颜色解析",
        "description": "解析 CSS Color Level 3/4/5 颜色值（关键词、hex、rgb/hsl/hwb/lab/lch/oklab/oklch/device-cmyk/light-dark 等），并提供颜色空间转换。",
        "evidence": ["tinycss2/color3.py:parse_color", "tinycss2/color4.py:parse_color", "tinycss2/color5.py:parse_color"]
      },
      {
        "name": "An+B 解析",
        "description": "解析 :nth-child() 等选择器伪类中常见的 An+B 语法。",
        "evidence": ["tinycss2/nth.py:parse_nth"]
      }
    ],
