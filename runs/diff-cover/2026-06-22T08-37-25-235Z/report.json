    "one_liner": "自动发现 git diff 中缺少测试覆盖或存在代码质量问题的行，并输出 HTML/JSON/Markdown 报告。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "diff-cover 是一款面向代码评审的 Python CLI 工具，它将 git diff 与 Cobertura/Clover/JaCoCo XML 或 LCov 覆盖率报告进行对比，输出新增或修改行中未被测试覆盖的行；diff-quality 则对 diff 行运行 pycodestyle、flake8、pylint、ruff、eslint、checkstyle、clang-format 等静态检查工具并汇总违规。主要服务于希望在 CI/CD 或本地提交前检查增量代码质量的多语言项目开发者。",
    "categories": [
      {
        "name": "Git diff 获取与解析",
        "description": "调用 git diff、git ls-files、git rev-parse 获取当前工作区变更，解析出变更文件路径与行号范围。",
        "evidence": ["diff_cover/git_diff.py:GitDiffTool", "diff_cover/git_path.py:GitPathTool", "diff_cover/diff_reporter.py:GitDiffReporter"]
      },
      {
        "name": "覆盖率报告解析",
        "description": "解析 Cobertura、Clover、JaCoCo 三种 XML 覆盖率格式以及 LCov info 格式，提取每行命中次数并识别未覆盖行。",
        "evidence": ["diff_cover/violationsreporters/violations_reporter.py:XmlCoverageReporter", "diff_cover/violationsreporters/violations_reporter.py:LcovCoverageReporter"]
      },
      {
        "name": "代码质量检查集成",
        "description": "内置对 Python（pycodestyle、pyflakes、flake8、pylint、pydocstyle、mypy、ruff）、JavaScript（eslint、jshint）、C/C++（clang-format、cppcheck）、Java（checkstyle、findbugs、pmd）及 shellcheck 等工具的驱动与报告解析。",
        "evidence": ["diff_cover/violationsreporters/violations_reporter.py", "diff_cover/violationsreporters/java_violations_reporter.py", "diff_cover/violationsreporters/base.py:QualityReporter"]
      },
      {
        "name": "多格式报告生成",
        "description": "基于 Jinja2 模板生成 HTML、JSON、Markdown、控制台文本及 GitHub Actions annotations 等多种报告输出。",
        "evidence": ["diff_cover/report_generator.py:HtmlReportGenerator", "diff_cover/report_generator.py:JsonReportGenerator", "diff_cover/report_generator.py:MarkdownReportGenerator", "diff_cover/report_generator.py:GitHubAnnotationsReportGenerator", "diff_cover/templates/"]
      },
      {
        "name": "代码片段语法高亮",
        "description": "使用 Pygments 对报告中的源码片段进行语法高亮，并用 chardet 检测文件编码，支持 HTML 与 Markdown 展示。",
        "evidence": ["diff_cover/snippets.py:Snippet", "diff_cover/snippets.py:pygments", "diff_cover/snippets.py:chardet"]
      },
      {
        "name": "命令行入口与配置",
        "description": "提供 diff-cover 与 diff-quality 两个 CLI 入口，支持 argparse 命令行参数、TOML 配置文件以及旧版参数兼容。",
        "evidence": ["diff_cover/diff_cover_tool.py:main", "diff_cover/diff_quality_tool.py:main", "diff_cover/config_parser.py:TOMLParser"]
      },
      {
        "name": "插件扩展机制",
        "description": "通过 pluggy hookspec 允许第三方包注册新的 diff-quality 检查工具，无需改动 diff-cover 本体。",
        "evidence": ["diff_cover/hookspecs.py", "diff_cover/hook.py", "diff_cover/diff_quality_tool.py:pluggy.PluginManager"]
      }
    ],
    "domain": "软件质量保证",
    "target_users": "多语言项目的开发者与 CI/CD 流水线维护者"
  },
