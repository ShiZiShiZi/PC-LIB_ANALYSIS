  "function_summary": {
    "summary": "OpenBLAS 是基于 GotoBLAS2 1.13 BSD 版本优化的 BLAS（Basic Linear Algebra Subprograms）库，同时集成了参考 LAPACK 实现以及 CBLAS/LAPACKE C 语言封装接口。它通过针对 x86、ARM、POWER、RISC-V、LoongArch 等 CPU 架构的手写汇编与 SIMD 内核提供高性能矩阵/向量运算，主要面向科学计算、机器学习、数据分析及其他需要稠密线性代数能力的上层库与终端开发者。",
    "categories": [
      {
        "name": "BLAS 核心例程",
        "description": "提供 Level 1/2/3 的稠密矩阵与向量运算，包括 GEMM、GEMV、AXPY、DOT、TRSM 等标准 BLAS 接口。",
        "evidence": [
          "interface/gemm.c",
          "interface/gemv.c",
          "interface/axpy.c",
          "driver/level2",
          "driver/level3"
        ]
      },
      {
        "name": "CBLAS C 语言接口",
        "description": "在 BLAS Fortran 命名规范之上提供 C 语言封装（cblas_xxx）与运行时线程/配置查询函数。",
        "evidence": [
          "cblas.h",
          "interface/cblas",
          "driver/others/openblas_set_num_threads.c",
          "driver/others/openblas_get_config.c"
        ]
      },
      {
        "name": "LAPACK 线性代数求解器",
        "description": "集成参考 LAPACK 与 OpenBLAS 优化版线性方程、特征值、SVD 等高层数值例程。",
        "evidence": [
          "lapack/",
          "lapack-netlib/SRC",
          "relapack/src"
        ]
      },
      {
        "name": "LAPACKE C 接口",
        "description": "为 LAPACK 例程提供 C 语言调用接口（lapacke_xxx）。",
        "evidence": [
          "lapack-netlib/LAPACKE/include/lapacke.h",
          "lapack-netlib/LAPACKE/src"
        ]
      },
      {
        "name": "CPU 架构优化内核",
        "description": "针对不同 CPU 微架构（x86_64、arm64、POWER、RISC-V、LoongArch、zarch）手写汇编与 SIMD 微内核。",
        "evidence": [
          "kernel/x86_64/",
          "kernel/arm64/",
          "kernel/power/",
          "kernel/riscv64/",
          "cpuid_x86.c",
          "cpuid_arm64.c"
        ]
      },
      {
        "name": "多线程并行与线程管理",
        "description": "基于 POSIX pthreads 或 Windows 线程实现内部线程池，提供线程数设置与回调扩展。",
        "evidence": [
          "driver/others/blas_server.c",
          "driver/others/blas_server_win32.c",
          "driver/others/init.c",
          "driver/others/openblas_set_num_threads.c"
        ]
      },
      {
        "name": "动态架构探测",
        "description": "DYNAMIC_ARCH 模式下在运行时通过 cpuid、/proc/cpuinfo、sysctl 等识别 CPU 并选择最优内核。",
        "evidence": [
          "driver/others/dynamic.c",
