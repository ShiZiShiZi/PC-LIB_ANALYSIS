  "function_summary": {
    "summary": "argcomplete 是一个为基于 argparse 的 Python 命令行程序提供 bash/zsh/tcsh/fish/PowerShell 命令补全的库。开发者在 ArgumentParser 构造完成后调用 argcomplete.autocomplete(parser)，库通过 shell 补全钩子触发 Python 程序，解析当前命令行上下文并返回候选补全项。它主要面向需要交互式命令行体验的 Python CLI 开发者。",
    "categories": [
      {
        "name": "命令补全编排",
        "description": "通过 CompletionFinder 识别 argparse 解析器中的选项、子命令与位置参数，调用注册的 completer 收集并格式化补全结果。",
        "evidence": ["argcomplete/finders.py:CompletionFinder.__call__", "argcomplete/finders.py:collect_completions"]
      },
      {
        "name": "Shell 集成",
        "description": "生成并安装 bash/zsh/tcsh/fish/PowerShell 的补全脚本，支持全局补全与按程序注册两种模式。",
        "evidence": [
          "argcomplete/shell_integration.py:shellcode",
          "argcomplete/scripts/activate_global_python_argcomplete.py",
          "argcomplete/scripts/register_python_argcomplete.py",
          "argcomplete/bash_completion.d/_python-argcomplete"
        ]
      },
      {
        "name": "内置补全器",
        "description": "提供文件、目录、环境变量、固定选项等常用 completer，以及通过 bash compgen 获取文件列表的能力。",
        "evidence": [
          "argcomplete/completers.py:FilesCompleter",
          "argcomplete/completers.py:DirectoriesCompleter",
          "argcomplete/completers.py:EnvironCompleter",
          "argcomplete/completers.py:ChoicesCompleter"
        ]
      },
      {
        "name": "命令行分词与解析内省",
        "description": "内置 shlex 变体对 COMP_LINE 进行分词，并 monkey-patch argparse 以在补全过程中内省活跃 action 与子解析器。",
        "evidence": [
          "argcomplete/lexers.py:split_line",
          "argcomplete/packages/_shlex.py",
          "argcomplete/packages/_argparse.py",
          "argcomplete/finders.py:_patch_argument_parser"
        ]
      },
      {
        "name": "注册与检测工具",
        "description": "提供 _check_module 与 _check_console_script 工具，供全局补全脚本检测入口模块或 console script 是否包含 PYTHON_ARGCOMPLETE_OK 标记。",
        "evidence": ["argcomplete/_check_module.py", "argcomplete/_check_console_script.py"]
      }
    ],
    "domain": "命令行工具 / Shell 补全",
    "target_users": "使用 argparse 构建 CLI 的 Python 开发者"
  },
