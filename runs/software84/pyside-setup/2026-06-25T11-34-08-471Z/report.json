  "function_summary": {
    "summary": "pyside-setup 是 Qt for Python 的官方源码与构建仓库。它首先构建 shiboken6（一个基于 libclang 的 C++ 绑定生成器），然后使用 shiboken6 为 Qt6 的几乎所有模块生成 Python 绑定，最终打包成 PySide6/shiboken6 Python 包。核心能力覆盖：Qt 框架的 Python 暴露、C++ 库绑定生成、Python 与 C++ 对象生命周期桥接、类型签名与 .pyi 存根生成，以及 pyside6-* 工具链。目标用户是开发桌面/嵌入式 GUI 应用、需要把 C++ 库包装到 Python 的开发者。",
    "categories": [
      {
        "name": "Qt6 Python 绑定",
        "description": "为 Qt6 的 Core、Gui、Widgets、Network、Multimedia、Qml、Quick、3D、WebEngine 等模块生成 Python 模块，使 Python 代码可以直接创建和操作 Qt 对象。",
        "evidence": [
          "sources/pyside6/cmake/PySideHelpers.cmake:76-145",
          "sources/pyside6/PySide6/glue/qtcore.cpp",
          "README.md:3-5"
        ]
      },
      {
        "name": "C++ 绑定生成器（Shiboken6）",
        "description": "解析 C++ 头文件与类型系统 XML，自动生成 C-API 扩展代码，支持重载解析、内存管理、虚函数重入、容器转换等。",
        "evidence": [
          "sources/shiboken6_generator/generator/shiboken/cppgenerator.cpp",
          "sources/shiboken6_generator/ApiExtractor/abstractmetalang.cpp",
          "sources/shiboken6_generator/generator/main.cpp"
        ]
      },
      {
        "name": "Python/C++ 对象桥接与生命周期管理",
        "description": "libshiboken/libpyside 提供 SbkObject、BindingManager、所有权转移、GIL 管理、主线程删除等机制，保证 Python 对象与底层 C++ 对象安全交互。",
        "evidence": [
          "sources/shiboken6/libshiboken/basewrapper.cpp",
          "sources/shiboken6/libshiboken/bindingmanager.cpp",
          "sources/pyside6/libpyside/pyside.cpp"
        ]
      },
      {
        "name": "类型签名与 .pyi 生成",
        "description": "内嵌 signature_bootstrap 模块，在运行时解析并缓存函数签名；构建阶段调用 generate_pyi.py 生成类型提示文件。",
        "evidence": [
          "sources/shiboken6/libshiboken/signature/signature_globals.cpp",
          "sources/pyside6/support/generate_pyi.py",
          "sources/shiboken6/CMakeLists.txt:165-179"
        ]
      },
      {
        "name": "开发与部署工具链",
        "description": "提供 pyside6-designer、pyside6-uic、pyside6-rcc、pyside6-deploy、pyside6-android-deploy 等入口，用于 Qt 工具调用、项目打包与跨平台部署。",
        "evidence": [
          "sources/pyside-tools/pyside_tool.py",
          "sources/pyside-tools/deploy_lib/commands.py",
          "sources/pyside-tools/CMakeLists.txt:34-61"
        ]
      }
    ],
    "domain": "GUI / 绑定生成 / 跨平台桌面开发",
    "target_users": "Python 桌面/嵌入式 GUI 开发者、需要为 C++ 库生成 Python 绑定的开发者"
