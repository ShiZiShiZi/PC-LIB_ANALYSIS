  },
  "function_summary": {
    "summary": "Appium Inspector 是一款面向 Appium 自动化测试的桌面 GUI 辅助工具，以 Electron 桌面应用形态发布，同时提供可嵌入 Appium 服务器的浏览器插件形态。它通过 WebDriver 协议连接本地或远程 Appium 服务器，可视化展示被测应用的页面截图与源码树，支持元素定位、点击/滑动手势、命令执行以及多语言客户端代码生成。",
    "categories": [
      {
        "name": "会话构建与管理",
        "description": "配置 Appium 服务器地址、编辑 Desired Capabilities、保存/加载 .appiumsession 会话文件，并支持从文件或 URL 恢复会话状态",
        "evidence": [
          "app/common/renderer/actions/SessionBuilder.js",
          "app/common/renderer/components/SessionBuilder/SessionBuilder.jsx",
          "app/common/renderer/utils/sessionfile-parsing.js"
        ]
      },
      {
        "name": "元素检查与交互",
        "description": "展示应用截图与页面源码树，高亮选中元素，支持按多种策略（XPath、class chain、predicate 等）定位元素，并在截图上执行点击、滑动、手势等操作",
        "evidence": [
          "app/common/renderer/components/SessionInspector/SessionInspector.jsx",
          "app/common/renderer/lib/appium/inspector-driver.js",
          "app/common/renderer/utils/locator-generation/"
        ]
      },
      {
        "name": "WebDriver 命令执行",
        "description": "封装 webdriver 客户端，调用 Appium/WebDriver 标准命令与 executeScript 扩展命令，并展示命令返回值",
        "evidence": [
          "app/common/renderer/lib/appium/session-starter.js",
          "app/common/renderer/lib/appium/session-driver.js",
          "app/common/renderer/constants/commands.js"
        ]
      },
      {
        "name": "多平台云服务商集成",
        "description": "内置 SauceLabs、BrowserStack、HeadSpin、LambdaTest 等二十余家云测设备平台的连接配置与认证，支持从环境变量读取凭证",
        "evidence": [
          "app/common/renderer/lib/vendor/",
          "app/common/renderer/components/SessionBuilder/ServerDetails/CloudProviders.jsx"
        ]
      },
      {
        "name": "桌面应用壳与集成",
        "description": "Electron 主进程负责窗口管理、应用菜单、深色主题、外部链接打开、自动更新以及 .appiumsession 文件关联",
        "evidence": [
          "app/electron/main/main.js",
          "app/electron/main/windows.js",
          "app/electron/main/menus.js",
          "app/electron/main/updater.js"
        ]
      },
      {
        "name": "客户端代码生成",
        "description": "根据用户操作自动生成 Java/JUnit、Python、JavaScript/WDIO、Ruby、Robot Framework、C# 等测试框架代码片段",
        "evidence": [
          "app/common/renderer/lib/client-frameworks/"
        ]
      }
    ],
    "domain": "mobile test automation / GUI tool",
    "target_users": "移动应用测试工程师、QA 自动化开发者"
  },
