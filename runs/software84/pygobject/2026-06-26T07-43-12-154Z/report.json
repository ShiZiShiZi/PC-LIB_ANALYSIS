    "one_liner": "为 GObject Introspection 库提供 Python 绑定的运行时桥接库，支持 GTK、GLib/GIO、GStreamer 等 GObject 库。",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "PyGObject 是一个 Python 库，通过 GObject Introspection（GI）元数据把 GTK、GLib/GIO、GStreamer 等基于 GObject 的 C 库动态暴露为 Python 模块。核心是一个 C 扩展：它借助 Python C API 和 libffi 完成 Python 对象与 C 函数调用之间的双向编组，并在 Python 层提供 override 以改善 API 的 Pythonic 程度。",
    "categories": [
      {
        "name": "GObject Introspection 桥接",
        "description": "C 扩展读取 GIR/typelib 元数据，在运行时为每个 GI 命名空间生成 Python 代理模块，并通过 libffi 调用底层 C 函数。",
        "evidence": [
          "gi/pygi-invoke.c:698",
          "gi/pygi-repository.c:155",
          "gi/importer.py:127"
        ]
      },
      {
        "name": "GLib/GIO 主循环与异步集成",
        "description": "提供 asyncio 事件循环适配（GLibEventLoop）和 signal 唤醒机制，使 Python 的信号处理器在 GLib 主循环空闲时仍可被触发。",
        "evidence": [
          "gi/events.py:21",
          "gi/_ossighelper.py:54"
        ]
      },
      {
        "name": "GTK/GDK/Pango Python 覆盖层",
        "description": "为 GTK 等 GUI 库提供更贴近 Python 习惯的 API 覆盖与模板支持。",
        "evidence": [
          "gi/overrides/Gtk.py",
          "gi/overrides/Gdk.py",
          "gi/overrides/Pango.py"
        ]
      },
      {
        "name": "Cairo 外部类型互操作",
        "description": "通过 pycairo 在 Python cairo 对象与 GI 参数之间进行编组，使 Cairo 类型能作为 GObject signal/属性值传递。",
        "evidence": [
          "gi/pygi-foreign-cairo.c:41",
          "gi/__init__.py:216"
        ]
      },
      {
        "name": "GObject 类型/信号/属性封装",
        "description": "暴露 GType、GObject 生命周期、信号连接/断开、属性安装与绑定的 Python 接口。",
        "evidence": [
          "gi/pygobject-object.c",
          "gi/pygobject-class.c",
          "gi/overrides/GObject.py"
        ]
      }
    ],
    "domain": "GUI 绑定 / 语言桥接",
    "target_users": "需要在 Python 中使用 GTK、GLib/GIO、GStreamer 等 GObject 库的开发者"
  },
