  "function_summary": {
    "summary": "GitLab Runner 是 GitLab CI/CD 的官方执行器，作为命令行应用运行。它注册到 GitLab 实例后持续轮询并拉取作业，在本地或远程的容器、虚拟机、Shell 等环境中执行构建、测试与部署脚本，并将日志和产物回传给 GitLab。",
    "categories": [
      {
        "name": "作业执行与调度",
        "description": "轮询 GitLab 协调器、领取作业、管理并发 worker 与作业生命周期、处理优雅/强制关闭",
        "evidence": [
          "commands/multi.go:677",
          "commands/multi.go:1300",
          "common/build.go"
        ]
      },
      {
        "name": "多执行器支持",
        "description": "支持 Docker、Kubernetes、Shell、SSH、VirtualBox、Parallels、Custom 等多种执行后端，按需初始化和关闭",
        "evidence": [
          "main.go:18-27",
          "executors/docker/docker.go",
          "executors/kubernetes/kubernetes.go",
          "executors/shell/shell.go"
        ]
      },
      {
        "name": "网络与 GitLab 通信",
        "description": "通过 REST API 与 GitLab 协调器通信，处理认证、轨迹流、产物上传、TLS 配置与请求重试",
        "evidence": [
          "network/client.go:42",
          "network/gitlab.go:54",
          "network/gitlab.go:128-129"
        ]
      },
      {
        "name": "Shell 脚本生成",
        "description": "为 Bash、PowerShell、CMD 生成跨平台脚本，注入 CI/CD 变量、凭证辅助与退出码处理",
        "evidence": [
          "shells/bash.go",
          "shells/powershell.go",
          "shells/abstract.go"
        ]
      },
      {
        "name": "缓存与产物",
        "description": "支持 S3、GCS、Azure、MinIO 等缓存后端，以及 zip/tar 产物归档与并行传输",
        "evidence": [
          "cache/s3/s3.go",
          "cache/gcs/gcs.go",
