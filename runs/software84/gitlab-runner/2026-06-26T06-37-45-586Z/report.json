          "helpers/archives"
        ]
      },
      {
        "name": "服务注册与管理",
        "description": "以系统服务形式安装、启动、停止 Runner，支持 systemd、Windows Service 与 launchd",
        "evidence": [
          "commands/service.go:55",
          "commands/service_linux.go",
          "commands/service_windows.go"
        ]
      },
      {
        "name": "可观测性",
        "description": "暴露 Prometheus 指标、pprof 调试端点、Sentry 日志钩子、OpenTelemetry 追踪与用量日志",
        "evidence": [
