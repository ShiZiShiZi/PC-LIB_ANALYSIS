  "function_summary": {
    "summary": "wheel 是一个用于创建与操作 Python wheel 归档文件（PEP 427）的纯 Python 命令行工具。它提供 unpack、pack、convert、tags、info 等 CLI 子命令，并包含 WheelFile 类用于带 RECORD 哈希校验的 wheel 读写，以及历史上由 setuptools 使用的 bdist_wheel 命令实现。主要面向 Python 包维护者、构建工具开发者与需要在本地操作 wheel 归档的开发者。",
    "categories": [
      {
        "name": "wheel 文件读写与哈希校验",
        "description": "基于 zipfile.ZipFile 扩展实现 WheelFile，解析 wheel 文件名、读取 .dist-info/RECORD、对读取内容做 SHA-256 哈希校验，并负责写入 RECORD 与生成可复现的时间戳。",
        "evidence": ["src/wheel/wheelfile.py:WheelFile", "src/wheel/wheelfile.py:58", "src/wheel/wheelfile.py:open", "src/wheel/wheelfile.py:writestr"]
      },
      {
        "name": "命令行工具",
        "description": "提供 wheel unpack / pack / convert / tags / info / version / help 子命令，用于解包、重新打包、转换旧格式、修改平台标签和查看 wheel 元数据。",
        "evidence": ["src/wheel/_commands/__init__.py:parser", "src/wheel/_commands/__init__.py:85", "src/wheel/_commands/unpack.py", "src/wheel/_commands/pack.py", "src/wheel/_commands/tags.py", "src/wheel/_commands/info.py", "src/wheel/_commands/convert.py"]
      },
      {
        "name": "旧分发格式转换",
        "description": "将 .egg 归档/目录与 Windows wininst 安装程序转换为 wheel 格式，同时把 requires.txt、PKG-INFO 等旧元数据迁移为 Metadata 2.4 与 WHEEL 文件。",
        "evidence": ["src/wheel/_commands/convert.py:convert", "src/wheel/_commands/convert.py:EggFileSource", "src/wheel/_commands/convert.py:WininstFileSource"]
      },
      {
        "name": "元数据解析与生成",
        "description": "解析并生成 PEP 566/643 风格的 METADATA、WHEEL 文件，提供 requires.txt 到 Requires-Dist、extras 到 Provides-Extra 的转换逻辑。",
        "evidence": ["src/wheel/_metadata.py", "src/wheel/_metadata.py:pkginfo_to_metadata", "src/wheel/_metadata.py:generate_requirements", "src/wheel/_commands/pack.py:pack"]
      },
      {
        "name": "macOS 平台标签计算",
        "description": "通过解析 Mach-O / Fat 二进制头（LC_VERSION_MIN_MACOSX、LC_BUILD_VERSION）获取 .dylib / .so 的最低系统版本，从而计算正确的 macosx 平台标签。",
        "evidence": ["src/wheel/macosx_libfile.py:calculate_macosx_platform_tag", "src/wheel/macosx_libfile.py:extract_macosx_min_system_version", "src/wheel/_bdist_wheel.py:get_platform"]
      },
      {
        "name": "setuptools 集成",
        "description": "提供 bdist_wheel distutils/setuptools 命令，用于从源码构建生成 wheel；新版本 setuptools 已内置该命令，此处保留兼容实现。",
        "evidence": ["src/wheel/_bdist_wheel.py:bdist_wheel", "src/wheel/bdist_wheel.py", "pyproject.toml:project.entry-points.distutils.commands"]
      }
    ],
