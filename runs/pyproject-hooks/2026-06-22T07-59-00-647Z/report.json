  "function_summary": {
    "summary": "pyproject-hooks 是一个低层 Python 库，用于在独立子进程中调用基于 pyproject.toml 的构建后端（build backend）所提供的 PEP 517 钩子（如 build_wheel、build_sdist、prepare_metadata_for_build_wheel 等）。它主要负责子进程隔离、JSON 形式的进程间通信、钩子返回值解析与异常转换，供 pip、build 等构建前端集成使用。",
    "categories": [
      {
        "name": "构建后端钩子调用",
        "description": "包装 PEP 517 规定的所有钩子（get_requires_for_build_*、prepare_metadata_for_build_*、build_*），通过 _call_hook 统一调度。",
        "evidence": [
          "src/pyproject_hooks/_impl.py:139",
          "src/pyproject_hooks/_impl.py:191-389",
          "src/pyproject_hooks/_in_process/_in_process.py:342"
        ]
      },
      {
        "name": "子进程隔离执行",
        "description": "默认使用 subprocess.run 启动独立 Python 解释器运行 _in_process.py，避免构建后端的导入污染前端环境；同时提供可插拔的 SubprocessRunner 协议。",
        "evidence": [
          "src/pyproject_hooks/_impl.py:78-115",
          "src/pyproject_hooks/_impl.py:391-409"
        ]
      },
      {
        "name": "进程间通信与序列化",
        "description": "使用 tempfile 创建的临时目录存放 input.json/output.json，并通过 json 模块序列化/反序列化钩子参数与返回值。",
        "evidence": [
          "src/pyproject_hooks/_impl.py:29-36",
          "src/pyproject_hooks/_impl.py:398-411",
          "src/pyproject_hooks/_in_process/_in_process.py:32-39",
          "src/pyproject_hooks/_in_process/_in_process.py:371-397"
        ]
      },
      {
        "name": "异常与警告转换",
        "description": "将后端不可用、钩子缺失、不支持操作等状态转换为前端可识别的异常（BackendUnavailable、HookMissing、UnsupportedOperation、BuildBackendWarning）。",
        "evidence": [
          "src/pyproject_hooks/_impl.py:39-76",
          "src/pyproject_hooks/_impl.py:411-430",
          "src/pyproject_hooks/_in_process/_in_process.py:42-57"
        ]
      },
      {
        "name": "后端路径解析",
        "description": "支持通过 backend_path 指定树内后端路径，并用自定义 _BackendPathFinder 确保优先从指定路径加载构建后端模块。",
        "evidence": [
          "src/pyproject_hooks/_impl.py:118-136",
          "src/pyproject_hooks/_in_process/_in_process.py:82-118"
        ]
      }
    ],
