  "function_summary": {
    "summary": "OxyPlot 是一个面向 .NET 的跨平台绘图库，核心包（OxyPlot.Core）定义了平台无关的 PlotModel/IRenderContext 抽象层，支持线图、柱状图、饼图、散点图、热力图、等高线图、金融图、直方图等数十种图表类型及注释、图例、坐标轴。通过多套渲染后端（WPF Canvas、Windows Forms GDI+、SkiaSharp、ImageSharp、PDFsharp、SVG）在不同 .NET 运行时（.NET Framework 4.6.2 / .NET 6 / .NET 8 / .NET Standard 2.0）上输出图表到屏幕或文件。",
    "categories": [
      {
        "name": "数据可视化与图表渲染",
        "description": "提供 30+ 种 Series 类型（LineSeries、BarSeries、ScatterSeries、HeatMapSeries、ContourSeries、CandleStickSeries、HistogramSeries 等），支持多轴、对数轴、极坐标、日期时间轴，内置 XY/Polar/Cartesian 布局，以及 Png/Jpeg/Svg/Pdf/Xps 多格式导出。",
        "evidence": [
          "Source/OxyPlot/Series/",
          "Source/OxyPlot/Axes/",
          "Source/OxyPlot/Svg/SvgExporter.cs",
          "Source/OxyPlot/Pdf/PdfExporter.cs"
        ]
      },
      {
        "name": "平台适配渲染后端",
        "description": "核心库通过 IRenderContext 接口抽象绘图操作，各平台包提供具体实现：WPF（CanvasRenderContext/XamlRenderContext）、Windows Forms（GraphicsRenderContext 基于 System.Drawing）、SkiaSharp（SkiaRenderContext）、ImageSharp（ImageRenderContext）、PDF（PdfRenderContext），以及 SVG 文本渲染。",
        "evidence": [
          "Source/OxyPlot/Rendering/RenderContext/IRenderContext.cs",
          "Source/OxyPlot.Wpf/CanvasRenderContext.cs",
          "Source/OxyPlot.WindowsForms/GraphicsRenderContext.cs",
          "Source/OxyPlot.SkiaSharp/SkiaRenderContext.cs",
          "Source/OxyPlot.ImageSharp/ImageRenderContext.cs"
        ]
      },
      {
        "name": "交互控制器与事件处理",
        "description": "PlotController 提供鼠标/键盘/触摸手势到图表操作（平移、缩放、跟踪器、区域缩放）的绑定机制，支持自定义命令与输入手势映射，以及 Tracker 悬浮提示。",
        "evidence": [
          "Source/OxyPlot/PlotController/PlotController.cs",
          "Source/OxyPlot/PlotController/PlotCommands.cs",
          "Source/OxyPlot/PlotController/Manipulators/"
        ]
      },
      {
        "name": "图像编解码",
        "description": "内置 PNG/BMP/JPEG 解码器和 PNG 编码器（含自实现 Deflate 压缩），不依赖外部图像库即可进行基本图像格式处理。",
        "evidence": [
          "Source/OxyPlot/Imaging/Png/",
          "Source/OxyPlot/Imaging/Bmp/",
          "Source/OxyPlot/Imaging/Jpeg/",
          "Source/OxyPlot/Imaging/Deflate/"
        ]
      }
    ],
    "domain": "数据可视化/图表绘制",
    "target_users": "在 .NET 应用中需要嵌入交互式或静态图表的开发者，包括 WPF、Windows Forms、跨平台（SkiaSharp/ImageSharp）场景"
  },
