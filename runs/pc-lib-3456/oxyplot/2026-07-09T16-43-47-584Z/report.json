  "function_summary": {
    "summary": "OxyPlot 是一个面向 .NET 生态的开源跨平台图表绘制库（library），提供丰富的二维数据可视化能力。开发者通过创建 PlotModel、向其添加 Series（数据系列）和 Axes（坐标轴）、再绑定到 PlotView 控件，即可在桌面应用中渲染出折线图、柱状图、饼图、散点图、面积图、热力图、等高线图、金融 K 线图等二十余种图表。库核心独立于 UI 框架（OxyPlot.Core），通过 OxyPlot.Wpf（WPF）、OxyPlot.WindowsForms（WinForms）、OxyPlot.SkiaSharp（SkiaSharp 跨平台渲染）等包适配不同 .NET UI 平台，还支持 SVG/PDF/PNG 导出。",
    "categories": [
      {
        "name": "图表模型与数据系列",
        "description": "核心绘图引擎：PlotModel 作为图表容器，通过 Series（LineSeries、BarSeries、ScatterSeries、PieSeries、AreaSeries、ContourSeries、HeatMapSeries 等二十余种数据系列）定义图表内容，Axes（LinearAxis、LogarithmicAxis、DateTimeAxis、CategoryAxis 等）定义坐标轴映射。",
        "evidence": [
          "Source/OxyPlot/PlotModel/PlotModel.cs",
          "Source/OxyPlot/Series/"
        ]
      },
      {
        "name": "UI 平台渲染适配",
        "description": "通过 OxyPlot.Wpf（基于 WPF Canvas/DrawingVisual 的原生渲染）、OxyPlot.WindowsForms（基于 GDI+/System.Drawing 的 WinForms 控件）、OxyPlot.SkiaSharp（基于 SkiaSharp 的跨平台 2D 渲染）等包，将图表模型渲染到不同 .NET UI 平台。",
        "evidence": [
          "Source/OxyPlot.Wpf/",
          "Source/OxyPlot.WindowsForms/",
          "Source/OxyPlot.SkiaSharp/"
        ]
      },
      {
        "name": "图像与文档导出",
        "description": "支持将图表导出为多种格式：PNG 位图（通过各平台渲染后端）、SVG 矢量图（OxyPlot.SvgExporter）、PDF 文档（OxyPlot.Pdf，基于 PDFsharp）、XPS/XAML 等，满足报告生成与打印需求。",
        "evidence": [
          "Source/OxyPlot/Svg/",
          "Source/OxyPlot.Pdf/"
        ]
      },
      {
        "name": "交互与控制器",
        "description": "通过 PlotController 处理鼠标/触摸/键盘手势，支持缩放（鼠标滚轮/矩形框选）、平移、轨迹追踪（Tracker）等交互操作。",
        "evidence": [
          "Source/OxyPlot/PlotController/",
          "Source/OxyPlot/Input/"
        ]
      },
      {
        "name": "图像编解码",
        "description": "内置 PNG、BMP、JPEG 图像的编解码器（基于 Deflate 压缩），用于图表图像的加载与处理，不依赖外部图像库。",
        "evidence": [
          "Source/OxyPlot/Imaging/"
        ]
      }
    ],
    "domain": "数据可视化 / 图表绘制",
    "target_users": ".NET 桌面应用开发者",
    "ecosystem": "dotnet"
  },
