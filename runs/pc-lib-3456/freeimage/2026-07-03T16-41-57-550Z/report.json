  "function_summary": {
    "summary": "FreeImage 是一个开源的跨平台 C/C++ 图像处理库，提供统一的 C 语言 API 接口，支持加载、保存、转换和处理 30 余种常见与专业图像格式（BMP、JPEG、PNG、TIFF、GIF、WebP、OpenEXR、RAW 等）。适用于桌面应用开发、图像引擎和工具链，目标用户是需要跨平台图像 I/O 与格式转换的 C/C++/C#/Delphi 开发者。",
    "categories": [
      {
        "name": "图像格式读写（30+ 格式）",
        "description": "支持 BMP、ICO、JPEG、PNG、TIFF、GIF、WebP、TARGA、PSD、DDS、OpenEXR、RAW、J2K、JP2、JNG、MNG、HDR、PBM/PGM/PPM、XBM/XPM 等格式的加载与保存，通过内部插件架构实现。每个格式对应一个 Plugin 模块（如 PluginBMP、PluginPNG、PluginTIFF 等），统一经由 FreeImage_Load/FreeImage_Save API 访问。",
        "evidence": [
          "Source/FreeImage.h:786-854 (公开 API、FREE_IMAGE_FORMAT 枚举、Load/Save 函数)",
          "Source/FreeImage/Plugin.cpp:218-277 (内部插件初始化，注册所有格式)",
          "Source/FreeImage/PluginBMP.cpp",
          "Source/FreeImage/PluginPNG.cpp",
          "Source/FreeImage/PluginTIFF.cpp",
          "Source/FreeImage/PluginWebP.cpp"
        ]
      },
      {
        "name": "内存流与自定义 I/O",
        "description": "支持从内存缓冲区加载/保存图像及多页位图，提供 FreeImage_OpenMemory/CloseMemory、LoadFromMemory/SaveToMemory、以及 FreeImageIO 结构体让调用方注入自定义读写/寻址/定位函数，实现完全脱离文件系统的图像处理流水线。",
        "evidence": [
          "Source/FreeImage.h:823-837 (内存 I/O API)",
          "Source/FreeImageIO.h:31-62 (FIMEMORYHEADER 结构、SetMemoryIO)",
          "Source/FreeImage/MemoryIO.cpp"
        ]
      },
      {
        "name": "图像类型与位深转换",
        "description": "提供丰富的位深与色彩空间转换——支持 1/4/8/16/24/32 位位图互转、16-bit unsigned/16-bit unsigned short/float/double/RGB 48-bit/RGBA 64-bit/RGBF 96-bit/RGBAF 128-bit 等类型。提供色彩量化（Wu/NeuQuant/LFPQuant 三种算法）、半色调(Halftoning)、颜色抖动(Floyd-Steinberg/Bayer 等算法)。",
        "evidence": [
          "Source/FreeImage.h:427-441 (FREE_IMAGE_TYPE 枚举)",
          "Source/FreeImage.h:457-474 (量化与抖动算法枚举)",
          "Source/FreeImage.h:989-1014 (ConvertTo*/FromRawBits API)",
          "Source/FreeImage/Conversion.cpp",
          "Source/FreeImage/Halftoning.cpp",
          "Source/FreeImage/WuQuantizer.cpp",
          "Source/FreeImage/NNQuantizer.cpp",
          "Source/FreeImage/LFPQuantizer.cpp"
        ]
      },
      {
        "name": "图像处理工具集",
        "description": "提供缩放(Rescale)、旋转(Rotate)、翻转(Flip)、裁剪(Copy/Paste)、亮度/对比度/伽马调整、颜色映射、通道提取与设置、背景填充、画布扩展、图像合成(Composite)、Alpha 预乘等基本图像处理操作。缩放支持 Box/Bicubic/Bilinear/B-Spline/Catmull-Rom/Lanczos3 滤波器。",
        "evidence": [
          "Source/FreeImage.h:1093-1142 (图像处理工具 API 段)",
          "Source/FreeImageToolkit/Rescale.cpp",
          "Source/FreeImageToolkit/Resize.cpp",
          "Source/FreeImageToolkit/Rotate.cpp",
          "Source/FreeImageToolkit/Colors.cpp",
          "Source/FreeImageToolkit/Channels.cpp",
          "Source/FreeImageToolkit/CopyPaste.cpp",
          "Source/FreeImageToolkit/Background.cpp"
        ]
      },
      {
        "name": "元数据读写",
        "description": "支持读取和写入多种图像元数据模型：Exif（Main/Exif/GPS/MakerNote/Interop）、IPTC/NAA、XMP、GeoTIFF，以及动画元数据和自定义元数据。提供 tag 粒度的键值读写、克隆与遍历接口。",
        "evidence": [
          "Source/FreeImage.h:527-582 (FIMETADATA/FITAG 结构及元数据模型枚举)",
          "Source/FreeImage.h:1037-1074 (元数据 API)",
          "Source/Metadata/Exif.cpp",
          "Source/Metadata/IPTC.cpp",
          "Source/Metadata/TagLib.cpp",
          "Source/Metadata/XTIFF.cpp"
        ]
      },
      {
        "name": "HDR 色调映射",
        "description": "支持三种高动态范围(HDR)色调映射算法：Drago03 自适应对数映射、Reinhard05 光度感受器模拟、Fattal02 梯度域压缩，将 HDR 浮点图像转换为 LDR 显示格式。",
        "evidence": [
          "Source/FreeImage.h:490-497 (FREE_IMAGE_TMO 枚举)",
          "Source/FreeImage.h:1017-1023 (ToneMapping API)",
          "Source/FreeImage/tmoDrago03.cpp",
          "Source/FreeImage/tmoReinhard05.cpp",
          "Source/FreeImage/tmoFattal02.cpp"
        ]
      },
      {
        "name": "插件扩展架构",
        "description": "支持本地/外部图像插件注册与加载——外部插件(.fip)可在运行时通过 LoadLibrary(dlopen)加载，允许第三方按 Plugin 函数表接口扩展新的图像格式支持。",
        "evidence": [
          "Source/FreeImage.h:621-664 (Plugin 结构体)",
          "Source/FreeImage.h:840-859 (插件注册与查询 API)",
          "Source/FreeImage/Plugin.cpp:210-353 (FreeImage_Initialise / 外部插件加载)"
        ]
      },
      {
        "name": "图像信息查询与像素访问",
        "description": "提供位图尺寸、位深、色彩类型、调色板、扫描线、像素值、透明度表、ICC 配置文件等元信息的读取接口，以及像素级索引和颜色值的 Get/Set 访问。",
        "evidence": [
          "Source/FreeImage.h:883-938 (图像信息与像素访问 API)",
          "Source/FreeImage/PixelAccess.cpp",
          "Source/FreeImage/BitmapAccess.cpp"
        ]
      },
      {
        "name": "多页面图像支持",
        "description": "支持多页/多帧位图（如多页 TIFF、动画 GIF、动画 MNG）的打开、追加页面、插入页面、删除页面、锁定/解锁页面、页面移动等操作。",
        "evidence": [
          "Source/FreeImage.h:861-874 (MultiBitmap API)",
          "Source/FreeImage/MultiPage.cpp"
        ]
      }
    ],
