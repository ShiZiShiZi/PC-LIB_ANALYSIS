  "function_summary": {
    "summary": "AOM（Alliance for Open Media）是 AV1 视频编码标准的官方参考实现库，以 C/C++ 编写，向外提供统一的 C API（aom_codec_*），同时封装编码器（aomenc）与解码器（aomdec）命令行工具。它覆盖从原始 YUV/Y4M 输入、IVF/WebM 容器读写，到多线程编码/解码、率控制、ROI、SVC、外部帧缓冲等完整视频处理链路，广泛用于浏览器、流媒体、视频会议等场景。",
    "categories": [
      {
        "name": "AV1 编码",
        "description": "提供 AV1 编码器接口，支持多路率控制（VBR/CBR/CQ/Q）、多通道（two-pass/three-pass）、SVC、ROI、噪声建模、实时编码等能力。",
        "evidence": [
          "aom/aom_encoder.h",
          "av1/av1_cx_iface.c",
          "apps/aomenc.c",
          "av1/encoder/"
        ]
      },
      {
        "name": "AV1 解码",
        "description": "提供 AV1 解码器接口，支持 Annex-B/OBU、外部帧缓冲、低比特深度路径、多线程解码等。",
        "evidence": [
          "aom/aom_decoder.h",
          "av1/av1_dx_iface.c",
          "apps/aomdec.c",
          "av1/decoder/"
        ]
      },
      {
        "name": "容器与示例工具",
        "description": "提供 IVF/WebM 容器读写、Y4M 输入解析、统计输出，以及 aomenc/aomdec 命令行工具和多个示例程序。",
        "evidence": [
          "common/ivfenc.c",
          "common/ivfdec.c",
          "common/webmdec.cc",
          "common/webmenc.cc",
          "apps/aomenc.c",
          "apps/aomdec.c"
        ]
      },
      {
        "name": "平台抽象与运行期优化",
        "description": "通过 RTCD（Run-Time CPU Dispatch）在运行时根据 CPU 特性选择 SIMD/汇编实现；封装 pthread/Win32 线程、计时器、内存对齐等跨平台能力。",
        "evidence": [
          "aom_ports/",
          "aom_util/aom_thread.c",
          "aom_dsp/aom_dsp_rtcd.c",
          "cmake/aom_optimization.cmake"
        ]
      },
      {
        "name": "可选质量调优与实验功能",
        "description": "可选集成 VMAF、Butteraugli（JPEG-XL）、TensorFlow Lite 等做质量调优；提供比特流分析器（analyzer）等实验/调试能力。",
        "evidence": [
          "CMakeLists.txt:CONFIG_TUNE_VMAF",
          "CMakeLists.txt:CONFIG_TUNE_BUTTERAUGLI",
          "CMakeLists.txt:CONFIG_TFLITE",
          "CMakeLists.txt:CONFIG_ANALYZER"
        ]
      }
    ],
    "domain": "multimedia / video codec",
    "target_users": "视频应用开发者、流媒体平台、浏览器与播放器厂商、视频会议系统开发者"
  },
