  "function_summary": {
    "summary": "WebSocket4Net 是一个流行的 .NET WebSocket 客户端库，基于 SuperSocket 2.0 和现代 .NET（.NET 6/7/8/9）构建。它提供了完整的 WebSocket 协议客户端实现，支持 ws/wss 安全连接、子协议协商、自定义 HTTP 头、自动 Ping/Pong 心跳保活，以及事件驱动和按需接收两种消息处理模式。该库面向需要在 .NET 应用中集成 WebSocket 客户端功能的开发者。",
    "categories": [
      {
        "name": "WebSocket 连接管理",
        "description": "提供 WebSocket 客户端的完整生命周期管理，包括通过 URI 解析建立连接（ws/wss）、WebSocket 握手（Sec-WebSocket-Key/Accept 验证）、连接状态追踪（None/Connecting/Open/CloseSent/CloseReceived/Closed）以及优雅关闭流程",
        "evidence": [
          "src/WebSocket4Net/WebSocket.cs:77-97",
          "src/WebSocket4Net/WebSocket.cs:130-181",
          "src/WebSocket4Net/WebSocketState.cs:3-11"
        ]
      },
      {
        "name": "消息收发",
        "description": "支持文本和二进制 WebSocket 消息的发送与接收，提供事件驱动（PackageHandler）和按需接收（ReceiveAsync）两种模式，底层使用 WebSocket 帧编码/解码与 PipeWriter/PipeReader 高性能 I/O",
        "evidence": [
          "src/WebSocket4Net/WebSocket.cs:226-275",
          "src/WebSocket4Net/WebSocket.cs:317-351",
          "src/WebSocket4Net/IWebSocket.cs:14-19"
        ]
      },
      {
        "name": "自动心跳保活",
        "description": "内置可配置的自动 Ping/Pong 机制，定期发送 Ping 帧检测连接活性，若 Pong 未在预期时间内返回则自动关闭连接",
        "evidence": [
          "src/WebSocket4Net/PingPongStatus.cs:20-47",
          "src/WebSocket4Net/AutoPingOptions.cs:3-22",
          "src/WebSocket4Net/WebSocket.cs:174-178"
        ]
      },
      {
        "name": "协议扩展与自定义",
        "description": "支持 WebSocket 子协议协商、自定义 HTTP 请求头、Origin 设置等协议扩展功能",
        "evidence": [
          "src/WebSocket4Net/WebSocket.cs:116-122",
          "src/WebSocket4Net/WebSocket.cs:58-66",
          "src/WebSocket4Net/WebSocket.cs:192-224"
        ]
      },
      {
        "name": "关闭握手处理",
        "description": "实现完整的 WebSocket 关闭握手流程，支持本地/远端发起关闭、关闭原因编码与文本解析、CloseStatus 追踪",
        "evidence": [
          "src/WebSocket4Net/WebSocket.cs:355-413",
          "src/WebSocket4Net/WebSocket.cs:415-454"
        ]
      }
    ],
    "domain": "networking",
    "target_users": ".NET 应用开发者（需要在应用中集成 WebSocket 客户端功能的开发者）"
  },
