  "function_summary": {
    "summary": "libsixel 是一个 C 语言实现的 DEC SIXEL 图形格式编解码库，提供高低两级 API 将普通图像（PNG/JPEG/GIF/BMP 等）编码为 SIXEL 终端逃逸序列，或将 SIXEL 数据解码为位图。支持颜色量化、误差扩散抖动、GIF 动画编解码等高级功能。附带 img2sixel 和 sixel2png 两个命令行工具，以及 Python、Perl、Ruby、PHP 四种脚本语言绑定，方便其他应用集成终端图形显示能力。",
    "categories": [
      {
        "name": "SIXEL 编码",
        "description": "将位图数据编码为 DEC SIXEL 逃逸序列格式，支持 7bit/8bit 模式、高彩色、颜色量化、多种误差扩散算法、多种像素格式输入",
        "evidence": [
          "src/tosixel.c",
          "src/encoder.c",
          "include/sixel.h.in"
        ]
      },
      {
        "name": "SIXEL 解码",
        "description": "将 SIXEL 逃逸序列解析为索引位图与调色板，支持原始解码与高层解码器对象",
        "evidence": [
          "src/fromsixel.c",
          "src/decoder.c"
        ]
      },
      {
        "name": "图像加载与转换",
        "description": "通过内置 stb_image 或可选 libjpeg/libpng/gd/gdk-pixbuf2 加载多种格式图像文件，并使用高层 Encoder/Decoder API 完成文件到文件的转换",
        "evidence": [
          "src/loader.c",
          "src/loader.h",
          "converters/img2sixel.c",
          "converters/sixel2png.c"
        ]
      },
      {
        "name": "颜色量化与抖动",
        "description": "实现中位切分（median cut）颜色量化算法及 Floyd-Steinberg、Atkinson、Stucki 等多种误差扩散抖动方法，支持多种像素格式",
        "evidence": [
          "src/quant.c",
          "src/dither.c",
          "src/scale.c"
        ]
      },
      {
        "name": "PNG 输出",
        "description": "将解码后的位图数据输出为 PNG 格式文件，可选使用 libpng 或内置 stb_image_write",
        "evidence": [
          "src/writer.c",
          "src/output.c"
        ]
      },
      {
        "name": "终端交互",
        "description": "提供 TTY 终端交互功能，包括 cbreak 模式设置、终端尺寸查询（ioctl TIOCGWINSZ）、光标位置获取与滚动控制，以及 GNU Screen 穿透输出",
        "evidence": [
          "src/tty.c",
          "src/output.c"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "提供 Python (ctypes)、Perl (XS)、Ruby (C 扩展) 和 PHP (C 扩展) 四种脚本语言绑定",
        "evidence": [
          "python/libsixel/__init__.py",
          "perl/",
          "ruby/ext/libsixel/libsixel.c",
          "php/sixel.c"
        ]
      }
    ],
    "domain": "图形/终端图像",
    "target_users": "终端应用开发者、CLI 工具制作者、需要终端内嵌图像显示的应用（如终端文件管理器、终端视频播放器）"
  },
