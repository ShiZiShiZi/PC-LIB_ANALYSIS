  "function_summary": {
    "summary": "Castle Core 是 Castle 开源项目的核心基础设施库，面向 .NET 开发者和框架作者。其主要提供三个能力：Castle DynamicProxy —— 轻量级运行时动态代理生成器，可在运行时创建类/接口的代理对象并拦截方法调用（被 Moq、NSubstitute、FakeItEasy 等 Mock 框架及 Castle Windsor 广泛使用）；Castle DictionaryAdapter —— 在运行时动态生成针对未类型化字典或 XML 配置片段的强类型包装器，支持变更通知、取消和错误通知；日志抽象层 —— 提供面向多种日志框架（log4net、NLog、Serilog、EventLog）的统一日志门面。此外还包含配置抽象（IConfiguration）、资源访问和通用基础类型。",
    "categories": [
      {
        "name": "动态代理生成（DynamicProxy）",
        "description": "在运行时动态生成类/接口的代理对象，拦截方法、属性调用并注入拦截器逻辑。支持类代理、接口代理、带目标接口代理、混合代理等多种模式，被大量 Mock 框架和 IoC 容器使用",
        "evidence": [
          "src/Castle.Core/DynamicProxy/ProxyGenerator.cs",
          "src/Castle.Core/DynamicProxy/IInterceptor.cs",
          "src/Castle.Core/DynamicProxy/Generators/"
        ]
      },
      {
        "name": "字典适配器（DictionaryAdapter）",
        "description": "运行时动态生成强类型包装器，将未类型化字典或 XML 配置转换为遵循指定接口的强类型对象。支持属性变更通知（INotifyPropertyChanged）、数据校验（IDataErrorInfo）、可编辑语义（IEditableObject）",
        "evidence": [
          "src/Castle.Core/Components.DictionaryAdapter/DictionaryAdapterBase.cs",
          "src/Castle.Core/Components.DictionaryAdapter/DictionaryAdapterFactory.cs",
          "src/Castle.Core/Components.DictionaryAdapter/Xml/"
        ]
      },
      {
        "name": "日志抽象（Logging Abstraction）",
        "description": "提供面向多种日志框架的统一门面接口（ILogger/ILoggerFactory），并内置 ConsoleLogger、StreamLogger 等基础实现。作为独立 NuGet 包还提供 log4net、NLog、Serilog、EventLog 的集成适配器",
        "evidence": [
          "src/Castle.Core/Core/Logging/ILogger.cs",
          "src/Castle.Core/Core/Logging/ILoggerFactory.cs",
          "src/Castle.Services.Logging.log4netIntegration/",
          "src/Castle.Services.Logging.NLogIntegration/"
        ]
      },
      {
        "name": "配置与资源抽象",
        "description": "提供统一的配置节点模型（IConfiguration）和资源访问（IResource）基础抽象，支持从 App.config、Xml 等源读取配置",
        "evidence": [
          "src/Castle.Core/Core/Configuration/IConfiguration.cs",
          "src/Castle.Core/Core/Resource/"
        ]
      }
    ],
    "domain": "开发框架与基础设施",
    "target_users": ".NET 应用开发者与框架作者",
    "ecosystem": "dotnet"
  },
