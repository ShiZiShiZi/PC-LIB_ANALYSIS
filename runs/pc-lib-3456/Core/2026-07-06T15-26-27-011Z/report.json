  "function_summary": {
    "summary": "Castle Core 是 Castle Project 的基础类库，核心功能包括：Castle DynamicProxy——轻量级运行时代理生成器，通过 System.Reflection.Emit 在运行时动态创建类和接口的代理类型，广泛用于 AOP、Mock 框架（如 Moq、NSubstitute）及 IoC 容器；Castle DictionaryAdapter——将 IDictionary 自动适配为强类型接口，支持属性通知、编辑、校验及 XML 序列化；以及一套 ILogger 日志抽象门面，提供与 NLog、log4net、Serilog 等日志框架的集成适配器。该库面向 .NET 生态，支持 .NET Framework 4.6.2、.NET Standard 2.0、.NET 8/9 多目标框架。",
    "categories": [
      {
        "name": "运行时代理生成（DynamicProxy）",
        "description": "在运行时通过 Reflection.Emit 动态生成类代理和接口代理类型，支持方法拦截（IInterceptor）、Mixin、代理类型缓存与持久化，是 AOP 和 Mock 框架的基础设施。",
        "evidence": [
          "src/Castle.Core/DynamicProxy/ProxyGenerator.cs:32",
          "src/Castle.Core/DynamicProxy/IProxyBuilder.cs:28",
          "src/Castle.Core/DynamicProxy/IInterceptor.cs",
          "src/Castle.Core/DynamicProxy/ModuleScope.cs"
        ]
      },
      {
        "name": "字典适配器（DictionaryAdapter）",
        "description": "将 IDictionary 自动包装为强类型接口的代理对象，支持属性变更通知（INotifyPropertyChanged/INotifyPropertyChanging）、编辑（IEditableObject）、校验（IDataErrorInfo）、XML 序列化及多层编辑/撤销。",
        "evidence": [
          "src/Castle.Core/Components.DictionaryAdapter/DictionaryAdapterFactory.cs",
          "src/Castle.Core/Components.DictionaryAdapter/DictionaryAdapterBase.cs",
          "src/Castle.Core/Components.DictionaryAdapter/IDictionaryAdapter.cs"
        ]
      },
      {
        "name": "日志抽象门面（Logging）",
        "description": "提供 ILogger/ILoggerFactory 日志抽象接口及多种内置实现（ConsoleLogger、StreamLogger、TraceLogger、NullLogger），并为 NLog、log4net、Serilog、Windows EventLog 提供集成适配器。",
        "evidence": [
          "src/Castle.Core/Core/Logging/ILogger.cs:27",
          "src/Castle.Core/Core/Logging/LevelFilteredLogger.cs",
          "src/Castle.Services.Logging.NLogIntegration/Castle.Services.Logging.NLogIntegration.csproj",
          "src/Castle.Services.Logging.SerilogIntegration/Castle.Services.Logging.SerilogIntegration.csproj"
        ]
      },
      {
        "name": "配置与资源抽象",
        "description": "提供 IConfiguration/IConfigurationSource 配置树抽象及 IResource 资源定位抽象，支持嵌套配置和多种资源协议（file、config、assembly）。",
        "evidence": [
          "src/Castle.Core/Core/Configuration/AbstractConfiguration.cs",
          "src/Castle.Core/Core/Resource/ConfigResource.cs"
        ]
      }
    ],
    "domain": "基础设施 / AOP / 日志",
    "target_users": ".NET 开发者，特别是使用 IoC 容器、AOP 框架、Mock 框架或需要日志抽象的应用开发者"
  },
