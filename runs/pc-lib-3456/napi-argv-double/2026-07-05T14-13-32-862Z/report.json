  "function_summary": {
    "summary": "提供将 Node-API（napi_value）值转换为 C 双精度浮点数（double）的底层工具函数和宏，属于 stdlib 标准库的 N-API 基础设施包。其他 stdlib N-API addon 通过包含本包的头文件和链接本包的编译产物，从 JS 回调参数中提取 double 值。",
    "categories": [
      {
        "name": "N-API 值转换",
        "description": "将 JS 侧传入的 Node-API napi_value 转换为 C double 类型，含类型检查与错误处理。提供 stdlib_napi_argv_double 函数和 STDLIB_NAPI_ARGV_DOUBLE 宏两种调用方式。",
        "evidence": [
          "src/main.c:55",
          "include/stdlib/napi/argv_double.h:57-64"
        ]
      },
      {
        "name": "C 头文件分发",
        "description": "导出包含头文件的目录路径，供其他 stdlib 原生 addon 的编译系统引用。JS 侧主导出即为该路径字符串。",
        "evidence": [
          "lib/main.js:28",
          "lib/index.js:34"
        ]
      }
    ],
    "domain": "数值计算 / Node-API 基础设施",
    "target_users": "stdlib 生态中编写 Node.js 原生 C addon 的开发者"
  },
