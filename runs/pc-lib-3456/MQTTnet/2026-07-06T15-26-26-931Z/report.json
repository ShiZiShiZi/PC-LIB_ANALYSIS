  "function_summary": {
    "summary": "MQTTnet 是一个高性能的 .NET MQTT 通信库，同时提供 MQTT 客户端与服务端（Broker）实现，支持 MQTT v3.1.0、v3.1.1 和 v5.0.0 协议。它通过可扩展的传输通道抽象（TCP/TLS、WebSocket、内存通道）实现灵活部署，无需外部依赖，适用于物联网（IoT）、消息中间件和智能家居等场景。",
    "categories": [
      {
        "name": "MQTT 客户端",
        "description": "完整的 MQTT 客户端实现，支持连接/断开、发布、订阅/取消订阅、QoS 0/1/2、遗嘱消息、保持连接等核心功能，并提供低层级 LowLevelMqttClient 和自动重连的 ManagedMqttClient 两种使用模式。",
        "evidence": [
          "Source/MQTTnet/MqttClient.cs",
          "Source/MQTTnet/IMqttClient.cs",
          "Source/MQTTnet/LowLevelClient"
        ]
      },
      {
        "name": "MQTT 服务端（Broker）",
        "description": "内置 MQTT Broker 实现，支持多客户端同时连接、不同协议版本共存、保留消息持久化、客户端凭证验证、消息拦截与转换、订阅验证等服务器侧功能。",
        "evidence": [
          "Source/MQTTnet.Server/MqttServer.cs",
          "Source/MQTTnet.Server/Internal/MqttClientSessionsManager.cs"
        ]
      },
      {
        "name": "传输通道与协议格式化",
        "description": "可扩展的通信通道抽象（IMqttChannel），内置 TCP/TLS 通道（MqttTcpChannel）和 WebSocket 通道（MqttWebSocketChannel）；MQTT 协议包的序列化/反序列化（MqttPacketFormatterAdapter）；跨平台 Socket 封装（CrossPlatformSocket）。",
        "evidence": [
          "Source/MQTTnet/Implementations/MqttTcpChannel.cs",
          "Source/MQTTnet/Implementations/MqttWebSocketChannel.cs",
          "Source/MQTTnet/Implementations/CrossPlatformSocket.cs",
          "Source/MQTTnet/Formatter"
        ]
      },
      {
        "name": "TLS/SSL 安全与证书管理",
        "description": "客户端和服务端均支持 TLS 加密连接，提供证书验证回调、证书选择回调、忽略证书撤销/链错误等灵活的 TLS 配置选项。",
        "evidence": [
          "Source/MQTTnet/Options/MqttClientTlsOptions.cs",
          "Source/MQTTnet/Options/MqttClientCertificateValidationEventArgs.cs",
          "Source/MQTTnet.Server/Internal/Adapter/MqttTcpServerListener.cs"
        ]
      },
      {
        "name": "扩展包",
        "description": "RPC 扩展（基于 MQTT 的同步远程调用）、SOCKS5 代理扩展（为 TCP 传输添加 SOCKS5 代理支持）、Topic 模板扩展（基于 Mustache 语法的主题路由与分发，兼容 AsyncAPI）；ASP.NET Core 集成包（将 MQTT Broker 嵌入 ASP.NET Core 管道）。",
        "evidence": [
          "Source/MQTTnet.Extensions.Rpc",
          "Source/MQTTnet.Extensions.Socks5",
          "Source/MQTTnet.Extensions.TopicTemplate",
          "Source/MQTTnet.AspNetCore"
        ]
      }
    ],
    "domain": "networking",
    "target_users": ".NET 应用开发者（IoT、消息中间件、智能家居等）",
    "ecosystem": "dotnet"
  },
