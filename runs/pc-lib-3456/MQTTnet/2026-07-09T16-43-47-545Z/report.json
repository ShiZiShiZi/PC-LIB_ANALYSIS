  "function_summary": {
    "summary": "MQTTnet 是一个面向 .NET 平台的高性能 MQTT 协议通信库，提供完整 MQTT 客户端实现（含低级别和托管连接管理）和 MQTT Broker（服务端）实现，支持 MQTT v3/v5 协议、TLS/SSL 加密、WebSocket 传输、消息保留/持久化、客户端认证鉴权、消息拦截变换等企业级功能。适用于 IoT/物联网场景中设备与平台间的消息发布订阅、遥测传输和指令下发。",
    "categories": [
      {
        "name": "MQTT 客户端",
        "description": "提供 LowLevelMqttClient 和 ManagedMqttClient 客户端",
        "evidence": [
          "Source/MQTTnet/MqttClient.cs"
        ]
      },
      {
        "name": "MQTT Broker",
        "description": "完整 MQTT 服务端实现",
        "evidence": [
          "Source/MQTTnet.Server/MqttServer.cs"
        ]
      },
      {
        "name": "TLS/SSL 安全传输",
        "description": "基于 .NET SslStream 的 TLS 加密",
        "evidence": [
          "Source/MQTTnet/Implementations/MqttTcpChannel.cs"
        ]
      },
      {
        "name": "TCP 和 WebSocket 传输",
        "description": "TCP/WebSocket 通道",
        "evidence": [
          "Source/MQTTnet/Implementations/CrossPlatformSocket.cs"
        ]
      },
      {
        "name": "协议编解码",
        "description": "MQTT v3/v5 包编解码",
        "evidence": [
          "Source/MQTTnet/Formatter/"
        ]
      },
      {
        "name": "扩展功能",
        "description": "RPC/SOCKS5/主题模板扩展",
        "evidence": [
          "Source/MQTTnet.Extensions.Rpc/MqttRpcClient.cs"
        ]
      }
    ],
    "domain": "物联网/消息通信",
    "target_users": ".NET 开发者"
  },
