  "function_summary": {
    "summary": "@electron-internal/extract-zip 是 Electron 项目内部使用的 ZIP 压缩包解压库，专为在 Node.js 环境中快速、安全地提取 ZIP 文件而设计。其核心解压逻辑由 Rust 语言编写，通过 N-API（napi-rs）编译为原生 .node 插件，解压操作在事件循环之外执行，不阻塞主线程。相比纯 JavaScript 的 extract-zip，性能提升约 2 倍，且实现了全面的安全加固——包括 Zip Slip 防护、符号链接逃逸检测、NUL 字节和 Windows 保留设备名（CON、AUX、COM1、LPT9 等）拒绝、绝对路径拒绝以及压缩炸弹防护。面向 Electron 项目工具链使用，非通用解压库。",
    "categories": [
      {
        "name": "ZIP 解压核心",
        "description": "接收 ZIP 文件路径和目标目录，以多线程并行的方式解压文件、保留 Unix 权限位和修改时间，并按顺序处理目录、普通文件、符号链接。",
        "evidence": [
          "src/lib.rs:87-run_extract",
          "index.js:13-extract"
        ]
      },
      {
        "name": "安全路径验证",
        "description": "在解压开始前对所有归档条目进行路径安全性检查：拒绝 Zip Slip（.. 跳转）、绝对路径、NUL 字节、Windows 保留设备名；逐组件创建目录时不跟随符号链接；符号链接目标经过有限跳步分辨率验证，确保不逃逸出目标目录。",
        "evidence": [
          "src/lib.rs:316-extra_name_checks",
          "src/lib.rs:357-ensure_dir_nofollow",
          "src/lib.rs:519-verify_symlink_target"
        ]
      },
      {
        "name": "恶意归档防御",
        "description": "限制单文件解压输出上限为 max(2 × 声明大小, 1 MB) 以防御压缩炸弹；符号链接目标限制为 4 KB；限制符号链接解析跳步数（最多 40 跳）以防循环链接。",
        "evidence": [
          "src/lib.rs:255-LimitedWriter",
          "src/lib.rs:451-read_symlink_target",
          "src/lib.rs:24-MAX_SYMLINK_HOPS"
        ]
      },
      {
        "name": "跨平台预构建分发",
        "description": "通过 napi-rs 工具链为 macOS（universal）、Windows（x64/arm64）、Linux（x64/arm64, glibc+musl）预编译原生 .node 二进制，运行时自动选配。单包分发所有平台二进制，无需 optionalDependencies 或安装后网络下载。",
        "evidence": [
          "package.json:22-napi.targets",
          "README.md:70-Distribution"
        ]
      }
    ],
    "domain": "文件压缩与解压",
    "target_users": "Electron 项目工具链开发者，需要高性能、安全的 ZIP 解压能力"
  },
