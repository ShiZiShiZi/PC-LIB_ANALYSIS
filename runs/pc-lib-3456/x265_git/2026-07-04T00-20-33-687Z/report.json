  "function_summary": {
    "summary": "x265 是一个开源的 HEVC（H.265）视频编码库，核心由 C/C++ 与大量平台相关汇编实现，提供稳定的 C API 供 FFmpeg、VLC 等应用集成；仓库同时附带一个 x265 命令行编码器，可直接对 YUV/Y4M 原始视频进行编码并输出 HEVC 码流。",
    "categories": [
      {
        "name": "HEVC 视频编码",
        "description": "实现完整的 HEVC 编码器流水线，包括帧内/帧间预测、运动估计、变换量化、熵编码、环路滤波、码率控制、多线程 wavefront 调度等。",
        "evidence": [
          "source/encoder/encoder.cpp",
          "source/encoder/analysis.cpp",
          "source/encoder/frameencoder.cpp",
          "source/common/dct.cpp",
          "source/common/threadpool.cpp"
        ]
      },
      {
        "name": "C 语言公共 API",
        "description": "通过 x265.h 暴露编码器生命周期管理（x265_encoder_open/encode/close）、参数配置（x265_param）、图像缓冲（x265_picture）以及版本查询等 C API。",
        "evidence": [
          "source/x265.h:2379-2620",
          "source/encoder/api.cpp:75-1100"
        ]
      },
      {
        "name": "多架构 SIMD/汇编优化",
        "description": "针对 x86（SSE/AVX/AVX512）、ARM64（NEON/SVE/SVE2）、Power（Altivec）、RISC-V（RVV）、LoongArch（LSX/LASX）提供汇编与编译器 intrinsics 优化，并运行时检测 CPU 能力。",
        "evidence": [
          "source/common/x86/",
          "source/common/aarch64/",
          "source/common/ppc/",
          "source/common/riscv64/",
          "source/common/loongarch64/",
          "source/common/cpu.cpp"
        ]
      },
      {
        "name": "命令行编码工具",
        "description": "提供 x265 CLI，可解析大量编码参数、读取 YUV/Y4M 输入、输出 AnnexB/raw/Y4M 等格式，并支持 ABR-ladder、多 pass、分析数据复用等高级用法。",
        "evidence": [
          "source/x265.cpp:270-367",
          "source/x265cli.cpp",
          "source/input/",
          "source/output/"
        ]
      },
      {
        "name": "可选扩展与质量评估",
        "description": "可选集成 libvmaf 进行 VMAF 质量评分、SVT-HEVC 编码器路径、dynamic HDR10+ SEI 注入，以及 VTune/PPA 性能剖析接口。",
        "evidence": [
          "source/CMakeLists.txt:194-898",
          "source/dynamicHDR10/",
          "source/encoder/api.cpp:1920-2063"
        ]
      }
    ],
    "domain": "视频编码 / 多媒体",
    "target_users": "需要将视频编码为 HEVC 格式的应用开发者、流媒体处理工具与命令行用户"
  },
