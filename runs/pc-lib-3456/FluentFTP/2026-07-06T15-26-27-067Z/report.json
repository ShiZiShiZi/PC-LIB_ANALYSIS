  "function_summary": {
    "summary": "FluentFTP 是一个面向 .NET 和 .NET Standard 的全托管 FTP/FTPS 客户端库，用纯 C# 编写、无外部依赖。它提供完整的 FTP 协议命令集、文件上传/下载、SSL/TLS 加密连接、自动目录列表解析、文件哈希校验、FTP 代理、FXP 服务器间传输、异步/await 支持、文件夹监控等功能，并针对 30 余种 FTP 服务器类型进行了适配与集成测试。",
    "categories": [
      {
        "name": "FTP/FTPS 协议客户端",
        "description": "实现 FTP 和 FTPS 协议的完整客户端功能，包括连接/认证、主动/被动数据连接、SSL/TLS 显式与隐式加密、TLS 1.3 支持，以及丰富的 FTP 命令发送能力",
        "evidence": [
          "FluentFTP/Client/AsyncClient/Connect.cs",
          "FluentFTP/Client/SyncClient/Connect.cs",
          "FluentFTP/Streams/FtpSslStream.cs",
          "FluentFTP/Streams/FtpSocketStream.cs"
        ]
      },
      {
        "name": "文件传输管理",
        "description": "支持单文件和多文件的上传/下载、断点续传、进度跟踪、限速、文件校验（MD5/CRC32/SHA 系列）、目录递归同步上传下载",
        "evidence": [
          "FluentFTP/Client/AsyncClient/DownloadFile.cs",
          "FluentFTP/Client/AsyncClient/UploadFile.cs",
          "FluentFTP/Client/AsyncClient/DownloadDirectory.cs",
          "FluentFTP/Client/AsyncClient/UploadDirectory.cs",
          "FluentFTP/Helpers/Hashing/"
        ]
      },
      {
        "name": "目录列表解析",
        "description": "自动识别并解析 30 余种 FTP 服务器的目录列表格式（Unix、Windows/IIS、Azure、VMS、z/OS 等），支持自定义解析器扩展",
        "evidence": [
          "FluentFTP/Helpers/Parsers/",
          "FluentFTP/Helpers/FtpListParser.cs",
          "FluentFTP/Servers/Handlers/"
        ]
      },
      {
        "name": "FTP 代理与 FXP 传输",
        "description": "支持 HTTP 1.1、SOCKS4/4a/5、User@Host、BlueCoat 等 FTP 代理类型，以及服务器间直接文件传输（FXP 协议）",
        "evidence": [
          "FluentFTP/Proxy/",
          "FluentFTP/Client/AsyncClient/FXP.cs",
          "FluentFTP/Client/SyncClient/FXP.cs"
        ]
      },
      {
        "name": "文件夹监控",
        "description": "提供 FTP 服务器端文件夹变更监控功能，可检测文件新增/修改/删除并触发事件",
        "evidence": [
          "FluentFTP/Monitors/AsyncFtpMonitor.cs",
          "FluentFTP/Monitors/FtpMonitor.cs",
          "FluentFTP/Monitors/BlockingAsyncFtpMonitor.cs"
        ]
      },
      {
        "name": "规则过滤与日志",
        "description": "基于文件名/扩展名/大小/正则的传输规则白名单/黑名单，以及通过 TraceListener 和 ILogger 接口的日志输出",
        "evidence": [
          "FluentFTP/Rules/",
          "FluentFTP/Helpers/Logging/",
          "FluentFTP.Logging/FtpLogAdapter.cs"
        ]
      }
    ],
    "domain": "网络协议/文件传输",
    "target_users": "需要在 .NET 应用中集成 FTP/FTPS 文件传输功能的开发者"
  },
