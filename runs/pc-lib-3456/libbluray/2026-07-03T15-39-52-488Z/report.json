  "function_summary": {
    "summary": "libbluray 是 VideoLAN 与 Doom9 社区联合开发的开源库，供媒体播放器（如 VLC、MPlayer）集成 Blu-ray 光盘播放能力。C 核心负责光盘读取、UDF/BDMV 解析、导航、HDMV 虚拟机、图形字幕与菜单叠加；Java BD-J 子系统则实现 Blu-ray Disc Java 规范，用于运行光盘上的交互式菜单与增值应用。",
    "categories": [
      {
        "name": "光盘读取与容器解析",
        "description": "打开 Blu-ray 光盘/目录，解析 UDF 文件系统、BDMV 索引、播放列表（MPLS）、剪辑信息（CLPI）与扩展数据，定位标题与章节。",
        "evidence": [
          "src/libbluray/bluray.h",
          "src/libbluray/bluray.c",
          "src/libbluray/disc/disc.c",
          "src/libbluray/bdnav/navigation.c",
          "src/libbluray/bdnav/mpls_parse.c",
          "src/libbluray/bdnav/clpi_parse.c"
        ]
      },
      {
        "name": "导航与 HDMV 虚拟机",
        "description": "实现 Blu-ray 电影对象（Movie Object）虚拟机，处理菜单跳转、标题选择、按钮事件与播放器寄存器（PSR/GPR）。",
        "evidence": [
          "src/libbluray/hdmv/hdmv_vm.c",
          "src/libbluray/hdmv/mobj_parse.c",
          "src/libbluray/register.c",
          "src/libbluray/register.h"
        ]
      },
      {
        "name": "图形与字幕解码",
        "description": "解码并渲染 Presentation Graphic（PG）、Interactive Graphic（IG）、TextST 字幕，以及位图叠加（overlay）输出。",
        "evidence": [
          "src/libbluray/decoders/pg_decode.c",
          "src/libbluray/decoders/ig_decode.c",
          "src/libbluray/decoders/textst_decode.c",
          "src/libbluray/decoders/textst_render.c",
          "src/libbluray/decoders/graphics_controller.c",
          "src/libbluray/decoders/overlay.h"
        ]
      },
      {
        "name": "BD-J 菜单与交互应用",
        "description": "内嵌 BD-J 运行时：通过 JNI 加载并执行光盘上的 Java Xlet，提供 java.awt / javax.tv / org.bluray 等 BD-J API 实现，支持交互菜单、网络与持久存储。",
        "evidence": [
          "src/libbluray/bdj/bdj.c",
          "src/libbluray/bdj/native/org_videolan_Libbluray.c",
          "src/libbluray/bdj/native/java_awt_BDGraphics.c",
          "src/libbluray/bdj/java/java/awt/BDToolkitBase.java",
          "src/libbluray/bdj/java/org/videolan/Libbluray.java"
        ]
      },
      {
        "name": "AACS/BD+ 解密桥接",
        "description": "运行时动态加载 libaacs / libbdplus（或 libmmbd）以处理受 AACS/BD+ 保护的商业光盘；未找到库时自动降级为不支持加密盘。",
        "evidence": [
          "src/libbluray/disc/aacs.c",
          "src/libbluray/disc/bdplus.c",
          "src/file/dl_posix.c",
          "src/file/dl_win32.c"
        ]
      }
    ],
    "domain": "media / optical-disc playback",
    "target_users": "媒体播放器与多媒体框架开发者（如 VLC、MPlayer、Kodi），以及需要 Blu-ray 播放能力的桌面/嵌入式应用。"
  },
