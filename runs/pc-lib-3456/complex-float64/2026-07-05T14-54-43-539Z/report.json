  "function_summary": {
    "summary": "`@stdlib/complex-float64` 是 stdlib 项目中关于双精度（128 位）复数运算的命名空间包。它聚合了复数的基础构造函数、共轭、实部/虚部提取、字符串解析、JSON 反序列化恢复以及底层运算子命名空间。该包自身是一个索引/入口模块，通过 `require` 将各子功能模块注册到命名空间对象上供外部使用。面向需要在 JavaScript/Node.js 环境中进行科学计算、数值分析或复数运算的应用和库开发者。",
    "categories": [
      {
        "name": "复数构造函数",
        "description": "提供 `Complex128` 类，用以创建和表示 128 位双精度复数实例",
        "evidence": [
          "lib/index.js:64",
          "docs/types/index.d.ts:60"
        ]
      },
      {
        "name": "复数基本运算",
        "description": "提供复共轭（conj）、实部提取（real）、虚部提取（imag）、实部虚部同时提取（reim）等基本操作函数",
        "evidence": [
          "lib/index.js:48-100",
          "docs/types/index.d.ts:41-124"
        ]
      },
      {
        "name": "复数解析与序列化",
        "description": "提供 `parseComplex128` 将字符串表示（如 '5 + 3i'）解析为 Complex128 实例，以及 `reviveComplex128` 从 JSON 序列化结果恢复复数对象",
        "evidence": [
          "lib/index.js:75-109",
          "docs/types/index.d.ts:78-140"
        ]
      },
      {
        "name": "底层复数函数",
        "description": "暴露 `base` 子命名空间，汇集底层（lower-level）的双精度复数的加减乘除、取负、缩放等基本运算",
        "evidence": [
          "lib/index.js:46",
          "docs/types/index.d.ts:39"
        ]
      }
    ],
    "domain": "数值计算 / 复数运算",
    "target_users": "JavaScript/Node.js 科学计算与应用开发者",
    "ecosystem": "nodejs"
  },
