  "function_summary": {
    "summary": "nlohmann/json 是一个面向现代 C++ 的 JSON 库，提供单头文件、零依赖的 JSON 解析、序列化与数据操作能力。它以 C++11 模板元编程将 JSON 值表现为一等公民的 C++ 数据类型 `nlohmann::json`，支持类 STL 容器访问、用户自定义类型双向转换、JSON Pointer/Patch/Merge Patch 以及 BSON/CBOR/MessagePack/UBJSON/BJData 等二进制格式。目标用户是需要简洁 JSON 集成且不需额外编译配置的 C++ 应用与库开发者。",
    "categories": [
      {
        "name": "JSON 解析与反序列化",
        "description": "将 JSON 字符串、文件流、字节序列解析为 C++ `json` 对象，支持 SAX 流式解析与错误诊断。",
        "evidence": [
          "include/nlohmann/detail/input/parser.hpp",
          "include/nlohmann/detail/input/lexer.hpp",
          "include/nlohmann/detail/input/json_sax.hpp"
        ]
      },
      {
        "name": "JSON 序列化与输出",
        "description": "将 `json` 对象序列化为 JSON 字符串、缩进美化输出或写入流，支持自定义序列化器。",
        "evidence": [
          "include/nlohmann/detail/output/serializer.hpp",
          "include/nlohmann/detail/output/output_adapters.hpp"
        ]
      },
      {
        "name": "JSON 值操作与 STL 互操作",
        "description": "提供类 STL 容器接口（迭代器、operator[]、push_back、find 等）操作 JSON 对象与数组，支持与 std::vector/std::map/string 等无缝转换。",
        "evidence": [
          "include/nlohmann/detail/iterators/iter_impl.hpp",
          "include/nlohmann/detail/conversions/from_json.hpp",
          "include/nlohmann/detail/conversions/to_json.hpp"
        ]
      },
      {
        "name": "用户自定义类型双向转换",
        "description": "通过 NLOHMANN_DEFINE_TYPE_* 宏或特化 adl_serializer，将任意 C++ 结构体/类零代码侵入地实现与 JSON 的序列化/反序列化。",
        "evidence": [
          "include/nlohmann/adl_serializer.hpp",
          "include/nlohmann/detail/macro_scope.hpp"
        ]
      },
      {
        "name": "JSON Pointer 与 Patch",
        "description": "按 RFC 6901 实现 JSON Pointer 定位访问，按 RFC 6902 实现 JSON Patch 差分修改，按 RFC 7396 实现 JSON Merge Patch 合并更新。",
        "evidence": [
          "include/nlohmann/detail/json_pointer.hpp",
          "include/nlohmann/detail/output/serializer.hpp"
        ]
      },
      {
        "name": "二进制格式支持",
        "description": "支持 BSON、CBOR、MessagePack、UBJSON、BJData 五种二进制 JSON 格式的解析与输出。",
        "evidence": [
          "include/nlohmann/detail/input/binary_reader.hpp",
          "include/nlohmann/detail/output/binary_writer.hpp"
        ]
      }
    ],
    "domain": "数据处理 / JSON",
    "target_users": "C++ 应用与库开发者"
  },
