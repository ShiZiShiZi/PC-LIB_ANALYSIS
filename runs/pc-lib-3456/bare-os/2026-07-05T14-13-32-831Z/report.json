  "function_summary": {
    "summary": "bare-os 是 Bare 运行时（一个轻量级 JavaScript 运行时）的操作系统工具库，提供平台标识（platform/arch/type/release）、进程信息（pid/ppid/execPath/cwd）、用户与组信息（userInfo/groupInfo）、网络接口查询（networkInterfaces）、进程控制（kill/priority/processTitle）、环境变量读写（getEnv/setEnv/unsetEnv）以及系统资源统计（CPU/内存/负载/运行时间）等函数。API 设计紧密遵循 Node.js 标准库 `os` 模块，底层由 C 原生插件通过 libuv 实现跨平台调用。目标用户是 Bare 和 JavaScript 应用开发者。",
    "categories": [
      {
        "name": "平台与架构标识",
        "description": "获取操作系统平台（platform）、CPU 架构（arch）、系统名称（type）、版本号（version）、内核发行版（release）和机器类型（machine）",
        "evidence": [
          "index.js:12-34",
          "binding.c:23-100"
        ]
      },
      {
        "name": "进程信息",
        "description": "获取当前进程的 PID、父进程 PPID、可执行文件路径（execPath）、当前工作目录（cwd/chdir）、进程标题（getProcessTitle/setProcessTitle）",
        "evidence": [
          "index.js:36-56, 181-193",
          "binding.c:103-191, 857-896"
        ]
      },
      {
        "name": "用户与组信息",
        "description": "查询当前用户信息（uid/gid/username/homedir/shell）以及系统组信息（groupname/gid/members），支持按 UID/GID 查询",
        "evidence": [
          "index.js:70-80",
          "binding.c:257-338, 962-1044"
        ]
      },
      {
        "name": "网络接口",
        "description": "枚举系统网络接口，返回每个接口的 IP 地址、子网掩码、MAC 地址、协议族（IPv4/IPv6）、CIDR 表示法和环回标识",
        "evidence": [
          "index.js:82-93",
          "binding.c:353-494"
        ]
      },
      {
        "name": "进程控制与信号",
        "description": "向进程发送信号（kill）、获取和设置进程调度优先级（getPriority/setPriority），支持信号名称和数字两种形式",
        "evidence": [
          "index.js:95-109, 195-211",
          "binding.c:497-525, 899-959",
          "lib/constants.js:3-6"
        ]
      },
      {
        "name": "环境变量管理",
        "description": "列举（getEnvKeys）、读取（getEnv）、检查是否存在（hasEnv）、设置（setEnv）和删除（unsetEnv）环境变量，线程安全实现",
        "evidence": [
          "index.js:213-240",
          "binding.c:1047-1280"
        ]
      },
      {
        "name": "系统资源统计",
        "description": "查询系统内存总量/可用量/进程内存用量（freemem/totalmem/memoryUsage）、CPU 时间（cpuUsage/threadCpuUsage）、资源使用明细（resourceUsage）、负载均值（loadavg）、CPU 核信息（cpus）、系统运行时间（uptime）、可用并行度（availableParallelism）、受约束内存（constrainedMemory）",
        "evidence": [
          "index.js:115-179",
          "binding.c:538-852"
        ]
      }
    ],
    "domain": "system-utilities",
    "target_users": "Bare 与 JavaScript 应用开发者"
  },
