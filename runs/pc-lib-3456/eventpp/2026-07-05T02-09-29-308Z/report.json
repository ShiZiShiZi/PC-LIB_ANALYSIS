  "function_summary": {
    "summary": "eventpp 是一个 C++ 头文件库，提供进程内事件分发与回调管理基础设施。主体包含 EventDispatcher（同步事件分发）、EventQueue（异步事件队列）和 CallbackList（回调列表）三大核心，辅以条件移除器、参数适配器、事件标记生成器等工具集。全部基于 C++11 标准库实现，无外部依赖，开箱即用。",
    "categories": [
      {
        "name": "同步事件分发",
        "description": "基于事件类型键的路由分发，支持同步触发监听器、事件过滤、策略配置（线程安全/性能/排序）。用于进程内发布-订阅、信号槽模式。",
        "evidence": [
          "include/eventpp/eventdispatcher.h",
          "include/eventpp/eventpolicies.h",
          "include/eventpp/mixins/mixinfilter.h"
        ]
      },
      {
        "name": "异步事件队列",
        "description": "事件入队后批量处理，支持延迟调度、有序处理、批量等待。EventQueue 基于 C++ std::queue + std::thread 实现线程安全的异步分发。",
        "evidence": [
          "include/eventpp/eventqueue.h",
          "include/eventpp/internal/eventqueue_i.h"
        ]
      },
      {
        "name": "回调列表",
        "description": "基于模板的可动态增删回调函数列表，支持附加/前插/移除回调和批量调用。与其他两大核心共享策略与 mixin 机制。",
        "evidence": [
          "include/eventpp/callbacklist.h"
        ]
      },
      {
        "name": "异质事件支持",
        "description": "HeterCallbackList、HeterEventDispatcher、HeterEventQueue 在类型擦除层面支持不同签名的事件类型混用，以概念验证方式扩展了类型系统的灵活性。",
        "evidence": [
          "include/eventpp/hetercallbacklist.h",
          "include/eventpp/hetereventdispatcher.h",
          "include/eventpp/hetereventqueue.h"
        ]
      },
      {
        "name": "事件泵工具集",
        "description": "围绕核心散发的实用工具：CounterRemover（触发 N 次后自动移除）、ConditionalRemover（条件成立时移除监听器）、ScopedRemover（离开作用域时清理）、argumentAdapter（参数类型适配）、AnyData（零堆分配事件数据）、AnyId（任意类型事件 ID）、eventmaker（事件类生成宏）、OrderedQueueList（事件队列排序）。",
        "evidence": [
          "include/eventpp/utilities/counterremover.h",
          "include/eventpp/utilities/conditionalremover.h",
          "include/eventpp/utilities/scopedremover.h",
          "include/eventpp/utilities/argumentadapter.h",
          "include/eventpp/utilities/anydata.h",
          "include/eventpp/utilities/anyid.h",
          "include/eventpp/utilities/eventmaker.h",
          "include/eventpp/utilities/orderedqueuelist.h"
        ]
      }
    ],
    "domain": "事件系统 / 进程内消息分发",
    "target_users": "需要进程内发布-订阅、信号槽、观察者模式的 C++ 应用开发者和框架开发者"
  },
