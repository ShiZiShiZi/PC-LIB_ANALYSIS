  "function_summary": {
    "summary": "bare-fs 是 Holepunch 为 Bare JavaScript 运行时提供的原生文件系统操作库。其 API 设计紧密遵循 Node.js 内置 fs 模块的接口约定，提供包括文件打开/关闭、读写、目录操作、文件状态查询、权限管理、符号链接、文件监控、流式读写等在内的完整文件系统能力。底层通过 C addon 绑定到 libuv 的跨平台文件系统 API，实现对操作系统文件 I/O 的原生调用。该库支持同步和异步两种调用风格（回调与 Promise），并提供 promises 子模块以支持基于 FileHandle 的对象式操作。",
    "categories": [
      {
        "name": "文件与目录操作",
        "description": "提供文件的打开、关闭、读取、写入、截断、复制、重命名、删除等操作，以及目录的创建、读取、删除和临时目录创建。支持递归 mkdir/rm/cp 操作。",
        "evidence": [
          "index.js:112-146 open",
          "index.js:265-299 read",
          "index.js:354-412 write",
          "index.js:1029-1136 mkdir",
          "index.js:1387-1435 copyFile",
          "index.js:1437-1507 cp",
          "index.js:1217-1299 rm",
          "index.js:1950-2050 readFile",
          "index.js:2052-2101 writeFile",
          "index.js:1138-1174 mkdtemp"
        ]
      },
      {
        "name": "文件状态与元数据",
        "description": "通过 stat/lstat/fstat 获取文件状态信息（设备号、权限、链接数、大小、时间戳等），通过 statfs 获取文件系统统计，通过 access 检查文件访问权限。",
        "evidence": [
          "index.js:485-593 stat/lstat/fstat",
          "index.js:595-631 statfs",
          "index.js:198-242 access",
          "index.js:244-263 exists",
          "index.js:2140-2216 Stats/StatFs 类定义"
        ]
      },
      {
        "name": "权限与时间管理",
        "description": "支持修改文件权限 (chmod/fchmod)、所有者 (chown/fchown/lchown) 以及访问/修改时间 (utimes/lutimes/futimes)。在 Windows 上 chown 系列操作不可用。",
        "evidence": [
          "index.js:703-779 chmod/fchmod",
          "index.js:781-874 chown/fchown/lchown",
          "index.js:876-987 utimes/lutimes/futimes"
        ]
      },
      {
        "name": "目录遍历与迭代",
        "description": "通过 opendir 获取 Dir 对象，支持同步/异步迭代器以逐条读取目录条目。readdir 支持 withFileTypes 和 recursive 选项。Dir/Dirent 类提供了完整的类型判断方法。",
        "evidence": [
          "index.js:1823-1948 opendir/readdir",
          "index.js:2218-2416 Dir/Dirent 类定义"
        ]
      },
      {
        "name": "符号链接与路径解析",
        "description": "提供符号链接的创建 (symlink)、读取 (readlink)、状态查询 (lstat)，以及路径解析 (realpath)。支持 Windows 平台上的 junction 类型链接。",
        "evidence": [
          "index.js:1509-1574 realpath",
          "index.js:1576-1641 readlink",
          "index.js:1713-1821 symlink",
          "index.js:523-559 lstat"
        ]
      },
      {
        "name": "流式文件读写",
        "description": "通过 createReadStream/createWriteStream 创建 ReadStream/WriteStream，支持指定起始偏移和长度，底层基于 bare-stream 的 Readable/Writable。",
        "evidence": [
          "index.js:2418-2565 FileReadStream/FileWriteStream 类定义",
          "index.js:2774-2782 createReadStream/createWriteStream"
        ]
      },
      {
        "name": "文件系统监控",
        "description": "通过 watch 创建 Watcher 实例监控文件或目录的变化，支持 persistent/recursive 选项，支持 async 迭代器。底层通过 libuv 的 fs_event 实现。",
        "evidence": [
          "index.js:2126-2138 watch",
          "index.js:2567-2677 Watcher 类定义",
          "binding.c:2444-2697 Watcher 的 C 实现"
        ]
      },
      {
        "name": "数据同步",
        "description": "提供 fsync/fdatasync 将文件数据强制同步到磁盘，确保数据持久性。",
        "evidence": [
          "index.js:1643-1699 fsync/fdatasync"
        ]
      }
    ],
    "domain": "系统编程",
    "target_users": "使用 Bare JavaScript 运行时进行文件系统操作的开发者和应用"
  },
