  "function_summary": {
    "summary": "dom-to-image 是一个纯 JavaScript 浏览器端库，可将任意 DOM 节点转换为 SVG、PNG、JPEG 格式的图像或 RGBA 像素数据。它利用 SVG `<foreignObject>` 内嵌 HTML 再序列化、并通过 Canvas 渲染出位图的技巧，无需服务端参与即可在前端完成 DOM 截图。核心流程包括：克隆节点并计算样式、内嵌 web 字体与图片、序列化为 SVG、再通过 Canvas 导出 PNG/JPEG/Blob/像素数据。供前端开发者使用，零运行时依赖，仅需现代浏览器支持 Promise 与 SVG foreignObject。",
    "categories": [
      {
        "name": "DOM 截图",
        "description": "将任意 DOM 节点渲染为 PNG、JPEG 图像 data URL 或 Blob，支持背景色、尺寸、质量等选项",
        "evidence": [
          "src/dom-to-image.js:toPng",
          "src/dom-to-image.js:toJpeg",
          "src/dom-to-image.js:toBlob"
        ]
      },
      {
        "name": "SVG 导出",
        "description": "将 DOM 节点序列化为 SVG data URL，保留完整结构与样式",
        "evidence": [
          "src/dom-to-image.js:toSvg",
          "src/dom-to-image.js:makeSvgDataUri"
        ]
      },
      {
        "name": "像素数据提取",
        "description": "将 DOM 节点渲染为 Uint8Array 格式的 RGBA 像素数据，供进一步图像分析处理",
        "evidence": [
          "src/dom-to-image.js:toPixelData"
        ]
      },
      {
        "name": "样式内联与字体/图片嵌入",
        "description": "自动计算并复制计算样式、克隆伪元素、内联 web 字体的 @font-face 定义、将外部图片转为 data URL 以生成完全自包含的 SVG",
        "evidence": [
          "src/dom-to-image.js:cloneStyle",
          "src/dom-to-image.js:clonePseudoElements",
          "src/dom-to-image.js:embedFonts",
          "src/dom-to-image.js:inlineImages"
        ]
      }
    ],
    "domain": "图像生成 / DOM 渲染",
    "target_users": "前端 Web 开发者"
  },
