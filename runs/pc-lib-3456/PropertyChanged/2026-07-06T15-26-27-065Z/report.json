  "function_summary": {
    "summary": "PropertyChanged.Fody 是一个 .NET IL 织入库，作为 Fody 插件在编译期自动为实现了 INotifyPropertyChanged 接口的类注入属性变更通知代码。它消除了 WPF/XAML MVVM 开发中手工编写 PropertyChanged 事件触发的样板代码，支持依赖属性联动、变更前/后值拦截、属性级 OnChanged 回调、等值检查优化等高级功能。还附带一个 C# 增量源生成器（Source Generator），为 partial 类直接生成 INotifyPropertyChanged 基础实现。",
    "categories": [
      {
        "name": "IL 织入 / 编译期代码注入",
        "description": "通过 Mono.Cecil 在编译后阶段（Post-build IL weaving）修改程序集，向属性 setter 自动注入 PropertyChanged 事件触发、等值比较、依赖属性通知等 IL 指令",
        "evidence": [
          "PropertyChanged.Fody/ModuleWeaver.cs:3 (BaseModuleWeaver.Execute 入口)",
          "PropertyChanged.Fody/PropertyWeaver.cs:17 (Execute — 注入 IL 指令到 setter)",
          "PropertyChanged.Fody/EqualityCheckWeaver.cs"
        ]
      },
      {
        "name": "属性变更通知框架",
        "description": "为 INotifyPropertyChanged 实现类提供声明式属性依赖（AlsoNotifyFor/DependsOn）、变更回调（OnChanged）、通知拦截（全局/类级/属性级）等 MVVM 数据绑定基础设施",
        "evidence": [
          "PropertyChanged/AlsoNotifyForAttribute.cs",
          "PropertyChanged/DependsOnAttribute.cs",
          "PropertyChanged/OnChangedMethodAttribute.cs",
          "PropertyChanged.Fody/OnChangedWalker.cs"
        ]
      },
      {
        "name": "C# 增量源生成器",
        "description": "提供基于 IIncrementalGenerator 的源生成器，在编译期为 partial 类生成 INotifyPropertyChanged 事件声明和 OnPropertyChanged 方法，减少手工编码",
        "evidence": [
          "PropertyChanged.Fody.Analyzer/SourceGenerator.cs:7",
          "PropertyChanged.Fody.Analyzer/SourceGeneratorEngine.cs:9"
        ]
      },
      {
        "name": "配置与属性标注",
        "description": "提供一系列特性标注（DoNotNotify、DoNotCheckEquality、FilterType、AddINotifyPropertyChangedInterface 等）和 XML 配置选项，精细控制织入行为",
        "evidence": [
          "PropertyChanged/DoNotNotifyAttribute.cs",
          "PropertyChanged/FilterTypeAttribute.cs",
          "PropertyChanged.Fody/Config/ 目录下各配置类"
        ]
      }
    ],
    "domain": ".NET 开发工具 / MVVM 基础设施",
    "target_users": "WPF、Xamarin、MAUI 等 .NET UI 框架的开发者，特别是使用 MVVM 模式需要大量实现 INotifyPropertyChanged 的场景"
  },
