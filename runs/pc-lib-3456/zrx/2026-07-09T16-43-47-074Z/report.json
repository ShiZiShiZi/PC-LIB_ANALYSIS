  "function_summary": {
    "summary": "ZRX（Zen Reactive Extensions）是一个基于 Rust 的响应式流处理框架，为 Zensical 静态站点生成器提供数据管道基础。它提供了流（Stream）的构建、组合与转换 API，通过模块（Module）系统实现可扩展性，并由调度器（Scheduler）管理执行。核心特色在于基于图（Graph）结构的拓扑调度，允许模块间通过类型化订阅协作。",
    "categories": [
      {
        "name": "流处理与组合",
        "description": "提供 Stream 类型及其组合操作（map、join、merge 等），支持响应式数据管道的构建，通过工作流（Workflow）定义流之间的依赖和转换关系。",
        "evidence": [
          "crates/zrx-stream/src/lib.rs",
          "crates/zrx-stream/src/stream.rs"
        ]
      },
      {
        "name": "图结构与遍历",
        "description": "基于有向图的拓扑结构，支持 O(1) 的节点与边查找，提供高效的拓扑遍历（Traversal）能力，是调度器执行计划的核心数据基础。",
        "evidence": [
          "crates/zrx-graph/src/graph.rs",
          "crates/zrx-graph/src/graph/topology.rs"
        ]
      },
      {
        "name": "模块系统",
        "description": "提供 Module trait 和 Context 抽象，使所有功能以模块形式组织；支持运行时动态挂载/卸载模块，通过类型化订阅实现模块间协作。",
        "evidence": [
          "crates/zrx-module/src/module.rs",
          "crates/zrx-module/src/module/context.rs"
        ]
      },
      {
        "name": "任务调度与并行",
        "description": "Scheduler 负责协调所有挂载模块的执行，支持定时器（Timer）和异步任务（Task）调度；Executor 提供多线程任务并行执行，支持 WorkSharing 策略。",
        "evidence": [
          "crates/zrx-scheduler/src/scheduler.rs",
          "crates/zrx-executor/src/executor.rs"
        ]
      },
      {
        "name": "数据存储与标识",
        "description": "提供 Queue、Stash 等通用存储抽象，用于流与模块之间传递数据；Id 系统提供结构化的 zri: URI 标识符，用于追踪流中的数据项。",
        "evidence": [
          "crates/zrx-store/src/lib.rs",
          "crates/zrx-id/src/id.rs"
        ]
      }
    ],
    "domain": "数据处理与管道",
    "target_users": "Rust 应用开发者，特别是需要响应式数据管道的静态站点生成器或类似数据处理场景",
    "ecosystem": "rust"
  },
