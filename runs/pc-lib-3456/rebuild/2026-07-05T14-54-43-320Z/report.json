  "function_summary": {
    "summary": "@electron/rebuild 是一个 Node.js 开发工具，用于将原生 Node.js 模块（C/C++ 扩展）重新编译以匹配 Electron 内置的 Node.js 版本。它自动检测项目中的原生模块（支持 node-gyp、prebuildify、prebuild-install、node-pre-gyp 四种构建/分发工具），下载对应的 Electron 头文件和 Clang 编译器，然后调用 node-gyp 重新编译或下载预编译二进制文件。提供 CLI 命令行接口和编程 API 两种使用方式。",
    "categories": [
      {
        "name": "原生模块检测与扫描",
        "description": "遍历 node_modules 目录树，自动检测需要重新编译的原生模块（含 binding.gyp 的模块），支持 monorepo 和工作空间",
        "evidence": [
          "src/module-walker.ts",
          "src/search-module.ts"
        ]
      },
      {
        "name": "多构建工具适配",
        "description": "支持四种原生模块构建/分发工具：node-gyp（源码编译）、prebuildify（捆绑预编译文件）、prebuild-install（按需下载预编译文件）、node-pre-gyp（二进制分发框架）",
        "evidence": [
          "src/module-type/node-gyp/node-gyp.ts",
          "src/module-type/prebuildify.ts",
          "src/module-type/prebuild-install.ts",
          "src/module-type/node-pre-gyp.ts"
        ]
      },
      {
        "name": "Electron 头文件与 ABI 管理",
        "description": "根据 Electron 版本自动确定 ABI 版本（通过 node-abi），下载对应 Electron 头文件，支持自定义头文件 URL",
        "evidence": [
          "src/rebuild.ts:234-241",
          "src/node-api.ts",
          "package.json (node-abi)"
        ]
      },
      {
        "name": "Clang 编译器和 sysroot 自动获取",
        "description": "从 Google Cloud Storage 自动下载 Electron 使用的 Clang 编译器（匹配 Chromium 版本），在 Linux 上还下载对应版本的系统 sysroot 以确保编译器兼容",
        "evidence": [
          "src/clang-fetcher.ts",
          "src/sysroot-fetcher.ts"
        ]
      },
      {
        "name": "缓存与增量构建",
        "description": "基于文件内容 SHA256 哈希的缓存机制，跳过已构建且无变化的模块；缓存元数据标记模块已编译状态",
        "evidence": [
          "src/cache.ts",
          "src/module-rebuilder.ts:40-47"
        ]
      },
      {
        "name": "CLI 命令行接口",
        "description": "完整的 CLI 界面，支持多平台/架构重定向、并行/串行构建、白名单/黑名单过滤、调试模式等",
        "evidence": [
          "src/cli.ts"
        ]
      }
    ],
    "domain": "开发工具 / 构建工具",
    "target_users": "使用 Electron 框架的 Node.js 应用开发者",
    "ecosystem": "nodejs"
  },
