  "function_summary": {
    "summary": "LibRaw 是一个用于读取和处理数码相机 RAW 原始图像文件的 C/C++ 开源库，源自 Dave Coffin 的 dcraw.c。它提供统一的编程接口来提取 RAW 像素数据、解码各种相机制造商的 RAW 文件格式、获取 Bayer/CFA 模式、黑电平、白平衡等处理所需元数据，以及读取嵌入式 JPEG 预览/缩略图。该库还内置了对多种压制算法（如 Fuji X-Trans、Sony ARW2、Canon CR3、Lossy DNG）的解码支持和基于 dcraw 的基本 RAW→RGB 转换功能，主要面向 RAW 查看器、RAW 转换器、图像分析工具和全景拼合软件开发。",
    "categories": [
      {
        "name": "RAW 文件读取与格式解析",
        "description": "支持超过数百种数码相机型号的 RAW 格式（CR2/CR3/NEF/ARW/DNG/ORF/PEF 等），提供统一的打开、解析、解码接口，抽象不同厂商和压缩算法的差异",
        "evidence": [
          "src/libraw_c_api.cpp:30-74",
          "src/utils/open.cpp:17-179",
          "src/decoders/"
        ]
      },
      {
        "name": "RAW 像素数据与元数据提取",
        "description": "提取 Bayer/CFA 模式、黑电平、白平衡系数、裁剪区域等 RAW 处理所必需的元数据；读取 Makernotes 厂商特有标签和 EXIF/GPS 信息",
        "evidence": [
          "src/metadata/identify.cpp",
          "src/metadata/exif_gps.cpp",
          "src/metadata/makernotes.cpp"
        ]
      },
      {
        "name": "嵌入式预览与缩略图提取",
        "description": "从 RAW 文件中提取相机内嵌的 JPEG 预览和缩略图，支持多尺寸预览选择",
        "evidence": [
          "src/utils/thumb_utils.cpp",
          "src/decoders/unpack_thumb.cpp"
        ]
      },
      {
        "name": "RAW 后处理与基本转换",
        "description": "提供去马赛克（demosaic）、白平衡、色彩空间转换、曲线调整等基本的 RAW→RGB 转换流水线，包含多种 demosaic 算法（AHD/DCB/AAHD 等）",
        "evidence": [
          "src/postprocessing/dcraw_process.cpp",
          "src/demosaic/ahd_demosaic.cpp",
          "src/postprocessing/postprocessing_utils.cpp"
        ]
      }
    ],
    "domain": "数字图像处理 / RAW 解码",
    "target_users": "RAW 查看器与转换器开发者、数码影像分析软件开发人员",
    "ecosystem": "cpp"
  },
