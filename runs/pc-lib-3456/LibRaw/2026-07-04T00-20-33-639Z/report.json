  "function_summary": {
    "summary": "LibRaw 是一个专注于数码相机 RAW 文件读取与解码的 C/C++ 库。它为上层应用（RAW 浏览器、转换器、分析工具、拼接/堆栈软件等）提供统一接口，用于提取原始像素数据、拍摄元数据（几何、Bayer/CFA、黑电平、白平衡等）以及内嵌预览/缩略图。库的核心是跨厂商 RAW 格式解码器，并继承了 dcraw 的部分后处理代码用于快速验证与兼容。",
    "categories": [
      {
        "name": "RAW 文件解码",
        "description": "支持 Canon、Nikon、Sony、Fuji、Phase One 等数百种相机的 RAW 数据解压与解码，包括无损/有损压缩、分块读取、CR3/X-Trans/Fuji 压缩等特殊格式。",
        "evidence": [
          "src/decoders/",
          "src/decoders/crx.cpp",
          "src/decoders/fuji_compressed.cpp",
          "src/decoders/unpack.cpp"
        ]
      },
      {
        "name": "元数据提取",
        "description": "解析 EXIF、MakerNotes、TIFF/IFD、GPS、镜头信息等 RAW 文件内嵌元数据，为后续色彩处理与相机识别提供参数。",
        "evidence": [
          "src/metadata/",
          "src/metadata/identify.cpp",
          "src/metadata/exif_gps.cpp",
          "src/metadata/makernotes.cpp"
        ]
      },
      {
        "name": "去马赛克与色彩还原",
        "description": "提供 AHD、AAHD、DHT、VNG、PPG、X-Trans 等多种 demosaic 算法，以及黑电平扣除、白平衡、色彩矩阵转换等基础后处理。",
        "evidence": [
          "src/demosaic/",
          "src/postprocessing/",
          "src/demosaic/ahd_demosaic.cpp",
          "src/postprocessing/dcraw_process.cpp"
        ]
      },
      {
        "name": "数据流抽象",
        "description": "抽象 LibRaw_abstract_datastream 接口，支持文件、内存缓冲区、Windows 内存映射等不同输入源，并暴露 C 与 C++ 两套 API。",
        "evidence": [
          "libraw/libraw_datastream.h",
          "src/libraw_datastream.cpp",
          "src/libraw_c_api.cpp"
        ]
      },
      {
        "name": "可选扩展集成",
        "description": "通过条件编译集成 RawSpeed（加速解码）、Adobe DNG SDK（DNG/GPR 高级解析）以及 X3F 工具，用于提升特定格式支持。",
        "evidence": [
          "src/integration/rawspeed_glue.cpp",
          "src/integration/dngsdk_glue.cpp",
          "RawSpeed/rawspeed_xmldata.cpp"
        ]
      }
    ],
    "domain": "图像处理 / 数字摄影",
    "target_users": "需要读取或处理相机 RAW 文件的桌面/服务器应用开发者、图像处理库与工具链"
  },
