  "function_summary": {
    "summary": "liba52 是一个用 C 语言编写的免费 ATSC A/52（即 AC-3）音频解码库，广泛应用于数字电视与 DVD。它从 A/52 编码的比特流中解析音频帧、重建声道音频采样，并支持立体声/多声道下混输出。以高精度浮点（可选定点）实现全标准覆盖、跨架构 SIMD 加速，被 Xine/VideoLAN/MPlayer/ffmpeg/GStreamer 等大量媒体播放与处理项目集成。附带命令行测试工具 a52dec 支持原始 A/52 流与 MPEG-1/2 复用流解码。",
    "categories": [
      {
        "name": "A/52 比特流解析与帧同步",
        "description": "解析 ATSC A/52 比特流，完成帧同步、头部信息提取（采样率/码率/通道配置）、CRC 校验",
        "evidence": [
          "liba52/bitstream.c",
          "liba52/parse.c",
          "liba52/crc.c",
          "include/a52.h — a52_syncinfo/a52_crc"
        ]
      },
      {
        "name": "AC-3 音频解码",
        "description": "解码音频频谱数据——位分配、指数解包、IMDCT 逆变换、声道下混/上混，输出 float（或定点）多声道 PCM 采样",
        "evidence": [
          "liba52/bit_allocate.c",
          "liba52/imdct.c",
          "liba52/downmix.c",
          "liba52/parse.c",
          "liba52/a52_internal.h"
        ]
      },
      {
        "name": "跨架构性能加速",
        "description": "编译期自动检测并启用 x86(MMX/SSE2/SSE3/3DNOW) / PPC(Altivec) / SPARC(VIS) / Alpha(MVI) 的 SIMD 指令集加速，运行时 CPU 特性探测；保留 C 语言通用回退路径",
        "evidence": [
          "liba52/cpu_accel.c",
          "liba52/cpu_state.c",
          "liba52/imdct.c:413-427",
          "include/mmx.h"
        ]
      },
      {
        "name": "音频输出抽象层 (libao)",
        "description": "为命令行工具 a52dec 提供多平台音频输出——OSS(Linux/BSDs)、Solaris 音频、IRIX AL、Windows waveOut、WAV/AIFF 文件输出、null/peak/float 测试输出",
        "evidence": [
          "libao/audio_out_oss.c",
          "libao/audio_out_solaris.c",
          "libao/audio_out_al.c",
          "libao/audio_out_win.c",
          "libao/audio_out_wav.c",
          "libao/audio_out_aif.c",
          "libao/audio_out.c"
        ]
      },
      {
        "name": "动态范围压缩",
        "description": "支持 AC-3 规定的动态范围压缩，可由调用方自定义压缩回调",
        "evidence": [
          "include/a52.h — a52_dynrng",
          "liba52/parse.c"
        ]
      }
    ],
    "domain": "音频解码 / 媒体",
    "target_users": "多媒体播放器、音视频转码工具、流媒体框架的开发者",
    "ecosystem": "cpp"
  },
