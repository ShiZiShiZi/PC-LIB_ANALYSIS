  "function_summary": {
    "summary": "JDOM 是一个纯 Java 的 XML 处理库，提供直观的、基于 Java 集合和泛型的高层 API，用于读取、创建、导航、修改和序列化 XML 文档。它不包含原生解析器，而是通过 JAXP 适配底层 SAX/DOM 解析器（如 Xerces），将 XML 内容映射到 Java 对象模型（Document、Element、Attribute 等）。JDOM 支持 XPath 查询（通过 Jaxen）、XSLT 转换（通过 TrAX/JAXP）、命名空间管理以及多种输出格式（XML、HTML、Text），是 Java 生态中处理 XML 数据的基础库之一。",
    "categories": [
      {
        "name": "XML 文档解析与构建",
        "description": "通过 JAXP 接入底层 SAX/DOM XML 解析器，将 XML 字符串、文件、输入流解析为 JDOM 对象树（Document/Element）；也支持从 JDOM 模型反向构建 DOM。",
        "evidence": [
          "core/src/java/org/jdom2/input/SAXBuilder.java:142",
          "core/src/java/org/jdom2/input/DOMBuilder.java",
          "core/src/java/org/jdom2/input/StAXEventBuilder.java",
          "core/src/java/org/jdom2/input/StAXStreamBuilder.java"
        ]
      },
      {
        "name": "XML 文档对象模型操作",
        "description": "提供 Document、Element、Attribute、Text、CDATA、Comment、ProcessingInstruction、DocType、EntityRef 等完整的 XML 对象模型，支持增删改查、命名空间管理、内容筛选与过滤。",
        "evidence": [
          "core/src/java/org/jdom2/Document.java",
          "core/src/java/org/jdom2/Element.java",
          "core/src/java/org/jdom2/Attribute.java",
          "core/src/java/org/jdom2/Namespace.java",
          "core/src/java/org/jdom2/filter/"
        ]
      },
      {
        "name": "XPath 查询",
        "description": "通过 Jaxen 提供 XPath 表达式查询功能，支持从 JDOM 文档中按 XPath 选择节点，获取单值或多值结果。",
        "evidence": [
          "core/src/java/org/jdom2/xpath/XPath.java",
          "core/src/java/org/jdom2/xpath/jaxen/JDOMXPath.java",
          "core/src/java/org/jdom2/xpath/jaxen/JDOMCoreNavigator.java"
        ]
      },
      {
        "name": "XML 输出与序列化",
        "description": "支持将 JDOM 对象树输出为 XML、HTML、纯文本等格式，提供格式控制（缩进、换行、编码），可输出到 Writer、OutputStream、SAX 事件流或 DOM。",
        "evidence": [
          "core/src/java/org/jdom2/output/XMLOutputter.java",
          "core/src/java/org/jdom2/output/SAXOutputter.java",
          "core/src/java/org/jdom2/output/DOMOutputter.java",
          "core/src/java/org/jdom2/output/StAXStreamOutputter.java",
          "core/src/java/org/jdom2/output/StAXEventOutputter.java",
          "core/src/java/org/jdom2/output/Format.java"
        ]
      },
      {
        "name": "XSLT 转换",
        "description": "封装 JAXP TrAX (javax.xml.transform) 提供 XSLT 样式表转换功能，将 JDOM 文档经 XSLT 转换为其他 XML/文本格式。",
        "evidence": [
          "core/src/java/org/jdom2/transform/XSLTransformer.java",
          "core/src/java/org/jdom2/transform/JDOMSource.java",
          "core/src/java/org/jdom2/transform/JDOMResult.java"
        ]
      }
    ],
    "domain": "数据处理/XML",
    "target_users": "Java 开发者（需处理 XML 数据的应用与库）",
    "ecosystem": "java"
  },
