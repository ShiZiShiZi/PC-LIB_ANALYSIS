  "function_summary": {
    "summary": "JDOM2 是一个轻量级的 Java XML 处理库，提供直观的树形 API 来创建、解析、修改和序列化 XML 文档。它支持通过 SAX、StAX 和 DOM 等多种方式构建文档，内置 XPath 查询（可选用 Jaxen 或 JDK 内置引擎）和 XSLT 转换功能，并为输出提供灵活的格式化控制。JDOM2 面向需要在 Java 应用中高效处理 XML 数据的开发者，是 DOM 和 SAX 之外的简化替代方案。",
    "categories": [
      {
        "name": "XML 文档解析与构建",
        "description": "通过 SAXBuilder、StAXEventBuilder、StAXStreamBuilder、DOMBuilder 等多种构建器从不同来源（文件、流、URL）解析 XML 并生成 JDOM 树结构",
        "evidence": [
          "core/src/java/org/jdom2/input/SAXBuilder.java",
          "core/src/java/org/jdom2/input/StAXEventBuilder.java",
          "core/src/java/org/jdom2/input/StAXStreamBuilder.java",
          "core/src/java/org/jdom2/input/DOMBuilder.java"
        ]
      },
      {
        "name": "XML 文档输出与序列化",
        "description": "将 JDOM 文档树序列化为 XML 文本、SAX 事件、StAX 事件流或 DOM 节点，支持格式化输出（缩进、换行、编码控制）",
        "evidence": [
          "core/src/java/org/jdom2/output/XMLOutputter.java",
          "core/src/java/org/jdom2/output/SAXOutputter.java",
          "core/src/java/org/jdom2/output/StAXEventOutputter.java",
          "core/src/java/org/jdom2/output/DOMOutputter.java"
        ]
      },
      {
        "name": "XPath 查询",
        "description": "提供统一的 XPath 表达式接口，可选用 Jaxen 或 JDK 内置 XPath 引擎执行查询",
        "evidence": [
          "core/src/java/org/jdom2/xpath/XPath.java",
          "core/src/java/org/jdom2/xpath/jaxen/JaxenXPathFactory.java",
          "core/src/java/org/jdom2/xpath/XPathFactory.java"
        ]
      },
      {
        "name": "XSLT 转换",
        "description": "将 JDOM 文档作为 XSLT 转换的源和结果，封装了 javax.xml.transform 的集成",
        "evidence": [
          "core/src/java/org/jdom2/transform/XSLTransformer.java",
          "core/src/java/org/jdom2/transform/JDOMSource.java",
          "core/src/java/org/jdom2/transform/JDOMResult.java"
        ]
      },
      {
        "name": "文档过滤与内容遍历",
        "description": "提供灵活的 Filter 机制（按元素名、属性类型、内容类型等）和迭代器，对文档内容进行条件筛选与遍历",
        "evidence": [
          "core/src/java/org/jdom2/filter/Filters.java",
          "core/src/java/org/jdom2/filter/ElementFilter.java",
          "core/src/java/org/jdom2/filter/ContentFilter.java"
        ]
      },
      {
        "name": "扩展贡献模块",
        "description": "contrib 包提供 DOM 包装、ID 感知元素、ResultSet 构建、DTD 感知输出、Bean 映射等扩展功能",
        "evidence": [
          "contrib/src/java/org/jdom2/contrib/dom/JDocument.java",
          "contrib/src/java/org/jdom2/contrib/ids/IdFactory.java",
          "contrib/src/java/org/jdom2/contrib/input/ResultSetBuilder.java"
        ]
      }
    ],
    "domain": "XML 处理",
    "target_users": "需要在 Java 应用中解析、构建、查询和序列化 XML 文档的开发者"
  },
