  "function_summary": {
    "summary": "Xdelta 3 是一个 C 语言编写的二进制差分压缩库与命令行工具，实现 VCDIFF（RFC 3284）通用差分和数据压缩格式。它可基于源文件对目标文件生成大小最优的差分包（delta），也支持无源文件的简单数据压缩模式。该库风格类似 Zlib，提供流式编解码接口，适用于软件更新分发、增量备份、二进制补丁等场景。",
    "categories": [
      {
        "name": "VCDIFF 差分编码（delta压缩）",
        "description": "基于源文件（source）与目标文件（target）生成 VCDIFF 格式差分包，利用源端匹配减少输出大小。支持流式输入输出与任意源块读取回调。",
        "evidence": [
          "xdelta3/xdelta3.h:1116-1170 xd3_encode_memory/xd3_encode_stream/xd3_encode_input"
        ]
      },
      {
        "name": "VCDIFF 解码与还原",
        "description": "从差分包与源文件还原目标文件，支持流式解码、多窗口增量还原，可解码任意 VCDIFF 兼容流。",
        "evidence": [
          "xdelta3/xdelta3.h:1172-1224 xd3_decode_memory/xd3_decode_stream/xd3_decode_input"
        ]
      },
      {
        "name": "纯数据压缩（无源差）",
        "description": "在无源文件的情况下直接对目标文件进行 VCDIFF 压缩，利用目标内部的重复数据段进行匹配编码。",
        "evidence": [
          "xdelta3/xdelta3.c:20-22",
          "xdelta3/xdelta3.h:503-505 XD3_NOCOMPRESS"
        ]
      },
      {
        "name": "二级压缩（secondary compression）",
        "description": "对 VCDIFF 的 data/inst/addr 三个段可选再应用 Huffman（DJW 静态/FGK 自适应）或 LZMA 压缩，进一步减小体积。",
        "evidence": [
          "xdelta3/xdelta3-djw.h",
          "xdelta3/xdelta3-fgk.h",
          "xdelta3/xdelta3-lzma.h",
          "xdelta3/xdelta3-main.h:1303-1381"
        ]
      },
      {
        "name": "外部压缩支持（external compression）",
        "description": "自动检测并透明调用外部压缩工具（bzip2、gzip、compress、xz）对输入解压/输出再压缩，兼容管道模式。仅 POSIX 平台支持。",
        "evidence": [
          "xdelta3/xdelta3-main.h:411-424 extcomp_types",
          "xdelta3/xdelta3-main.h:2135-2610"
        ]
      },
      {
        "name": "Armor 模式（整文件校验）",
        "description": "在差分包 VCDIFF 应用头中嵌入源/目标文件的 BLAKE3 摘要，解码时自动校验源文件与还原目标，防止用错源文件。",
        "evidence": [
          "xdelta3/xdelta3-main.h:86-104 XD3_ARMOR",
          "xdelta3/xdelta3-main.h:1280-1288"
        ]
      },
      {
        "name": "VCDIFF 工具（打印/合并/重编码）",
        "description": "支持打印 VCDIFF 流结构（printhdr/printdelta）、合并多层差分包（merge）、以及差分包重编码（recode）。",
        "evidence": [
          "xdelta3/xdelta3-main.h:183-199 xd3_cmd enum",
          "xdelta3/xdelta3-merge.h"
        ]
      }
    ],
    "domain": "数据压缩与差分",
    "target_users": "需要差分更新/增量备份/二进制补丁的应用程序开发者与运维用户",
    "ecosystem": "cpp"
  },
