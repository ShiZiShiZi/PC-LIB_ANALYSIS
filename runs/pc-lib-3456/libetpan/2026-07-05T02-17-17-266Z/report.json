  "function_summary": {
    "summary": "libEtPan 是一个跨平台 C 语言邮件库，为应用程序提供统一的接口来收发邮件和管理邮件存储。它封装了 IMAP、SMTP、POP3、NNTP 等网络邮件协议的低层细节，同时内置 RFC822/MIME 消息解析与构建、maildir / mbox / MH 本地邮件存储格式的读写支持，以及 S/MIME 和 PGP 签名/加密的消息隐私引擎。适用于需要集成邮件收发、解析或存储功能的所有桌面、移动端（macOS/iOS/Android/Windows）或服务端 C/C++ 应用开发者。",
    "categories": [
      {
        "name": "网络邮件协议客户端",
        "description": "提供 IMAP4rev1、SMTP、POP3、NNTP 协议的低层客户端实现，支持连接管理、命令发送与响应解析。",
        "evidence": [
          "src/low-level/imap/",
          "src/low-level/smtp/",
          "src/low-level/pop3/",
          "src/low-level/nntp/"
        ]
      },
      {
        "name": "邮件解析与构建（RFC822/MIME）",
        "description": "完整的 RFC 822 消息头与 MIME 多部分消息解析与构建引擎，支持附件、编码传输、字符集转换。",
        "evidence": [
          "src/low-level/imf/",
          "src/low-level/mime/",
          "src/data-types/charconv.c"
        ]
      },
      {
        "name": "本地邮件存储格式支持",
        "description": "支持 maildir、mbox、MH 及 Berkeley DB/LMDB 缓存存储格式的读写与管理，提供统一的消息和文件夹抽象接口。",
        "evidence": [
          "src/low-level/maildir/",
          "src/low-level/mbox/",
          "src/low-level/mh/",
          "src/driver/implementation/maildir/",
          "src/driver/implementation/mbox/",
          "src/driver/implementation/mh/",
          "src/data-types/mail_cache_db.c",
          "src/data-types/mail_cache_lmdb.c"
        ]
      },
      {
        "name": "消息隐私与加密引擎",
        "description": "支持 S/MIME 和 PGP (GnuPG) 签名/加密的消息隐私处理引擎，可对邮件进行签名验证、解密和加密。",
        "evidence": [
          "src/engine/mailprivacy.c",
          "src/engine/mailprivacy_gnupg.c",
          "src/engine/mailprivacy_smime.c",
          "src/engine/mailprivacy_tools.c"
        ]
      },
      {
        "name": "传输层抽象与安全",
        "description": "提供 socket、CFStream（macOS/iOS）等多传输层后端抽象，支持 OpenSSL / GnuTLS 加密和 zlib 传输压缩。",
        "evidence": [
          "src/data-types/mailstream.c",
          "src/data-types/mailstream_socket.c",
          "src/data-types/mailstream_cfstream.c",
          "src/data-types/mailstream_ssl.c",
          "src/data-types/mailstream_compress.c",
          "src/data-types/mailstream_low.c"
        ]
      },
      {
        "name": "订阅与 Feed 支持",
        "description": "提供 Hotmail 协议驱动和 RSS/Atom Feed 驱动的订阅与读取支持。",
        "evidence": [
          "src/driver/implementation/hotmail/",
          "src/low-level/feed/",
          "src/driver/implementation/feed/"
        ]
      }
    ],
    "domain": "networking/email",
    "target_users": "C/C++ 邮件客户端、邮件服务器、移动邮件应用开发者"
  },
