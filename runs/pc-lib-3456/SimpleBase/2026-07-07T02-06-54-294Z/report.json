  "function_summary": {
    "summary": "SimpleBase 是一个 .NET 多进制编码/解码库，提供 Base2、Base8、Base10、Base16、Base32（含 Crockford/RFC4648/Bech32/z-base-32/Geohash/FileCoin/ExtendedHex 等多种变体）、Base36、Base45、Base58（Bitcoin/Ripple/Monero/Flickr，含 Base58Check 与 CB58）、Base62、Base85（Ascii85/Z85，含 IPv6 编码）、Base256 Emoji 以及 Multibase 统一接口的编码与解码功能。同时提供一次性内存缓冲区 API 与基于流的异步 API，支持大端序 CPU（如 IBM s390x），线程安全且无外部依赖。",
    "categories": [
      {
        "name": "二进制/八进制/十进制编码",
        "description": "Base2（二进制字符串）、Base8（八进制字符串）和 Base10（十进制数字字符串）的编码与解码。",
        "evidence": [
          "src/Base2.cs",
          "src/Base8.cs",
          "src/Base10.cs"
        ]
      },
      {
        "name": "十六进制编码",
        "description": "Base16 编码/解码，支持大写、小写和 ModHex（Yubico）三种字母表，并提供流式与异步接口。",
        "evidence": [
          "src/Base16.cs",
          "src/Base16Alphabet.cs"
        ]
      },
      {
        "name": "Base32 编码",
        "description": "Base32 编码/解码，涵盖 RFC4648、Crockford（含字符替换）、z-base-32、Geohash、FileCoin、Bech32、ExtendedHex、Base32H 等多种字母表变体，支持数字编码（ulong/int64）。",
        "evidence": [
          "src/Base32.cs",
          "src/Base32Alphabet.cs",
          "src/AliasedBase32Alphabet.cs"
        ]
      },
      {
        "name": "Base36/Base45 编码",
        "description": "Base36（大小写字母表）和 Base45（RFC 9285）编码与解码。",
        "evidence": [
          "src/Base36.cs",
          "src/Base36Alphabet.cs",
          "src/Base45.cs",
          "src/Base45Alphabet.cs"
        ]
      },
      {
        "name": "Base58 编码与校验",
        "description": "Base58 编码/解码，支持 Bitcoin、Ripple、Monero、Flickr 字母表；提供 Base58Check（双 SHA256 校验和）和 Avalanche CB58 编码辅助方法。",
        "evidence": [
          "src/Base58.cs",
          "src/Base58Alphabet.cs",
          "src/MoneroBase58.cs",
          "src/Sha256.cs"
        ]
      },
      {
        "name": "Base62/Base85 编码",
        "description": "Base62 编码/解码以及 Base85 编码/解码（Ascii85、Z85、RFC1924 自定义字母表），含 IPv6 地址编码支持。",
        "evidence": [
          "src/Base62.cs",
          "src/Base85.cs",
          "src/Base85Alphabet.cs",
          "src/Base85Ipv6.cs"
        ]
      },
      {
        "name": "Multibase 统一接口",
        "description": "实现 Multibase 规范的统一编码/解码入口，通过前缀字符自动选择对应编码方案（Base2–Base256Emoji，含 Base64 多种变体）。",
        "evidence": [
          "src/Multibase.cs",
          "src/MultibaseEncoding.cs",
          "src/Base64.cs"
        ]
      }
    ],
    "domain": "数据编码",
    "target_users": ".NET 应用开发者（需要非标准进制编码/解码的场景，如区块链地址、IPFS/Multibase、二维码等）"
  },
