  "function_summary": {
    "summary": "TinyXML-2 是一个为 C++ 程序设计的轻量级 XML 解析库。它将 XML 文档解析为内存中的 DOM（文档对象模型），支持读取、修改、保存以及从代码中直接构造 XML 并输出。库本身仅由一个头文件 tinyxml2.h 和一个源文件 tinyxml2.cpp 组成，不依赖 C++ 标准库容器，也不使用异常或 RTTI，便于嵌入到游戏、工具或其他 C++ 项目中。",
    "categories": [
      {
        "name": "XML 文档解析与加载",
        "description": "从文件路径、FILE* 或字符缓冲区解析 XML，并返回 XMLError 错误码；支持 UTF-8 与 BOM 检测。",
        "evidence": [
          "tinyxml2.h:1715 XMLDocument",
          "tinyxml2.h:1749 Parse",
          "tinyxml2.h:1756 LoadFile",
          "tinyxml2.cpp:2361 LoadFile(const char*)"
        ]
      },
      {
        "name": "DOM 构建与节点操作",
        "description": "以 XMLDocument 为拥有者构建 DOM，提供 XMLElement、XMLText、XMLComment、XMLDeclaration、XMLUnknown 等节点类型，支持父子/兄弟遍历、插入、删除与浅克隆。",
        "evidence": [
          "tinyxml2.h:666 XMLNode",
          "tinyxml2.h:1262 XMLElement",
          "tinyxml2.h:989 XMLText",
          "tinyxml2.cpp:2230 XMLDocument::Clear"
        ]
      },
      {
        "name": "XML 序列化与输出",
        "description": "将 DOM 保存到文件或 FILE*，或通过 XMLPrinter 输出到内存/流；XMLPrinter 也支持不构造 DOM 直接流式写入元素与属性。",
        "evidence": [
          "tinyxml2.h:1776 SaveFile",
          "tinyxml2.h:1842 Print",
          "tinyxml2.h:2100 XMLPrinter",
          "tinyxml2.cpp:2433 SaveFile(const char*, bool)"
        ]
      },
      {
        "name": "属性类型查询与设置",
        "description": "在元素上按名称读写属性，并支持 int、unsigned、int64、uint64、bool、double、float、string 等类型的查询与转换。",
        "evidence": [
          "tinyxml2.h:1138 XMLAttribute",
          "tinyxml2.h:1207 QueryIntValue",
          "tinyxml2.h:1306 XMLElement::Attribute",
          "tinyxml2.h:1328 QueryIntAttribute"
        ]
      },
      {
        "name": "内存与字符串管理",
        "description": "内部使用 DynArray、MemPoolT 等轻量级数据结构，并通过 StrPair 管理字符串生命周期；节点内存由 XMLDocument 统一拥有。",
        "evidence": [
          "tinyxml2.h:130 StrPair",
          "tinyxml2.h:199 DynArray",
          "tinyxml2.h:322 MemPool",
          "tinyxml2.h:339 MemPoolT"
        ]
      }
    ],
    "domain": "data",
    "target_users": "需要在 C/C++ 项目中嵌入 XML 解析/序列化能力的应用开发者、游戏引擎或工具库开发者"
  },
