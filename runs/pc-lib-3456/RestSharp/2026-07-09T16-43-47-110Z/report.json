  "function_summary": {
    "summary": "RestSharp 是一个轻量级的 .NET HTTP API 客户端库，封装了 System.Net.Http.HttpClient，为 RESTful API 调用提供便捷的请求构建、序列化/反序列化、认证管理和响应处理功能。它简化了 JSON、XML、CSV 等多种数据格式的自动序列化，支持 URL 查询参数、请求体、Header、Cookie 等多种参数方式，并提供 Basic、OAuth1、OAuth2、JWT 等多种认证方案。广泛应用于 .NET 生态中需要调用 REST API 的后端服务、桌面应用和移动应用场景，帮助开发者用最少的代码完成 HTTP 请求。",
    "categories": [
      {
        "name": "HTTP 请求构建与发送",
        "description": "封装 HttpClient 提供同步和异步 HTTP 请求，支持 GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS 等标准方法，可灵活添加查询参数、URL 段、Header、Cookie、请求体等多种参数类型",
        "evidence": [
          "src/RestSharp/RestClient.cs",
          "src/RestSharp/RestClient.Async.cs",
          "src/RestSharp/RestClient.Extensions.Get.cs",
          "src/RestSharp/RestClient.Extensions.Post.cs"
        ]
      },
      {
        "name": "序列化与反序列化",
        "description": "内置 System.Text.Json 和基础 XML 序列化器，支持 JSON、XML、CSV 三种格式的自动序列化/反序列化，并允许用户注册自定义序列化器",
        "evidence": [
          "src/RestSharp/Serializers/Json/SystemTextJsonSerializer.cs",
          "src/RestSharp/Serializers/Xml/DotNetXmlSerializer.cs",
          "src/RestSharp/Serializers/IRestSerializer.cs"
        ]
      },
      {
        "name": "多种认证方案支持",
        "description": "内置 Basic、OAuth1、OAuth2、JWT 等多种 HTTP 认证方案的自动处理，包括令牌获取与刷新机制",
        "evidence": [
          "src/RestSharp/Authenticators/HttpBasicAuthenticator.cs",
          "src/RestSharp/Authenticators/JwtAuthenticator.cs",
          "src/RestSharp/Authenticators/OAuth/",
          "src/RestSharp/Authenticators/OAuth2/"
        ]
      },
      {
        "name": "请求拦截与中间件",
        "description": "提供请求/响应拦截器机制，可在请求发送前后注入自定义逻辑",
        "evidence": [
          "src/RestSharp/Interceptors/Interceptor.cs"
        ]
      }
    ],
    "domain": "HTTP 客户端 / REST API 调用",
    "target_users": ".NET 开发者，包括后端服务开发者、桌面应用开发者、移动应用开发者，需要在 C# 中方便地调用 RESTful API"
  },
