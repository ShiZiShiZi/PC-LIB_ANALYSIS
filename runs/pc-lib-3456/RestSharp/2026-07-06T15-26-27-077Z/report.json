  "function_summary": {
    "summary": "RestSharp 是一个面向 .NET 平台的轻量级 HTTP/REST API 客户端库，封装了 System.Net.Http.HttpClient，为 HTTP 请求的构建、发送与响应处理提供更高级的抽象。核心功能包括请求参数管理（查询、URL 片段、请求头、请求体）、多种内容类型的序列化/反序列化（JSON/XML/CSV）、丰富的认证机制（HTTP Basic、OAuth1/2、JWT）、请求/响应拦截器、自动重定向、Cookie 管理以及依赖注入集成。该库面向 .NET 生态开发者，显著简化了 REST API 调用的编码工作。",
    "categories": [
      {
        "name": "HTTP 请求构建与发送",
        "description": "封装 HttpClient，提供请求参数（查询、URL 片段、请求头、请求体）管理、HTTP 方法扩展（GET/POST/PUT/DELETE/PATCH 等）、多部分表单数据与文件上传、自动重定向与 Cookie 处理",
        "evidence": [
          "src/RestSharp/RestClient.cs",
          "src/RestSharp/RestClient.Async.cs",
          "src/RestSharp/Request/RestRequest.cs",
          "src/RestSharp/Request/RequestContent.cs",
          "src/RestSharp/Request/RequestHeaders.cs"
        ]
      },
      {
        "name": "序列化与反序列化",
        "description": "内置 JSON（System.Text.Json）、XML、CSV 序列化器，支持自定义序列化器注册；提供 Newtonsoft.Json、CsvHelper 及扩展 XML 序列化子包",
        "evidence": [
          "src/RestSharp/Serializers/Json/SystemTextJsonSerializer.cs",
          "src/RestSharp/Serializers/Xml/XmlRestSerializer.cs",
          "src/RestSharp.Serializers.NewtonsoftJson/JsonNetSerializer.cs",
          "src/RestSharp.Serializers.CsvHelper/CsvHelperSerializer.cs"
        ]
      },
      {
        "name": "认证机制",
        "description": "支持 HTTP Basic、OAuth1/2、JWT 认证，以及 OAuth2 令牌刷新与客户端凭据认证；可自定义认证器接口",
        "evidence": [
          "src/RestSharp/Authenticators/HttpBasicAuthenticator.cs",
          "src/RestSharp/Authenticators/JwtAuthenticator.cs",
          "src/RestSharp/Authenticators/OAuth/OAuth1Authenticator.cs",
          "src/RestSharp/Authenticators/OAuth2/OAuth2ClientCredentialsAuthenticator.cs",
          "src/RestSharp/Authenticators/OAuth2/OAuth2RefreshTokenAuthenticator.cs"
        ]
      },
      {
        "name": "请求拦截与生命周期管理",
        "description": "提供请求/响应拦截器接口，支持在请求发送前和响应返回后插入自定义逻辑；支持兼容旧版拦截器",
        "evidence": [
          "src/RestSharp/Interceptors/Interceptor.cs",
          "src/RestSharp/Interceptors/CompatibilityInterceptor.cs"
        ]
      },
      {
        "name": "依赖注入集成",
        "description": "提供 Microsoft.Extensions.Http 集成，支持通过 IHttpClientFactory 和依赖注入容器管理 RestClient 生命周期",
        "evidence": [
          "src/RestSharp.Extensions.DependencyInjection/ServiceCollectionExtensions.cs",
          "src/RestSharp.Extensions.DependencyInjection/DefaultRestClientFactory.cs",
          "src/RestSharp.Extensions.DependencyInjection/IRestClientFactory.cs"
        ]
      }
    ],
    "domain": "networking",
    "target_users": ".NET 应用开发者",
    "ecosystem": "dotnet"
  },
