  "function_summary": {
    "summary": "libunwind 是一个可移植的 C 语言回调栈回溯库，支持对 ELF 程序线程执行调用链进行确定性回溯，并可在调用链任意点恢复执行。提供本地（同进程）与远程（其他进程，基于 ptrace）两种操作模式，覆盖 Linux、FreeBSD、QNX、Solaris、HP-UX 等 Unix-like 系统以及 Windows（远程模式）。同时提供 Itanium C++ ABI 异常处理替代实现、setjmp/longjmp 替代方案，以及 coredump 事后分析能力。核心用户为语言运行时（如 C++ 异常处理）、调试器、性能分析器、崩溃报告工具等系统级工具开发者。",
    "categories": [
      {
        "name": "调用链回溯(Unwinding)",
        "description": "基于 DWARF/ARM EXIDX/IA-64 等调试信息格式，逐帧回溯线程调用栈，获取每帧的 IP、寄存器状态、过程名称等信息。支持按需缓存策略（全局/每线程/无缓存）。",
        "evidence": [
          "src/mi/backtrace.c",
          "src/dwarf/Gparser.c",
          "src/dwarf/Gfind_proc_info-lsb.c",
          "src/ia64/Gscript.c",
          "include/libunwind.h.in"
        ]
      },
      {
        "name": "寄存器状态读写",
        "description": "读取与修改任意栈帧的通用寄存器、浮点寄存器值与过程状态，支持恢复执行点为调用链中任意位置。",
        "evidence": [
          "src/mi/Gget_reg.c",
          "src/mi/Gset_reg.c",
          "src/mi/Gget_fpreg.c",
          "src/mi/Gset_fpreg.c",
          "include/libunwind-common.h.in"
        ]
      },
      {
        "name": "远程进程回溯(Remote Unwinding)",
        "description": "通过 ptrace 接口或自定义访问器回调，对另一进程进行调用栈分析，是调试器与性能分析工具的基础能力。支持 Linux ptrace 与 FreeBSD PT_IO 等平台后端。",
        "evidence": [
          "src/ptrace/_UPT_access_mem.c",
          "src/ptrace/_UPT_access_reg.c",
          "src/ptrace/_UPT_create.c",
          "src/ptrace/_UPT_resume.c",
          "include/libunwind-ptrace.h"
        ]
      },
      {
        "name": "Coredump 事后分析",
        "description": "对 ELF coredump 文件进行离线调用栈回溯，解析 coredump 的 NOTE 段线程信息与内存映射，支持 Linux、FreeBSD、QNX 三种 coredump 格式。",
        "evidence": [
          "src/coredump/_UCD_create.c",
          "src/coredump/_UCD_get_mapinfo_linux.c",
          "src/coredump/_UCD_get_mapinfo_qnx.c",
          "src/coredump/_UCD_access_reg_linux.c",
          "include/libunwind-coredump.h"
        ]
      },
      {
        "name": "C++ 异常处理 ABI 替代",
        "description": "可选提供 Itanium C++ ABI 的 _Unwind_* 系列函数替代实现（RaiseException、Resume、ForcedUnwind 等），可作为系统 libgcc_s/libgcc 异常处理运行时的一部分。",
        "evidence": [
          "src/unwind/Resume.c",
          "src/unwind/RaiseException.c",
          "src/unwind/ForcedUnwind.c",
          "src/unwind/Backtrace.c"
        ]
      },
      {
        "name": "setjmp/longjmp 替代",
        "description": "可选提供标准 C 库 setjmp()/longjmp() 以及 sigsetjmp()/siglongjmp() 的替代实现，基于 unwinding 机制实现非局部跳转。",
        "evidence": [
          "src/setjmp/setjmp.c",
          "src/setjmp/longjmp.c",
          "src/setjmp/sigsetjmp.c",
          "src/setjmp/siglongjmp.c"
        ]
      },
      {
        "name": "动态 unwind 信息注册",
        "description": "支持运行时动态注册与注销 unwind 信息（如 JIT 编译器生成的代码），使动态生成的代码也能被回溯。",
        "evidence": [
          "src/mi/dyn-register.c",
          "src/mi/dyn-cancel.c",
          "src/mi/Gdyn-extract.c",
          "src/mi/Gdyn-remote.c"
        ]
      }
    ],
    "domain": "系统编程/运行时基础设施",
    "target_users": "语言运行时开发者、调试器/性能分析器/崩溃报告工具开发者、系统级工具链开发者"
  },
