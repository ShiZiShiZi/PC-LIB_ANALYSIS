  "native_api": {
    "summary": "ncurses 是重度依赖 POSIX 终端接口的 C 库。核心通过 termios(tcgetattr/tcsetattr) 和 ioctl(TIOCGWINSZ 等)与终端驱动交互；文件 I/O、信号、环境变量读取均为标准/ POSIX API。Windows 专有代码仅在 win32con 驱动与少量 _WIN32 守卫中，占生产代码比例极小(约 26 行)。",
    "groups": [
      {
        "type": "c_stdlib",
        "category": "standard",
        "platform": "portable",
        "apis": [
          {
            "name": "malloc/free",
            "purpose": "堆内存分配与释放",
            "count": 20,
            "evidence": [
              "ncurses/tinfo/doalloc.c",
              "ncurses/tinfo/alloc_entry.c"
            ]
          },
          {
            "name": "fopen/fclose/fread/fwrite",
            "purpose": "标准流式文件读写",
            "count": 15,
