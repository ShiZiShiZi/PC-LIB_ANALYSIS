  "function_summary": {
    "summary": "ncurses 是 POSIX/Unix 系统上最广泛使用的字符终端 UI 库，提供与 System V curses 兼容的 API。它抽象了不同终端的能力差异，使 C/C++ 程序能够以可移植方式绘制窗口、处理键盘/鼠标输入、管理颜色和表单/菜单/面板等高级控件。库的核心依赖 terminfo/termcap 终端描述数据库，通过 POSIX termios/ioctl 与终端驱动交互；同时附带 tic、infocmp、tput、clear、tset 等命令行工具。",
    "categories": [
      {
        "name": "终端字符界面绘制",
        "description": "提供 move、addch、addstr、box、hline、vline、refresh 等 API，在字符终端上绘制边框、线条、文本并刷新屏幕。",
        "evidence": [
          "ncurses/base/lib_addch.c",
          "ncurses/base/lib_box.c",
          "ncurses/base/lib_refresh.c",
          "ncurses/tty/tty_update.c"
        ]
      },
      {
        "name": "窗口与子窗口管理",
        "description": "管理 stdscr、子窗口、pad、覆盖层(overlay)的创建、移动、复制与销毁，并支持重叠窗口的刷新。",
        "evidence": [
          "ncurses/base/lib_newwin.c",
          "ncurses/base/lib_pad.c",
          "ncurses/base/lib_overlay.c",
          "panel/"
        ]
      },
      {
        "name": "键盘与鼠标输入处理",
        "description": "读取键盘输入(getch/getstr)、支持功能键与自定义键绑定、处理鼠标事件及 raw/cbreak/echo 等输入模式。",
        "evidence": [
          "ncurses/base/lib_getch.c",
          "ncurses/base/lib_getstr.c",
          "ncurses/base/define_key.c",
          "ncurses/base/lib_mouse.c"
        ]
      },
      {
        "name": "颜色与视频属性控制",
        "description": "提供颜色对(pair)、前景/背景色、高亮、下划线、反显等属性的启用与组合，以及默认颜色假设。",
        "evidence": [
          "ncurses/base/lib_color.c",
          "ncurses/base/lib_chgat.c",
          "ncurses/base/lib_dft_fgbg.c"
        ]
      },
      {
        "name": "terminfo/termcap 终端能力数据库",
        "description": "维护终端能力描述数据库的编译(tic)、读取、写入、匹配与回退(TERMINFO/TERMCAP)，为上层 API 屏蔽终端差异。",
        "evidence": [
          "ncurses/tinfo/read_entry.c",
          "ncurses/tinfo/write_entry.c",
          "ncurses/tinfo/lib_tputs.c",
          "ncurses/tinfo/lib_setup.c",
          "progs/tic.c"
        ]
      },
      {
        "name": "表单、菜单与面板高级控件",
        "description": "在 curses 基础上提供表单(form)、菜单(menu)、面板(panel)的域/项/层叠管理，用于构建交互式 TUI 应用。",
        "evidence": [
          "form/",
          "menu/",
          "panel/"
        ]
      },
      {
        "name": "多语言绑定与配套工具",
        "description": "提供 C++ 类封装(cursesw/cursesp/cursesm/cursesf)和 Ada95 绑定；同时附带 tic、infocmp、tput、clear、tset 等命令行工具。",
        "evidence": [
          "c++/cursesw.h",
          "Ada95/src/terminal_interface-curses.ads",
          "progs/"
        ]
      }
    ],
    "domain": "terminal ui / text user interface",
    "target_users": "C/C++/Ada 终端应用与 TUI 框架开发者，以及依赖字符界面工具的终端用户"
  },
