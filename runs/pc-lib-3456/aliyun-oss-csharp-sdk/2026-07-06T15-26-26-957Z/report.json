  "function_summary": {
    "summary": "阿里云对象存储服务（OSS）的官方 C# SDK，封装了 OSS REST API，为 .NET 开发者提供 Bucket 创建/删除/列举、Object 上传/下载/复制/删除、Multipart Upload 分块上传、Resumable Upload/Download 断点续传、STS 临时凭证签名、访问控制（ACL/CORS/Referer/Lifecycle/Worm）、LiveChannel 直播频道管理等全生命周期操作接口。核心入口为 OssClient 类，支持 .NET Framework 2.0+ 与 .NET Standard 2.0（.NET Core 2.0+）双目标框架。",
    "categories": [
      {
        "name": "Bucket 生命周期管理",
        "description": "Bucket 的创建、删除、列举、元数据获取、存储容量查询、区域定位等操作",
        "evidence": [
          "sdk/Commands/CreateBucketCommand.cs",
          "sdk/Commands/DeleteBucketCommand.cs",
          "sdk/Commands/ListBucketsCommand.cs",
          "sdk/Commands/GetBucketInfoCommand.cs"
        ]
      },
      {
        "name": "Object 存取与操作",
        "description": "Object 的上传（Put/Append）、下载（Get/Range）、复制、删除（单个/批量）、元数据读写、软链接、标签等操作",
        "evidence": [
          "sdk/Commands/PutObjectCommand.cs",
          "sdk/Commands/GetObjectCommand.cs",
          "sdk/Commands/CopyObjectCommand.cs",
          "sdk/Commands/DeleteObjectsCommand.cs"
        ]
      },
      {
        "name": "Multipart Upload 分块上传",
        "description": "大文件分块上传的完整流程：初始化、上传分块、复制分块、完成/中止分块上传",
        "evidence": [
          "sdk/Commands/InitiateMultipartUploadCommand.cs",
          "sdk/Commands/UploadPartCommand.cs",
          "sdk/Commands/UploadPartCopyCommand.cs",
          "sdk/Commands/CompleteMultipartUploadCommand.cs"
        ]
      },
      {
        "name": "断点续传",
        "description": "大文件的断点续传上传（ResumableUpload）与下载（ResumableDownload），含进度回调与断点恢复",
        "evidence": [
          "sdk/Common/ResumableUploadManager.cs",
          "sdk/Common/ResumableDownloadManager.cs",
          "sdk/Domain/DownloadObjectRequest.cs"
        ]
      },
      {
        "name": "访问控制与安全",
        "description": "Bucket/Object ACL、CORS 跨域、Referer 防盗链、服务端加密、Worm 合规保留、策略（Policy）、版本控制等安全相关配置",
        "evidence": [
          "sdk/Commands/SetBucketAclCommand.cs",
          "sdk/Commands/SetBucketCorsCommand.cs",
          "sdk/Commands/SetBucketRefererCommand.cs",
          "sdk/Commands/SetBucketEncryptionCommand.cs"
        ]
      },
      {
        "name": "签名与鉴权",
        "description": "基于 HMAC-SHA1/V1 和 V4 签名版本的请求签名、STS 临时安全令牌、预签名 URL 生成",
        "evidence": [
          "sdk/Common/Authentication/HmacSHA1Signature.cs",
          "sdk/Util/OssRequestSignerV1.cs",
          "sdk/Util/OssRequestSignerV4.cs",
          "sdk/Domain/GeneratePresignedUriRequest.cs"
        ]
      },
      {
        "name": "HTTP 通信与容错",
        "description": "基于 HttpWebRequest 的 HTTP 客户端实现、自动重试、CRC64/MD5 校验、错误响应处理、User-Agent 构造",
        "evidence": [
          "sdk/Common/Communication/ServiceClientImpl.cs",
          "sdk/Common/Communication/RetryableServiceClient.cs",
          "sdk/Common/Handlers/Crc64CheckHandler.cs",
          "sdk/Common/Handlers/ErrorResponseHandler.cs"
        ]
      }
    ],
