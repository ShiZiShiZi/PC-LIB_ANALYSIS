  "function_summary": {
    "summary": "MariaDB Connector/C 是一个 LGPL 协议的 C/C++ 客户端库，用于通过 TCP/Unix socket 或 Windows named pipe 连接 MariaDB/MySQL 数据库服务器。它向上层应用提供连接生命周期管理、SQL 执行、预处理语句、异步/非阻塞 I/O、TLS 加密、认证与压缩插件、动态列以及 binlog 读取等能力，常被数据库驱动、中间件和命令行工具集成。",
    "categories": [
      {
        "name": "数据库连接管理",
        "description": "初始化、建立/断开连接、重连、字符集协商与连接选项设置。",
        "evidence": [
          "include/mysql.h",
          "libmariadb/mariadb_lib.c:1526",
          "libmariadb/mariadb_lib.c:1814"
        ]
      },
      {
        "name": "SQL 执行与结果处理",
        "description": "发送 SQL、获取结果集、遍历行、元数据查询及事务控制。",
        "evidence": [
          "include/mysql.h",
          "libmariadb/mariadb_lib.c",
          "include/mariadb_com.h"
        ]
      },
      {
        "name": "预处理语句（Prepared Statements）",
        "description": "准备语句、参数绑定、批量操作、执行与结果获取。",
        "evidence": [
          "include/mariadb_stmt.h",
          "libmariadb/mariadb_stmt.c"
        ]
      },
      {
        "name": "异步/非阻塞 I/O",
        "description": "基于 async_context 的非阻塞连接、读/写与等待，避免同步阻塞。",
        "evidence": [
          "include/mariadb_async.h",
          "libmariadb/mariadb_async.c:86"
        ]
      },
      {
        "name": "TLS/SSL 安全连接",
        "description": "通过 OpenSSL、GnuTLS 或 Windows Schannel 实现加密握手与通道。",
        "evidence": [
          "libmariadb/secure/openssl.c",
          "libmariadb/secure/gnutls.c",
          "libmariadb/secure/schannel.c",
          "include/ma_tls.h"
        ]
      },
      {
        "name": "认证插件",
        "description": "原生密码、dialog、sha256、caching_sha2、ed25519、GSSAPI/SSPI 等可插拔认证。",
        "evidence": [
          "plugins/auth/CMakeLists.txt",
          "plugins/auth/*.c",
          "include/mysql/client_plugin.h"
        ]
      },
      {
        "name": "压缩与远程 IO 插件",
        "description": "zlib/zstd 协议压缩，以及基于 libcurl 的远程文件访问插件。",
        "evidence": [
          "plugins/compress/CMakeLists.txt",
          "plugins/compress/c_zlib.c",
          "plugins/compress/c_zstd.c",
          "plugins/io/remote_io.c"
        ]
      },
      {
        "name": "动态列（Dynamic Columns）",
        "description": "MariaDB 动态列的编码、解码、更新与查询 API。",
        "evidence": [
          "include/mariadb_dyncol.h",
          "libmariadb/mariadb_dyncol.c"
        ]
      },
      {
        "name": "复制/binlog 读取",
        "description": "客户端读取 MariaDB 二进制日志事件（mariadb_rpl API）。",
        "evidence": [
          "include/mariadb_rpl.h",
          "libmariadb/mariadb_rpl.c"
        ]
      }
    ],
