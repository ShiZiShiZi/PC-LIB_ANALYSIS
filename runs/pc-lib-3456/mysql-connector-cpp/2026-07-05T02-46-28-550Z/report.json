  "function_summary": {
    "summary": "MySQL Connector/C++ 是 Oracle 官方提供的 C++ 数据库连接器，供 C/C++ 应用程序通过 X DevAPI（面向文档/关系型混合操作）或传统 JDBC 风格 API 连接并操作 MySQL 服务器。支持连接池、TLS/SSL 加密、多种认证方式（SHA256/PAM/Kerberos 等）、DNS SRV 服务发现、多主机故障转移及压缩传输。主要由 CDK（连接开发工具包）底层协议栈、devapi（C++ X DevAPI）、xapi（C 语言 X DevAPI）三层组成，可选构建 JDBC 遗留兼容层。",
    "categories": [
      {
        "name": "MySQL 数据库连接与会话管理",
        "description": "支持基于 URL 或配置选项创建 MySQL 会话，含连接池、多主机故障转移、DNS SRV 服务发现、超时控制与会话状态检查。",
        "evidence": [
          "include/mysqlx/xdevapi.h",
          "include/mysqlx/xapi.h",
          "include/mysqlx/common/settings.h",
          "devapi/session.cc",
          "common/session.cc"
        ]
      },
      {
        "name": "文档型数据库操作 (CRUD for Collections)",
        "description": "实现 X DevAPI 的 Collection 增删改查——文档插入(find/add/remove/modify)、JSON 投影、排序/分页/聚合。",
        "evidence": [
          "include/mysqlx/xdevapi.h",
          "include/mysqlx/xapi.h",
          "devapi/crud.cc",
          "xapi/crud.cc",
          "common/collection.cc"
        ]
      },
      {
        "name": "关系型表操作 (CRUD for Tables)",
        "description": "实现 X DevAPI 的 Table 增删改查——SQL SELECT/INSERT/UPDATE/DELETE、WHERE/Having/ORDER BY/LIMIT、参数化绑定。",
        "evidence": [
          "include/mysqlx/xdevapi.h",
          "include/mysqlx/xapi.h",
          "xapi/crud.cc",
          "common/op_impl.h"
        ]
      },
      {
        "name": "事务与保存点管理",
        "description": "提供 session 级别的事务 begin/commit/rollback 及 savepoint 设置/释放/回滚接口。",
        "evidence": [
          "include/mysqlx/xapi.h",
          "common/session.cc",
          "xapi/session.cc"
        ]
      },
      {
        "name": "TLS/SSL 安全传输",
        "description": "基于 OpenSSL 实现 TLS 加密连接，支持多种 SSL 模式（DISABLED/PREFERRED/REQUIRED/VERIFY_CA/VERIFY_IDENTITY）、CA 证书、TLS 版本与密码套件协商。",
        "evidence": [
          "cdk/foundation/connection_openssl.cc",
          "cdk/foundation/socket_detail.cc",
          "include/mysqlx/xapi.h"
        ]
      },
      {
        "name": "认证与安全机制",
        "description": "支持 MySQL 多种认证方法（SHA256_MEMORY、MYSQL41、PAM、KERBEROS 等），连接属性传递，行锁（SHARED/EXCLUSIVE）与 NOWAIT/SKIP LOCKED。",
        "evidence": [
          "cdk/mysqlx/protocol/mysqlx.cc",
          "include/mysqlx/xapi.h",
          "cdk/foundation/socket_detail.cc"
        ]
      },
      {
        "name": "网络传输压缩",
        "description": "内置 zlib、LZ4、Zstd 压缩算法支持，可配置压缩模式与算法优先级以降低网络传输开销。",
        "evidence": [
          "cdk/cmake/DepFindCompression.cmake",
          "cdk/extra/zlib/",
          "cdk/extra/lz4/",
          "cdk/extra/zstd/"
        ]
      },
      {
        "name": "C 语言 X DevAPI",
        "description": "面向 C 语言的 X DevAPI 绑定（mysqlx_* 函数族），提供 session/schema/collection/table CRUD 全功能，供 C 代码调用。",
        "evidence": [
          "include/mysqlx/xapi.h",
          "xapi/mysqlx.cc",
          "xapi/session.cc"
        ]
      }
    ],
    "domain": "数据库连接器",
    "target_users": "需要从 C++ 或 C 应用程序连接 MySQL 数据库的后端开发者、中间件/工具开发者"
  },
