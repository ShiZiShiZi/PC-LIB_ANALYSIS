  "function_summary": {
    "summary": "undici 是 Node.js 生态中从头实现的 HTTP/1.1 客户端库，以高性能连接池和底层 dispatch API 为核心，同时提供了符合 WHATWG 标准的 fetch、WebSocket、EventSource 等 Web API 实现。它还集成缓存（内存/SQLite）、Cookie 解析与管理、多种代理（HTTP/SOCKS5/环境代理）、拦截器管道（重定向/重试/解压缩/DNS/去重）、内容安全子资源完整性校验等特性。该库已被 Node.js 内置为全局 fetch 的实现引擎（自 v18 起），目标用户是 Node.js 应用开发者、服务端框架作者以及需要细粒度 HTTP 控制的场景。",
    "categories": [
      {
        "name": "HTTP/1.1 客户端核心与连接池",
        "description": "提供 Client、Pool、BalancedPool、RoundRobinPool 等调度器，支持连接复用、Keep-Alive、流水线（pipelining）、超时控制、TLS/HTTPS 连接与 ALPN 协商",
        "evidence": [
          "lib/dispatcher/client.js",
          "lib/dispatcher/pool.js",
          "lib/dispatcher/client-h1.js",
          "lib/core/connect.js",
          "lib/dispatcher/pool-base.js"
        ]
      },
      {
        "name": "HTTP/2 支持",
        "description": "提供 Client 的 HTTP/2 (h2) 模式和 H2CClient（明文 HTTP/2），支持多路复用、流控、Ping 探测",
        "evidence": [
          "lib/dispatcher/client-h2.js",
          "lib/dispatcher/h2c-client.js"
        ]
      },
      {
        "name": "WHATWG Fetch API 实现",
        "description": "完整实现Request、Response、Headers、FormData、Body 等 Web API，包括数据 URL 解析、MIME 类型处理、FormData 解析",
        "evidence": [
          "lib/web/fetch/index.js",
          "lib/web/fetch/request.js",
          "lib/web/fetch/response.js",
          "lib/web/fetch/headers.js",
          "lib/web/fetch/body.js",
          "lib/web/fetch/formdata.js",
          "lib/web/fetch/data-url.js"
        ]
      },
      {
        "name": "WebSocket 客户端",
        "description": "实现 WebSocket 协议（RFC 6455），支持消息帧收发、关闭握手、Ping/Pong、permessage-deflate 压缩扩展、WebSocketStream",
        "evidence": [
          "lib/web/websocket/websocket.js",
          "lib/web/websocket/connection.js",
          "lib/web/websocket/receiver.js",
          "lib/web/websocket/sender.js",
          "lib/web/websocket/frame.js",
          "lib/web/websocket/permessage-deflate.js"
        ]
      },
      {
        "name": "EventSource (SSE) 客户端",
        "description": "实现 Server-Sent Events 客户端，支持自动重连、lastEventId、事件类型分发",
        "evidence": [
          "lib/web/eventsource/eventsource.js"
        ]
      },
      {
        "name": "缓存与拦截器管道",
        "description": "提供内存与 SQLite 缓存存储后端、CacheStorage API；拦截器系统支持重定向、重试、解压缩（gzip/deflate/brotli/zstd）、DNS 解析注入、请求去重、响应 dump 等可组合中间件",
        "evidence": [
          "lib/interceptor/redirect.js",
          "lib/interceptor/retry.js",
          "lib/interceptor/decompress.js",
          "lib/interceptor/dns.js",
          "lib/interceptor/deduplicate.js",
          "lib/interceptor/cache.js",
          "lib/cache/memory-cache-store.js",
          "lib/cache/sqlite-cache-store.js",
          "lib/web/cache/cachestorage.js"
        ]
      },
      {
        "name": "代理与 Cookie 支持",
        "description": "支持 HTTP 代理、SOCKS5 代理、环境变量代理自动发现、带重试的策略代理（RetryAgent），以及 Cookie 解析/设置/删除/获取与 CookieJar 管理",
        "evidence": [
          "lib/dispatcher/proxy-agent.js",
          "lib/dispatcher/socks5-proxy-agent.js",
          "lib/dispatcher/env-http-proxy-agent.js",
          "lib/dispatcher/retry-agent.js",
          "lib/web/cookies/parse.js",
          "lib/web/cookies/index.js"
        ]
      },
      {
        "name": "Mock/测试客户端",
        "description": "提供 MockClient、MockAgent、MockPool、SnapshotAgent 等用于单元测试的 HTTP mock 工具，可录制/回放 HTTP 交互",
        "evidence": [
          "lib/mock/mock-client.js",
          "lib/mock/mock-agent.js",
          "lib/mock/mock-pool.js",
          "lib/mock/snapshot-agent.js",
          "lib/mock/snapshot-recorder.js"
        ]
      }
    ],
    "domain": "网络通信 / HTTP 客户端",
    "target_users": "Node.js 应用与框架开发者，需要高性能 HTTP 客户端、Web 标准 API（fetch/WebSocket/EventSource）或细粒度 HTTP 连接控制的场景",
    "ecosystem": "nodejs"
