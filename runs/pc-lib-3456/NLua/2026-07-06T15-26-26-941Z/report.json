  "function_summary": {
    "summary": "NLua 是一个 .NET 平台上的 Lua 脚本语言桥接库，允许 C# 代码创建 Lua 状态机、执行 Lua 脚本，并在两个语言之间双向传递对象、调用方法和访问属性。它基于 KeraLua（原生 Lua 的 P/Invoke 绑定），通过 ObjectTranslator 实现类型转换与元表注册，支持 .NET Framework 4.6+、.NET Standard 2.0、.NET 8.0 以及 Android/iOS/macOS/tvOS/UWP 等多平台。NLua 是 LuaInterface 项目的继承者。",
    "categories": [
      {
        "name": "Lua 脚本引擎嵌入",
        "description": "提供 Lua 状态机的创建、脚本执行（DoString/DoFile）、表达式求值、函数定义与调用等核心能力，将 Lua 作为嵌入式脚本语言集成到 .NET 应用中",
        "evidence": [
          "src/Lua.cs:278",
          "src/Lua.cs:306",
          "src/LuaFunction.cs:9"
        ]
      },
      {
        "name": ".NET-Lua 对象互操作",
        "description": "通过 ObjectTranslator 和 MetaFunctions 实现 CLR 对象与 Lua 值之间的双向转换——.NET 对象可传入 Lua 脚本并被索引/调用，Lua 函数、表、线程也可在 C# 中作为一等对象使用",
        "evidence": [
          "src/ObjectTranslator.cs:23",
          "src/Metatables.cs:24",
          "src/CheckType.cs:10"
        ]
      },
      {
        "name": "动态代码生成与事件桥接",
        "description": "使用 System.Reflection.Emit 在运行时生成事件处理器类型和委托包装类型，使 Lua 函数可订阅 .NET 事件、充当委托回调",
        "evidence": [
          "src/GenerateEventAssembly/CodeGeneration.cs:11",
          "src/GenerateEventAssembly/DelegateGenerator.cs",
          "src/GenerateEventAssembly/ClassGenerator.cs"
        ]
      },
      {
        "name": "类型注册与枚举导出",
        "description": "提供 LuaRegistrationHelper 将标记了 LuaMemberAttribute 的方法批量注册为 Lua 全局函数，以及将 .NET 枚举类型导出为 Lua 表",
        "evidence": [
          "src/LuaRegistrationHelper.cs:7",
          "src/LuaMemberAttribute.cs",
          "src/LuaHideAttribute.cs"
        ]
      }
    ],
    "domain": "脚本语言嵌入与互操作",
    "target_users": "需要在 .NET 应用中嵌入 Lua 脚本能力的开发者，如游戏引擎、应用插件系统、自动化测试框架、配置热更新场景"
  },
