  "function_summary": {
    "summary": "IPNetwork 是一个 .NET（C#）IP 网络计算库，提供 IPv4/IPv6 网络的解析、CIDR 掩码处理、子网划分、超网合并、网络包含/重叠判断、网络减法、IP 范围转 CIDR、IANA 保留块查询及 IPv6 唯一本地地址生成等功能。同时附带一个原生 AOT 编译的命令行工具，可交互式执行网络计算操作。该库以 NuGet 包 IPNetwork2 分发，目标框架覆盖 .NET 8/9/10 及 .NET Standard 2.0/2.1，API 轻量整洁，完全单元测试覆盖。",
    "categories": [
      {
        "name": "IP 网络解析与构造",
        "description": "从字符串、IPAddress、CIDR 等多种格式解析并构造 IPNetwork2 对象，支持 ClassFull/ClassLess/NetworkAware 三种 CIDR 猜测策略，以及输入清洗与容错 TryParse 变体。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Parse.cs",
          "src/System.Net.IPNetwork/IPNetwork2InternalParse.cs",
          "src/System.Net.IPNetwork/CidrGuess.cs",
          "src/System.Net.IPNetwork/CidrClassFull.cs",
          "src/System.Net.IPNetwork/CidrClassLess.cs",
          "src/System.Net.IPNetwork/CidrNetworkAware.cs"
        ]
      },
      {
        "name": "网络属性计算",
        "description": "计算 IP 网络的网络地址、广播地址、子网掩码、首/末可用 IP、可用 IP 数、总 IP 数等核心属性，同时支持 BigInteger 与无符号整数互转以及位运算辅助。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Members.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToIPAddress.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToUint.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToCidr.cs",
          "src/System.Net.IPNetwork/IPNetwork2ToNetmask.cs",
          "src/System.Net.IPNetwork/IPNetwork2BitsSet.cs",
          "src/System.Net.IPNetwork/BigIntegerExtensions.cs"
        ]
      },
      {
        "name": "子网划分与超网合并",
        "description": "将网络按指定 CIDR 划分为子网集合，或将多个相邻网络合并为超网；支持数组批量操作与 Try 变体。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Subnet.cs",
          "src/System.Net.IPNetwork/IPNetwork2Supernet.cs",
          "src/System.Net.IPNetwork/IPNetwork2SupernetArray.cs",
          "src/System.Net.IPNetwork/IPNetwork2WideSubnet.cs"
        ]
      },
      {
        "name": "网络包含、重叠与减法",
        "description": "判断网络是否包含某 IP 或另一网络、两网络是否重叠，以及网络减法（对称差），生成去除指定子网后的最小网络集合。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2Contains.cs",
          "src/System.Net.IPNetwork/IPNetwork2Overlap.cs",
          "src/System.Net.IPNetwork/IPNetwork2Substract.cs"
        ]
      },
      {
        "name": "IP 范围解析与 IANA/ULA 支持",
        "description": "将起始-结束 IP 范围转换为最优 CIDR 块集合（ParseRange）；查询 IANA 保留的 A/B/C 类地址块；生成 IPv6 唯一本地地址（ULA）前缀及子网。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2ParseRange.cs",
          "src/System.Net.IPNetwork/IPNetwork2IANAblock.cs",
          "src/System.Net.IPNetwork/UniqueLocalAddress.cs"
        ]
      },
      {
        "name": "序列化、比较与运算符",
        "description": "支持 XML 序列化（IXmlSerializable）与二进制序列化（ISerializable）；实现 IEquatable/IComparable 接口与运算符重载（+/-），便于集合操作与排序。",
        "evidence": [
          "src/System.Net.IPNetwork/IPNetwork2XmlSerialization.cs",
          "src/System.Net.IPNetwork/IPNetwork2ISerializable.cs",
          "src/System.Net.IPNetwork/IPNetwork2IEquatableIPNetworkMembers.cs",
          "src/System.Net.IPNetwork/IPNetwork2IComparableIPNetworkMembers.cs",
          "src/System.Net.IPNetwork/IPNetwork2Operators.cs"
        ]
      },
      {
        "name": "命令行工具",
        "description": "原生 AOT 编译的 CLI 应用，支持显示网络信息、子网划分、超网合并、包含/重叠判断、网络减法、IP 枚举等操作，可输出文本或 JSON 格式，通过 Homebrew/Chocolatey 安装。",
        "evidence": [
          "src/ConsoleApplication/Program.cs",
          "src/ConsoleApplication/ActionComputer.cs",
          "src/ConsoleApplication/JsonFormatter.cs",
          "src/ConsoleApplication/TextFormatter.cs"
        ]
      }
    ],
