  "function_summary": {
    "summary": "libaribcaption 是一个用 C++17 编写的可移植库，提供 ARIB STD-B24（及兼容的 ABNT NBR 15606-1、菲律宾 UTF-8 变体）数字电视字幕的解码与位图渲染能力。它以 PES 分组为输入，输出带时间戳的字幕数据结构，并可进一步渲染为 RGBA 图像，供视频播放器叠加显示。库同时暴露 C++ 与 C 接口，默认在不同平台选用 DirectWrite（Windows）、CoreText（macOS/iOS）或 FreeType+Fontconfig（Linux/Android）作为字体解析与字形绘制后端。",
    "categories": [
      {
        "name": "ARIB 字幕解码",
        "description": "解析 ARIB STD-B24 PES 数据，提取管理数据与语句数据，支持日语 JIS、拉丁语及菲律宾 UTF-8 编码方案的自动/手动选择。",
        "evidence": [
          "include/aribcaption/decoder.hpp",
          "src/decoder/decoder_impl.cpp"
        ]
      },
      {
        "name": "字幕位图渲染",
        "description": "将解码后的字幕按区域、颜色、字符样式（下划线/描边/半角等）渲染为 RGBA 图像，并提供内部缓存策略控制。",
        "evidence": [
          "include/aribcaption/renderer.hpp",
          "src/renderer/renderer_impl.cpp",
          "src/renderer/canvas.cpp"
        ]
      },
      {
        "name": "多平台字体与字形后端",
        "description": "通过可插拔的 FontProvider/TextRenderer 组合，在 Windows、macOS/iOS、Linux、Android 上分别使用 DirectWrite、CoreText、FreeType+Fontconfig 或 Android 系统字体解析。",
        "evidence": [
          "src/renderer/font_provider_directwrite.cpp",
          "src/renderer/text_renderer_directwrite.cpp",
          "src/renderer/font_provider_coretext.cpp",
          "src/renderer/text_renderer_coretext.cpp",
          "src/renderer/font_provider_fontconfig.cpp",
          "src/renderer/text_renderer_freetype.cpp",
          "src/renderer/font_provider_android.cpp"
        ]
      },
      {
        "name": "DRCS 与 Gaiji 处理",
        "description": "支持 ARIB 附加符号（Gaiji）解码，并内置 DRCS（动态字符集）替换表，将已知 DRCS 字符映射为等效 Unicode 进行渲染。",
        "evidence": [
          "src/decoder/b24_gaiji_table.hpp",
          "src/decoder/b24_drcs_conv.cpp",
          "src/renderer/drcs_renderer.cpp"
        ]
      },
      {
        "name": "C/C++ 双接口",
        "description": "对外提供现代 C++ 类接口（Context/Decoder/Renderer）以及纯 C 封装接口，便于嵌入 C 项目或作为其他语言绑定的基础。",
        "evidence": [
          "include/aribcaption/aribcaption.hpp",
          "include/aribcaption/decoder.h",
          "include/aribcaption/renderer.h",
          "src/common/context_capi.cpp",
          "src/decoder/decoder_capi.cpp",
          "src/renderer/renderer_capi.cpp"
        ]
      }
    ],
    "domain": "media",
    "target_users": "视频播放器、流媒体客户端及多媒体框架开发者",
    "ecosystem": "cpp"
