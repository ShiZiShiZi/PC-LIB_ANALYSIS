  "function_summary": {
    "summary": "readable-stream 是 Node.js 核心 stream 模块的 userland 镜像，将 Node.js 18.19.0 的流实现以独立 npm 包形式提供给开发者。它提供了 Readable、Writable、Duplex、Transform、PassThrough 五种流基类，以及 pipeline、finished、compose、destroy、addAbortSignal 等流工具函数，让不同 Node.js 版本（含旧版）的开发者获得一致的流 API 体验。该包也支持浏览器环境（需通过打包工具），是 npm 生态中最广泛依赖的包之一。",
    "categories": [
      {
        "name": "可读流（Readable）",
        "description": "数据读取的流抽象，支持 flowing 与 paused 两种模式，可从底层数据源（如文件、HTTP 响应）逐步读取数据。提供 read()、pipe()、on('data')、on('readable') 等接口。",
        "evidence": [
          "lib/internal/streams/readable.js:204",
          "lib/stream.js:52"
        ]
      },
      {
        "name": "可写流（Writable）",
        "description": "数据写入的流抽象，接收数据并写入底层目标（如文件、HTTP 请求）。支持 cork/uncork 背压缓冲、write()、end() 等接口。",
        "evidence": [
          "lib/internal/streams/writable.js",
          "lib/stream.js:101"
        ]
      },
      {
        "name": "双工流（Duplex）",
        "description": "既可读又可写的流，同时实现了 Readable 和 Writable 接口。适用于 TCP socket、交互式通信等双向数据场景。",
        "evidence": [
          "lib/internal/streams/duplex.js",
          "lib/stream.js:102"
        ]
      },
      {
        "name": "转换流（Transform）",
        "description": "继承自 Duplex 的特殊双工流，可在写入时对数据进行转换后再读出。常用于数据压缩、加密、编码转换、对象变换等场景。",
        "evidence": [
          "lib/internal/streams/transform.js",
          "lib/stream.js:103"
        ]
      },
      {
        "name": "流工具函数",
        "description": "提供 pipeline（自动管道连接与清理）、finished（监听流结束/错误）、compose（组合流）、destroy（统一销毁）、addAbortSignal（将 AbortSignal 接入流）等实用工具。",
        "evidence": [
          "lib/internal/streams/pipeline.js",
          "lib/internal/streams/end-of-stream.js",
          "lib/internal/streams/compose.js",
          "lib/stream.js:104-109"
        ]
      },
      {
        "name": "流操作符（Operators）",
        "description": "基于 readable.from 的流式数据处理操作符，包括 map、filter、reduce、forEach、find、some、every、flatMap、drop、take、toArray 等，提供声明式流数据处理能力。",
        "evidence": [
          "lib/internal/streams/operators.js",
          "lib/stream.js:53-76"
        ]
      },
      {
        "name": "Promise 接口",
        "description": "将 pipeline 和 finished 以 Promise 形式暴露，方便 async/await 场景使用。",
        "evidence": [
          "lib/stream/promises.js",
          "lib/stream.js:113-119"
        ]
      }
    ],
    "domain": "数据流处理（data streaming）",
    "target_users": "Node.js 和浏览器 JavaScript 应用开发者"
  },
