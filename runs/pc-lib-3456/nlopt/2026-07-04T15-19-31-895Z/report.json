  "function_summary": {
    "summary": "NLopt 是一个非线性优化库，集成了 DIRECT、COBYLA、NEWUOA、BOBYQA、SLSQP、MMA、Nelder-Mead 等十余种自由/开源优化算法，提供统一的 C 接口。支持无梯度与有梯度优化、全局与局部搜索、带约束优化。面向科研人员与工程开发者，可将优化功能嵌入数值计算、模型拟合、工程设计等应用。",
    "categories": [
      {
        "name": "全局优化",
        "description": "提供 DIRECT、CRS2、MLSL、ISRES、ESCH、AGS 等全局搜索算法，支持随机与拟随机初始化",
        "evidence": [
          "src/api/nlopt.h:85-89 (NLOPT_GN_DIRECT 系列)",
          "src/algs/direct/",
          "src/algs/crs/",
          "src/algs/isres/",
          "src/algs/ags/"
        ]
      },
      {
        "name": "局部优化",
        "description": "提供 MMA、COBYLA、NEWUOA、BOBYQA、Nelder-Mead、L-BFGS、SLSQP、PRAXIS、TNEWTON 等局部搜索算法",
        "evidence": [
          "src/api/nlopt.h:98-135 (NLOPT_LD_LBFGS 等)",
          "src/algs/mma/",
          "src/algs/cobyla/",
          "src/algs/newuoa/",
          "src/algs/slsqp/"
        ]
      },
      {
        "name": "约束优化",
        "description": "支持等式与不等式约束、边界约束，通过增广拉格朗日法 (AUGLAG) 和 SLQP/COBYLA/MMA 等方法处理",
        "evidence": [
          "src/api/nlopt.h:238-246",
          "src/algs/auglag/",
          "src/api/optimize.c:62-86 (边界变换)"
        ]
      },
      {
        "name": "多语言绑定",
        "description": "通过 SWIG 提供 Python、Java、Guile、Octave/Matlab 绑定，另有社区维护的 Fortran、R、Lua、Rust、Julia 等语言接口",
        "evidence": [
          "README.md:16-18",
          "src/swig/nlopt.i",
          "src/swig/nlopt-python.i",
          "src/swig/nlopt-java.i",
          "src/api/f77api.c"
        ]
      },
      {
        "name": "准随机序列生成",
        "description": "内置 Sobol 低差异序列生成器用于准蒙特卡洛与全局优化初始化",
        "evidence": [
          "src/util/sobolseq.c",
          "src/util/nlopt-util.h:71-76"
        ]
      }
    ],
    "domain": "数值优化",
    "target_users": "科学计算与工程优化领域的研究人员和开发者"
  },
