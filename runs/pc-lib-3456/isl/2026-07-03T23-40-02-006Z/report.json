  "function_summary": {
    "summary": "isl（Integer Set Library）是一个线程安全的 C 库，用于表示和操作由仿射约束界定的整数点集合与关系。它支持参数、存在量词变量、集合/映射的并/交/差/投影、凸包、整数线性规划、依赖分析、调度综合以及 AST 生成，是面向多面体编译模型的核心基础设施库。",
    "categories": [
      {
        "name": "整数集合与关系运算",
        "description": "提供 isl_set、isl_map、isl_union_set、isl_union_map 等核心对象的创建、等价判定、包含关系、投影、拆分与简化操作。",
        "evidence": [
          "include/isl/set.h",
          "include/isl/map.h",
          "include/isl/union_set.h",
          "include/isl/union_map.h",
          "isl_map.c",
          "isl_set.c"
        ]
      },
      {
        "name": "仿射表达式与取值",
        "description": "表示分段仿射函数（isl_pw_aff、isl_multi_pw_aff）和有理数/整数取值（isl_val），支持算术、比较、求值与符号化操作。",
        "evidence": [
          "include/isl/aff.h",
          "include/isl/val.h",
          "isl_aff.c",
          "isl_val.c"
        ]
      },
      {
        "name": "调度综合",
        "description": "基于 Pluto 风格约束求解，为多面体表示的循环迭代空间生成有效的调度树（isl_schedule），用于自动并行化和局部性优化。",
        "evidence": [
          "include/isl/schedule.h",
          "include/isl/schedule_node.h",
          "isl_scheduler.c",
          "isl_schedule.c"
        ]
      },
      {
        "name": "AST 生成与代码生成",
        "description": "将调度后的多面体域转换为类 C 的抽象语法树（isl_ast_node/isl_ast_expr），供下游生成实际循环代码。",
        "evidence": [
          "include/isl/ast.h",
          "include/isl/ast_build.h",
          "isl_ast_codegen.c",
          "isl_ast_build.c"
        ]
      },
      {
        "name": "整数线性规划与依赖分析",
        "description": "内置参数整数规划（PIP）求解器和流/反依赖分析工具，支撑数据依赖检测与多面体变换。",
        "evidence": [
          "include/isl/ilp.h",
          "include/isl/flow.h",
          "isl_tab_pip.c",
          "isl_flow.c"
        ]
      },
      {
        "name": "输入输出与绑定",
        "description": "提供文本解析/打印（isl 格式）、YAML 输出、GDB 脚本，以及可选的 Python（ctypes）和 C++ 头文件绑定。",
        "evidence": [
          "include/isl/printer.h",
          "isl_input.c",
          "isl_output.c",
          "python/isl.py.top",
          "interface/"
        ]
      }
    ],
    "domain": "compiler optimization / polyhedral model",
    "target_users": "编译器开发者、自动并行化与高性能计算研究人员、需要多面体分析的其它库（如 LLVM/Polly、Pluto、PPCG）"
  },
