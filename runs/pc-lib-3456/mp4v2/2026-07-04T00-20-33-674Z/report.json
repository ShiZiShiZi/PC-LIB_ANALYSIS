  "function_summary": {
    "summary": "mp4v2 是一个 C/C++ 实现的 MP4 容器文件操作库，对外提供稳定的 C API，内部使用 C++ 实现。它支持创建、读取、修改 MP4 文件，管理音视频轨道，读写 iTunes 元数据（iTMF），处理 QuickTime/Nero 章节，以及生成 RTP 提示轨道以支持流媒体打包。该库主要被多媒体应用、转码工具和媒体元数据编辑器以 API 方式调用。",
    "categories": [
      {
        "name": "MP4 文件读写与创建",
        "description": "提供 MP4 文件的打开、创建、修改、关闭和布局优化能力，支持自定义文件 I/O Provider。",
        "evidence": [
          "include/mp4v2/file.h",
          "src/mp4file.cpp"
        ]
      },
      {
        "name": "轨道管理",
        "description": "支持添加、删除、克隆音视频和文本轨道，覆盖 MPEG-4、H.264、H.263、AMR、AC3、字幕等常见编码类型。",
        "evidence": [
          "include/mp4v2/track.h",
          "src/mp4track.cpp"
        ]
      },
      {
        "name": "媒体元数据（iTMF Tags）",
        "description": "提供对 iTunes Metadata Format 标签的读取与写入，包括歌曲信息、封面、TV 节目信息、排序字段等。",
        "evidence": [
          "include/mp4v2/itmf_tags.h",
          "src/itmf/Tags.cpp"
        ]
      },
      {
        "name": "章节管理",
        "description": "支持 QuickTime 章节轨道和 Nero 章节两种格式，可添加、删除、转换和读取章节列表。",
        "evidence": [
          "include/mp4v2/chapter.h",
          "src/cmeta.cpp"
        ]
      },
      {
        "name": "流媒体与 RTP 提示轨道",
        "description": "可创建和读取 RTP hint track，辅助将媒体数据打包为 RTP 包，支持 SDP 会话描述。",
        "evidence": [
          "include/mp4v2/streaming.h",
          "src/rtphint.cpp"
        ]
      },
      {
        "name": "命令行工具集",
        "description": "仓库自带 mp4info、mp4tags、mp4track、mp4chaps 等命令行工具，封装库能力供终端用户直接使用。",
        "evidence": [
          "util/mp4info.cpp",
          "util/mp4tags.cpp",
          "util/mp4track.cpp",
          "GNUmakefile.am"
        ]
      }
    ],
    "domain": "multimedia",
    "target_users": "需要处理 MP4 容器文件的 C/C++ 应用开发者、转码工具和媒体元数据编辑器"
  },
