  "function_summary": {
    "summary": "mp4v2是一个C++编写的MP4文件操作库，原名MPEG4IP项目，经TechSmith fork维护。提供完整的MP4容器格式读写能力：创建新MP4文件、修改已有文件的音视频轨道、读取文件结构并提取元数据。支持MPEG-4系统层（OD/BIFS）、3GPP扩展（H.263/AMR）、iTunes风格元数据标签（封面、章节、自定义标签）以及ISMA加密。面向音视频工具开发者、媒体处理管线及需要程序化操作MP4文件的桌面/服务端应用。",
    "categories": [
      {
        "name": "MP4文件创建与修改",
        "description": "创建空MP4文件、添加/删除音视频轨道、设置轨道属性（编码格式、时间尺度、帧率），支持对已有文件进行增量修改。",
        "evidence": [
          "src/mp4.cpp",
          "include/mp4v2/file.h",
          "src/mp4file.cpp"
        ]
      },
      {
        "name": "MP4文件解析与读取",
        "description": "打开已有MP4文件、读取其内部原子(atom)结构、遍历音视频轨道及其属性（时长、采样率、码率等）、定位并读取媒体数据。",
        "evidence": [
          "src/mp4.cpp",
          "src/mp4atom.cpp",
          "src/mp4file.cpp",
          "include/mp4v2/file_prop.h"
        ]
      },
      {
        "name": "iTunes风格元数据标签",
        "description": "读写MP4文件中的iTunes风格元数据（如封面图、章节标记、自定义字符串/整数/布尔标签），支持moov.udta.meta层次的标准标签。",
        "evidence": [
          "src/itmf/Tags.cpp",
          "src/itmf/generic.cpp",
          "src/itmf/CoverArtBox.cpp",
          "include/mp4v2/itmf_tags.h",
          "include/mp4v2/itmf_generic.h"
        ]
      },
      {
        "name": "3GPP扩展支持",
        "description": "支持3GPP文件格式扩展，包括H.263视频编码、AMR音频编码、3GP合规性转换（移除不兼容原子）。",
        "evidence": [
          "src/3gp.cpp",
          "src/atom_s263.cpp",
          "src/atom_damr.cpp",
          "include/mp4v2/isma.h"
        ]
      },
      {
        "name": "ISMA加密与流式输出",
        "description": "支持ISMA 1.0规范的加密方案设置与加密流输出，可配置KMS URI等加密参数。",
        "evidence": [
          "src/isma.cpp",
          "include/mp4v2/isma.h",
          "include/mp4v2/streaming.h"
        ]
      },
      {
        "name": "平台抽象与文件系统",
        "description": "内置POSIX/Windows双平台文件IO与路径处理抽象层，封装文件打开、读写、重命名、临时文件等操作。",
        "evidence": [
          "libplatform/io/File_posix.cpp",
          "libplatform/io/File_win32.cpp",
          "libplatform/io/FileSystem_posix.cpp",
          "libplatform/io/FileSystem_win32.cpp"
        ]
      }
    ],
    "domain": "多媒体/音视频容器格式处理",
    "target_users": "音视频工具开发者、媒体处理管线开发者、需要程序化操作MP4文件的桌面/服务端应用开发者"
  },
