  "function_summary": {
    "summary": "ini-parser 是一个用 C# 编写的 INI 配置文件解析库，面向 .NET/Mono/Unity3D 平台。它提供了 INI 文件的读取、写入、合并操作，支持从字符串、文件流和 IO 流解析 INI 数据，并允许通过配置对象自定义解析行为（如注释符、重复键处理、大小写敏感等）。该库不依赖任何 Windows API 调用，完全基于 .NET 标准库实现，具备良好的跨平台可移植性。",
    "categories": [
      {
        "name": "INI 文件解析",
        "description": "将 INI 格式的文本（字符串、文件或流）解析为结构化的 IniData 对象，支持节（section）、键值对（property）、注释的识别与提取",
        "evidence": [
          "src/IniParser/IniDataParser.cs:67 — Parse(string)",
          "src/IniParser/IniDataParser.cs:85 — Parse(TextReader)",
          "src/IniParser/Model/IniData.cs"
        ]
      },
      {
        "name": "INI 文件写入与格式化",
        "description": "将 IniData 对象格式化输出为 INI 文本，支持自定义格式配置（缩进、换行、注释位置等）",
        "evidence": [
          "src/IniParser/IniDataFormatter.cs:11 — Format()",
          "src/IniParser/Format/IIniDataFormatter.cs",
          "src/IniParser/Configuration/IniFormattingConfiguration.cs"
        ]
      },
      {
        "name": "INI 数据合并",
        "description": "支持完整 INI 文件、单个节或键值集合级别的合并操作，用户配置可覆盖全局配置",
        "evidence": [
          "src/IniParser/Model/IniData.cs — Merge()",
          "src/IniParser/Model/Section.cs",
          "src/IniParser/Model/PropertyCollection.cs"
        ]
      },
      {
        "name": "解析行为自定义",
        "description": "通过 IniParserConfiguration 和 IniScheme 配置解析器的行为，包括注释字符串、节定界符、重复键处理策略、大小写敏感性等",
        "evidence": [
          "src/IniParser/Configuration/IniParserConfiguration.cs",
          "src/IniParser/Configuration/IniScheme.cs",
          "src/IniParser/Configuration/IniFormattingConfiguration.cs"
        ]
      }
    ],
    "domain": "配置文件解析",
    "target_users": "需要在 .NET/Mono/Unity3D 应用中读写 INI 配置文件的开发者"
  },
