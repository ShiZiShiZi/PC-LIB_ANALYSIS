  "function_summary": {
    "summary": "libxmp 是一个用 C 语言编写的跨平台模块音乐播放器库，可将 Protracker (MOD)、Scream Tracker 3 (S3M)、Fast Tracker II (XM)、Impulse Tracker (IT) 等 90 余种 tracker 模块格式渲染为 PCM 音频数据。它面向游戏、音频播放器、转换工具等需要离线回放模块音乐的开发者，提供创建上下文、加载模块、逐帧/逐缓冲区播放、格式检测、音轨信息等稳定 C API。",
    "categories": [
      {
        "name": "模块格式加载",
        "description": "解析并加载 MOD、S3M、XM、IT 等主流及大量小众 tracker 格式，以及 ProWizard 打包格式。",
        "evidence": [
          "src/load.c",
          "src/loaders/mod_load.c",
          "src/loaders/s3m_load.c",
          "src/loaders/xm_load.c",
          "src/loaders/it_load.c",
          "src/loaders/prowizard/prowiz.c"
        ]
      },
      {
        "name": "音频渲染与混音",
        "description": "以指定采样率将模块事件流渲染为 PCM 采样，支持最近邻/线性/三次样条插值、8/16/32 位与单/立体声输出、虚拟通道与 DSP 效果。",
        "evidence": [
          "src/mixer.c",
          "src/mix_all.c",
          "src/virtual.c",
          "src/player.c"
        ]
      },
      {
        "name": "内置解包解压",
        "description": "内置 gzip、bzip2、xz、zip、LHA、LZX、MMCMP、PowerPack 等常见压缩/打包格式解压器，并可选调用外部 unrar/unmo3 助手程序处理 RAR/MO3。",
        "evidence": [
          "src/depackers/depacker.c",
          "src/depackers/gunzip.c",
          "src/depackers/bunzip2.c",
          "src/depackers/unzip.c",
          "src/depackers/unlha.c"
        ]
      },
      {
        "name": "播放控制与定位",
        "description": "提供开始/停止/暂停播放、位置跳转、时间定位、通道静音/音量、事件注入等播放控制 API。",
        "evidence": [
          "src/control.c",
          "src/scan.c",
          "src/read_event.c",
          "include/xmp.h"
        ]
      },
      {
        "name": "扩展采样混音器 (SMIX)",
        "description": "允许在模块播放之上叠加外部采样/乐器，实现音效层或自定义音轨。",
        "evidence": [
          "src/smix.c",
          "include/xmp.h"
        ]
      }
    ],
    "domain": "audio / module music playback",
    "target_users": "需要在游戏、媒体播放器、转换工具或嵌入式设备中集成模块音乐回放功能的 C/C++ 开发者"
  },
