  "function_summary": {
    "summary": "HtmlAgilityPack 是一个 .NET 平台的敏捷 HTML 解析库，能将'真实世界'中不规范的 HTML 文档解析为可读写的 DOM 对象模型。其对象模型类似 System.Xml，但专为 HTML 设计，支持 XPath 查询与 XSLT 转换，对畸形 HTML 有极强的容错能力。主要面向 .NET 开发者，用于网页抓取、HTML 文档处理与数据提取。",
    "categories": [
      {
        "name": "HTML 文档解析与 DOM 构建",
        "description": "将 HTML 文本/流/文件解析为可操作的 DOM 树，支持编码自动检测、容错解析与多种加载方式",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlDocument.cs",
          "src/HtmlAgilityPack.Shared/HtmlDocument.PathMethods.cs"
        ]
      },
      {
        "name": "DOM 节点操作与遍历",
        "description": "提供 HtmlNode/HtmlAttribute/HtmlNodeCollection 等核心类型，支持节点增删改查、父子遍历与属性操作",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlNode.cs",
          "src/HtmlAgilityPack.Shared/HtmlAttribute.cs",
          "src/HtmlAgilityPack.Shared/HtmlNodeCollection.cs"
        ]
      },
      {
        "name": "XPath 查询与导航",
        "description": "通过 HtmlNodeNavigator 实现 XPath 导航，支持 SelectNodes/SelectSingleNode 等 XPath 查询",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlNode.Xpath.cs",
          "src/HtmlAgilityPack.Shared/HtmlNodeNavigator.cs",
          "src/HtmlAgilityPack.Shared/HtmlDocument.Xpath.cs"
        ]
      },
      {
        "name": "Web 内容获取",
        "description": "HtmlWeb 类提供从 HTTP/HTTPS URL 加载 HTML 文档的能力，支持缓存、代理、认证与编码检测",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlWeb.cs",
          "src/HtmlAgilityPack.Shared/Metro/HtmlWeb.cs"
        ]
      },
      {
        "name": "XSLT 转换",
        "description": "支持对 HTML 文档应用 XSLT 样式表转换，将 HTML 转换为其他格式",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlWeb.Xpath.cs"
        ]
      },
      {
        "name": "混合代码文档处理",
        "description": "MixedCodeDocument 类处理含代码与文本混合片段的文档，支持代码/文本片段的创建与迭代",
        "evidence": [
          "src/HtmlAgilityPack.Shared/MixedCodeDocument.cs"
        ]
      },
      {
        "name": "HTML 实体与编码处理",
        "description": "HtmlEntity 提供实体名称/值映射，支持编码检测与转换，确保多编码 HTML 的正确解析",
        "evidence": [
          "src/HtmlAgilityPack.Shared/HtmlEntity.cs",
          "src/HtmlAgilityPack.Shared/crc32.cs"
        ]
      }
    ],
    "domain": "HTML 解析与文档处理",
    "target_users": ".NET 应用开发者（网页抓取、HTML 文档处理、数据提取场景）"
  },
