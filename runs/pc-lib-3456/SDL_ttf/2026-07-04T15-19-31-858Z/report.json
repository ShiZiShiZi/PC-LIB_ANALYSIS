  "function_summary": {
    "summary": "SDL_ttf 是 SDL3 的 TrueType 字体渲染伴侣库，通过对 FreeType 字体引擎、HarfBuzz 复杂文本整形引擎和 PlutoSVG 彩色矢量图形库的封装，为 SDL3 应用提供完整的多语言 TrueType 字体加载、排版测量与高质量渲染能力。支持四种渲染质量模式（Solid/Shaded/Blended/LCD）、Signed Distance Field（SDF）渲染、字体样式变换、回退字体链、及基于 GPU/OpenGL/渲染器的加速纹理图集文本引擎。目标用户为使用 SDL3 开发游戏或桌面图形应用的 C/C++ 开发者。",
    "categories": [
      {
        "name": "字体加载与管理",
        "description": "从文件或 IO 流加载 TrueType/OpenType 字体文件，支持多 face、属性化创建、字体复制、回退字体链注册",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_OpenFont/TTF_OpenFontIO/TTF_OpenFontWithProperties/TTF_CopyFont/TTF_CloseFont)",
          "src/SDL_ttf.c:2203-2240"
        ]
      },
      {
        "name": "字体属性与样式",
        "description": "设置和查询字体的大小、DPI、样式（粗体/斜体/下划线/删除线）、轮廓描边、Hinting 级别、字间距、SDF 渲染开关及字重",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_SetFontStyle/TTF_SetFontOutline/TTF_SetFontSize/TTF_SetFontHinting/…)",
          "src/SDL_ttf.c"
        ]
      },
      {
        "name": "文本布局与测量",
        "description": "计算 UTF-8 文本的渲染尺寸（含自动换行）、测量指定宽度内可容纳的字符数、设置文本方向（LTR/RTL/TTB/BTT）、脚本与语言，以及水平对齐方式",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_GetStringSize/TTF_MeasureString/TTF_SetFontDirection/TTF_SetFontScript/…)",
          "src/SDL_ttf.c"
        ]
      },
      {
        "name": "字形与文本渲染",
        "description": "将文本渲染为 SDL_Surface：Solid（快速单色）、Shaded（带背景过渡）、Blended（高质量抗锯齿）、LCD（子像素渲染）四种质量模式，支持逐字形查询与渲染",
        "evidence": [
          "include/SDL3_ttf/SDL_ttf.h (TTF_RenderText_Solid/TTF_RenderText_Shaded/TTF_RenderText_Blended/TTF_RenderText_LCD/TTF_RenderGlyph_*/…)",
          "src/SDL_ttf.c:1374-1430"
        ]
      },
      {
        "name": "文本引擎与 GPU 加速",
        "description": "通过 TTF_TextEngine 插件接口，提供 Renderer/GPU/OpenGL/Surface 四种纹理图集文本引擎后端，将字形缓存为纹理并按需绘制，支持 SDF 渲染和子串集群定位",
        "evidence": [
          "include/SDL3_ttf/SDL_textengine.h",
          "src/SDL_renderer_textengine.c",
          "src/SDL_gpu_textengine.c",
          "src/SDL_gl_textengine.c",
          "src/SDL_surface_textengine.c"
        ]
      }
    ],
    "domain": "图形渲染 / 字体排版",
    "target_users": "使用 SDL3 开发游戏或桌面图形应用的 C/C++ 开发者"
  },
