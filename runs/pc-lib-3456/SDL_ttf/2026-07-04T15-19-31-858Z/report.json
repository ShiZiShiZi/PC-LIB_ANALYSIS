          "CMakeLists.txt:293 (usp10/gdi32/rpcrt4)"
        ]
      },
      {
        "id": "bk:freebsd_rendering_sse2",
        "issue": "SSE2 SIMD 字形混合函数为 x86 专有指令集，鸿蒙 PC (ARM) 上不可用",
