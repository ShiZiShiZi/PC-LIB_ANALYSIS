      ],
      "level": "medium"
    },
    "confidence": "medium",
    "recommended_path": "cross_compile",
    "summary": "SDL_ttf 是纯 C 字体渲染封装库（封装 FreeType/HarfBuzz/PlutoSVG），自身不直接调用任何平台特有系统 API——所有 OS 级操作均通过 SDL3 的跨平台抽象层间接完成。核心技术路径：用 OHOS NDK（musl + clang）交叉编译本库及其 C 依赖，生成 arm64/x86_64 .so 即可；CPU SIMD 优化路径（SSE2/NEON）有运行时检测与通用标量回退，不影响可移植性。主要不确定性来自 SDL3 自身在鸿蒙 PC 的可用状态（未知），若 SDL3 尚未适配则本库需先等待或协助 SDL3 适配。",
    "blockers": [
      {
        "id": "bk:sdl3_unknown",
        "issue": "SDL3 在鸿蒙 PC 上的可用性未核实——本库所有窗口/渲染/GPU/IO 能力均依赖 SDL3",
        "severity": "major",
        "adaptability": "adaptable",
        "category": "native_dependency",
        "source_dimension": "dependencies",
        "harmony_status": "unknown",
        "remediation": "需确认 SDL3 是否已有鸿蒙 PC 移植（如 OHOS NDK 可编译的 SDL3 后端）；若尚无，需先用 OHOS NDK + 鸿蒙窗口/渲染后端编译 SDL3，本库随后仅需 .cmake 配置即可重编",
        "caused_by": [
          "ta:sdl3_runtime"
        ],
        "evidence": [
          "CMakeLists.txt:127 (find_package SDL3)",
          "src/SDL_ttf.c:22 (#include <SDL3/SDL.h>)"
        ]
      },
      {
        "id": "bk:harfbuzz_win32",
        "issue": "HarfBuzz vendored 编译在 Windows 上链接 usp10/gdi32/rpcrt4（Windows 专有系统库），鸿蒙无对应",
        "severity": "minor",
        "adaptability": "adaptable",
        "category": "win32_api",
        "source_dimension": "dependencies",
        "harmony_status": "unavailable",
