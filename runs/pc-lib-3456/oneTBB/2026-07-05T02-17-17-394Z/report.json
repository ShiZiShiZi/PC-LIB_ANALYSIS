  "function_summary": {
    "summary": "oneTBB（oneAPI Threading Building Blocks）是 Intel 发起、现由 UXL 基金会托管的 C++ 并行编程库。它为开发者在多核 CPU 上编写可移植、可组合、可伸缩的并行程序提供了基于模板的高层抽象——用户只需表述逻辑并行，无需直接操作线程。库涵盖任务调度器、并行算法（parallel_for/reduce/scan/sort/pipeline）、并发容器（hash_map/queue/vector）、基于任务的流图（flow graph）、可伸缩内存分配器（tbbmalloc）、以及 CPU 拓扑绑定（tbbbind）与 NUMA 感知分配。附带 Python 绑定（tbb4py）使 Python 程序也能享用其任务并行能力。",
    "categories": [
      {
        "name": "任务调度与工作窃取",
        "description": "提供基于工作窃取的任务调度器（task_arena、task_group、task），自动管理线程池与任务粒度，支持 task_scheduler_observer 观测调度行为并可通过 global_control 动态调控并发度。",
        "evidence": [
          "include/oneapi/tbb/task_arena.h",
          "include/oneapi/tbb/task_group.h",
          "include/oneapi/tbb/task.h",
          "include/oneapi/tbb/global_control.h",
          "src/tbb/governor.cpp",
          "src/tbb/market.cpp",
          "src/tbb/arena.cpp"
        ]
      },
      {
        "name": "并行算法",
        "description": "提供丰富的并行算法模板：parallel_for / parallel_for_each（并行循环）、parallel_reduce（并行归约）、parallel_scan（并行前缀扫描）、parallel_sort（并行排序）、parallel_pipeline（并行流水线）、parallel_invoke（并行调用一组函数）。支持多种分区策略（auto/affinity/simple/static_partitioner）。",
        "evidence": [
          "include/oneapi/tbb/parallel_for.h",
          "include/oneapi/tbb/parallel_for_each.h",
          "include/oneapi/tbb/parallel_reduce.h",
          "include/oneapi/tbb/parallel_scan.h",
          "include/oneapi/tbb/parallel_sort.h",
          "include/oneapi/tbb/parallel_pipeline.h",
          "include/oneapi/tbb/parallel_invoke.h",
          "include/oneapi/tbb/partitioner.h"
        ]
      },
      {
        "name": "并发容器",
        "description": "提供线程安全的数据结构：concurrent_hash_map / concurrent_unordered_map / concurrent_map（并发散列表/映射）、concurrent_queue / concurrent_bounded_queue（并发队列）、concurrent_vector（并发动态数组）、concurrent_set / concurrent_unordered_set（并发集合）、concurrent_priority_queue（并发优先级队列）、concurrent_lru_cache（并发 LRU 缓存）。同时提供 combinable（线程局部归约变量）和 enumerable_thread_specific（线程局部存储）。",
        "evidence": [
          "include/oneapi/tbb/concurrent_hash_map.h",
          "include/oneapi/tbb/concurrent_unordered_map.h",
          "include/oneapi/tbb/concurrent_queue.h",
          "include/oneapi/tbb/concurrent_vector.h",
          "include/oneapi/tbb/concurrent_set.h",
          "include/oneapi/tbb/concurrent_priority_queue.h",
          "include/oneapi/tbb/concurrent_lru_cache.h",
          "include/oneapi/tbb/combinable.h",
          "include/oneapi/tbb/enumerable_thread_specific.h"
        ]
      },
      {
        "name": "同步原语（互斥锁）",
        "description": "提供多种互斥量与读写锁：mutex / spin_mutex / queuing_mutex（公平排队锁）/ null_mutex（空占位锁）、rw_mutex / spin_rw_mutex / queuing_rw_mutex / null_rw_mutex。此外还有 collaborative_call_once（协作式一次性初始化）和部分硬件 RTM 支持（rtm_mutex / rtm_rw_mutex）。",
        "evidence": [
          "include/oneapi/tbb/mutex.h",
          "include/oneapi/tbb/spin_mutex.h",
          "include/oneapi/tbb/queuing_mutex.h",
          "include/oneapi/tbb/rw_mutex.h",
          "include/oneapi/tbb/spin_rw_mutex.h",
          "include/oneapi/tbb/queuing_rw_mutex.h",
          "include/oneapi/tbb/null_mutex.h",
          "src/tbb/rtm_mutex.cpp",
          "src/tbb/rtm_rw_mutex.cpp"
        ]
      },
      {
        "name": "内存分配器",
        "description": "tbbmalloc 是专为多线程优化的可伸缩内存分配器，替代系统 malloc 以降低竞争。tbbmalloc_proxy 通过 LD_PRELOAD / 链接替换拦截标准 C 内存分配调用。提供 cache_aligned_allocator / tbb_allocator / scalable_allocator 等 C++ 分配器适配，以及 memory_pool 内存池。支持 NUMA 感知的 numa_allocation。",
        "evidence": [
          "src/tbbmalloc/frontend.cpp",
          "src/tbbmalloc/backend.cpp",
          "src/tbbmalloc_proxy/proxy.cpp",
          "include/oneapi/tbb/cache_aligned_allocator.h",
          "include/oneapi/tbb/tbb_allocator.h",
          "include/oneapi/tbb/scalable_allocator.h",
          "include/oneapi/tbb/memory_pool.h",
          "include/oneapi/tbb/numa_allocation.h"
        ]
      },
      {
        "name": "流图（Flow Graph）",
        "description": "提供基于任务依赖的流图编程模型：通过 flow_graph 构建节点图（function_node/buffer_node/broadcast_node/join_node 等），数据沿边流动，节点在数据到达时由 TBB 调度器自动并行执行。支持 async_node 与外部事件集成。",
        "evidence": [
          "include/oneapi/tbb/flow_graph.h",
          "include/oneapi/tbb/flow_graph_abstractions.h"
        ]
      },
      {
        "name": "CPU 拓扑绑定与 NUMA 感知",
        "description": "tbbbind 库利用 hwloc 获取 CPU 拓扑信息并绑定线程到特定核心，提升计算密集型负载的缓存命中率。info.h 提供 system_topology() 运行时查询。numa_allocation 支持按 NUMA 节点分配内存。",
        "evidence": [
          "src/tbbbind/tbb_bind.cpp",
          "include/oneapi/tbb/info.h",
          "include/oneapi/tbb/numa_allocation.h",
          "src/tbb/numa_allocation.cpp"
        ]
