  "function_summary": {
    "summary": "fontkit 是一个纯 JavaScript 实现的高级字体引擎，专为 Node.js 和浏览器环境设计。它能够解析多种字体格式（TrueType、OpenType、WOFF、WOFF2、TrueType Collection、Datafork TrueType），提供字符到字形的映射、高级 OpenType 和 Apple Advanced Typography (AAT) 字形替换与定位、字形矢量路径提取（可转为 SVG 路径或渲染到 Canvas）、彩色字形（如 emoji）支持、可变字体（variation fonts）支持以及字体子集化等功能。该库由 PDFKit 项目采用，是 Node.js 生态中功能最为完整的开源字体处理库之一。",
    "categories": [
      {
        "name": "字体文件解析",
        "description": "支持 TrueType (.ttf)、OpenType (.otf)、WOFF (.woff)、WOFF2 (.woff2)、TrueType Collection (.ttc) 和 Datafork TrueType (.dfont) 六种字体格式的解析。自动探测字体格式并返回对应字体对象。",
        "evidence": [
          "src/index.js:9-13 (registerFormat 注册五种字体格式处理器)",
          "src/base.js:10-24 (create 函数自动探测并实例化字体格式)",
          "src/WOFFFont.js (WOFF 格式解析，解压 zlib 数据流)",
          "src/WOFF2Font.js (WOFF2 格式解析，brotli 解压)"
        ]
      },
      {
        "name": "OpenType 字形替换与定位 (GSUB/GPOS)",
        "description": "实现 OpenType 字形替换（GSUB 表）和字形定位（GPOS 表）处理引擎。支持标准 OpenType 功能标签的开启/关闭，提供布局引擎进行复杂文本排版。",
        "evidence": [
          "src/opentype/GSUBProcessor.js (GSUB 处理)",
          "src/opentype/GPOSProcessor.js (GPOS 处理)",
          "src/opentype/OTLayoutEngine.js (OpenType 布局引擎)",
          "src/layout/LayoutEngine.js (布局引擎调度)"
        ]
      },
      {
        "name": "AAT 字形替换 (morx 表)",
        "description": "支持 Apple Advanced Typography (AAT) 规范中的 morx 表，处理 Apple 平台的字形替换特性。包含特征映射、状态机查找表等实现。",
        "evidence": [
          "src/aat/AATMorxProcessor.js (morx 处理核心)",
          "src/aat/AATLayoutEngine.js (AAT 布局引擎)",
          "src/aat/AATStateMachine.js (AAT 状态机)",
          "src/aat/AATFeatureMap.js (AAT 特征映射)"
        ]
      },
      {
        "name": "复杂文本塑造 (Shaper)",
        "description": "支持多种文字系统的文本塑造，包括阿拉伯语、梵文系文字（天城文、孟加拉文等）、朝鲜语谚文以及通用塑造器。每种塑造器实现对应的 OpenType 塑造规则。",
        "evidence": [
          "src/opentype/shapers/ArabicShaper.js (阿拉伯/蒙古/叙利亚文塑造)",
          "src/opentype/shapers/IndicShaper.js (印度诸文字塑造)",
          "src/opentype/shapers/HangulShaper.js (谚文塑造)",
          "src/opentype/shapers/UniversalShaper.js (通用塑造器)",
          "src/opentype/shapers/index.js (塑造器注册与选择)"
        ]
      },
      {
        "name": "字形路径提取与渲染",
        "description": "从字体中提取字形轮廓矢量路径，支持 TrueType (glyf) 和 PostScript (CFF) 两种轮廓格式。路径可转为 SVG 路径字符串、Canvas 渲染函数或应用矩阵变换。",
        "evidence": [
          "src/glyph/TTFGlyph.js (TrueType 字形解码)",
          "src/glyph/CFFGlyph.js (CFF 字形解码)",
          "src/glyph/Path.js (路径对象，含 toSVG/toFunction 方法)",
          "src/glyph/Glyph.js (render 方法渲染到 Canvas)"
        ]
      },
      {
        "name": "彩色字形 (Emoji) 支持",
        "description": "支持 Apple SBIX 表和 Microsoft COLR 表的彩色 emoji 字形。SBIX 返回位图图像（通常为 PNG），COLR 返回矢量层叠字形。",
        "evidence": [
          "src/glyph/SBIXGlyph.js (SBIX 彩色字形)",
          "src/glyph/COLRGlyph.js (COLR 彩色字形)"
        ]
      },
      {
        "name": "可变字体 (Variation Fonts)",
        "description": "支持 AAT 可变字体，允许用户在重量、宽度等轴上精细调节字形形态。提供变体轴查询、命名变体实例、变体字形坐标处理等功能。",
        "evidence": [
          "src/TTFFont.js:445-548 (variationAxes / namedVariations / getVariation / _variationProcessor)",
          "src/glyph/GlyphVariationProcessor.js (变体字形处理)",
          "src/tables/fvar.js (fvar 变体轴表)",
          "src/tables/gvar.js (gvar 变体轮廓表)"
        ]
      },
      {
        "name": "字体子集化 (Subsetting)",
        "description": "支持从现有字体中提取指定字形生成子集字体。可用于 PDF 嵌入等场景。支持 TrueType 和 CFF 字体的子集化，生成最小化的字体文件。",
        "evidence": [
          "src/subset/Subset.js (子集基类)",
          "src/subset/TTFSubset.js (TrueType 子集)",
          "src/subset/CFFSubset.js (CFF 子集)"
        ]
      }
    ],
    "domain": "字体处理/排版",
    "target_users": "需要解析、操作或生成字体的 JavaScript/Node.js 应用开发者，尤其是 PDF 生成、Web 字体预览和文本排版工具的开发人员",
    "ecosystem": "nodejs"
