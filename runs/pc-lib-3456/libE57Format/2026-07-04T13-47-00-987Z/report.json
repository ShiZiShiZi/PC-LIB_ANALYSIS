  "function_summary": {
    "summary": "libE57Format 是一个 C++ 库，用于在 Linux、macOS 和 Windows 上读写 ASTM E57 标准文件。E57 文件主要存储 3D 成像系统（如激光扫描仪）产生的点云数据、点属性（颜色、强度）以及 2D 图像。库对外提供底层节点树 API（ImageFile、StructureNode、VectorNode、CompressedVectorNode 等）和更高层的 Simple API（e57::Reader / e57::Writer），方便 C++ 应用集成点云数据的导入导出。",
    "categories": [
      {
        "name": "E57 文件核心读写",
        "description": "打开、创建、关闭 E57 文件，管理文件根节点与扩展注册，提供 ImageFile 入口类",
        "evidence": [
          "include/E57Format.h",
          "src/ImageFile.cpp",
          "src/ImageFileImpl.cpp"
        ]
      },
      {
        "name": "节点树数据模型",
        "description": "通过 StructureNode、VectorNode、CompressedVectorNode、IntegerNode、ScaledIntegerNode、FloatNode、StringNode、BlobNode 等类型构建和操作 E57 文件中的层次化数据树",
        "evidence": [
          "include/E57Format.h",
          "src/NodeImpl.cpp",
          "src/StructureNodeImpl.cpp",
          "src/VectorNodeImpl.cpp"
        ]
      },
      {
        "name": "3D 点云数据存取",
        "description": "读写 Data3D 块，支持 Cartesian/Spherical 坐标、强度、颜色、法线、分组等字段的压缩向量读写",
        "evidence": [
          "include/E57SimpleData.h",
          "src/E57SimpleReader.cpp",
          "src/E57SimpleWriter.cpp",
          "src/ReaderImpl.cpp",
          "src/WriterImpl.cpp"
        ]
      },
      {
        "name": "2D 图像存取",
        "description": "读写 Image2D 块，支持 JPEG/PNG 视觉参考、针孔、球面、圆柱等投影模型的图像数据",
        "evidence": [
          "include/E57SimpleData.h",
          "src/E57SimpleReader.cpp",
          "src/E57SimpleWriter.cpp"
        ]
      },
      {
        "name": "XML 元数据解析",
        "description": "使用 Xerces-C++ SAX2 解析 E57 文件头部 XML 段，将 XML 结构转换为节点树",
        "evidence": [
          "src/E57XmlParser.cpp",
          "src/E57XmlParser.h"
        ]
      },
      {
        "name": "校验和与数据完整性",
        "description": "对物理页计算并校验 CRC32C 校验和，提供多种校验策略（None/Sparse/Half/All）",
        "evidence": [
          "src/CheckedFile.cpp",
          "extern/CRCpp/inc/CRC.h"
        ]
      },
      {
        "name": "Simple 高层封装 API",
        "description": "面向常见使用场景的高层 Reader/Writer 类，封装 Data3D/Image2D 的读写流程",
        "evidence": [
          "include/E57SimpleReader.h",
          "include/E57SimpleWriter.h"
        ]
      }
    ],
    "domain": "3D 点云数据 / 文件格式",
    "target_users": "需要读写 E57 点云文件的 C++ 应用开发者、CAD/测绘/三维重建工具"
  },
