  "function_summary": {
    "summary": "G'MIC 是一个全功能开源数字图像处理框架，核心以 C++ 库（libgmic）形式提供，可被第三方程序链接调用；同时附带 gmic 命令行接口。它支持从 1D 信号到 3D+t 多光谱体数据的通用图像数据集处理，内置上千条图像处理命令与滤镜管道，并可通过 G'MIC 脚本语言扩展。",
    "categories": [
      {
        "name": "图像处理引擎",
        "description": "核心 C++ 实现，提供滤波、形态学、几何变换、色彩处理、修复、渲染、数学形态学等像素级与高层图像算法。",
        "evidence": [
          "src/gmic.cpp",
          "src/gmic.h:300",
          "README.md:12"
        ]
      },
      {
        "name": "G'MIC 脚本解释器",
        "description": "解析并执行 G'MIC 命令语言，支持变量、流程控制、自定义命令、宏表达式与并行管线。",
        "evidence": [
          "src/gmic.cpp:4053",
          "src/gmic_stdlib.gmic"
        ]
      },
      {
        "name": "公共 C++/C API",
        "description": "通过 gmic.h 向第三方暴露 gmic 类、gmic_image、gmic_list 与 gmic_exception，支持头文件直插或动态/静态链接。",
        "evidence": [
          "src/gmic.h:89",
          "src/gmic.h:300",
          "src/use_libgmic.cpp"
        ]
      },
      {
        "name": "命令行工具",
        "description": "gmic CLI 入口，负责参数解析、资源文件加载、异常处理与解释器调用。",
        "evidence": [
          "src/gmic_cli.cpp:80",
          "CMakeLists.txt:317"
        ]
      },
      {
        "name": "标准库命令集",
        "description": "gmic_stdlib.gmic 提供预定义滤镜与算法命令，是 G'MIC 生态的默认脚本标准库。",
        "evidence": [
          "src/gmic_stdlib.gmic",
          "CMakeLists.txt:78"
        ]
      },
      {
        "name": "可选图像编解码",
        "description": "通过可选依赖 PNG、JPEG、TIFF、ZLIB 读写常见图像格式。",
        "evidence": [
          "CMakeLists.txt:82",
          "CMakeLists.txt:199",
          "CMakeLists.txt:205",
          "CMakeLists.txt:211"
        ]
      },
      {
        "name": "可选并行、网络与显示",
        "description": "通过 OpenMP 多线程加速，libcurl 下载网络资源，X11/GDI/SDL 提供可选图像显示能力。",
        "evidence": [
          "CMakeLists.txt:188",
          "CMakeLists.txt:229",
          "CMakeLists.txt:236",
          "src/Makefile:235"
        ]
      }
    ],
    "domain": "graphics",
    "target_users": "图像处理应用开发者、摄影师、设计师与科研人员，以及需要将图像处理算法集成到自身软件的 C++ 开发者。"
