  "function_summary": {
    "summary": "Ant Design Vue 是 Ant Design 设计规范的 Vue 3 实现，提供 60+ 个高质量企业级 UI 组件（按钮、表格、表单、弹窗、日期选择、菜单等），支持 SSR、Electron 及现代浏览器。面向 Vue 3 生态的 Web 应用开发者，专注于构建中后台管理界面与桌面端企业应用的前端 UI 层。",
    "categories": [
      {
        "name": "通用组件",
        "description": "基础 UI 原子组件，包括按钮 (Button)、图标 (Icon)、排版 (Typography)、分割线 (Divider)、间距 (Space)、弹性布局 (Flex) 等。",
        "evidence": [
          "components/button/",
          "components/icon/",
          "components/typography/",
          "components/divider/",
          "components/space/",
          "components/flex/"
        ]
      },
      {
        "name": "布局组件",
        "description": "页面布局体系，包括栅格系统 (Grid/Row/Col)、布局壳 (Layout/Sider) 等。",
        "evidence": [
          "components/grid/",
          "components/layout/"
        ]
      },
      {
        "name": "导航组件",
        "description": "页面导航与定位组件，包括锚点 (Anchor)、面包屑 (Breadcrumb)、菜单 (Menu)、分页 (Pagination)、步骤条 (Steps)、标签页 (Tabs)、固钉 (Affix) 等。",
        "evidence": [
          "components/anchor/",
          "components/breadcrumb/",
          "components/menu/",
          "components/pagination/",
          "components/steps/",
          "components/tabs/",
          "components/affix/"
        ]
      },
      {
        "name": "数据录入",
        "description": "表单与数据收集组件，包括表单 (Form)、输入框 (Input)、选择器 (Select)、级联选择 (Cascader)、日期选择器 (DatePicker)、开关 (Switch)、上传 (Upload)、评分 (Rate)、滑块 (Slider)、穿梭框 (Transfer)、树选择 (TreeSelect)、颜色选择器 (@simonwep/pickr)、数字输入 (InputNumber) 等。",
        "evidence": [
