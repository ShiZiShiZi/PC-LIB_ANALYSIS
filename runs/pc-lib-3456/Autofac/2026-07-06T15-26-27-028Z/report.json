  "function_summary": {
    "summary": "Autofac 是面向 Microsoft .NET 平台的控制反转（IoC）容器库，通过将 .NET 类视为可组合的组件来管理类之间的依赖关系，使应用在规模和复杂度增长时仍保持良好的可维护性。它提供类型注册、依赖解析、生命周期范围管理、装饰器、开放泛型支持、程序集扫描等核心 IoC 功能，并通过 NuGet 包分发。",
    "categories": [
      {
        "name": "组件注册与构建",
        "description": "通过 ContainerBuilder 流式 API 注册类型、实例、委托工厂等组件，支持模块化注册与构建回调",
        "evidence": [
          "src/Autofac/ContainerBuilder.cs",
          "src/Autofac/Builder/RegistrationBuilder.cs",
          "src/Autofac/Builder/IRegistrationBuilder.cs"
        ]
      },
      {
        "name": "依赖解析与管道",
        "description": "实现解析管道（resolve pipeline）机制，包含循环依赖检测、实例共享、作用域选择等中间件，从容器或嵌套作用域中解析服务实例",
        "evidence": [
          "src/Autofac/Core/Resolving/ResolvePipeline.cs",
          "src/Autofac/Core/Resolving/Middleware/CircularDependencyDetectorMiddleware.cs",
          "src/Autofac/ResolutionExtensions.cs"
        ]
      },
      {
        "name": "生命周期范围管理",
        "description": "提供嵌套的 lifetime scope 机制管理组件实例的生命周期（瞬时/单例/每作用域），自动释放 IDisposable 资源",
        "evidence": [
          "src/Autofac/Core/Lifetime/LifetimeScope.cs",
          "src/Autofac/ILifetimeScope.cs",
          "src/Autofac/Core/Lifetime/CurrentScopeLifetime.cs"
        ]
      },
      {
        "name": "装饰器与适配器",
        "description": "支持注册装饰器（decorator）对已注册组件进行包装增强，以及轻量级适配器模式转换服务类型",
        "evidence": [
          "src/Autofac/Features/Decorators/DecoratorService.cs",
          "src/Autofac/Features/Decorators/DecoratorMiddleware.cs",
          "src/Autofac/Features/LightweightAdapters/LightweightAdapterRegistrationSource.cs"
        ]
      },
      {
        "name": "开放泛型与程序集扫描",
        "description": "支持开放泛型类型注册与解析、程序集批量扫描注册，以及按条件/属性过滤的注册",
        "evidence": [
          "src/Autofac/Features/OpenGenerics/OpenGenericRegistrationSource.cs",
          "src/Autofac/Features/Scanning/ScanningRegistrationExtensions.cs",
          "src/Autofac/Features/OpenGenerics/OpenGenericServiceBinder.cs"
        ]
      },
      {
        "name": "诊断追踪",
        "description": "基于 System.Diagnostics.DiagnosticSource 的诊断事件体系，支持解析操作追踪与性能度量",
        "evidence": [
          "src/Autofac/Diagnostics/DefaultDiagnosticTracer.cs",
          "src/Autofac/Diagnostics/DiagnosticSourceExtensions.cs",
          "src/Autofac/Diagnostics/AutofacMetrics.cs"
        ]
      },
      {
        "name": "关系类型支持",
        "description": "内置支持 IEnumerable/ILazy/Func/Owned/IIndex/Meta 等关系类型的自动解析，无需额外注册",
        "evidence": [
          "src/Autofac/Features/Collections/CollectionRegistrationSource.cs",
          "src/Autofac/Features/LazyDependencies/LazyRegistrationSource.cs",
          "src/Autofac/Features/OwnedInstances/Owned.cs"
        ]
      }
    ],
    "domain": "dependency_injection",
    "target_users": ".NET 应用开发者及框架集成者"
  },
