  "function_summary": {
    "summary": "Autofac 是 .NET 生态中最流行的 IoC/DI 容器之一，提供声明式的组件注册、自动化构造函数注入、生命周期管理以及 AOP 拦截等企业级功能。它通过容器（Container）和生命周期作用域（LifetimeScope）管理服务实例的创建与销毁，支持程序集扫描自动注册、装饰器模式、元数据筛选和键控服务（Keyed Service），适用于从简单到复杂的 .NET 应用。",
    "categories": [
      {
        "name": "依赖注入与组件注册",
        "description": "支持 Lambda 表达式注册、类型注册、实例注册和程序集扫描批量注册；提供可配置的构造函数选择器、属性注入与泛型注册。",
        "evidence": [
          "src/Autofac/ContainerBuilder.cs",
          "src/Autofac/RegistrationExtensions.cs",
          "src/Autofac/Builder/RegistrationBuilder.cs",
          "src/Autofac/Features/Scanning/ScanningRegistrationExtensions.cs"
        ]
      },
      {
        "name": "生命周期管理",
        "description": "提供多种生命周期策略（单例、每次依赖、每次生命周期作用域、每次匹配作用域、每次所有者），通过 ILifetimeScope 管理组件实例的创建与释放。",
        "evidence": [
          "src/Autofac/Core/Lifetime/LifetimeScope.cs",
          "src/Autofac/Core/Lifetime/CurrentScopeLifetime.cs",
          "src/Autofac/Core/Lifetime/MatchingScopeLifetime.cs"
        ]
      },
      {
        "name": "特性与元数据筛选",
        "description": "通过特性（Attribute）对服务进行元数据标记和参数筛选，支持基于元数据的服务过滤和 KeyFilter 键控筛选。",
        "evidence": [
          "src/Autofac/Features/AttributeFilters/KeyFilterAttribute.cs",
          "src/Autofac/Features/AttributeFilters/MetadataFilterAttribute.cs",
          "src/Autofac/Features/Metadata/MetadataViewProvider.cs"
        ]
      },
      {
        "name": "装饰器与拦截器",
        "description": "提供装饰器模式支持，允许对已注册服务进行包装增强；支持 AOP 风格的拦截器。",
        "evidence": [
          "src/Autofac/Features/Decorators/DecoratorMiddleware.cs",
          "src/Autofac/Features/Decorators/OpenGenericDecoratorMiddlewareSource.cs"
        ]
      },
      {
        "name": "诊断与可观测性",
        "description": "内置集成 System.Diagnostics.DiagnosticListener，支持对解析请求的完整事件追踪，便于调试和性能监控。",
        "evidence": [
          "src/Autofac/Diagnostics/DiagnosticSourceExtensions.cs",
          "src/Autofac/Diagnostics/DefaultDiagnosticTracer.cs"
        ]
      }
    ],
    "domain": "开发框架 / 依赖注入",
    "target_users": ".NET 开发者与架构师，构建从控制台应用到 ASP.NET Core 微服务的各类应用"
  },
