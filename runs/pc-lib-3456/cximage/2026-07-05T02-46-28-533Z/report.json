  "function_summary": {
    "summary": "CxImage 是一个 C++ 图像处理库，提供二十余种图像格式的编解码、像素级操作、图像变换（缩放/旋转/裁切/镜像）、颜色量化与抖动、特效滤镜（模糊/锐化/浮雕/噪声）以及透明/Alpha 通道处理。同时提供 Windows GDI 集成接口（Draw/MakeBitmap/MakeIcon）和内存文件抽象，广泛用于需要图像支持且不依赖庞大框架的桌面应用、嵌入式及服务端场景。核心库约 4.2 万行生产代码，内嵌 jpeg/png/tiff/zlib 等格式库的源码拷贝，依赖自包含无需外部安装。",
    "categories": [
      {
        "name": "多格式图像编解码",
        "description": "支持 BMP、GIF、JPEG、PNG、TIFF、ICO、TGA、PCX、WBMP、WMF/EMF、JPEG2000 (JP2/JPC/PGX/PNM/RAS)、JBIG、MNG、JBG、SKA、RAW 相机原始格式、PSD 等多种格式的读取与写出，格式覆盖通过编译宏按需开启",
        "evidence": [
          "CxImage/ximaenc.cpp:8-70 (格式 include 条件编译)",
          "CxImage/ximage.h:71-164 (CXIMAGE_FORMAT 枚举)",
          "CxImage/ximacfg.h:20-43 (格式开关宏)"
        ]
      },
      {
        "name": "像素级操作与绘制",
        "description": "支持逐像素读写、直线绘制、矩形填充、像素混合(alpha blend)、调色板操作及色彩空间转换(RGB↔BGR, GrayScale, 颜色量化)；包含 18 种插值算法（双线性/双三次/Lanczos/B-Spline 等）",
        "evidence": [
          "CxImage/ximage.h:395-410 (Pixel 接口)",
          "CxImage/ximage.h:426-491 (OverflowMethod/InterpolationMethod/Kernels)",
          "CxImage/ximage.h:577-600 (BasicTransformations)"
        ]
      },
      {
        "name": "图像变换与几何操作",
        "description": "缩放、旋转（任意角度）、裁切、镜像翻转、错切(skew)、任意四点透视变形等几何变换，支持直接替换或生成新图像",
        "evidence": [
          "CxImage/ximage.h:601-660 (Transformations)",
          "CxImage/ximatran.cpp",
          "CxImage/ximage.h:668-678 (DSP 特效)"
        ]
      },
      {
        "name": "特效滤镜与图像处理",
        "description": "模糊、锐化、浮雕、边缘检测、中值滤波、噪声添加/去除、对比度/亮度/伽马调整、色彩均衡、红眼消除、直方图均衡化等数字图像处理算子",
        "evidence": [
          "CxImage/ximage.h:668-678 (DSP)",
          "CxImage/ximadsp.cpp",
          "CxImage/ximahist.cpp"
        ]
      },
      {
        "name": "Windows GDI 集成",
        "description": "提供 HBITMAP/HICON 与 GDI DC 的互操作：从 HBITMAP/HICON 创建图像、将图像绘制到 HDC（支持 stretch/tile/draw2）、生成 MakeBitmap/MakeIcon/CopyToHandle，以及 Windows 资源加载",
        "evidence": [
          "CxImage/ximage.h:493-518 (Painting/CXIMAGE_SUPPORT_WINDOWS)",
          "CxImage/ximawnd.cpp:63-800",
          "CxImage/ximage.h:524-527 (LoadResource)"
        ]
      },
      {
        "name": "透明/Alpha 通道与图层",
        "description": "支持每像素 8 位透明度 (Alpha)、调色板级透明索引、背景色透明；内建图层(layer)管理与动画帧(frame)操作，支持多页 TIFF/GIF/MNG/ICO",
        "evidence": [
          "CxImage/ximage.h:775-790 (layers)",
          "CxImage/ximalpha.cpp",
          "CxImage/ximalyr.cpp",
          "CxImage/ximage.h:195-228 (frame/layer info)"
        ]
      },
      {
        "name": "内存与流 I/O 抽象",
        "description": "提供 CxFile 虚基类抽象文件 I/O，内建 CxIOFile (stdio FILE*) 和 CxMemFile (内存块) 实现；编解码通过此抽象解耦物理存储",
        "evidence": [
          "CxImage/xfile.h:53-77 (CxFile)",
          "CxImage/xiofile.h:7-124 (CxIOFile)",
          "CxImage/xmemfile.h:7-42 (CxMemFile)"
        ]
      }
    ],
    "domain": "图像处理/图形",
    "target_users": "C++ 桌面应用与嵌入式开发者，需要多格式图像编解码与处理能力但不依赖大型框架的场景"
  },
