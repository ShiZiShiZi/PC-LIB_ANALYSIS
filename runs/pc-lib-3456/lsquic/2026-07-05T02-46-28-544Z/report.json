  "function_summary": {
    "summary": "lsquic 是 LiteSpeed Technologies 开发的开源 C 库，实现 QUIC 传输协议与 HTTP/3 应用层协议，支持 RFC 9000/9001/9002/9114/9204 等标准及 Q043/Q046/Q050 等 Google QUIC 旧版本。提供完整的客户端与服务端 API（基于回调的事件驱动模型），内置多种拥塞控制算法（Cubic/BBR/自适应）、QPACK 头部压缩、0-RTT 恢复、连接迁移、WebTransport 等功能，被 LiteSpeed Web Server/ADC/OpenLiteSpeed 等产品使用。",
    "categories": [
      {
        "name": "QUIC 传输协议引擎",
        "description": "完整实现 QUIC 传输层，包括数据包编解码、拥塞控制、流控、丢包检测与重传、连接迁移、路径 MTU 发现等核心传输功能",
        "evidence": [
          "src/liblsquic/lsquic_engine.c",
          "src/liblsquic/lsquic_conn.c",
          "src/liblsquic/lsquic_stream.c",
          "src/liblsquic/lsquic_send_ctl.c"
        ]
      },
      {
        "name": "HTTP/3 协议支持",
        "description": "在 QUIC 之上实现 HTTP/3（RFC 9114），包括 QPACK 头部压缩（RFC 9204）、HTTP/1.x 适配层、可扩展优先级、服务器推送（API 接口保留）",
        "evidence": [
          "src/liblsquic/lsquic_http.c",
          "src/liblsquic/lsquic_http1x_if.c",
          "src/liblsquic/lsquic_qdec_hdl.c",
          "src/liblsquic/lsquic_qenc_hdl.c"
        ]
      },
      {
        "name": "TLS 握手与加密",
        "description": "通过 BoringSSL 或 OpenSSL 实现 TLS 1.3 握手，支持 QUIC-TLS 集成、证书验证、会话恢复、0-RTT、密钥协商、HKDF 密钥派生",
        "evidence": [
          "src/liblsquic/lsquic_handshake.c",
          "src/liblsquic/lsquic_crypto.c",
          "src/liblsquic/lsquic_hkdf.c"
        ]
      },
      {
        "name": "拥塞控制算法",
        "description": "内置 Cubic、BBR v1 及自适应拥塞控制（根据 RTT 自动在 Cubic 与 BBR 间切换），可配合带宽采样器与包调速器",
        "evidence": [
          "src/liblsquic/lsquic_cubic.c",
          "src/liblsquic/lsquic_bbr.c",
          "src/liblsquic/lsquic_adaptive_cc.c",
          "src/liblsquic/lsquic_bw_sampler.c",
          "src/liblsquic/lsquic_pacer.c"
        ]
      },
      {
        "name": "协议扩展",
        "description": "支持 QUIC 不可靠数据报（RFC 9221）、WebTransport、版本协商（RFC 9368）、QUIC v2（RFC 9369）、延迟 ACK、时间戳、ECN、greasing 等扩展",
        "evidence": [
          "src/liblsquic/lsquic_full_conn_ietf.c",
          "src/liblsquic/lsquic_spi.c",
          "src/liblsquic/lsquic_qlog.c",
          "include/lsquic.h"
        ]
      },
      {
        "name": "跨平台事件驱动 API",
        "description": "提供回调驱动的 C API：应用注册 on_new_conn/on_read/on_write 等回调，库管理 I/O 调度；同时提供示例 CLI 工具（http_client/http_server）",
        "evidence": [
          "include/lsquic.h",
          "bin/echo_client.c",
          "bin/echo_server.c",
          "bin/http_client.c",
          "bin/http_server.c"
        ]
      }
    ],
    "domain": "网络传输协议",
    "target_users": "网络应用与服务开发者（需要 QUIC/HTTP/3 传输能力的 C/C++ 项目）",
    "ecosystem": "cpp"
  },
