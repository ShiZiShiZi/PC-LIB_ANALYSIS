  "function_summary": {
    "summary": "Graphite2 是 SIL International 开发的智能字体渲染引擎，通过编译后的 Graphite 描述语言（GDL）规则驱动 TrueType 字体的复杂文字排版。它提供稳定的 C ABI 公共接口，供文本排版应用（如 LibreOffice、Firefox）调用，实现上下文字形塑形、连字、重排、双向文本、分音符号碰撞避免、断行与对齐等高级文字处理功能。同时提供 Python 绑定（pip 可安装）和 C# 包装（contrib/）作为多语言使用入口。",
    "categories": [
      {
        "name": "字体面（Face）管理与字体表解析",
        "description": "从应用提供的回调或文件路径加载 TrueType/OpenType 字体，解析 cmap、name、glyf/loca、Silf 等核心表；支持压缩表（LZ4）解压、缓存和预加载选项。",
        "evidence": [
          "include/graphite2/Font.h",
          "src/Face.cpp",
          "src/FileFace.cpp",
          "src/CmapCache.cpp",
          "src/GlyphCache.cpp"
        ]
      },
      {
        "name": "字体实例化与度量",
        "description": "根据指定 ppm 创建字体实例，支持应用提供自定义 glyph advance 回调以获取 hinting 度量；提供字体升降（ascent/descent）和 UPEM 查询。",
        "evidence": [
          "include/graphite2/Font.h",
          "src/Font.cpp",
          "src/gr_font.cpp",
          "src/GlyphFace.cpp"
        ]
      },
      {
        "name": "文本段（Segment）排版",
        "description": "对输入字符串（UTF-8/16/32）创建文本段，按指定脚本/语言/特性值执行 GDL 规则引擎的排版 pass（字形替换、定位、游标跟踪）；支持 RTL 回退和双向文本镜像。",
        "evidence": [
          "include/graphite2/Segment.h",
          "src/Segment.cpp",
          "src/gr_segment.cpp",
          "src/Slot.cpp",
          "src/Code.cpp"
        ]
      },
      {
        "name": "字形槽（Slot）查询",
        "description": "遍历排版后的字形槽链表与父子附着树，获取每个槽的字形 ID、定位坐标（origin）、advance、断行权重、bidi 层级等属性。",
        "evidence": [
          "include/graphite2/Segment.h",
          "src/gr_slot.cpp",
          "src/Slot.cpp"
        ]
      },
      {
        "name": "特性值与语言管理",
        "description": "查询字体中 OpenType 特性（Feature）的定义、取值标签和 UI 名称；按语言标签获取默认特性值集，支持特性值克隆与修改。",
        "evidence": [
          "include/graphite2/Font.h",
          "src/gr_features.cpp",
          "src/FeatureMap.cpp",
          "src/NameTable.cpp"
        ]
      },
      {
        "name": "碰撞避免与断行对齐",
        "description": "基于碰撞检测的自动分音符号避让（Shift/Kern Collider）；支持宽度对齐的断行（justification）和 line-end contextual 规则处理。",
        "evidence": [
          "src/Collider.cpp",
          "src/Justifier.cpp",
          "include/graphite2/Segment.h"
        ]
      },
      {
        "name": "调试与遥测",
        "description": "可选编译启用的 JSON 日志输出（排版 pass 与段详情）和内存用量遥测，供字体开发者调试 GDL 规则。",
        "evidence": [
          "include/graphite2/Log.h",
          "src/gr_logging.cpp",
          "src/json.cpp",
          "src/inc/Main.h"
        ]
      }
    ],
    "domain": "字体引擎/文字排版",
    "target_users": "文本排版应用开发者（浏览器、桌面排版软件、文字处理引擎的集成者）"
  },
