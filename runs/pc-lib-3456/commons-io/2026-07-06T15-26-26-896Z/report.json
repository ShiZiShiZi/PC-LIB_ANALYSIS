  "function_summary": {
    "summary": "Apache Commons IO 是一个 Java I/O 工具库，为 java.io 和 java.nio.file 提供丰富的实用工具类、流实现、文件过滤器、文件比较器和字节序转换等功能。它简化了文件与流的常见操作（读写、复制、删除、遍历、过滤、监控），是 Java 应用开发中最广泛使用的基础 I/O 库之一。",
    "categories": [
      {
        "name": "流操作工具",
        "description": "对 InputStream/OutputStream/Reader/Writer 的通用操作：读写、复制、关闭、转换（Reader↔InputStream、字节↔字符）、缓冲、边界限制、校验和计算、BOM 处理、tailer 追踪等。核心类为 IOUtils 和各种 input/output 包下的流装饰器。",
        "evidence": [
          "src/main/java/org/apache/commons/io/IOUtils.java",
          "src/main/java/org/apache/commons/io/input/",
          "src/main/java/org/apache/commons/io/output/"
        ]
      },
      {
        "name": "文件操作工具",
        "description": "对 java.io.File 和 java.nio.file.Path 的常用操作：复制、移动、删除、遍历目录树、读写文件内容、获取临时目录和用户目录、计算校验和、文件内容比较等。核心类为 FileUtils 和 PathUtils。",
        "evidence": [
          "src/main/java/org/apache/commons/io/FileUtils.java",
          "src/main/java/org/apache/commons/io/file/PathUtils.java"
        ]
      },
      {
        "name": "文件名与路径处理",
        "description": "跨平台文件名规范化、路径拼接、扩展名提取、分隔符转换、路径合法性验证等。核心类为 FilenameUtils 和 FileSystem。",
        "evidence": [
          "src/main/java/org/apache/commons/io/FilenameUtils.java",
          "src/main/java/org/apache/commons/io/FileSystem.java"
        ]
      },
      {
        "name": "文件过滤器与比较器",
        "description": "基于名称、扩展名、大小、修改时间、可读/可写/隐藏属性、通配符、正则表达式等的文件过滤器（IOFileFilter 体系），以及按名称、路径、大小、修改时间排序的文件比较器。",
        "evidence": [
          "src/main/java/org/apache/commons/io/filefilter/",
          "src/main/java/org/apache/commons/io/comparator/"
        ]
      },
      {
        "name": "文件系统监控",
        "description": "对文件系统目录变更的实时监控（创建/删除/修改事件），通过 FileAlterationMonitor 和 FileAlterationObserver 实现。",
        "evidence": [
          "src/main/java/org/apache/commons/io/monitor/FileAlterationMonitor.java",
          "src/main/java/org/apache/commons/io/monitor/FileAlterationObserver.java"
        ]
      },
      {
        "name": "IO 函数式接口与流适配",
        "description": "为 java.util.stream 提供 IOException 安全的函数式接口（IOConsumer、IOFunction、IOPredicate 等）和 IOStream 适配器，便于在流式 API 中处理受检 IO 异常。",
        "evidence": [
          "src/main/java/org/apache/commons/io/function/IOStream.java",
          "src/main/java/org/apache/commons/io/function/IOConsumer.java",
          "src/main/java/org/apache/commons/io/function/Uncheck.java"
        ]
      },
      {
        "name": "字节序与字符集工具",
        "description": "大小端字节序转换、字符集编解码器查询、ByteOrderMark 处理等辅助工具。",
        "evidence": [
          "src/main/java/org/apache/commons/io/EndianUtils.java",
          "src/main/java/org/apache/commons/io/ByteOrderMark.java",
          "src/main/java/org/apache/commons/io/charset/"
        ]
      }
    ],
    "domain": "io_utilities",
    "target_users": "Java 应用开发者",
    "ecosystem": "java"
  },
