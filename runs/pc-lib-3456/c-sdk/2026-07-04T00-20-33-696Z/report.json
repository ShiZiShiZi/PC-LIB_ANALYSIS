  "function_summary": {
    "summary": "七牛云对象存储 Kodo 的官方 C/C++ SDK，面向需要把数据安全存放到七牛云的应用程序。它封装了七牛云存储 API，提供 bucket 文件管理、上传（直传/分片/断点续传）、下载、云处理（fop）、CDN 刷新以及 MAC 鉴权等功能，以 C 函数库形式供其它程序链接调用。",
    "categories": [
      {
        "name": "对象存储文件上传",
        "description": "支持从本地文件、内存缓冲或自定义流上传对象；提供直传、分片上传（multipart upload）以及断点续传能力，可配置上传加速、区域、超时与重试。",
        "evidence": [
          "qiniu/io.h:88",
          "qiniu/io.c:239",
          "qiniu/multipart_upload.h",
          "qiniu/multipart_upload.c",
          "qiniu/resumable_io.h",
          "qiniu/resumable_io.c"
        ]
      },
      {
        "name": "bucket 资源管理",
        "description": "对 bucket 内文件进行 stat、copy、move、delete、fetch、prefetch 等操作，并支持批量操作接口。",
        "evidence": [
          "qiniu/rs.h:92",
          "qiniu/rs.h:175",
          "qiniu/rs.c",
          "qiniu/rsf.h",
          "qiniu/rsf.c"
        ]
      },
      {
        "name": "鉴权与安全",
        "description": "基于 AccessKey/SecretKey 的 MAC 签名（HMAC-SHA1）以及上传凭证（uptoken）鉴权，并通过 OpenSSL 提供 MD5/SHA1 摘要辅助。",
        "evidence": [
          "qiniu/auth_mac.c",
          "qiniu/crypto.c",
          "qiniu/http.h:193",
          "qiniu/private/crypto.h"
        ]
      },
      {
        "name": "HTTP 客户端与区域调度",
        "description": "基于 libcurl 的 HTTP/HTTPS 客户端，内置区域（Region）查询与缓存、主备域名切换、低速检测和 NIC 绑定。",
        "evidence": [
          "qiniu/http.c:71",
          "qiniu/http.c:95",
          "qiniu/region.c",
          "qiniu/conf.c"
        ]
      },
      {
        "name": "云处理与 CDN",
        "description": "提供持久化云处理（persistent ops）回调解析以及 CDN 刷新/预取接口封装。",
        "evidence": [
          "qiniu/fop.h",
          "qiniu/fop.c",
          "qiniu/cdn.h",
          "qiniu/cdn.c"
        ]
      },
      {
        "name": "通用工具与数据结构",
        "description": "内部集成 base64、JSON 解析、hashmap、CRC32、读写缓冲、文件分块读取与日志等基础能力，供上层接口使用。",
        "evidence": [
          "b64/b64.h",
          "cJSON/cJSON.h",
          "hashmap/hashmap.h",
          "qiniu/base.h",
          "qiniu/base_io.c"
        ]
      }
    ],
    "domain": "cloud_storage / networking",
    "target_users": "需要集成七牛云对象存储 Kodo 的 C/C++ 后端服务、桌面应用或 IoT 程序开发者。"
  },
