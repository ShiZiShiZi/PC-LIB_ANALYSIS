  "function_summary": {
    "summary": "fastText 是一个面向 NLP 的轻量级机器学习库，核心用 C++17 实现，提供 skipgram/cbow 词向量训练、监督文本分类、模型量化、子词特征提取等功能；同时提供命令行可执行文件 fasttext、Python 绑定（pybind11）以及 WebAssembly/JS 绑定，方便研究与生产集成。",
    "categories": [
      {
        "name": "词表示学习",
        "description": "基于 skipgram 与 cbow 模型学习单词及子词向量，支持负采样、层次 softmax 与 OOV 子词推断。",
        "evidence": [
          "src/fasttext.cc",
          "src/main.cc:22-42",
          "src/model.cc"
        ]
      },
      {
        "name": "监督文本分类",
        "description": "使用线性分类器训练句子级别标签预测，支持多标签、概率输出与 P/R 评估。",
        "evidence": [
          "src/fasttext.cc",
          "src/loss.cc",
          "src/meter.cc"
        ]
      },
      {
        "name": "子词信息建模",
        "description": "通过字符 n-gram 哈希为未登录词生成向量，并扩展词表表示。",
        "evidence": [
          "src/dictionary.cc",
          "src/dictionary.h"
        ]
      },
      {
        "name": "模型量化与压缩",
        "description": "通过乘积量化（product quantization）与量化矩阵减少模型体积与内存占用。",
        "evidence": [
          "src/quantmatrix.cc",
          "src/productquantizer.cc",
          "src/main.cc:24"
        ]
      },
      {
        "name": "多语言词向量对齐",
        "description": "提供有监督与无监督双语/多语词嵌入对齐脚本（基于 NumPy/POT）。",
        "evidence": [
          "alignment/align.py",
          "alignment/unsup_align.py",
          "alignment/README.md"
        ]
      },
      {
        "name": "Python 与 WebAssembly 绑定",
        "description": "通过 pybind11 暴露 C++ API 给 Python，并通过 Emscripten 提供 WebAssembly/JS 绑定。",
        "evidence": [
          "python/fasttext_module/fasttext/pybind/fasttext_pybind.cc",
          "webassembly/fasttext_wasm.cc",
          "setup.py"
        ]
      }
    ],
    "domain": "machine learning / natural language processing",
    "target_users": "NLP 研究者、机器学习开发者及需要轻量文本表示与分类能力的应用工程师"
  },
