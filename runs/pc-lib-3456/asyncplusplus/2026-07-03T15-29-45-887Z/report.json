  "function_summary": {
    "summary": "Async++ 是一个面向 C++11 的轻量级并发框架，提供基于任务的异步编程模型（spawn/then/when_all/when_any）、并行算法（parallel_for/parallel_invoke/parallel_reduce）以及可插拔的调度器（线程池、内联调度器、FIFO 调度器）。其设计受 Microsoft PPL 与 C++ 标准提案 N3428 启发，目标用户是需要在 C++ 应用中表达异步与并行逻辑的开发者。",
    "categories": [
      {
        "name": "任务与异步组合",
        "description": "提供 task/shared_task/event_task 及 spawn、then、when_all、when_any 等原语，用于构建延迟执行与组合式异步流程。",
        "evidence": [
          "include/async++/task.h",
          "include/async++/when_all_any.h",
          "include/async++.h:126-150"
        ]
      },
      {
        "name": "并行算法",
        "description": "提供 parallel_for、parallel_invoke、parallel_reduce 等高层并行算法，并支持 static_partitioner 与 auto_partitioner 进行任务划分。",
        "evidence": [
          "include/async++/parallel_for.h",
          "include/async++/parallel_invoke.h",
          "include/async++/parallel_reduce.h",
          "include/async++/partitioner.h"
        ]
      },
      {
        "name": "调度器抽象",
        "description": "抽象 scheduler 概念，内置 inline_scheduler、thread_scheduler、fifo_scheduler 与 threadpool_scheduler，允许用户自定义任务调度策略。",
        "evidence": [
          "include/async++/scheduler.h",
          "include/async++/scheduler_fwd.h",
          "src/threadpool_scheduler.cpp",
          "src/scheduler.cpp"
        ]
      },
      {
        "name": "线程同步原语",
        "description": "内部基于 std::mutex、std::condition_variable、std::atomic 与内存屏障实现任务等待、工作窃取队列与线程池休眠唤醒。",
        "evidence": [
          "src/task_wait_event.h",
          "src/work_steal_queue.h",
          "src/fifo_queue.h"
        ]
      },
      {
        "name": "取消与异常支持",
        "description": "提供 cancellation_token 与 interruption_point，支持任务取消协议；同时允许在关闭异常时编译为无异常版本。",
        "evidence": [
          "include/async++/cancel.h",
          "include/async++.h:60-83"
        ]
      }
    ],
    "domain": "concurrency / parallelism",
    "target_users": "C++ 应用开发者与其他需要异步/并行能力的 C++ 库"
  },
