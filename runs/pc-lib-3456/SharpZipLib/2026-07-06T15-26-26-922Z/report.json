  "function_summary": {
    "summary": "SharpZipLib（#ziplib）是一个纯 C# 实现的压缩与归档库，面向 .NET 开发者提供 Zip、GZip、BZip2、Tar 及 LZW 格式的压缩和解压缩功能。它不依赖任何原生代码，以 .NET 程序集形式分发（支持 GAC 安装），可被任何 .NET 语言直接引用。库支持 PKZIP 2.0 传统加密与 WinZip AES 加密、Zip64 扩展格式、GNU 长文件名扩展，以及 Deflate/Store 压缩方法。最早从 GNU Classpath java.util.zip 移植而来，后追加 BZip2 和 Tar 支持。",
    "categories": [
      {
        "name": "Zip 压缩与解压缩",
        "description": "完整实现 Zip 格式的创建、读取与更新，支持 Zip64、PKZIP 传统加密及 WinZip AES 加密，提供流式与随机访问两种 API（ZipOutputStream/ZipInputStream 与 ZipFile）",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Zip/ZipFile.cs",
          "src/ICSharpCode.SharpZipLib/Zip/ZipOutputStream.cs",
          "src/ICSharpCode.SharpZipLib/Zip/ZipInputStream.cs",
          "src/ICSharpCode.SharpZipLib/Zip/FastZip.cs"
        ]
      },
      {
        "name": "GZip 压缩与解压缩",
        "description": "提供 GZip 格式的流式压缩与解压缩（GZipOutputStream / GZipInputStream），以及单次调用的便捷方法",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/GZip/GzipOutputStream.cs",
          "src/ICSharpCode.SharpZipLib/GZip/GzipInputStream.cs",
          "src/ICSharpCode.SharpZipLib/GZip/GZip.cs"
        ]
      },
      {
        "name": "BZip2 压缩与解压缩",
        "description": "提供 BZip2 格式的流式压缩与解压缩（BZip2OutputStream / BZip2InputStream），以及单次便捷方法",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/BZip2/BZip2OutputStream.cs",
          "src/ICSharpCode.SharpZipLib/BZip2/BZip2InputStream.cs",
          "src/ICSharpCode.SharpZipLib/BZip2/BZip2.cs"
        ]
      },
      {
        "name": "Tar 归档",
        "description": "完整实现 Tar 归档格式的创建与提取，支持 GNU 长文件名扩展和扩展头（TarArchive / TarInputStream / TarOutputStream）",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Tar/TarArchive.cs",
          "src/ICSharpCode.SharpZipLib/Tar/TarInputStream.cs",
          "src/ICSharpCode.SharpZipLib/Tar/TarOutputStream.cs"
        ]
      },
      {
        "name": "校验和计算",
        "description": "提供 CRC-32、Adler32、BZip2 CRC 校验和算法实现，用于压缩数据完整性验证",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Checksum/Crc32.cs",
          "src/ICSharpCode.SharpZipLib/Checksum/Adler32.cs",
          "src/ICSharpCode.SharpZipLib/Checksum/BZip2Crc.cs"
        ]
      },
      {
        "name": "加密支持",
        "description": "实现 PKZIP 传统加密（PkzipClassic）与 WinZip AES 加密（ZipAESStream/ZipAESTransform），集成 .NET System.Security.Cryptography",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Encryption/PkzipClassic.cs",
          "src/ICSharpCode.SharpZipLib/Encryption/ZipAESStream.cs",
          "src/ICSharpCode.SharpZipLib/Encryption/ZipAESTransform.cs"
        ]
      },
      {
        "name": "LZW 解压缩",
        "description": "提供 LZW（Lempel-Ziv-Welch）格式的解压缩流（LzwInputStream），用于 .Z 压缩文件的读取",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Lzw/LzwInputStream.cs"
        ]
      },
      {
        "name": "核心工具与路径处理",
        "description": "提供文件系统扫描、路径过滤/转换（含 Windows 路径规范化）、流工具、字节序处理、内存池等基础设施",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Core/FileSystemScanner.cs",
          "src/ICSharpCode.SharpZipLib/Core/PathFilter.cs",
          "src/ICSharpCode.SharpZipLib/Zip/WindowsNameTransform.cs",
          "src/ICSharpCode.SharpZipLib/Core/StreamUtils.cs"
        ]
      }
    ],
    "domain": "数据压缩与归档",
    "target_users": ".NET 应用开发者",
    "ecosystem": "dotnet"
  },
