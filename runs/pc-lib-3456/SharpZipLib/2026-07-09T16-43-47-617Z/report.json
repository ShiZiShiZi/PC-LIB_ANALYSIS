  "function_summary": {
    "summary": "SharpZipLib 是一个完全用 C# 实现的压缩与归档类库，提供 Zip（含 AES 加密与 Zip64）、GZip、BZip2、Tar 及 LZW 等多种格式的压缩/解压与归档/解档功能。它源于 GNU Classpath 的 java.util.zip，现以 MIT 协议开源，以纯托管 .NET 程序集形式发布，可无缝集成到任何 .NET 语言项目中。",
    "categories": [
      {
        "name": "Zip 压缩与归档",
        "description": "支持 Zip 格式的创建、读取与更新，包含 Deflate/Store 压缩、PKZIP 2.0 及 WinZip AES 加密、Zip64 大文件支持，以及基于通配符的快速压缩/解压接口（FastZip）。",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Zip/ZipFile.cs",
          "src/ICSharpCode.SharpZipLib/Zip/FastZip.cs",
          "src/ICSharpCode.SharpZipLib/Zip/ZipOutputStream.cs"
        ]
      },
      {
        "name": "GZip 压缩",
        "description": "提供 GZip 格式（RFC 1952）的压缩与解压，兼容 gzip 命令行工具产出的 .gz 文件。",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/GZip/GZip.cs",
          "src/ICSharpCode.SharpZipLib/GZip/GzipOutputStream.cs"
        ]
      },
      {
        "name": "BZip2 压缩",
        "description": "提供 BZip2 格式的块压缩与解压，适合高压缩率场景。",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/BZip2/BZip2.cs",
          "src/ICSharpCode.SharpZipLib/BZip2/BZip2InputStream.cs"
        ]
      },
      {
        "name": "Tar 归档",
        "description": "支持 Tar 格式的创建与读取，兼容 GNU tar 长文件名扩展，可与其他压缩格式组合使用（如 .tar.gz）。",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Tar/TarArchive.cs",
          "src/ICSharpCode.SharpZipLib/Tar/TarOutputStream.cs"
        ]
      },
      {
        "name": "LZW 解压",
        "description": "提供 LZW（Lempel-Ziv-Welch）压缩算法的解压实现，常用于老式 Unix compress（.Z）文件的读取。",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Lzw/LzwInputStream.cs"
        ]
      },
      {
        "name": "校验和",
        "description": "内置 CRC32、Adler32 及 BZip2 专用 CRC 校验和计算，供各压缩格式内部使用。",
        "evidence": [
          "src/ICSharpCode.SharpZipLib/Checksum/Crc32.cs",
          "src/ICSharpCode.SharpZipLib/Checksum/Adler32.cs"
        ]
      }
    ],
    "domain": "压缩与归档",
    "target_users": ".NET 应用开发者",
    "ecosystem": "dotnet"
  },
