  "function_summary": {
    "summary": "geotiff.js 是一个纯 JavaScript 实现的 (Geo)TIFF 图像文件解析与写入库，可在浏览器和 Node.js 环境下运行。它支持从远程 URL、本地 ArrayBuffer、浏览器 Blob/File 以及 Node.js 文件系统等多种数据源读取 TIFF 文件，解析二进制头信息与影像文件目录(IFD)，按需解压并返回栅格像素数据。同时提供地理空间元数据（边界框、原点、分辨率、GeoKey、控制点）、多级概览自动选择、子区域裁剪、重采样、色彩空间转换等功能，并包含 Worker 线程池加速解码和 beta 阶段的 GeoTIFF 写入能力。",
    "categories": [
      {
        "name": "多数据源读取",
        "description": "支持从远程 HTTP URL（通过 fetch / XHR / Node http 模块的字节范围请求）、本地 ArrayBuffer、浏览器 Blob/File 以及 Node.js 文件系统路径读取 TIFF 数据源，统一抽象为 BaseSource 接口",
        "evidence": [
          "src/geotiff.js:694-762",
          "src/source/remote.js",
          "src/source/arraybuffer.js",
          "src/source/file.js",
          "src/source/filereader.js"
        ]
      },
      {
        "name": "TIFF 二进制格式解析",
        "description": "解析 TIFF/BigTIFF 二进制头部（字节序、魔数、IFD 偏移量），按需延迟加载影像文件目录条目（ImageFileDirectory），支持标准 TIFF 和 64 位 BigTIFF 格式",
        "evidence": [
          "src/geotiff.js:397-608",
          "src/imagefiledirectory.js",
          "src/dataview64.js",
          "src/dataslice.js"
        ]
      },
      {
        "name": "栅格数据解压与读取",
        "description": "读取条带（strip）或瓦片（tile）组织的栅格像素数据，支持多种压缩算法：无压缩、PackBits、LZW、Deflate（含浮点预测器）、JPEG、LERC、Zstandard，以及浏览器原生支持的 WebP 等图像格式；支持 8/16/32 位整数、Float16/32/64 及非 8 位对齐的 n-bit 数据类型",
        "evidence": [
          "src/geotiffimage.js",
          "src/compression/index.js",
          "src/compression/deflate.js",
          "src/compression/lzw.js",
          "src/compression/jpeg.js",
          "src/compression/lerc.js",
          "src/compression/zstd.js",
          "src/compression/packbits.js",
          "src/compression/raw.js",
          "src/compression/webimage.js"
        ]
      },
      {
        "name": "地理空间元数据提取",
        "description": "从 GeoTIFF 标签中提取地理空间信息：地理参照模型（ModelTiepoint/ModelPixelScale/ModelTransformation）、GeoKey 目录、GDAL 元数据与 NODATA 值，并提供边界框(BoundingBox)、原点(Origin)、分辨率(Resolution)等便捷计算函数",
        "evidence": [
          "src/geotiffimage.js:169-280",
          "src/globals.js:183-440"
        ]
      },
      {
        "name": "子区域与多波段采样控制",
        "description": "支持按像素窗口(window)或地理边界框(bbox)裁剪读取栅格子集，可选择特定波段(samples)，控制输出宽高与重采样方法(最近邻/双线性)，以及分量分离或像素交错(interleave)的输出格式",
        "evidence": [
          "src/geotiff.js:280-386",
          "src/geotiffimage.js:281-580",
          "src/resample.js"
        ]
      },
      {
        "name": "色彩空间转换与可视化输出",
        "description": "提供 readRGB() 方法自动将各种光度解释(WhiteIsZero/BlackIsZero/Palette/CMYK/YCbCr/CIELab)转换为 RGB 数组，便于直接渲染显示",
        "evidence": [
          "src/geotiffimage.js:900-1084",
          "src/rgb.ts",
          "src/globals.js:362-379"
        ]
      },
      {
        "name": "GeoTIFF 写入（Beta）",
        "description": "提供 writeArrayBuffer() 将栅格像素值与元数据（宽高、压缩方式、地理参照、GeoKey 等）序列化为 TIFF 二进制 ArrayBuffer，支持条带(Strip)和瓦片(Tile)组织方式",
        "evidence": [
          "src/geotiffwriter.js",
          "src/geotiff.js:785-794"
        ]
      }
    ],
    "domain": "地理空间/遥感图像处理",
    "target_users": "Web GIS 应用开发者、遥感数据处理工程师、地图可视化前端开发者",
    "ecosystem": "nodejs"
  },
