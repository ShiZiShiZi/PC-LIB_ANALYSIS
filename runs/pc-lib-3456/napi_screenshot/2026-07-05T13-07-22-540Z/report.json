  "function_summary": {
    "summary": "napi_screenshot 是一个 Node.js 原生插件（N-API），基于 Rust 的 napi-rs 框架构建，提供桌面截屏能力。它支持多显示器环境下的全屏与区域截图，可以将捕获的像素数据转换为 PNG 格式输出。目前仅 Windows 平台的 Win32 GDI 后端已实现，macOS 与 Linux 为未实现的占位（返回 'not implemented' 错误）。面向需要在 Node.js 应用中集成桌面截屏功能的开发者。",
    "categories": [
      {
        "name": "桌面截屏",
        "description": "通过 Win32 GDI API 捕获指定显示器的屏幕内容，支持多线程并行截图，输出 RGBA 像素数据",
        "evidence": [
          "src/core/win32.rs:100-228",
          "src/core/mod.rs:39-41",
          "src/napi.rs:51-71"
        ]
      },
      {
        "name": "显示器信息获取",
        "description": "枚举系统所有显示器，获取每台显示器的 ID、位置、分辨率、旋转角度、缩放因子及主屏标记",
        "evidence": [
          "src/napi.rs:33-48",
          "src/napi.rs:12-23"
        ]
      },
      {
        "name": "图像编码输出",
        "description": "将捕获的 BGRA 像素数据转换为 RGBA，通过 png 编码器输出为 PNG 文件或纯字节数组",
        "evidence": [
          "src/core/image.rs:19-84",
          "src/napi.rs:74-92"
        ]
      },
      {
        "name": "N-API 原生桥接",
        "description": "通过 napi-rs 框架将 Rust 函数导出为 Node.js 可直接调用的模块，附带 TypeScript 类型声明",
        "evidence": [
          "src/napi.rs:26-92",
          "src/lib.rs:11-12",
          "index.d.ts"
        ]
      }
    ],
    "domain": "桌面截屏 / 系统工具",
    "target_users": "Node.js 桌面应用开发者",
    "ecosystem": "nodejs"
  },
