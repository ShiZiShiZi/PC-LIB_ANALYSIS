  "function_summary": {
    "summary": "libsoup 是 GNOME 生态的核心 HTTP 库（3.x 系列），为桌面应用和服务提供完整的 HTTP 客户端/服务端通信能力。它基于 GLib 事件循环与 GIO I/O 抽象层，同时支持异步（GMainLoop + 回调）和同步 API。涵盖 HTTP/1.1 与 HTTP/2、TLS、WebSocket、代理、多种认证方案（Basic/Digest/NTLM/Negotiate）、Cookie 持久化、缓存、内容解码（gzip/Brotli/zstd）与内容嗅探等功能。",
    "categories": [
      {
        "name": "HTTP 客户端",
        "description": "提供 SoupSession 为核心的异步/同步 HTTP 客户端，支持连接池复用、超时控制、重定向、User-Agent 等。",
        "evidence": [
          "libsoup/soup-session.c",
          "libsoup/soup-session.h",
          "libsoup/soup-message.c"
        ]
      },
      {
        "name": "HTTP 服务端",
        "description": "提供 SoupServer 用于构建嵌入式 HTTP 服务，支持路由分发、流式 I/O、WebSocket 升级（通过 GIOStream 接入）。",
        "evidence": [
          "libsoup/server/soup-server.c",
          "libsoup/server/soup-server-message.c",
          "libsoup/server/soup-listener.c"
        ]
      },
      {
        "name": "TLS/SSL",
        "description": "通过 GLib GTlsDatabase/GTlsInteraction 集成 GIO 的 TLS 后端（通常为 glib-networking / GnuTLS），支持 HTTPS 与 ALPN 协商 HTTP/2。",
        "evidence": [
          "libsoup/soup-connection.c:689-700",
          "libsoup/soup-session.h:80-91"
        ]
      },
      {
        "name": "HTTP/2",
        "description": "基于 nghttp2 库实现 HTTP/2 协议支持，包括客户端与服务端的 HTTP/2 多路复用流。",
        "evidence": [
          "libsoup/http2/soup-client-message-io-http2.c",
          "libsoup/http2/soup-body-input-stream-http2.c",
          "libsoup/server/http2/soup-server-message-io-http2.c"
        ]
      },
      {
        "name": "WebSocket",
        "description": "完整的 WebSocket 客户端/服务端实现，支持扩展（如 deflate 压缩），可独立或通过 SoupSession 使用。",
        "evidence": [
          "libsoup/websocket/soup-websocket-connection.c",
          "libsoup/websocket/soup-websocket-extension-deflate.c",
          "libsoup/websocket/soup-websocket-extension-manager.c"
        ]
      },
      {
        "name": "认证",
        "description": "支持 HTTP Basic、Digest、NTLM（通过外部 ntlm_auth 进程）与 Negotiate（GSSAPI/Kerberos）多种认证方案。",
        "evidence": [
          "libsoup/auth/soup-auth-basic.c",
          "libsoup/auth/soup-auth-digest.c",
          "libsoup/auth/soup-auth-ntlm.c",
          "libsoup/auth/soup-auth-negotiate.c"
        ]
      },
      {
        "name": "Cookie 与 HSTS",
        "description": "支持 Cookie 解析/存储（文本格式与 SQLite 数据库持久化）与 HTTP Strict Transport Security 策略管理。",
        "evidence": [
          "libsoup/cookies/soup-cookie-jar.c",
          "libsoup/cookies/soup-cookie-jar-db.c",
          "libsoup/hsts/soup-hsts-enforcer.c",
          "libsoup/hsts/soup-hsts-enforcer-db.c"
        ]
      },
      {
        "name": "内容处理",
        "description": "支持响应内容的解码（gzip/Brotli/zstd）、内容类型嗅探、以及多部分消息解析。",
        "evidence": [
          "libsoup/content-decoder/soup-content-decoder.c",
          "libsoup/content-decoder/soup-brotli-decompressor.c",
          "libsoup/content-decoder/soup-zstd-decompressor.c",
          "libsoup/content-sniffer/soup-content-sniffer.c"
        ]
      },
      {
        "name": "缓存",
        "description": "提供 HTTP 缓存层，支持条件请求与缓存条目管理。",
        "evidence": [
          "libsoup/cache/soup-cache.c",
          "libsoup/cache/soup-cache-client-input-stream.c"
        ]
      }
    ],
    "domain": "网络通信 / HTTP 基础设施",
    "target_users": "GNOME/GTK 桌面应用开发者、需要嵌入式 HTTP 服务的 C 应用开发者",
    "ecosystem": "cpp"
  },
