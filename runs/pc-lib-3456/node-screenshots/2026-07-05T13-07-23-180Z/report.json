  "function_summary": {
    "summary": "node-screenshots 是一个基于 Rust xcap 库的 Node.js 原生截图库，通过 N-API（napi-rs）暴露高性能屏幕截图能力。支持按显示器（Monitor）和窗口（Window）截图，可输出 PNG、JPEG、BMP、Raw 四种图像格式，并提供同步与异步两种调用方式。跨平台支持 Windows（x86/x64/arm64）、macOS（x64/arm64）、Linux（x64/arm64/loongarch64/riscv64 等），零外部运行时依赖，通过预编译 .node 原生插件分发。",
    "categories": [
      {
        "name": "显示器截图",
        "description": "枚举所有显示器并截图，支持按坐标点定位显示器，获取显示器属性（分辨率、缩放、刷新率、旋转角度等）",
        "evidence": [
          "src/monitor.rs",
          "index.d.ts:18-49"
        ]
      },
      {
        "name": "窗口截图",
        "description": "枚举所有窗口并按 Z 序截图，获取窗口属性（标题、进程ID、应用名、最小化/最大化/焦点状态、所在显示器等）",
        "evidence": [
          "src/window.rs",
          "index.d.ts:51-84"
        ]
      },
      {
        "name": "图像编码输出",
        "description": "将截图转为 PNG、JPEG、BMP 或原始 RGBA 数据 Buffer，支持同步与异步（AsyncTask）两种模式",
        "evidence": [
          "src/image.rs",
          "index.d.ts:1-16"
        ]
      },
      {
        "name": "图像裁剪",
        "description": "对已捕获的图像进行区域裁剪，产出新的 Image 对象",
        "evidence": [
          "src/image.rs:108-122"
        ]
      }
    ],
    "domain": "桌面截图/图形处理",
    "target_users": "Node.js 应用开发者（自动化脚本、测试工具、桌面截图工具开发）",
    "ecosystem": "nodejs"
  },
