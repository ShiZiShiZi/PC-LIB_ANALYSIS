  "function_summary": {
    "summary": "libsodium 是 NaCl 的一个可移植、可安装、可打包的分支，用 C 语言实现现代密码学原语。它面向应用开发者和库开发者，提供易于使用且难以误用的 API，覆盖公钥/对称加密、数字签名、安全哈希、密钥派生、密码哈希、安全随机数生成以及安全内存管理。",
    "categories": [
      {
        "name": "对称加密与认证加密",
        "description": "提供 ChaCha20-Poly1305、XChaCha20-Poly1305、AES-256-GCM（含 AESNI/ARM Crypto 加速）、AEGIS 等 AEAD 方案，以及传统 secretbox 接口。",
        "evidence": [
          "src/libsodium/include/sodium/crypto_aead_chacha20poly1305.h",
          "src/libsodium/include/sodium/crypto_aead_xchacha20poly1305.h",
          "src/libsodium/include/sodium/crypto_aead_aes256gcm.h",
          "src/libsodium/include/sodium/crypto_secretbox.h"
        ]
      },
      {
        "name": "公钥加密与密钥交换",
        "description": "基于 Curve25519/X25519 的 crypto_box 封装、crypto_kx 密钥交换，以及 ML-KEM-768、X-Wing 等后量子 KEM 封装。",
        "evidence": [
          "src/libsodium/include/sodium/crypto_box.h",
          "src/libsodium/include/sodium/crypto_kx.h",
          "src/libsodium/include/sodium/crypto_kem_mlkem768.h",
          "src/libsodium/include/sodium/crypto_kem_xwing.h"
        ]
      },
      {
        "name": "数字签名",
        "description": "提供 Ed25519 数字签名方案，包括标准签名、Ed25519ph 预哈希变体及多签名支持。",
        "evidence": [
          "src/libsodium/include/sodium/crypto_sign.h",
          "src/libsodium/include/sodium/crypto_sign_ed25519.h"
        ]
      },
      {
        "name": "哈希、消息认证与密钥派生",
        "description": "提供 BLAKE2b 通用哈希与 keyed hash、SHA-256/SHA-512、HMAC、SipHash-2-4、HKDF、Argon2/scrypt 密码哈希、SHAKExx/TurboSHAKE 可扩展输出函数。",
        "evidence": [
          "src/libsodium/include/sodium/crypto_generichash.h",
          "src/libsodium/include/sodium/crypto_auth.h",
          "src/libsodium/include/sodium/crypto_kdf.h",
          "src/libsodium/include/sodium/crypto_pwhash.h",
          "src/libsodium/include/sodium/crypto_pwhash_argon2id.h",
          "src/libsodium/include/sodium/crypto_xof_shake256.h"
        ]
      },
      {
        "name": "安全随机数生成",
        "description": "randombytes 模块封装操作系统安全 RNG（getrandom/getentropy/arc4random/dev_urandom/RtlGenRandom 等），并提供可插拔实现。",
        "evidence": [
          "src/libsodium/include/sodium/randombytes.h",
          "src/libsodium/randombytes/sysrandom/randombytes_sysrandom.c",
          "src/libsodium/randombytes/internal/randombytes_internal_random.c"
        ]
      },
      {
        "name": "安全内存与工具函数",
        "description": "提供 sodium_malloc 安全分配（带 canary、guard page、mlock/mprotect）、sodium_memzero/sodium_memcmp 等常量时间辅助工具，以及 base64/hex 编解码。",
        "evidence": [
          "src/libsodium/include/sodium/utils.h",
          "src/libsodium/sodium/utils.c"
        ]
      },
      {
        "name": "运行时 CPU 特性检测",
        "description": "sodium_init 在启动时检测 CPU 支持的 SIMD/加密扩展（SSE2/SSSE3/SSE4.1/AVX/AVX2/AVX512F/AESNI/RDRAND/NEON/ARM Crypto），自动选择最优实现。",
        "evidence": [
          "src/libsodium/include/sodium/runtime.h",
          "src/libsodium/sodium/runtime.c",
          "src/libsodium/sodium/core.c"
        ]
      }
    ],
    "domain": "cryptography",
    "target_users": "需要在应用中集成现代密码学的 C/C++ 应用开发者、语言绑定维护者及其他开源库"
  },
