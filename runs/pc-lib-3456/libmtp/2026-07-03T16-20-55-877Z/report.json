  "function_summary": {
    "summary": "libmtp 是一个 C 语言实现的 MTP（Media Transfer Protocol）发起端库，运行于具备 USB 主机控制器接口的计算机上，通过 libusb 访问 USB 设备，与 MTP/PTP 响应端（如 MP3 播放器、智能手机、相机等）建立会话，实现文件传输、元数据读写、播放列表管理和设备信息查询等功能。核心 PTP 协议实现源自 libgphoto2，库提供高层 C API 供应用程序集成。生产代码集中在 src/ 目录（约 30K 行 C），examples/ 为命令行示例程序，logs/ 为设备检测日志集合。",
    "categories": [
      {
        "name": "MTP/PTP 协议通信",
        "description": "实现 MTP（Media Transfer Protocol）和 PTP（Picture Transfer Protocol）的发起端协议栈，包括会话管理、事务处理、数据打包/解包，与 MTP 响应端设备建立和维持通信",
        "evidence": [
          "src/ptp.c",
          "src/ptp.h",
          "src/ptp-pack.c",
          "src/libmtp.c:2208"
        ]
      },
      {
        "name": "USB 设备交互",
        "description": "通过 libusb（1.0/0.1/openusb 多后端）进行 USB 批量传输、控制传输和中断传输，实现设备探测、接口配置、端点管理和内核驱动卸载",
        "evidence": [
          "src/libusb1-glue.c",
          "src/libusb-glue.c",
          "src/libopenusb1-glue.c",
          "src/libusb-glue.h"
        ]
      },
      {
        "name": "文件传输与管理",
        "description": "提供文件/音视频轨道的上传（Send）和下载（Get）功能，支持文件夹创建与删除、对象移动与复制，以及大文件分块传输",
        "evidence": [
          "src/libmtp.c"
        ]
      },
      {
        "name": "设备元数据与播放列表",
        "description": "读写设备上的媒体元数据（艺术家、专辑、时长等），管理播放列表（包括 Samsung SPL 格式），查询存储信息和文件树",
        "evidence": [
          "src/playlist-spl.c",
          "src/playlist-spl.h",
          "src/libmtp.c"
        ]
      },
      {
        "name": "MTPZ 设备认证",
        "description": "支持与 MTPZ（Zune 等受保护设备）的 RSA 握手认证流程，依赖 libgcrypt 进行加解密运算",
        "evidence": [
          "src/mtpz.c",
          "src/mtpz.h"
        ]
      },
      {
        "name": "字符编码转换",
        "description": "在 UTF-8 与 UTF-16LE 之间进行字符串编码转换，确保 MTP 协议中 Unicode 字符串的正确处理",
        "evidence": [
          "src/unicode.c",
          "src/unicode.h",
          "src/libmtp.c:1968"
        ]
      }
    ],
    "domain": "USB 设备通信 / 媒体传输协议",
    "target_users": "需要在 Linux/macOS/Windows 上通过 USB 与 MTP/PTP 设备通信的桌面应用开发者，如媒体管理器、文件同步工具和设备探测程序"
  },
