  "function_summary": {
    "summary": "FluentValidation 是一个 .NET 验证库，通过流畅接口（fluent interface）以强类型链式 API 构建对象验证规则。开发者继承 AbstractValidator<T> 并用 RuleFor/RuleForEach 声明属性校验，内置 30+ 验证器（非空、长度、范围、正则、邮箱、信用卡等），支持同步/异步执行、条件分支（When/Unless）、规则集（RuleSet）、级联模式、自定义验证器、本地化错误消息及依赖注入集成。面向 .NET 应用开发者，用于替代数据注解（Data Annotations）实现业务校验逻辑。",
    "categories": [
      {
        "name": "流畅规则定义引擎",
        "description": "通过 RuleFor/RuleForEach 等 Lambda 表达式驱动的链式 API 声明属性验证规则，支持规则集分组、条件分支（When/Unless/WhenAsync）、级联模式（Continue/Stop）和规则组合（Include）",
        "evidence": [
          "src/FluentValidation/AbstractValidator.cs:210-216",
          "src/FluentValidation/AbstractValidator.cs:224-230",
          "src/FluentValidation/AbstractValidator.cs:256-272"
        ]
      },
      {
        "name": "内置验证器集合",
        "description": "提供 30+ 开箱即用的属性验证器：非空（NotNull/NotEmpty）、相等（Equal/NotEqual）、比较（GreaterThanOrEqual/LessThan）、范围（InclusiveBetween/ExclusiveBetween）、长度（Length/ExactLength/MaximumLength）、正则（RegularExpression）、邮箱（EmailAddress）、信用卡（CreditCard）、枚举（IsInEnum）、精度小数（PrecisionScale）等",
        "evidence": [
          "src/FluentValidation/DefaultValidatorExtensions.cs",
          "src/FluentValidation/Validators/"
        ]
      },
      {
        "name": "验证执行与结果",
        "description": "支持同步 Validate 和异步 ValidateAsync 执行验证，返回 ValidationResult（含 IsValid 与 Errors 集合），每条错误记录属性名、错误消息、严重级别、错误码和自定义状态；支持 ValidateAndThrow 直接抛出 ValidationException",
        "evidence": [
          "src/FluentValidation/AbstractValidator.cs:98-126",
          "src/FluentValidation/Results/ValidationResult.cs",
          "src/FluentValidation/Results/ValidationFailure.cs",
          "src/FluentValidation/ValidationException.cs"
        ]
      },
      {
        "name": "本地化与错误消息定制",
        "description": "内置 40+ 语言的错误消息翻译（LanguageManager + 各 Language 类），支持自定义消息模板、消息格式化占位符、错误码覆盖和属性名解析器定制",
        "evidence": [
          "src/FluentValidation/Resources/LanguageManager.cs",
          "src/FluentValidation/Resources/Languages/",
          "src/FluentValidation/Internal/MessageFormatter.cs"
        ]
      },
      {
        "name": "依赖注入集成",
        "description": "通过 FluentValidation.DependencyInjectionExtensions 子包提供 Microsoft.Extensions.DependencyInjection 的 AddValidatorsFromAssembly 注册和 ServiceProviderValidatorFactory，方便在 ASP.NET Core 等框架中使用",
        "evidence": [
          "src/FluentValidation.DependencyInjectionExtensions/ServiceCollectionExtensions.cs",
          "src/FluentValidation.DependencyInjectionExtensions/ServiceProviderValidatorFactory.cs"
        ]
      },
      {
        "name": "测试辅助工具",
        "description": "提供 TestHelper 模块（TestValidate/ShouldHaveValidationErrorFor 等），方便在单元测试中流式断言验证结果",
        "evidence": [
          "src/FluentValidation/TestHelper/ValidatorTestExtensions.cs",
          "src/FluentValidation/TestHelper/TestValidationResult.cs"
        ]
      }
    ],
    "domain": "data_validation",
    "target_users": ".NET 应用开发者（ASP.NET Core/Web API/桌面/微服务等场景的业务校验）"
  },
