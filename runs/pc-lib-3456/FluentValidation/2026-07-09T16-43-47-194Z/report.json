  "function_summary": {
    "summary": "FluentValidation 是一个面向 .NET 的验证库，通过 Fluent 接口和 Lambda 表达式构建强类型验证规则。开发者继承 AbstractValidator<T> 定义验证器类，在构造函数中用 RuleFor() 链式声明属性约束，再对对象实例调用 Validate() 校验。适用于任何 .NET 8 应用——桌面、Web、命令行均可。",
    "categories": [
      {
        "name": "Fluent 规则定义",
        "description": "通过链式 API（RuleFor → 内置校验器 → .When/.WithMessage/.WithState）声明验证规则，支持集合嵌套和属性链",
        "evidence": [
          "src/FluentValidation/AbstractValidator.cs",
          "src/FluentValidation/DefaultValidatorExtensions.cs"
        ]
      },
      {
        "name": "内置校验器",
        "description": "提供 NotEmpty、NotNull、NotEqual、Email、CreditCard、Length、Range、PrecisionScale、RegularExpression、Enum 等常用校验器",
        "evidence": [
          "src/FluentValidation/Validators/"
        ]
      },
      {
        "name": "自定义验证",
        "description": "支持 Must/MustAsync 和 Custom/CustomAsync 编写自定义验证逻辑",
        "evidence": [
          "src/FluentValidation/DefaultValidatorExtensions.cs"
        ]
      },
      {
        "name": "多语言支持",
        "description": "内置 50+ 种语言的错误消息翻译，通过 ILanguageManager 获取，错误消息使用占位符（{PropertyName} 等）",
        "evidence": [
          "src/FluentValidation/Resources/Languages/",
          "src/FluentValidation/Resources/LanguageManager.cs"
        ]
      },
      {
        "name": "依赖注入集成",
        "description": "提供 AddFluentValidation/AddValidatorsFromAssembly 等扩展，将验证器注册到 Microsoft DI 容器，可用于 ASP.NET Core",
        "evidence": [
          "src/FluentValidation.DependencyInjectionExtensions/ServiceCollectionExtensions.cs"
        ]
      }
    ],
    "domain": "开发工具 / 数据验证",
    "target_users": ".NET 应用程序开发者（ASP.NET Core、桌面、命令行应用）",
    "ecosystem": "dotnet"
  },
