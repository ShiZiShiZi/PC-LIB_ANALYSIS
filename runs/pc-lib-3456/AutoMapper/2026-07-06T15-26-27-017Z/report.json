  "function_summary": {
    "summary": "AutoMapper 是一个基于约定的 .NET 对象-对象映射库，用于自动将一种类型的对象转换为另一种类型，消除手工编写属性赋值映射代码的繁琐工作。它通过配置映射关系（CreateMap）和约定（命名匹配）来生成高效的映射执行计划（编译为委托），同时支持 LINQ 查询投影（ProjectTo）、反向映射、自定义值解析器、条件映射等高级特性。该库还包含商业授权验证机制（Lucky Penny Software 许可证密钥），以及动态代理生成（Reflection.Emit）用于接口映射。",
    "categories": [
      {
        "name": "对象映射",
        "description": "核心功能：基于约定和配置的类型间属性映射，支持嵌套对象、集合、枚举、可空类型、键值对等多种映射场景，编译为高效委托执行",
        "evidence": [
          "src/AutoMapper/Mapper.cs",
          "src/AutoMapper/Configuration/MapperConfiguration.cs",
          "src/AutoMapper/Mappers/"
        ]
      },
      {
        "name": "LINQ 投影",
        "description": "将 IQueryable 查询直接投影为目标类型，无需先物化再映射，支持 EF/Core 等ORM 场景",
        "evidence": [
          "src/AutoMapper/QueryableExtensions/Extensions.cs",
          "src/AutoMapper/QueryableExtensions/ProjectionBuilder.cs"
        ]
      },
      {
        "name": "映射配置与验证",
        "description": "提供 Fluent API 配置映射关系（ForMember/ForMember/ReverseMap/IncludeMembers等），支持映射配置验证（AssertConfigurationIsValid）",
        "evidence": [
          "src/AutoMapper/Configuration/IMappingExpression.cs",
          "src/AutoMapper/Configuration/MappingExpression.cs",
          "src/AutoMapper/Configuration/MapperConfigurationExpression.cs"
        ]
      },
      {
        "name": "依赖注入集成",
        "description": "提供 IServiceCollection.AddAutoMapper 扩展方法，自动扫描 Profile、类型转换器等并注册到 DI 容器",
        "evidence": [
          "src/AutoMapper/ServiceCollectionExtensions.cs"
        ]
      },
      {
        "name": "动态代理生成",
        "description": "使用 System.Reflection.Emit 在运行时生成接口的动态代理类，支持 INotifyPropertyChanged 等接口的映射",
        "evidence": [
          "src/AutoMapper/Execution/ProxyGenerator.cs"
        ]
      },
      {
        "name": "商业许可证验证",
        "description": "内置 JWT 许可证密钥验证机制，支持社区版/标准版/专业版/企业版，通过环境变量或显式配置提供密钥",
        "evidence": [
          "src/AutoMapper/Licensing/License.cs",
          "src/AutoMapper/Licensing/LicenseAccessor.cs",
          "src/AutoMapper/Licensing/LicenseValidator.cs"
        ]
      }
    ],
    "domain": "对象映射 / 数据传输",
    "target_users": ".NET 开发者，尤其是需要在分层架构中频繁进行 DTO/ViewModel/Entity 之间对象映射的 Web 和企业应用开发者"
  },
