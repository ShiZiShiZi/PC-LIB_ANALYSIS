  "function_summary": {
    "summary": "CommonServiceLocator 是一个 .NET 服务定位器抽象库，定义了 IServiceLocator 接口规范和 ServiceLocator 静态访问入口，供各种依赖注入容器（DI Container）实现统一的服务获取接口。该库不提供具体容器实现，仅作为各 IoC 容器适配器的共享抽象层，使消费者代码不绑定特定容器。",
    "categories": [
      {
        "name": "服务定位抽象接口",
        "description": "定义 IServiceLocator 接口，包含 GetInstance/GetAllInstances 等方法，作为各种 IoC/DI 容器的统一抽象层",
        "evidence": [
          "src/IServiceLocator.cs",
          "src/ServiceLocatorImplBase.cs"
        ]
      },
      {
        "name": "静态服务定位入口",
        "description": "提供 ServiceLocator 静态类作为全局服务定位器的访问点，通过 SetLocatorProvider 委托设置当前容器",
        "evidence": [
          "src/ServiceLocator.cs",
          "src/ServiceLocatorProvider.cs"
        ]
      },
      {
        "name": ".NET 反射兼容层",
        "description": "为 .NET Framework 4.0 提供 TypeInfo 兼容实现，桥接旧版 .NET 与 .NET Standard/Portable Library 之间的反射 API 差异",
        "evidence": [
          "src/net40/TypeInfo.cs"
        ]
      }
    ],
    "domain": "依赖注入/控制反转",
    "target_users": ".NET 库/框架开发者，需要让代码与多种 IoC 容器解耦的场景"
  },
