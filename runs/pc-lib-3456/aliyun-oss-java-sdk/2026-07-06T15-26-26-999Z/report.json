  "function_summary": {
    "summary": "阿里云对象存储服务（OSS）的 Java 客户端 SDK，为 Java 开发者提供对 OSS 服务的完整编程接口。涵盖 Bucket 与 Object 的创建、列举、删除、权限控制，分片上传/断点续传，数据加密（AES-CTR/RSA），跨区域复制，生命周期管理，回调和事件进度通知等功能。通过 Apache HttpClient 发起 HTTP REST 请求并处理签名认证（V1/V2/V4），支持 STS 临时凭证与自定义凭证提供者。",
    "categories": [
      {
        "name": "对象存储操作",
        "description": "Bucket 与 Object 的完整 CRUD 操作，包括创建/删除/列举 Bucket，上传/下载/复制/追加写入 Object，以及 Object 元数据与 ACL 管理",
        "evidence": [
          "src/main/java/com/aliyun/oss/OSS.java",
          "src/main/java/com/aliyun/oss/internal/OSSBucketOperation.java",
          "src/main/java/com/aliyun/oss/internal/OSSObjectOperation.java"
        ]
      },
      {
        "name": "分片上传与断点续传",
        "description": "大文件的分片上传（Multipart Upload）、分片拷贝、断点续传下载，含上传/下载进度事件回调",
        "evidence": [
          "src/main/java/com/aliyun/oss/internal/OSSMultipartOperation.java",
          "src/main/java/com/aliyun/oss/internal/OSSUploadOperation.java",
          "src/main/java/com/aliyun/oss/internal/OSSDownloadOperation.java"
        ]
      },
      {
        "name": "客户端数据加密",
        "description": "客户端侧加密（Client-Side Encryption），支持 AES-CTR 对称加密与 RSA 非对称加密，含加密材料的密钥管理",
        "evidence": [
          "src/main/java/com/aliyun/oss/OSSEncryptionClient.java",
          "src/main/java/com/aliyun/oss/crypto/CryptoModuleAesCtr.java",
          "src/main/java/com/aliyun/oss/crypto/SimpleRSAEncryptionMaterials.java"
        ]
      },
      {
        "name": "签名与认证",
        "description": "OSS 请求签名（V1/V2/V4），AccessKey/SecretKey 凭证管理，STS 临时安全令牌支持，以及自定义凭证提供者接口",
        "evidence": [
          "src/main/java/com/aliyun/oss/internal/SignUtils.java",
          "src/main/java/com/aliyun/oss/internal/SignV2Utils.java",
          "src/main/java/com/aliyun/oss/common/auth/CredentialsProvider.java",
          "src/main/java/com/aliyun/oss/internal/OSSRequestSigner.java"
        ]
      },
      {
        "name": "Bucket 高级功能",
        "description": "跨区域复制、生命周期规则、版本控制、日志记录、防盗链 Referer、CORS、标签、清单、QoS 限速、传输加速等 Bucket 级配置",
        "evidence": [
          "src/main/java/com/aliyun/oss/internal/OSSBucketOperation.java",
          "src/main/java/com/aliyun/oss/model/ReplicationRule.java",
          "src/main/java/com/aliyun/oss/model/LifecycleRule.java"
        ]
      },
      {
        "name": "事件与进度通知",
        "description": "上传/下载过程的进度事件发布与监听，支持自定义 ProgressListener 回调",
        "evidence": [
          "src/main/java/com/aliyun/oss/event/ProgressPublisher.java",
          "src/main/java/com/aliyun/oss/event/ProgressInputStream.java",
          "src/main/java/com/aliyun/oss/event/ProgressListener.java"
        ]
      }
    ],
