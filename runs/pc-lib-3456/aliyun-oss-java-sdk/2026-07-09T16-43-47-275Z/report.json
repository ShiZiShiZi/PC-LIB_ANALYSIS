  "function_summary": {
    "summary": "阿里云对象存储OSS的Java SDK，为Java开发者提供完整的云存储API客户端。核心功能包括Bucket管理（创建/删除/ACL/生命周期）、Object管理（上传/下载/复制/删除）、分段上传与断点续传、服务端数据加密（AES256/KMS）、客户端加密、图片处理、防盗链、跨域CORS配置等。通过REST API与OSS通信，以Apache HttpClient为底层HTTP传输。",
    "categories": [
      {
        "name": "Bucket管理",
        "description": "创建、删除、列举存储桶，配置ACL权限、生命周期规则、跨域CORS、日志、防盗链、静态网站托管、版本控制等Bucket级别操作",
        "evidence": [
          "src/main/java/com/aliyun/oss/internal/OSSBucketOperation.java",
          "src/main/java/com/aliyun/oss/OSS.java"
        ]
      },
      {
        "name": "Object管理",
        "description": "文件上传/下载/复制/删除，支持简单上传、追加上传、带进度回调的上传下载、对象元数据管理",
        "evidence": [
          "src/main/java/com/aliyun/oss/internal/OSSObjectOperation.java",
          "src/main/java/com/aliyun/oss/model/PutObjectRequest.java"
        ]
      },
      {
        "name": "分段上传与传输加速",
        "description": "大文件分片上传/下载（MultipartUpload），支持断点续传、并发传输、进度监听，以及OSS传输加速",
        "evidence": [
          "src/main/java/com/aliyun/oss/internal/OSSMultipartOperation.java",
          "src/main/java/com/aliyun/oss/internal/OSSUploadOperation.java",
          "src/main/java/com/aliyun/oss/internal/OSSDownloadOperation.java"
        ]
      },
      {
        "name": "数据加密",
        "description": "服务端加密（AES256/KMS）设置与获取；客户端加密通过CryptoModule实现本地加解密，使用AES-CTR与RSA混合加密模式",
        "evidence": [
          "src/main/java/com/aliyun/oss/crypto/CryptoModuleBase.java",
          "src/main/java/com/aliyun/oss/crypto/CryptoModuleAesCtr.java",
          "src/main/java/com/aliyun/oss/crypto/SimpleRSAEncryptionMaterials.java"
        ]
      },
      {
        "name": "图片与媒体处理",
        "description": "通过OSS的图片处理API对存储的图片进行缩放、裁剪、旋转、水印等实时处理，支持SelectObject对CSV/JSON文件执行SQL查询",
        "evidence": [
          "src/main/java/com/aliyun/oss/model/GetImageStyleResult.java",
          "src/main/java/com/aliyun/oss/model/CreateSelectObjectMetadataRequest.java"
        ]
      },
      {
        "name": "签名与认证",
        "description": "支持AccessKeyID/Secret认证、STS临时凭证、EcsRamRole/InstanceProfile自动获取凭证；支持V1/V2两种签名算法",
        "evidence": [
          "src/main/java/com/aliyun/oss/common/auth/",
          "src/main/java/com/aliyun/oss/internal/SignUtils.java",
          "src/main/java/com/aliyun/oss/internal/SignV2Utils.java"
        ]
      }
    ],
    "domain": "cloud_storage",
    "target_users": "Java开发者（服务端/Web/大数据应用），需要对接阿里云OSS存储服务的项目",
    "ecosystem": "java"
