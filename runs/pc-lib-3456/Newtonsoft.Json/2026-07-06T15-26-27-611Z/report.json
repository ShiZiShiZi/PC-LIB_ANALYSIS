  "function_summary": {
    "summary": "Newtonsoft.Json（又名 Json.NET）是 .NET 平台上最广泛使用的高性能 JSON 框架，为 .NET 对象与 JSON 文本之间提供双向序列化与反序列化能力。它支持通过特性标注或约定控制序列化行为，提供 LINQ to JSON 的对象模型（JToken/JObject/JArray），并包含 BSON 格式读写、JSON Schema 生成与验证、以及 JSON 与 XML 互转等高级功能。目标用户为 .NET 应用与库开发者。",
    "categories": [
      {
        "name": "JSON 序列化与反序列化",
        "description": "核心功能：将 .NET 对象序列化为 JSON 文本，以及将 JSON 文本反序列化为 .NET 对象。支持泛型、匿名类型、动态类型、多态、循环引用处理等高级场景。",
        "evidence": [
          "Src/Newtonsoft.Json/JsonConvert.cs",
          "Src/Newtonsoft.Json/JsonSerializer.cs",
          "Src/Newtonsoft.Json/JsonSerializerSettings.cs"
        ]
      },
      {
        "name": "LINQ to JSON",
        "description": "提供 JToken/JObject/JArray/JValue 等对象模型，支持以 LINQ 方式查询、构建和修改 JSON 文档，无需定义强类型类即可灵活操作 JSON 数据。",
        "evidence": [
          "Src/Newtonsoft.Json/Linq/JToken.cs",
          "Src/Newtonsoft.Json/Linq/JObject.cs",
          "Src/Newtonsoft.Json/Linq/JArray.cs"
        ]
      },
      {
        "name": "JSON 读写器",
        "description": "提供高性能的流式 JSON 读写器（JsonTextReader/JsonTextWriter），支持异步读写、格式化输出、缩进控制等，是底层序列化引擎的基础。",
        "evidence": [
          "Src/Newtonsoft.Json/JsonReader.cs",
          "Src/Newtonsoft.Json/JsonTextWriter.cs",
          "Src/Newtonsoft.Json/JsonTextReader.cs"
        ]
      },
      {
        "name": "BSON 格式支持",
        "description": "提供 BSON（Binary JSON）格式的读写器，支持将 JSON 数据以二进制格式序列化和反序列化。",
        "evidence": [
          "Src/Newtonsoft.Json/Bson/BsonReader.cs",
          "Src/Newtonsoft.Json/Bson/BsonWriter.cs"
        ]
      },
      {
        "name": "JSON Schema",
        "description": "支持 JSON Schema 的生成与验证，可根据 .NET 类型自动生成 JSON Schema，或对 JSON 数据进行 Schema 合规性校验。",
        "evidence": [
          "Src/Newtonsoft.Json/Schema/JsonSchema.cs",
          "Src/Newtonsoft.Json/Schema/JsonSchemaGenerator.cs",
          "Src/Newtonsoft.Json/JsonValidatingReader.cs"
        ]
      },
      {
        "name": "JSON 与 XML 互转",
        "description": "提供 JSON 与 XML 文档之间的双向转换功能，支持 XmlDocument 和 XDocument 两种 XML 对象模型。",
        "evidence": [
          "Src/Newtonsoft.Json/Converters/XmlNodeConverter.cs",
          "Src/Newtonsoft.Json/JsonConvert.cs:973"
        ]
      },
      {
        "name": "自定义转换器与契约解析",
        "description": "通过 JsonConverter 自定义特定类型的序列化逻辑，通过 DefaultContractResolver/IContractResolver 控制全局序列化契约，支持 DataContract/DataMember 特性互操作。",
        "evidence": [
          "Src/Newtonsoft.Json/JsonConverter.cs",
          "Src/Newtonsoft.Json/Serialization/DefaultContractResolver.cs",
          "Src/Newtonsoft.Json/Serialization/JsonTypeReflector.cs"
        ]
      }
    ],
    "domain": "数据序列化",
    "target_users": ".NET 应用与库开发者"
  },
