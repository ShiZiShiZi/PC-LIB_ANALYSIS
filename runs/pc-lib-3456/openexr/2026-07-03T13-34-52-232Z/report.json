  "function_summary": {
    "summary": "OpenEXR 是电影行业广泛使用的高动态范围（HDR）图像格式 EXR 的规范与参考实现。它提供跨平台的 C++ API，用于读写、压缩/解压缩、多通道/多部件/多视点/深合成图像数据，并附带命令行工具与 Python 绑定。目标用户主要是影视特效、合成、渲染、调色等应用开发者与桌面工具开发者。",
    "categories": [
      {
        "name": "EXR 文件读写",
        "description": "提供扫描线、分块（tiled）、深层（deep）输入输出文件类，支持单文件多部件、多视点及完整元数据。",
        "evidence": [
          "src/lib/OpenEXR/ImfInputFile.h",
          "src/lib/OpenEXR/ImfOutputFile.h",
          "src/lib/OpenEXR/ImfRgbaFile.h",
          "src/lib/OpenEXRCore/openexr.h"
        ]
      },
      {
        "name": "压缩与编解码",
        "description": "内置 ZIP、PIZ、RLE、B44/B44A、PXR24、DWAA/DWAB、HT（JPEG 2000 HTJ2K）等多种压缩器，并支持 SIMD 加速。",
        "evidence": [
          "src/lib/OpenEXR/ImfZipCompressor.cpp",
          "src/lib/OpenEXR/ImfDwaCompressor.cpp",
          "src/lib/OpenEXRCore/internal_ht.cpp",
          "src/lib/OpenEXR/ImfCompression.h"
        ]
      },
      {
        "name": "深合成与多通道",
        "description": "支持 deep scanline / deep tiled 图像及深度合成运算，满足影视后期复杂合成需求。",
        "evidence": [
          "src/lib/OpenEXR/ImfDeepScanLineInputFile.h",
          "src/lib/OpenEXR/ImfDeepCompositing.cpp",
          "src/lib/OpenEXRUtil/ImfDeepImage.h"
        ]
      },
      {
        "name": "多部件/多视点",
        "description": "支持将多个独立图像（视图、通道组）存储于同一 EXR 文件，并提供相应的读取接口。",
        "evidence": [
          "src/lib/OpenEXR/ImfMultiPartInputFile.h",
          "src/lib/OpenEXR/ImfMultiPartOutputFile.h",
          "src/lib/OpenEXR/ImfMultiView.cpp"
        ]
      },
      {
        "name": "图像工具库",
        "description": "OpenEXRUtil 提供高层图像对象（平面/深层）及文件校验、预览图、属性处理等辅助功能。",
        "evidence": [
          "src/lib/OpenEXRUtil/ImfFlatImage.h",
          "src/lib/OpenEXRUtil/ImfCheckFile.h",
          "src/lib/OpenEXR/ImfPreviewImage.h"
        ]
      },
      {
        "name": "命令行工具",
        "description": "提供 exrheader、exrinfo、exrmakepreview、exrmaketiled、exrmultipart 等命令行实用程序。",
        "evidence": [
          "src/bin/exrheader/main.cpp",
          "src/bin/exrinfo/main.c",
          "src/bin/exrmaketiled/main.cpp",
          "CMakeLists.txt"
        ]
      },
      {
        "name": "Python 绑定",
        "description": "基于 pybind11 的 PyOpenEXR 模块，使 Python 代码能够读写 EXR 文件。",
        "evidence": [
          "src/wrappers/python/PyOpenEXR.cpp",
          "src/wrappers/python/CMakeLists.txt",
          "pyproject.toml"
        ]
      }
    ],
    "domain": "graphics / image processing",
    "target_users": "影视特效、合成、渲染、调色等桌面应用开发者与工具开发者"
