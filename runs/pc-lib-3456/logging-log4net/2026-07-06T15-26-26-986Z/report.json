  "function_summary": {
    "summary": "Apache log4net 是 Apache 软件基金会旗下的 .NET 日志框架，提供层级日志器、多种输出目标（Appender）、灵活的布局格式与 XML/代码配置能力。开发者通过 LogManager 获取 ILog 实例，以 Debug/Info/Warn/Error/Fatal 五级输出日志；框架按层级继承与过滤器规则将日志事件路由到文件、控制台、数据库、系统日志、网络等 Appender。核心设计目标是速度与灵活性，支持运行时动态开关日志而不修改二进制。",
    "categories": [
      {
        "name": "日志记录核心",
        "description": "层级日志器（Logger Hierarchy）、五级日志（Debug–Fatal）、ILog 接口、LogManager 工厂",
        "evidence": [
          "src/log4net/ILog.cs",
          "src/log4net/LogManager.cs",
          "src/log4net/Repository/Hierarchy/Logger.cs",
          "src/log4net/Core/Level.cs"
        ]
      },
      {
        "name": "多目标输出（Appender）",
        "description": "将日志事件输出到文件、控制台、数据库、SMTP、UDP、Telnet、Windows 事件日志、POSIX syslog、OutputDebugString 等目标",
        "evidence": [
          "src/log4net/Appender/FileAppender.cs",
          "src/log4net/Appender/RollingFileAppender.cs",
          "src/log4net/Appender/AdoNetAppender.cs",
          "src/log4net/Appender/EventLogAppender.cs",
          "src/log4net/Appender/LocalSyslogAppender.cs",
          "src/log4net/Appender/SmtpAppender.cs",
          "src/log4net/Appender/UdpAppender.cs",
          "src/log4net/Appender/TelnetAppender.cs"
        ]
      },
      {
        "name": "布局与格式化",
        "description": "灵活的日志消息格式化：PatternLayout、XML 布局、JSON 布局、日期格式化器等",
        "evidence": [
          "src/log4net/Layout/PatternLayout.cs",
          "src/log4net/Layout/XmlLayout.cs",
          "src/log4net/DateFormatter/Iso8601DateFormatter.cs"
        ]
      },
      {
        "name": "过滤器与评估器",
        "description": "按级别、日志器名、属性、字符串匹配等条件过滤日志事件；支持触发评估器控制缓冲输出",
        "evidence": [
          "src/log4net/Filter/LevelMatchFilter.cs",
          "src/log4net/Filter/LoggerMatchFilter.cs",
          "src/log4net/Filter/StringMatchFilter.cs",
          "src/log4net/Core/LevelEvaluator.cs"
        ]
      },
      {
        "name": "配置系统",
        "description": "XML 配置文件、程序集属性声明式配置、BasicConfigurator/XmlConfigurator 编程式配置",
        "evidence": [
          "src/log4net/Config/XmlConfigurator.cs",
          "src/log4net/Config/BasicConfigurator.cs",
          "src/log4net/Config/XmlConfiguratorAttribute.cs"
        ]
      },
      {
        "name": "上下文与诊断信息",
        "description": "MDC/NDC/ThreadContext/LogicalThreadContext/GlobalContext 提供线程/全局诊断上下文；LocationInfo 捕获调用位置",
        "evidence": [
          "src/log4net/MDC.cs",
          "src/log4net/NDC.cs",
          "src/log4net/ThreadContext.cs",
          "src/log4net/LogicalThreadContext.cs",
          "src/log4net/Core/LocationInfo.cs"
        ]
      }
    ],
    "domain": "日志/可观测性",
    "target_users": ".NET 应用开发者与运维人员，需要在应用中集成结构化日志输出的场景"
  },
