  "function_summary": {
    "summary": "Fraunhofer FDK AAC 是一个用 C/C++ 实现的 ISO/MPEG-2/4 AAC 音频编解码库，既提供 AAC-LC、HE-AAC(v1/v2)、AAC-LD、AAC-ELD 的解码能力，也提供 AAC-LC、HE-AAC、AAC-ELD 的编码能力，并支持 MPEG-D USAC 与 DRC/SBR/PS/SAC 等扩展特性。它以 libfdk-aac 共享/静态库形式被上层应用（如 FFmpeg、Android Stagefright、流媒体播放器）链接调用，属于典型的底层媒体处理库。",
    "categories": [
      {
        "name": "AAC 音频解码",
        "description": "将 AAC/HE-AAC/AAC-ELD/USAC 等压缩码流解码为 PCM 音频样本，支持 ADTS/ADIF/LOAS-LATM/RTP 等传输格式、错误隐藏、DRC 与下混。",
        "evidence": [
          "libAACdec/include/aacdecoder_lib.h",
          "libAACdec/src/aacdecoder_lib.cpp",
          "libMpegTPDec/src/tpdec_lib.cpp"
        ]
      },
      {
        "name": "AAC 音频编码",
        "description": "将 PCM 音频样本编码为 AAC-LC、HE-AAC(v1/v2) 或 AAC-ELD 码流，提供码率、采样率、声道模式、VBR、元数据等参数配置。",
        "evidence": [
          "libAACenc/include/aacenc_lib.h",
          "libAACenc/src/aacenc_lib.cpp",
          "libAACenc/src/aacenc.cpp"
        ]
      },
      {
        "name": "频带扩展与立体声处理",
        "description": "实现 SBR（Spectral Band Replication，频谱带复制）、PS（Parametric Stereo，参数立体声）与 SAC（MPEG Surround）等 MPEG 音频扩展模块，用于低码率高质量立体声/多声道。",
        "evidence": [
          "libSBRdec/src/sbrdecoder.cpp",
          "libSBRenc/src/sbr_encoder.cpp",
          "libSACdec/src/sac_dec_lib.cpp",
          "libSACenc/src/sacenc_lib.cpp"
        ]
      },
      {
        "name": "通用 DSP 与工具函数",
        "description": "提供定点/浮点 FFT、MDCT、QMF、DRC、比特缓冲区、通道映射、内存与 stdio 包装等底层基础设施，供编解码器复用。",
        "evidence": [
          "libFDK/src/fft.cpp",
          "libFDK/src/mdct.cpp",
          "libFDK/src/qmf.cpp",
          "libFDK/src/FDK_bitbuffer.cpp",
          "libSYS/src/genericStds.cpp"
        ]
      }
    ],
    "domain": "多媒体 / 音频编解码",
    "target_users": "播放器、流媒体、通信、移动设备、嵌入式系统的开发者，以及需要在 HarmonyOS PC 等平台上实现 AAC 编解码能力的上层应用。"
  },
