  "function_summary": {
    "summary": "litehtml 是一个轻量级 C++ HTML/CSS 渲染引擎，负责解析 HTML 文档和 CSS 样式表，根据 CSS2/CSS3 规范计算每个 HTML 元素的最终位置、尺寸与样式（即布局/渲染计算），但不执行任何实际像素绘制。所有绘制操作（文字、图片、背景、边框等）通过 document_container 纯虚接口回调委托给宿主应用实现，使该库完全独立于任何图形/字体库。适用于需要在应用中展示简单 HTML 格式化文本、工具提示或轻量级 HTML 视图的场景。",
    "categories": [
      {
        "name": "HTML 解析与 DOM 构建",
        "description": "利用内置的 gumbo-parser（HTML5 解析器）将 HTML 源码解析为 DOM 树，支持 HTML 元素层级、属性、文本节点与编码检测。",
        "evidence": [
          "include/litehtml/document.h",
          "src/html.cpp",
          "src/document.cpp",
          "src/gumbo/parser.c"
        ]
      },
      {
        "name": "CSS 解析与选择器匹配",
        "description": "解析 CSS2/CSS3 样式表（含 @media 查询），实现 CSS 选择器引擎（ID、类、属性、伪类、伪元素、兄弟/子代/后代选择器），将样式规则应用到 DOM 元素。",
        "evidence": [
          "src/css_parser.cpp",
          "src/css_selector.cpp",
          "src/css_tokenizer.cpp",
          "src/stylesheet.cpp",
          "include/litehtml/css_selector.h"
        ]
      },
      {
        "name": "CSS 属性计算与继承",
        "description": "计算每个元素的 CSS 属性最终值，支持属性继承、初始值与简写展开（display、position、margin、padding、border、font、color、background、flexbox 等）。",
        "evidence": [
          "src/css_properties.cpp",
          "src/html_tag.cpp",
          "include/litehtml/css_properties.h"
        ]
      },
      {
        "name": "盒模型布局与渲染",
        "description": "实现 CSS 盒模型布局：块级（block）、内联（inline）、表格（table）、弹性盒（flexbox）布局，以及浮动（float）、绝对/固定定位、行内块、列表项等。计算每个渲染元素的位置和尺寸。",
        "evidence": [
          "src/render_block.cpp",
          "src/render_inline_context.cpp",
          "src/render_table.cpp",
          "src/render_flex.cpp",
          "src/render_item.cpp",
          "src/element.cpp"
        ]
      },
      {
        "name": "媒体查询与响应式",
        "description": "支持 CSS @media 查询的解析与求值（width、height、aspect-ratio、orientation、resolution、color 等媒体特性），允许宿主通过 get_media_features 回调提供设备参数。",
        "evidence": [
          "src/media_query.cpp",
          "include/litehtml/media_query.h"
        ]
      },
      {
        "name": "背景与渐变绘制回调",
        "description": "为宿主提供结构化的背景层（纯色填充、线性/径向/锥形渐变、图像）与边框绘制信息，宿主只需按参数调用自己的 2D 图形库即可实现。",
        "evidence": [
          "src/background.cpp",
          "src/gradient.cpp",
          "include/litehtml/background.h",
          "include/litehtml/gradient.h"
        ]
      }
    ],
    "domain": "GUI/渲染引擎",
    "target_users": "需要在应用中嵌入 HTML 视图的 C++ 应用开发者"
  },
