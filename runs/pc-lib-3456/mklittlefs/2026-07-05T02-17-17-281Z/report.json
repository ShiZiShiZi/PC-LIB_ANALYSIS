  "function_summary": {
    "summary": "mklittlefs 是一个命令行工具，用于构建、解包和列出 LittleFS 嵌入式文件系统镜像。它从 ESP8266/ESP32 生态系统的 mkspiffs 派生而来，将 SPIFFS 替换为 ARMmbed 的 LittleFS 作为底层文件系统。主要面向嵌入式固件开发者和 IoT 设备构建流程。",
    "categories": [
      {
        "name": "LittleFS 镜像创建",
        "description": "将本地目录递归打包为 LittleFS 镜像文件，支持自定义块大小、页大小和镜像总大小，可排除 .DS_Store 和 .git 等元数据文件",
        "evidence": [
          "main.cpp:504-521 (actionPack)",
          "main.cpp:158-217 (addFile)",
          "main.cpp:219-301 (addFiles)"
        ]
      },
      {
        "name": "LittleFS 镜像解包",
        "description": "从 LittleFS 镜像中提取所有文件到本地目录，自动重建子目录结构",
        "evidence": [
          "main.cpp:529-561 (actionUnpack)",
          "main.cpp:384-413 (unpackFile)",
          "main.cpp:424-500 (unpackFiles)"
        ]
      },
      {
        "name": "LittleFS 镜像文件列表",
        "description": "挂载 LittleFS 镜像并列出其中包含的所有文件及其大小",
        "evidence": [
          "main.cpp:564-581 (actionList)",
          "main.cpp:303-330 (listFiles)"
        ]
      }
    ],
    "domain": "嵌入式/IoT 构建工具链",
    "target_users": "嵌入式固件开发者、IoT 设备构建流程",
    "ecosystem": "cpp"
