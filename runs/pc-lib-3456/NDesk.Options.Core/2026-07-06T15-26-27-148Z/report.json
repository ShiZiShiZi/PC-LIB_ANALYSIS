  "function_summary": {
    "summary": "NDesk.Options.Core 是一个基于回调机制的 C# 命令行选项解析库，灵感来源于 Perl 的 Getopt::Long。它允许开发者通过集合初始化器或链式 Add 调用简洁地声明选项名称、是否接受值以及匹配时的回调动作，支持短选项（-v）、长选项（--verbose）、Windows 风格选项（/v）、选项捆绑（-abc）以及通过 System.ComponentModel.TypeConverter 的自定义类型转换。适用于需要解析命令行参数的 .NET 控制台应用和工具开发。",
    "categories": [
      {
        "name": "命令行选项解析",
        "description": "解析命令行参数数组，识别选项标志（-、--、/）与选项名，提取选项值，支持必选值（=）、可选值（:）和无值选项，并处理选项捆绑和布尔开关（+/-）。",
        "evidence": [
          "src/OptionSet.cs:129",
          "src/OptionSet.cs:189",
          "src/Option.cs:79"
        ]
      },
      {
        "name": "选项注册与回调",
        "description": "通过 OptionSet.Add() 方法或集合初始化器注册选项，指定原型字符串和回调委托，支持 Action<string>、Action<T>、OptionAction<TKey,TValue> 等多种回调签名。",
        "evidence": [
          "src/OptionSet.cs:82",
          "src/OptionSet.cs:88",
          "src/OptionSet.cs:118"
        ]
      },
      {
        "name": "类型转换",
        "description": "利用 System.ComponentModel.TypeDescriptor/TypeConverter 机制将字符串选项值自动转换为目标类型（如 int、enum、自定义类型），内置 Foo/FooConverter 示例展示自定义类型转换。",
        "evidence": [
          "src/Option.cs:62",
          "src/Converter/Foo.cs:13",
          "src/Converter/FooConverter.cs:14"
        ]
      },
      {
        "name": "帮助信息生成",
        "description": "自动格式化并输出已注册选项的使用说明，包含选项原型、描述文本和自动换行排版。",
        "evidence": [
          "src/OptionSet.cs:297"
        ]
      }
    ],
    "domain": "命令行解析 / 开发工具",
    "target_users": "需要处理命令行参数的 .NET 应用开发者"
  },
