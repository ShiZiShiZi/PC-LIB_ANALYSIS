  "function_summary": {
    "summary": "zip.js 是一个纯 JavaScript 的 ZIP 压缩与解压缩库，使用 BSD-3-Clause 许可协议发布。它被设计为处理大量数据，支持多核压缩、Zip64（大于 4GB 的归档文件）、分卷 ZIP 文件、数据加密（AES-256/192/128 和 ZipCrypto）以及 Deflate64 解压缩。该库提供多种 I/O 后端（Blob、Text、Data64URI、HTTP、Uint8Array、分卷读取器/写入器），可在浏览器、Deno 和 Node.js 中运行，并通过 Web Workers 实现多核并行处理。压缩核心采用 WebAssembly 编译的 zlib 实现，也支持浏览器原生 CompressionStream API 和纯 JavaScript 降级方案。",
    "categories": [
      {
        "name": "ZIP 文件读取",
        "description": "读取 ZIP 归档文件的内容和元数据，支持 Zip64、分卷 ZIP、加密归档、Deflate64 压缩格式，提供 ZipReader 和 ZipReaderStream 接口",
        "evidence": [
          "lib/core/zip-reader.js:29"
        ]
      },
      {
        "name": "ZIP 文件写入",
        "description": "创建 ZIP 归档文件，支持存储/压缩/加密条目、Zip64 大文件、分卷写入，提供 ZipWriter 和 ZipWriterStream 接口",
        "evidence": [
          "lib/core/zip-writer.js:29"
        ]
      },
      {
        "name": "虚拟文件系统",
        "description": "在内存中模拟类文件系统操作 ZIP 内容，支持目录遍历、文件移动、重命名等文件管理操作，提供 ZipDirectoryEntry 和 ZipFileEntry",
        "evidence": [
          "lib/core/zip-fs.js:57"
        ]
      },
      {
        "name": "数据加密与解密",
        "description": "支持 AES-256/192/128 加密（基于 Web Crypto API 或 SJCL 降级）和传统的 ZipCrypto 加密，提供密码验证和加密强度选择",
        "evidence": [
          "lib/core/streams/aes-crypto-stream.js:29",
          "lib/core/streams/common-crypto.js:29"
        ]
      },
      {
        "name": "多后端 I/O",
        "description": "提供丰富的读取器/写入器：BlobReader/Writer、TextReader/Writer、Data64URIReader/Writer、HttpReader/HttpRangeReader、Uint8ArrayReader/Writer、SplitDataReader/Writer，适应不同数据源",
        "evidence": [
          "lib/core/io.js:29"
        ]
      },
      {
        "name": "多核并行压缩",
        "description": "利用 Web Workers 实现多核并行解压缩处理，自动检测 CPU 核心数以确定 Worker 数量",
        "evidence": [
          "lib/core/codec-pool.js:29",
          "lib/core/codec-worker.js:29"
        ]
      },
      {
        "name": "多压缩引擎",
        "description": "支持三种压缩后端：WebAssembly 编译的 zlib（默认高性能）、浏览器原生 CompressionStream API、纯 JavaScript 实现（zlib-js），可在配置中切换",
        "evidence": [
          "lib/zip-module-wasm.js:29",
          "lib/zip-module-native.js:29",
          "lib/core/streams/zlib-wasm/zlib-streams-loader.js:29"
        ]
      }
    ],
