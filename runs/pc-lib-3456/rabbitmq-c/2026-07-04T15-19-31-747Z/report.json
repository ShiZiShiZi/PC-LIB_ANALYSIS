  "function_summary": {
    "summary": "rabbitmq-c 是一个 C 语言编写的 AMQP 0-9-1 协议客户端库，用于连接 RabbitMQ 消息代理（broker）。提供连接管理、通道管理、交换机/队列声明、消息发布与消费、SASL 认证（PLAIN/EXTERNAL）、SSL/TLS 加密传输、心跳维持等完整功能。面向 C/C++ 应用开发者，适合构建需与 RabbitMQ 通信的后端服务、物联网网关或嵌入式系统。",
    "categories": [
      {
        "name": "AMQP 协议连接管理",
        "description": "建立与 RabbitMQ broker 的 TCP 连接、AMQP 握手、通道协商、帧传输与心跳维持",
        "evidence": [
          "include/rabbitmq-c/amqp.h",
          "librabbitmq/amqp_socket.c",
          "librabbitmq/amqp_connection.c"
        ]
      },
      {
        "name": "消息消费与发布",
        "description": "声明交换机与队列、绑定路由键、消费消息（pull/push）、发布消息到指定交换机",
        "evidence": [
          "include/rabbitmq-c/amqp.h",
          "librabbitmq/amqp_consumer.c"
        ]
      },
      {
        "name": "SSL/TLS 安全传输",
        "description": "通过 OpenSSL 库实现加密的 AMQPS 连接，支持客户端证书、CA 验证和 TLS 版本选择",
        "evidence": [
          "include/rabbitmq-c/ssl_socket.h",
          "librabbitmq/amqp_openssl.c"
        ]
      },
      {
        "name": "AMQP 帧编解码与字段表处理",
        "description": "AMQP 协议帧的序列化/反序列化、字段表（field-table）的编码解码和克隆，支持多种数据类型",
        "evidence": [
          "librabbitmq/amqp_framing.c",
          "librabbitmq/amqp_table.c",
          "include/rabbitmq-c/framing.h"
        ]
      },
      {
        "name": "AMQP URL 解析",
        "description": "解析形如 amqp://user:pass@host:port/vhost 的 AMQP 连接字符串，提取连接参数",
        "evidence": [
          "librabbitmq/amqp_url.c"
        ]
      },
      {
        "name": "内存池管理",
        "description": "内置的内存池（amqp_pool_t）用于高效管理帧缓冲与协议对象生命周期",
        "evidence": [
          "include/rabbitmq-c/amqp.h:470-484",
          "librabbitmq/amqp_mem.c"
        ]
      }
    ],
    "domain": "消息中间件 / AMQP 客户端库",
    "target_users": "C/C++ 服务端与嵌入式系统开发者，需通过 RabbitMQ 进行异步消息传递"
  },
