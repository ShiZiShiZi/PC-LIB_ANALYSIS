  "function_summary": {
    "summary": "Zint 是一个开源的条码编码套件，核心为 C 编写的共享库 libzint（BSD-3-Clause 授权），配套 CLI 命令行工具和基于 Qt5/Qt6 的桌面 GUI 应用 Zint Barcode Studio（GPL-3.0-or-later 授权）。它支持将任意数据编码为 90+ 种公共领域条码标准（1D 线形码、2D 矩阵码、邮政码、复合码等），输出 BMP/EMF/EPS/GIF/PCX/PNG/SVG/TIF 等多种格式，适用于需要在自己的应用中集成条码生成能力的软件开发者及需要图形化界面批量生成条码的终端用户。",
    "categories": [
      {
        "name": "条码编码核心",
        "description": "支持 90+ 种条码符号体系的编码引擎，涵盖 1D 线形码（Code 128/EAN/UPC/Code 39 等）、2D 矩阵码（QR Code/Data Matrix/Aztec Code/PDF417/汉信码等）、邮政码（USPS POSTNET/IMail/RM4SCC/日本邮政等）、复合码（GS1 DataBar Composite 等），含 Reed-Solomon 纠错、GS1 数据解析、ECI 扩展通道解译等",
        "evidence": [
          "backend/library.c",
          "backend/zint.h",
          "backend/qr.c",
          "backend/dmatrix.c",
          "backend/pdf417.c",
          "backend/hanxin.c"
        ]
      },
      {
        "name": "多种输出格式",
        "description": "将编码后的条码渲染输出为多种图像格式：BMP/GIF/PCX/PNG/TIF 栅格格式和 EMF/EPS/SVG 矢量格式；可选 PNG 支持需 libpng",
        "evidence": [
          "backend/raster.c",
          "backend/vector.c",
          "backend/bmp.c",
          "backend/svg.c",
          "backend/png.c",
          "backend/output.c"
        ]
      },
      {
        "name": "CLI 命令行工具",
        "description": "命令行界面，可从终端直接编码数据并输出条码图像，支持丰富的选项控制输出格式、尺寸、颜色、旋转等",
        "evidence": [
          "frontend/main.c"
        ]
      },
      {
        "name": "Qt 桌面 GUI 应用（Zint Barcode Studio）",
        "description": "基于 Qt5/Qt6 的图形界面条码生成器，提供条码类型选择、数据输入、实时预览、图像导出、序列生成等功能，面向需要可视化操作条码生成的用户",
        "evidence": [
          "frontend_qt/mainwindow.cpp",
          "frontend_qt/datawindow.cpp",
          "frontend_qt/exportwindow.cpp",
          "frontend_qt/sequencewindow.cpp"
        ]
      },
      {
        "name": "多语言/多平台绑定",
        "description": "提供 C API（zint.h）供其他语言集成；含 Tcl 后端绑定和 Qt/C++ 封装类 QZint，方便将条码生成功能嵌入第三方应用",
        "evidence": [
          "backend/zint.h",
          "backend_tcl/zint.c",
          "backend_qt/qzint.cpp"
        ]
      }
    ],
    "domain": "条码编码/图形生成",
    "target_users": "需要在应用中集成条码生成功能的软件开发者、需要图形界面批量生成条码的终端用户",
    "ecosystem": "cpp"
  },
