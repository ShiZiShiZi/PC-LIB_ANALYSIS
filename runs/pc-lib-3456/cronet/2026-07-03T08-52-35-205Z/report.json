  "function_summary": {
    "summary": "Cronet 是 Chromium 浏览器网络栈的 Android 库封装，向应用提供异步 URL 请求、HTTP/2、QUIC、缓存、Cookie、NetLog 等能力，同时保留 HttpURLConnection 同步兼容层。核心由 C++ 实现并通过 JNI 与 Java API 桥接，目标用户主要是 Android 应用开发者。",
    "categories": [
      {
        "name": "异步 HTTP/HTTPS/QUIC 请求",
        "description": "基于 Chromium //net 的高性能异步网络请求，支持 HTTP/2、QUIC、双向流、上传数据流与回调式 API",
        "evidence": [
          "android/api/src/org/chromium/net/UrlRequest.java",
          "cronet_url_request.cc"
        ]
      },
      {
        "name": "CronetEngine 构建与配置",
        "description": "通过 Builder 配置缓存、QUIC、DNS、代理、实验选项等，并序列化为 Protobuf 后传入 C++ 核心",
        "evidence": [
          "android/api/src/org/chromium/net/CronetEngine.java:105",
          "url_request_context_config.cc"
        ]
      },
      {
        "name": "HttpURLConnection 同步兼容层",
        "description": "提供 java.net.HttpURLConnection 适配实现，使现有基于标准 Java 网络 API 的代码可无缝切换到 Cronet",
        "evidence": [
          "android/java/src/org/chromium/net/urlconnection/CronetHttpURLConnection.java"
        ]
      },
      {
        "name": "C++ 核心与 JNI 桥接",
        "description": "C++ CronetContext/CronetURLRequest 封装 Chromium 线程模型，通过自动生成/手写的 JNI 适配器与 Java 层交互",
        "evidence": [
          "android/cronet_context_adapter.cc",
          "android/cronet_url_request_adapter.cc",
          "cronet_context.cc"
        ]
      },
      {
        "name": "缓存与持久化",
        "description": "将 Host cache、网络质量估计、Cookie 等状态持久化到磁盘，并支持 NetLog 文件/目录导出",
        "evidence": [
          "cronet_prefs_manager.cc:38",
          "host_cache_persistence_manager.cc",
          "cronet_context.cc:396"
        ]
      },
      {
        "name": "Provider 发现与平台适配",
        "description": "通过 ServiceLocator/反射在 org.chromium.net.impl 中挑选最合适的 Provider（Native / HttpEngine / Java 回退），并适配 Android 系统代理、系统属性与 StatsLog",
        "evidence": [
          "android/api/src/org/chromium/net/CronetProvider.java",
          "android/java/src/org/chromium/net/impl/NativeCronetProvider.java",
          "android/java/src/org/chromium/net/impl/HttpEngineNativeProvider.java"
        ]
      }
    ],
    "domain": "networking",
    "target_users": "Android 应用开发者及需要 Chromium 网络能力的嵌入方"
  },
