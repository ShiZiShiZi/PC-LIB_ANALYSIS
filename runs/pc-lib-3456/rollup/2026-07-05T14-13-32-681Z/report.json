  "function_summary": {
    "summary": "Rollup 是面向 JavaScript/TypeScript 生态的下一代 ES 模块打包工具。它采用标准的 ES 模块格式，将分散的小模块合并为优化后的单一文件或分块输出。支持 Tree-shaking（基于静态分析的死代码消除）、多种输出格式（ES、CommonJS、AMD、IIFE、UMD、SystemJS）、插件系统、代码拆分、动态导入、TypeScript 类型声明生成等功能。以 npm 包 `rollup` 分发，提供 JavaScript API 和命令行界面两种使用方式。",
    "categories": [
      {
        "name": "模块打包与 Tree-shaking",
        "description": "核心打包引擎：解析 ES 模块依赖图，通过静态分析消除未使用的导出代码，生成优化的打包结果。支持多种入口格式配置。",
        "evidence": [
          "src/rollup/rollup.ts:46",
          "src/Graph.ts",
          "src/Module.ts",
          "src/Chunk.ts"
        ]
      },
      {
        "name": "多种输出格式",
        "description": "支持 ES、CommonJS、AMD、IIFE（立即执行函数）、UMD、SystemJS 等模块格式，适配不同运行环境（浏览器、Node.js）。",
        "evidence": [
          "src/finalisers/"
        ]
      },
      {
        "name": "插件系统",
        "description": "完善的插件 Hook 机制，允许构建过程各阶段（解析模块、加载模块、转换代码、生成输出等）的自定义扩展。官方及社区提供大量插件。",
        "evidence": [
          "src/utils/PluginDriver.ts",
          "src/rollup/rollup.ts:76"
        ]
      },
      {
        "name": "代码拆分与动态导入",
        "description": "支持 `import()` 表达式自动代码拆分，按入口和动态导入点将打包结果拆分为多个 Chunk，优化按需加载。",
        "evidence": [
          "src/Chunk.ts",
          "src/Module.ts:dynamicImports"
        ]
      },
      {
        "name": "Watch 模式与文件监听",
        "description": "提供 `rollup --watch` 的开发模式，监听源码文件变更自动增量重新打包。底层集成 chokidar（文件系统监听库）。",
        "evidence": [
          "src/watch/watch.ts",
          "src/watch/fileWatcher.ts",
          "cli/run/watch-cli.ts"
        ]
      },
      {
        "name": "AST 快速解析（Rust 原生）",
        "description": "使用 Rust 实现的基于 SWC 的高性能 AST 解析器，通过 N-API（Node 原生）和 WASM（浏览器）提供 `parse`、`parseAsync` 接口及哈希计算。",
        "evidence": [
          "rust/bindings_napi/src/lib.rs",
          "rust/parse_ast/src/lib.rs",
          "native.js",
          "browser/src/wasm.ts"
        ]
      },
      {
        "name": "Sourcemap 处理",
        "description": "生成与合并源码映射（Sourcemap），支持调试时定位到原始源码位置。集成 `magic-string` 库进行源码变换追踪。",
        "evidence": [
          "src/Bundle.ts",
          "src/utils/collapseSourcemaps.ts"
        ]
      }
    ],
    "domain": "构建工具",
    "target_users": "JavaScript/TypeScript 应用与库的开发者",
    "ecosystem": "nodejs"
  },
