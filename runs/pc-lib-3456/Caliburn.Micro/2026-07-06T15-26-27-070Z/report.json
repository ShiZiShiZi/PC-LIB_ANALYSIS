  "function_summary": {
    "summary": "Caliburn.Micro 是一个面向所有 XAML 平台（WPF、UWP、WinUI 3、.NET MAUI、Avalonia UI、Xamarin.Forms、Android、iOS）的轻量级 MVVM 应用框架。它通过约定优于配置的方式自动完成 View-ViewModel 绑定、Action 消息路由与导航，同时提供 Screen 生命周期管理、Conductor 组合、EventAggregator 事件总线、WindowManager 窗口管理和 SimpleContainer IoC 容器等核心设施，帮助开发者快速构建可测试的桌面与移动应用。",
    "categories": [
      {
        "name": "MVVM 视图-模型绑定",
        "description": "基于命名约定自动发现并绑定 View 与 ViewModel，支持 ViewLocator/ViewModelLocator 名称变换、ViewModelBinder 绑定钩子、ActionMessage 事件路由与 MessageBinder 参数解析",
        "evidence": [
          "src/Caliburn.Micro.Platform/ViewLocator.cs",
          "src/Caliburn.Micro.Platform/ViewModelLocator.cs",
          "src/Caliburn.Micro.Platform/ViewModelBinder.cs",
          "src/Caliburn.Micro.Platform/ActionMessage.cs",
          "src/Caliburn.Micro.Platform/MessageBinder.cs"
        ]
      },
      {
        "name": "Screen 生命周期与 Conductor 组合",
        "description": "Screen 基类封装激活/停用/关闭生命周期，Conductor 系列提供单活动/多活动子项管理，支持协程式 IResult 异步操作链",
        "evidence": [
          "src/Caliburn.Micro.Core/Screen.cs",
          "src/Caliburn.Micro.Core/Conductor.cs",
          "src/Caliburn.Micro.Core/ConductorBase.cs",
          "src/Caliburn.Micro.Core/ConductorWithCollectionOneActive.cs",
          "src/Caliburn.Micro.Core/ConductorWithCollectionAllActive.cs",
          "src/Caliburn.Micro.Core/IResult.cs"
        ]
      },
      {
        "name": "事件聚合器",
        "description": "EventAggregator 实现发布-订阅模式，使用弱引用避免内存泄漏，支持泛型 IHandle<T> 消息处理器与自定义marshal调度",
        "evidence": [
          "src/Caliburn.Micro.Core/EventAggregator.cs",
          "src/Caliburn.Micro.Core/IEventAggregator.cs",
          "src/Caliburn.Micro.Core/IHandle.cs"
        ]
      },
      {
        "name": "窗口管理与导航",
        "description": "IWindowManager/WindowManager 统一管理模态/非模态窗口与弹出窗口，FrameAdapter/NavigationPageAdapter 提供 XAML Frame 导航服务",
        "evidence": [
          "src/Caliburn.Micro.Platform/Platforms/net46-netcore/WindowManager.cs",
          "src/Caliburn.Micro.Platform/Platforms/netcore-avalonia/WindowManager.cs",
          "src/Caliburn.Micro.Platform/Platforms/net46-netcore/FrameAdapter.cs",
          "src/Caliburn.Micro.Platform/Platforms/netcore-avalonia/NavigationFrame.cs"
        ]
      },
      {
        "name": "IoC 容器与引导",
        "description": "SimpleContainer 提供轻量依赖注入，Bootstrapper/BootstrapperBase 封装框架初始化流程，包括程序集发现、Convention 配置与平台适配",
        "evidence": [
          "src/Caliburn.Micro.Core/SimpleContainer.cs",
          "src/Caliburn.Micro.Platform/Platforms/net46-netcore/Bootstrapper.cs",
          "src/Caliburn.Micro.Platform/Platforms/netcore-avalonia/BootstrapperBase.cs"
        ]
      },
      {
        "name": "平台适配层",
        "description": "为 WPF、UWP、WinUI 3、Avalonia、.NET MAUI、Xamarin.Forms、Android、iOS 各平台提供专用 PlatformProvider、ActionMessage、ConventionManager 与导航实现",
        "evidence": [
          "src/Caliburn.Micro.Platform/Platforms/",
          "src/Caliburn.Micro.Platform/XamlPlatformProvider.cs",
          "src/Caliburn.Micro.Platform/Platforms/Android/AndroidPlatformProvider.cs",
          "src/Caliburn.Micro.Platform/Platforms/iOS/iOSPlatformProvider.cs",
          "src/Caliburn.Micro.Platform/Platforms/Maui/FormsPlatformProvider.cs"
        ]
      }
    ],
    "domain": "桌面/移动应用 UI 框架",
    "target_users": "使用 XAML 技术栈（WPF/UWP/WinUI/Avalonia/MAUI/Xamarin.Forms）开发桌面与移动应用的 .NET 开发者"
  },
