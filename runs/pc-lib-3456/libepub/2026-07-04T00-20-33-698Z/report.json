  "function_summary": {
    "summary": "libepub 是一个基于 C++11 的电子书处理库，主要面向需要集成 EPUB 解析能力的 C++ 应用。它能够把 EPUB 文件解压到临时目录，解析 META-INF/container.xml、OPF 包文件、CSS 样式以及 HTML 内容，并将解析结果序列化到 SQLite 数据库中。",
    "categories": [
      {
        "name": "EPUB 容器解压与校验",
        "description": "通过外部 unzip 命令将 EPUB 压缩包解压到系统临时目录，并校验 mimetype 与 container.xml。",
        "evidence": [
          "src/Epub.cpp:61-166",
          "include/Epub.hpp:45-79"
        ]
      },
      {
        "name": "OPF 与元数据解析",
        "description": "解析 OPF 包中的 metadata、manifest、spine 信息，提供按 id 或媒体类型查找条目。",
        "evidence": [
          "src/OPF.cpp:177-404",
          "include/OPF.hpp:192-216"
        ]
      },
      {
        "name": "CSS 选择器与规则解析",
        "description": "读取 EPUB 中的 CSS 文件，解析选择器、特异性与原始属性键值对。",
        "evidence": [
          "src/CSS.cpp:422-743",
          "include/CSS.hpp:89-111"
        ]
      },
      {
        "name": "HTML 内容抽取",
        "description": "基于 libxml++ 遍历 XHTML 文档，将段落、标题、分隔符等内容抽取为结构化文本项。",
        "evidence": [
          "src/Content.cpp:463-537",
          "include/Content.hpp:73-92"
        ]
      },
      {
        "name": "SQLite 持久化",
        "description": "将 EPUB 文件信息、container、OPF、CSS、content 等数据保存到 SQLite，并支持从数据库重建对象。",
        "evidence": [
          "src/Epub.cpp:342-405",
          "src/OPF.cpp:597-782",
          "src/Content.cpp:617-673"
        ]
      }
    ],
    "domain": "电子书/文档处理",
    "target_users": "需要集成 EPUB 解析能力的 C++ 应用开发者"
  },
