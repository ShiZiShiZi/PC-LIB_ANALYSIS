  "function_summary": {
    "summary": "webpack 是为现代 JavaScript 应用设计的模块打包工具（module bundler）。它将 ESM、CommonJS、AMD 等不同模块格式的源码及图片、CSS、字体等静态资源递归分析并打包为浏览器可用的静态文件。core 由 Compiler（编译驱动）+ Compilation（单次构建上下文）+ 基于 tapable 的插件钩子系统构成，通过 loader 机制预处理各类文件（TypeScript/JSX/Sass 等），通过插件机制扩展打包行为（代码分割、压缩、HMR、Module Federation 等）。主要被前端开发者在构建阶段以 CLI 或 Node.js API 方式调用。",
    "categories": [
      {
        "name": "模块解析与打包",
        "description": "解析 ESM、CommonJS、AMD 等模块语法，构建模块依赖图，将多个模块合并为一个或多个 bundle 产物",
        "evidence": [
          "lib/Compilation.js",
          "lib/NormalModuleFactory.js",
          "lib/dependencies/"
        ]
      },
      {
        "name": "代码分块与按需加载",
        "description": "通过 SplitChunksPlugin 等将代码拆分为多个 chunk，支持运行时异步加载，减少首屏加载体积",
        "evidence": [
          "lib/optimize/SplitChunksPlugin.js",
          "lib/runtime/",
          "lib/Chunk.js"
        ]
      },
      {
        "name": "Loader 预处理管道",
        "description": "以 loader-runner 驱动文件预处理链，允许开发者在导入时转换任意类型文件（TypeScript→JS、Sass→CSS 等）",
        "evidence": [
          "lib/NormalModule.js",
          "lib/loader-runner/"
        ]
      },
      {
        "name": "插件可扩展架构",
        "description": "基于 tapable 事件流提供 200+ 编译钩子，内置 40+ 插件覆盖 HMR、SourceMap、Banner、Define 等常见需求",
        "evidence": [
          "lib/Compiler.js",
          "lib/Compilation.js",
          "lib/BannerPlugin.js",
          "lib/DefinePlugin.js",
          "lib/HotModuleReplacementPlugin.js"
        ]
      },
      {
        "name": "多输出目标与格式",
        "description": "支持 web、node、webworker、electron、deno、bun 等输出目标，产物格式覆盖 ESM、CommonJS、AMD、UMD、Module Federation",
        "evidence": [
          "lib/web/",
          "lib/node/",
          "lib/webworker/",
          "lib/electron/",
          "lib/library/",
          "lib/container/"
        ]
      },
      {
        "name": "Module Federation（微前端）",
        "description": "支持多个独立构建应用在运行时共享模块，实现微前端架构的运行时依赖共享和动态加载",
        "evidence": [
          "lib/container/",
          "lib/sharing/"
        ]
      },
      {
        "name": "持久化缓存与增量构建",
        "description": "通过 filesystem cache 将模块构建结果持久化到磁盘，watch 模式下仅重新构建变更部分，大幅提升二次构建速度",
        "evidence": [
          "lib/cache/",
          "lib/Cache.js",
          "lib/Compiler.js"
        ]
      }
    ],
    "domain": "构建工具 / 前端工程化",
    "target_users": "前端与 JavaScript 应用开发者",
    "ecosystem": "nodejs"
