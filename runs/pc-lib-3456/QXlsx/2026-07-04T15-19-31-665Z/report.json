  "function_summary": {
    "summary": "QXlsx 是一个基于 Qt 框架的 C++ 库，用于读写 Microsoft Excel .xlsx 格式文件。它源自已停止维护的 QtXlsxWriter 项目，提供从简单单元格读写到高级 Excel 功能（图表、数据验证、条件格式、合并单元格、行高列宽设置等）的完整 API。开发者可通过 QXlsx 在 Qt 应用中生成、修改和解析 Excel 文档，无需外部依赖或 Microsoft Office。",
    "categories": [
      {
        "name": "Excel 文件读写",
        "description": "创建、打开、保存和另存 .xlsx 文件，支持从文件路径或 QIODevice 加载与保存",
        "evidence": [
          "QXlsx/header/xlsxdocument.h:34-36",
          "QXlsx/source/xlsxdocument.cpp:117-121"
        ]
      },
      {
        "name": "单元格数据操作",
        "description": "按行列或单元格引用读写各种数据类型（字符串、数字、布尔、日期时间、富文本、公式），支持共享字符串和内联字符串",
        "evidence": [
          "QXlsx/header/xlsxworksheet.h:53-112",
          "QXlsx/header/xlsxcell.h:35-45"
        ]
      },
      {
        "name": "格式与样式设置",
        "description": "设置字体、颜色、边框、填充模式、对齐方式、数字格式等 Excel 单元格格式；支持预定义格式与自定义格式",
        "evidence": [
          "QXlsx/header/xlsxformat.h:27-247",
          "QXlsx/source/xlsxformat.cpp"
        ]
      },
      {
        "name": "图表生成",
        "description": "在 Excel 工作表中插入多种图表类型（柱状图、折线图、饼图、散点图、面积图、雷达图、气泡图等 16 种 ECMA 376 标准图表）",
        "evidence": [
          "QXlsx/header/xlsxchart.h:23-41",
          "QXlsx/source/xlsxchart.cpp"
        ]
      },
      {
        "name": "数据验证与条件格式",
        "description": "支持单元格数据验证规则（类型、范围、列表等限制）和条件格式（高亮规则、数据条、色阶）",
        "evidence": [
          "QXlsx/header/xlsxdatavalidation.h:27-38",
          "QXlsx/header/xlsxconditionalformatting.h:29-73"
        ]
      },
      {
        "name": "工作表与行列管理",
        "description": "管理工作表（添加、删除、重命名、复制、移动），设置行列高度/宽度/隐藏/分组、合并与取消合并单元格、冻结窗格",
        "evidence": [
          "QXlsx/header/xlsxworksheet.h:139-193",
          "QXlsx/header/xlsxdocument.h:51-80"
        ]
      },
      {
        "name": "图片与图形",
        "description": "在 Excel 工作表中插入图片（QImage），支持获取与统计已插入图片",
        "evidence": [
          "QXlsx/header/xlsxdocument.h:44-47",
          "QXlsx/header/xlsxworksheet.h:132-135"
        ]
      },
      {
        "name": "SAX 流式读取",
        "description": "提供 SAX（Simple API for XML）风格的逐行流式读取接口，通过回调函数处理大体积 Excel 文件，避免一次性加载全部数据到内存",
        "evidence": [
          "QXlsx/header/xlsxreadsax.h:18-26",
          "QXlsx/source/xlsxreadsax.cpp"
        ]
      }
    ],
    "domain": "文件处理 / 办公文档",
    "target_users": "Qt/C++ 应用开发者，需要在应用中生成或解析 Excel 报表的桌面或服务端程序开发人员"
  },
