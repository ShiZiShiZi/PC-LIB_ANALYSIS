    "one_liner": "用于拦截 XML 炸弹与实体扩张等漏洞的 Python 安全封装库",
    "ecosystem": "python",
    "bindings": []
  },
  "function_summary": {
    "summary": "defusedxml 是对 Python 标准库 xml 系列模块的安全封装，通过拦截 DTD、内部/外部实体引用和外部实体扩展来防御 Billion Laughs、二次爆炸实体扩张、外部实体（XXE）和 gzip 炸弹等拒绝服务攻击。它以纯 Python 实现，提供与 xml.etree.ElementTree、xml.dom.minidom、xml.sax、xmlrpc.client 等标准库 API 相近的入口，主要面向需要在不可信 XML 输入上保持安全的 Python 开发者与安全工程师。",
    "categories": [
      {
        "name": "ElementTree 防护",
        "description": "封装 xml.etree.ElementTree，在解析阶段禁止 DTD、实体声明与外部引用，提供 parse、fromstring、iterparse 等安全入口。",
        "evidence": ["defusedxml/ElementTree.py:66 DefusedXMLParser", "defusedxml/ElementTree.py:122 parse", "defusedxml/ElementTree.py:151 fromstring"]
      },
      {
        "name": "DOM/SAX 防护",
        "description": "对 xml.dom.minidom、xml.dom.pulldom、xml.sax、xml.dom.expatbuilder、xml.sax.expatreader 提供统一的安全封装与解析器钩子。",
        "evidence": ["defusedxml/minidom.py:17 parse", "defusedxml/pulldom.py:17 parse", "defusedxml/sax.py:18 parse", "defusedxml/expatbuilder.py:18 DefusedExpatBuilder", "defusedxml/expatreader.py:17 DefusedExpatParser"]
      },
      {
        "name": "XML-RPC 防护",
        "description": "通过 monkey-patch 替换 xmlrpc.client 的 FastParser 与 gzip 解码逻辑，限制最大解压/请求大小以防御 gzip 炸弹。",
        "evidence": ["defusedxml/xmlrpc.py:100 DefusedExpatParser", "defusedxml/xmlrpc.py:36 defused_gzip_decode", "defusedxml/xmlrpc.py:131 monkey_patch"]
      },
      {
        "name": "全局 monkey-patch",
        "description": "提供 defuse_stdlib() 一键将上述安全实现注入 Python 标准库对应模块，方便旧代码快速启用防护。",
        "evidence": ["defusedxml/__init__.py:22 defuse_stdlib", "defusedxml/common.py:75 _apply_defusing"]
      },
      {
        "name": "异常体系",
        "description": "定义 DTDForbidden、EntitiesForbidden、ExternalReferenceForbidden 等异常，用于在触发危险 XML 特性时抛出明确错误。",
        "evidence": ["defusedxml/common.py:25 DTDForbidden", "defusedxml/common.py:39 EntitiesForbidden", "defusedxml/common.py:56 ExternalReferenceForbidden"]
      },
      {
        "name": "lxml 兼容（已弃用）",
        "description": "提供基于 lxml.etree 的防护示例与 RestrictedElement，但该模块已被标记为废弃并将在未来版本移除。",
        "evidence": ["defusedxml/lxml.py:33 RestrictedElement", "defusedxml/lxml.py:26 DeprecationWarning"]
      }
    ],
    "domain": "security / xml parsing",
    "target_users": "需要安全解析不可信 XML 的 Python 开发者、应用安全工程师与后端服务维护者"
  },
