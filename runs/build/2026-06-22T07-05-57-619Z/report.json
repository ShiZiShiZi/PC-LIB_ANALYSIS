  "function_summary": {
    "summary": "build 是由 PyPA 维护的 Python 构建前端，提供符合 PEP 517 的 API 与命令行接口。它解析项目 pyproject.toml 中的 [build-system] 配置，在隔离环境（venv/virtualenv + pip/uv）中调用构建后端，生成源码分发包（sdist）与二进制 wheel，并支持依赖检查、元数据提取与构建产物报告输出。主要面向 Python 包开发者、CI/CD 流水线及下游打包工具集成方。",
    "categories": [
      {
        "name": "PEP 517 构建编排",
        "description": "解析 pyproject.toml 的 [build-system] 表，调用 get_requires_for_build、build_sdist、build_wheel、prepare_metadata_for_build 等钩子完成构建流程。",
        "evidence": ["src/build/_builder.py:ProjectBuilder", "src/build/_builder.py:188-420"]
      },
      {
        "name": "隔离构建环境管理",
        "description": "创建并管理隔离虚拟环境，支持 pip 与 uv 两种安装后端，以及 venv/virtualenv 两种环境后端，确保构建依赖与宿主环境隔离。",
        "evidence": ["src/build/env.py:DefaultIsolatedEnv", "src/build/env.py:_PipBackend", "src/build/env.py:_UvBackend"]
      },
      {
        "name": "命令行前端",
        "description": "提供 python -m build / pyproject-build CLI，解析构建参数、控制日志输出与颜色、处理错误提示并输出构建报告。",
        "evidence": ["src/build/__main__.py:main", "src/build/__main__.py:main_parser", "src/build/__main__.py:_setup_cli"]
      },
      {
        "name": "依赖检查",
        "description": "基于 packaging 与 importlib.metadata 校验 build-system.requires 与后端声明的依赖是否已满足，并格式化未满足依赖信息。",
        "evidence": ["src/build/_util.py:check_dependency", "src/build/_util.py:format_unmet_dependencies"]
      },
      {
        "name": "源码包与元数据处理",
        "description": "安全解压 sdist（PEP 706 data 过滤器回退）、验证 sdist 结构、从 wheel 中提取 METADATA，并生成 JSON 构建报告。",
        "evidence": ["src/build/_compat/tarfile.py:safe_extractall", "src/build/__main__.py:_validate_sdist_archive", "src/build/__main__.py:_write_report"]
      }
    ],
    "domain": "Python 打包与构建工具",
    "target_users": "Python 包开发者、CI/CD 维护者及打包工具集成方"
