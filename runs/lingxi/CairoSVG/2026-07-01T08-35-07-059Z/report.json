  "function_summary": {
    "summary": "CairoSVG 是一个基于 Cairo 图形库的 Python SVG 转换库。它解析 SVG 文档与内联 CSS，利用 Cairo 的 2D 矢量绘制能力将 SVG 渲染为 PDF、PNG、EPS、PS 或再输出为 SVG。库同时提供 Python API（svg2png/svg2pdf 等）和 cairosvg 命令行入口，主要面向需要在服务端、脚本或工作流中完成矢量图格式转换的 Python 开发者。",
    "categories": [
      {
        "name": "SVG 解析与 DOM 构建",
        "description": "使用 defusedxml 安全解析 SVG/XML，使用 cssselect2 包装 ElementTree 节点，构建带继承属性、样式和子节点的内部 Node/Tree 树。",
        "evidence": [
          "cairosvg/parser.py:12",
          "cairosvg/parser.py:154-414"
        ]
      },
      {
        "name": "CSS 样式解析",
        "description": "使用 tinycss2 解析内联 <style> 与 @import 样式表，使用 cssselect2 编译选择器并匹配元素，生成 normal/important 规则集。",
        "evidence": [
          "cairosvg/css.py:1-91"
        ]
      },
      {
        "name": "矢量渲染与多格式输出",
        "description": "通过 cairocffi 调用 Cairo 的 2D 绘图上下文，将基本形状、路径、文本、变换、裁剪等绘制到 PDF/PNG/EPS/PS/SVG 表面。",
        "evidence": [
          "cairosvg/surface.py:82-539",
          "cairosvg/shapes.py",
          "cairosvg/path.py",
          "cairosvg/text.py"
        ]
      },
      {
        "name": "渐变、图案、遮罩与滤镜",
        "description": "解析 SVG <linearGradient>/<radialGradient>/<pattern>/<mask>/<filter> 等定义，并映射为 Cairo 渐变、图案、遮罩表面与混合操作。",
        "evidence": [
          "cairosvg/defs.py:1-375"
        ]
      },
      {
        "name": "内嵌光栅图像处理",
        "description": "对 SVG <image> 引用的 PNG/JPEG/SVG 等数据进行解码、EXIF 方向修正与颜色模式转换，必要时通过 Pillow 转为 PNG 后再交给 Cairo。",
        "evidence": [
          "cairosvg/image.py:9-117"
        ]
      },
      {
        "name": "URL 解析与资源获取",
        "description": "处理 file://、相对路径与 data: URL，支持 Windows 路径归一化；默认安全模式下仅允许 data: URL，unsafe=True 时可通过 urllib 获取外部资源。",
        "evidence": [
          "cairosvg/url.py:1-155"
        ]
      },
      {
        "name": "命令行接口",
        "description": "提供 cairosvg 命令行入口，支持指定输入/输出、格式、DPI、缩放、背景色、颜色取反等选项。",
        "evidence": [
          "cairosvg/__main__.py:13-79",
          "setup.cfg:55"
        ]
      }
    ],
