  "function_summary": {
    "summary": "playwright 是一个 Python 库，为 Microsoft Playwright 提供 Python 语言绑定。它通过 JSON-over-pipe 协议与内置的 Node.js 驱动通信，进而控制 Chromium、Firefox 和 WebKit 浏览器。库同时提供同步与异步两套高层 API，覆盖浏览器启动、页面操作、元素定位、网络拦截、请求伪造、截图/视频/跟踪记录以及下载处理，主要面向 Web 自动化测试与爬虫场景。",
    "categories": [
      {
        "name": "浏览器启动与生命周期管理",
        "description": "通过 BrowserType.launch / launch_persistent_context 启动本地或持久化浏览器，并管理 Browser、BrowserContext、Page 等对象的生命周期。",
        "evidence": ["playwright/_impl/_browser_type.py:BrowserType.launch", "playwright/_impl/_browser_type.py:BrowserType.launch_persistent_context", "playwright/_impl/_browser.py"]
      },
      {
        "name": "页面与元素交互",
        "description": "提供 Page、Frame、Locator、ElementHandle 等对象，支持点击、填充、截图、滚动、等待、对话框处理等页面级与元素级操作。",
        "evidence": ["playwright/_impl/_page.py", "playwright/_impl/_locator.py", "playwright/_impl/_element_handle.py"]
      },
      {
        "name": "网络拦截与 API 请求",
        "description": "支持 Request/Response/Route 事件监听与拦截，以及 APIRequestContext 直接发起 HTTP 请求，用于模拟后端与测试网络行为。",
        "evidence": ["playwright/_impl/_network.py", "playwright/_impl/_fetch.py:APIRequestContext", "playwright/_impl/_har_router.py"]
      },
      {
        "name": "同步与异步双 API",
        "description": "自动生成 sync_api/_generated.py 与 async_api/_generated.py，为同一底层实现提供 sync_playwright 与 async_playwright 两套调用风格。",
        "evidence": ["playwright/sync_api/_generated.py", "playwright/async_api/_generated.py", "playwright/_impl/_sync_base.py", "playwright/_impl/_async_base.py"]
      },
      {
        "name": "截图、视频、跟踪与下载",
        "description": "封装截图、屏幕录制（Screencast）、视频录制（Video）、HAR/Trace 跟踪以及文件下载（Download、Artifact）能力。",
        "evidence": ["playwright/_impl/_screencast.py", "playwright/_impl/_video.py", "playwright/_impl/_tracing.py", "playwright/_impl/_download.py"]
      },
      {
        "name": "CLI 与驱动管理",
        "description": "提供 playwright 控制台入口，透传命令到内置 Node.js 驱动；运行时负责定位并启动 driver/package/cli.js。",
        "evidence": ["playwright/__main__.py:main", "playwright/_impl/_driver.py:compute_driver_executable", "pyproject.toml:project.scripts"]
      }
    ],
    "domain": "web automation / testing",
    "target_users": "Web 应用开发者、测试工程师、自动化脚本作者"
  },
